#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.REPAIRBOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.REPAIRBOAT.GENERIC"
msgid "The boat's still quite sound. No patching it up just yet."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1"
msgid "The hull is sound as it is."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2"
msgid "I'll save the patch for an actual leak."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.EMBARK.INUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.EMBARK.INUSE"
msgid "Oh! There's someone aboard already. I'll wait."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1"
msgid "After you. I've time to wait."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2"
msgid "Let me know when you're finished."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.INSPECTBOAT.INUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.INSPECTBOAT.INUSE"
msgid "Someone's inspecting it. I'll be good and wait my turn."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1"
msgid "After you. I've time to wait."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2"
msgid "Let me know when you're finished."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.OPEN_CRAFTING.FLOODED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.OPEN_CRAFTING.FLOODED"
msgid "Even a practiced hand would slip in all this water..."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1"
msgid "I can't lay my tools down in this water."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2"
msgid "I'll find some dry ground to work on."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAGIC_FAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAGIC_FAIL"
msgid "Huh? That spell's as contrary as a little tsukumogami."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1"
msgid "I'm still standing in the same place."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2"
msgid "Strange. I felt nothing happen."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SHARX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SHARX"
msgid "Something's churning up the sea. I'll keep my distance before I draw."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SHARX.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SHARX.1"
msgid "A fin off the stern!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SHARX.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SHARX.2"
msgid "Keep your hands inside the boat."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TREASURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TREASURE"
msgid "An X! That's the treasure giving me a wink. Ha!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1"
msgid "There's a cross on the map."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2"
msgid "I'll bring the shovel along."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TREASURE_DISCOVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TREASURE_DISCOVER"
msgid "Found it! The treasure's gleaming right here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1"
msgid "There's something buried just here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2"
msgid "I heard the shovel strike something!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MORETREASURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MORETREASURE"
msgid "This is my lucky day. I'd have drawn the very best fortune!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1"
msgid "There's something buried just here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2"
msgid "I heard the shovel strike something!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_OTHER_WORLD_TREASURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_OTHER_WORLD_TREASURE"
msgid "These islands aren't on the chart. Have I wandered into a hidden village?"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1"
msgid "None of these islands match my map."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2"
msgid "I'll save this chart for another sea."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_OTHER_WORLD_PLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_OTHER_WORLD_PLANT"
msgid "It doesn't like this soil. It seems cruel to plant it here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1"
msgid "I can't get it to take root here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2"
msgid "We should take it back to its own soil."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_IA_MESSAGEBOTTLE.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_IA_MESSAGEBOTTLE.1"
msgid "Seawater has blurred the letters. I can't read any of them."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IA_MESSAGEBOTTLE.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IA_MESSAGEBOTTLE.1.1"
msgid "The salt washed out every word."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IA_MESSAGEBOTTLE.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IA_MESSAGEBOTTLE.1.2"
msgid "All that survived was the paper."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_VOLCANO_ERUPT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_VOLCANO_ERUPT"
msgid "The volcano speaks! We've angered a god!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1"
msgid "Look up! Stones are falling!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2"
msgid "Find open ground!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_WARN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_WARN"
msgid "The fog's so thick I've lost sight of the tip of my sword."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1"
msgid "I can hardly see past the bow."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2"
msgid "Keep close in this fog."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_LOSECONTROL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_LOSECONTROL"
msgid "Oh dear. Has a tanuki run off with my sense of direction?"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1"
msgid "I can hardly see past the bow."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2"
msgid "Keep close in this fog."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_RETURN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MAPWRAP_RETURN"
msgid "Out at last! My eyes were starting to spin."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1"
msgid "There's the horizon again!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2"
msgid "Let me get my bearings after all that fog."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CRAB_ESCAPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CRAB_ESCAPE"
msgid "Oh! A quick little sidestep and it got away."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1"
msgid "It went straight under the sand!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2"
msgid "Those little legs are faster than they look."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TRAWL_FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TRAWL_FULL"
msgid "The trawl's full! Time to bring in the catch."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1"
msgid "The net's dragging. Give me a hand!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2"
msgid "Time to see what we caught."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_DAMAGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_DAMAGED"
msgid "My boat's hurt. A swordswoman ought to have a gentle hand for repairs too."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1"
msgid "Water under the boards! Pass me a patch."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2"
msgid "I can feel water round my ankles."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_SINKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_SINKING"
msgid "Oh dear. The sea seems to be inviting me for a swim..."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1"
msgid "Everyone to shore! Leave the cargo!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2"
msgid "The deck's going under!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_SINKING_IMMINENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_BOAT_SINKING_IMMINENT"
msgid "The boat's going down! No time for a farewell poem!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1"
msgid "Everyone to shore! Leave the cargo!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2"
msgid "The deck's going under!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WAVE_BOOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WAVE_BOOST"
msgid "Off with the wave! Here we go!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1"
msgid "That wave gave us quite a lift!"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2"
msgid "Hold on, we're picking up speed!"
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY"
msgid "Something huge is close. It feels like an umibozu on its nightly rounds."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1"
msgid "Fresh signs. It can't be far."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.2"
msgid "Quiet now. We're close."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_LOST_TRAIL"
msgid "No more bubbles. I've lost the trail."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.1"
msgid "Nothing past this point."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.2"
msgid "I can't tell where it went from here."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING"
msgid "These spring waves could fool even a swordswoman's eyes."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.1"
msgid "Nothing past this point."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.2"
msgid "I can't tell where it went from here."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOTSAM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOTSAM"
msgid "It's floating just out there. If only my scabbard had a hook."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.1"
msgid "Something from a ship, judging by the splinters."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.2"
msgid "I wonder which shore it started from."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT.ABANDONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT.ABANDONED"
msgid "Nobody left aboard... I wonder if this is how Urashima Taro's story went on."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.1"
msgid "Nobody seems to be tending it now."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.2"
msgid "I wonder when someone last came this way."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT.GENERIC"
msgid "That sodden boat looks as if it's waiting for someone to talk to."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.1"
msgid "I wonder what Wickerbottom could tell me about the sunken boat."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.2"
msgid "I'll keep it separate until I know what it's for."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUNKEN_BOAT_BURNT"
msgid "Sunk and scorched. Oh, what a sorry sight."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.1"
msgid "Water all around and it still burned."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.2"
msgid "The water hasn't washed away the scorch marks."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LOGRAFT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LOGRAFT"
msgid "Logs laid out in a row! I suppose that counts as a boat."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1"
msgid "I'll keep my things tied down between the logs."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2"
msgid "I can see the water between my toes."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_RAFT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_RAFT"
msgid "Plain and dependable, just like my practice sword."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.1"
msgid "I'll keep my things tied down between the logs."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.2"
msgid "I can see the water between my toes."
msgstr ""

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROW"
msgid "An arm workout? Very well. I won't give up."
