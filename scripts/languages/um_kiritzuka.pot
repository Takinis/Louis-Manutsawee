msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MINERHAT_ELECTRICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MINERHAT_ELECTRICAL.1"
