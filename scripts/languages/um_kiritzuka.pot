msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POWERCELL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POWERCELL.2"
msgid "Something this small powers that whole thing?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.1"
msgid "It looks fine from a distance. Look closer before you try to use it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.2"
