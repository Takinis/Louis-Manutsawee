msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.2"
