msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.1"
msgid "Can we leave it here and go?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.2"
msgid "Whatever made that, give it some room."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.1"
msgid "This is the flute the rats follow. Start somewhere away from camp."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.2"
msgid "I won't try that tune until we've closed the food chest."
msgstr ""

