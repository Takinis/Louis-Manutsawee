msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_COPPER_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_COPPER_KIT"
msgid "Copper tubing. Let's lay it out before one rolls off the dock."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SLUDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SLUDGE"
msgid "The bumper gives a little if I push on it. That's probably deliberate."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RAIN_UM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RAIN_UM"
msgid "I can read the whole thing indoors. That seems wiser."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRINE_BALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRINE_BALM"
msgid "If it stings, I'll know when it's on the cut."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGZAPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGZAPPER"
msgid "Finally, something else can keep the bugs off me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLETBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLETBEE.GENERIC"
msgid "That bee flew out faster than I could follow it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLETBEE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLETBEE.HELD"
msgid "I can feel the bee moving in my hand. Bad feeling."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSHCRAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSHCRAB"
msgid "I was going to pick that bush. Then it picked up and walked."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CALIFORNIAKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CALIFORNIAKING"
msgid "That plate's giving me a worse feeling than a school lunch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANNONBALL_SLUDGE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANNONBALL_SLUDGE_ITEM"
msgid "The cannon gets a ball of sludge. The deck's going to be a mess."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL"
msgid "I'll wait till somebody comes back up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC"
msgid "I can't get down here right now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN"
msgid "There's a way down through those roots."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_SUNKDECID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_SUNKDECID"
msgid "Look at the roots around that rock. Something's under it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL"
msgid "It's crowded up top. I won't try to squeeze past."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC"
msgid "That exit isn't clear yet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN"
msgid "Up we go. I've had enough roots over my head."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_DON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_DON"
msgid "I can read Don on the side. The rest is scuffed."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_FREDDO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_FREDDO"
msgid "Freddo. That name was put there on purpose."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_JAZZY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_JAZZY"
msgid "I've seen school pins less shiny than that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_NAMES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CCTRINKET_NAMES"
msgid "There's writing on it. Might be somebody's name."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLES_T_HORSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLES_T_HORSE"
msgid "Charles, right? Does it get mad if I say the whole name?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEPHONOGRAPH_100
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEPHONOGRAPH_100"
msgid "The record's been turning. Who left it playing?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHERRYBULLETBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHERRYBULLETBEE.GENERIC"
msgid "That red bee's had enough time to notice us. Move."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHERRYBULLETBEE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHERRYBULLETBEE.HELD"
msgid "This bee's got no intention of staying in my hand."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMP"
msgid "I saw you look at my pockets."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CODEX_MANTRA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CODEX_MANTRA.GENERIC"
msgid "It's a book I don't want to fall asleep reading."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CODEX_MANTRA.NEEDSFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CODEX_MANTRA.NEEDSFUEL"
msgid "The writing's fading. It needs fuel to work."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMONSTERSMALLMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMONSTERSMALLMEAT"
msgid "It cooked all the way through. That's the good news."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORNCAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORNCAN"
msgid "Corn in a can. Did anybody pack an opener?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABCLAW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABCLAW"
msgid "A claw with gem sockets. Try not to get your finger in the wrong hole."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB_REAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB_REAL"
msgid "I think there's something small in there. Be quiet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB_REAL_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB_REAL_BROKEN"
msgid "It's busted. Maybe moon rocks would hold it together."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_FIGGY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_FIGGY"
msgid "There's a little Figgy. Did it eat all the figs?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURSED_ANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURSED_ANTLER"
msgid "That antler doesn't feel normal when I pick it up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS_BARRIER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS_BARRIER"
msgid "Ice all around. Give me the pickaxe."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVILSFRUITCAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVILSFRUITCAKE"
msgid "I want the fruitcake. I'm less sure about the name."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISEASECUREBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISEASECUREBOMB"
msgid "Use it where the plants are sick. My shoes are fine."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORMANT_RAIN_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORMANT_RAIN_HORN"
msgid "It's quiet. The horn has to wake up first, I think."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOODFISHINGROD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOODFISHINGROD"
msgid "A bit of driftwood that gets to go back to sea."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.FULL"
msgid "No tears anywhere. Looks good."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.HALF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.HALF"
msgid "I can see the holes from here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.QUARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.QUARTER"
msgid "One more hit and this thing's in pieces."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER"
msgid "A few seams are starting to go."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_ALLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_ALLY"
msgid "That little eye is following us instead of biting. I'll take it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY"
msgid "The little eye isn't up yet. Get ready."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_FROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_FROCK"
msgid "I can wear the feathers without having to grow them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_DRIED"
msgid "Dried fish. Easier to carry and it doesn't drip."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLORAL_BANDAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLORAL_BANDAGE"
msgid "I can wrap a scrape in flowers now. That's new."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITBAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITBAT"
msgid "That bat knows exactly where the fruit is. So do I."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARBAGEPATCHFLOTSAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARBAGEPATCHFLOTSAM"
msgid "The wind dumped half the island here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASMASK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASMASK"
msgid "I can breathe. Everybody else, stay out of the cloud."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_BLUEBERRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_BLUEBERRY"
msgid "If I drop that, the whole floor's getting stained."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE"
msgid "I looked up as far as I could. That's still not the top."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE_BIRDNEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE_BIRDNEST"
msgid "That's an enormous nest. I wonder how big the eggs are."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE_INFESTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANT_TREE_INFESTED"
msgid "Something's eating the giant tree. Check the next one too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLACIALHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLACIALHOUND"
msgid "The hound's leaving a cold trail. Leave some room."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASS_SCALES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASS_SCALES"
msgid "Those scales shine right through my fingers."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GORE_HORN_HAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GORE_HORN_HAT"
msgid "The horn goes out front. Even I can tell."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENGEM_CRACKED"
msgid "I can see light coming through the split in the green gem."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENSTEAMEDHAMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENSTEAMEDHAMS"
msgid "It's green all the way through. Is it supposed to be?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHED_ROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHED_ROOM"
msgid "That's the green cap I saw before. What's left of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_VOMIT"
msgid "Green. That's the nicest thing I can say about it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARDSHELLTACOS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARDSHELLTACOS"
msgid "That shell's loud enough to wake people up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAT_RATMASK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAT_RATMASK"
msgid "I can smell the burrows now. Kind of wish I couldn't."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.HUGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.HUGE"
msgid "It's as insulated as it gets. Let's go."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.LARGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.LARGE"
msgid "It's well wrapped. We'll get some use out of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.MED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.MED"
msgid "That's some decent insulation. I can carry it farther now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.SMALL"
msgid "It's got a little insulation now. Better than nothing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.TINY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK_LEVEL.TINY"
msgid "The stone's out in the open. It won't hold its temperature long."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEAT_SCALES_ARMOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEAT_SCALES_ARMOR"
msgid "Scales for the heat. I'll try it before I get any closer."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEY_LOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEY_LOG"
msgid "It smells like honey. It's still a piece of wood."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDMOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDMOSS"
msgid "This moss hasn't had to see the sun in a while."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDTRAPDOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDTRAPDOOR"
msgid "It looks like the rest of the ground. That's what bothers me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDWIDOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODEDWIDOW"
msgid "There's a spider in that shadow. A lot of spider."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_FERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_FERN"
msgid "The fern has a whole patch of shade to itself."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "Acid on that mushroom. I thought the canopy would keep it off."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM"
msgid "The cap's opened up. Can we walk around it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC"
msgid "Not as tall as the tree beside it. Still tall for a mushroom."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED"
msgid "Even the little cap's coated in that stuff."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM"
msgid "Look at the little cap. It's putting out spores already."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC"
msgid "A little one by the roots. I almost stepped over it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED"
msgid "The acid's running all the way down the tall stalk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM"
msgid "That tall one is shedding right over our heads."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC"
msgid "I thought that was a tree till I saw the cap."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDIOUS_OBSERVIOUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDIOUS_OBSERVIOUS"
msgid "That thing opened its eyes. All of them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBOOMERANG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBOOMERANG"
msgid "It comes back. I need gloves to catch that thing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS_AMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS_AMULET"
msgid "Something's pulling at the chains from the inside."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNOOK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNOOK"
msgid "I was doing fine until I saw the mouth."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE2"
msgid "Little lava thing. Do not pick it up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT_SLUDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT_SLUDGE"
msgid "It's still bubbling where it landed."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LICELOAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LICELOAF"
msgid "I'll have a slice if you stop telling me what it's made of."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGHOUND"
msgid "See the sparks along its back? It saw us too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLAGUE_RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLAGUE_RAT"
msgid "There's something off about that rat's coat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUSH_ENTRANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUSH_ENTRANCE"
msgid "Green up here. Can't see what's green down there."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAHOUND"
msgid "That hound's burning, and it's still running at us."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARA_BOSS1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARA_BOSS1"
msgid "Something's here. I need a second to see all of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_GRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_GRASS"
msgid "Grass with mud halfway up the stalk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM"
msgid "Wind turns it. I hope the lamp keeps up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYING"
msgid "Dinner's drying right above me. No pressure."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN"
msgid "It was practically dry. Then the rain came."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT"
msgid "The rain's undoing half the work. Bring it in."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT"
msgid "It's getting dry. Still not done yet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HAT.GENERIC"
msgid "It's a drying rack. I keep wanting to call it a hat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINERHAT_ELECTRICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINERHAT_ELECTRICAL"
msgid "Two free hands. That's worth checking the battery for."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR_BOULDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR_BOULDER"
msgid "Big rock. Somebody's been putting effort into moving it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR_BOULDER_BIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR_BOULDER_BIG"
msgid "That one blocks more than half the passage."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOCK_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOCK_DRAGONFLY"
msgid "I've seen the real thing. This one's still too close."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERSMALLMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERSMALLMEAT"
msgid "That piece is just big enough to make me reconsider dinner."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERSMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERSMALLMEAT_DRIED"
msgid "Even dried, the little piece still looks wrong."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_GEODE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_GEODE"
msgid "It's heavier than it looks. Pick it up from underneath."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_DRAGONFLY"
msgid "The dragonfly's covered in glass. Watch where it turns."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_GLASSSHARDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_GLASSSHARDS"
msgid "Glass from the dragonfly. It's sharp on every side."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_GLASSSHARDS_RING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_GLASSSHARDS_RING"
msgid "It's a ring of glass. Look for a gap before you move."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_LAVAE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_LAVAE"
msgid "Little ones with the same glass on their backs."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_LAVAE_RING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONMAW_LAVAE_RING"
msgid "The larvae have us surrounded. Find the biggest gap."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TEAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TEAR"
msgid "There's a glow where I'd expect a drop of water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOTHERGOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOTHERGOOSE"
msgid "I'll take the long way around the goose and the nest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT_OVERWORLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT_OVERWORLD"
msgid "So the bad air starts at this mushroom."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TRAPDOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TRAPDOOR"
msgid "Webber, it's your snack. I don't need to know what's in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NYMPH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NYMPH"
msgid "There's a little one on the next tree too. Check the leaves."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_SPEAKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_SPEAKER"
msgid "I didn't expect to hear anything but waves out here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_BEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_BEAK"
msgid "The beak came off. I'm glad it can't close around anything now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE"
msgid "It feels slippery through the gloves. Who wants to carry it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE_COOKED"
msgid "It smells better cooked. That's not much to go on."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE_EYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCUPUS_TENTACLE_EYE"
msgid "That eye is still pointed right at me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALPRECIOUSGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALPRECIOUSGEM_CRACKED"
msgid "Every color's still in there. Shame about that crack."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEGEM_CRACKED"
msgid "The orange gem took a hit. I'd rather not drop it again."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGE_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGE_VOMIT"
msgid "That orange puddle wasn't here a minute ago."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALE_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALE_VOMIT"
msgid "That pale stuff is coming nowhere near my shoes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIED_PIPER_FLUTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIED_PIPER_FLUTE"
msgid "If I play it, I'd like to know who else can hear it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIED_RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIED_RAT"
msgid "Watch the one with the tune. The others keep following it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGGUARD.GUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGGUARD.GUARD"
msgid "Don't get the guard and the king mixed up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGGUARD.WEREPIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGGUARD.WEREPIG"
msgid "The guard's changed. Forget about asking permission."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGTORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING_PIGTORCH"
msgid "They've kept the torch lit. Stand on the side out of the wind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINK_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINK_VOMIT"
msgid "I liked pink better before I saw this."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITCHERPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITCHERPLANT"
msgid "I'm not sticking my face into that pitcher."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAGUEMASK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAGUEMASK"
msgid "Mushrooms in the beak. I hope those are the good kind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLENMITEDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLENMITEDEN"
msgid "There are mites inside. Listen if you don't believe me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLENMITES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLENMITES"
msgid "My nose started itching before I got a good look at them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEBOAT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEBOAT_ITEM"
msgid "I can carry the boat till I need to sit in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWERCELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWERCELL"
msgid "I can feel the weight, but I can't see how much charge is left."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEGEM_CRACKED"
msgid "There's something dark along the crack in the purple gem."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLESTEAMEDHAMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLESTEAMEDHAMS"
msgid "I know that's a burger. I'm still looking at the purple part."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_VOMIT"
msgid "It's purple. I still wish I hadn't looked."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAIN_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAIN_HORN"
msgid "This one ought to make it rain. Put the clothes away."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATPOISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATPOISON"
msgid "Mark it so nobody thinks it's lunch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATPOISONBOTTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATPOISONBOTTLE"
msgid "Leave the stopper on till we're at the burrow."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAT_TAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAT_TAIL"
msgid "I don't need the rest of the rat to know where that's from."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAT_WHIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAT_WHIP"
msgid "I can hear it crack before it hits anything."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDGEM_CRACKED"
msgid "The red gem still feels warm where it split."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHED_ROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHED_ROOM"
msgid "A red cap. I don't remember it being that flat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_VOMIT"
msgid "Look at that red patch. Actually, don't."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICE"
msgid "I'll wait till it's cooked. My teeth have enough to do."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICEPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICEPLANT"
msgid "There's dinner growing in the mud."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RICE_COOKED"
msgid "Hot rice. I can have it plain for once."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RNEGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RNEGHOST"
msgid "I can see the ghost better than I can see the ground."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RNESKELETON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RNESKELETON"
msgid "That skeleton didn't need the fog to be hard to look at."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKJAWLEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKJAWLEATHER"
msgid "Cold leather. I wasn't expecting it to feel that smooth."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROSHIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROSHIP"
msgid "The outline's fine. I don't like what I can see of the rest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTPACK"
msgid "The snow's going away right around my shoes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPIONCARAPACE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPIONCARAPACE"
msgid "Empty shell. I checked twice."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPIONCARAPACECOOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPIONCARAPACECOOKED"
msgid "I cooked the shell and now it smells almost edible."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCREECHER_TRINKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCREECHER_TRINKET"
msgid "It's small enough that I almost let it lie."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFOODPAELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFOODPAELLA"
msgid "Finally, the fish and rice came out of the same pan."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_CROWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_CROWN"
msgid "I haven't put it on and I already feel watched."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_TELEPORTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_TELEPORTER"
msgid "It took the gem. I hope that's all it takes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOCKWORM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOCKWORM"
msgid "It's moving and sparking. I can see both without touching it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOM_SKIN_FRAGMENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOM_SKIN_FRAGMENT"
msgid "I thought a smaller piece wouldn't smell as bad. Wrong."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIMPSALAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIMPSALAD"
msgid "Salad. I can eat it and still have room for something hot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIREN_THRONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIREN_THRONE"
msgid "That seat doesn't look as empty as it should."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETONMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETONMEAT"
msgid "I don't want to know why there was still meat on that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLCHEST_CHILD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLCHEST_CHILD"
msgid "Small chest. Plenty of room for things I don't want loose."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLFLASK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLFLASK"
msgid "The flask has something in it. I'm settling for a look."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLFLASK_EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLFLASK_EMPTY"
msgid "Empty flask. That's good for my balance."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS"
msgid "Firecrackers. At least the whole camp will know you hit something."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FLARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FLARE"
msgid "A flare I can shoot. Don't wait till you can't see your hands."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GOOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GOOP"
msgid "It's sticky before it even comes out of the pouch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Honey pellets? Let me eat first so I don't get confused."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_INSANITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_INSANITY"
msgid "Something about this shot makes me want to put the bag down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LAZY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LAZY"
msgid "This one's doing something funny even before I pull the band."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE"
msgid "Limestone rounds. Good thing I'm not carrying the whole rock."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LUNARVINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LUNARVINE"
msgid "Vines for the slingshot. I want to see what grows out of that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Moonglass pellets. I'll pick them up by the smooth end."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONROCK"
msgid "Little moon rocks for a slingshot. Can I get the leftovers?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN"
msgid "Obsidian rounds. Mind the edges when you load them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_RUBBER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_RUBBER"
msgid "Rubber rounds. Don't make me chase them when they bounce."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SALT"
msgid "These leave salt all over my hand. I'm getting a new pouch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SHADOW"
msgid "I almost lost those shadow pellets in the bottom of my bag."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SLIME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SLIME"
msgid "That slime round is trying to stick to the next one."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR"
msgid "I touched one. Now I need something to get tar off my thumb."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TREMOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TREMOR"
msgid "A tremor round. Put the cups down before you try it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_GNASHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_GNASHER"
msgid "Wixie, I'd like to see what that one hits. I'll stand behind you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_MATILDA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_MATILDA"
msgid "That band looks tighter than the last one."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOBBERLOBBER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOBBERLOBBER"
msgid "That's a long way to go to avoid spitting by yourself."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE"
msgid "It clings to my fingers. Why did I touch it twice?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGESTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGESTACK"
msgid "That stack's where the smell gets stronger."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_CORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_CORK"
msgid "The cork's huge. Which hole needs that much plugging?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_OIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_OIL"
msgid "Oil on the water. It gets everywhere if I stir it up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_SACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUDGE_SACK"
msgid "The bag's sticky on the wrong side."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLFISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLFISHMEAT_DRIED"
msgid "Little strip of fish. Good for a short walk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPDRAGON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPDRAGON"
msgid "The flower's closer to my hand than it was."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPDRAGON_BUDDY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPDRAGON_BUDDY"
msgid "If you're hungry, come along. I'm looking for lunch too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLE"
msgid "Look at that shell. Now look where the mouth is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLEBABY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLEBABY"
msgid "Small turtle. The jaws already look finished."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLENEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPERTURTLENEST"
msgid "I'd leave the turtle nest the way I found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPLANT"
msgid "Put it in the dirt. I want to see what shape it grows into."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOTROAST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOTROAST"
msgid "I'd send it back if anybody claimed to have cooked it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWBALL_THROWABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWBALL_THROWABLE"
msgid "Wait till I've put my bag down. Then we can throw."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWCONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWCONE"
msgid "Ice for lunch. I'm going to regret how fast I eat it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWGOGGLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWGOGGLES"
msgid "Now I can look into blowing snow without squinting."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMONG"
msgid "It's moving under the snow. Watch where you put your feet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWPILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWPILE"
msgid "There's more snow here than I'd care to shovel."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_BRINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_BRINE"
msgid "Salt crust on the speaker. The sound still gets out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_RUSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_RUSTED"
msgid "It's rusted through in spots. How is that still playing?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_SPECTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAKER_SPECTER"
msgid "The speaker looks wrong. So does the thing I can hear from it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPECTER_SHIPWRECK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPECTER_SHIPWRECK"
msgid "That wreck doesn't look all there. Part of it keeps fading."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE"
msgid "Last time I saw the queen, she was a lot quicker."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_TRAPDOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_TRAPDOOR"
msgid "It came out of the dirt! Move!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOREHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOREHOUND"
msgid "Those spores are coming off the hound. Stay upwind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOREPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOREPACK"
msgid "I can smell the pack without turning my head."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON"
msgid "If he's pouring, I want to see what's in the glass first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON_SHADOW_TONIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON_SHADOW_TONIC"
msgid "I can see through the glass. I can't see through what's in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON_SHADOW_TONIC_FANCY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STANTON_SHADOW_TONIC_FANCY"
msgid "Nicer glass. Same feeling I shouldn't drink it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEAMEDHAMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEAMEDHAMS"
msgid "That looks like lunch. Did you leave me a seat?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_COPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_COPPER"
msgid "That copper wheel feels solid. Good, I lean on it a lot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_COPPER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_COPPER_ITEM"
msgid "Put it somewhere I can get two hands on the wheel."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFED_PEEPER_POPPERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFED_PEEPER_POPPERS"
msgid "I get the feeling lunch is looking back at me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUMPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUMPLING"
msgid "I thought leaving the stump was the easy part."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNGLASSES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNGLASSES"
msgid "Now I can look at the sunlit ground without squinting."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_BLUE"
msgid "Blue chest. Good thing I saw it against the bottom."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_GREEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_GREEN"
msgid "Green trim. Took me a while to get the chest out of the water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_ORANGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_ORANGE"
msgid "The orange chest is a lot easier to spot up here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_PURPLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_PURPLE"
msgid "Purple. Somebody must've wanted it to look expensive."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RAINBOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RAINBOW"
msgid "I can see all the colors now that the chest is out of the water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RANDOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RANDOM"
msgid "Royal chest, all the way down there. How did they lose it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_RED"
msgid "Red chest coming up. Get it before I lose my grip."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST_ROYAL_YELLOW"
msgid "There's yellow under the muck. Give me a cloth."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWILSON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWILSON"
msgid "From here that almost looks like Wilson."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THEATERCORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THEATERCORN"
msgid "I have the popcorn. Is anybody putting on a show?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THE_REAL_CHARLES_T_HORSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THE_REAL_CHARLES_T_HORSE"
msgid "All right, that's a real horse. Now what?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDDLESTRANGER_RNE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDDLESTRANGER_RNE"
msgid "I can hear him in the fog. I'm still not sure what he's saying."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADLING"
msgid "Little toad. Still too close to that weird mushroom."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADLINGSPAWNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADLINGSPAWNER"
msgid "If something hops out of there, I'm moving first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOOR"
msgid "I thought there was nothing there. Then I saw the edge."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.BARREN"
msgid "That patch needs fertilizer before it grows again."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.BURNING"
msgid "That patch of grass caught fast. Stand back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.DISEASED"
msgid "The grass looks sick all the way down to the roots."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.DISEASING"
msgid "The ends are changing color. It might be getting sick."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.GENERIC"
msgid "It's grass. Why am I checking for holes under it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.PICKED"
msgid "Cut back already. I'll check for new shoots later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAPDOORGRASS.WITHERED"
msgid "The heat's got to it. No new growth till it cools down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_WATHOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_WATHOM"
msgid "I'll keep the broken piece somewhere it won't break again."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_WATHOM1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_WATHOM1"
msgid "That's Wathom's, if he still wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_AMBER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_AMBER"
msgid "There's something in the amber. Hold it up to the light."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ARMOR_PYRE_NETTLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ARMOR_PYRE_NETTLES"
msgid "I can wear nettles now. How far do I have to walk in this?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP"
msgid "Stop right there. There's a trap by your foot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_EQUIPPABLE_GOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_EQUIPPABLE_GOLD"
msgid "Gold on the jaws. That won't make me reach between them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_EQUIPPABLE_TOOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_EQUIPPABLE_TOOTH"
msgid "I can see the teeth around the rim. I'll hold it from the other end."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_OLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEAR_TRAP_OLD"
msgid "Rusty jaws. I don't think that makes them safe."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_BLOCKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_BLOCKER"
msgid "They're thick enough to stop me walking through. I tried looking for a gap."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_SEEKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_SEEKER"
msgid "I think that guard's looking for us. It turned when I moved."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_SHOOTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUARD_SHOOTER"
msgid "Something flew past my ear before the bee did."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BEEGUN"
msgid "If the bees come out the back, I'm dropping it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BLOWDART_PYRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BLOWDART_PYRE"
msgid "The tip's warm. Keep it away from the dry grass."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BOOMBERRYPIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BOOMBERRYPIE"
msgid "I was expecting a pie that stayed quiet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BRINEISHMOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_BRINEISHMOSS"
msgid "That moss has been sitting in salt water. I can smell it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_CHILES_EN_NOGADA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_CHILES_EN_NOGADA"
msgid "Hit me with the cold part first. Then I'll try the pepper."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_COALESCED_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_COALESCED_NIGHTMARE"
msgid "I can see the edge moving. Tell me you can too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_COPPER_PIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_COPPER_PIPE"
msgid "Copper tube. I'm putting it down where it won't roll."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DEVILED_EGGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DEVILED_EGGS"
msgid "I'll have half of one. Save the other half till I ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DREAMCATCHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DREAMCATCHER"
msgid "Hang it where I sleep. I'll see how I feel in the morning."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DURIAN_CREAM_MARSHCAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_DURIAN_CREAM_MARSHCAKE"
msgid "Yes, I can smell what's in the cream. Pass me a slice anyway."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MAGNERANG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MAGNERANG"
msgid "Let it come back on its own. Keep metal out of its way."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MAGNERANGREEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MAGNERANGREEL"
msgid "The reel pulls metal in. Don't leave your keys near it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MONSTEREGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MONSTEREGG"
msgid "Small egg. The spots don't look like any bird's I've seen."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MONSTEREGG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_MONSTEREGG_COOKED"
msgid "It's fried. The colour didn't get any less suspicious."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_BEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_BEAK"
msgid "That's the part we were keeping the boat away from."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_EYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_EYE"
msgid "The eye's up. I don't think the rest is far behind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_EYETACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_EYETACLE"
msgid "A tentacle that can look over the rail. That's new."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_OCUPUS_TENTACLE"
msgid "A tentacle's reaching for the hull. Pull away!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ORNAMENT_OPOSSUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ORNAMENT_OPOSSUM"
msgid "Cute opossum. I'll hang it low enough to reach."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ORNAMENT_RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_ORNAMENT_RAT"
msgid "Finally a rat that won't disappear with my stuff."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PAWN"
msgid "I can hear that piece getting louder. Stop there."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PAWN_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PAWN_NIGHTMARE"
msgid "What's around the pawn wasn't there before."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PYRE_NETTLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_PYRE_NETTLES"
msgid "Don't push through the nettles. See the heat coming off them?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_RICE_PUDDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_RICE_PUDDING"
msgid "Soft rice and a spoon. Dinner can be this simple sometimes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SAND"
msgid "I'll brush it off. Then I'll find some more in my cuffs."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SANDHILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SANDHILL"
msgid "I'm not climbing the whole sandhill if there's a way around."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SCORPION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SCORPION"
msgid "I see the tail. There's no good reason to get closer."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SCORPIONHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SCORPIONHOLE"
msgid "Something dug a neat hole here. I don't want to put my hand in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SMOLDER_SPORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SMOLDER_SPORE"
msgid "It's already smoking. I'm not keeping it in my pocket."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SPIDERQUEENCORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_SPIDERQUEENCORPSE"
msgid "That's bigger than the shed. And it smells worse."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_THULECITE_RAZOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_THULECITE_RAZOR"
msgid "Looks sharp even around the old chips."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_TORNADO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_TORNADO"
msgid "That's picking up things I can't even lift. Get clear!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_WATERFALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_WATERFALL"
msgid "Anything I say next to that is a waste of breath."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_WITCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UM_WITCH"
msgid "Tell me if she raises her hands. I'm not looking away."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_BLOWGUN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_BLOWGUN"
msgid "That tube's for darts. I only get one breath per shot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_FISHINGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_FISHINGNET"
msgid "I can haul this up with both hands. You'll have to steer."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOON"
msgid "That's meant to be thrown. Give my arm a little room."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOONREEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOONREEL"
msgid "If I pull the reel, I don't have to go swimming after the harpoon."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOON_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_HARPOON_HEAVY"
msgid "The extra weight's all at one end. I'll get used to it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_PACKRAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_PACKRAT"
msgid "Hey, it's carrying our stuff! Check your pockets!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RAT"
msgid "This one's looking right at the food chest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RATBURROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RATBURROW"
msgid "I recognize that pile of dirt. Don't reach in."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RATHERD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_RATHERD"
msgid "They're all going the same way. We should see where it leads."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_TOAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_TOAD"
msgid "That toad looks sick. It hasn't slowed down, though."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_WINKYBURROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_WINKYBURROW"
msgid "Winky was here, I guess. Watch the hole."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_WINKYHOMEBURROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNCOMPROMISING_WINKYHOMEBURROW"
msgid "That's Winky's place. I'll call from out here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT"
msgid "Keep the teeth to yourself. I've already got a bat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VETERANSHRINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VETERANSHRINE"
msgid "I can read the offer. I'm looking for the part about the cost."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VETSITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VETSITEM"
msgid "It won't work for me. I need whatever power the shrine gives you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERFRUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERFRUIT"
msgid "The fruit's got a mark I don't recognize."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERJAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERJAM"
msgid "Tell me whether the jam moves before I put it on toast."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERWORM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VIPERWORM"
msgid "There's a dark streak where it moves."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_EMPTY"
msgid "Nobody home. I can still see where they put the fire."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_SUMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_SUMMER.EMPTY"
msgid "The summer camp's quiet. I can check it from outside."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_SUMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP_SUMMER.GENERIC"
msgid "Somebody's camping here even in summer. Do we have to meet them?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_LANTERN"
msgid "That's a perfectly good watermelon with a light where lunch goes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.ATTACKER"
msgid "%s, I don't think either of us wants to do this."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.FIRESTARTER"
msgid "%s, whatever started it, we have to put it out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.GENERIC"
msgid "%s, are you sitting here? I can move my bag."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.GHOST"
msgid "%s, I hear you. Stay where I can find you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.MURDERER"
msgid "%s, enough. I won't let you hurt anyone else."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHOM.REVIVER"
msgid "%s, I'm glad you got there first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBEDCREATURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBEDCREATURE"
msgid "Something's still in that cocoon. I saw it move."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD"
msgid "Plant it and see what comes out. I'll listen from here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD_NORMAL_GROUND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD_NORMAL_GROUND.GENERIC"
msgid "It's in the ground. Does it need a seed to get started?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD_NORMAL_GROUND.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHISPERPOD_NORMAL_GROUND.GROWING"
msgid "Something's sprouting. I'll try to leave it alone."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKER_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKER_TENTACLE"
msgid "It's already losing its shape. I don't want it touching me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIDOWSGRASP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIDOWSGRASP"
msgid "If this cuts the silk, let me try the loose end first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIDOWSHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIDOWSHEAD"
msgid "I see too much from inside this thing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.ATTACKER"
msgid "%s, keep your teeth off me. We can talk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.FIRESTARTER"
msgid "%s, what caught first? Show me so I can put it out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.GENERIC"
msgid "%s, if you saw where my snacks went, just tell me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.GHOST"
msgid "%s, stay where I can see you. I'll find a heart."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.MURDERER"
msgid "%s, get away from them. I won't ask twice."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINKY.REVIVER"
msgid "%s, you found a way to bring them back. Thank you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH_ITEM"
msgid "I'd set the larger power kit down before taking the cover off."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH_ITEM_UM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH_ITEM_UM"
msgid "The big generator kit. I'll set it down before I unpack it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW_ITEM"
msgid "One little power kit. I can carry it if that's all you need."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW_ITEM_UM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW_ITEM_UM"
msgid "It's Winona's smaller generator. Which way does the lid go?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT_ITEM"
msgid "It's the catapult in the box. How are these parts supposed to stay together?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT_ITEM_UM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT_ITEM_UM"
msgid "A catapult in parts. I hope there's a spot clear for testing it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT_ITEM"
msgid "I know it's the light kit. I can't tell which way it's supposed to face."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT_ITEM_UM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT_ITEM_UM"
msgid "A spotlight kit. I'd like it to face away from my bed."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TOOLBOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TOOLBOX"
msgid "Those tools are packed tighter than I could ever get them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_UPGRADEKIT_ELECTRICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_UPGRADEKIT_ELECTRICAL"
msgid "There are too many wires for me to guess."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.ATTACKER"
msgid "%s, take the shot out of the slingshot. We need to talk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.FIRESTARTER"
msgid "%s, there are better ways to get my attention."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.GENERIC"
msgid "%s, how's the slingshot holding up?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.GHOST"
msgid "%s, I'll find a heart. Can Charles wait with you?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.MURDERER"
msgid "%s, put the slingshot down. We're done here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE.REVIVER"
msgid "%s, I know who brought them back. Thanks."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIEGUN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIEGUN"
msgid "Whatever practice you had planned, find an empty field first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_CLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_CLOCK"
msgid "I can hear it ticking. I can't find where to open it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_PIANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_PIANO"
msgid "I learned part of a song once. I'll spare you the part I didn't."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_WARDROBE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIXIE_WARDROBE"
msgid "I can tell whose wardrobe it is by what's sticking out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODPECKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODPECKER"
msgid "I get a headache just listening to it knock that hard."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWGEM_CRACKED"
msgid "I can still see the yellow shine through the damage."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOW_VOMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOW_VOMIT"
msgid "Bright yellow. I know exactly where not to step."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ZASPBERRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ZASPBERRY"
msgid "My tongue tingled before I finished chewing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ZASPBERRYPARFAIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ZASPBERRYPARFAIT"
msgid "The berries make my mouth buzz through the cream."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.GAS_DAMAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.GAS_DAMAGE"
msgid "Cough! I need air!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.1"
msgid "The pact was never yours."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.2"
msgid "The mark is absent."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANCURSED.3"
msgid "You bear no curse for me to lift."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.1"
msgid "I asked for a skull. This will not do."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.2"
msgid "That is no offering for this pact."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.NOT_VETERANSKULL.3"
msgid "Bring me what the curse demands."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.1"
msgid "YOU HEARD SOMEONE OUTSIDE THE ROOM. YOU WERE ALONE."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.2"
msgid "YOU LEFT YOUR BAT WHERE YOU ALWAYS DO. REACH FOR IT."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.SHADOWTALKER.3"
msgid "YOU DON'T HAVE TO CLOSE YOUR EYES TO KNOW WHAT'S THERE."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.1"
msgid "Your glass. Let's see whether you can keep it steady."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.2"
msgid "Here you are. Don't spend all night sniffing it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GIVE.3"
msgid "Drink. I'll wait till you put it down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.1"
msgid "You looked steadier a moment ago."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.2"
msgid "Sit down. You already lost."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_GLOAT.3"
msgid "You'll get your legs back. You won't get this round back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.1"
msgid "Have a sip or set it down. I'm waiting."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.2"
msgid "The glass isn't going to drink itself."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_IMPATIENT.3"
msgid "I poured it for you to drink. Decide already."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.1"
msgid "When the last light goes out, the dead pull up a chair."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.2"
msgid "Just short of midnight, bones sit down beside you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET1.3"
msgid "At the end of daylight, an empty stool finds a guest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.1"
msgid "Stop talking. There's still something in your glass."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.2"
msgid "The room is quiet now. Drink while it is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET2.3"
msgid "The next word can wait till you've swallowed."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.1"
msgid "Play against the dead and they can wait you out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.2"
msgid "It was his game before you sat down. You knew the odds."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET3.3"
msgid "The dead never have to leave the table. You will."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.1"
msgid "Here's to the guest who came in cold."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.2"
msgid "Raise the glass to someone who no longer breathes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET4.3"
msgid "Drink up. Your host has been dead a long time."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.1"
msgid "One last round with the dead."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.2"
msgid "The living leave. The dead keep drinking."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_POET5.3"
msgid "Finish your drink. I'll still be here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.1"
msgid "One seat, one guest. Everyone else waits."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.2"
msgid "Wait your turn. I'm drinking with this one right now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_RULES.3"
msgid "No passing the glass. It's their round."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.1"
msgid "I'm taking the glass back. We're done."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.2"
msgid "Too late. Get up and let somebody else sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.STANTON_SUPERIMPATIENT.3"
msgid "You had your chance. I'm closing the bottle."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.1"
msgid "The pact holds. Return bearing skulls."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.2"
msgid "You bear the mark now. Remember the offering."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSED.3"
msgid "The curse is yours. Come back when you have paid."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.1"
msgid "Come closer. There is a price for what you seek."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.2"
msgid "You came for a challenge. Put your hand on the shrine."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.VETERANCURSETAUNT.3"
msgid "You may take the pact. You will have to see it through."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.WEBBEDCREATURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.WEBBEDCREATURE"
msgid "I can't get through silk this thick with a bat."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL.1"
msgid "Save the power. The meter's full."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL.2"
msgid "There's no room for more charge."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE.1"
msgid "We have to charge the source first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE.2"
msgid "Not enough power. Got another one?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GIVE.NOTNIGHT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GIVE.NOTNIGHT.1"
msgid "Too early. I'll hold on to it till the moon's out."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GIVE.NOTNIGHT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GIVE.NOTNIGHT.2"
msgid "I'm not standing here till nightfall."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.READ.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.READ.GENERIC.1"
msgid "I got through the whole page. Still nothing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.READ.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.READ.GENERIC.2"
msgid "I can read the words. They don't do anything."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.UPGRADE.NOT_HARVESTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.UPGRADE.NOT_HARVESTED.1"
msgid "There's still something to take out first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.UPGRADE.NOT_HARVESTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.UPGRADE.NOT_HARVESTED.2"
msgid "Let me harvest that first. Then we can work on it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.WINONATOOLBOX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.WINONATOOLBOX.1"
msgid "I don't know what half these tools do."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.WINONATOOLBOX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.WINONATOOLBOX.2"
msgid "Keep the lid on. I don't want to put her tools back wrong."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.1"
msgid "What did I just eat? I feel strange."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.2"
msgid "Give me a minute. Something's changed."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.1"
msgid "The next thing to hit me is going to feel that charge."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.2"
msgid "Keep your hands to yourself. I'm sparking."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.1"
msgid "It's cold all the way down to the grip."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.2"
msgid "If I keep moving, maybe my teeth will stop chattering."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.1"
msgid "I'll take the front for once. I feel up to it now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.2"
msgid "Whatever's out there can show itself."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.1"
msgid "I could take a shove without moving an inch."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.2"
msgid "I feel heavier. Good thing I don't have to run."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.1"
msgid "For once I can forget about lunch."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.2"
msgid "That'll keep me going longer than I expected."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.1"
msgid "My next swing's going to have a little extra kick."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.2"
msgid "There's a crackle every time I lift my hand."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.1"
msgid "I can feel it already. This is going to be a long day."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.2"
msgid "I took the deal. Now I'm finding out what it costs."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.1"
msgid "That went right up my arm!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.2"
msgid "Next time, I'm wearing gloves. Both of them."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.1"
msgid "The sparks stayed on the other side of the insulation."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.2"
msgid "Full charge and I can still feel all my fingers."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.1"
msgid "Things look familiar again. That took a while."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.2"
msgid "Whatever the food did, it wore off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.1"
msgid "You can come closer now. I'm done crackling."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.2"
msgid "My hair finally came down. That's how I know."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.1"
msgid "My grip's warming up. I like it better this way."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.2"
msgid "Good. I can finish a sentence without chattering."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.1"
msgid "I think I've got my usual amount of fear back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.2"
msgid "You can have the front again. I won't argue."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.1"
msgid "Whatever kept me planted just wore off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.2"
msgid "Next hit, I'm getting out of the way."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.1"
msgid "There goes my extra time between meals."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.2"
msgid "My appetite's back. I can smell dinner from here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.1"
msgid "Back to regular swings. I can work with that."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.2"
msgid "No more static in my hand. The charge is gone."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.1"
msgid "I don't feel it hanging over me anymore."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.2"
msgid "The curse let go. I need to sit down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DREADEYE_SPOOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DREADEYE_SPOOKED.1"
msgid "Something was right there! Turn the light this way."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DREADEYE_SPOOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_DREADEYE_SPOOKED.2"
msgid "Give me a second. My heart's still racing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.1"
msgid "I can't bring you back this way. Stay nearby anyway."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.2"
msgid "Guess I need more than a heart. Give me a minute."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1"
msgid "The pollen's back. I can feel it in my nose."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2"
msgid "Hold on. I think I'm about to sneeze."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1"
msgid "My nose cleared up. Where were we going?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2"
msgid "That's better. I can put the tissues away."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.AUTUMN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.AUTUMN.1"
msgid "That cream was better than it smelled."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.AUTUMN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.AUTUMN.2"
msgid "It's autumn and I can still smell it across the room."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SPRING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SPRING.1"
msgid "Spring has enough smells. At least this one comes with cake."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SPRING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SPRING.2"
msgid "I should've eaten under a roof. Now my cake's wet."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SUMMER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SUMMER.1"
msgid "The cream's getting warm. Better finish it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SUMMER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.SUMMER.2"
msgid "Tastes like summer. Smells like it sat in the sun, too."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.WINTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.WINTER.1"
msgid "That's a tropical cake all right. I can still see my breath."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.WINTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MARSHCAKE_BONUS.WINTER.2"
msgid "I wasn't expecting that flavour in the middle of winter."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NORATBURROWS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NORATBURROWS.1"
msgid "No dens within sniffing distance. Can I take this off?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NORATBURROWS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NORATBURROWS.2"
msgid "I can't find another burrow around here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.OVERSTUFFED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.OVERSTUFFED.1"
msgid "I need to sit down. Actually, don't make me bend that far."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.OVERSTUFFED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.OVERSTUFFED.2"
msgid "Nobody bring me another plate. I'm serious."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.STUFFED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.STUFFED.1"
msgid "Save me the rest for later. I can't finish it now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.STUFFED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OVER_EAT.STUFFED.2"
msgid "That's all I can fit. Good meal, though."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.1"
msgid "I can pick it up once I'm out of the water. Come on!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.2"
msgid "The raft won't stay afloat. Where's the bank?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID.1"
msgid "Something small's running around. Get the food inside."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID.2"
msgid "That wasn't a floorboard. Watch the ground."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.1"
msgid "They left. Where'd they put my stuff?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.2"
msgid "It's quiet again. Check the camp before sitting down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.1"
msgid "They're coming for the supplies. Move the bags!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.2"
msgid "Hey! That's my lunch you're carrying off!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.LEVEL_1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.LEVEL_1.1"
msgid "I keep finding fresh dirt where there used to be grass."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.LEVEL_1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.LEVEL_1.2"
msgid "Too many rats for one hole. Look farther from camp."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.1"
msgid "We keep leaving spoiled food out. No wonder they come around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.2"
msgid "Go through the supplies. Anything that stinks needs to go."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.1"
msgid "The rats are going to pick through all this if we let them."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.2"
msgid "I can't see the ground under our junk. Time to tidy up."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.1"
msgid "Something moved. I don't think it was the fog."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.2"
msgid "The air changed. I want a light in my hand."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOTING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOTING.1"
msgid "I can't lift either foot. Look down here!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOTING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOTING.2"
msgid "The roots came up right under me!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.1"
msgid "I swallowed it before I thought about what it was. Ow."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.2"
msgid "It was still smoking. Why did I think that was food?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.1"
msgid "The spore went off in my pocket!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.2"
msgid "My stuff's on fire! Make some room!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1"
msgid "Achoo! ...I almost held that one in."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2"
msgid "Hh... ACHOO! Can you pass me a tissue?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.1"
msgid "The wind picked up. We need somewhere out of it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.2"
msgid "Don't lose the path. I can't see our tracks anymore."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.1"
msgid "Watch your feet. Those aren't ordinary mushrooms."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.2"
msgid "The ground's moving. Get onto a clear patch!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.1"
msgid "I don't see anything spinning. We can keep going."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.2"
msgid "All clear. I can take my hand off my hat."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.1"
msgid "I'll hold the light while you do the wiring."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.2"
msgid "Show me where to put it before I touch anything."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ATTACKED_CRABKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ATTACKED_CRABKING.1"
msgid "The shell's too solid. I need a different angle."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ATTACKED_CRABKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ATTACKED_CRABKING.2"
msgid "My bat isn't getting through. Bring the boat around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.1"
msgid "Something bit my hand! I was only trying to hold it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.2"
msgid "That's got a curse on it all right. My palm's burning."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.1"
msgid "I can breathe near it. That's good enough for me."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.2"
msgid "The air's better on this side. I'm staying here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.1"
msgid "Keep clear of the horns. They're already charged."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.2"
msgid "I can hear that thing from here. I'm not walking closer."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.1"
msgid "Dirt from under those huge trees. It barely saw daylight."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.2"
msgid "Put the old earth back where the roots were."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.1"
msgid "I know it looks familiar. I don't know if that's a good thing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.2"
msgid "I'll leave the necklace off until I know what it wants from me."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIHISTAMINE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIHISTAMINE.1"
msgid "Save some for when the pollen's out."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIHISTAMINE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIHISTAMINE.2"
msgid "I'd take it even if it tastes awful. I'm tired of sneezing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APHID.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APHID.1"
msgid "I can see the leaf it's been chewing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APHID.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APHID.2"
msgid "It's tiny. Why are there always so many of them?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.1"
msgid "I hope that's supposed to be moving."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.2"
msgid "Next time I want armor, remind me to ask for something cooler."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.1"
msgid "Leave some space around the glass. It cuts."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.2"
msgid "It glints when I turn. Better not brush the walls."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.1"
msgid "I can't step back without checking where the shards are."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.2"
msgid "That's my armor doing that. Keep your distance anyway."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.1"
msgid "Woven reeds. At least I can move my arms."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.2"
msgid "It rustles a little, but it's better than carrying a slab of rock."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.1"
msgid "How much of the shark did it take to make this?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.2"
msgid "It fits. Don't ask me what it smells like."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.1"
msgid "I could rig a whole gym floor with these."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.2"
msgid "Pick that one up. It'll roll under something if you wait."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.1"
msgid "The grip's all right. The beak's the part I'm worried about."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.2"
msgid "At least this beak doesn't get to decide what it hits anymore."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.1"
msgid "I can see what made all those marks in the dirt."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.2"
msgid "Does it count as a rake if the original owner was this big?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.1"
msgid "I want to know who looked at a beefalo and thought of wings."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.2"
msgid "Pass the plate. Whatever they're called, I'm hungry."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.1"
msgid "It looks like it'd matter to somebody. I'll keep it safe."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.2"
msgid "I can't tell what's inside without shaking it. I'll put it down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.1"
msgid "I thought the cat was stitched to stay still."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.2"
msgid "Soft paws. Still don't want it sneaking up on me."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.1"
msgid "That bear takes bigger steps than you'd think."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.2"
msgid "It walked past me. For once I didn't imagine that."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.1"
msgid "Big enough to block the whole way now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.2"
msgid "I'm glad the stuffed cat's on our side."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.1"
msgid "Let the big bear go first. He's got it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.2"
msgid "Somebody gave the teddy bear a growth spurt."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.1"
msgid "Ashley can stay on the shelf till somebody brushes that off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.2"
msgid "It looks scorched, but I think the cat's still in one piece."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.1"
msgid "It'll take more than one stitch to fix those paws."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.2"
msgid "Don't pick it up by the tail. It's barely hanging on."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.1"
msgid "Pick up the stuffing before it blows away."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.2"
msgid "Bernie's falling apart. Lay him flat for now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.1"
msgid "Burnt, but I can still see both of Bernie's eyes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.2"
msgid "You smell like a campfire, Bernie."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIGHT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIGHT.1"
msgid "I don't trust anything that wakes up when I get close."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIGHT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIGHT.2"
msgid "It's alive. Keep a light on it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIRCHLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIRCHLING.1"
msgid "That's a birch, and it can walk. I saw both parts."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIRCHLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIRCHLING.2"
msgid "Let it get tired before we try getting past it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.1"
msgid "That one goes in the dry pocket."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.2"
msgid "A dart and a shock in one. Good thing I'm holding the blunt end."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.1"
msgid "Don't load it and then forget which one you put in."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.2"
msgid "Does it have to smell like smoke while I'm holding it?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.1"
msgid "Save that one for something that won't settle down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.2"
msgid "Point it away from me. I'll sleep when I want to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.1"
msgid "It's small. I could drop that in the grass and never see it again."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.2"
msgid "I've seen where the teeth come from. I'd rather open the pouch than a hound's mouth."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.1"
msgid "Can I take the one that got crispy around the edge?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.2"
msgid "I can stay awake long enough for pancakes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.1"
msgid "I'll wait for the ice to melt before I touch the berries."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.2"
msgid "Too cold to pick. I don't want to break off the branches."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.1"
msgid "That's a good patch. Can we plant some closer to camp?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.2"
msgid "I could get a whole bowlful from this one."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.1"
msgid "There's still life in the stem. We'll have more later."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.2"
msgid "Come back when the leaves have filled out a bit."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.1"
msgid "It looks fine from a distance. Look closer before you try to use it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.2"
msgid "The split goes right through. I'll save it for something that can take a damaged gem."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.1"
msgid "I'm not sorting that out with my fingers."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.2"
msgid "If we need a whole mushroom, we're too late."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATPATCH_SLUDGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATPATCH_SLUDGE.1"
msgid "It's going on the leak. I'd rather not have to peel it off later."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATPATCH_SLUDGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATPATCH_SLUDGE.2"
msgid "Check the crack after I stick this on."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.1"
msgid "I'll put it together before we push off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.2"
msgid "Get it mounted while we're still on dry land."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.1"
msgid "Good. I'd rather hit something with that than with the hull."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.2"
msgid "I hope we don't have to find out how well it works today."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.1"
msgid "I'll put it together before we push off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.2"
msgid "Get it mounted while we're still on dry land."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.1"
msgid "Good. I'd rather hit something with that than with the hull."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.2"
msgid "I hope we don't have to find out how well it works today."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.1"
msgid "Reading this one means checking the sky first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.2"
msgid "It brings rain. I hope nobody's still hanging their clothes out."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRINE_BALM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRINE_BALM.1"
msgid "Salt in the balm. I'll put it on carefully."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRINE_BALM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRINE_BALM.2"
msgid "It'll do till I find a clean bandage."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.1"
msgid "I can hear it working. That is a lot of bugs."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.2"
msgid "Stay clear of the wire. Let the bugs find it first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.1"
msgid "I can hear it coming. I'm keeping the bat up."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.2"
msgid "That's close enough. I don't need to count its stripes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.1"
msgid "Don't hold it any longer than you have to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.2"
msgid "My next move is finding somewhere else to put it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.1"
msgid "Claws under the leaves. I won't reach in twice."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.2"
msgid "Does every shrub have a crab under it now?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.1"
msgid "I need to know what's in it before I agree to try it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.2"
msgid "It looks like a proper dinner if I don't look too hard."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.1"
msgid "Keep it close to the cannon. I'm not carrying that across the boat twice."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.2"
msgid "Somebody clean the barrel after we use this."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL.1"
msgid "Too many people below. I can sit here for a minute."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.FULL.2"
msgid "Get me when there's room for one more."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC.1"
msgid "Something's blocking the way below."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.GENERIC.2"
msgid "Guess I'll find another entrance."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN.1"
msgid "Hold the light over the opening. I'll go first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_OPEN_SUNKDECID.OPEN.2"
msgid "We'll have to watch our footing down there."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_SUNKDECID.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_SUNKDECID.1"
msgid "We'll see what's there if we can move that stone."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_SUNKDECID.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_ENTRANCE_SUNKDECID.2"
msgid "I can see where the ground has sunk around it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL.1"
msgid "Wait till the top clears. I'll be here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.FULL.2"
msgid "Can somebody up there move over a little?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC.1"
msgid "I wanted fresh air. Guess I'll wait a little longer."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.GENERIC.2"
msgid "I don't think I can climb out right now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN.1"
msgid "I can see the light up there. That's our way out."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_SUNKDECID.OPEN.2"
msgid "Hand me my bag once I'm out."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.1"
msgid "Put that aside till we know who it belongs to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.2"
msgid "It looks like something somebody would want back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.1"
msgid "Put that aside till we know who it belongs to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.2"
msgid "It looks like something somebody would want back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.1"
msgid "Put that aside till we know who it belongs to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.2"
msgid "It looks like something somebody would want back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_NAMES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_NAMES.1"
msgid "Put that aside till we know who it belongs to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_NAMES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_NAMES.2"
msgid "It looks like something somebody would want back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.1"
msgid "That's Wixie's horse. I'll ask before I pick it up."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.2"
msgid "If it moves, I'm going to put it right back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.1"
msgid "I'd listen a little longer if I knew who put it on."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.2"
msgid "It sounds old. The needle's still doing its job."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.1"
msgid "I can hear it coming. I'm keeping the bat up."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.2"
msgid "That's close enough. I don't need to count its stripes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.1"
msgid "Don't hold it any longer than you have to."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.2"
msgid "My next move is finding somewhere else to put it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMP.1"
msgid "Go on, find something to do that doesn't involve my bag."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMP.2"
msgid "It's watching. I'm watching it back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.GENERIC.1"
msgid "It's quiet. For now. I'll close it while I can."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.GENERIC.2"
msgid "Some of these lines are easier to read in the dark. That's wrong."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.NEEDSFUEL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.NEEDSFUEL.1"
msgid "I'll close it till we've got something to feed it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.NEEDSFUEL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.NEEDSFUEL.2"
msgid "No charge left in the book. I can tell by the pages."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.1"
msgid "The purple didn't cook out of it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.2"
msgid "It's a little bite. Maybe I shouldn't let that convince me."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORNCAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORNCAN.1"
msgid "I want to know how long the corn's been in there. No, I don't."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORNCAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORNCAN.2"
msgid "At least the can didn't leak in my bag."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.1"
msgid "I can put gems in this? I was worried about my hand."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.2"
msgid "It's not attached to the crab anymore. Why does that barely help?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.1"
msgid "If it comes out, let it sniff me first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.2"
msgid "I'm looking for a pet that can sit still longer than I can."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.1"
msgid "The stone's chipped away near the opening. We can fix that."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.2"
msgid "We'd better patch it before sending anything in."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.1"
msgid "I can look after you, if you don't need me up early."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.2"
msgid "It's light enough to pick up. I'll let it come to me first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.1"
msgid "I could swing it. I'm going to find out why it's cursed first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.2"
msgid "I hope the last thing that held it had better luck than I do."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.1"
msgid "I know who's keeping us here. Can we get through the ice now?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.2"
msgid "Let's clear a path before it fills in again."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.1"
msgid "That's a heavy slice. I'm cutting mine in half."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.2"
msgid "Smells like fruit. Maybe the rest of the name is for show."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.1"
msgid "I hope it gets the whole patch in one go."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.2"
msgid "If that helps the trees, I won't ask how they made it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.1"
msgid "I could blow till I'm out of breath and it still wouldn't rain."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.2"
msgid "Something's missing from this horn. Check before I try it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.1"
msgid "Long enough to cast from here. Good, I can stay seated."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.2"
msgid "I want a better grip before something pulls on the line."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.FULL.1"
msgid "Still in one piece, right down to the seams."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.FULL.2"
msgid "Nothing to mend yet."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.HALF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.HALF.1"
msgid "It'll last a bit longer, but I'd bring a spare."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.HALF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.HALF.2"
msgid "Those tears aren't staying that small."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.QUARTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.QUARTER.1"
msgid "It's barely holding together. Get a replacement."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.QUARTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.QUARTER.2"
msgid "I wouldn't trust those seams much longer."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER.1"
msgid "I can fix that before it gets worse."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DURABILITY_LEVEL.THREEQUARTER.2"
msgid "That's from wear. It's still usable."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.1"
msgid "I keep an eye on it. It keeps an eye on everything."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.2"
msgid "I wasn't planning to bring home an eyeball. Here we are."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY.1"
msgid "I saw it twitch. Might be ready to hatch."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_GROUNDED_ALLY.2"
msgid "Give it room. I don't want it opening right into my hand."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.1"
msgid "Soft enough to nap in. I'm starting to like it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.2"
msgid "Feels warm. Watch it if I go anywhere near a burr."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.1"
msgid "It can stay in my bag till the next stop."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.2"
msgid "This should last longer than the fish I forgot on the boat."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.1"
msgid "Smells better than most of the things I use on a cut."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.2"
msgid "Give me a piece I can tie with one hand."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.1"
msgid "If it wants these berries, it can get down here and ask."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.2"
msgid "I like fruit too. That doesn't mean I'm sharing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GARBAGEPATCHFLOTSAM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GARBAGEPATCHFLOTSAM.1"
msgid "Something useful might be floating under the junk."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GARBAGEPATCHFLOTSAM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GARBAGEPATCHFLOTSAM.2"
msgid "Get the hook. I'm not climbing into that mess."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASMASK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASMASK.1"
msgid "Fits tight around my face. Now I wish I'd tied my hair first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASMASK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASMASK.2"
msgid "Check the filter before we go back in."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.1"
msgid "A blueberry I have to pick up with both hands."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.2"
msgid "We can split it. Find something wider than my lunchbox."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.1"
msgid "The shade's good. I'm not sitting where that branch could reach."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.2"
msgid "I can get out of the rain here without walking back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.1"
msgid "If I can see it from down here, I don't want to meet the bird."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.2"
msgid "Keep an eye on the branches while I look."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.1"
msgid "Look where the leaves have gone thin. That's getting worse."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.2"
msgid "I can see the bugs from down here. There must be a lot of them."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.1"
msgid "Don't let it back you against the ice."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.2"
msgid "That one can chill more than my ankles if it catches up."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.1"
msgid "Glass, but not smooth on all sides. Pick it up carefully."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.2"
msgid "Good color. I'll hold it so nobody gets cut."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.1"
msgid "If I take a corner too fast in this, somebody's getting poked."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.2"
msgid "It's heavy on my forehead. Let me get used to it first."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.1"
msgid "It looks fine from a distance. Look closer before you try to use it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.2"
msgid "The split goes right through. I'll save it for something that can take a damaged gem."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENSTEAMEDHAMS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENSTEAMEDHAMS.1"
msgid "Somebody made a whole burger. I'll judge it after lunch."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENSTEAMEDHAMS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREENSTEAMEDHAMS.2"
msgid "Give me a plate. It's going to fall apart when I take a bite."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.1"
msgid "I'm not sorting that out with my fingers."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.2"
msgid "If we need a whole mushroom, we're too late."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.1"
msgid "Can we leave it here and go?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.2"
msgid "Whatever made that, give it some room."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.1"
msgid "I like the crunch. Don't tell me where the shell came from."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.2"
msgid "Hold the taco over the plate. I'm going to lose the filling."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.1"
msgid "I'll wear the rat mask. Don't make me look in a mirror."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.2"
msgid "The nose on this works. That's the part I care about."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.HUGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.HUGE.1"
msgid "That stone can keep its temperature for a long while."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.HUGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.HUGE.2"
msgid "I don't think another layer would help. It's ready."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.LARGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.LARGE.1"
msgid "The thermal stone ought to last through a good walk."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.LARGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.LARGE.2"
msgid "The weather won't get at it as fast with that much insulation."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.MED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.MED.1"
msgid "The thermal stone holds its temperature a little longer now."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.MED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.MED.2"
msgid "We're about halfway to keeping the wind off that thing."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.SMALL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.SMALL.1"
msgid "The stone's a bit sheltered. Still won't last long."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.SMALL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.SMALL.2"
msgid "A little protection for the thermal stone. I'll take it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.TINY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.TINY.1"
msgid "Barely any insulation. It'll change fast out here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.TINY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEATROCK_LEVEL.TINY.2"
msgid "It could use a cover. Anything at all."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEAT_SCALES_ARMOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEAT_SCALES_ARMOR.1"
msgid "I can still move my shoulders in it. Good."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEAT_SCALES_ARMOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HEAT_SCALES_ARMOR.2"
msgid "It won't make the heat go away. I hope it takes the edge off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.1"
msgid "The bark's sticky. I sort of want to know how far in it goes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.2"
msgid "Anybody want to carry the other end? My end's getting sticky."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.1"
msgid "It's soft under the roots. Don't let the patch fall apart."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.2"
msgid "I'd put it somewhere shady. It looks comfortable there."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.1"
msgid "I think that patch shifted. Please step somewhere else."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.2"
msgid "Look for the edges. Something built a door into the dirt."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.1"
msgid "I want to get through here with all my sleeves still attached."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.2"
msgid "Watch the legs. If one moves, we move."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.1"
msgid "Watch your face. The fronds hang low here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.2"
msgid "I can see why it got this big under the canopy."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED.1"
msgid "Keep your hands off it. We'll find another way around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.ACIDCOVERED.2"
msgid "Don't stand under it. Look what's dripping off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM.1"
msgid "Give the spores some room. My nose is bad enough."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.BLOOM.2"
msgid "It wasn't shedding all that last time I walked past."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC.1"
msgid "I'd rather not bump into that cap in the dark."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_MEDIUM.GENERIC.2"
msgid "A full-sized mushroom under a full-sized canopy."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED.1"
msgid "Keep your hands off it. We'll find another way around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.ACIDCOVERED.2"
msgid "Don't stand under it. Look what's dripping off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM.1"
msgid "Give the spores some room. My nose is bad enough."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.BLOOM.2"
msgid "It wasn't shedding all that last time I walked past."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC.1"
msgid "At least the cap's lower than my eyes."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_SMALL.GENERIC.2"
msgid "This one's small enough that I can see the top."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED.1"
msgid "Keep your hands off it. We'll find another way around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.ACIDCOVERED.2"
msgid "Don't stand under it. Look what's dripping off."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM.1"
msgid "Give the spores some room. My nose is bad enough."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.BLOOM.2"
msgid "It wasn't shedding all that last time I walked past."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC.1"
msgid "How does a mushroom get that tall without falling over?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOODED_MUSHTREE_TALL.GENERIC.2"
msgid "There's shade on both sides of that stalk."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.1"
msgid "Is that supposed to be looking out for us? It can stop looking at me."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.2"
msgid "I didn't think it could watch so many directions at once."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.1"
msgid "Cold enough that I want to throw it just to stop holding it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.2"
msgid "I'll give it a little room on the way back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.1"
msgid "I don't want to put this around my neck until it stops moving."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.2"
msgid "Those links look strong. I hope they're strong enough."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNOOK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNOOK.1"
msgid "I don't want to know how far its jaws open."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNOOK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNOOK.2"
msgid "Step back. Don't give that thing anything to bite."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAE2.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAE2.1"
msgid "It makes the ground warm where it crawls."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAE2.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAE2.2"
msgid "I might think it was cute if I could touch it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.1"
msgid "Go around the hot sludge. A wide way around."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.2"
msgid "Something spat that out? I'm not waiting for the next one."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LICELOAF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LICELOAF.1"
msgid "It looks like bread if I stand a step back."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LICELOAF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LICELOAF.2"
msgid "I think I'll save the loaf for when I run out of everything else."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.1"
msgid "I don't want to find out what an electric bite feels like."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.2"
msgid "Keep the lightning hound off the wet ground if you can."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.1"
msgid "Don't let it get into our food. Any of it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.2"
msgid "The rats already carried enough trouble without this one."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.1"
msgid "I don't trust a cave entrance covered that well."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.2"
msgid "Can somebody point the light down it before I climb in?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.1"
msgid "Don't let it pass the wood pile."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.2"
msgid "Can we lead the hot one somewhere that isn't covered in grass?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.1"
msgid "Get a light on it, if you can."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.2"
msgid "I'll get my bat up. You tell me which way it's looking."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.1"
msgid "I can pull on the grass. I don't want to step in after it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.2"
msgid "Check the bottom for water before you sit next to it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.1"
msgid "Put it on the mast. The wind's better up there."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.2"
msgid "One more thing to check when the sail starts shaking."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.1"
msgid "I'll leave the meat on the rack till it's done."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.2"
msgid "I can smell it, but it still needs time."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.1"
msgid "I'll move the meat under cover if it keeps coming down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.2"
msgid "That meat's getting wetter instead of drier."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.1"
msgid "Nothing's drying in weather like this."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.2"
msgid "I'd leave it out a little longer if there were any sun."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.1"
msgid "I can wait if you promise not to touch it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.2"
