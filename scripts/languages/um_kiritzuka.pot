msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.2"
