msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.1"
