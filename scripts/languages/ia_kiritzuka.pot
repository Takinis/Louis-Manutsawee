msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.2"
