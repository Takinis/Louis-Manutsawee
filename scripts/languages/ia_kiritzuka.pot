#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.2"
