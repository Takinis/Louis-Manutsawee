msgid ""
msgstr ""
"Application: Dont' Starve\n"
"Content-Type: text/plain; charset=utf-8\n"
"POT Version: 2.0\n"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.EMBARK.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.EMBARK.INUSE"
msgid "Someone's still on it. I'll wait on dry land."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ERASE_PAPER.FLOODED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ERASE_PAPER.FLOODED"
msgid "This paper's soaked. It'll tear if I rub it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.GENERIC.UNDERBOAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.GENERIC.UNDERBOAT"
msgid "My boat's right over it. I'll have to move."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.INSPECTBOAT.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.INSPECTBOAT.INUSE"
msgid "Someone's checking it already. Works for me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.BUSY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.BUSY"
msgid "Hold on. I can't leave in the middle of this."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE"
msgid "Can't get through. Guess we're staying here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.FLOODED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.FLOODED"
msgid "I'm not setting my tools down in a puddle."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.SLEEPING"
msgid "Let me wake up first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC"
msgid "The hull's fine. Save the kit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BERMUDA_FAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BERMUDA_FAIL"
msgid "I can't get through that thing. Figures."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED"
msgid "Hey, there's water coming through the hull."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING"
msgid "The water's coming in faster. Start rowing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT"
msgid "Forget the cargo! Get to land!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAB_ESCAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAB_ESCAPE"
msgid "It slipped into the sand. Cheap move."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.1"
msgid "The ink's washed off. I can't read a word."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.2"
msgid "All I got out of that bottle was wet paper."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.3"
msgid "These words are gone. Next time, use a better cork."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAGIC_FAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAGIC_FAIL"
msgid "Well, that didn't work here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_LOSECONTROL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_LOSECONTROL"
msgid "I can't tell which way we're drifting anymore."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_RETURN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_RETURN"
msgid "Out of the fog. Let me see where we ended up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_WARN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_WARN"
msgid "That's a lot of fog. I can barely see the bow."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MORETREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MORETREASURE"
msgid "There's more? All right, pass the shovel back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_PLANT"
msgid "Wrong soil. Find somewhere better for it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_TREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_TREASURE"
msgid "Wrong waters. That map isn't much use here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHARX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHARX"
msgid "Something's chasing the boat. Keep rowing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAWL_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAWL_FULL"
msgid "Net's full. Help me pull it in."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE"
msgid "X marks it. All that's left is digging."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE_DISCOVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE_DISCOVER"
msgid "Found it. Finally, something worth digging up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VOLCANO_ERUPT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VOLCANO_ERUPT"
msgid "The volcano's going off! Look up!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST"
msgid "Whoa! That was faster than rowing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY"
msgid "Those bubbles are getting bigger. We're close."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL"
msgid "Bubbles stopped. There goes the trail."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING"
msgid "The swell washed out the trail."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AERODYNAMICHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AERODYNAMICHAT"
msgid "With the wind in my face, I might finally wake up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM"
msgid "I'd rather wince at the taste than at the bite."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORCACTUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORCACTUS"
msgid "Can somebody help me get into this without bleeding?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORLIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORLIMESTONE"
msgid "A suit made of rock. Getting into it counts as weights."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOROBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOROBSIDIAN"
msgid "This stuff gets hot when I fight. I'll watch my sleeves."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSEASHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSEASHELL"
msgid "If these shells crack, at least it won't be my ribs."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LIFEJACKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LIFEJACKET"
msgid "I'll wear it. Nobody needs to see how I swim."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN"
msgid "Good jacket. I'd have picked another pattern."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WINDBREAKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WINDBREAKER"
msgid "Maybe now I can walk across the beach without fixing my hair every ten steps."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYOX"
msgid "It's got little horns already. I wonder how they'll turn out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHIN"
msgid "How do they jump that high without a running start?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHINHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHINHOUSE"
msgid "The ballphins get a palace. I get wet socks."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO"
msgid "Light enough to carry. Long enough to hit the doorframe."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNING"
msgid "The bamboo patch caught fire. Somebody get water!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNT"
msgid "The bamboo patch is pretty much ash now. Leave it to cool."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.CHOPPED"
msgid "The bamboo patch is cut back. My arms can rest now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.GENERIC"
msgid "I'll cut a few stalks. Stop me if I start clearing the whole patch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_POISON"
msgid "Good. A bandage for the kind of scratch that gets worse."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARREL_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARREL_GUNPOWDER"
msgid "Let me put my bat down before we move that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERMUDATRIANGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERMUDATRIANGLE"
msgid "Can't we take a shortcut that doesn't make my hair stand up?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIOLUMINESCENCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIOLUMINESCENCE"
msgid "Even the sea has its own night-light. Good for it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISQUE"
msgid "If there's more soup, I can stay awake for another bowl."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FLUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FLUP"
msgid "Quit looking at me. It's weird enough holding the thing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_POISON"
msgid "I'll keep the point away from my fingers."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBER"
msgid "A wad of whale fat. Whose bag is this going in?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBERSUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBERSUIT"
msgid "Every time I move, it makes a noise. I'm pretending I can't hear it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATCANNON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATCANNON"
msgid "That goes on the boat, right? Give me some room."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT"
msgid "Good. Something that fixes holes faster than I make them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ARMOURED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ARMOURED"
msgid "Thick hull. I like my boats hard to break."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE"
msgid "Better the limestone takes the bump than the hull."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT"
msgid "I'll put the bumper together before I hit anything else."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO"
msgid "There's room for a whole week's lunches in there."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ENCRUSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ENCRUSTED"
msgid "That shell plating better hold out at sea."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LANTERN"
msgid "A lantern on the bow frees up both hands."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT"
msgid "Logs and rope. This is all the boat I get?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_RAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_RAFT"
msgid "A bamboo raft. Light enough to push off by myself."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW"
msgid "A rowboat. So much for resting my arms."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_SURFBOARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_SURFBOARD"
msgid "I'll stand on it as soon as it stops moving."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH"
msgid "Good, I can see what I'm about to run into."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_WOODLEGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_WOODLEGS"
msgid "Woodlegs gets an entire ship to himself. Lucky."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_METEOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_METEOR"
msgid "I was going to skip the reading. Then I saw what it does."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOTTLELANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOTTLELANTERN"
msgid "Odd light. Still better than feeling around in the dark."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAINJELLYHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAINJELLYHAT"
msgid "I don't mind getting smarter. Do I have to get slimier too?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUOY"
msgid "I can use that to tell whether I've been rowing in circles."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURIEDTREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURIEDTREASURE"
msgid "That's the spot. Start digging before the tide comes in."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNING"
msgid "That's smoke coming off the viney bush. Back up a little."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNT"
msgid "So much for the viney bush. Is anything under the ash still good?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.CHOPPED"
msgid "The viney bush is cut back. My arms can rest now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.GENERIC"
msgid "If I get tangled up, I'm taking the whole bush with me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAPTAINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAPTAINHAT"
msgid "I'll wear it. You can still tell me which way to go."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN"
msgid "I'd rather be on the handle end of that saw."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVIAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVIAR"
msgid "Fish eggs in a little jar. Who decided that's fancy?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KRAKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KRAKEN"
msgid "I like the Quacken this size. It can't reach my boat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SEAL"
msgid "A seal in stone. Now I can finally put my hat down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TIGERSHARK"
msgid "I can get a good look at its teeth now. Much better."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWISTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWISTER"
msgid "Good. A Sealnado that stays where I put it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMINEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMINEA"
msgid "With that much shelter, even I can keep the fire going."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING"
msgid "It's lit! Don't stand there holding it!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC"
msgid "That's a coconut. I know enough not to crack it open."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT"
msgid "There's a good drink in there. It's putting up a fight."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_COOKED"
msgid "That smells better than anything I made in cooking class."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_HALVED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_HALVED"
msgid "Finally got it open. That took more swings than it should have."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_SAPLING"
msgid "It can grow close to home. I could use a little shade."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE"
msgid "One cup and suddenly I can finish things."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS"
msgid "I want coffee. First I've got to roast these."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED"
msgid "Now it smells like coffee. Still needs hot water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.BARREN"
msgid "The coffee plant looks dried out. Can we still do anything for it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.GENERIC"
msgid "Coffee growing out here. Now there's a reason to go for a walk."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.PICKED"
msgid "We can come back for the coffee plant after it's had some time to grow."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.WITHERED"
msgid "I'll leave the coffee plant alone till we know how to help it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL"
msgid "I like the color. I'll put some on my desk if it fits."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORALLARVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORALLARVE"
msgid "That's alive? I thought it was a wet chip of rock."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN"
msgid "That thing looks more like a brain than anything I want to eat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN_ROCK"
msgid "At least there's an easier place to find a brain than math class."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORMORANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORMORANT"
msgid "Did that bird dive all the way down for lunch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.GENERIC"
msgid "Hold on. I'm trying to walk sideways too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.HIDDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.HIDDEN"
msgid "I can see where it dug in. That's about it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABHOLE"
msgid "It's in there. I can wait longer than it can. Probably."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRATE"
msgid "No name on the crate. Guess I'll see what's inside."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROCODOG"
msgid "I don't care how much it acts like a dog. Look at the jaws."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS"
msgid "The handle's fine. The rest smells like lunch left in the sun."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BAMBOOTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BAMBOOTREE"
msgid "I already took what I could from the bamboo patch. I'll check back later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BUSH_VINE"
msgid "We can come back for the viney bush after it's had some time to grow."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS_WATER"
msgid "Nothing left on the water grass for now. Give it time."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORSALFIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORSALFIN"
msgid "Glad I can see the fin without the rest of the fish attached."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOUBLE_UMBRELLAHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOUBLE_UMBRELLAHAT"
msgid "Two umbrellas and both hands still free. I'll take the funny looks."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOY"
msgid "I don't think it knows I'm here. I'm right in front of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYBABY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYBABY"
msgid "Small enough to get lost in the grass. I'll watch where I step."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG"
msgid "Leave it be if we want more of those birds."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_COOKED"
msgid "Hand me the fried doydoy egg. I haven't eaten since we left."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_CRACKED"
msgid "The shell's split. I hope that's all that broke."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYFEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYFEATHER"
msgid "That's one thing the bird managed to leave behind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYNEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYNEST"
msgid "I can see why they'd stop here. Looks good for a nap."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOON"
msgid "That lizard's looking at me wrong. And it's hot enough from here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONDEN"
msgid "Keep your distance. I doubt the lizards take visitors."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONEGG"
msgid "It's warmer than an egg ought to be. I'm putting it down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONHEART
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONHEART"
msgid "I'm not putting that in my pocket while it's still warm."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONSPIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONSPIT"
msgid "It spat where I was standing. I'm standing somewhere else now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUBLOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUBLOON"
msgid "Money I can dig up. This beats asking for an allowance."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BAMBOOTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BAMBOOTREE"
msgid "I'll carry the bamboo root. Can you dig the hole?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BUSH_VINE"
msgid "Find a spot for the viney bush root before the roots dry out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_COFFEEBUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_COFFEEBUSH"
msgid "Find a spot for the coffee plant before the roots dry out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_ELEPHANTCACTUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_ELEPHANTCACTUS"
msgid "I'll carry the elephant cactus. Can you dig the hole?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_LIMESTONE"
msgid "Somebody show me how the limestone dumbbell works. Keep it short."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_OBSIDIAN"
msgid "Somebody show me how the obsidian dumbbell works. Keep it short."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARRING"
msgid "Shiny enough to find if I drop it. Still, I'd rather not."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.BARREN"
msgid "Something's wrong with the elephant cactus. It wasn't this droopy before."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.GENERIC"
msgid "I'll look at the spikes with both hands behind my back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.PICKED"
msgid "I already took what I could from the elephant cactus. I'll check back later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.WITHERED"
msgid "The elephant cactus looks dried out. Can we still do anything for it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_ACTIVE"
msgid "Ow! Those spikes weren't pointing at me a second ago."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_STUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_STUMP"
msgid "Finally. Nothing left to stick in my sleeve."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC"
msgid "I could patch three holes with this. Maybe two, with my sewing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINHOLE"
msgid "The fish are all in one spot. That's unusual cooperation."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.BLUEFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.BLUEFISH"
msgid "That's a lot of blue fish. I should get the net."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.EMPTY"
msgid "Empty. Who's got the fish eggs?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.ONEFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.ONEFISH"
msgid "There's one. I'll try not to plan the whole menu around it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.REDFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.REDFISH"
msgid "I can see the red ones now. Looks like it worked."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.STOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.STOCKED"
msgid "Eggs are in. Now comes the part I'm bad at: waiting."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.TWOFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.TWOFISH"
msgid "Two fish. This is starting to look worth the trouble."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_TROPICAL"
msgid "It has more colors than the shirt I had to wear on sports day."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLAMEGEYSER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLAMEGEYSER"
msgid "I'm happy to watch the fire from exactly this far away."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTSAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTSAM"
msgid "Something washed out to sea. I might be able to fish it out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLUP"
msgid "I can see your eye. Quit pretending I can't."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASHAT"
msgid "I'll try the particulate purifier on. Does it flatten my hair?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE"
msgid "The gold part doesn't help me swing. Does look nice, though."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_WATER"
msgid "At least nobody has to remember to water this grass."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAIL_ICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAIL_ICE"
msgid "Ice from the sky. I liked it better when it was in a drink."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARPOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARPOON"
msgid "I'll need a running start. On second thought, we're on a boat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_BOAT_NAMEPLATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_BOAT_NAMEPLATE"
msgid "Put my name on it. Make it big enough to read in the rain."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1"
msgid "Hang the pirate ghost decoration a little higher. My bat might catch it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2"
msgid "Whoever picked the stink ray decoration gets to dust it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3"
msgid "The tropical spider warrior decoration can go on the wall. Just don't make me stand there admiring it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4"
msgid "Hang the doydoy decoration a little higher. My bat might catch it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_14"
msgid "Don't lose the worn-out doll now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_15
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_15"
msgid "I don't know what an old ukulele is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_17
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_17"
msgid "I've got room in my bag for the lost old boot, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_18"
msgid "I don't know what a mother's favorite vase is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_20
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_20"
msgid "I've got room in my bag for the lost father's sextant, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_21
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_21"
msgid "I've got room in my bag for the favorite toy boat, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLE"
msgid "I'd use a sealed bottle too if nobody picked up my letters."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLEEMPTY"
msgid "All the way across the sea and now it's an empty bottle."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED"
msgid "I'll listen to Shipwrecked. Give me somewhere to sit first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED"
msgid "I'll listen to Beached. Give me somewhere to sit first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD"
msgid "Did we bring a player for Castaway? I'd like to hear it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_TRIDENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_TRIDENT"
msgid "Three points to keep track of. A bat was simpler."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.HIGH"
msgid "I can hear the ice maker 3000 working. We'll check on it in a minute."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.LOW"
msgid "The ice maker 3000 needs more fuel. Did we bring any?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.NORMAL"
msgid "The ice maker 3000 is running. Can I sit down now?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.OUT"
msgid "No ice. No fuel. There goes my cold drink."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.VERYLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.VERYLOW"
msgid "It's sputtering. Fuel, quick, before it stops."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRONWIND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRONWIND"
msgid "This can move the boat while I sit down. Good."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH"
msgid "It can sting even if it looks like dessert. I know now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISHJELLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISHJELLY"
msgid "The jellyfish jelly can cool off while I find somewhere to sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_COOKED"
msgid "Put the cooked jellyfish where I can reach it. I'll be hungry later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_DEAD"
msgid "Dead. I'm still keeping my fingers off the tentacles."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_PLANTED"
msgid "There it goes, drifting around with its stingers out."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYJERKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYJERKY"
msgid "I chewed and chewed. It stayed practically the same size."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYOPOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYOPOP"
msgid "Finally, a jellyfish I can eat from the safe end."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNING"
msgid "The jungle tree caught fire. Somebody get water!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNT"
msgid "The jungle tree is already burnt through. Too late to bring a bucket."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.CHOPPED"
msgid "The jungle tree is cut back. My arms can rest now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.GENERIC"
msgid "That's a big tree. I'll check the ground for surprises before I start chopping."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED"
msgid "I want the shade this grows into. I don't want to wait that long."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED_SAPLING"
msgid "Give the jungle tree sapling room to take root. I don't want to move it twice."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_SILVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_SILVER"
msgid "I'll keep the silver key in my pocket where it won't get lost."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_TROPICAL"
msgid "I'll keep the loot stash key in my pocket where it won't get lost."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHTBOAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHTBOAT"
msgid "Someone taught a clockwork knight to sail. Thanks a lot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN"
msgid "That thing is wider than the boat. Don't stop rowing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKENCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKENCHEST"
msgid "After all that rowing, I'm opening this one."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN_TENTACLE"
msgid "Keep that arm off my boat!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL"
msgid "The heat's coming through my shoes. This is far enough."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_PALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_PALM"
msgid "I didn't expect the tree to come after me. I can take the hint."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMESTONENUGGET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMESTONENUGGET"
msgid "Light-colored rock. Still makes my bag heavy."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS"
msgid "They're hanging onto the rock harder than I hang onto my bed in the morning."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS_COOKED"
msgid "Put the cooked limpets where I can reach it. I'll be hungry later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGJUNGLETREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGJUNGLETREE"
msgid "I can't say what's off about it. I'm still picking a different tree."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER"
msgid "If I get pinched, somebody else cooks dinner."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERHOLE"
msgid "I see where it lives. I'm not reaching in bare-handed."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD"
msgid "The claws stopped moving. Now I don't mind holding it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD_COOKED"
msgid "I'll try the delicious wobster. Save me a bite."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUGGAGECHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUGGAGECHEST"
msgid "Somebody's luggage. I hope the clasp still opens."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE"
msgid "Now that's a tool for getting straight through the weeds."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGIC_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGIC_SEAL"
msgid "It's still glowing. I don't know what it's doing, but it's still glowing."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK"
msgid "That rock was liquid once. I'm glad I got here later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK_GOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK_GOLD"
msgid "I see gold in there. Pass me the pickaxe and stand back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.BURNT"
msgid "The mangrove is pretty much ash now. Leave it to cool."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.GENERIC"
msgid "It grows right in the water. Must be nice never needing a watering can."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_BURNT"
msgid "I didn't think a tree standing in water could end up that dry."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_SAPLING"
msgid "Give the mangrove sapling room to take root. I don't want to move it twice."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT_TROPICAL"
msgid "It grows in the wet stuff. I'll stay on the edge."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMFISHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMFISHER"
msgid "That merm looks like it knows a better fishing spot than I do."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER"
msgid "That's the fishermerm's hut. I wonder if anyone's inside."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER_CRAFTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER_CRAFTED"
msgid "That's the anglermerm house. I wonder if anyone's inside."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.BURNT"
msgid "So much for the merm hut. Is anything under the ash still good?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC"
msgid "I can see the merm hut from here. Want to go look?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBALL"
msgid "If the monkey wants the ball that much, it can stop touching my bag."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB_YELLOW"
msgid "That's a whole lot of bad smell in one little package."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER_YELLOW"
msgid "It came out of a mosquito. If the plants want it, they can have it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE_YELLOW"
msgid "That's meant for the merms. Set it somewhere they can see it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK_YELLOW"
msgid "If that smell keeps the mosquitoes off, I'll put up with it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK_YELLOW"
msgid "That fell off a mosquito. You can carry it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO_POISON"
msgid "I hate regular mosquitoes enough already."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL"
msgid "I think I can see the wrecked postern from here. Hold up the light."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL"
msgid "I could pry it open. I could also wait till dinner."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSELBOUILLABAISE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSELBOUILLABAISE"
msgid "Put the mussel bouillabaise where I can reach it. I'll be hungry later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_BED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_BED"
msgid "So that's where mussels come from. Can we put some closer to home?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_COOKED"
msgid "Hand me the cooked mussel. I haven't eaten since we left."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.GENERIC"
msgid "There are mussels down there. I need a stick to get at them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.STICKPLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.STICKPLANTED"
msgid "Stick's in place. The mussels can do the rest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_STICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_STICK"
msgid "You tell me why the mussels like this stick. I'll listen if it's short."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_RANDOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_RANDOM"
msgid "I'll let the spiders work out what kind of snack this is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR"
msgid "That's for the spider. Don't mix it up with my lunch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MYSTERYMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MYSTERYMEAT"
msgid "I'll go hungry before I try to guess what that is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEEDLESPEAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEEDLESPEAR"
msgid "That's one cactus thorn I don't want under my fingernail."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO"
msgid "I can see that fish coming from here. Does it know how bright it is?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO_COOKED"
msgid "Hand me the cooked neon quattro. I haven't eaten since we left."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUBBIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUBBIN"
msgid "Part of a reef that I can carry. It'll go back in the sea."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT"
msgid "How am I going to keep the ingenius gardeneer hat from falling off?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_BAMBOO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_BAMBOO"
msgid "Put the bamboo oar where I can reach it from my seat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_TIGERSHARK"
msgid "I'll check the tigoar before we leave the dock."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN"
msgid "It looks like glass till I try to pick it up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANAXE"
msgid "Hot enough on its own. I don't have to swing harder."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANBUGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANBUGNET"
msgid "I want to catch the bug before the handle gets warm."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.BURNING"
msgid "Everybody back! That one's already lit!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.GENERIC"
msgid "A coconut with obsidian on it. I'm putting it down carefully."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.EMBERS"
msgid "It's down to coals. Look for some dry wood."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.GENERIC"
msgid "A ring of obsidian. Looks like it can hold a serious fire."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.HIGH"
msgid "Step back. The flames in the obsidian fire pit are getting high."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.LOW"
msgid "The obsidian fire pit barely puts out any heat right now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.NORMAL"
msgid "Can we stop here for a minute? The obsidian fire pit is keeping me warm."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.OUT"
msgid "Any spare wood? I let the obsidian fire pit go out while I was resting."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANMACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANMACHETE"
msgid "Clear the trail and mind the heat. I think I can manage both."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN_WORKBENCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN_WORKBENCH"
msgid "I can make hot tools here. Can I make the handles stay cold?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY"
msgid "If the doydoy quill float comes loose at sea, I'm making you go get it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSCHEST"
msgid "Deal's done. I'm opening the chest while we still have daylight."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSKING"
msgid "Eight arms and still too relaxed to move. I respect that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX"
msgid "That beefalo doesn't seem to mind getting its feet wet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OXHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OXHAT"
msgid "I finally have horns that aren't just my hair sticking up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE"
msgid "If I play it, it rains. I'm tempted to play it outside somebody's window."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN"
msgid "It's hollow. I shouldn't blow into it unless I want the whole camp to know I'm here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM"
msgid "If you carry my stuff, I'll stop asking why you follow me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM_FISHBONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM_FISHBONE"
msgid "I'll hang on to it. The bird seems to care where it goes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF"
msgid "I could cool off with this if my arm didn't have to do all the work."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_HUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_HUT"
msgid "Shade without having to sit under a falling coconut. Perfect."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_UMBRELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_UMBRELLA"
msgid "I'll take that. My hair's got enough salt in it already."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNING"
msgid "That's smoke coming off the palm tree. Back up a little."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNT"
msgid "The palm tree is pretty much ash now. Leave it to cool."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.CHOPPED"
msgid "That's enough chopping for now. What's left of the palm tree can stay."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.GENERIC"
msgid "I want the coconuts. The coconuts are way up there. Typical."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT"
msgid "That's a better color than anything I'm allowed to wear to school."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_PIRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_PIRATE"
msgid "Loud. Whoever taught it to talk owes me some peace and quiet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEG_LEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEG_LEG"
msgid "That's a leg somebody can swing. I still like my bat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH"
msgid "Does the clownfish know it's easier to spot in that color?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH_COOKED"
msgid "The cooked pierrot fish smells good. I get the first bite, right?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEGHOST"
msgid "Being dead didn't make it any quieter."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEHAT"
msgid "How am I going to keep the pirate hat from falling off?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEPACK"
msgid "I'll carry the booty bag if somebody else carries the rest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.BURNT"
msgid "The piratihatitator is pretty much ash now. Leave it to cool."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.GENERIC"
msgid "Somebody built a whole thing around a pirate hat. Fair enough."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM"
msgid "Poison treatment. I hope it doesn't sting more than the bite."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONCROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONCROCODOG"
msgid "That one's got venom. Don't let it get its teeth on you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONHOLE"
msgid "I saw the fumes. I'm going the long way around."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTAL_SHIPWRECKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTAL_SHIPWRECKED"
msgid "I think I can see the portal from here. Hold up the light."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPE"
msgid "I saw it looking at my bag. I'm not putting it down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPEBARREL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPEBARREL"
msgid "I wonder where they keep all the stuff they take."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER"
msgid "I can see a purple fish. Hard to lose that one."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER_COOKED"
msgid "The cooked purple grouper can cool off while I find somewhere to sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENBEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENBEAK"
msgid "That's some beak. Glad it's off the thing now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENDRILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENDRILL"
msgid "A drill for the sea. At least it's lighter than hauling the sea to a workbench."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.EMPTY"
msgid "The can's dry. Who's going to refill it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.GENERIC"
msgid "The big beak makes a pretty decent spout. Who knew?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKERINGRAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKERINGRAM"
msgid "I'll keep my head behind it when it hits. Learned that much."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH"
msgid "A rainbow with stingers. I'll look from here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISHMOUSSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISHMOUSSE"
msgid "Hand me the rainbow mousse. I haven't eaten since we left."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_COOKED"
msgid "I had plans. Then somebody made cooked rainbow jellyfish."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_DEAD"
msgid "It stopped moving. The colors didn't go anywhere."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_PLANTED"
msgid "I can see the colors through the water. See, I don't have to touch it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAWLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAWLING"
msgid "A ball my bat can't hit. We should probably talk about that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CHARCOAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CHARCOAL"
msgid "My hands are black, and I barely touched it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CORAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CORAL"
msgid "The reef's pretty when I'm not scraping the bottom of my boat on it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.GENERIC"
msgid "There's dinner, stuck to a rock with no plans to leave."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.PICKED"
msgid "I already took what I could from the limpet rock. I'll check back later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_OBSIDIAN"
msgid "I'm not carrying the whole rock. I'll break off what I need."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE"
msgid "All those eggs in one pile. I thought it would look more like dinner."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE_COOKED"
msgid "I had plans. Then somebody made cooked roe."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_CLOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_CLOTH"
msgid "The stitching looks solid. Don't make me repair it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_FEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_FEATHER"
msgid "That's a light sail. Good, I'll be the one hauling it up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_PALMLEAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_PALMLEAF"
msgid "I could have used those leaves for shade. A sail works too."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN"
msgid "At least the snake won't be doing the steering."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_WOODLEGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_WOODLEGS"
msgid "I know whose sail that is. Think he'll give me a lift?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND"
msgid "I'll be finding this in my shoes for a week."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG"
msgid "Keep that gap closed. I don't want water in the house again."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL"
msgid "I'll take the sandbag with me. Better than walking back for it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL_ITEM"
msgid "Somebody show me how the sandbag works. Keep it short."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG_ITEM"
msgid "It's full. Somebody help me carry it where the water's coming in."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.GENERIC"
msgid "Good castle. I wouldn't build it any closer to the water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.SAND"
msgid "I'll build the wall once the sand stops crumbling in my hands."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDDUNE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDDUNE"
msgid "A whole pile of sand. I'll walk around it and save myself the climb."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL"
msgid "My lunch is in my bag for a reason. There it is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL_WATER"
msgid "It gets to sit there without having to steer. Nice."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASACK"
msgid "As long as what's inside stays fresh, I'll deal with the wet straps."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL"
msgid "I thought I'd put it to my ear. First I'll check if someone's still in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL_BEACHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL_BEACHED"
msgid "The tide left it here. I'll pick it up before it takes it back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEATRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEATRAP"
msgid "Set it and stand back. I like fishing when I can sit down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED"
msgid "Lunch from the sea. Tastes like a lot of sea."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_COOKED"
msgid "The roasted seaweed can cool off while I find somewhere to sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_DRIED"
msgid "Much easier to carry when it isn't dripping."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.GENERIC"
msgid "I can see the seaweed. I can't quite reach it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.PICKED"
msgid "I already took what I could from the seaweed. I'll check back later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_STALK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_STALK"
msgid "A seaweed stalk. Water's still running down my sleeve."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.BROKEN"
msgid "One of the pieces is out of place. I don't think sitting harder will help."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.GENERIC"
msgid "A chair that gets me off the island? I'll try sitting down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.INSIDE_SW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.INSIDE_SW"
msgid "I sat down and now we're going somewhere. That's just how I like to travel."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.EMBERS"
msgid "I can see a few red coals. Have you got any dry wood?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.GENERIC"
msgid "A stove on the water. I'll keep a hand on it when the waves come."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.HIGH"
msgid "Step back. The flames in the buoyant chiminea are getting high."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.LOW"
msgid "I can still see embers in the buoyant chiminea. We haven't lost the fire yet."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.NORMAL"
msgid "I'll sit near the buoyant chiminea till my sleeves dry."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.OUT"
msgid "The buoyant chiminea went out. Let's get it lit again."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_LAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_LAB"
msgid "I'd like to see how they keep the experiments from rolling overboard."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.LOWFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.LOWFUEL"
msgid "The sea yard needs more fuel. Did we bring any?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.OFF"
msgid "Can somebody turn the sea yard back on? I need it in a minute."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.ON"
msgid "I'll leave the sea yard on until it's done."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKFINSOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKFINSOUP"
msgid "Now that there's shark fin soup, can we stop for lunch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTEN"
msgid "Little fins. Big teeth. Where's its mother?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.GENERIC"
msgid "There are little fins coming out of that sand. I'm backing up."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.INACTIVE"
msgid "Nothing's coming out of the sand right now. Let's not change that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_FIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_FIN"
msgid "One fin I don't have to watch coming at me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_GILLS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_GILLS"
msgid "I don't know how those let it breathe underwater. School never covered that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_TEETHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_TEETHHAT"
msgid "Now I've got shark teeth over my head instead of behind me."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARX"
msgid "They caught up already. I should've taken the lighter boat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECK"
msgid "There's a reason that boat never made it back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_ENTRANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_ENTRANCE"
msgid "Take a look at the entrance. Tell me if anything around it moves."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_EXIT"
msgid "I want a closer look at the exit. Can you watch my back?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE"
msgid "Keep the limestone rounds in the pouch till we need them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN"
msgid "I brought the obsidian rounds. Who packed the slingshot?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POISON"
msgid "I brought the stink bombs. Who packed the slingshot?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR"
msgid "Keep the tar rounds in the pouch till we need them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN"
msgid "This slithering slingshot band came off something. Look for the rest of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN"
msgid "This obsidian slingshot frame came off something. Look for the rest of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_TAR"
msgid "This slingshot tar grip came off something. Look for the rest of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOTMACHINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOTMACHINE"
msgid "I can lose all my money without turning a handle. What's the point?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE"
msgid "A snake. Where'd it come from? I was looking right at the ground."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNING"
msgid "The viney bush caught fire. Somebody get water!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNT"
msgid "The viney bush is already burnt through. Too late to bring a bucket."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.CHOPPED"
msgid "That's all the vines I can cut without checking for snakes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.GENERIC"
msgid "If something starts moving in those vines, I'm stepping back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL"
msgid "Keep that snake oil. I might need it later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN"
msgid "It's got the pattern without the snake in it. Good."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT"
msgid "The rain rolls right off. Wish my shoes did that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_POISON"
msgid "See the fangs? Don't wait to find out what's on them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH"
msgid "It's following the boat. I don't have anything to throw it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH_DEAD"
msgid "We've got the dead dogfish. Now someone's got to clean it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LAUNCHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LAUNCHER"
msgid "It throws the spear for me. Doesn't do the aiming, though."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_OBSIDIAN"
msgid "Let me get a feel for the obsidian spear before anything comes after us."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_POISON"
msgid "Stand back a little. I want to see what the poison spear can do."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUNGRAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUNGRAY"
msgid "I can smell it before I can see it. I don't need to get any closer."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.ABANDONED"
msgid "Nobody left on board. Only thing moving is the water."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.GENERIC"
msgid "Somebody's still over there. Let's see what they've got to say."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_BURNT"
msgid "It managed to burn and sink. Rough day."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_1"
msgid "The sextant was in the wreck. I bet it used to get someone home."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_2"
msgid "I don't know what a toy boat is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_3"
msgid "Don't lose the bottle candle now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_4"
msgid "Don't lose the odd trinket now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_5"
msgid "Only found one boot in the wreck. Some help that is."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTELESCOPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTELESCOPE"
msgid "I can see the next island from here. Can I get there without rowing?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFBOARD_ITEM"
msgid "I'll carry the board. Somebody else can go first."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATOSOUFFLE"
msgid "The sweet potato souffle can cool off while I find somewhere to sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO"
msgid "If I roast this, I'm not sharing the crispy parts."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_COOKED"
msgid "I'll try the cooked sweet potato. Save me a bite."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_OVERSIZED"
msgid "Too big to fit in my bag. That's a good problem to have."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_PLANTED"
msgid "There's food under those leaves. I have to wait, don't I?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_SEEDS"
msgid "Somebody mark where we plant the stellar seeds. I forget these things."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH"
msgid "Stop pointing that at me. I get it, you're a swordfish."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH_DEAD"
msgid "Pointy end's still pointy. Pick it up from the back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR"
msgid "It stuck to my hand. Now it's on my other hand."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARLAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARLAMP"
msgid "Good light. I'll try not to get tar on the handle."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARSUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARSUIT"
msgid "It sticks to me and everything I touch. Great."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.LOWFUEL"
msgid "Keep some fuel by the tar extractor. We'll need it soon."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.OFF"
msgid "The tar extractor isn't running. Check it before we start."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.ON"
msgid "I'll leave the tar extractor on until it's done."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_POOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_POOL"
msgid "I see the slick. I'm keeping my oar out of it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_TRAP"
msgid "I can feel it sticking just by looking at it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BASE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BASE"
msgid "It has places to put things. That's the part I understand."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BOX"
msgid "One box. Now all I need is the machine it belongs to."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_CRANK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_CRANK"
msgid "A crank. Something's expecting me to turn this."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_POTATO"
msgid "Looks like a potato. I already checked, it's not lunch."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_RING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_RING"
msgid "I don't think I'm supposed to wear this ring."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESCOPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESCOPE"
msgid "I can check if there's land before we go all the way out there."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THATCHPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THATCHPACK"
msgid "Light enough to carry. It'll be nice until it rains."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDALPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDALPOOL"
msgid "There's a little sea left in the hole. Anything else in there?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDAL_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDAL_PLANT"
msgid "If you're taking some tidal plant, leave a bit for later."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGEREYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGEREYE"
msgid "It's unsettling how well it still looks back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGERSHARK"
msgid "A shark that hunts like a cat. I hate that it can do both."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIROEMISU
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIROEMISU"
msgid "The tiroemisu smells good. I get the first bite, right?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN"
msgid "That's a lot of beak to carry around all day."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET"
msgid "I'll trail it behind me. Get ready to help when I pull."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC"
msgid "Get one end of the trawl net. I'll lift the other."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON"
msgid "Quick, pull the trawl net aboard. There isn't much of it left above water!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH"
msgid "The trawl net is starting to sink. Let's work on getting it back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_13
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_13"
msgid "I don't know what an orange soda is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_14"
msgid "I don't know what a voodoo doll is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_15
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_15"
msgid "I've got room in my bag for the ukulele, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_16
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_16"
msgid "Don't lose the license plate now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_17
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_17"
msgid "I've got room in my bag for the old boot, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_18"
msgid "Don't lose the ancient vase now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_19
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_19"
msgid "I don't know what a brain cloud pill is worth here. I could ask."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_20
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_20"
msgid "Don't lose the sextant now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_21
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_21"
msgid "I've got room in my bag for the toy boat, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_22
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_22"
msgid "I've got room in my bag for the wine bottle candle, if nobody else wants it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_23
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_23"
msgid "Don't lose the broken aac device now that we finally found it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALBOUILLABAISSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALBOUILLABAISSE"
msgid "The tropical bouillabaisse smells good. I get the first bite, right?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALFAN"
msgid "I'd keep using it if it didn't move my hair into my mouth."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN"
msgid "Pull the lid back. Lunch is ready."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURBINE_BLADES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURBINE_BLADES"
msgid "Those could move some air. Keep the sharp edge away from my bag."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN"
msgid "Anybody using the terra firma forger? I could use a turn."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ASH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ASH"
msgid "Try a strip of ashy turf by the door. See how it looks."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEACH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEACH"
msgid "How much beach turf do we need to cover that patch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_JUNGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_JUNGLE"
msgid "The jungle turf can go here. I'm tired of carrying it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MAGMAFIELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MAGMAFIELD"
msgid "How much magma turf do we need to cover that patch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MEADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MEADOW"
msgid "How much meadow turf do we need to cover that patch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SNAKESKIN"
msgid "Let's lay the snakeskin rug before putting all the furniture back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_TIDALMARSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_TIDALMARSH"
msgid "How much tidal marsh turf do we need to cover that patch?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VOLCANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VOLCANO"
msgid "Try a strip of volcano turf by the door. See how it looks."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER"
msgid "That wind's picking everything up. Hang on to the boat!"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER_SEAL"
msgid "That little seal made all that wind?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND"
msgid "Handle it from the outside. I want the poison to stay in it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE"
msgid "It bends better than rope I made in class. That's not saying much."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO"
msgid "That's an entire mountain I'd rather admire from the beach."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANOSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANOSTAFF"
msgid "I could call down rocks with this. I'd better not do it under a roof."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.GENERIC"
msgid "It takes snacks. I'd like to know how many before we start."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.OPEN"
msgid "It's open. Put the food in before I change my mind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_EXIT"
msgid "Outside. Where the ground doesn't have to be hot."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_SHRUB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_SHRUB"
msgid "Somehow it's still standing in all that ash."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.ATTACKER"
msgid "%s, take a breath. What's this about?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.FIRESTARTER"
msgid "%s, I can smell burning from here. What happened?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GENERIC"
msgid "%s, show me how you stay on that board."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GHOST"
msgid "%s, don't drift out past the breakers. I'll be back."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.MURDERER"
msgid "%s, drop it. You're done hurting people."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.REVIVER"
msgid "%s, thanks for bringing them back. Let me carry the board today."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLYINTRO_DEBRIS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLYINTRO_DEBRIS"
msgid "I hope whatever broke into all these pieces was empty when it happened."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE"
msgid "I can handle the sea wall. You keep the boat steady."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM"
msgid "If the sea wall comes loose at sea, I'm making you go get it."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE"
msgid "I should make space in my bag for the limestone wall."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE_ITEM"
msgid "I'll carry the limestone wall if somebody else carries the rest."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.GENERIC"
msgid "A chest that can float. Now I can lose my stuff farther from home."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE"
msgid "More room in the chest. I want to know why it still floats."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCROCODOG"
msgid "Great. It can swim faster than I can row."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERYGRAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERYGRAVE"
msgid "Somebody chose a quiet spot. I'll keep my voice down."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BLUE"
msgid "I've never been next to a fish that made my boat look this small."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BUBBLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BUBBLES"
msgid "Those bubbles are coming from something. Follow them, slowly."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_BLUE"
msgid "That smell's worse than I thought it would be."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_WHITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_WHITE"
msgid "Whole whale out here. I'm sad it ended up like that."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_TRACK"
msgid "I see the next patch of bubbles. That's where we're going."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_WHITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_WHITE"
msgid "It's not moving out of our way. Turn the boat around."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.ATTACKER"
msgid "%s, put that down. That's enough."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.FIRESTARTER"
msgid "%s, don't let the fire reach the trees."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GENERIC"
msgid "%s, got a spare banana? I'll trade you."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GHOST"
msgid "%s, hang on. I've got to find you a heart."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.MURDERER"
msgid "%s, enough! Back up. Now."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.REVIVER"
msgid "%s, good job. You earned my last banana."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_CROWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_CROWN"
msgid "Small crown. That must be for a very particular head."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_UNLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_UNLOCK"
msgid "He's got the crown. Let him decide where it goes."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBORE"
msgid "It looks at me the way I look at somebody in my seat."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHEAD"
msgid "I was going to ask what that smell was. Never mind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHOUSE"
msgid "I got this far without waking anybody. I'll stop here."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDSTAFF"
msgid "Stick for the sails. A lot easier than arguing with the wind."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIND_CONCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIND_CONCH"
msgid "Whatever it does, I'm facing it away from my ears."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERBISQUE"
msgid "The wobster bisque can cool off while I find somewhere to sit."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERDINNER"
msgid "I had plans. Then somebody made wobster dinner."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.ATTACKER"
msgid "%s, put the weapon away before you come aboard."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.FIRESTARTER"
msgid "%s, douse that before it reaches the rigging."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GENERIC"
msgid "%s, taking the Sea Legs out today?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GHOST"
msgid "%s, stay by the dock. I'll find a heart."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.MURDERER"
msgid "%s, that's enough. Get away from them."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.REVIVER"
msgid "%s, you got them back safe. Thanks, captain."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGSHAT"
msgid "I'll try the lucky hat on. Does it flatten my hair?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_CAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_CAGE"
msgid "You know about the lock. I'm looking for the key."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY1"
msgid "I'll keep the bone key in my pocket where it won't get lost."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY2"
msgid "I've got the golden key. Which lock takes it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY3"
msgid "I've got the iron key. Which lock takes it?"
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC_TROPICAL"
msgid "WX can bring the island music along. Turn it down if I doze off."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_POISON"
msgid "WX, see if this helps with the poison. I'm not testing it myself."
msgstr ""

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_WATER"
msgid "A waterproof circuit. Wish WX could waterproof my shoes too."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1"
msgid "Go ahead and finish. I'm in no hurry to get soaked."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2"
msgid "I can wait. This is the only dry spot I've found all day."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.1"
msgid "First get it out of the water. Then I'll erase it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.2"
msgid "Great. Even the eraser needs a dry desk."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.1"
msgid "Can't reach with the hull in the way."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.2"
msgid "Let me row aside first. I can't reach through wood."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1"
msgid "I'll wait until they're finished with the boat."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2"
msgid "Sure, check the whole hull. I can sit here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.1"
msgid "In a minute. Let me finish up here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.2"
msgid "I'm still busy. The next island can wait."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.1"
msgid "Huh. That route's closed."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.2"
msgid "No way across right now. I'll put my bag down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1"
msgid "A dry workbench would be nice. A dry anything, actually."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2"
msgid "Can't work here till the water goes down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.1"
msgid "Five more minutes. Then you can give me work."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.2"
msgid "I'm asleep. Put the tools down."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1"
msgid "It passed inspection. Mine, anyway."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2"
msgid "I'll patch it when there's a hole to patch."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.1"
msgid "I took the shortcut and got exactly nowhere."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.2"
msgid "Guess I'll take the long way across."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1"
msgid "Pass me the patches. One of those cracks is leaking."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2"
msgid "That's a leak. Anybody bring a repair kit?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1"
msgid "This boat's going down. Which way's the beach?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2"
msgid "I've got water around my ankles. Get us to shore."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1"
msgid "We're out of time! Shore, anywhere!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2"
msgid "It's going under! Move!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1"
msgid "I had it! How does it run sideways that fast?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2"
msgid "Fine, hide. I didn't want to dig anyway."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1"
msgid "Save the magic for somewhere it'll actually work."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2"
msgid "I knew that looked too easy."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1"
msgid "Where'd the horizon go?!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2"
msgid "I've lost my bearings. Keep your hands inside the boat."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1"
msgid "I can see the water again. That's a start."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2"
msgid "Next time somebody else steers through that."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1"
msgid "Slow down. We can't see what's ahead."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2"
msgid "I'd rather not find out what's in that fog by hitting it."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1"
msgid "One more haul and I can call today a good day."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2"
msgid "Guess I can put off my nap for one more chest."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1"
msgid "I can dig all I want. It still won't grow here."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2"
msgid "Save it for an island with the right dirt."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1"
msgid "I'm not rowing in circles over a map of somewhere else."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2"
msgid "Put the map away till we reach the right place."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.1"
msgid "Sea hounds. Of course they can swim."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.2"
msgid "Watch the fins. Those aren't friendly."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1"
msgid "I hope that weight is fish and not rocks."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2"
msgid "That's enough trawling. Let's see what we caught."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1"
msgid "We found the spot. Who's holding the shovel?"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2"
msgid "If this turns out to be another empty box, I'm going home."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1"
msgid "There it is! Move over, I want to see inside."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2"
msgid "Treasure. For once the map was right."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1"
msgid "Get away from those shadows! Rocks are coming down!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2"
msgid "Great, it's raining rocks. Find cover!"
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1"
msgid "Caught it! Let's do that again."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2"
msgid "Now that was worth getting my socks wet."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1"
msgid "Something big's right under us. Steady."
msgstr ""

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.2
