msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.11"
msgid "I once had many standing behind me."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.12
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.12"
msgid "And to the last, I never once looked back at them."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.13
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.13"
