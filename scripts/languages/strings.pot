msgid "We can go the rest of the way together."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GENERIC.1"
msgid "I've come to visit. Is it all right if I stay a while?"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GENERIC.2"
msgid "I brought food, in case you felt like company."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GUARD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GUARD.1"
msgid "He's keeping his post. I won't get in his way."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GUARD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.GUARD.2"
msgid "Do they give you any time off duty?"
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.WEREPIG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.WEREPIG.1"
msgid "I don't think he recognizes me now."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.WEREPIG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGMAN.WEREPIG.2"
msgid "Those tusks are coming straight this way."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGSHRINE.BURNT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGSHRINE.BURNT.1"
