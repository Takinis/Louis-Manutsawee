msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAKUSAIGA"
msgid "That'd make short work of a log. Don't worry, Lucy. That's your job."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LYCORIS_BACKPACK"
msgid "Room for lunch and a dry pair of socks. That's plenty."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KAGE"
msgid "Steer clear of that one after sundown, Lucy."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_PANTSU"
msgid "Clothesline must've come down."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OINC1000000"
msgid "That's a right pile of money for the company store."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROWBAR"
msgid "It'll pry loose a board without hitting it. No offence, Lucy."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REBAR"
msgid "That's the sort of thing you don't want to hit with an axe."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASEBALLBAT"
