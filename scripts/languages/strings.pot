msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK.2"
msgid "I'll have to set aside the beefalo wool if I make another."
msgstr ""

