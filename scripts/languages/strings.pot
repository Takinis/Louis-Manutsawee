#. STRINGS.CHARACTERS.WANDA.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.HMINGOT"
msgid "I'll come back in five minutes. Its five minutes."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.KATANABLADE"
msgid "A fraction off at the tang. It'll show when the hilt goes on."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.KATANABODY"
msgid "Give the smith time. Good work takes it."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.KOSHIRAE"
msgid "I try to be elsewhere whenever giants enter the picture."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MAID_HB"
msgid "That's one uniform I never had time to wear."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MINGOT"
msgid "I wonder how many firings it'll take before I know what this is."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MMIKO_ARMOR"
msgid "That hem will take an afternoon to mend if you step on it."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MORTALBLADE"
msgid "I've spent rather a long time avoiding precisely that blade."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MSURFBOARD_ITEM"
msgid "By the time I've learned to use it, I'll need a dry coat."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.M_FOXMASK"
msgid "How much of one's face does a mask like that really hide?"
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.M_SCARF"
msgid "A good scarf saves a great deal of time spent thawing out."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RAIKIRI"
msgid "Lightning is notorious for arriving ahead of schedule."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SHINAI"
msgid "Practice is time well spent. Up to a point."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SHIRASAYA"
msgid "Plain fittings are easier to replace. Sensible."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SHUSUI"
msgid "That edge has aged remarkably well."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TOKIJIN"
msgid "I've enough shadows following me as it is."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_HITOKIRI"
msgid "One cut, and the wound outlasts you. Unpleasant business."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_KOSHIRAE"
msgid "I'd have to be considerably younger to carry that all day."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_RAIKIRI"
msgid "Some things are over in a flash. With that around, I'd count on it."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TRUE_SHIRASAYA"
msgid "I'll give it a wide berth. I don't care to see what it calls a demon."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.VSCODE"
msgid "Without a dial, how does one tell what it's measuring?"
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.YARI"
msgid "The point arrives rather a long time before the person holding it."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TENSEIGA"
msgid "If only bringing someone back were as simple as that."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Good heavens. How long has it been down there?"
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BAKUSAIGA"
msgid "That blade looks perfectly sound. I'd worry about whatever it touches."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.LYCORIS_BACKPACK"
msgid "My spare springs would fit, though they'd tangle in the lining."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.KAGE"
msgid "The things in the dark are quite near enough, thank you."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.M_PANTSU"
msgid "Leave them on the washing line. They'll dry eventually."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.OINC1000000"
msgid "A million? I hope exact change isn't required."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CROWBAR"
msgid "That can wait until I have something larger than a watch to open."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.REBAR"
msgid "Far too thick for a spring. It's hardly got any give."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BASEBALLBAT"
msgid "I tried batting once. The ball took a dreadful amount of time to find."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.MURASAME"
msgid "Just the thing if you want all your other tools to rust."
msgstr ""

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Whose handwriting is this? I can't make out a word."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BOAT_MSURFBOARD"
msgid "We'll have to eat before we shove off. There's nowhere to set a pot."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.HARAKIRI"
msgid "That little knife has no business in my kitchen."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.HITOKIRI"
msgid "I smell iron. That blade hasn't come from a butcher's shop."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.HMINGOT"
msgid "With that much heat, I could sear both sides in seconds."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.KATANABLADE"
msgid "A sharp edge and nothing to hold. A terrible kitchen knife."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.KATANABODY"
msgid "Some things must rest before you finish them. Is metal the same?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.KOSHIRAE"
msgid "Mon dieu, what a knife! What could possibly need a cut that deep?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MAID_HB"
msgid "I'll keep my chef's hat. It covers more hair."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MINGOT"
msgid "I'd keep that out of the stew until we know what it is."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MMIKO_ARMOR"
msgid "Those sleeves would trail into every dish I serve."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MORTALBLADE"
msgid "There are some things I'd rather not learn to carve."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MSURFBOARD_ITEM"
msgid "With a line and a little luck, one could bring back supper on it."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.M_FOXMASK"
msgid "How am I to taste the sauce through that?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.M_SCARF"
msgid "Very smart. Tuck the ends in before you come near the stove."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RAIKIRI"
msgid "You'd hear that blade even above the sizzle of a pan."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHINAI"
msgid "That's more like a wooden spoon than anything in my knife roll."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHIRASAYA"
msgid "Such plain wood around such a fine blade. I like it."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHUSUI"
msgid "You could see every onion skin against that black blade."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TOKIJIN"
msgid "I wouldn't have that thing at a dinner table."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_HITOKIRI"
msgid "That knife has tasted quite enough. Put it away, please."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_KOSHIRAE"
msgid "A giant's cutlery. I wonder how big a serving is."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_RAIKIRI"
msgid "If you strike down there, my soufflé will collapse up here."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUE_SHIRASAYA"
msgid "It drives demons out? There are nights I'd make room for that in the kitchen."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.VSCODE"
msgid "Can that little printing box take down a recipe?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YARI"
msgid "It'd need a very large fire to roast anything on that."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TENSEIGA"
msgid "If it can bring back a life, could it save a split sauce?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Something's been put away here for a very long time."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BAKUSAIGA"
msgid "What a clean edge for a sword with such a terrible reputation."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LYCORIS_BACKPACK"
msgid "It'll carry the picnic, if I wrap the jar well."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.KAGE"
msgid "Even with the stove lit, the edge stays in shadow."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.M_PANTSU"
msgid "The laundry goes outside, far from the food."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OINC1000000"
msgid "That would keep a restaurant in butter for years."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CROWBAR"
msgid "At last, something to open a crate of good wine."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REBAR"
msgid "Too heavy for a skewer. The roast would fall straight into the coals."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BASEBALLBAT"
msgid "I wouldn't use it to roll pastry. What would I do about the handle?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MURASAME"
msgid "Wipe that down before you put it with the other knives."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Is this a recipe? I can't read a word of it."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MSURFBOARD"
msgid "A worthy vessel for a skirmish on the waves!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HARAKIRI"
msgid "A dagger for a grim rite."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HITOKIRI"
msgid "What deeds gave thee that baleful edge?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HMINGOT"
msgid "Fresh from the fires of the forge!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KATANABLADE"
msgid "A blade awaiting its hilt and its first battle."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KATANABODY"
msgid "The smith hath yet to grind its edge."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOSHIRAE"
msgid "Let a giant come and test its steel!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAID_HB"
msgid "That crown is for one who tends the hall."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINGOT"
msgid "What fine steel might be wrought from this?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MMIKO_ARMOR"
msgid "A robe fit for a keeper of the shrine."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MORTALBLADE"
msgid "Even the undying should fear that edge."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MSURFBOARD_ITEM"
msgid "A plank to ride across the sea!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_FOXMASK"
msgid "A fox has no need of a helm to be cunning."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_SCARF"
msgid "A good mantle for the cold watch before dawn."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAIKIRI"
msgid "A blade bold enough to challenge the storm!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHINAI"
msgid "To drill with wood is to be ready when steel is drawn!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIRASAYA"
msgid "The plain scabbard does honour to the steel within."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHUSUI"
msgid "Its dark steel will show no glint to the foe."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOKIJIN"
msgid "I will not bargain with the spirit in that steel."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_HITOKIRI"
msgid "Let those who forged it answer for its thirst."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_KOSHIRAE"
msgid "A weapon worthy of the deeds sung in the hall!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_RAIKIRI"
msgid "Now the thunder follows the strike!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUE_SHIRASAYA"
msgid "Fear this blade, foul spawn of the dark!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VSCODE"
msgid "What runes does this little machine set in order?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YARI"
msgid "A spear to hold the line!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENSEIGA"
msgid "Could this call a fallen warrior home?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "A blade waits in the stone for a hand to claim it."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BAKUSAIGA"
msgid "There is strength enough in that sword to break a shield wall."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LYCORIS_BACKPACK"
msgid "There is room here for the spoils of a small skirmish."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KAGE"
msgid "The dark wrought into the shape of a blade."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.M_PANTSU"
msgid "Even a warrior must put out the washing."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OINC1000000"
msgid "A lord could pay a company of warriors with that."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROWBAR"
msgid "A good iron hook to prise open a barred door."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REBAR"
msgid "It wants a point before I'd carry it to battle."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BASEBALLBAT"
msgid "I can see how the game would train a warrior's swing."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MURASAME"
msgid "The steel carries the dew of morning into battle."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "The runes of this scroll are hidden from me."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MSURFBOARD"
msgid "I prefer a vessel with room for a chair."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HARAKIRI"
msgid "A nasty little implement. Leave it where it is."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HITOKIRI"
msgid "I recognise a bad bargain when I see one."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HMINGOT"
msgid "Do set it down before it burns through your gloves."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KATANABLADE"
msgid "A fine blade in need of some proper furniture."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KATANABODY"
msgid "Someone has left the smith's work unfinished."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOSHIRAE"
msgid "A quite unnecessary amount of steel, until the giant appears."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAID_HB"
msgid "You won't find me wearing that, pal."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINGOT"
msgid "I'd have paid to know what that was, once."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MMIKO_ARMOR"
msgid "A costume for someone altogether more devout."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MORTALBLADE"
msgid "Some promises are worth breaking. Others come with a blade."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MSURFBOARD_ITEM"
msgid "You may have my turn. In fact, you may have all my turns."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_FOXMASK"
msgid "I've seen better disguises at a children's matinee."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_SCARF"
msgid "Decent enough wool. The fringe is another matter."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAIKIRI"
msgid "Lightning. An old effect, and still quite a good one."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHINAI"
msgid "We all start with stage props, I suppose."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHIRASAYA"
msgid "All that care taken to make it look unremarkable."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHUSUI"
msgid "It would vanish completely against black velvet."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOKIJIN"
msgid "Take some advice from someone who's heard the whispers. Leave it."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_HITOKIRI"
msgid "You'll find the interest rather dear, sooner or later."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_KOSHIRAE"
msgid "For the giant who insists on sitting in the front row."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_RAIKIRI"
msgid "They'll see that trick from the cheap seats."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUE_SHIRASAYA"
msgid "Let me know how it defines a demon before you take it out."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VSCODE"
msgid "A little magic-lantern show in a box. Where's the lamp?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YARI"
msgid "It has the advantage of keeping one's company at a decent distance."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENSEIGA"
msgid "Don't make promises on behalf of the dead."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Some things are entombed for excellent reasons."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAKUSAIGA"
msgid "When a sword looks that expensive, the price is usually more than money."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LYCORIS_BACKPACK"
msgid "Two buckles? I need only the one to keep my secrets in."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KAGE"
msgid "I might once have found that tempting."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.M_PANTSU"
msgid "I'd thank you to put the laundry away before we have company."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OINC1000000"
msgid "A million of the local currency. How agreeable."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROWBAR"
msgid "The work of opening crates is best done before the audience arrives."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REBAR"
msgid "There must be some perfectly useful concrete missing that."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASEBALLBAT"
msgid "I'll leave the athletics to someone dressed for them."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MURASAME"
msgid "A sword that needs drying even when it hasn't been used."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "The penmanship is deliberate enough. I can't decipher it."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MSURFBOARD"
msgid "If we sit very still, maybe both of us can fit."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HARAKIRI"
msgid "We ought to ask a grown-up about that one."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HITOKIRI"
msgid "Why's the hair on our legs standing up?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HMINGOT"
msgid "Ow! We said we'd wait!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KATANABLADE"
msgid "Could we wrap the end in silk, so it won't cut our hands?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KATANABODY"
msgid "It looks like somebody's halfway through making a sword."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KOSHIRAE"
msgid "We'd need a friend to help us lift it."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAID_HB"
msgid "We could play house! Who wants to sweep?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINGOT"
msgid "Is it a rock or a metal? We can't agree."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MMIKO_ARMOR"
msgid "We'd get those sleeves caught on all our arms."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MORTALBLADE"
msgid "Can it hurt things that don't stay dead?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MSURFBOARD_ITEM"
msgid "Do you think the spiders could all fit on one board?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_FOXMASK"
msgid "How are we supposed to fit all our eyes behind two holes?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_SCARF"
msgid "This might be long enough to go around both of us."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAIKIRI"
msgid "We like watching lightning from under the covers."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHINAI"
msgid "Can we play knights? We'll be careful."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIRASAYA"
msgid "The scabbard looks like a big wooden pencil case."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHUSUI"
msgid "It's so dark we can hardly see where the blade ends."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOKIJIN"
msgid "Can we please put it back before anything comes out of it?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_HITOKIRI"
msgid "We don't like the look of that red edge at all."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_KOSHIRAE"
msgid "We'd look awfully small standing next to a giant."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_RAIKIRI"
msgid "That one's going to be much louder than the other one."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUE_SHIRASAYA"
msgid "Would it think we were a monster, too?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VSCODE"
msgid "It looks like a typewriter, but where does the paper go?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YARI"
msgid "We must be careful not to poke anybody with it."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENSEIGA"
msgid "If it really works, there are some people we'd like to see again."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Are we allowed to look inside the stone?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BAKUSAIGA"
msgid "We should leave that one for somebody with bigger hands."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LYCORIS_BACKPACK"
msgid "One pocket each! Now we just need to agree what goes in them."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KAGE"
msgid "We don't mind the dark. We mind what's in that sword."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.M_PANTSU"
msgid "Those aren't ours. We don't have enough legs left over for them."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OINC1000000"
msgid "We'd buy enough sweets for everyone. Would there be any money left?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CROWBAR"
msgid "Useful when the lid's stuck and none of our hands can budge it."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REBAR"
msgid "It's too heavy to put in a snowman's arm."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BASEBALLBAT"
msgid "Can we be the first to bat? We'll take turns, honest."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MURASAME"
msgid "Rain, rain, go away. Wait, it's just on the sword."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "We can't read it. Can you?"
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MSURFBOARD"
msgid "A little vessel with nowhere to sit when one grows tired."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HARAKIRI"
msgid "There is no comfort in an edge like that."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HITOKIRI"
msgid "How many hands has that blade outlived?"
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HMINGOT"
msgid "Even embers grow cold in time."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KATANABLADE"
msgid "It has nothing to keep its edge from the hand that holds it."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KATANABODY"
msgid "It will be sharp soon enough."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KOSHIRAE"
msgid "Even giants can be brought low."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAID_HB"
msgid "I should rather wear a veil."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINGOT"
msgid "The earth keeps a few secrets even from its graves."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MMIKO_ARMOR"
msgid "What rites are performed for those who never return?"
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MORTALBLADE"
msgid "Everything ends. Even the things that were promised eternity."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MSURFBOARD_ITEM"
msgid "The sea takes more than it brings back."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.M_FOXMASK"
msgid "A fox can't disguise the weariness in a person's eyes."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.M_SCARF"
msgid "It is easier to warm a neck than a heart."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAIKIRI"
msgid "The storm will come whether we call it or not."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHINAI"
msgid "We used to play at dying, Abigail."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIRASAYA"
msgid "In plain wood, as though it were already laid to rest."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHUSUI"
msgid "So dark that the light in the room seems to end at its edge."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOKIJIN"
msgid "Even I would rather not hear what it has to say."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_HITOKIRI"
msgid "I think it has taken more than anyone meant to give."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_KOSHIRAE"
msgid "Once a giant falls, there is just more of him to bury."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_RAIKIRI"
msgid "A great deal of noise for something that leaves only silence."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUE_SHIRASAYA"
msgid "I hope it knows a ghost from a demon."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.VSCODE"
msgid "It seems to have light enough to read by. I can make nothing of the letters."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YARI"
msgid "One can keep one's distance and still cause a great deal of hurt."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENSEIGA"
msgid "Would it work on you, Abigail? Would you want it to?"
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Something other than the dead lies buried here."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BAKUSAIGA"
msgid "There's no mourning a thing that has been utterly destroyed, I suppose."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LYCORIS_BACKPACK"
msgid "I could carry the flowers in this, until they're needed."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KAGE"
msgid "There is no telling where the shadow ends."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.M_PANTSU"
msgid "Someone once took the trouble to fold them."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OINC1000000"
msgid "A fortune makes a grave no less cold."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROWBAR"
msgid "It can open a great many things. There are some I'd leave closed."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REBAR"
msgid "That's all that's left when the stone around it crumbles."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BASEBALLBAT"
msgid "I wonder who last put it away, expecting another game."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MURASAME"
msgid "It looks as if it has been left out in the rain for years."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "There is no voice left to tell me what these words mean."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOAT_MSURFBOARD"
msgid "A shallow-draft vessel, though its stability is questionable."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HARAKIRI"
msgid "A ceremonial blade. Please handle it with care, dear."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HITOKIRI"
msgid "An unusual stain for this alloy. I shall refrain from taking a sample."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HMINGOT"
msgid "Its colour alone is sufficient warning of the temperature."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KATANABLADE"
msgid "The tang is exposed. It requires a hilt before it can be handled safely."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KATANABODY"
msgid "The rough profile has been established. Now comes the finer work."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOSHIRAE"
msgid "A rather specialised implement, judging by the weight and reach."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAID_HB"
msgid "A headpiece associated with domestic service."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINGOT"
msgid "I cannot identify the alloy by colour alone."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MMIKO_ARMOR"
msgid "The cut is characteristic of Japanese shrine garments."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MORTALBLADE"
msgid "Immortality, dear, is a surprisingly ill-defined condition."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MSURFBOARD_ITEM"
msgid "An excellent example of making use of buoyancy with very little material."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_FOXMASK"
msgid "Those ears leave very little doubt which animal the maker intended."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_SCARF"
msgid "Do make sure the wool is dry before you put it on, dear."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.RAIKIRI"
msgid "There appears to be an electrical discharge along the cutting edge."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHINAI"
msgid "A sensible means of practising fence without a sharpened blade."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHIRASAYA"
msgid "The undecorated wooden sheath is a handsome piece of joinery."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHUSUI"
msgid "The dark finish is strikingly uniform."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TOKIJIN"
msgid "The presence I detect merits further study from a considerable distance."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_HITOKIRI"
msgid "I recommend shelving the blade before it acquires another specimen."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_KOSHIRAE"
msgid "A tool of that size assumes an adversary of corresponding stature."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_RAIKIRI"
msgid "Observe the discharge, dear. Observe it from over there."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TRUE_SHIRASAYA"
msgid "The name implies an exorcistic function. I am in no hurry to verify it."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.VSCODE"
msgid "Its illuminated characters seem to change without type or ink. Curious."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YARI"
msgid "A spearhead of Japanese design, fitted to a long shaft."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TENSEIGA"
msgid "Its reputed properties would require a revision of several medical texts."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "The sword appears to have been deliberately sealed within the formation."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAKUSAIGA"
msgid "A single weapon scarcely accounts for the damage attributed to it."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LYCORIS_BACKPACK"
msgid "A well-made book satchel. The clasps should keep the contents in order."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KAGE"
msgid "The outline is remarkably difficult to distinguish from its own shadow."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.M_PANTSU"
msgid "I shall refrain from cataloguing somebody's undergarments."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OINC1000000"
msgid "An unusually large denomination. One wonders how it is redeemed."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROWBAR"
msgid "A straightforward application of the lever."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.REBAR"
msgid "The ridges help it bind to the material cast around it."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASEBALLBAT"
msgid "The wood has been shaped to concentrate the mass toward the striking end."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MURASAME"
msgid "No corresponding moisture on the sheath. I should like to know its source."
msgstr ""

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I don't recognise the script. I shall need a reference work."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MSURFBOARD"
msgid "There's hardly any boat to burn. What's the point?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HARAKIRI"
msgid "That's the sort of knife you put down and walk away from."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HITOKIRI"
msgid "I'd like to see if it still looks so nasty after a good fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HMINGOT"
msgid "Aww, it's already hot. I wanted to do that part."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KATANABLADE"
msgid "Someone should put a handle on it before I drop it on my foot."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KATANABODY"
msgid "Stick it back in the fire. That ought to liven things up."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOSHIRAE"
msgid "If you're fighting a giant, have you tried setting its trousers on fire?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAID_HB"
msgid "Do I look like I came here to dust the furniture?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINGOT"
msgid "Wonder what colour it turns in a really hot fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MMIKO_ARMOR"
msgid "Those sleeves had better stay out of my fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MORTALBLADE"
msgid "How about we see if the blade itself can burn?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MSURFBOARD_ITEM"
msgid "Great. Another way to get soaked."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_FOXMASK"
msgid "Can I wear it when I scare people at the campfire?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_SCARF"
msgid "That's handy for winter, when the fire needs a little help."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAIKIRI"
msgid "Lightning starts the nicest fires in dry grass."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHINAI"
msgid "It only takes one match to make it more interesting."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHIRASAYA"
msgid "Nice wooden sheath. It'd burn cleanly."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHUSUI"
msgid "Looks like it's already had a turn in the fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOKIJIN"
msgid "If I put it in the fire, will the thing inside come out?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_HITOKIRI"
msgid "Ew. That's a horrible red, even for me."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_KOSHIRAE"
msgid "Fine, hit the giant with it. I'll take care of the trousers."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_RAIKIRI"
msgid "Now that's a good loud crack. Do it again!"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUE_SHIRASAYA"
msgid "Can it chase something into a fire? Asking for me."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.VSCODE"
msgid "It's lit up and there's no fire anywhere. How boring."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YARI"
msgid "Long enough to reach the middle of a bonfire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENSEIGA"
msgid "Why does this one make me feel like I ought to be nice?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Dig it up! I want to see what happens."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BAKUSAIGA"
msgid "If it breaks everything, I call dibs on the pieces."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LYCORIS_BACKPACK"
msgid "Plenty of room for matches. I don't need the books."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KAGE"
msgid "I could bring a torch and still lose sight of that thing."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.M_PANTSU"
msgid "How fast do you think the stripes would burn?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OINC1000000"
msgid "They want me to go shopping with it. I want to see it burn."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROWBAR"
msgid "It'll do for turning a log over in the fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REBAR"
msgid "That bit of iron would be fun to heat up."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BASEBALLBAT"
msgid "It's a ball game till somebody sets the bat on fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MURASAME"
msgid "It looks wet. It wants a little time by the fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Who writes this small? Make it bigger or I'm using it for tinder."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MSURFBOARD"
msgid "Check the seams before you trust it with your weight."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HARAKIRI"
msgid "That one's staying off my workbench."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HITOKIRI"
msgid "There's a stain on that steel I'd rather not touch."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HMINGOT"
msgid "Tongs first, kid. Then you pick it up."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KATANABLADE"
msgid "Good grind. I'd fit a handle before I signed off on it."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KATANABODY"
msgid "The blank's sound. Now comes the finish work."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOSHIRAE"
msgid "That's a lot of steel to balance on one wrist."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MAID_HB"
msgid "Wouldn't keep much dust out of your hair."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINGOT"
msgid "I'd want to know what it's made of before I put a load on it."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MMIKO_ARMOR"
msgid "There's room to work in those sleeves. Too much room near machinery."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MORTALBLADE"
msgid "You don't need to read the label to know to keep clear."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MSURFBOARD_ITEM"
msgid "I could lash it down for shipping. I wouldn't ship anybody on it."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.M_FOXMASK"
msgid "The eyeholes are all wrong for a shop mask."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.M_SCARF"
msgid "Tuck it in before you get near a belt drive."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAIKIRI"
msgid "I'm going to stand somewhere well insulated."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SHINAI"
msgid "Practice is cheaper than a trip to the infirmary."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SHIRASAYA"
msgid "Nice joinery on the sheath. No gaps at all."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SHUSUI"
msgid "Hard to see a crack in steel that dark."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TOKIJIN"
msgid "There's something wrong with that blade, and it isn't the workmanship."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_HITOKIRI"
msgid "If that came through my shop, I'd tag it unsafe and call it a day."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_KOSHIRAE"
msgid "I see why they built it heavy. I don't see who they built it for."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_RAIKIRI"
msgid "I don't want that discharge anywhere near my tools."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TRUE_SHIRASAYA"
msgid "Do they make one that keeps the gremlins out of machinery?"
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VSCODE"
msgid "A keyboard without any typebars. How does that work?"
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YARI"
msgid "Mind the other end when you turn a corner with it."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TENSEIGA"
msgid "Well, that'd put a first-aid box to shame."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "The stone's cracked, but the blade's still in there tight."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BAKUSAIGA"
msgid "With an edge like that, you'd better watch what you're cutting into."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LYCORIS_BACKPACK"
msgid "Buckles look sound. I'd check the straps before loading it with tools."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KAGE"
msgid "No good reaching for a tool when you can't see its edge."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.M_PANTSU"
msgid "Somebody's wash. Leave it folded."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OINC1000000"
msgid "Try getting a cashier to break that before opening time."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CROWBAR"
msgid "A good bar. That crate lid doesn't stand a chance."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REBAR"
msgid "There's your reinforcement. Now where's the concrete?"
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BASEBALLBAT"
msgid "Decent balance. You can tell which end they want you to swing."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MURASAME"
msgid "Wet steel and a dry bench. That's worth a closer look."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I've read plenty of blueprints. This one's beyond me."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_MSURFBOARD"
msgid "Is tiny boat. Wolfgang must sit very carefully."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HARAKIRI"
msgid "Wolfgang has no use for sad little knife."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HITOKIRI"
msgid "Wolfgang is brave. Still will not touch scary sword."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HMINGOT"
msgid "Wolfgang can lift it after it gets cold."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KATANABLADE"
msgid "Where does Wolfgang put big mighty hand?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KATANABODY"
msgid "Is half a sword. Maybe is half as heavy?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KOSHIRAE"
msgid "Is for little giants. Really big giant needs more sword."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAID_HB"
msgid "Is good hat for sweeping. Wolfgang can sweep very fast!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINGOT"
msgid "Heavy little metal. Good for lifting with little finger."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MMIKO_ARMOR"
msgid "Does it come in mighty size?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MORTALBLADE"
msgid "Even mighty man does not want to try that edge."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MSURFBOARD_ITEM"
msgid "Wolfgang will stand in middle. Just in case."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_FOXMASK"
msgid "Wolfgang is fox now! Very big fox."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_SCARF"
msgid "Keeps mighty neck from getting chills."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.RAIKIRI"
msgid "Wolfgang is not afraid of thunder. Wolfgang just prefers quiet."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHINAI"
msgid "Good for practice. Wolfgang will try not to break it."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHIRASAYA"
msgid "Such plain case for such shiny sword."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHUSUI"
msgid "Is darker than top of stove."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOKIJIN"
msgid "Wolfgang does not like when sword looks at him first."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_HITOKIRI"
msgid "Too much red on that one. Wolfgang puts it down now."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_KOSHIRAE"
msgid "Ha! Now giant can have fair fight with Wolfgang!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_RAIKIRI"
msgid "Was that thunder? Wolfgang was only checking."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUE_SHIRASAYA"
msgid "Good sword can keep nasty things away at night."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VSCODE"
msgid "Tiny box has words in it. Wolfgang cannot find the paper."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YARI"
msgid "Wolfgang can hold it straight with one hand!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENSEIGA"
msgid "Is gentle sword. Wolfgang likes gentle sword."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Want Wolfgang to lift stone first?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BAKUSAIGA"
msgid "Looks heavy enough for both hands. Finally!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LYCORIS_BACKPACK"
msgid "Wolfgang can fill it with heavy things for a walk."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.KAGE"
msgid "Wolfgang will leave spooky shadow sword right here."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.M_PANTSU"
msgid "Someone's small clothes. Not Wolfgang's size."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OINC1000000"
msgid "Is big number. How many potatoes?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROWBAR"
msgid "Can lift whole crate. But little iron helps with lid."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.REBAR"
msgid "Wolfgang can bend it! Should Wolfgang bend it?"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BASEBALLBAT"
msgid "Wolfgang will try to keep ball inside field this time."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MURASAME"
msgid "Why sword wet? Wolfgang did not spill anything."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Is very strange writing. Wolfgang cannot make it out."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT_MSURFBOARD"
msgid "No room for a paddle on that thing, eh?"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HARAKIRI"
msgid "That's a grim use of a perfectly good bit of steel."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HITOKIRI"
msgid "Lucy, it's giving me the shivers just looking at it."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HMINGOT"
msgid "Careful. Hot iron looks an awful lot like cold iron at noon."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KATANABLADE"
msgid "Needs a handle that won't split in the cold."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KATANABODY"
msgid "Smith's still got a day's work in that, I'd say."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOSHIRAE"
msgid "That's one big blade. Still wouldn't take it logging."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAID_HB"
msgid "Not much of a hat for the bush."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINGOT"
msgid "Heavy for its size. Won't be mistaking it for a lump of pine."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MMIKO_ARMOR"
msgid "Fancy sleeves. Good luck keeping the sap off them."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MORTALBLADE"
msgid "I've got enough troubles with things that come back."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MSURFBOARD_ITEM"
msgid "I'd rather lash a few logs together and call it a raft."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_FOXMASK"
msgid "I've seen real foxes that looked less shifty, eh?"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.M_SCARF"
msgid "Good for the first cold morning in the bush."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAIKIRI"
msgid "A blade like that ought to stay clear of a tall stand of pines."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHINAI"
msgid "It'd make fine kindling if we were short, Lucy."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHIRASAYA"
msgid "Nice straight grain on that sheath."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHUSUI"
msgid "Black as a stump after a forest fire."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOKIJIN"
msgid "I don't care to hear a weapon talk unless it's you, Lucy."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_HITOKIRI"
msgid "That's a colour I don't like seeing on a blade."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_KOSHIRAE"
msgid "What do you reckon, Lucy? One axe for a tree, one sword for a giant?"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_RAIKIRI"
msgid "Last thing a dry bush needs is another lightning strike."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUE_SHIRASAYA"
msgid "Would it know the difference between a demon and a beaver?"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VSCODE"
msgid "Looks like a telegraph set. I don't see a wire on it, though."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YARI"
msgid "Might be handy keeping a bear on the far side of the camp."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENSEIGA"
msgid "What I'd give to have that work on the toughest days, eh?"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DREADSTONE_STACK_TOMB"
