msgid "Now I can take a measurement before they grind away the evidence."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.KOSHIRAE"
msgid "I'd like to measure the force at the tip when that blade is swung."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MAID_HB"
msgid "Cotton, I'd venture. At least it won't throw a spark."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MINGOT"
msgid "Unfamiliar density. I shall need my scales."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MMIKO_ARMOR"
msgid "I hope those cuffs can be drawn close about the wrists."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MORTALBLADE"
msgid "A test would require a rather particular subject."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MSURFBOARD_ITEM"
msgid "I'd like to determine the point at which it will roll over. Preferably from shore."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_FOXMASK"
msgid "The maker has sacrificed peripheral vision for effect."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_SCARF"
msgid "I'll keep the loose ends well clear of my apparatus."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.RAIKIRI"
msgid "I ought to measure that discharge before it finds ground."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHINAI"
msgid "Wood makes an excellent control for a test of the steel version."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHIRASAYA"
msgid "The join is so close I can scarcely see it through my spectacles."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.SHUSUI"
msgid "An extraordinarily dark surface. What did they treat it with?"
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TOKIJIN"
msgid "Something is vibrating, and the blade is perfectly still."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_HITOKIRI"
msgid "The surface has changed. Whatever did it may still be active."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_KOSHIRAE"
msgid "That mass would make it very difficult to arrest mid-swing."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_RAIKIRI"
msgid "An enviable source of current, if I can find a way to contain it."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TRUE_SHIRASAYA"
msgid "I am told it distinguishes demons. I should like to see the criterion."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.VSCODE"
msgid "Curious. It puts out light without a filament I can see."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.YARI"
msgid "Increasing the length of the shaft increases reach at a cost in control."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.TENSEIGA"
msgid "Where does the energy for such a restoration come from?"
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "The stone seems to have formed around the blade itself."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.BAKUSAIGA"
msgid "I'd test that blade only in a room with nothing in it worth saving."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.LYCORIS_BACKPACK"
msgid "I could put the lenses in one side and the tools in the other."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.KAGE"
msgid "The edge scarcely reflects light at all. That can't be accidental."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.M_PANTSU"
msgid "Somebody has an eye for regular spacing in stripes."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.OINC1000000"
msgid "Funding. At last, some funding."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.CROWBAR"
msgid "The flattened end is just narrow enough to slip under a casing."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.REBAR"
msgid "The ridges give the cement something to grip."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.BASEBALLBAT"
msgid "Observe how much wood they've left where it meets the ball."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.DESCRIBE.MURASAME"
msgid "It keeps its moisture in dry air. That's a useful property to have."
msgstr ""

#. STRINGS.CHARACTERS.WAGSTAFF.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WAGSTAFF.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "A fine drawing, but the notation eludes me."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.BOAT_MSURFBOARD"
msgid "Now there's a boat you can take over the breakers."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.HARAKIRI"
msgid "That isn't the kind of knife I bring to the beach."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.HITOKIRI"
msgid "That thing gives me the creeps even in full sun."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.HMINGOT"
msgid "Let's leave it to cool. I've got nowhere to be."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.KATANABLADE"
msgid "Put a grip on it and maybe I'll pick it up."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.KATANABODY"
msgid "The smith can finish it after a nap. I certainly would."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.KOSHIRAE"
msgid "Seems like an awful lot of trouble to go to over a giant."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MAID_HB"
msgid "I don't even dust my own place."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MINGOT"
msgid "Pretty heavy for a paperweight. It'll do, though."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MMIKO_ARMOR"
msgid "Those sleeves would take all day to dry."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MORTALBLADE"
msgid "Sounds like someone went looking for a fight that never ends."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MSURFBOARD_ITEM"
msgid "Good lines on that board. Mind if I take it out?"
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.M_FOXMASK"
msgid "That'd be fun till the first wave took it off."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.M_SCARF"
msgid "Good for sitting on the sand after sundown."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.RAIKIRI"
msgid "I'll take it as a sign to get out of the water."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.SHINAI"
msgid "I'd rather paddle out than practise swordplay."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.SHIRASAYA"
msgid "Nice and plain. No decoration for the sand to get into."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.SHUSUI"
msgid "Black like the water when the moon's gone."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TOKIJIN"
msgid "Whatever's whispering in there can find somebody else."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_HITOKIRI"
msgid "Put that away. This was going to be a nice day."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_KOSHIRAE"
msgid "If the giant wants a fight, I'll be out past the breakers."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_RAIKIRI"
msgid "No thanks. I'll wait on shore till the weather clears."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TRUE_SHIRASAYA"
msgid "Maybe it could clear whatever's making that beach so spooky."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.VSCODE"
msgid "That's a bright little box. I wonder if it minds salt air."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.YARI"
msgid "It might reach the sandy bottom from the shallows."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.TENSEIGA"
msgid "A blade that mends things? That I could get used to."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Wouldn't pull that out in the middle of a nice quiet afternoon."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.BAKUSAIGA"
msgid "I'd be more comfortable if it had a sheath on it."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.LYCORIS_BACKPACK"
msgid "Room for a towel and a bite to eat. Let's go."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.KAGE"
msgid "If I put it down in the shade, I'll never find it again."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.M_PANTSU"
msgid "Someone's laundry, drying in the sun."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.OINC1000000"
msgid "We could buy a place on the shore and never set an alarm again."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.CROWBAR"
msgid "Does it come with someone who'll do the prying?"
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.REBAR"
msgid "Heavy, rusty, and an excellent reason to wear sandals."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.BASEBALLBAT"
msgid "Who's up for an easy game on the beach?"
msgstr ""

#. STRINGS.CHARACTERS.WALANI.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WALANI.DESCRIBE.MURASAME"
msgid "I'm used to things getting wet. Usually I see the wave coming first."
msgstr ""

#. STRINGS.CHARACTERS.WALANI.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WALANI.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Let's ask someone who can read it. I was about to lie down."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BOAT_MSURFBOARD"
msgid "Ye call that a ship? Where be the gun deck?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HARAKIRI"
msgid "A dark purpose for a wee knife."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HITOKIRI"
msgid "That's seen a grim day's work, by the look of it."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.HMINGOT"
msgid "Leave it off me deck till it cools!"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KATANABLADE"
msgid "Put a proper grip on her, then we'll talk."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KATANABODY"
msgid "That be a blade with a ways to go."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KOSHIRAE"
msgid "I'd sooner take a broadside to a giant."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MAID_HB"
msgid "Ye won't catch this captain in a frilly cap."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MINGOT"
msgid "What kind o' booty be this, then?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MMIKO_ARMOR"
msgid "Too much sail about the sleeves!"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MORTALBLADE"
msgid "Could be worth keepin' for the crew that won't stay buried."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MSURFBOARD_ITEM"
msgid "That plank be for walkin', not sailin'!"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_FOXMASK"
msgid "I don't need a fox face to look sly."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_SCARF"
msgid "Aye, that'll keep the spray off me neck."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.RAIKIRI"
msgid "I've no wish to call a storm down on me mast."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHINAI"
msgid "A cutlass for a cabin boy, that."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHIRASAYA"
msgid "Plain as driftwood till ye draw the steel."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.SHUSUI"
msgid "Black as the hold with the hatch shut."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TOKIJIN"
msgid "I've heard enough whispers on a night watch, thanks."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_HITOKIRI"
msgid "A blade to leave at the bottom o' the sea."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_KOSHIRAE"
msgid "Ye won't swing that in the captain's cabin."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_RAIKIRI"
msgid "A good crack o' thunder in the middle of a clear day!"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TRUE_SHIRASAYA"
msgid "Would it run off the ghosts that haunt me charts?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.VSCODE"
msgid "Some kind o' signal lamp with letters in it, is it?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.YARI"
msgid "Good reach. I'd lash it down in a gale."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.TENSEIGA"
msgid "The sea doesn't give up her dead so easy."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "A sword buried in stone! Should've brought me pick."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BAKUSAIGA"
msgid "That'll put a hole in a strongbox if there's no key to hand."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.LYCORIS_BACKPACK"
msgid "Two buckles or twenty, I'll want it lashed down in a blow."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.KAGE"
msgid "Who'd stow a sword where a man can't see to grab it?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.M_PANTSU"
msgid "Who's been hanging their washing on me rigging?"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.OINC1000000"
msgid "Now that's a piece o' treasure worth the digging!"
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.CROWBAR"
msgid "A bar for persuadin' locked chests."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.REBAR"
msgid "A rusty length o' iron. Give it to the ballast."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.BASEBALLBAT"
msgid "Never played it on deck. We'd lose the ball to the first good hit."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WOODLEGS.DESCRIBE.MURASAME"
msgid "I've seen drier blades after a storm at sea."
msgstr ""

#. STRINGS.CHARACTERS.WOODLEGS.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WOODLEGS.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I can read some dreadful charts, but this defeats me."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.BOAT_MSURFBOARD"
msgid "It's got just enough room for an explorer and no room for her luggage."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.HARAKIRI"
msgid "I leave ceremonial knives right where I find them."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.HITOKIRI"
msgid "I don't think that stain came from the mud."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.HMINGOT"
msgid "I've found another use for my tongs."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.KATANABLADE"
msgid "Good steel. Now I need something that can hold it without cutting my hand."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.KATANABODY"
msgid "That still needs some work before I'd pack it for an expedition."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.KOSHIRAE"
msgid "If there's a sword for giants, somebody must know where to find one."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MAID_HB"
msgid "Fancy, but it won't keep the sun out of my eyes."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MINGOT"
msgid "Unidentified metal. I'll make a note of where I found it."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MMIKO_ARMOR"
msgid "Not a good choice for making your way through brush."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MORTALBLADE"
msgid "If a warning can be made of steel, this is it."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MSURFBOARD_ITEM"
msgid "I'll try anything once. This one had better be in shallow water."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_FOXMASK"
msgid "An excellent disguise, as long as nobody expects a real fox."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_SCARF"
msgid "A bit of warmth for the early start."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.RAIKIRI"
msgid "I'd put some distance between that and my compass."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHINAI"
msgid "Something to practise with before drawing the real thing."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHIRASAYA"
msgid "A plain sheath won't draw much attention when I travel."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.SHUSUI"
msgid "I'd have trouble finding that in the bottom of my pack."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TOKIJIN"
msgid "There's trouble in that blade and I've already got my share."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_HITOKIRI"
msgid "I think I'll leave it out of my field report."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_KOSHIRAE"
msgid "I hope the giant isn't uphill. I wouldn't want to carry that up to meet it."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_RAIKIRI"
msgid "We can't call it clear weather with that thing along."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TRUE_SHIRASAYA"
msgid "An exorcist's blade. One more thing to bring into a ruin, I suppose."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.VSCODE"
msgid "It shines like an electric lamp. Can it do anything else?"
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.YARI"
msgid "I could use it to test the depth of the ford."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.TENSEIGA"
msgid "That's what I call emergency supplies."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "There's a sword in there. Now how do I bring back a sample of the stone?"
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.BAKUSAIGA"
msgid "Let's put that on the far side of the expedition crates."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.LYCORIS_BACKPACK"
msgid "That's just the size for my maps and travel journal."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.KAGE"
msgid "I'd tie something bright to the handle before setting it down."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.M_PANTSU"
msgid "Well, someone got a start on the washing."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.OINC1000000"
msgid "Finally, a budget for a proper expedition!"
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.CROWBAR"
msgid "I've never opened an untouched ruin with a key."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.REBAR"
msgid "Could prop open a hatch in a pinch."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.BASEBALLBAT"
msgid "I could have a go at that once we set up camp."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.MURASAME"
msgid "I'll pack that outside the bag. My maps need to stay dry."
msgstr ""

#. STRINGS.CHARACTERS.WHEELER.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WHEELER.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I've read plenty of maps. Whatever this is, it's beyond me."
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.BOAT_MSURFBOARD"
msgid "YON LITTLE SHIP HATH NO ROOM FOR A THRONE"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.HARAKIRI"
msgid "A GRIM AND LITTLE BLADE"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.HITOKIRI"
msgid "WITNESS YE THE ILL MARK UPON YON BLADE"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.HMINGOT"
msgid "WILBA SHALL WAIT UNTIL IT CEASETH GLOWING"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.KATANABLADE"
msgid "GIVETH WILBA A HILT TO HOLD"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.KATANABODY"
msgid "WHEREFORE HATH THE SMITH LEFT IT UNFINISHED?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.KOSHIRAE"
msgid "A SWORD FOR HIM WHO WOULD SMITE A GIANT"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MAID_HB"
msgid "WILBA DOTH NOT SWEEP IN HER CROWN"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MINGOT"
msgid "WHAT METAL HATH THE EARTH GIVEN US?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MMIKO_ARMOR"
msgid "THE FINE ROBE HATH NO ROOM FOR WILBA'S TAIL"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MORTALBLADE"
msgid "THAT EDGE DOTH MAKE AN END OF FOREVER"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MSURFBOARD_ITEM"
msgid "SHALL WILBA STAND UPON A MERE PLANK?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.M_FOXMASK"
msgid "WILBA WOULD KNOW A FALSE FOX ANY DAY"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.M_SCARF"
msgid "A WARM THING FOR A COLD PRINCESS"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.RAIKIRI"
msgid "THE SKIES DO SPEAK THROUGH THE STEEL"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.SHINAI"
msgid "BRING FORTH THE WOODEN SWORDS!"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.SHIRASAYA"
msgid "A HUMBLE SHEATH FOR NOBLE STEEL"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.SHUSUI"
msgid "BLACK AS YON CASTLE CELLAR"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TOKIJIN"
msgid "GET THEE GONE, FOUL SPIRIT!"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_HITOKIRI"
msgid "KEEP YON RED BLADE FAR FROM THE ROYAL HALL"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_KOSHIRAE"
msgid "YON GIANT SHALL KNEEL BEFORE WILBA"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_RAIKIRI"
msgid "THUNDER IN THE COURT!"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TRUE_SHIRASAYA"
msgid "WOULD IT SPARE A CURSED PRINCESS?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.VSCODE"
msgid "WHO LIT THE LETTERS INSIDE YON BOX?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.YARI"
msgid "A SPEAR FOR THE GUARD AT WILBA'S GATE"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.TENSEIGA"
msgid "THAT BLADE HATH A GENTLER DUTY"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "WHO BURIED YON SWORD IN LIVING STONE?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.BAKUSAIGA"
msgid "LET NONE DRAW IT WITHIN THE PALACE WALLS"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.LYCORIS_BACKPACK"
msgid "WILBA SHALL CARRY HER OWN BOOKS"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.KAGE"
msgid "WHAT SHADOW DARES TO WEAR AN EDGE?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.M_PANTSU"
msgid "THE LAUNDRY HATH FALLEN"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.OINC1000000"
msgid "TO THE ROYAL TREASURY WITH THEE!"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.CROWBAR"
msgid "NOW THE STUBBORN CHEST SHALL OPEN"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.REBAR"
msgid "WILBA HATH FOUND THE IRON FROM THE WALL"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.BASEBALLBAT"
msgid "WHO SHALL PITCH TO THEIR PRINCESS?"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WILBA.DESCRIBE.MURASAME"
msgid "YON SWORD IS WET WITH NO CLOUD IN SIGHT"
msgstr ""

#. STRINGS.CHARACTERS.WILBA.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WILBA.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "WILBA KNOWETH NOT YON LETTERS"
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.BOAT_MSURFBOARD"
msgid "One passenger. Little cover."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.HARAKIRI"
msgid "Leave it sheathed."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.HITOKIRI"
msgid "Something's soaked into the steel."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.HMINGOT"
msgid "Use the tongs."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.KATANABLADE"
msgid "Good edge. Finish the grip first."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.KATANABODY"
msgid "The profile's set. The edge isn't."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.KOSHIRAE"
msgid "Too heavy to carry unless you know what you're facing."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MAID_HB"
msgid "It'd pass for part of a uniform."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MINGOT"
msgid "I'll need a sample before I can identify it."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MMIKO_ARMOR"
msgid "The sleeves would catch on my kit."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MORTALBLADE"
msgid "So there is a way to make sure they stay down."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MSURFBOARD_ITEM"
msgid "Low profile. No room for spare gear."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.M_FOXMASK"
msgid "It hides my face and cuts my field of view."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.M_SCARF"
msgid "Wrap it tight. Loose ends catch."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.RAIKIRI"
msgid "That flash tells them exactly where you are."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.SHINAI"
msgid "Good for drills. Clear the floor first."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.SHIRASAYA"
msgid "Plain wooden sheath. Easy to carry unnoticed."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.SHUSUI"
msgid "No glint off the blade. Useful."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TOKIJIN"
msgid "I don't take orders from people. A sword won't change that."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_HITOKIRI"
msgid "Keep it covered. I've seen enough of that colour."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_KOSHIRAE"
msgid "I wouldn't carry it through a doorway in a hurry."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_RAIKIRI"
msgid "If we want to leave quietly, that stays behind."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TRUE_SHIRASAYA"
msgid "I'd want to know what it considers a target."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.VSCODE"
msgid "An editor. We'd need the project files for it to be useful."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.YARI"
msgid "Good reach. Awkward in a confined space."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.TENSEIGA"
msgid "A weapon that brings people back. I'd want proof."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "The blade's sealed in. Check the stone before touching it."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.BAKUSAIGA"
msgid "With that much force, I'd keep it away from anyone on my side."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.LYCORIS_BACKPACK"
msgid "The buckles still close properly. I can use it."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.KAGE"
msgid "If I can't see the edge, neither can the person in front of me."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.M_PANTSU"
msgid "Leave it where it is."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.OINC1000000"
msgid "It's only worth something where they'll accept it."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.CROWBAR"
msgid "Useful when the door won't open and there's no key."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.REBAR
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.REBAR"
msgid "It'll do. Keep the rust off whatever it's packed with."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.BASEBALLBAT"
msgid "It's Shino's. I don't need to try it to be sure."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.INOUE.DESCRIBE.MURASAME"
msgid "It's wet again. I just wiped it dry."
msgstr ""

#. STRINGS.CHARACTERS.INOUE.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.INOUE.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I can't verify what this says."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "I can't make sense of these markings."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BAKUSAIGA"
msgid "There's an old story behind this blade."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BASEBALLBAT"
msgid "I could give it a swing if someone pitched."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROWBAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CROWBAR"
msgid "That'll get the lid off."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Is that a sword hilt sticking out of the stone?"
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MURASAME"
msgid "The blade is damp, but the hilt is dry."
msgstr ""

