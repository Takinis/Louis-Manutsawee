msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.VSCODE"
msgid "Little glow. No sun warmth."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.YARI"
msgid "Long pokey stick."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TENSEIGA"
msgid "Makes hurt go away?"
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.DREADSTONE_STACK_TOMB
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.DREADSTONE_STACK_TOMB"
msgid "Sharp thing growing out of rock."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.BAKUSAIGA"
msgid "Don't let it near roots."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LYCORIS_BACKPACK
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LYCORIS_BACKPACK"
msgid "Soil in one pocket, seeds in other."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.KAGE"
msgid "Can't see where sharp ends."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.M_PANTSU"
msgid "Stripes. No roots. Clothes."
