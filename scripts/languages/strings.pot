msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK.2"
msgid "It pays to know where you put the spare supplies."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSSLING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSSLING.1"
msgid "I'd watch the mosling from just over here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSSLING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSSLING.2"
msgid "I'll wait and see which way it turns."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOUND.DUG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOUND.DUG.1"
