msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONSTORM_STATIC_CATCHER.1"
msgid "I'd set the static restrainer beside the rest of my supplies."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONSTORM_STATIC_CATCHER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONSTORM_STATIC_CATCHER.2"
