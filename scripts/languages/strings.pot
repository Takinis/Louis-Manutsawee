msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FIRESUPPRESSOR.LOWFUEL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FIRESUPPRESSOR.LOWFUEL.2"
