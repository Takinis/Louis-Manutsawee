msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABBITKINGMINION_BUNNYMAN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABBITKINGMINION_BUNNYMAN.1"
msgid "I'd like to watch the royal rabbit enforcer from somewhere quiet."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABBITKINGMINION_BUNNYMAN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABBITKINGMINION_BUNNYMAN.2"
