msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.SHIRASAYA"
msgid "Wood keeps sharp inside."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.SHUSUI"
msgid "Dark sharp. Shiny in the dark?"
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TOKIJIN
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TOKIJIN"
msgid "Bad feeling. Leave sleeping."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_HITOKIRI"
msgid "Red part isn't flower."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_KOSHIRAE"
msgid "Very big cut for very big thing."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_RAIKIRI"
msgid "Sky noise! Sky light!"
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.TRUE_SHIRASAYA"
