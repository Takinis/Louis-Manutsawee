msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TOMATO_SEEDS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TOMATO_SEEDS.1"
