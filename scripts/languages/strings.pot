msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MMIKO_ARMOR"
msgid "Pretty red and white. Like flower."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MORTALBLADE"
msgid "Stops things growing back?"
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MSURFBOARD_ITEM"
