msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.3"
msgid "But I can see how you hold your blade."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.4
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.4"
msgid "That skill is yours. None can take it from you."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.5
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.5"
msgid "You believe that where there is a will, there is a way."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.6
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.6"
msgid "So firmly did I believe it, too."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.7
msgctxt "STRINGS.STALKER_NPC_INSPECT.MANUTSAWEE.7"
