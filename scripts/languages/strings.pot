#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITO.HELD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITO.HELD.2"
