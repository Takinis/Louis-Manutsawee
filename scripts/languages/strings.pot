msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONSTORM_STATIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONSTORM_STATIC.2"
