#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.CHOPPED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.CHOPPED.2"
msgid "I can count the rings from here."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.GENERIC.1"
msgid "I want to look at the boulderbough in better light."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK.GENERIC.2"
msgid "I should mind where I step near the roots."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK_SAPLING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK_SAPLING.1"
msgid "I know a patch of soil for the boulderbough sapling."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK_SAPLING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_ROCK_SAPLING.2"
