#. STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.4
msgctxt "STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.4"
msgid "And when you help someone to their feet, you are just as careful."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.5
msgctxt "STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.5"
msgid "I once thought strength meant I need never ask leave again."
msgstr ""

#. STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.6
msgctxt "STRINGS.STALKER_NPC_INSPECT.KIRITZUKA.6"
