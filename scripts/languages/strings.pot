msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FOLIAGE_DRIED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FOLIAGE_DRIED.2"
