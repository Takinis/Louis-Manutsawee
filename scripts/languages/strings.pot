msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.BASEBALLBAT
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.BASEBALLBAT"
msgid "Tree piece for hitting ball."
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MURASAME
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MURASAME"
msgid "Blade has rain. Can share with thirsty friends?"
msgstr ""

#. STRINGS.CHARACTERS.WORMWOOD.ANNOUNCE_LNCOMPREHENSIBLE
msgctxt "STRINGS.CHARACTERS.WORMWOOD.ANNOUNCE_LNCOMPREHENSIBLE"
msgid "Not understanding."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MSURFBOARD"
msgid "A board afloat, a little boat! Will it hold a hoof or two?"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HARAKIRI"
msgid "A grim little blade. I'd sooner leave it where it laid."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HITOKIRI"
msgid "That's a nasty stain. I doubt it came from berry juice."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HMINGOT"
msgid "Glowing hot! Touch it? I shall not."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KATANABLADE"
msgid "No hilt to hold! Might be a very short trick, I'm told."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KATANABODY"
