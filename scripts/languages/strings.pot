msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOUND.DUG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOUND.DUG.2"
