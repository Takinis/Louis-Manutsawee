#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE.2"
msgid "I remember setting aside the mosquito sack to make this."
msgstr ""

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK.1"
