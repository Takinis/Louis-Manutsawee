#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAYER_HOSTED.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAYER_HOSTED.GENERIC.2"
