#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURKEYDINNER"
msgid "A feast of roasted bird."
msgstr "一頓烤鳥大餐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP"
msgid "I'm not fond of turnips."
msgstr "我不太喜歡蕪菁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP_COOKED"
msgid "Take that, turnip."
msgstr "吃我一招吧，蕪菁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURNIP_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURTILLUS"
msgid "How am I supposed to hit you through all that armor?"
msgstr "穿著這麼厚的盔甲，我要怎麼打到你？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.BURNING"
msgid "What a waste of wood."
msgstr "多麼浪費木材啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "我覺得我本可以阻止這種情況發生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Take that, nature!"
msgstr "吃我一斧，大自然！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It looks sick. More so than usual."
msgstr "看起來病了。比平常更是如此。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "It's all stick-y."
msgstr "全是樹枝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_NUT"
msgid "There's a stick-y tree inside it that wants to get out."
msgstr "裡面有一棵全是樹枝的樹想要出來。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It doesn't need any help to grow."
msgstr "它不需要任何幫助就能成長。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGGY_OLD"
msgid "That tree looks pretty wimpy."
msgstr "那棵樹看起來很軟弱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWIGS"
msgid "A bunch of small twigs."
msgstr "一束小樹枝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWINOFTERROR1"
msgid "ROBO! ROBOROBOROBOROBOROBO..."
msgstr "機器！機器機器機器機器機器……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TWINOFTERROR2"
msgid "ROBO! ROBOROBOROBOROBOROBO..."
msgstr "機器！機器機器機器機器機器……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UMBRELLA"
msgid "I like the color."
msgstr "我喜歡這個顏色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UNAGI"
msgid "Unagi daisuki-desu."
msgstr "鰻魚，最喜歡了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.UNIMPLEMENTED"
msgid "It's not finished yet."
msgstr "還沒完成。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGGIEOMLET"
msgid "There are vegetables hiding underneath."
msgstr "蔬菜都藏在下面了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "A big pile of stinky mush."
msgstr "一大堆臭糊糊的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VEGSTINGER"
msgid "Can you use the celery as a straw?"
msgstr "你能用芹菜當吸管嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Ha! This is going to look hilarious!"
msgstr "哈！這看起來一定很好笑！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH"
msgid "Finders keepers."
msgstr "誰撿到就是誰的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTHHAT"
msgid "You never know who might really be hiding under that hood."
msgstr "你永遠不知道那兜帽底下藏著誰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_KIT"
msgid "I suppose I can fix it. Hold on."
msgstr "我想我能修好它。等一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Farming just became more efficient."
msgstr "種田變得更有效率了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "At least it keeps the rain off."
msgstr "至少可以擋雨。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOLTGOATJELLY"
msgid "Warly, may I eat this?"
msgstr "沃利，我可以吃這個嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VSCODE"
msgid "Can you change the world?"
msgstr "你能改變世界嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAFFLES"
msgid "Hello, waffles."
msgstr "你好呀，鬆餅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNKBITS_KIT"
msgid "A nice gadget."
msgstr "不錯的小裝置。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNKHAT"
msgid "A hat that teaches scholars how to fight. Handy."
msgstr "一頂能教學者打架的帽子。真方便。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_BITS"
msgid "What am I supposed to do with that?"
msgstr "我要拿那個做什麼？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Someone should really tidy up this scrap heap."
msgstr "真該有人來收拾這堆廢鐵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Looks important. I'll keep it for review."
msgstr "看起來很重要。我先留著複查。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC"
msgid "Older folk always seem to need help with one thing or another."
msgstr "上了年紀的人好像總有這樣那樣的事需要幫忙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Hey, suspicious guy, do you think I have all the time in the world for your schemes?"
msgstr "嘿，可疑的傢伙，你以為我有那麼多時間陪你耍陰謀嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Are you in a hurry to die?"
msgstr "你急著去死嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "I have a feeling this belongs to that old gentleman."
msgstr "我感覺這是那位老先生的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "Couldn't he have fetched it himself?"
msgstr "他就不能自己去拿嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Yeah, that looks like a Whaddayacallit! Or was it a Whatchamahoosit..."
msgstr "對，這看起來就是那個什麼來著！還是那個叫什麼的……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "I found a tool! Maybe it's the one he's looking for?"
msgstr "我找到一件工具！也許就是他要找的那件？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "Looks like strange science equipment. Perhaps the old gentleman is looking for it."
msgstr "看起來像奇怪的科學設備。也許那位老先生正在找它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK"
msgid "So, who're we going to make walk it?"
msgstr "那麼，我們要讓誰走上去呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_GRASS"
msgid "So, who are we going to make walk it?"
msgstr "那麼，我們要讓誰走上去呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_YOTD"
msgid "It's not much fun, but a least it's pretty."
msgstr "這不是很有趣，但至少很漂亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKING_STICK"
msgid "A walking stick. Sensible."
msgstr "一根手杖。很合理。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_DREADSTONE"
msgid "Couldn't we have made walls out of literally anything else?"
msgstr "我們就不能用別的東西來砌牆嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Building is so much work."
msgstr "蓋房子真費工夫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY.BURNT"
msgid "It didn't keep the fire out."
msgstr "它沒能擋住火。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY.GENERIC"
msgid "This will keep all sorts of things out!"
msgstr "這能把各種東西都擋在外面！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_HAY_ITEM"
msgid "This seems like a bad idea."
msgstr "這似乎是個壞主意。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_MOONROCK"
msgid "Safe for now."
msgstr "目前安全。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "I guess I could carry it."
msgstr "我想我能帶上它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS"
msgid "And they'll huff and they'll puff!"
msgstr "任它們又吹又喘！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS_2"
msgid "And they'll huff and they'll puff!"
msgstr "任它們又吹又喘！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_RUINS_ITEM"
msgid "Will those fit in my pockets?"
msgstr "這些裝得進我的口袋嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_SCRAP"
msgid "Scrap can still make a useful wall."
msgstr "廢料也能砌成有用的牆。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_SCRAP_ITEM"
msgid "I'll reinforce the camp with these."
msgstr "用這些加固營地。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE"
msgid "It will do."
msgstr "這樣就可以了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE_2"
msgid "It will do."
msgstr "這樣就可以了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_STONE_ITEM"
msgid "These are surprisingly heavy."
msgstr "這些東西非常重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD.BURNT"
msgid "Burnt!"
msgstr "燒焦了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Pointy!"
msgstr "尖尖的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALL_WOOD_ITEM"
msgid "I don't enjoy hiding."
msgstr "我不喜歡躲躲藏藏。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS"
msgid "Please stop following me."
msgstr "請別再跟著我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUSHAT"
msgid "I rather like the look of it."
msgstr "我還蠻喜歡它的樣子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "I'm not going in there."
msgstr "我不進去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Everyone has a nicer house than me."
msgstr "每個人的房子都比我的好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALRUS_TUSK"
msgid "A handsome tusk."
msgstr "一根漂亮的海象牙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.ATTACKER"
msgid "He finally snapped."
msgstr "他終於崩潰了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.FIRESTARTER"
msgid "Oh... s-should i start making a fire too?"
msgstr "喔……我、我也應該開始生火嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.GENERIC"
msgid "Hello, %s."
msgstr "您好，%s。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.GHOST"
msgid "I think he's actually having fun."
msgstr "我覺得他其實玩得很開心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.MURDERER"
msgid "Murderer confirmed. Stand down."
msgstr "確認為殺人者。停止行動。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTER.REVIVER"
msgid "Thank you, Walter. I suppose I owe you an apology for teasing."
msgstr "謝謝你，沃爾特。看來我得為之前取笑你道歉了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALTERHAT"
msgid "It doesn't suit me."
msgstr "它不適合我。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.ATTACKER"
msgid "Please, watch it!"
msgstr "請小心一點！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.FIRESTARTER"
msgid "Stop it, %s! You're going to get in trouble!"
msgstr "住手，%s！你會惹上麻煩的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.GENERIC"
msgid "Hello, %s."
msgstr "您好，%s。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.GHOST"
msgid "I'm guessing something went wrong."
msgstr "我猜是出了什麼差錯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.MURDERER"
msgid "Murderer confirmed. Keep your distance."
msgstr "確認為殺人者。保持距離。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDA.REVIVER"
msgid "%s is always there when we need her."
msgstr "我們需要她的時候，%s 總是在。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.BURNING"
msgid "Fire fire fire!"
msgstr "著火了，著火了，著火了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.BURNT"
msgid "The fire has gone out."
msgstr "火已經熄了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARDROBE.GENERIC"
msgid "It holds dark, forbidden secrets..."
msgstr "它蘊藏著黑暗、禁忌的秘密……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WARG
