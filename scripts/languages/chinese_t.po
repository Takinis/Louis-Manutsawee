msgstr "真酷！不知道它能打開什麼？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "I want to go to the park."
msgstr "我想去公園。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "It's the kind of lamp they have in the city."
msgstr "這是城裡的那種燈。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_LAMP_SHORT"
