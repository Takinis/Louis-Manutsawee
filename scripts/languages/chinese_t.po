msgstr "力氣恢復原樣了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "No more electricity."
msgstr "不帶電了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Back to dodging the rain."
msgstr "又得躲雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
