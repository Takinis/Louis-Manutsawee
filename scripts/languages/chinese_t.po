msgstr "啊！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLACKFLAG"
msgid "Looks like it's already charred."
msgstr "看起來已經燒焦了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_FIRE"
msgid "My, that's a clever little thing."
msgstr "哎呀，真是個聰明的小東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA"
msgid "Ptoo! Take that."
msgstr "呸！嚐嚐這個。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA2"
msgid "My, what firepower."
msgstr "哎呀，好強的火力。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_PIPE"
msgid "I like a weapon you can shoot from far away. Preferably while running."
msgstr "我喜歡可以從遠處射擊的武器。最好是在跑步時。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_SLEEP"
msgid "Just don't breathe in."
msgstr "只是不要吸氣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_YELLOW"
msgid "It's a shock to the system."
msgstr "這對系統來說是一個衝擊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEAMULET"
msgid "I'm not a fan of this."
msgstr "我不太喜歡這個。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM"
msgid "This one is a bit ugly."
msgstr "這顆有點難看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEMOONEYE"
msgid "That's not an eyeball. It's a rock."
msgstr "那不是眼球，是石頭。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.COMMON"
msgid "This will save some experimentation."
msgstr "這將節省一些實驗。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.RARE"
msgid "Whoa. It doesn't burn."
msgstr "哇，它燒不起來。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP"
msgid "It smells like a gym sock."
msgstr "聞起來像運動襪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP_COOKED"
msgid "Transformed by fire."
msgstr "被火改變了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Just a mushroom."
msgstr "只是一朵蘑菇。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hello? Come up here, please."
msgstr "您好？請上來吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也許有一天它會回來。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARDS"
msgid "Boards. Good and sturdy."
msgstr "木板。又好又結實。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARON"
msgid "Keep that snout to yourself."
msgstr "把你的豬鼻子拿開。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARRIOR"
msgid "He looks pretty haggard."
msgstr "他看起來很憔悴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT03"
msgid "Well, there goes that."
msgstr "嗯，這下沒了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT04"
msgid "Well, there goes that."
msgstr "嗯，這下沒了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT05"
msgid "Well, there goes that."
msgstr "嗯，這下沒了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATPATCH"
msgid "Repairs are routine, but necessary."
msgstr "修補是例行工作，但很有必要。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "My brain is going into overload."
msgstr "我的大腦即將超負荷。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Strategic."
msgstr "戰略。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Tryin' to throw a monkeywrench in my race"
msgstr "想在我的比賽裡搗亂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK"
msgid "It's trying to wreak havoc on my game"
msgstr "它想毀了我的比賽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Watch out for that buoy!"
msgstr "小心那個浮標！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "給我下水吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "給我下水吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Clap! Clap if you believe in me!"
msgstr "鼓掌！相信我的話就鼓掌！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START"
msgid "Here we go?"
msgstr "開始了？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "No, I don't want to play."
msgstr "不，我不想玩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It's slimy."
msgstr "黏糊糊的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Building bumpers beats sinking, I suppose."
msgstr "我想，造保險槓總比沉船好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Nothing sturdier than seashells, clearly."
msgstr "顯然沒什麼比貝殼更結實了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Building bumpers beats sinking, I suppose."
msgstr "我想，造保險槓總比沉船好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Those teeth are just decoration."
msgstr "那些牙齒只是裝飾品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Let's paddle together~"
msgstr "一起來划槳吧~"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "The only fun part of sailing is firing the cannon."
msgstr "航海唯一有趣的部分就是開炮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It isn't loaded. How dull."
msgstr "沒有裝彈。真無聊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I'm out of ammunition... Wes, you always wanted to be a human cannonball, didn't you?"
msgstr "我沒彈藥了……韋斯，你一直想當人肉炮彈，對吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON_KIT"
msgid "If I build it, I get to fire it."
msgstr "既然是我造的，就該由我來開炮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_GRASS_ITEM"
msgid "It won't burn well if I put it in the water, but it will float."
msgstr "放進水裡燒不太起來，但能浮著。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ITEM"
msgid "That's the boat part of the boat."
msgstr "這是船的船身部分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LEAK"
msgid "I should patch that up before we sink."
msgstr "我應該在我們沉沒之前把它修好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "All right, it works fine. I was wrong to doubt it."
msgstr "好吧，運行正常。是我不該懷疑它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "A large magnet. Functional enough."
msgstr "一塊大磁鐵。夠用了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I suppose that means it's working."
msgstr "我想這說明它在運作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This will attract any strong magnets nearby."
msgstr "這將吸引附近的強磁鐵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Wilson, how am I supposed to put all this together?"
msgstr "威爾遜，這些東西我要怎麼組裝起來？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MSURFBOARD"
msgid "Ride the waves!"
msgstr "乘風破浪！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR"
msgid "Let's see how fast we can spin without getting sick."
msgstr "來看看我們能轉多快還不暈吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Alright, I'll install the rudder properly."
msgstr "好吧，我會好好把舵裝上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "Bernie is much cuddlier than a hairy old pillow."
msgstr "伯尼比毛茸茸的舊枕頭好抱多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_KELP"
msgid "This pillow is full of wet seaweed."
msgstr "這個枕頭裡全是濕海藻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_PETALS"
msgid "I guess that's one use for flowers."
msgstr "我想這就是花的用途之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "I'm fairly sure this is the worst pillow ever made."
msgstr "我敢肯定這是史上最糟糕的枕頭。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT"
msgid "Heh. Think fast."
msgstr "呵。接著。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood must have been tinkering with this one."
msgstr "這一定是沃姆伍德鼓搗出來的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESHARD"
msgid "I don't think these are good for much."
msgstr "我想這些沒什麼大用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESOUP"
msgid "I could happily finish a bowl of that."
msgstr "這個我能開心地喝完一碗。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESTEW"
msgid "Smells like Sunday supper."
msgstr "聞起來像週日的晚餐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.BURNT"
msgid "Knowledge can't be treated like this"
msgstr "知識不能這樣對待"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Hey, who can remember what I learned in high school?"
msgstr "嘿，誰還記得我高中學過的東西？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BEES"
msgid "A book about bees. I'll read it carefully."
msgstr "一本關於蜜蜂的書。我會仔細讀的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BIRDS"
msgid "Study first, action second."
msgstr "先學習，後行動。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BRIMSTONE"
msgid "That one looks dangerous. I'll be careful with it."
msgstr "這本看起來很危險。我會小心的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_ELEMENTAL"
msgid "Looks interesting."
msgstr "看起來很有意思。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FIRE"
msgid "I don't need books to teach me this!"
msgstr "我不需要書本來教我這個！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FISH"
msgid "It's as interesting as fishing."
msgstr "就像釣魚一樣有趣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FOSSIL"
msgid "A book about fossils. Heavy reading, literally."
msgstr "一本關於化石的書。讀起來真的很沉重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_GARDENING"
msgid "Basic cultivation knowledge. Useful."
msgstr "基礎的栽培知識，很有用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE"
msgid "Horticulture notes. Worth learning."
msgstr "園藝筆記，值得學習。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "The knowledge within shall grant us bountiful harvests."
msgstr "裡面的知識將會給我們帶來豐富的收穫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT"
msgid "Sounds pretty mysterious!"
msgstr "聽起來很神秘！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Let's keep this one close at hand, shall we?"
msgstr "讓我們把這個放在手邊，好嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_MOON"
msgid "I'm looking up at the moon~"
msgstr "我抬頭看月亮~"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN"
msgid "A book about rain. Not my favorite subject."
msgstr "一本關於雨的書。不是我喜歡的主題。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "More knowledge!"
msgstr "更多知識！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SILVICULTURE"
msgid "A book about growing trees. Patient work."
msgstr "一本關於種樹的書。是需要耐心的工作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SLEEP"
msgid "Rather dull. I may nod off."
msgstr "相當枯燥。我可能會打瞌睡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TEMPERATURE"
msgid "...Sorry, I nodded off."
msgstr "……抱歉，我打瞌睡了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TENTACLES"
msgid "A book about tentacles. I'll read it with the lights on."
msgstr "一本關於觸手的書。我會開著燈讀的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_WEB"
msgid "Who would want to read a book about spiders?"
msgstr "誰會想讀關於蜘蛛的書？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOMERANG"
msgid "It's not the most exciting weapon."
msgstr "這不是最令人興奮的武器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOTLEG"
msgid "Monkey pirates don't know how to wear shoes."
msgstr "猴子海盜不懂怎麼穿鞋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Well, it's broken."
msgstr "嗯，它壞了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BRUSH"
msgid "It smells faintly like a beefalo."
msgstr "隱約有股皮弗婁牛的味道。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGNET"
msgid "I don't think it would fit over Webber's head."
msgstr "我想這套不到韋伯頭上吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "I bet we could eat that."
msgstr "我打賭我們可以吃那個。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nothing left to take."
msgstr "沒有什麼可以拿走的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_ROOT"
msgid "Ha. This is handy."
msgstr "哈。這個真方便。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLE"
msgid "That oughta keep everything nice and fresh."
msgstr "這樣應該能讓東西都保持新鮮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLEWRAP"
msgid "Useful for wrapping things up neatly."
msgstr "用來把東西包得整整齊齊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYMAN"
msgid "Unusual appearance, but I'll stay respectful."
msgstr "外表不太尋常，但我會保持尊重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYSTEW"
msgid "It warms from the inside out."
msgstr "從裡到外都暖和起來了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BURNT_MARSH_BUSH"
msgid "All burned up."
msgstr "全部燒毀了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHHAT"
msgid "A hat to hide in. A little passive, but sensible."
msgstr "可以躲起來的帽子。有點消極，不過很明智。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTER"
msgid "Tasty, and just a little bit insecty."
msgstr "好吃，就是有點蟲子味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter along, butterfly."
msgstr "飛吧，蝴蝶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.HELD"
msgid "I'll let it go in a moment."
msgstr "我馬上就放了它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYMUFFIN"
msgid "A butterfly in a muffin. Rather elegant, really."
msgstr "馬芬裡有隻蝴蝶。其實蠻優雅的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYWINGS"
msgid "Poor butterfly. No more flying for it."
msgstr "可憐的蝴蝶。再也飛不了了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUZZARD"
msgid "That is an unfortunate neck."
msgstr "那脖子長得真不幸。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CABBAGEROLLS"
msgid "Cabbage rolls. I can certainly roll with these."
msgstr "高麗菜卷。這個我可以接受。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.GENERIC"
msgid "Spines. How did you know my weakness?"
msgstr "尖刺。您怎麼知道我的弱點？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.PICKED"
msgid "We'll call it a tie."
msgstr "就算打平吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_FLOWER"
msgid "Yet another flower."
msgstr "又一朵花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT"
msgid "It still looks dangerous."
msgstr "看起來還是很危險。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "It seems fine now."
msgstr "現在看來還好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAROLL"
msgid "Fish rolled in seaweed. One of my favorites."
msgstr "海苔卷著魚。我最喜歡的之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "那場火需要更多的燃料，否則就會熄滅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "總比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "這場大火已經失控了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "火勢有點小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.OUT"
msgid "Well, that's over."
msgstr "好了，就這樣結束了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.GENERIC"
msgid "If it stops singing, I'll leave quickly."
msgstr "如果它不唱了，我就趕快離開。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.HELD"
msgid "Still breathing? Just checking."
msgstr "還有氣嗎？我只是確認一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY_POISONED"
msgid "Uh, are you feeling okay?"
msgstr "呃，你感覺還好嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANDYBAG"
msgid "Treats, treats, treats!"
msgstr "糖果，糖果，糖果！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANE"
msgid "This makes covering ground much easier."
msgstr "有了它，走路輕鬆多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Heavy, but I suppose that's the point."
msgstr "很重，不過我想這正是重點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "It needs a moment to recover."
msgstr "它需要時間恢復。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Shall we liven things up?"
msgstr "我們讓氣氛熱鬧一點吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALCANNON_KIT"
msgid "This looks like fun."
msgstr "這個看起來很好玩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "That's a cheerful banner."
msgstr "真是面喜氣洋洋的旗子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I'll put it together. Carefully."
msgstr "我來組裝。小心一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "I could watch it for hours."
msgstr "我可以看幾個小時。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I'll put it together. Carefully."
msgstr "我來組裝。小心一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Aww, it's so cute!"
msgstr "哇，太可愛了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Wow, a rare one!"
msgstr "哇，難得一見！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "If I gather enough, I can make a proper display."
msgstr "收集得夠多，就能好好擺一個展示了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "I wonder what's in the box."
msgstr "不知道盒子裡有什麼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "I wonder what's in the box."
msgstr "不知道盒子裡有什麼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It makes light."
msgstr "它會發光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I'll put it together. Carefully."
msgstr "我來組裝。小心一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "Guess this tree never got its growth spurt."
msgstr "看來這棵樹沒能長高。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I'll put it together. Carefully."
msgstr "我來組裝。小心一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "It keeps getting stuck in my teeth."
msgstr "它總是卡在我的牙齒裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "I don't need to chew them up first, do I?"
msgstr "我不需要先咀嚼它們，不是嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "A little door to nowhere special."
msgstr "一扇不通往任何地方的小門。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Heh. This actually looks rather fun."
msgstr "呵。這個其實還蠻好玩的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Please come back here."
msgstr "請回到這裡來。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Run, little eggs, run."
msgstr "跑吧，小蛋們，跑吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "A little door to nowhere special."
msgstr "一扇不通往任何地方的小門。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Yes, that's the one."
msgstr "對，就是這張。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "That's too much thinking for me right now."
msgstr "對現在的我來說，要想的東西太多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "Bounce that way. No, the other way."
msgstr "往那邊彈。不，是另一邊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Steady... now."
msgstr "穩住……就是現在。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Games where you get to hit something suit me well."
msgstr "可以打東西的遊戲很適合我。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "A little door to nowhere special."
msgstr "一扇不通往任何地方的小門。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Look sharp, bugs."
msgstr "小心了，蟲子們。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I suppose I'll set this one up myself."
msgstr "我想這個就由我自己來搭吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "I've never been to a carnival before. Do I give it something?"
msgstr "我還沒去過園遊會。要給它什麼東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "I'm rather good at this."
msgstr "我還蠻擅長這個的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_BALL"
msgid "Catch, Maxwell."
msgstr "接著，麥斯威爾。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_CROWKID"
msgid "I wonder where they've been hiding all this time."
msgstr "我想知道他們一直躲在哪裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "What is this, bird money?"
msgstr "這是什麼，鳥錢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_HOST"
msgid "I like him."
msgstr "我喜歡他。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Hm, the ground around it does looks kind of empty..."
msgstr "嗯，周圍的地面看起來確實有點空……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "I think those weird birds like the decorations."
msgstr "我認為那些奇怪的鳥喜歡這些裝飾品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "That's enough decorating for now."
msgstr "今天就裝飾到這裡吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Will make nice tree for birds."
msgstr "能給鳥兒們種棵漂亮的樹。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Ooh, prizes."
msgstr "喔，有獎品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "One more thing to build."
msgstr "又多了一樣要建的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "Tickets. I'll keep them safe."
msgstr "獎券。我會好好保管的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "It's a good thing we have extra arms to carry all these tickets!"
msgstr "幸好我們有多餘的手臂來攜帶所有這些門票！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Maybe now we can go get a prize!"
msgstr "也許現在我們可以去拿獎品了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "Bird food."
msgstr "鳥食。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_A"
msgid "A lovely shade of red."
msgstr "很漂亮的紅色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_B"
msgid "It's like wearing my own shade tree."
msgstr "就像穿著屬於自己的遮蔭樹。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_C"
msgid "Breezy."
msgstr "微風習習。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "That's a pity."
msgstr "真可惜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I love stuff made out of wood!"
msgstr "我喜歡用木頭做的東西！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.DEAD"
msgid "Oh, it's dead."
msgstr "喔，它死了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.GENERIC"
msgid "I want to roast it!"
msgstr "我想烤了它！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.HELD"
msgid "It keeps squirming."
msgstr "它一直在蠕動。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.SLEEPING"
msgid "It's snoring."
msgstr "打鼾了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT_GHOSTRACER"
msgid "That's a weird looking Carrat."
msgstr "那隻紅蘿蔔鼠看起來好奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT"
msgid "A very vegetable-y carrot."
msgstr "非常有蔬菜味的紅蘿蔔。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_COOKED"
msgid "Still vegetable-y, but better for having been cooked."
msgstr "還是有蔬菜味，不過煮過以後好多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_OVERSIZED"
msgid "A big old carrot."
msgstr "一根又大又老的紅蘿蔔。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_PLANTED"
msgid "Maybe its special carrot friend is in the ground."
msgstr "也許它的紅蘿蔔好朋友就在地裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_SEEDS"
msgid "Some seeds."
msgstr "一些種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Oh no, the maps!"
msgstr "喔不，地圖！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Well, I remember most of the map."
msgstr "嗯，大部分地圖我都還記得。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I could show everyone where I've been."
msgstr "我可以讓大家看看我去過哪裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOON"
msgid "Meow.. Meow.. Meow..."
msgstr "喵……喵……喵……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.EMPTY"
msgid "The nine lives thing is true!"
msgstr "九條命的傳說是真的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Trunk house."
msgstr "樹幹屋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONHAT"
msgid "Meow hat."
msgstr "喵帽子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATTOY_MOUSE"
msgid "Mice with wheels.."
msgstr "帶輪子的老鼠.."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I'll break it up carefully."
msgstr "我會小心地把它敲碎。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't reach that."
msgstr "我夠不著。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA"
msgid "Bananas!"
msgstr "香蕉！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_BURNT"
msgid "That was all I wanted..."
msgstr "我只想要這個……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Delicious."
msgstr "真好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_TREE"
msgid "A banana tree. Wonderful."
msgstr "一棵香蕉樹。太好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE"
msgid "Who plugged that hole?"
msgstr "誰堵住了這個洞？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people down there."
msgstr "下面人太多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I'd rather not go into that hole."
msgstr "我不太想進那個洞。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "I hope there's something interesting down there."
msgstr "希望下面有些有趣的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Who plugged that hole?"
msgstr "誰堵住了這個洞？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people up there."
msgstr "上面的人太多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "It's cooler down here, anyway."
msgstr "無論如何，這裡比較涼爽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.OPEN"
msgid "It's too dark and stuffy down here."
msgstr "這裡太黑、太悶了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_FERN"
msgid "Swirly plants."
msgstr "漩渦狀植物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CEVICHE"
msgid "It's still slimy."
msgstr "它還是粘糊糊的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARCOAL"
msgid "It smells faintly of smoke."
msgstr "隱約有股煙味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HAND"
msgid "You want something from me?"
msgstr "你想從我這裡得到什麼？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HECKLER"
msgid "They're just here to stir up drama."
msgstr "他們只是來鬧事的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_LECTURN"
msgid "Is someone doing a play?"
msgstr "有人演戲嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_NPC.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_NPC.GENERIC"
msgid "Have I seen her before...?"
msgstr "我以前見過她嗎……？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_STAGE_POST"
msgid "It's a setup! It feels too... staged."
msgstr "這是圈套！感覺太……像演出來的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK1"
msgid "Dead windup horsey."
msgstr "壞掉的發條馬。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK2"
msgid "Dead windup priest."
msgstr "壞掉的發條主教。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK3"
msgid "Dead windup castle."
msgstr "壞掉的發條城堡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "It's as heavy as it looks."
msgstr "它和看起來一樣重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Can't shake anything up like that."
msgstr "這樣可什麼都撼動不了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Those are some pointy teeth."
msgstr "那是一些尖尖的牙齒。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Somehow it seems crankier than the real one."
msgstr "不知怎的，它看起來比真的還暴躁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "They captured his good side."
msgstr "他們雕出了它最好看的一面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Took the sting out of her stinger."
msgstr "她的毒刺也沒那麼嚇人了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A bishop piece."
msgstr "一枚主教棋子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到裡面會出來什麼！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It looks nice, doesn't it?"
msgstr "看起來很不錯，不是嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Now all I can think of is carrots."
msgstr "現在我滿腦子都是紅蘿蔔。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CATCOON"
msgid "Meow.. Meow.. Meow..."
msgstr "喵……喵……喵……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It almost looks friendly."
msgstr "它看起來幾乎很友好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It doesn't look so tough now."
msgstr "現在看起來沒那麼厲害了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Was the treasure worth it?"
msgstr "寶藏值得嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Why do the troublesome ones always get statues?"
msgstr "為什麼總是麻煩的傢伙才有雕像？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "We managed it, in the end."
msgstr "我們總算還是辦到了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "Creepy, trembling all over."
msgstr "毛骨悚然，渾身顫抖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "I think... I think I understand art."
msgstr "我想……我想我了解藝術。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Haha, Your soul is mine!"
msgstr "哈哈，你的靈魂是我的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_FORMAL"
msgid "I'm not afraid of that fellow. He doesn't even have arms."
msgstr "我才不怕這傢伙。他連手臂都沒有。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I'd be happy never seeing that thing again."
msgstr "我希望再也不要見到那東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Ow. I think I chipped a tooth."
msgstr "哎喲。我的牙好像磕掉一塊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KITCOON"
msgid "These ones are much easier to find."
msgstr "這些更容易找到。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Ha. You can't get me now."
msgstr "哈。這下你抓不到我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A horse with no butt."
msgstr "一匹沒有屁股的馬。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到裡面會出來什麼！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "She was a pretty tough old bird."
msgstr "她是隻相當頑強的老鳥。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Good times."
msgstr "美好時光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "I never had a guardian, and I turned out fine. Mostly."
msgstr "我從來沒有監護人，也長得好好的。大概吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOON"
msgid "I guess it's nice."
msgstr "我想這很好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Looks as awkward as the real one."
msgstr "和真的一樣笨拙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MUSE"
msgid "She doesn't have a head. That's unsettling."
msgstr "她沒有頭。真讓人不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PAWN"
msgid "What sort of peasant doesn't carry a lantern?"
msgstr "哪有農民不提燈籠的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PIPE"
msgid "That was never really my thing."
msgstr "那從來不是我的愛好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "That one looks like it could do some damage."
msgstr "那個看起來可能會造成一些傷害。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到裡面會出來什麼！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_STALKER"
msgid "Not so tough now, are you?"
msgstr "現在沒那麼厲害了吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "What are you looking at?"
msgstr "你在看什麼？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "Now they'll always be together."
msgstr "現在他們會永遠在一起。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Now it won't summon puppies"
msgstr "現在它不會召喚小狗了"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_YOTD"
msgid "Meaningless reward."
msgstr "無意義的獎勵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER"
msgid "He's so fuzzy."
msgstr "他毛茸茸的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's rude to stare."
msgstr "盯著別人看很不禮貌。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "At least it's not looking at me anymore."
msgstr "至少它不再看我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "More room for supplies. Excellent!"
msgstr "能裝更多物資，很好！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHUM"
msgid "Fish eat that?"
msgstr "魚吃那個？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.GENERIC"
msgid "This dog is stone cold!"
msgstr "這狗真是鐵石心腸！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.STATUE"
msgid "That's an odd shape for a rock."
msgstr "這塊石頭的形狀真奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.GENERIC"
msgid "How do you get your eyes to do that?"
msgstr "您的眼睛是怎麼做到那樣的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.STATUE"
msgid "Did someone carve this thing?"
msgstr "有人雕刻過這個東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "那場火需要更多的燃料，否則就會熄滅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "總比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "這場大火已經失控了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "火勢有點小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.OUT"
msgid "Well, that's over."
msgstr "好了，就這樣結束了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "我應該在火熄滅之前放點東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "總比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "幸好火被圍住了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "火勢有點小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "至少我可以重新開始。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLLAPSEDCHEST"
msgid "Too much damage. Let's recover what we can."
msgstr "損壞太嚴重了，先收回能拿的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "東。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.GENERIC"
msgid "Can't get a reading."
msgstr "讀不出方向。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "東北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "西北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "東南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "西南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOST"
msgid "No, thank you."
msgstr "不了，謝謝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "It looks acceptable, for a pile of rotting things."
msgstr "作為一堆腐爛的東西，看起來還算可以。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Well. That's one way to finish it."
msgstr "嗯。這也算是種結束方式。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Is it supposed to be that dry?"
msgstr "應該這麼乾嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Why do we have this, again?"
msgstr "我們為什麼要留著這個來著？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's wet and unpleasant."
msgstr "又濕又讓人不舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTWRAP"
msgid "That's rather disgusting."
msgstr "真有點噁心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'd rather break things down than build them up."
msgstr "比起建造，我更想拆東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKBOOK"
msgid "Now i'll never forget a recipe!"
msgstr "現在我永遠不會忘記食譜！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMANDRAKE"
msgid "Poor little guy."
msgstr "可憐的小傢伙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMEAT"
msgid "Unseasoned meat. How exciting."
msgstr "沒調味的肉。真讓人興奮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still unappealing."
msgstr "還是沒有食慾。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDSMALLMEAT"
msgid "I'll need many small portions to get by out here."
msgstr "在這裡要吃好多小份才活得下去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTER"
msgid "Please stop staring."
msgstr "請別再盯著我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERHAT"
msgid "It matches my prickly side."
msgstr "和我帶刺的一面很相配。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERSHELL"
msgid "I borrowed its house. Permanently."
msgstr "我借了它的房子。永久地。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "It records a lot of delicious food!"
msgstr "記錄了很多美食！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.BURNT"
msgid "The pot got cooked."
msgstr "鍋被煮熟了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This is going to take a while."
msgstr "這需要一段時間。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It's almost done!"
msgstr "快好了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.DONE"
msgid "Mmmmm! It's ready to eat!"
msgstr "嗯嗯！可以吃了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.EMPTY"
msgid "It makes me hungry just to look at it."
msgstr "光是看著它就讓我感到飢餓。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COONTAIL"
msgid "I've kept stranger things than that."
msgstr "我還保留過比那更奇怪的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN"
msgid "A sweet vegetable."
msgstr "一種甜甜的蔬菜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_COOKED"
msgid "It pops nicely when it's cooked."
msgstr "煮熟後爆得很好聽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_OVERSIZED"
msgid "That's a lot of corn."
msgstr "真是好多玉米。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_SEEDS"
msgid "Some seeds."
msgstr "一些種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It's a blacksmith costume."
msgstr "這是鐵匠裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It's a doll costume."
msgstr "這是娃娃裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It's a fool's costume."
msgstr "這是小丑的服裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_KING_BODY"
msgid "It's a King costume."
msgstr "這是國王的服裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It's a costume."
msgstr "這是一套服裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It's a Queen costume."
msgstr "這是女王裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_TREE_BODY"
msgid "It's a tree costume."
msgstr "這是樹服裝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起來在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "That's better."
msgstr "這樣更好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起來在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "That looks lovely lit."
msgstr "點亮後真好看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起來在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Flame is stable."
msgstr "火焰很穩定。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TRINKET"
msgid "Finder's keepers."
msgstr "誰撿到就是誰的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COZY_BUNNYMAN"
msgid "They look comfortable."
msgstr "他們看起來很舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.GENERIC"
msgid "He doesn't look too happy..."
msgstr "他看上去不太高興……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.INERT"
msgid "I think it could use something glittery."
msgstr "我想它需要些閃閃發光的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING_CLAW"
msgid "Please keep your claws off my boat."
msgstr "請把您的鉗子從我的船上拿開。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB"
msgid "Is there anything cute in there?"
msgstr "裡面有什麼可愛的東西嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_DRAGONLING"
msgid "I think we'll get along."
msgstr "我想我們會相處得很好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "You're looking well today."
msgstr "你今天氣色不錯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_GLOMLING"
msgid "Aw, what a funny little face."
msgstr "呀，真是張滑稽的小臉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_KITTEN"
msgid "You're the perfect lapwarmer."
msgstr "你是完美的暖腿墊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LAMB"
msgid "Look at those little eyes. How odd. How sweet."
msgstr "看看那雙小眼睛。真奇怪。真可愛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "She loves light."
msgstr "她喜歡光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PERDLING"
msgid "You're adorable."
msgstr "你真可愛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PUPPY"
msgid "You don't even know you're smelly, do you?"
msgstr "你還不知道自己很臭吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.GENERIC"
msgid "I think it's waiting for something to go wrong."
msgstr "我想它在等著出事。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.HELD"
msgid "Not so smart now, are you?"
msgstr "現在不那麼聰明了，是嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRUMBS"
msgid "That little fellow is losing his parts."
msgstr "那小傢伙在掉零件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "I already have a curse more powerful than this. This one has no effect on me."
msgstr "我已經有比這更強大的詛咒了。這個對我來說沒有任何影響。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for crafting."
msgstr "割下的草，可以用來製作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLESS"
msgid "A wooden sword. Better than nothing."
msgstr "一把木劍，總比沒有好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLICHEN"
msgid "It tastes a lot like sawdust."
msgstr "吃起來很像鋸末。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for crafting."
msgstr "割下的蘆葦，可以用來製作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTSTONE"
msgid "Perfectly squared. Very satisfying."
msgstr "方方正正，讓人非常滿足。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.GENERIC"
msgid "I was only trying to help!"
msgstr "我只是想幫忙而已！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Looks like somebody's having a bad day."
msgstr "看來某人今天過得很糟糕。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.BURIED"
msgid "He's buried in scrap. Approach carefully."
msgstr "他被埋在廢料裡，小心靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.GENERIC"
msgid "I'll leave him alone while he's calm."
msgstr "他還平靜的時候就別打擾。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "He's ready to fight. So am I."
msgstr "他準備動手了，我也準備好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It won't break. I didn't try that hard, but still."
msgstr "它砸不破。雖然我也沒那麼用力。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "How crazy would I have to be to try and break that pillar?"
msgstr "得多瘋狂才會想打破那根柱子？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEADLYFEAST"
msgid "Cooking didn't cure this dish of being nasty."
msgstr "再怎麼煮也改變不了這道菜有多噁心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEAD_SEA_BONES"
msgid "What if I had stepped on it by accident?"
msgstr "要是不小心踩到了怎麼辦？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "What a waste of wood."
msgstr "多麼浪費木材啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "我覺得我本可以阻止這種情況發生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Take that, nature!"
msgstr "吃我一斧，大自然！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's all leafy. Most of the time."
msgstr "都是綠葉。大多數時候。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It looks unhappy about me stealing those birchnuts!"
msgstr "我偷了那些樺慄果，它看起來很不高興！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_CENTERPIECE"
msgid "Okay."
msgstr "好的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "It's empty. Time to refill."
msgstr "空了。該補上了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "At least we won't be in the dark."
msgstr "至少我們不會摸黑了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "A simple flower arrangement."
msgstr "簡單的插花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "We're going to be in the dark soon."
msgstr "我們很快就要摸黑了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Those need replacing."
msgstr "那些需要更換。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_LAMP"
msgid "A lamp. Simple and warm."
msgstr "一盞燈。簡單又溫暖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It's fine."
msgstr "還不錯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Drawing isn't really my talent, but I may try."
msgstr "畫畫不是我的長項，不過我可以試試。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "The portrait is missing a certain spark."
msgstr "這幅肖像少了一點神韻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.ANTLER"
msgid "That antler is impressive. Don't let it go to your head, deer."
msgstr "那鹿角真了不起。不過別太得意了，小鹿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.GENERIC"
msgid "Everyone fawns over the deer. I can't blame them."
msgstr "大家都喜歡這隻鹿。也不能怪他們。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS"
msgid "Oh my."
msgstr "天哪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "This is the best way to handle it..."
msgstr "這是最好的處理方式..."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Quick, toss that Deerclops carcass into the fire, don't give them a chance!"
msgstr "快，把鹿角怪的屍體丟進火裡，別給他們機會！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "That's... not good."
msgstr "這……不太好吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "It keeps a watchful eye for us."
msgstr "它幫我們盯著周圍。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "There we go."
msgstr "好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Looks like it's easy to assemble"
msgstr "看起來很容易組裝"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Please stop staring."
msgstr "請別再盯著我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_ANTLER"
msgid "It's a big, weird antler."
msgstr "這是一個又大又奇怪的鹿角。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_GEMMED"
msgid "Marginally better smelling than most animals here."
msgstr "比這裡的大多數動物的氣味略好一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "What a sorry looking piece of... grass?"
msgstr "一塊看起來多麼可憐的……草？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DESERTHAT"
msgid "Not very stylish."
msgstr "不是很時尚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL"
msgid "A strange tool with a familiar smell."
msgstr "工具很奇怪，氣味卻很熟悉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL_NODEV"
msgid "I can't wield this properly."
msgstr "我沒辦法好好使用它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIRTPILE"
msgid "Who just leaves dirt lying around in the forest?"
msgstr "誰會把泥土堆在森林裡？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.COLD"
msgid "Buzz buzz buzz, What sound did you hear?"
msgstr "嗡嗡嗡，你聽到了什麼聲音？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.GENERIC"
msgid "This thing looks like it's full of electronic waste!"
msgstr "這東西看起來裡面裝滿了電子垃圾！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.HOT"
msgid "Please stop beeping. It's so noisy."
msgstr "請別再響了，太吵了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARM"
msgid "This thing is getting noisier and noisier."
msgstr "這東西越來越吵了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARMER"
msgid "It feels like we're almost there! What kind of treasure could it be?"
msgstr "感覺我們就快到了！到底會是怎樣的寶物呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "I'm not sure what this does."
msgstr "我不確定這是做什麼用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.READY"
msgid "It just needs a key to unlock it."
msgstr "只要一把鑰匙就能開啟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It's whirring now."
msgstr "它現在開始嗡嗡響了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODSTART"
msgid "I'll make something out of it."
msgstr "我會用它做點什麼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_KIT"
msgid "Everything I need to build a dock for my boat."
msgstr "為我的船建造碼頭所需的一切。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Aha! I thought the dock was missing something."
msgstr "啊哈！我以為碼頭缺少什麼東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOLL_BLUEPRINT"
msgid "Awww, my beefalo's going to be so hideous and adorable!"
msgstr "嗚啊，我的牛會變得又醜又可愛！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_KIT"
msgid "\"Dragon Boat\""
msgstr "《龍舟》"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_PACK"
msgid "\"Dragon Boat\" Kit"
msgstr "「龍舟」套裝"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBODYHAT"
msgid "I'm not sure I want to be in *another* belly."
msgstr "我不確定我想進入*另一個*肚子裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONCHILISALAD"
msgid "I can hardly wait to eat it."
msgstr "我都等不及要吃了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLY"
msgid "Oh, don't you just drag on."
msgstr "喔，別再拖拖拉拉了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Chest is not afraid of fire."
msgstr "這箱子不怕火。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Let's turn it back on."
msgstr "我們把它重新打開吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "That's certainly a look."
msgstr "這造型可真不一般。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It's warm and rather lovely."
msgstr "暖暖的，真舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Another gem should do it."
msgstr "再放一顆寶石就好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT"
msgid "What a weird fruit."
msgstr "多麼奇怪的水果啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "The fruit's still weird."
msgstr "水果還是很奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "I'd hoped it would be a bit smaller."
msgstr "我本來希望它能小一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "這是一顆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONHEADHAT"
msgid "The front part's sort of scary."
msgstr "前面的部分有點嚇人"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONPIE"
msgid "The dragonfruit is very filling."
msgstr "火龍果吃得很飽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONTAILHAT"
msgid "I like the tail!"
msgstr "我喜歡尾巴！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGON_SCALES"
msgid "They don't weigh much for scales."
msgstr "作為鱗片，它們並不重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE"
msgid "Why does this rock feel so cold and clammy?"
msgstr "這塊石頭為什麼摸起來又冷又潮？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONEHAT"
msgid "Do I really have to wear it on my head?"
msgstr "真的要把它戴在頭上嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE_STACK"
msgid "It's growing from way down below."
msgstr "它是從很深的地下長出來的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_LOG"
msgid "Dry wood. Good utility material."
msgstr "乾木頭，很實用的材料。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "That driftwood's burning!"
msgstr "那塊浮木著火了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Well. That's the end of that."
msgstr "嗯。這下全完了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "There might still be something worth digging up."
msgstr "或許還有值得挖掘的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree looks very strange."
msgstr "這棵樹看起來非常奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRUMSTICK"
msgid "Bang on the drum all day, as they say."
msgstr "人家都說，敲一整天的鼓。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hmm... Satisfy hunger, or bang on the drum?"
msgstr "嗯……充飢，還是敲鼓？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BANANABUSH"
msgid "That bush is bananas!"
msgstr "這叢灌木長滿了香蕉！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BERRYBUSH"
msgid "Poor thing. It needs some dirt."
msgstr "可憐的東西。它需要點泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "Poor thing. It needs some dirt."
msgstr "可憐的東西。它需要點泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_GRASS"
msgid "Poor thing. It needs some dirt."
msgstr "可憐的東西。它需要點泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_MARSH_BUSH"
msgid "Poor thing. It needs some dirt."
msgstr "可憐的東西。它需要點泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_MONKEYTAIL"
msgid "It's so soft. And fuzzy."
msgstr "好軟。毛茸茸的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_SAPLING"
msgid "Poor thing. It needs some dirt."
msgstr "可憐的東西。它需要點泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I had a feeling about you."
msgstr "我早就覺得你不對勁了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL"
msgid "Training gear should stay practical."
msgstr "訓練器材要講究實用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Why is it so cold?"
msgstr "它為什麼這麼冰？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_GEM"
msgid "Did he really need to make it so fancy?"
msgstr "他真的需要把事情弄得這麼花哨嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Did he really need to make it so fancy?"
msgstr "他真的需要把事情弄得這麼花哨嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_HEAT"
msgid "A warm-up for your workout, big guy."
msgstr "給你熱熱身，大個子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_MARBLE"
msgid "Did he really need to make it so fancy?"
msgstr "他真的需要把事情弄得這麼花哨嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUMBBELL_REDGEM"
msgid "Solid resistance for training."
msgstr "訓練時的阻力很紮實。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN"
msgid "What a weird fruit."
msgstr "多麼奇怪的水果啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_COOKED"
msgid "The fruit's still weird."
msgstr "水果還是很奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_OVERSIZED"
msgid "Of course this is the one that grows well."
msgstr "果然長得好的就是這種東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DURIAN_SEEDS"
msgid "Some seeds."
msgstr "一些種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMERINGUE"
msgid "I don't think I'm that hungry."
msgstr "我想我還沒那麼餓。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMOTH"
msgid "They keep things clean all day. Diligent workers."
msgstr "它們一整天都在打掃，真勤快。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUSTMOTHDEN"
msgid "Not that I tried or anything."
msgstr "倒不是說我試過。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EARMUFFSHAT"
msgid "It smells distinctly of rabbit."
msgstr "有一股明顯的兔子味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EEL"
msgid "This will make a delicious meal."
msgstr "能做成美味的一餐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EEL_COOKED"
msgid "Smells great!"
msgstr "聞起來好極了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT"
msgid "Definitely not a bird."
msgstr "絕對不是鳥。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_COOKED"
msgid "Cooking made it a tastier eggplant."
msgstr "煮過以後成了更好吃的茄子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "What am I supposed to do with all this eggplant?"
msgstr "這麼多茄子我該怎麼辦？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EGGPLANT_SEEDS"
msgid "Some seeds."
msgstr "一些種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EMBERLIGHT"
msgid "How did it catch fire without any combustible material to support it?"
msgstr "在沒有任何可燃材料支撐的情況下，它是如何著火的呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.BURNT"
msgid "I suppose there was no hand after all."
msgstr "看來終究沒有什麼手。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.EMPTY"
msgid "I have a feeling there's a monster hand under there."
msgstr "我總覺得那下面藏著一隻怪物的手。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "It's nice to have a little light."
msgstr "有一點光真好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.GENERIC"
msgid "A neat bunch of flowers."
msgstr "一束整齊的花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We're going to be in the dark soon."
msgstr "我們很快就要摸黑了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ENDTABLE.WILTED"
msgid "Those need replacing."
msgstr "那些需要更換。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.BURNING"
msgid "What a waste of wood."
msgstr "多麼浪費木材啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.BURNT"
msgid "I feel like I could have prevented that."
msgstr "我覺得我本可以阻止這種情況發生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Take that, nature!"
msgstr "吃我一斧，大自然！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN.GENERIC"
msgid "It's all piney."
msgstr "全是松木味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "What a waste of wood."
msgstr "多麼浪費木材啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "我覺得我本可以阻止這種情況發生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Take that, nature!"
msgstr "吃我一斧，大自然！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "This sad tree has no cones."
msgstr "這棵悲傷的樹沒有球果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEBRELLAHAT"
msgid "Keeps the rain out your eyes and in someone else's."
msgstr "把雨擋在自己眼睛外，淋到別人眼裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEMASKHAT"
msgid "Ugly."
msgstr "真醜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR"
msgid "Come! I'll Cut you down!"
msgstr "來！我就砍了你！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI"
msgid "I'm starting to feel self-conscious."
msgstr "我開始感到不自在了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I think it's about to hatch..."
msgstr "我覺得它快要孵化了..."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEPLANT"
msgid "I think I'm being watched."
msgstr "我想我正在被監視。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYETURRET"
msgid "I hope it doesn't turn on me."
msgstr "希望它不會轉過來對付我。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYETURRET_ITEM"
msgid "It's no good until it's been placed."
msgstr "在放置之前它是沒有用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.BURNT"
msgid "That's the end of that plot."
msgstr "這塊地算是完了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.GENERIC"
msgid "Sigh. It's a pile of dirt."
msgstr "嘆。這是一堆泥土。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.GROWING"
msgid "Take your time, soil. But not too much time."
msgstr "慢慢來吧，土壤。不過也別太慢。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs fertilizer."
msgstr "它需要施肥。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_HOE"
msgid "Farming is so much work..."
msgstr "種田真是太辛苦了..."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.BURNING"
msgid "Oh no."
msgstr "喔不。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL"
msgid "Worth the wait."
msgstr "等得值了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Well that looks kind of unnatural."
msgstr "嗯，這看起來有點不自然。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Wait, what kind of vegetable is that supposed to be?"
msgstr "等等，那應該是什麼蔬菜？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant. Track its growth."
msgstr "一株植物。記錄它的生長情況。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.GROWING"
msgid "Grow well, little one."
msgstr "好好長吧，小傢伙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "I'm not eating that."
msgstr "我才不吃那個。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "A big pile of stinky mush."
msgstr "一大堆臭糊糊的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLANT.SEED"
msgid "This is going to take a while."
msgstr "這得花上一段時間。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLOW"
msgid "Turn the soil evenly and cleanly."
msgstr "把土翻得又平又乾淨。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_PLOW_ITEM"
msgid "I should choose a suitable plot for planting."
msgstr "我應該選一塊適合種植的地。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Out you go."
msgstr "你走開。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERFAN"
msgid "I do not know... it could put out some..."
msgstr "我不知道……它也許能吹滅一些……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERHAT"
msgid "A phoenix reborn!"
msgstr "鳳凰涅槃重生！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHERPENCIL"
msgid "Haha! It tickles!"
msgstr "哈哈！好癢啊！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_CANARY"
msgid "Feather of yellow."
msgstr "羽毛黃色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_CROW"
msgid "Feather of black."
msgstr "羽毛黑色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_ROBIN"
msgid "Feather of red."
msgstr "紅色的羽毛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Feather of white."
msgstr "羽毛白色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEM_PUPPET"
msgid "She looks scared half to death."
msgstr "她看起來嚇得半死。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE"
msgid "I'm not painting that."
msgstr "我可不會去粉刷它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_GATE"
msgid "I guess we could pen stuff in with it."
msgstr "我想可以用它把東西圈起來。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_GATE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "把它留在地上是沒有意義的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "把它留在地上是沒有意義的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_JUNK"
msgid "Rough edges. Watch your sleeves."
msgstr "邊緣很粗糙，小心衣袖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FENCE_ROTATOR"
msgid "Enguard! Re-post!"
msgstr "看招！回擊！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FERTILIZER"
msgid "A bucket of something unpleasant."
msgstr "一桶不怎麼好聞的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FESTIVEFISH"
msgid "It's very festive."
msgstr "很有節日氣氛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It looks festive enough to me."
msgstr "我覺得這樣就夠有節日氣氛了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG"
msgid "It looks like fruit for grandparents."
msgstr "看起來是老人家愛吃的水果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGATONI"
msgid "I won't turn down a plate of pasta."
msgstr "我不會拒絕一盤義大利麵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGKABAB"
msgid "Food on a stick. Practical."
msgstr "串在棍子上的食物。很實用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG_COOKED"
msgid "Cooking improved it, as usual."
msgstr "和往常一樣，煮過以後更好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "它從上方呼喚一顆流星。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRECRACKERS"
msgid "Don't worry Ms. Wicker, we'll be careful."
msgstr "別擔心，威克女士，我們會小心的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish they wouldn't keep running away."
msgstr "真希望它們別老是跑開。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.HELD"
msgid "They make my pocket glow!"
msgstr "它們讓我的口袋閃閃發光！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREHOUND"
msgid "I rather like that one."
msgstr "我還蠻喜歡那隻的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRENETTLES"
msgid "It's a weed? It looks rather nice to me."
msgstr "這是雜草？我覺得蠻好看的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPEN"
msgid "I feel inspired to write."
msgstr "我有靈感想寫點東西了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "我應該在火熄滅之前放點東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "總比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "幸好火被圍住了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "火勢有點小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "至少我可以重新開始。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESTAFF"
msgid "Powerful, and best handled with care."
msgstr "威力強大，最好小心使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Running low on fuel."
msgstr "燃油不足。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "It's off."
msgstr "關了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "This would come in handy in a snowball fight."
msgstr "這在打雪仗時會派上用場。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH"
msgid "A slippery fish."
msgstr "一條滑溜溜的魚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGNET"
msgid "Throwing things to catch other things. Clever."
msgstr "丟東西來抓別的東西。真聰明。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGROD"
msgid "Fishing for the answer with a hook, line and sinker."
msgstr "用魚鉤、魚線和鉛墜釣答案。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT"
msgid "Once a fish, now food."
msgstr "曾經是魚，現在是食物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_COOKED"
msgid "Grilled to perfection."
msgstr "烤至完美。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL"
msgid "Not much more than a quick fishy snack."
msgstr "也就夠當一份魚味小點心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Fish and a bit of heat go well together."
msgstr "魚和一點火候很配。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHSTICKS"
msgid "What you see is what you get. Sticks of fish."
msgstr "所見即所得。魚條。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHTACOS"
msgid "Convenient taco-grip."
msgstr "方便手握的塔可。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_BOX"
msgid "Did we just... put a hole in the boat?"
msgstr "我們剛剛……在船上打了一個洞嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_COOKED"
msgid "Flaky and moist. Delicious."
msgstr "酥軟多汁。真好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLINT"
msgid "Aha, I've found some flint!"
msgstr "啊哈，我找到了一些打火石！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.GENERIC"
msgid "A flower. Pretty, in its way."
msgstr "一朵花。有它自己的美。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.ROSE"
msgid "Bright red petals!"
msgstr "鮮紅的花瓣！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERHAT"
msgid "A halo of flowers. Simple and tidy."
msgstr "花做的光環，簡單又整潔。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERSALAD"
msgid "I'd rather have something more filling."
msgstr "我更想吃點能填飽肚子的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_CAVE"
msgid "It glows from within."
msgstr "它從裡面發著光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_EVIL"
msgid "That smells terrible."
msgstr "聞起來真可怕。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_WITHERED"
msgid "It's withered."
msgstr "它枯萎了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOLIAGE"
msgid "Soft and leafy."
msgstr "柔軟而多葉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "體育運動很難。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORGETMELOTS"
msgid "More flowers. Nice color balance."
msgstr "更多的花。色彩搭配不錯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It looks very stuffy and proper."
msgstr "看起來非常拘謹又正式。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_PIECE"
msgid "Old bits of bone."
msgstr "古老的骨頭碎片。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Looks passable."
msgstr "看起來還過得去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That looks absolutely ridiculous."
msgstr "這看起來太荒唐了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "It needs more old bits."
msgstr "還需要更多古老的碎片。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRESHFRUITCREPES"
msgid "Ooo la la."
msgstr "噢啦啦。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This one is actually helping."
msgstr "這隻真的在幫忙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.DEAD"
msgid "A hop too far."
msgstr "跳過頭了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.GENERIC"
msgid "Ob.. Ob..."
msgstr "歐..歐.."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.SLEEPING"
msgid "Oblivious amphibious."
msgstr "兩棲動物睡得毫無察覺。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGFISHBOWL"
msgid "That's a lot of frogs."
msgstr "真是好多青蛙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGGLEBUNWICH"
msgid "If you close your eyes it's a little easier to get it down."
msgstr "閉上眼睛的話，比較容易吞下去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS"
msgid "It still twitches now and then. Unsettling."
msgstr "它偶爾還會抽動一下。讓人不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS_COOKED"
msgid "Tastes like chicken."
msgstr "味道像雞肉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGNEWTON"
msgid "All that fig almost masks the frog flavor."
msgstr "所有的無花果幾乎掩蓋了青蛙的味道。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "It's very cold."
msgstr "真的很冰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They're pretty cute."
msgstr "它們非常可愛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.RIPE"
msgid "Mmm. Dragonfruit."
msgstr "嗯。火龍果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Good night, little guy."
msgstr "晚安，小傢伙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLY"
msgid "Please stay out of the crops."
msgstr "請離莊稼遠一點。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLYFRUIT"
msgid "Now I'm the the one giving the orders! To Fruit Flies, but still."
msgstr "現在換我發號施令了！雖然只是對果蠅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITMEDLEY"
msgid "Lovely fruit."
msgstr "很棒的水果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FURTUFT"
msgid "Black and white and fuzzy all over!"
msgstr "黑白相間，毛茸茸的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING"
msgid "It's very creepy."
msgstr "真讓人毛骨悚然。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "They sure go out with a bang."
msgstr "它們走得真是轟轟烈烈。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_HOUND"
msgid "A large stone ornament."
msgstr "一件很大的石頭擺設。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_WEREPIG"
msgid "At least it doesn't smell anymore."
msgstr "至少現在沒有味道了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC"
msgid "It's just a couple cloves of garlic."
msgstr "只是幾瓣大蒜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_COOKED"
msgid "Cooking made it better."
msgstr "煮過以後好多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_OVERSIZED"
msgid "My breath would be unforgettable if I ate the whole thing."
msgstr "要是把這一整顆吃完，我的口氣一定令人難忘。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GAZPACHO"
msgid "I prefer my soup warm."
msgstr "我更喜歡喝熱湯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEARS"
msgid "These must make them move."
msgstr "一定是這些讓它們動起來的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.GEMS"
msgid "It's so empty."
msgstr "空蕩蕩的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.VALID"
msgid "I wonder how they hover?"
msgstr "我想知道它們是如何懸停的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT"
msgid "It feels like they're speaking inside my head!"
msgstr "感覺就像他們在我腦子裡說話！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD"
msgid "They sure hate those shadow creeps."
msgstr "他們確實討厭那些暗影怪物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST"
msgid "Resentment wakes it up. \n You can't kill what's already dead."
msgstr "怨恨將其喚醒。 \n 你無法殺死已經死去的東西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWER"
msgid "Another spooky flower."
msgstr "又一朵陰森的花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_ATTACK"
