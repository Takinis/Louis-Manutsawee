msgstr "你就在那裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
