msgctxt "STRINGS.CHARACTER_NAMES.manutsawee"
msgid "Manutsawee"
msgstr "曼莎薇"

#. STRINGS.CHARACTER_QUOTES.manutsawee
msgctxt "STRINGS.CHARACTER_QUOTES.manutsawee"
msgid "\"Where There's a Will, There's a Way\""
msgstr "「有志者事竟成」"

