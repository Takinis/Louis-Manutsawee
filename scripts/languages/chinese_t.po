msgstr "沒能源，白來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "Already memorized this part."
msgstr "這部分已經記過了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Time to go!"
msgstr "該走了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Something's not right."
msgstr "情況不對。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Don't stay here!"
msgstr "別留在這裡！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ATTACH_BUFF_ATTACK
