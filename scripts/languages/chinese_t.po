msgstr "別擔心，我會帶你出去的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
