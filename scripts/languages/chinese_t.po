msgstr "圓鼓鼓的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ONION_COOKED"
