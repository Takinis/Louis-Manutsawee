msgstr "別站在這裡！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ANTLION_SINKHOLE.3"
