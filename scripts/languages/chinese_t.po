msgstr "這件事我得好好烤問一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Barbecurious."
msgstr "烤物好奇。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
