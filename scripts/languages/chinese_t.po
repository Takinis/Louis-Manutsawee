msgid "A fountain with no water. Maybe that's a metaphor?"
msgstr "沒有水的噴泉。也許這是一個比喻？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "I didn't even have to break the locks."
msgstr "我甚至不用砸鎖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It's locked. I think we need a key."
msgstr "它被鎖了。我想我們需要一把鑰匙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's a monument or something."
msgstr "這是一座紀念碑什麼的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "A quiet place to rest."
msgstr "一個安靜的長眠之地。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Don't worry, I won't kick you."
msgstr "放心，我不會踢你的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It's dead."
msgstr "它死了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I haven't got any crumbs for you."
msgstr "我沒有任何麵包屑給你。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's taking a nap."
msgstr "它正在小睡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Look who's fancy now."
msgstr "看看誰變高級了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "That tastes like the ocean."
msgstr "嚐起來像海水。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PORTAL"
msgid "I'm just going to keep jumping through portals til I figure out a way home."
msgstr "我要一直跳傳送門，直到找到回家的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Fancy key."
msgstr "花哨的鑰匙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT"
msgid "This pot holds more ingredients."
msgstr "這個鍋可以容納更多的食材。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO"
msgid "We grew it in that muck."
msgstr "我們是在那片爛泥裡種出來的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Cooking is mostly patience."
msgstr "烹飪大多靠耐心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "It has hang-ups."
msgstr "它掛得住。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "For suspension-based cookery."
msgstr "用於吊掛式烹飪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "Let's get cooking!"
msgstr "我們去做飯吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "I need to sweeten this pot."
msgstr "我得給這鍋加點甜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "That one stayed in the ground too long."
msgstr "那一棵在地裡待太久了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Aww... It's broken."
msgstr "唉……壞了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "I wish i could ride in that."
msgstr "真希望能坐上去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "I can't even fix it."
msgstr "我甚至無法修復它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "What's a chimney without a fireplace?"
msgstr "沒有壁爐還叫煙囪嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Aw. That's too bad."
msgstr "唉，太可惜了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Does it still tell the right time?"
msgstr "它現在還準嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "I don't think that clock works anymore."
msgstr "我想那座鐘已經不走了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "I wonder what happened here?"
msgstr "我想知道這裡發生了什麼？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Where did everyone go?"
msgstr "大家都去哪裡了？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Looks like everyone left."
msgstr "看來大家都離開了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It doesn't lead anywhere anymore."
msgstr "它不再通向任何地方了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "Too bad."
msgstr "太可惜了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "There. Cracked it."
msgstr "好了。打開了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I can't get it to open."
msgstr "我打不開它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALMON"
msgid "Look at it, flopping around like that."
msgstr "瞧瞧，就這樣撲騰著。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Ready for the dinner table."
msgstr "準備上餐桌了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT"
msgid "I need a pinch or two on all my food."
msgstr "我的每道菜都要加一兩撮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "I licked one. I had to know."
msgstr "我舔了一下。我非得知道不可。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Grow well, salt crystals."
msgstr "好好長吧，鹽結晶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Time to collect the salt."
msgstr "該收鹽了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "I can use it to get some cooking salt."
msgstr "我可以用它來取一些食用鹽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAP"
msgid "Mmm. Pure sugar."
msgstr "嗯。純粹的糖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "Now we can get sap out of the trees."
msgstr "現在我們可以從樹上獲取汁液了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAPLING"
msgid "It's going to take too long to grow back."
msgstr "要長回來得花太久了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "That's unfortunate."
msgstr "真遺憾。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "I won't know what these are until I plant them."
msgstr "不種下去就不知道是什麼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't want to use this."
msgstr "我不想用這個。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spices... the true spice of life."
msgstr "香料……生活真正的調味品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It smells kind of pepper-y."
msgstr "聞起來有點胡椒味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back."
msgstr "那不會再長回來了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It's a piece of that pepper-y bush."
msgstr "這是胡椒灌木叢的一部分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It's full of delicious, delicious sap."
msgstr "它充滿了美味可口的汁液。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It's rather useless now."
msgstr "現在沒什麼用了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Troublesome bugs."
msgstr "真麻煩的蟲子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It's taking a while."
msgstr "還要等一陣子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "The sap is ready."
msgstr "樹液好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "You don't look well, tree."
msgstr "你看起來不太好，樹。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Not the prettiest face."
msgstr "長得不算好看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "They're not so different from the pigs back at our place."
msgstr "它們和我們家的豬沒什麼不同。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's taking a nap."
msgstr "它正在小睡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "That structure looks unstable."
msgstr "那建築看起來不太穩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Your house blew down, I'm afraid."
msgstr "恐怕您的房子被吹倒了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Mmmm..."
msgstr "嗯……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Cutting these is a bit of a chore."
msgstr "切這些有點麻煩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It just needed a few minutes of cooking."
msgstr "只要煮幾分鐘就好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "What have you got for me?"
msgstr "您有什麼東西可以給我？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Nice hat. Are you selling that, too?"
msgstr "漂亮的帽子。你也賣那個嗎？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP"
msgid "I'm not fond of turnips."
msgstr "我不太喜歡蕪菁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Take that, turnip."
msgstr "吃我一招吧，蕪菁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_WHEAT"
msgid "How on earth do you eat this?"
msgstr "這到底要怎麼吃？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆種子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBIT.GENERIC"
msgid "He looks delicious. Forgive me."
msgstr "它看起來很好吃。原諒我。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBIT.HELD"
msgid "I have him right where I want him."
msgstr "我正好把它抓在手裡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Come out, rabbits. I promise I'm friendly."
msgstr "出來吧，兔子們。我保證我很友善。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOLE.SPRING"
msgid "The rabbits must be stuck down there."
msgstr "兔子們一定被困在下面了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Well. That's the end of that."
msgstr "嗯。這下全完了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Those rabbits again."
msgstr "又是那些兔子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAIKIRI"
msgid "Once it used to split a bolt of lightning."
msgstr "它曾經劈開過一道閃電。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAINCOAT"
msgid "That'll do the trick."
msgstr "這樣就可以了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAINHAT
