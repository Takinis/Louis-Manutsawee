msgstr "他在別的賽場。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
