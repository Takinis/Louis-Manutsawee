#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.1"
msgid "Acid rain?!"
msgstr "酸雨?!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.1.1"
msgid "That stings!"
msgstr "好刺痛！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.1.2"
msgid "Don't let it in your eyes."
msgstr "别让雨进眼睛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.2"
msgid "oh! it hurts!"
msgstr "噢！好痛！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.2.1"
msgid "My sleeves are spotting!"
msgstr "袖子上都蚀出斑了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.2.2"
msgid "This rain burns my skin."
msgstr "这雨落在皮肤上好疼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ACIDRAIN.3"
msgid "This rain is nothing but trouble!"
msgstr "这雨无非就是麻烦！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.3.1"
msgid "Get under cover!"
msgstr "快到遮蔽物下面！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDRAIN.3.2"
msgid "Find a roof, quickly!"
msgstr "快找屋檐！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING"
msgid "Oops, trouble..."
msgstr "哎呀，麻烦了……"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.1"
msgid "I can feel the change already."
msgstr "身体已经有感觉了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_CALIFORNIAKING.2"
msgid "Give me a moment to get used to this."
msgstr "让我稍微适应一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION"
msgid "lightning! I like!"
msgstr "闪电！我喜欢!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.1"
msgid "A spark jumped between my fingers!"
msgstr "指尖跳出了一点电光！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICRETALIATION.2"
msgid "Even my hair is standing up."
msgstr "连头发都竖起来了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_FROZENFURY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_FROZENFURY"
msgid "Brrr...hope this works."
msgstr "Brrr...希望这玩意有用."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.1"
msgid "There's frost on my fingers!"
msgstr "指尖上挂霜了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_FROZENFURY.2"
msgid "I can see my breath with every swing."
msgstr "每次挥动都能看见自己呼出的白气。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE"
msgid "I feel... my worries are lifted."
msgstr "我感觉……我的忧虑解除了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.1"
msgid "I can meet its eyes without flinching."
msgstr "我敢直视它的眼睛了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_HYPERCOURAGE.2"
msgid "My hands have finally steadied."
msgstr "手终于不再抖了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE"
msgid "After eating it, I felt like I gained 500 pounds"
msgstr "吃了它, 我感觉我胖了500斤"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.1"
msgid "My heels feel planted even when I turn."
msgstr "就算转身，脚跟也稳得很。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_KNOCKBACKIMMUNE.2"
msgid "I think I can hold my ground here."
msgstr "我想我能在这里站稳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW"
msgid "Temporarily, I no longer feel hungry"
msgstr "暂时的, 我不再感到饥饿了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.1"
msgid "That meal is going to last me quite a while."
msgstr "那顿饭够我撑上好一阵。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LARGEHUNGERSLOW.2"
msgid "I might get through practice without thinking of lunch."
msgstr "这次练习，或许不会一直惦记午饭了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK"
msgid "lightning! I like!"
msgstr "闪电！我喜欢!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.1"
msgid "A spark jumped between my fingers!"
msgstr "指尖跳出了一点电光！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_LESSERELECTRICATTACK.2"
msgid "Even my hair is standing up."
msgstr "连头发都竖起来了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_VETCURSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ATTACH_BUFF_VETCURSE"
msgid "Curse? I seem to get hungry more easily."
msgstr "诅咒? 我好像变得更容易饿了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.1"
msgid "I feel hungry again already. Is that the curse?"
msgstr "这么快又饿了。这就是诅咒吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_VETCURSE.2"
msgid "Something about that bargain feels wrong."
msgstr "那场交易让我有些不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED"
msgid "Wow! I almost got an electric shock."
msgstr "哇哦！我差点触电了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.1"
msgid "There, the charge went through."
msgstr "好了，电流通过去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_ELECTROCUTED.2"
msgid "That's quite a spark."
msgstr "这电火花可真亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CHARGE_SUCCESS_INSULATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_CHARGE_SUCCESS_INSULATED"
msgid "Wow! I almost got an electric shock."
msgstr "哇哦！我差点触电了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.1"
msgid "There, the charge went through."
msgstr "好了，电流通过去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARGE_SUCCESS_INSULATED.2"
msgid "That's quite a spark."
msgstr "这电火花可真亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING"
msgid "This experience will always haunt me."
msgstr "这段经历将一直困扰着我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.1"
msgid "The effect's wearing off."
msgstr "效果在慢慢消退。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_CALIFORNIAKING.2"
msgid "I feel the way I did before."
msgstr "身体恢复到之前的感觉了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION"
msgid "Transformation time is over"
msgstr "变身时间结束了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.1"
msgid "The last little spark just went out."
msgstr "最后一点电光也消失了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICRETALIATION.2"
msgid "I can touch metal normally again."
msgstr "现在碰金属也没事了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_FROZENFURY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_FROZENFURY"
msgid "Ah, back to normal."
msgstr "啊，恢复正常了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.1"
msgid "The feeling's coming back to my fingers."
msgstr "手指慢慢恢复知觉了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_FROZENFURY.2"
msgid "A drop of water where the frost was."
msgstr "原先结霜的地方化出了一滴水。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE"
msgid "It felt good while it lasted."
msgstr "持续的时候感觉很好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.1"
msgid "I can feel my heartbeat picking up again."
msgstr "心跳又开始快起来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_HYPERCOURAGE.2"
msgid "A breath before I face that again."
msgstr "再面对它之前，我得深吸一口气。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE"
msgid "Instantly I felt like I lost 500 pounds."
msgstr "瞬间我感觉我身上少了500斤."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.1"
msgid "There goes that weight in my heels."
msgstr "脚跟上那股沉稳劲消失了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_KNOCKBACKIMMUNE.2"
msgid "I'd better watch my balance again."
msgstr "又得小心保持平衡了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW"
msgid "My stomach is returning to normal digestion speed."
msgstr "我的胃正在恢复正常消化速度。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.1"
msgid "I can hear my stomach again."
msgstr "又能听见肚子叫了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LARGEHUNGERSLOW.2"
msgid "I should check what provisions we have left."
msgstr "我去看看还剩多少口粮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK"
msgid "Transformation time is over"
msgstr "变身时间结束了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.1"
msgid "The last little spark just went out."
msgstr "最后一点电光也消失了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_LESSERELECTRICATTACK.2"
msgid "I can touch metal normally again."
msgstr "现在碰金属也没事了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_VETCURSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DETACH_BUFF_VETCURSE"
msgid "It's over! The hunger curse is gone!"
msgstr "结束了! 饥饿诅咒消失了!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.1"
msgid "The curse is gone. I can stop counting my rations."
msgstr "诅咒消失了，不必总惦记着口粮了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_VETCURSE.2"
msgid "I wouldn't care to make that bargain twice."
msgstr "那样的交易，我可不想再来一次。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.1"
msgid "Looks like this lion has learned a new trick!"
msgstr "看来这头狮子又学会了新把戏！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.1.1"
msgid "Look up! Stones are falling!"
msgstr "抬头，石头落下来了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.1.2"
msgid "Find open ground!"
msgstr "往开阔处走！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.2"
msgid "I'm tired, the rumbling is getting louder and louder!"
msgstr "烦了，隆隆声越来越厉害了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.2.1"
msgid "That rumble is getting closer."
msgstr "轰隆声越来越近了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.2.2"
msgid "Away from where that lands!"
msgstr "离落点远一点！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_FIREFALL.3"
msgid "Watch your step, everyone!"
msgstr "大家小心脚下！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.3.1"
msgid "Leave room to move!"
msgstr "留出躲避的空地方！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIREFALL.3.2"
msgid "Wait for a gap!"
msgstr "等落石停一停！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HARDCORE_RES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HARDCORE_RES"
msgid "You need my help! And your body..."
msgstr "你需要我的帮助！ 还有你的身体..."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.1"
msgid "Hold still. I want to bring you back."
msgstr "别动，我想把你救回来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HARDCORE_RES.2"
msgid "There must be a way to help you."
msgstr "一定还有办法帮你。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER"
msgid "aaaa, my nose feels so itchy"
msgstr "aaaa, 鼻子好痒"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1"
msgid "My nose is itching again."
msgstr "鼻子又开始痒了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2"
msgid "Is there pollen on my collar?"
msgstr "我衣领上沾花粉了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER_OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER_OFF"
msgid "Ah, the fresh air"
msgstr "啊，清新的空气"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1"
msgid "There, a whole breath without sneezing."
msgstr "好了，总算能好好吸口气了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2"
msgid "My eyes have stopped watering."
msgstr "眼睛不流泪了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PORTABLEBOAT_SINK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PORTABLEBOAT_SINK"
msgid "We'd better find him and leave before this happens."
msgstr "我们最好在这件事发生之前找到赶紧走."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.1"
msgid "Everyone to shore! Leave the cargo!"
msgstr "往岸上去！先别管货物了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PORTABLEBOAT_SINK.2"
msgid "The deck's going under!"
msgstr "甲板要没进水里了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID"
msgid "mouse?"
msgstr "老鼠?"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID.1"
msgid "Rats! Cover the food!"
msgstr "老鼠！快把食物盖上！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID.2"
msgid "Listen to all those little feet."
msgstr "听，好多小爪子在跑。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID_OVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID_OVER"
msgid "These are important materials! I think..."
msgstr "这些都是重要的材料！ 我认为..."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.1"
msgid "The scurrying has finally stopped."
msgstr "总算听不见老鼠乱窜了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_OVER.2"
msgid "Let's see what they left in the pantry."
msgstr "看看储藏室里还剩些什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID_SPAWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATRAID_SPAWN"
msgid "Why now? !"
msgstr "为什么现在？！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.1"
msgid "Rats! Cover the food!"
msgstr "老鼠！快把食物盖上！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATRAID_SPAWN.2"
msgid "Listen to all those little feet."
msgstr "听，好多小爪子在跑。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_BURROWS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_BURROWS"
msgid "A mouse! Two mice! A bunch of rats!"
msgstr "一只老鼠！两只老鼠！一群老鼠！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.1"
msgid "There are signs of rats here."
msgstr "这里有老鼠来过的痕迹。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_BURROWS.2"
msgid "I'd better check our stores."
msgstr "我得检查一下储粮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1"
msgid "These expired foods seem to attract some unclean things."
msgstr "这些过期的食物似乎会引来一些不干净的东西."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.1"
msgid "There are signs of rats here."
msgstr "这里有老鼠来过的痕迹。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_FOOD.LEVEL_1.2"
msgid "I'd better check our stores."
msgstr "我得检查一下储粮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1"
msgid "What a mess! It's time for a reckoning!"
msgstr "真是一团糟！是时候清算了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.1"
msgid "There are signs of rats here."
msgstr "这里有老鼠来过的痕迹。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RATSNIFFER_ITEMS.LEVEL_1.2"
msgid "I'd better check our stores."
msgstr "我得检查一下储粮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RNEFOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_RNEFOG"
msgid "There's something out there...something new..."
msgstr "外面有东西……有新东西……"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.1"
msgid "I can hardly see past the bow."
msgstr "越过船头就看不清了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_RNEFOG.2"
msgid "Keep close in this fog."
msgstr "这么大的雾，跟紧些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ROOTING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_ROOTING"
msgid "Huh? It came out from under my feet!"
msgstr "啊? 从我脚下冒出来了!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ROOTING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ROOTING.1"
msgid "My feet are caught!"
msgstr "脚被缠住了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ROOTING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ROOTING.2"
msgid "Hold on. I can't move yet."
msgstr "等等，我还动不了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SMOLDER_SPORE_EATEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SMOLDER_SPORE_EATEN"
msgid "You absolutely can't eat that stuff."
msgstr "绝对不能吃那玩意。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.1"
msgid "My mouth's burning!"
msgstr "嘴里烫得厉害！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_EATEN.2"
msgid "I should have left that spore alone."
msgstr "那颗孢子真不该碰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP"
msgid "Damn it, why is it on fire?"
msgstr "卧槽，怎么着火了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.1"
msgid "My pack is smoking!"
msgstr "背包冒烟了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SMOLDER_SPORE_INVENTORY_POP.2"
msgid "Get that spore away from my things!"
msgstr "快把孢子从我东西里拿开！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNEEZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNEEZE"
msgid "OMG! what happened."
msgstr "我的天啊！怎么回事."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1"
msgid "Ah... achoo!"
msgstr "啊……阿嚏！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2"
msgid "Excuse me! Does anyone have a handkerchief?"
msgstr "失礼了！谁有手帕？"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNOWSTORM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNOWSTORM"
msgid "aaaa, I don't want to be buried in the snow!"
msgstr "aaaa, 我不想被雪埋了!"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.1"
msgid "I can't see the trail in all this snow."
msgstr "雪大得连路都看不清。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNOWSTORM.2"
msgid "Cover your face and stay together!"
msgstr "护住脸，别走散！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOADSTOOLED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOADSTOOLED"
msgid "Something ominous is stirring."
msgstr "一些不祥的事情在搅动"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.1"
msgid "That smell... is the toad near?"
msgstr "这个气味……蟾蜍就在附近吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOADSTOOLED.2"
msgid "Something's stirring among the mushrooms."
msgstr "蘑菇丛里有什么在动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_UM_NO_TORNADO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_UM_NO_TORNADO"
msgid "The air flow is very small now and there are no tornadoes around"
msgstr "现在气流很小，周围没有龙卷风"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.1"
msgid "The air's quite still here."
msgstr "这里的风很弱。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_UM_NO_TORNADO.2"
msgid "I don't see a funnel anywhere."
msgstr "四周都没见到旋风。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WINONAGEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_WINONAGEN"
msgid "\"I haven't gotten my 'putting rocks into machines' badge yet.\""
msgstr "我还没拿到“往机器里塞石头”的徽章呢。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.1"
msgid "Winona, which part takes the fuel?"
msgstr "薇诺娜，从哪儿加燃料？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_WINONAGEN.2"
msgid "I should ask before I touch the generator."
msgstr "我得先问清楚再动发电机。"

#. STRINGS.CHARACTERS.MANUTSAWEE.CURSED_ITEM_EQUIP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.CURSED_ITEM_EQUIP"
msgid "Ouch!"
msgstr "哎哟！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.1"
msgid "That curse has quite a hold on me."
msgstr "这诅咒缠得真紧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.CURSED_ITEM_EQUIP.2"
msgid "I'll find a way to break this."
msgstr "我会想办法解开它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.AIR_CONDITIONER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.AIR_CONDITIONER"
msgid "It is obviously made of very pungent toad skin, but it can actually filter out pollutants in the nearby air."
msgstr "它明明是用非常刺鼻的蛤蟆皮做的，但是居然能过滤掉附近空气中的污染物。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.1"
msgid "Strange to take a clean breath so near a toad skin."
msgstr "对着一张蟾蜍皮，居然能呼吸到干净空气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.AIR_CONDITIONER.2"
msgid "I can breathe more easily beside it."
msgstr "站在旁边呼吸顺畅多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ALPHA_LIGHTNINGGOAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ALPHA_LIGHTNINGGOAT"
msgid "careful! very dangerous. It's... inherently electric."
msgstr "小心！很危险。它...天生带电。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.1"
msgid "I'll watch the alpha volt goat without startling it."
msgstr "我尽量不惊动雄壮的伏特羊，看看它在做什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALPHA_LIGHTNINGGOAT.2"
msgid "It knows this ground better than I do."
msgstr "这里的地形，它比我熟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ANCIENTHOODEDTURF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ANCIENTHOODEDTURF"
msgid "Just put it back, it's of no use."
msgstr "铺回去吧，没什么用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.1"
msgid "I know that ground by the feel of it underfoot."
msgstr "这种地面，踩上去就认得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENTHOODEDTURF.2"
msgid "I'll set one piece down before I do the whole yard."
msgstr "先铺一块看看，再决定要不要铺满院子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ANCIENT_AMULET_RED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ANCIENT_AMULET_RED"
msgid "No, for her, I won't"
msgstr "不，为了她，我不会的"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.1"
msgid "I feel something strange around the ancient soul amulet."
msgstr "靠近那枚古老的护符时有种奇怪的感觉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ANCIENT_AMULET_RED.2"
msgid "Perhaps I should ask about it before I put it on."
msgstr "佩戴前还是先问问来历好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.APHID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.APHID"
msgid "This swarm of aphids was eating the red shirts."
msgstr "这群蚜虫啃食着那些红衫。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APHID.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APHID.1"
msgid "Where would I find the aphid after dark?"
msgstr "不知道蚜虫天黑以后会去哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APHID.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APHID.2"
msgid "I can tell more by watching than by chasing it."
msgstr "与其追过去，不如静下来观察。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMORLAVAE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMORLAVAE"
msgid "Why can't we be friends?"
msgstr "为什么我们不能成为朋友？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.1"
msgid "I could wear the dimvae over my training clothes."
msgstr "练习服外面还能再穿一层熔岩虫护甲。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMORLAVAE.2"
msgid "It has to leave my shoulders free."
msgstr "肩膀得活动得开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_GLASSMAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_GLASSMAIL"
msgid "This is so cool! !"
msgstr "这个太酷了！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.1"
msgid "I want to see whether I can turn freely in the shard-scale armor."
msgstr "我想试试穿上这副鳞甲还能不能灵活转身。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL.2"
msgid "I'll check the fastening twice."
msgstr "我得再检查一次搭扣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_GLASSMAIL_SHARDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_GLASSMAIL_SHARDS"
msgid "This is so cool! !"
msgstr "这个太酷了！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.1"
msgid "I'd check the fit of the moon shard before I rely on it."
msgstr "得先试过月亮碎片合不合身，再指望它护着我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_GLASSMAIL_SHARDS.2"
msgid "I'll check the fastening twice."
msgstr "我得再检查一次搭扣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_REED_UM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_REED_UM"
msgid "It's time to go to work in the fields."
msgstr "该下地干活了."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.1"
msgid "I could wear the reed suit over my training clothes."
msgstr "练习服外面还能再穿一层芦苇甲。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_REED_UM.2"
msgid "It has to leave my shoulders free."
msgstr "肩膀得活动得开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_SHARKSUIT_UM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_SHARKSUIT_UM"
msgid "It makes me feel like I'm at the top of the food chain."
msgstr "这让我感觉自己是食物链顶端的人。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.1"
msgid "I want to see whether I can turn freely in the rock hide armor."
msgstr "我想试试穿上鲨皮甲还能不能灵活转身。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_SHARKSUIT_UM.2"
msgid "I'll check the fastening twice."
msgstr "我得再检查一次搭扣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BAGOFMARBLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BAGOFMARBLES"
msgid "I appreciate the sophistication of their designs."
msgstr "我欣赏他们设计的复杂性。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.1"
msgid "I'd put the bag o' marbles within reach when I pack."
msgstr "收拾行装时，我会把这袋弹珠放在顺手的位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BAGOFMARBLES.2"
msgid "I should make time to practice before I need it."
msgstr "趁还不急用，我该抽空练练。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEAKBASHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEAKBASHER"
msgid "I put my beak on the stick. What should we do now?"
msgstr "我把喙放在棍子上。现在怎么办？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.1"
msgid "I hadn't thought of fitting a beak to a handle."
msgstr "我没想过还能把喙安在柄上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEAKBASHER.2"
msgid "I'd keep the hooked end away from my sleeve."
msgstr "得让带钩的一端离袖口远些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEARGERCLAW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEARGERCLAW"
msgid "The entire Eternal Continent was dug up."
msgstr "整个永恒大陆都挖了."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.1"
msgid "I'd bring the bearger claw back for a closer look."
msgstr "我想把獾爪带回去仔细看看。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEARGERCLAW.2"
msgid "I should look it over in better light."
msgstr "我想在亮一点的地方好好看看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEEFALOWINGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BEEFALOWINGS"
msgid "I'll just eat the extra horns as pie."
msgstr "多余的牛角，我直接吃派。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.1"
msgid "I'd bring the beefalo wings straight to the table."
msgstr "我把这道牛肉直接端上桌吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BEEFALOWINGS.2"
msgid "This is worth getting a clean plate for."
msgstr "值得专门拿个干净盘子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIEBOX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIEBOX"
msgid "It looks like it belongs to the girl who played with fire. Please keep it safe for her."
msgstr "看起来是那个玩火的女孩子的物品，帮她保管一下吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.1"
msgid "I'd bring the cuddly friends toy box back for a closer look."
msgstr "我想把玩具箱带回去仔细看看。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIEBOX.2"
msgid "I should look it over in better light."
msgstr "我想在亮一点的地方好好看看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_ACTIVE.ASHLEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_ACTIVE.ASHLEY"
msgid "That teddy bear is moving!"
msgstr "那只泰迪熊在动！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.1"
msgid "I recognize the bear, though the stitching looks different."
msgstr "我认得这只熊，不过针脚看起来不一样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.ASHLEY.2"
msgid "Who looks after you, little bear?"
msgstr "小熊，是谁在照顾你呀？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_ACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_ACTIVE.GENERIC"
msgid "That teddy bear is moving!"
msgstr "那只泰迪熊在动！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.1"
msgid "I'd give the bernie a little room to pass."
msgstr "我给伯尼让一点路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_ACTIVE.GENERIC.2"
msgid "I can tell more by watching than by chasing it."
msgstr "与其追过去，不如静下来观察。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_BIG.ASHLEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_BIG.ASHLEY"
msgid "It's creepy and cute at the same time!"
msgstr "它既令人毛骨悚然又可爱！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.1"
msgid "I recognize the bear, though the stitching looks different."
msgstr "我认得这只熊，不过针脚看起来不一样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.ASHLEY.2"
msgid "Who looks after you, little bear?"
msgstr "小熊，是谁在照顾你呀？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_BIG.GENERIC"
msgid "It's creepy and cute at the same time!"
msgstr "它既令人毛骨悚然又可爱！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.1"
msgid "Look, the bernie! has noticed us."
msgstr "看，伯尼！注意到我们了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_BIG.GENERIC.2"
msgid "Let's stay still and see what it does."
msgstr "先别动，看看它接下来做什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.ASHLEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.ASHLEY"
msgid "Completely burnt."
msgstr "完全烧焦了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.1"
msgid "I recognize the bear, though the stitching looks different."
msgstr "我认得这只熊，不过针脚看起来不一样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY.2"
msgid "Who looks after you, little bear?"
msgstr "小熊，是谁在照顾你呀？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN"
msgid "I didn't bring a sewing kit."
msgstr "我没有带针线包。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.1"
msgid "I can see the break in the bernie."
msgstr "能看见伯尼断在了什么地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.ASHLEY_BROKEN.2"
msgid "I'll put the loose pieces somewhere safe."
msgstr "我把松脱的零件收好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "I didn't bring a sewing kit."
msgstr "我没有带针线包。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.1"
msgid "I can see the break in the bernie."
msgstr "能看见伯尼断在了什么地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.BROKEN.2"
msgid "I'll put the loose pieces somewhere safe."
msgstr "我把松脱的零件收好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "Completely burnt."
msgstr "完全烧焦了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.1"
msgid "I hadn't expected to find the bernie out here."
msgstr "没想到能在这里找到伯尼。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BERNIE_INACTIVE.GENERIC.2"
msgid "I can see where the beefalo wool went into it."
msgstr "看得出哪里用上了牛毛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIGHT"
msgid "The consequences of the maker's intervention have been realized."
msgstr "制造者的干预，后果已经实现。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BIGHT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BIGHT.1"
msgid "Is that the usual gait for the comingled clockwork?"
msgstr "那个发条造物平时也是这样活动的吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BIGHT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BIGHT.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_ELECTRIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_ELECTRIC"
msgid "Is this right?"
msgstr "这才对嘛"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.1"
msgid "I'll leave room for the electric dart in the pouch."
msgstr "我看看怎么把电吹箭装进弹袋。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_ELECTRIC.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_FIRE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_FIRE"
msgid "Is this right?"
msgstr "这才对嘛"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.1"
msgid "A separate pocket for the fire dart. I can find the right shot by touch."
msgstr "我想把火吹箭单独装，伸手就能找到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_FIRE.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_SLEEP"
msgid "Is this right?"
msgstr "这才对嘛"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.1"
msgid "I'll leave room for the sleep dart in the pouch."
msgstr "我看看怎么把催眠吹箭装进弹袋。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_SLEEP.2"
msgid "I'll keep the spare shots where they won't spill."
msgstr "备用弹丸要收在不易撒出来的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_TOOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWGUNAMMO_TOOTH"
msgid "Is this right?"
msgstr "这才对嘛"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.1"
msgid "I can tell the dart apart by its weight."
msgstr "我能凭分量认出吹箭。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLOWGUNAMMO_TOOTH.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPANCAKES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPANCAKES"
msgid "Can I have three servings?"
msgstr "我可以吃三份吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.1"
msgid "I'd bring the boomberry pancakes straight to the table."
msgstr "我把蓝莓煎饼直接端上桌吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPANCAKES.2"
msgid "This is worth getting a clean plate for."
msgstr "值得专门拿个干净盘子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.FROZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.FROZE"
msgid "It froze and came out clean!"
msgstr "它冻住了，干净利落！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.1"
msgid "There's frost on the blueberry leaves."
msgstr "蓝莓叶上结霜了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.FROZE.2"
msgid "I'll see how it does after the thaw."
msgstr "等霜化了我再来看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.READY"
msgid "Wow! Everything here is big!"
msgstr "哇哦！ 这里的一切都很大！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.1"
msgid "Time to see what the boomberry plant has for us."
msgstr "该看看蓝莓丛这里有什么收获了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.READY.2"
msgid "I got here just in time."
msgstr "我来得正是时候。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.REGROWING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEBERRYPLANT.REGROWING"
msgid "It will come back, right?"
msgstr "它会回来的，对吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.1"
msgid "There's nothing left to pick from the boomberry plant today."
msgstr "今天从蓝莓丛上已经摘不到东西了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEBERRYPLANT.REGROWING.2"
msgid "Best to leave the roots undisturbed now."
msgstr "这时候还是别动根了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM_CRACKED"
msgid "Ah, this is so ugly"
msgstr "啊，这个好丑"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.1"
msgid "A little light brings the colour out in the shaped blue gem."
msgstr "照点光就能看清这颗磨过的宝石的颜色。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUEGEM_CRACKED.2"
msgid "I'd turn it over slowly to look for flaws."
msgstr "我想慢慢转一圈，看看有没有瑕疵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHED_ROOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHED_ROOM"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BLUE_MUSHED_ROOM.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT"
msgid "A softer pad for things that hit my boat."
msgstr "一个更柔软的垫子，可以用来对付撞到我船的东西。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.1"
msgid "I'll have a look at it while the water's calm."
msgstr "趁海面平静，我看看淤泥防撞套件。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMBER_SLUDGE_KIT.2"
msgid "It's easier to sort things out here than in rough seas."
msgstr "总比到了风浪里再处理容易。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_COPPER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_COPPER"
msgid "This should last long enough."
msgstr "这应该持续足够长的时间。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.1"
msgid "I wonder what a heavy swell would do to the copper bumper."
msgstr "想看看遇到海浪时铜防撞板表现如何。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER.2"
msgid "I won't go far from the dock until it's ready."
msgstr "准备妥当前，我不会离码头太远。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_COPPER_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_COPPER_KIT"
msgid "Now we just need a ship for protection."
msgstr "现在我们只需要一艘船来保护。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.1"
msgid "I'll check the copper bumper kit before we leave the shore."
msgstr "离岸前我要检查铜防撞板套件。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_COPPER_KIT.2"
msgid "It's easier to sort things out here than in rough seas."
msgstr "总比到了风浪里再处理容易。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SLUDGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SLUDGE"
msgid "It will bounce off anything that hits it."
msgstr "它会反弹任何击中它的东西。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.1"
msgid "I'll have a look at the sludge bumper while the water's calm."
msgstr "趁海面平静，我看看淤泥防撞板。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_SLUDGE.2"
msgid "It's easier to sort things out here than in rough seas."
msgstr "总比到了风浪里再处理容易。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN_UM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN_UM"
msgid "It tampered with the ballooning of local clouds."
msgstr "它篡改了当地云层的气球。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.1"
msgid "I'd bring the washing in before she reads a word."
msgstr "她还没开口，我就想先把晾的衣服收了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BOOK_RAIN_UM.2"
msgid "A useful book to have when the garden is dry."
msgstr "菜园缺水的时候，有这本书真好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGZAPPER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGZAPPER"
msgid "Snapped! Snapped! Snapped! Nasty bugs."
msgstr "啪！啪！啪！讨厌的虫子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.1"
msgid "I'd put the bug zapper within reach when I pack."
msgstr "收拾行装时，我会把灭虫灯放在顺手的位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUGZAPPER.2"
msgid "I can tell quite a lot from the wear on the handle."
msgstr "握柄上的磨痕能看出不少东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLETBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLETBEE.GENERIC"
msgid "I love the cut of that bee arm."
msgstr "我喜欢那只蜜蜂臂的剪裁。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.1"
msgid "I can hear the change in its buzzing."
msgstr "我听得出它振翅的声音变了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.GENERIC.2"
msgid "I'll keep out of the bee's flight path."
msgstr "我还是别挡在蜜蜂飞过的路上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLETBEE.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLETBEE.HELD"
msgid "Buzz!"
msgstr "嗡嗡声！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.1"
msgid "I have you, don't wriggle so much."
msgstr "我接住你了，别扭得那么厉害。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BULLETBEE.HELD.2"
msgid "I hope I haven't frightened it."
msgstr "希望没把它吓坏。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHCRAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHCRAB"
msgid "Ahhhh! How did it appear before me? !"
msgstr "啊啊啊！它是怎么出现在我面前的？！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.1"
msgid "I'll remember where the bush crab grows."
msgstr "我要记住灌木蟹长在哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BUSHCRAB.2"
msgid "I'll take a closer look without pulling anything up."
msgstr "靠近点看就好，不必把它拔出来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAKING"
msgid "Spicy soup, but it seems different from the one in California? . . ."
msgstr "胡辣汤，但好像跟在加州的不太一样？。。。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.1"
msgid "I'd bring the california king straight to the table."
msgstr "我把这道辣汤直接端上桌吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CALIFORNIAKING.2"
msgid "I'd like to taste it before it gets cold."
msgstr "我想趁还热着尝一口。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANNONBALL_SLUDGE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANNONBALL_SLUDGE_ITEM"
msgid "It still messes things up."
msgstr "它还是把事情搞砸了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.1"
msgid "I'll wedge it in place so it can't roll about the deck."
msgstr "我把它卡住，免得它在甲板上乱滚。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CANNONBALL_SLUDGE_ITEM.2"
msgid "Nobody wants to meet one of these with a bare toe."
msgstr "船上光着脚时，可千万别踢到这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_DON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_DON"
msgid "I can't see many words clearly. I can only recognize the words \"Don't\" and \"Guide\"."
msgstr "好多字都看不清了，只认得“别”和“指南”。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.1"
msgid "Somebody kept the torn book long enough for us to find it."
msgstr "有人把这本残破的书留了这么久，才让我们找到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_DON.2"
msgid "Perhaps someone at camp will recognize this."
msgstr "也许营地里有人认得。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_FREDDO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_FREDDO"
msgid "There is only the word \"freedom\" on it."
msgstr "上面只有“自由”两个字。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.1"
msgid "Of all the things to turn up here, the broken cassete!"
msgstr "居然会在这里找到这卷坏掉的磁带！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_FREDDO.2"
msgid "I can always spare one little corner of my pack."
msgstr "背包角落里总还有点空。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_JAZZY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CCTRINKET_JAZZY"
msgid "I can't appreciate jazz."
msgstr "爵士乐，我欣赏不来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.1"
msgid "Of all the things to turn up here, the rusty saxophone!"
msgstr "居然会在这里找到这把旧萨克斯！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CCTRINKET_JAZZY.2"
msgid "I can always spare one little corner of my pack."
msgstr "背包角落里总还有点空。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLES_T_HORSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLES_T_HORSE"
msgid "Not a single gear in sight."
msgstr "看不到一个齿轮。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.1"
msgid "I wonder who first thought to make the broken toy this shape."
msgstr "不知最早是谁想到把那件坏玩具做成这种形状。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLES_T_HORSE.2"
msgid "A dry handle makes all the difference."
msgstr "柄干燥，握起来就稳多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIEPHONOGRAPH_100
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIEPHONOGRAPH_100"
msgid "How does this thing work without a power source?"
msgstr "这玩意没有电源，怎么运行的？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.1"
msgid "The music carries a long way from that horn."
msgstr "声音从那只喇叭里传出去好远。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHARLIEPHONOGRAPH_100.2"
msgid "I'd like to know who's choosing the records."
msgstr "不知道是谁在挑唱片。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHERRYBULLETBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHERRYBULLETBEE.GENERIC"
msgid "I love the cut of that bee arm."
msgstr "我喜欢那只蜜蜂臂的剪裁。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.1"
msgid "I can hear the change in its buzzing."
msgstr "我听得出它振翅的声音变了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.GENERIC.2"
msgid "I'll keep out of the bee's flight path."
msgstr "我还是别挡在蜜蜂飞过的路上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHERRYBULLETBEE.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHERRYBULLETBEE.HELD"
msgid "Buzz!"
msgstr "嗡嗡声！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.1"
msgid "I can feel it moving in my hands."
msgstr "能感觉到它在手里动。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHERRYBULLETBEE.HELD.2"
msgid "It's much smaller this close."
msgstr "拿到跟前显得真小。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CODEX_MANTRA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CODEX_MANTRA"
msgid "Would make a great bedtime story...for nightmares!"
msgstr "会成为一个很棒的睡前故事......用于噩梦！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.1"
msgid "I hadn't expected to find the codex mantra out here."
msgstr "没想到能在这里找到这本咒语书。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CODEX_MANTRA.2"
msgid "I could save it for someone who needs it."
msgstr "可以留给需要的人。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERSMALLMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERSMALLMEAT"
msgid "It still smells weird."
msgstr "它还是在散发着奇怪的气味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.1"
msgid "Someone saved me a portion of the cooked monster morsel."
msgstr "有人给我留了一份这块熟怪物肉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COOKEDMONSTERSMALLMEAT.2"
msgid "I should eat before practice this time."
msgstr "这次得记得先吃饭再练习。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORNCAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORNCAN"
msgid "Well, it has corn in it."
msgstr "嗯，里面装了玉米。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CORNCAN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CORNCAN.1"
msgid "I'd set the canned corn beside the rest of my supplies."
msgstr "我想把玉米罐头放在其他物资旁边。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CORNCAN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CORNCAN.2"
msgid "I wonder how long it's been here."
msgstr "不知道它在这儿多久了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABCLAW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABCLAW"
msgid "It was full of rocks and no meat."
msgstr "里面全是石头，没有肉."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.1"
msgid "I'd like to know what Warly would serve with the crab claw."
msgstr "不知道沃利会给蟹钳配什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRABCLAW.2"
msgid "I should get a clean plate for this."
msgstr "我得拿个干净盘子来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB_REAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB_REAL"
msgid "Kawaii, who is the cute little guy?"
msgstr "卡哇伊，谁是可爱的小家伙？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.1"
msgid "I wonder what the rock den looked like when this place was new."
msgstr "不知道这里刚建成时，岩石巢穴是什么样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL.2"
msgid "I want to know why it's here in this particular spot."
msgstr "我想知道它为什么偏偏在这个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB_REAL_BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB_REAL_BROKEN"
msgid "I'm going to fix it up and use it as a mini animal shelter."
msgstr "我要把它修好，作为一个迷你动物收容所。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.1"
msgid "We could mend this and give a small creature a home."
msgstr "修好这里，小动物就能住了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTERLAB_REAL_BROKEN.2"
msgid "I'll check the supports before anything shelters here."
msgstr "让动物住进来以前，我得先检查支架。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_FIGGY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_FIGGY"
msgid "Cotton bug?"
msgstr "棉花虫子？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.1"
msgid "There's the figgy. I'll crouch down to say hello."
msgstr "是这只小伙伴。我蹲下来打个招呼。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CRITTER_FIGGY.2"
msgid "You can come closer, little one."
msgstr "小家伙，可以再靠近些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_ANTLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_ANTLER"
msgid "That big guy came to me on his own, and he even lost to me.\n And the corner of it is a bit heavy."
msgstr "是那大家伙自己找上门来的，而且还败给了我。\n 还有它这个角，有点重。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.1"
msgid "I'd like to see the cursed antler in the hands of someone who knows it."
msgstr "我想看看熟手是怎么用受诅咒的角的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CURSED_ANTLER.2"
msgid "Better wipe it down before I put it away."
msgstr "收起来以前得先擦一遍。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_BARRIER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_BARRIER"
msgid "let me out!"
msgstr "放我出去！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.1"
msgid "I'd like to see the glacial wall in daylight."
msgstr "我想看看日光下的冰墙。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEERCLOPS_BARRIER.2"
msgid "I can see a little more from the other side."
msgstr "从另一边还能多看到一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVILSFRUITCAKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVILSFRUITCAKE"
msgid "Sweet and a little evil."
msgstr "甜的有点邪恶。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.1"
msgid "I'd like to share the devils fruit cake after practice."
msgstr "练完以后，我想和大家分着吃水果蛋糕。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DEVILSFRUITCAKE.2"
msgid "I'm hungry enough to try a bite now."
msgstr "我现在就有点想尝一口。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DISEASECUREBOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DISEASECUREBOMB"
msgid "It smells bad, but this oil can treat plant diseases without any side effects."
msgstr "很难闻，但是这个油可以给植物治病，还没有副作用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.1"
msgid "You can smell that treatment right across the garden."
msgstr "隔着整个园子都闻得到这剂药的味道。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DISEASECUREBOMB.2"
msgid "If it saves the plants, I'll put up with the smell."
msgstr "它能救这些植物的话，这气味我可以忍受。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DORMANT_RAIN_HORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DORMANT_RAIN_HORN"
msgid "What's missing and doesn't work?"
msgstr "少了什么, 不起作用？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.1"
msgid "I'll keep the dormant conch apart from the food in my pack."
msgstr "这只海螺得和背包里的食物分开收。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DORMANT_RAIN_HORN.2"
msgid "The texture isn't what I expected."
msgstr "摸起来和我想的不一样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOODFISHINGROD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOODFISHINGROD"
msgid "A more stable way to fish."
msgstr "一种更稳定的钓鱼方式."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.1"
msgid "I'd like to see the driftwood fishing rod in the hands of someone who knows it."
msgstr "我想看看熟手是怎么用浮木鱼竿的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DRIFTWOODFISHINGROD.2"
msgid "I'll make room so my sleeves don't catch."
msgstr "我让出些地方，免得衣袖被勾住。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI_ALLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.EYEOFTERROR_MINI_ALLY"
msgid "I started to feel uncomfortable."
msgstr "我开始感到不自在了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.1"
msgid "I'd like to sketch the hardy peeper before it moves again."
msgstr "趁这只小眼睛没动，我想画下它的样子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.EYEOFTERROR_MINI_ALLY.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_FROCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FEATHER_FROCK"
msgid "Think it must be!"
msgstr "思必得！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.1"
msgid "I can see every fine strand on the feather frock."
msgstr "羽衣上的细纹一根根都看得清。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FEATHER_FROCK.2"
msgid "So much colour in something that weighs so little."
msgstr "这么轻的东西，颜色却如此鲜明。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_DRIED"
msgid "Dried fish makes a delicious soup."
msgstr "大鱼干，熬汤很好喝。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.1"
msgid "I'll keep the fishy jerky wrapped for the walk home."
msgstr "我把鱼肉干包好，留着路上吃。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FISHMEAT_DRIED.2"
msgid "I like provisions I can tuck into a sleeve."
msgstr "我喜欢能塞进袖兜里的口粮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLORAL_BANDAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLORAL_BANDAGE"
msgid "The medicinal properties of cactus flowers work well with ointments."
msgstr "仙人掌花的药用特性与药膏非常相配。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.1"
msgid "I ought to make a place for the sweetflower wrap in my pack."
msgstr "得在包里给花瓣绷带腾个位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLORAL_BANDAGE.2"
msgid "I'll turn it over and have a look at the other side."
msgstr "我想翻过来看看另一面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITBAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITBAT"
msgid "Even uglier, a blueberry fruit bat."
msgstr "更丑了，一只蓝莓果蝠。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.1"
msgid "I'd give the fruit bat room to turn."
msgstr "得给果蝠留点转身的地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FRUITBAT.2"
msgid "Quiet now. I don't want to get too close."
msgstr "轻一点，我不想靠得太近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GASMASK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GASMASK"
msgid "I can put this on to relieve my horrible allergies."
msgstr "我可以戴上这个缓解这可怕的过敏症。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GASMASK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GASMASK.1"
msgid "Would the goose mask leave any room for my glasses?"
msgstr "戴着防毒面具还能不能戴眼镜？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GASMASK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GASMASK.2"
msgid "I like to keep my line of sight clear."
msgstr "我喜欢眼前敞亮些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_BLUEBERRY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_BLUEBERRY"
msgid "Can it be made into blueberry jam?"
msgstr "可以做成蓝莓酱吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.1"
msgid "I'd save the boomberry for after practice."
msgstr "我想把那颗大蓝莓留到练习结束后。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_BLUEBERRY.2"
msgid "Something to look forward to on the way home."
msgstr "回去路上也有个盼头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE"
msgid "I've seen these giant red shirts from afar, but they don't look right?"
msgstr "我在老远就看到这些巨大的红衫了，但是它们看起来不太对劲？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.1"
msgid "I'd like a drawing of the giant redwood for my notes."
msgstr "我想把那棵巨大的红杉的样子画进笔记。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE.2"
msgid "I should mind where I step near the roots."
msgstr "在根边走，得留意脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE_BIRDNEST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE_BIRDNEST"
msgid "It didn't break when it fell? Σ(っ °Д °;)っ"
msgstr "掉下来居然没摔碎？Σ(っ °Д °;)っ"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.1"
msgid "Twigs and grass, and not a stitch to hold it together."
msgstr "只用了树枝和草，一针线都没缝，居然这么牢。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_BIRDNEST.2"
msgid "Birds build better nests than I could with two hands."
msgstr "光靠我的两只手，也编不出这么好的鸟窝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE_INFESTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIANT_TREE_INFESTED"
msgid "This redshirt was infected by those pests and was slowly dying."
msgstr "这棵红衫被那些害虫感染了，正在慢慢地死去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.1"
msgid "I want to look at the infested giant redwood in better light."
msgstr "我想在亮些的地方仔细看看那棵生了虫的红杉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GIANT_TREE_INFESTED.2"
msgid "I could come back tomorrow to see what has changed."
msgstr "明天我可以回来看看有何变化。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLACIALHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLACIALHOUND"
msgid "Someone cast ice magic on it."
msgstr "被人施加了寒冰魔法."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.1"
msgid "I can just make out the glacial hound from here."
msgstr "我在这里刚好看得见冰猎犬。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLACIALHOUND.2"
msgid "I'll wait to see which way it goes."
msgstr "先等等，看它往哪儿去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASS_SCALES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASS_SCALES"
msgid "It's radiant and quite sharp."
msgstr "光芒四射，而且相当锐利。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.1"
msgid "I wonder what I could make with the enlightened scales."
msgstr "不知这些透明的鳞片能做成什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLASS_SCALES.2"
msgid "I'll clean it before I take it back."
msgstr "带回去以前要清理一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GORE_HORN_HAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GORE_HORN_HAT"
msgid "It turns shadows into speed!"
msgstr "它将阴影变成速度！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.1"
msgid "I should tuck my fringe back before trying on the gore horn."
msgstr "不知道那顶角盔会不会压住刘海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GORE_HORN_HAT.2"
msgid "I should see how it feels when I turn my head."
msgstr "转转头试试合不合适。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENGEM_CRACKED"
msgid "This feels really light."
msgstr "这个感觉真的很轻。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.1"
msgid "A little light brings the colour out in the shaped green gem."
msgstr "照点光就能看清这颗磨过的宝石的颜色。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREENGEM_CRACKED.2"
msgid "I'll wrap it so it won't scratch against the others."
msgstr "我把它包好，免得和别的磨花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHED_ROOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHED_ROOM"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_MUSHED_ROOM.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GREEN_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HARDSHELLTACOS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HARDSHELLTACOS"
msgid "More salad dressing?\n Ah, Chinese street food! How much I miss you...."
msgstr "再来点沙拉酱？\n 啊，中国的街头小吃！我多么想念你...."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.1"
msgid "I'd like to share the hard shell tacos after practice."
msgstr "练完以后，我想和大家分着吃硬壳塔可。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HARDSHELLTACOS.2"
msgid "A smaller portion for me if we're sharing."
msgstr "如果大家分着吃，我少拿一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAT_RATMASK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAT_RATMASK"
msgid "I don't want to wear this mask, not at all."
msgstr "我不想戴上这个面具，一点都不想."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.1"
msgid "Would the rat mask leave any room for my glasses?"
msgstr "戴着老鼠面具还能不能戴眼镜？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HAT_RATMASK.2"
msgid "I should see how it feels when I turn my head."
msgstr "转转头试试合不合适。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEY_LOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEY_LOG"
msgid "Sweet, but a little too sweet."
msgstr "甜，但是有点甜过头。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.1"
msgid "I'd save the honey log roll for after practice."
msgstr "我想把蜂蜜卷留到练习结束后。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HONEY_LOG.2"
msgid "I'd like to know how this was prepared."
msgstr "我想知道这是怎么备好的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDMOSS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDMOSS"
msgid "There seems to be moonlight on this piece of land?"
msgstr "这块地皮上，好像有月光？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.1"
msgid "I'd remember where that patch grows."
msgstr "我会记住这片植物长在哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDMOSS.2"
msgid "I'll take a closer look without pulling at the roots."
msgstr "我凑近看就好，不去拔根。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDTRAPDOOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDTRAPDOOR"
msgid "There must be something dangerous hidden in here, like a spider."
msgstr "这里面肯定藏了危险的东西，比如蜘蛛。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.1"
msgid "I want to know exactly where the flat stone is set."
msgstr "我得记准那块扁石头布置在什么地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDTRAPDOOR.2"
msgid "Nobody should stumble into this on the way home."
msgstr "别让回营地的人不小心踩上来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDWIDOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODEDWIDOW"
msgid "A huge spider was in front of me, and my penis was shaking, as if it was trying to tell me something."
msgstr "一只巨大的蜘蛛在我面前，我的雷切在抖动，好像是在想告诉我什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.1"
msgid "Where would I find the hooded widow after dark?"
msgstr "不知道那只寡妇蛛天黑以后会去哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODEDWIDOW.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODED_FERN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOODED_FERN"
msgid "It can grow this big if there is sunlight on the ground."
msgstr "地面上有阳光，它能长这么大。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.1"
msgid "I'd like to see how the large fern changes with the season."
msgstr "想看看换季时那丛大蕨叶会有什么变化。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOODED_FERN.2"
msgid "I should mind where I step near the roots."
msgstr "在根边走，得留意脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDIOUS_OBSERVIOUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDIOUS_OBSERVIOUS"
msgid "It's still alive!"
msgstr "它还活着！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.1"
msgid "I'd give it room to turn."
msgstr "得给这只眼睛留点转身的地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HOUNDIOUS_OBSERVIOUS.2"
msgid "Quiet now. I don't want to get too close."
msgstr "轻一点，我不想靠得太近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBOOMERANG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBOOMERANG"
msgid "I should have worn gloves,"
msgstr "我应该戴着手套，"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.1"
msgid "The frozen pincer takes a different grip from my katana."
msgstr "冰回旋镖的握法和我的刀不同。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEBOOMERANG.2"
msgid "I'll keep it dry on the walk back."
msgstr "回去路上得护着，不让它淋湿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS_AMULET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS_AMULET"
msgid "This is what \"Santa Claus\" uses for resurrection."
msgstr "这就是那位“圣诞老人”用来复活的东西。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.1"
msgid "I feel something strange around the naught lock."
msgstr "靠近那把锁时有种奇怪的感觉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KLAUS_AMULET.2"
msgid "Perhaps I should ask about it before I put it on."
msgstr "佩戴前还是先问问来历好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNOOK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNOOK"
msgid "This is so creepy!"
msgstr "这真是令人毛骨悚然！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KNOOK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KNOOK.1"
msgid "Look, the automaton abomination has noticed us."
msgstr "看，那具发条怪物注意到我们了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KNOOK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.KNOOK.2"
msgid "Let's stay still and see what it does."
msgstr "先别动，看看它接下来做什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE2"
msgid "Does anyone have oven mitts? This is too hot!"
msgstr "谁有烤箱手套，这个太烫了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVAE2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVAE2.1"
msgid "I'd give it a little room to pass."
msgstr "我给熔岩虫让一点路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVAE2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVAE2.2"
msgid "I'll stay downwind for a clearer look."
msgstr "我站在下风处看得更仔细些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT_SLUDGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT_SLUDGE"
msgid "A pile of magma."
msgstr "一堆岩浆。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.1"
msgid "There's still heat coming off that sludge."
msgstr "那团泥还在往外散热。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LAVASPIT_SLUDGE.2"
msgid "I'd leave it alone until it sets."
msgstr "还是等它凝固再说。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LICELOAF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LICELOAF"
msgid "It tastes very crispy. Ate this in Sichuan, China."
msgstr "吃起来非常酥脆。在中国四川吃过这个。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LICELOAF.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LICELOAF.1"
msgid "I'll save the liceloaf for a meal we can eat sitting down."
msgstr "那块肉糕要留到能好好坐下吃饭的时候。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LICELOAF.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LICELOAF.2"
msgid "I'm hungry enough to try a bite now."
msgstr "我现在就有点想尝一口。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGHOUND"
msgid "Gilded dog? Still charged..."
msgstr "镀金的狗？还带电..."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.1"
msgid "I'll watch the lightning hound without startling it."
msgstr "我尽量不惊动雷电猎犬，看看它在做什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LIGHTNINGHOUND.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUREPLAGUE_RAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUREPLAGUE_RAT"
msgid "I didn't want to look at it again, so I cut it up quickly."
msgstr "我不想再看它一眼，赶紧把它切了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.1"
msgid "I can just make out the lureplague rat from here."
msgstr "我在这里刚好看得见那只老鼠。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUREPLAGUE_RAT.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUSH_ENTRANCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUSH_ENTRANCE"
msgid "There was a very strong scent coming from below."
msgstr "从下面传来一股非常浓烈的香味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.1"
msgid "I'll mark the overly ominous hole on my map."
msgstr "我在图上标一下那个洞口。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.LUSH_ENTRANCE.2"
msgid "Better check the footing near the edge."
msgstr "靠近边缘先看清脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MAGMAHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MAGMAHOUND"
msgid "A petrified dog? Its mouth is on fire!"
msgstr "一只石化的狗？它嘴里冒着火！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.1"
msgid "I'll watch the magma hound without startling it."
msgstr "我尽量不惊动熔岩猎犬，看看它在做什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MAGMAHOUND.2"
msgid "It knows this ground better than I do."
msgstr "这里的地形，它比我熟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MARA_BOSS1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MARA_BOSS1"
msgid "It doesn't belong here, well, it shouldn't exist anywhere."
msgstr "它不属于这里，呃，在哪都不应该存在。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.1"
msgid "I don't recognize that one at all."
msgstr "我完全不认得这位。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARA_BOSS1.2"
msgid "I'll keep the others in sight while I find out who it is."
msgstr "我先跟紧同伴，再弄清对方是谁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MARSH_GRASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MARSH_GRASS"
msgid "There was no movement. It seemed safe there?"
msgstr "没有任何动静，看起来那里面很安全？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.1"
msgid "I'd like to see how the marsh bush changes with the season."
msgstr "想看看换季时沼泽草丛会有什么变化。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MARSH_GRASS.2"
msgid "I could come back tomorrow to see what has changed."
msgstr "明天我可以回来看看有何变化。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM"
msgid "Perpetual motion machine, infinite loop"
msgstr "永动机，无限循环"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.1"
msgid "I'll check the wind turbine before we leave the shore."
msgstr "离岸前我要检查风力涡轮。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_WINDTURBINE_ITEM.2"
msgid "I won't go far from the dock until it's ready."
msgstr "准备妥当前，我不会离码头太远。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYING"
msgid "Come on, the meat is dry!"
msgstr "来吧，肉已经干了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.1"
msgid "I'll leave this on the jerky hat a while longer."
msgstr "还得在这顶晾肉帽上再挂一阵。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING.2"
msgid "Still a little too damp in the middle."
msgstr "中间还有些潮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN"
msgid "Forget about the rain! dry!"
msgstr "忘记下雨吧！ 干燥！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.1"
msgid "The rain's getting to the jerky hat!"
msgstr "雨都淋到这顶晾肉帽上了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN.2"
msgid "How is anything supposed to dry in this weather?"
msgstr "这天气，挂什么也晾不干吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT"
msgid "Forget about the rain! dry!"
msgstr "忘记下雨吧！ 干燥！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.1"
msgid "The rain's getting to the jerky hat!"
msgstr "雨都淋到这顶晾肉帽上了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYINGINRAIN_NOTMEAT.2"
msgid "How is anything supposed to dry in this weather?"
msgstr "这天气，挂什么也晾不干吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT"
msgid "How long does it take to dry this thing? !"
msgstr "这东西要多久才能干？！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.1"
msgid "I'll leave this on the jerky hat a while longer."
msgstr "还得在这顶晾肉帽上再挂一阵。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.DRYING_NOTMEAT.2"
msgid "Still a little too damp in the middle."
msgstr "中间还有些潮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HAT.GENERIC"
msgid "I want to hang some meat!"
msgstr "我想挂点肉！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.GENERIC.1"
msgid "I should tuck my fringe back before trying on the jerky hat."
msgstr "不知道这顶晾肉帽会不会压住刘海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MEATRACK_HAT.GENERIC.2"
msgid "I'd take a look in a mirror before going out."
msgstr "出门前我想先照一下镜子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MINOTAUR_BOULDER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MINOTAUR_BOULDER"
msgid "Danger! Don't touch it."
msgstr "危险！不要动它。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER.1"
msgid "I can feel the weight of the ancient stone slab just looking at it."
msgstr "光看着那块石板，就能想见它有多沉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER.2"
msgid "I should look for a natural crack first."
msgstr "得先找找天然的裂缝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MINOTAUR_BOULDER_BIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MINOTAUR_BOULDER_BIG"
msgid "Seduce the big-horned rhinoceros to hit this big rock."
msgstr "勾引那个大角犀牛去撞这个大石头。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.1"
msgid "I can feel the weight of the giant stone slab just looking at it."
msgstr "光看着那块大石板，就能想见它有多沉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MINOTAUR_BOULDER_BIG.2"
msgid "I ought to ask the smith what to make of this."
msgstr "我想问问铁匠，这东西能怎么用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOCK_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOCK_DRAGONFLY"
msgid "This guy is looking for trouble on his own."
msgstr "这家伙自己来找茬了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOCK_DRAGONFLY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOCK_DRAGONFLY.1"
msgid "I'd like to watch the wilting dragonfly from somewhere quiet."
msgstr "我想在安静的地方观察那只蜻蜓。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOCK_DRAGONFLY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOCK_DRAGONFLY.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MONSTERSMALLMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MONSTERSMALLMEAT"
msgid "It looks like it can only be used as bait and should never be eaten."
msgstr "看起来只能作为诱饵，绝对不能吃。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT.1"
msgid "I'm leaving that off the dinner table."
msgstr "这东西可不能上饭桌。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT.2"
msgid "Please put that away from the good food."
msgstr "请把它和能吃的东西分开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MONSTERSMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MONSTERSMALLMEAT_DRIED"
msgid "emmm, I still can't swallow it."
msgstr "emmm，我还是无法下口。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT_DRIED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT_DRIED.1"
msgid "I'm leaving that off the dinner table."
msgstr "这东西可不能上饭桌。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT_DRIED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MONSTERSMALLMEAT_DRIED.2"
msgid "Please put that away from the good food."
msgstr "请把它和能吃的东西分开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONGLASS_GEODE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONGLASS_GEODE"
msgid "Once charged glass breaks, it doesn't last long."
msgstr "带电的玻璃一旦破裂就不会持续太久。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONGLASS_GEODE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONGLASS_GEODE.1"
msgid "There's a grain to the inert infused moon chunk if you look closely."
msgstr "仔细看，那块月亮晶石也有纹理。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONGLASS_GEODE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONGLASS_GEODE.2"
msgid "I ought to ask the smith what to make of this."
msgstr "我想问问铁匠，这东西能怎么用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_DRAGONFLY"
msgid "Ahhhh! ! what are you!"
msgstr "啊啊啊！！你是什么东西！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_DRAGONFLY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_DRAGONFLY.1"
msgid "I'd like to watch the moonmaw dragonfly from somewhere quiet."
msgstr "我想在安静的地方观察那只月光下的龙蝇。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_DRAGONFLY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_DRAGONFLY.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_GLASSSHARDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_GLASSSHARDS"
msgid "This is so cool! !"
msgstr "这个太酷了！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS.1"
msgid "I'd keep it until we find the rest."
msgstr "在找到剩下的部分以前，先把月亮碎片留好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS.2"
msgid "Setting the pieces side by side might help."
msgstr "把部件排在一起也许能看明白。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_GLASSSHARDS_RING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_GLASSSHARDS_RING"
msgid "This is so cool! !"
msgstr "这个太酷了！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS_RING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS_RING.1"
msgid "I'd like to see the marks on it up close."
msgstr "我想贴近看清那圈月亮碎片上的纹路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS_RING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_GLASSSHARDS_RING.2"
msgid "I'll wrap it separately from my ordinary things."
msgstr "我把它和日常用品分开包好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_LAVAE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_LAVAE"
msgid "living glass block"
msgstr "活的玻璃块"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE.1"
msgid "Where would I find the glass lavae after dark?"
msgstr "不知道玻璃熔岩虫天黑以后会去哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_LAVAE_RING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONMAW_LAVAE_RING"
msgid "living glass block"
msgstr "活的玻璃块"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE_RING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE_RING.1"
msgid "I feel something strange around it."
msgstr "靠近那圈熔岩虫时有种奇怪的感觉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE_RING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOONMAW_LAVAE_RING.2"
msgid "I'll wrap it separately from my ordinary things."
msgstr "我把它和日常用品分开包好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOON_TEAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOON_TEAR"
msgid "This stone? Crying?"
msgstr "这块石头？在流泪？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOON_TEAR.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOON_TEAR.1"
msgid "I'd bring the moon tear back for a closer look."
msgstr "我想把这颗月之泪带回去仔细看看。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOON_TEAR.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOON_TEAR.2"
msgid "I wonder how long it's been here."
msgstr "不知道它在这儿多久了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOTHERGOOSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOTHERGOOSE"
msgid "A goose with antlers?"
msgstr "长着鹿角的鹅？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOTHERGOOSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOTHERGOOSE.1"
msgid "I'd like to watch it from somewhere quiet."
msgstr "我想在安静的地方观察那只麋鹿鹅。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOTHERGOOSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MOTHERGOOSE.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUSHROOMSPROUT_OVERWORLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUSHROOMSPROUT_OVERWORLD"
msgid "It appears to be using spores to pollute the air."
msgstr "它似乎正在使用孢子污染空气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.1"
msgid "I wonder what it looked like when this place was new."
msgstr "不知道这里刚建成时，那株蘑菇是什么样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUSHROOMSPROUT_OVERWORLD.2"
msgid "I should make a quick sketch before we leave."
msgstr "走之前我该简单画个草图。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATOR_TRAPDOOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATOR_TRAPDOOR"
msgid "This seems to be for spiders to eat"
msgstr "这个好像是给蜘蛛吃的"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TRAPDOOR.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TRAPDOOR.1"
msgid "I'll leave the trapdoor switcherdoodle with Webber and his little friends."
msgstr "我把这块蜘蛛饼干留给韦伯和他的小伙伴们。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TRAPDOOR.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TRAPDOOR.2"
msgid "I should label that before anyone mistakes it for a snack."
msgstr "得加个标记，免得有人当成点心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NYMPH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NYMPH"
msgid "It is spreading the plague to more trees."
msgstr "它正在将瘟疫传播到更多的树木上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.NYMPH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.NYMPH.1"
msgid "Is that the usual gait for the nymph?"
msgstr "那个小精灵平时也是这样活动的吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.NYMPH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.NYMPH.2"
msgid "I can tell more by watching than by chasing it."
msgstr "与其追过去，不如静下来观察。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCEAN_SPEAKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCEAN_SPEAKER"
msgid "What the hell"
msgstr "什么玩意"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCEAN_SPEAKER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCEAN_SPEAKER.1"
msgid "I wonder how far that voice carries over the water."
msgstr "不知声音在水面上能传多远。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCEAN_SPEAKER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCEAN_SPEAKER.2"
msgid "I keep listening for the next sound from it."
msgstr "我一直留心它下一次会发出什么声响。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_BEAK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_BEAK"
msgid "The Kraken's mouth spits out a strange liquid."
msgstr "克拉肯的嘴，它会吐出一种奇怪的液体。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_BEAK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_BEAK.1"
msgid "Even on land it reminds me of the deep sea."
msgstr "即使到了岸上，它也让我想起深海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_BEAK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_BEAK.2"
msgid "I would rather have seen it from the deck."
msgstr "我还是更愿意站在甲板上看它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE"
msgid "In Korea, some people like to eat it raw. Well, I don't like it."
msgstr "在韩国，有些人喜欢生吃，呃，我不喜欢就是了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE.1"
msgid "Even on land it reminds me of the deep sea."
msgstr "即使到了岸上，它也让我想起深海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE.2"
msgid "I would rather have seen it from the deck."
msgstr "我还是更愿意站在甲板上看它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE_COOKED"
msgid "I need some mustard."
msgstr "我需要一些芥末。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_COOKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_COOKED.1"
msgid "Even on land it reminds me of the deep sea."
msgstr "即使到了岸上，它也让我想起深海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_COOKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_COOKED.2"
msgid "I would rather have seen it from the deck."
msgstr "我还是更愿意站在甲板上看它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE_EYE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCUPUS_TENTACLE_EYE"
msgid "Well, what can I do with this?"
msgstr "嗯，我能用这个做什么？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_EYE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_EYE.1"
msgid "Even on land it reminds me of the deep sea."
msgstr "即使到了岸上，它也让我想起深海。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_EYE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OCUPUS_TENTACLE_EYE.2"
msgid "I would rather have seen it from the deck."
msgstr "我还是更愿意站在甲板上看它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OPALPRECIOUSGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OPALPRECIOUSGEM_CRACKED"
msgid "it sparkles and is mesmerizing"
msgstr "它闪闪发光，令人着迷"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OPALPRECIOUSGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OPALPRECIOUSGEM_CRACKED.1"
msgid "A little light brings the colour out in the shaped iridescent gem."
msgstr "照点光就能看清这颗磨过的宝石的颜色。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OPALPRECIOUSGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.OPALPRECIOUSGEM_CRACKED.2"
msgid "I'll wrap it so it won't scratch against the others."
msgstr "我把它包好，免得和别的磨花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ORANGEGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ORANGEGEM_CRACKED"
msgid "It will make your fingers tingle."
msgstr "它会让你的手指发麻。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGEGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGEGEM_CRACKED.1"
msgid "I can see a reflection deep inside the shaped orange gem."
msgstr "这颗磨过的宝石深处映着一点光。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGEGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGEGEM_CRACKED.2"
msgid "I'd turn it over slowly to look for flaws."
msgstr "我想慢慢转一圈，看看有没有瑕疵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ORANGE_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ORANGE_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGE_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGE_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGE_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ORANGE_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PALE_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PALE_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PALE_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIED_PIPER_FLUTE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIED_PIPER_FLUTE"
msgid "If I play it, will it attract mice?"
msgstr "我演奏它，会引来老鼠吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.1"
msgid "I'd set the pied piper's pipe beside the rest of my supplies."
msgstr "我想把那支长笛放在其他物资旁边。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_PIPER_FLUTE.2"
msgid "I should look it over in better light."
msgstr "我想在亮一点的地方好好看看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIED_RAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIED_RAT"
msgid "I have seen it on the forbidden road in Hamelin, Germany, but it was not a big rat"
msgstr "卖唱的，引来的不是人而是老鼠."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_RAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_RAT.1"
msgid "I can just make out the pied piper from here."
msgstr "我在这里刚好看得见那只吹笛的老鼠。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_RAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIED_RAT.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIGKING_PIGGUARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIGKING_PIGGUARD"
msgid "These pigs sure know how to have fun."
msgstr "这些猪确实知道如何玩得开心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGGUARD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGGUARD.1"
msgid "The Pig King has picked quite a team."
msgstr "猪王真会挑选队员。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGGUARD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGGUARD.2"
msgid "Have you been training for the contest too?"
msgstr "你也在为比赛练习吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIGKING_PIGTORCH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIGKING_PIGTORCH"
msgid "These pigs sure know how to have fun."
msgstr "这些猪确实知道如何玩得开心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGTORCH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGTORCH.1"
msgid "I'll see how far the light from it reaches."
msgstr "我想看看猪人火炬的光能照到多远。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGTORCH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIGKING_PIGTORCH.2"
msgid "I can find my way by a light this size."
msgstr "凭这么一点光，就能找到路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PINK_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PINK_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PINK_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PINK_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PINK_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PINK_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PITCHERPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PITCHERPLANT"
msgid "Nepenthes, which preys on insects that have snared themselves in the area."
msgstr "猪笼草，它会捕食这附近自投罗网的虫子"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PITCHERPLANT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PITCHERPLANT.1"
msgid "I'll mark the spot where we found the pitcherplant."
msgstr "我标一下发现猪笼草的位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PITCHERPLANT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PITCHERPLANT.2"
msgid "I'll walk round it once for a better look."
msgstr "我绕一圈，看得仔细些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAGUEMASK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAGUEMASK"
msgid "Strange shape, seems to have been seen in some comics."
msgstr "奇怪的造型，好像在某本漫画上看到过。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.1"
msgid "Would the plague mask leave any room for my glasses?"
msgstr "戴着防疫面具还能不能戴眼镜？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PLAGUEMASK.2"
msgid "I'd take a look in a mirror before going out."
msgstr "出门前我想先照一下镜子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POLLENMITEDEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POLLENMITEDEN"
msgid "Stay away, this mite can cause severe allergy symptoms."
msgstr "离远点，这种螨虫会引起强烈的过敏症状。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITEDEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITEDEN.1"
msgid "I wonder if anyone's home at the pollen mite den today."
msgstr "不知道今天花粉螨巢里有没有住客。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITEDEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITEDEN.2"
msgid "I shouldn't stand right in the doorway."
msgstr "我可不该站在门口挡路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POLLENMITES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POLLENMITES"
msgid "Ahhhhhhhhhh, stay away from me! ! ! ! ! !"
msgstr "啊啊啊啊啊啊啊，离我远点！！！！！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITES.1"
msgid "I can just make out the pollen mites from here."
msgstr "我在这里刚好看得见花粉螨。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POLLENMITES.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLEBOAT_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLEBOAT_ITEM"
msgid "Small, convenient, soft pontoon, but not safe"
msgstr "很小，方便，软软的浮船，但是不安全"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PORTABLEBOAT_ITEM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PORTABLEBOAT_ITEM.1"
msgid "I'll check that it opens before we set out."
msgstr "出发前我得确认它能展开。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PORTABLEBOAT_ITEM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PORTABLEBOAT_ITEM.2"
msgid "I'd rather pack it dry."
msgstr "我想等它干了再收好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POWERCELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.POWERCELL"
msgid "Batteries, but where does the power come from?"
msgstr "电池，但是电哪里来呢？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POWERCELL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POWERCELL.1"
msgid "I could smell the energy cell from the other side of camp."
msgstr "在营地另一头就闻到了电池的气味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POWERCELL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.POWERCELL.2"
msgid "Supper's better when we can all sit down together."
msgstr "大家能坐在一起吃，晚饭才香。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PURPLEGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PURPLEGEM_CRACKED"
msgid "Weird"
msgstr "诡异"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.1"
msgid "A little light brings the colour out in the shaped purple gem."
msgstr "照点光就能看清这颗磨过的宝石的颜色。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLEGEM_CRACKED.2"
msgid "I'll wrap it so it won't scratch against the others."
msgstr "我把它包好，免得和别的磨花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PURPLE_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PURPLE_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLE_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLE_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLE_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PURPLE_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAIN_HORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAIN_HORN"
msgid "My memory must be hazy. I thought this did something else."
msgstr "我的记忆一定很模糊。我以为这做了别的事情。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAIN_HORN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAIN_HORN.1"
msgid "I'll keep the drowning conch apart from the food in my pack."
msgstr "那只海螺号角得和背包里的食物分开收。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAIN_HORN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAIN_HORN.2"
msgid "There's no reason to let good material go to waste."
msgstr "好材料没理由白白浪费。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RATPOISON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RATPOISON"
msgid "Poison has a strong smell of almonds."
msgstr "毒药，有一股强烈的杏仁味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISON.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISON.1"
msgid "Could we take the poison jam on the road with us?"
msgstr "路上能带着毒饵吃吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISON.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISON.2"
msgid "I'd like to know how this was prepared."
msgstr "我想知道这是怎么备好的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RATPOISONBOTTLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RATPOISONBOTTLE"
msgid "Poison has a strong smell of almonds."
msgstr "毒药，有一股强烈的杏仁味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISONBOTTLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISONBOTTLE.1"
msgid "I'll mark the bottle so nobody mistakes it for food."
msgstr "我要标好瓶子，免得有人把它当食物。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISONBOTTLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RATPOISONBOTTLE.2"
msgid "Keep it away from our provisions."
msgstr "得让它离口粮远一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAT_TAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAT_TAIL"
msgid "Ahhhh, I don't want to touch this tail, it's so disgusting."
msgstr "啊啊啊，我不想碰这个尾巴，好恶心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_TAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_TAIL.1"
msgid "I wonder what I could make with the rat tail."
msgstr "不知鼠尾能做成什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_TAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_TAIL.2"
msgid "The texture isn't what I expected."
msgstr "摸起来和我想的不一样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAT_WHIP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RAT_WHIP"
msgid "Whips made of rat tails, that's not a good idea...."
msgstr "老鼠的尾巴做成的鞭子, 这不是一个好主意...."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_WHIP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_WHIP.1"
msgid "The tail o' twined rats takes a different grip from my katana."
msgstr "那条鞭子的握法和我的刀不同。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_WHIP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RAT_WHIP.2"
msgid "I'll keep it dry on the walk back."
msgstr "回去路上得护着，不让它淋湿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.REDGEM_CRACKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.REDGEM_CRACKED"
msgid "So beautiful!"
msgstr "好漂亮呀！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.REDGEM_CRACKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.REDGEM_CRACKED.1"
msgid "A little light brings the colour out in the shaped red gem."
msgstr "照点光就能看清这颗磨过的宝石的颜色。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.REDGEM_CRACKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.REDGEM_CRACKED.2"
msgid "I'll wrap it so it won't scratch against the others."
msgstr "我把它包好，免得和别的磨花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHED_ROOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHED_ROOM"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_MUSHED_ROOM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_MUSHED_ROOM.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_MUSHED_ROOM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_MUSHED_ROOM.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_VOMIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_VOMIT"
msgid "Oops, I'm going to vomit"
msgstr "呕，我要吐了"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_VOMIT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_VOMIT.1"
msgid "Oh. I'd better look at something else."
msgstr "啊，我还是看向别处吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_VOMIT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RED_VOMIT.2"
msgid "Could we get some fresh air over here?"
msgstr "能让这里透透气吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICE"
msgid "They have to be cooked to taste."
msgstr "要把它们煮过才好吃。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE.1"
msgid "A bowl of rice would make this feel like supper at home."
msgstr "添一碗米饭，就有点像在家吃晚饭了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE.2"
msgid "I'd save the last mouthful for the broth."
msgstr "我想留最后一口拌汤吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICEPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICEPLANT"
msgid "WOW. Rice! Often seen in rural areas of China and Japan."
msgstr "WOW.水稻诶！在中国和日本的农村经常能看到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICEPLANT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICEPLANT.1"
msgid "I ought to remember the way back to it."
msgstr "得记住回到稻子这里的路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICEPLANT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICEPLANT.2"
msgid "Next time I'll bring my notebook."
msgstr "下次把笔记本带来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICE_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RICE_COOKED"
msgid "It seemed a bit overcooked and a bit tough.\n I want to make it into rice balls, that would be delicious."
msgstr "有点煮过头了好像，有点硬。\n 我想做成饭团，那样很好吃。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE_COOKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE_COOKED.1"
msgid "A bowl of rice would make this feel like supper at home."
msgstr "添一碗米饭，就有点像在家吃晚饭了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE_COOKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RICE_COOKED.2"
msgid "I'd save the last mouthful for the broth."
msgstr "我想留最后一口拌汤吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RNEGHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RNEGHOST"
msgid "Lonely ghost, what is it still complaining about?"
msgstr "孤魂野鬼，它还在怨念着什么？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNEGHOST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNEGHOST.1"
msgid "I'd give the fire stealer a little room to pass."
msgstr "我给那个幽灵让一点路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNEGHOST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNEGHOST.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RNESKELETON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RNESKELETON"
msgid "No, no, no, I don't want to dance with you."
msgstr "不不不, 我不想与你共舞."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNESKELETON.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNESKELETON.1"
msgid "Is that the usual gait for the skeleton?"
msgstr "那具骷髅平时也是这样活动的吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNESKELETON.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RNESKELETON.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKJAWLEATHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKJAWLEATHER"
msgid "What a beautiful fin."
msgstr "好漂亮的鳍。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROCKJAWLEATHER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROCKJAWLEATHER.1"
msgid "Tough hide. I wonder if my awl could pierce it."
msgstr "皮子真韧，不知我的锥子钻不钻得动。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROCKJAWLEATHER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROCKJAWLEATHER.2"
msgid "I'd cut along the grain and waste as little as possible."
msgstr "我想顺着纹理裁，尽量不浪费。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROSHIP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROSHIP"
msgid "Resentment awakened it, and it looked like it was thirsty for blood. Run away, run away quickly, run away quickly."
msgstr "怨念唤醒了它，看起来很渴望鲜血，溜，赶紧溜，快溜."

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROSHIP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROSHIP.1"
msgid "Is that the usual gait for the mechanical monstrosity?"
msgstr "玫瑰果平时也是这样活动的吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROSHIP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ROSHIP.2"
msgid "I'll stay downwind for a clearer look."
msgstr "我站在下风处看得更仔细些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTPACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTPACK"
msgid "Sprinkling salt grains on the snow lowers the melting point of the snow and makes it melt faster."
msgstr "把盐粒撒在雪上，降低雪的融点，让雪融化得更快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SALTPACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SALTPACK.1"
msgid "I ought to check what's already in the salt shaker 3000."
msgstr "该检查一下盐袋里已经装了什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SALTPACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SALTPACK.2"
msgid "I'll keep the things we need first near the top."
msgstr "先要用的东西得放在最上面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCORPIONCARAPACE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCORPIONCARAPACE"
msgid "It can be used as bait, but not as food."
msgstr "它能用来作为诱饵，但是不能作为食物。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACE.1"
msgid "I could wear the scorpion carapace over my training clothes."
msgstr "练习服外面还能再穿一层蝎壳。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACE.2"
msgid "I can mend a small tear before it gets worse."
msgstr "小破口要趁还没扯大时补好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCORPIONCARAPACECOOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCORPIONCARAPACECOOKED"
msgid "Even if I starve to death, I will not eat this."
msgstr "我就是饿死我也不会吃这个。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACECOOKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACECOOKED.1"
msgid "I'm leaving that off the dinner table."
msgstr "这东西可不能上饭桌。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACECOOKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCORPIONCARAPACECOOKED.2"
msgid "Please put that away from the good food."
msgstr "请把它和能吃的东西分开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCREECHER_TRINKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SCREECHER_TRINKET"
msgid "I don't see the use of this thing."
msgstr "我看不出来这玩意有什么用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCREECHER_TRINKET.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCREECHER_TRINKET.1"
msgid "I'd like to show the lost doll to the children at camp."
msgstr "我想把遗落的玩偶拿给营地里的孩子们看。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCREECHER_TRINKET.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SCREECHER_TRINKET.2"
msgid "It looks well handled. That usually means well loved."
msgstr "表面都摸旧了，想必很受喜爱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SEAFOODPAELLA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SEAFOODPAELLA"
msgid "I want another bowl!"
msgstr "我还要再来一碗！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEAFOODPAELLA.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEAFOODPAELLA.1"
msgid "I could make room for the seafood paella at supper."
msgstr "晚饭还能给海鲜饭留个位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEAFOODPAELLA.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEAFOODPAELLA.2"
msgid "A smaller portion for me if we're sharing."
msgstr "如果大家分着吃，我少拿一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_CROWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_CROWN"
msgid "I feel a little uncomfortable wearing it. . ."
msgstr "戴着它，我感觉有点不舒服。。。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_CROWN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_CROWN.1"
msgid "Would the shadow crown leave any room for my glasses?"
msgstr "戴着暗影王冠还能不能戴眼镜？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_CROWN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_CROWN.2"
msgid "I'd take a look in a mirror before going out."
msgstr "出门前我想先照一下镜子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_TELEPORTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_TELEPORTER"
msgid "A huge temptation? But sorry, I'm not interested in this kind of thing."
msgstr "巨大的诱惑？但是不好意思，我对这种东西不感兴趣。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_TELEPORTER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_TELEPORTER.1"
msgid "I'd stop by the grasping shadow again when we have more time."
msgstr "等我们有闲暇，我想再来看看那团暗影。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_TELEPORTER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHADOW_TELEPORTER.2"
msgid "I'll walk round it once for a better look."
msgstr "我绕一圈，看得仔细些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHOCKWORM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHOCKWORM"
msgid "Is it as electric as Rachel? !"
msgstr "它和雷切一样带电？！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHOCKWORM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHOCKWORM.1"
msgid "I'd like to watch the depths eel from somewhere quiet."
msgstr "我想在安静的地方观察那条洞穴鳗。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHOCKWORM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHOCKWORM.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROOM_SKIN_FRAGMENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROOM_SKIN_FRAGMENT"
msgid "It was useless and had a very pungent smell."
msgstr "毫无用处，还散发出非常刺鼻的味道。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHROOM_SKIN_FRAGMENT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHROOM_SKIN_FRAGMENT.1"
msgid "I'd keep the shroom skin scrap until we find the rest."
msgstr "在找到剩下的部分以前，先把蘑菇皮碎片留好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHROOM_SKIN_FRAGMENT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHROOM_SKIN_FRAGMENT.2"
msgid "That edge looks as if it ought to meet another."
msgstr "这道边缘应该还有另一半能对上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SIMPSALAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SIMPSALAD"
msgid "Sometimes, you can also eat some vegetables to lose weight."
msgstr "有时候，也可以吃点蔬菜，减减肥。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIMPSALAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIMPSALAD.1"
msgid "I could make room for the simple salad at supper."
msgstr "晚饭还能给那盘沙拉留个位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIMPSALAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIMPSALAD.2"
msgid "A smaller portion for me if we're sharing."
msgstr "如果大家分着吃，我少拿一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SIREN_THRONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SIREN_THRONE"
msgid "Oh see! a rock! one way or another."
msgstr "哦，看！一块石头！不管怎样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIREN_THRONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIREN_THRONE.1"
msgid "I wonder what the sirens throne looked like when this place was new."
msgstr "不知道这里刚建成时，海妖的宝座是什么样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIREN_THRONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SIREN_THRONE.2"
msgid "I want to know why it's here in this particular spot."
msgstr "我想知道它为什么偏偏在这个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKELETONMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKELETONMEAT"
msgid "Throw it away quickly! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !"
msgstr "赶紧扔掉！！！！！！！！！！！！！！！！！！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKELETONMEAT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKELETONMEAT.1"
msgid "I'd set the long pig beside the rest of my supplies."
msgstr "我想把那块肉放在其他物资旁边。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKELETONMEAT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKELETONMEAT.2"
msgid "Let me get my glasses. I'd like a closer look."
msgstr "让我戴上眼镜，我想看清楚些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLCHEST_CHILD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLCHEST_CHILD"
msgid "Can I get in there and try?"
msgstr "我可以钻进去试试吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLCHEST_CHILD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLCHEST_CHILD.1"
msgid "I'd put the things I don't need yet in the skull chest."
msgstr "暂时用不到的可以收进骷髅箱。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLCHEST_CHILD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLCHEST_CHILD.2"
msgid "I'd like one place where my glasses won't get crushed."
msgstr "我想留个不会压到眼镜的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLFLASK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLFLASK"
msgid "Forget about sadness, fear for a moment..."
msgstr "暂时忘记悲伤, 恐惧......"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK.1"
msgid "I wonder how long the relief inside this flask will last."
msgstr "不知道这瓶里带来的轻松能维持多久。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK.2"
msgid "I don't think I'd like a second sip."
msgstr "我想我不会再喝第二口。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLFLASK_EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SKULLFLASK_EMPTY"
msgid "The sadness and fear are back."
msgstr "悲伤, 恐惧又来回来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK_EMPTY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK_EMPTY.1"
msgid "There's nothing left to pour."
msgstr "再也倒不出东西了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK_EMPTY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SKULLFLASK_EMPTY.2"
msgid "I'll set the empty flask down."
msgstr "我把空瓶放下吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS.1"
msgid "I can tell the firecracker rounds apart by its weight."
msgstr "我能凭分量认出这类弹丸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_FIRECRACKERS.2"
msgid "I'll keep the spare shots where they won't spill."
msgstr "备用弹丸要收在不易撒出来的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GOOP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GOOP"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_GOOP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_GOOP.1"
msgid "I can tell the gloop rounds apart by its weight."
msgstr "我能凭分量认出这类弹丸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_GOOP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_GOOP.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_HONEY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_HONEY.1"
msgid "I can tell the stickies apart by its weight."
msgstr "我能凭分量认出黏黏弹。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_HONEY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_HONEY.2"
msgid "I'll have to set aside the honey if I make another."
msgstr "想再做一件，得多备些蜂蜜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LAZY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LAZY"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LAZY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LAZY.1"
msgid "A separate pocket for the lazy prankster rounds. I can find the right shot by touch."
msgstr "我想把这类弹丸单独装，伸手就能找到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LAZY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LAZY.2"
msgid "I should count the rounds before we leave."
msgstr "出门前得数清有多少发。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LIMESTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LIMESTONE"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.1"
msgid "I'll leave room for the limestone rounds in the pouch."
msgstr "我看看怎么把石灰岩弹装进弹袋。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.2"
msgid "I should count the rounds before we leave."
msgstr "出门前得数清有多少发。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONGLASS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONGLASS.1"
msgid "A separate pocket for the moonshots. I can find the right shot by touch."
msgstr "我想把月亮弹单独装，伸手就能找到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONGLASS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONGLASS.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONROCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONROCK"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONROCK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONROCK.1"
msgid "A separate pocket for the moonphase rounds. I can find the right shot by touch."
msgstr "我想把这类弹丸单独装，伸手就能找到。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONROCK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_MOONROCK.2"
msgid "Walter could tell me how these fly."
msgstr "沃尔特应该知道这种弹丸飞起来怎么样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.1"
msgid "I'll leave room for the obsidian rounds in the pouch."
msgstr "我看看怎么把黑曜石弹装进弹袋。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.2"
msgid "I'll keep the spare shots where they won't spill."
msgstr "备用弹丸要收在不易撒出来的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_RUBBER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_RUBBER"
msgid "Bullets are to be thrown."
msgstr "子弹要投掷。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_RUBBER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_RUBBER.1"
msgid "I can tell the rubberband rounds apart by its weight."
msgstr "我能凭分量认出这类弹丸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_RUBBER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_RUBBER.2"
msgid "I'll keep the spare shots where they won't spill."
msgstr "备用弹丸要收在不易撒出来的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_SALT
