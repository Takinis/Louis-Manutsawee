msgid "Point the candelabra lamp this way a little. That's better."
msgstr "把烛台灯往这边照一点。这样好多了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_CANDELABRA.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_CANDELABRA.2"
