#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2EMBROIDERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2EMBROIDERED.1"
msgid "Leave the dual embroidered lamp on till I find my shoes."
msgstr "等我找到鞋再关双纹花灯。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2EMBROIDERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2EMBROIDERED.2"
msgid "Point the dual embroidered lamp this way a little. That's better."
msgstr "把双纹花灯往这边照一点。这样好多了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2FRINGES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2FRINGES.1"
msgid "Point the dual fringes lamp this way a little. That's better."
msgstr "把双条纹灯往这边照一点。这样好多了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2FRINGES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2FRINGES.2"
msgid "Switch on the dual fringes lamp. I can't see what I'm doing."
msgstr "把双条纹灯打开。我看不见手上的东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2UPTURNS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_2UPTURNS.1"
