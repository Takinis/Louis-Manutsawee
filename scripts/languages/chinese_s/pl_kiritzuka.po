#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_BELLSHADE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_BELLSHADE.1"
msgid "Does the bellshade lamp have to be that bright when I'm trying to rest?"
msgstr "我正要休息，钟罩灯非得这么亮吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_BELLSHADE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_BELLSHADE.2"
