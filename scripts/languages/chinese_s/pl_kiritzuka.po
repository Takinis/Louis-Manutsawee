msgstr "把陶瓷灯打开。我看不见手上的东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_CERAMIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_LAMP_CERAMIC.2"
