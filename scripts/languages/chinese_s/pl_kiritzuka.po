msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIGMAN_COLLECTOR.GENERIC.2"
msgid "Maybe the collector can point me in the right direction."
msgstr "收藏家兴许能给我指个路。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING.1"
