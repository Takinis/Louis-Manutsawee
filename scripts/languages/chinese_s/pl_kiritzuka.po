msgid ""
msgstr ""
"Language: zh-CN\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"POT Version: 2.0"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC"
msgid "It's floating fine. Don't give me extra work."
msgstr "船浮得好好的，别给我找事做。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS"
msgid "Almost there. Don't rush me."
msgstr "快找到了，别催。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.GENERIC"
msgid "My eyes are too lazy for this. Need a magnifying glass."
msgstr "光靠眼睛太累了，得要个放大镜。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE"
msgid "Keep digging. Something's gotta give."
msgstr "再翻翻，总会翻出点什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SHOP.CANTPAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SHOP.CANTPAY"
msgid "Broke again. Story of my life."
msgstr "又没钱了，我的人生就是这样。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.SHOP.GENERIC"
msgid "Can't buy that. Whatever."
msgstr "买不了。算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.USEDOOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.USEDOOR.GENERIC"
msgid "Won't open. Want me to kick it?"
msgstr "打不开。要我踹开吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.USEDOOR.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.USEDOOR.LOCKED"
msgid "Locked. My bat counts as a key, right?"
msgstr "锁着呢。我的球棒也算钥匙吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_ALARMOVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_ALARMOVER"
msgid "Lost 'em. Running is such a pain."
msgstr "甩掉了。跑步真累人。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_BATS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_BATS"
msgid "Bats. Guess it's batting practice."
msgstr "蝙蝠来了。那就当打击练习吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_OTHERWORLD_DEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_OTHERWORLD_DEED"
msgid "My place is back in the pig town. Wrong world."
msgstr "我家在猪镇那边，这里不对。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_UNDERLEAFCANOPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUCE_UNDERLEAFCANOPY"
msgid "So dark under here. Perfect for a nap."
msgstr "树底下好暗，正适合睡午觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED"
msgid "There's a leak. Not my fault."
msgstr "漏水了。不关我的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING"
msgid "We're sinking. Great."
msgstr "在往下沉了。真棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT"
msgid "Land! Now! I'm not swimming in this skirt!"
msgstr "快上岸！我才不要穿着裙子游泳！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.1"
msgid "Finally, I can breathe."
msgstr "终于能喘口气了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.2"
msgid "Less sticky. Way better."
msgstr "没那么黏了，舒服多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEHUMID.3"
msgid "Good. My sleeves finally stopped sticking to my arms."
msgstr "好了，袖子终于不贴手臂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GAS_DAMAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GAS_DAMAGE"
msgid "Cough! This air is the worst!"
msgstr "咳咳！这空气烂透了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HAYFEVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HAYFEVER"
msgid "My nose... it's gonna... ugh."
msgstr "鼻子……要……呃。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HAYFEVER_OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HAYFEVER_OFF"
msgid "Nose is back to normal. Finally."
msgstr "鼻子总算消停了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOUSE_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOUSE_DOOR"
msgid "I need a permit to add a room? Seriously?"
msgstr "加个房间还要许可证？认真的？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_DOOR_FOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_DOOR_FOUND"
msgid "A secret door. Okay, that's kinda cool."
msgstr "暗门啊，还有点酷。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND"
msgid "Nothing. Wasted my time."
msgstr "什么都没有。浪费时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_FOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_FOUND"
msgid "Something's hidden here. I can feel it."
msgstr "这里藏着东西，我感觉得到。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_NOREWARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MYSTERY_NOREWARD"
msgid "All that for nothing? Lame."
msgstr "折腾半天什么都没有？无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOTHING_FOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOTHING_FOUND"
msgid "It's not reacting. Guess I'm too far away."
msgstr "它没反应，大概是离太远了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.1"
msgid "Gross!"
msgstr "恶心！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.2"
msgid "Ugh, it's still warm."
msgstr "呃，还是热的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.3"
msgid "Why am I the one doing this?"
msgstr "为什么是我来干这个？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICKPOOP.4"
msgid "I'm washing my hands ten times after this."
msgstr "等下我要洗十遍手。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.1"
msgid "Too hard! My bat's gonna bend!"
msgstr "太硬了！球棒都要弯了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.2"
msgid "Tougher than a school desk."
msgstr "比课桌还硬。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PUGALISK_INVULNERABLE.3"
msgid "Fine. I'll just hit harder."
msgstr "行，那我就再用力点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROOM_STUCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROOM_STUCK"
msgid "If I do that, I'm stuck in here forever. No thanks."
msgstr "那样我就永远困在这里了。不要。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNEEZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNEEZE"
msgid "Ah... ACHOO! ...Don't look at me."
msgstr "啊……阿嚏！……别看我。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SUITUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SUITUP"
msgid "Suit's on. Let's get this over with."
msgstr "穿好了。赶快结束吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TAXDAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TAXDAY"
msgid "Tax day. Free money. My favorite holiday."
msgstr "收税日。白来的钱，我最喜欢的节日。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOLCORRODED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOLCORRODED"
msgid "My tool melted! Are you kidding me?!"
msgstr "我的工具化掉了！开什么玩笑？！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.1"
msgid "This %s is so sticky and hot."
msgstr "这%s又闷又热。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.2"
msgid "I'm sweating buckets in this %s."
msgstr "穿着这%s，汗都流成河了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOO_HUMID.3"
msgid "I need a break from wearing this %s."
msgstr "我得把这件%s脱下来透透气。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRACKER_FAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRACKER_FAR"
msgid "It's thinking. Slower than me in math class."
msgstr "它在想。比我上数学课还慢。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRACKER_FOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRACKER_FOUND"
msgid "It's pointing somewhere. Fine, I'll go."
msgstr "它指了个方向。好吧，我去。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TURFTOOHARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TURFTOOHARD"
msgid "Too hard. Even I can't pry this up."
msgstr "太硬了。连我都撬不动。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST"
msgid "Whoa! ...Okay, that was kinda fun."
msgstr "哇！……好吧，有点好玩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.DEAD"
msgid "Not snapping at anyone now."
msgstr "现在咬不了谁了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.GENERIC"
msgid "A plant with teeth. That's just cheating."
msgstr "长牙的植物，这也太犯规了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADULT_FLYTRAP.SLEEPING"
msgid "Even plants get to nap. Jealous."
msgstr "连植物都能睡午觉，羡慕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALLOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALLOY"
msgid "Shiny metal. Heavy, but I can carry it."
msgstr "亮闪闪的金属，很重，但我扛得动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE"
msgid "Aloe. Good for scrapes. I get a lot of those."
msgstr "芦荟，治擦伤的。我经常擦伤。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_COOKED"
msgid "Cooked aloe. Slimy, but edible."
msgstr "熟芦荟。黏糊糊的，但能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_PLANTED"
msgid "Some aloe growing. Free first aid."
msgstr "长着芦荟。免费的急救药。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALOE_SEEDS"
msgid "Seeds. Plant them and wait. Boring."
msgstr "种子。种下去然后等。无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HERALD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HERALD"
msgid "Big, spooky and loud. Just like the principal."
msgstr "又大又吓人又吵，跟校长一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HULK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HULK"
msgid "A giant robot. Okay, that's kinda awesome."
msgstr "巨型机器人。好吧，这个有点帅。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_REMNANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_REMNANT"
msgid "Dark rags. Smells like a cursed gym bag."
msgstr "黑乎乎的碎布，闻起来像被诅咒的运动包。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY"
msgid "Half-built junk. Don't you dare wake up."
msgstr "拼了一半的废铁。你可别醒过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_CLAW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_CLAW"
msgid "A claw. Still twitching. Gross."
msgstr "一只爪子，还在抽动。恶心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_HEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_HEAD"
msgid "A big metal head. It keeps staring at me."
msgstr "大铁脑袋，一直盯着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_LEG"
msgid "A leg. Where's the rest of you?"
msgstr "一条腿。你剩下的部分呢？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_RIBS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ROBOT_RIBS"
msgid "Iron ribs. Plenty of scrap to smack loose."
msgstr "铁肋骨。能敲下来不少废铁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCHEST"
msgid "A honey chest. Free snacks inside, hopefully."
msgstr "蜜箱。希望里面有免费的零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCOMBHOME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCOMBHOME"
msgid "Bug apartments. Hard pass."
msgstr "虫子公寓。我不去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTHILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTHILL"
msgid "Giant bugs living in a giant hill. Of course."
msgstr "巨型虫子住在巨型土堆里。合理。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM"
msgid "Tastes like medicine and regret."
msgstr "味道像药加后悔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLER"
msgid "A whistle. Blow it and something big shows up."
msgstr "鸟笛。一吹就有大家伙过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLER_CORRUPTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLER_CORRUPTED"
msgid "This whistle feels nasty. Good for scaring birds."
msgstr "这个笛子感觉很邪门，正好拿来吓鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.DEAD"
msgid "Squashed. Next."
msgstr "拍扁了。下一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.GENERIC"
msgid "A bug the size of a person. Nope."
msgstr "跟人一样大的虫子。不行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN.SLEEPING"
msgid "Sleeping bug. Let's keep it that way."
msgstr "虫子在睡觉。就让它继续睡吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN_WARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN_WARRIOR"
msgid "That one looks like a sports team captain. Mean."
msgstr "那只看起来像运动社团的队长，很凶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN_WARRIOR_EGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMAN_WARRIOR_EGG"
msgid "Don't hatch. I'm begging you."
msgstr "别孵出来，求你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMASKHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTMASKHAT"
msgid "Wearing a bug's face. Sticky inside. Ugh."
msgstr "戴着虫子的脸，里面黏黏的。呃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN"
msgid "Huge, loud and bossy. Like a hall monitor."
msgstr "又大又吵还爱指挥人，跟纪律委员一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN_CHAMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN_CHAMBERS"
msgid "A fancy room for a fancy bug."
msgstr "给高级虫子住的高级房间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN_THRONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTQUEEN_THRONE"
msgid "A throne. I wanna smash it. Just a little."
msgstr "王座。好想砸一下，就一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTSUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTSUIT"
msgid "Bug armor. Crunchy. Smells weird."
msgstr "虫子盔甲。脆脆的，味道怪怪的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANT_CAVE_LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANT_CAVE_LANTERN"
msgid "A lamp down here. Somebody's thoughtful."
msgstr "地底下居然有灯，有人很贴心嘛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.APORKALYPSE_CLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.APORKALYPSE_CLOCK"
msgid "Counting down to something bad. Classic."
msgstr "在倒数什么坏事。老套路了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORVORTEXCLOAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORVORTEXCLOAK"
msgid "A cloak that eats hits. Wish my uniform did that."
msgstr "能吞掉攻击的斗篷，我的制服要是也能就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_METALPLATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_METALPLATE"
msgid "A tin can I can wear. Clanky, but safe."
msgstr "能穿的铁罐头。叮当响，但安全。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN"
msgid "Snakeskin jacket. Looks kinda delinquent. I like it."
msgstr "蛇皮夹克，有点不良少女的感觉，我喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WEEVOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WEEVOLE"
msgid "Made of bug shells. Itchy, but it works."
msgstr "虫壳做的，会痒，但管用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_PLANTED"
msgid "Asparagus. Vegetables. Do I have to?"
msgstr "芦笋。蔬菜。非吃不可吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPEIN_HAMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPEIN_HAMMER"
msgid "Cute little hammer. My bat's way bigger."
msgstr "可爱的小锤子。我的球棒大多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO"
msgid "Bamboo. Hit it and it goes thwack."
msgstr "竹子，打起来会“啪”一声。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITHAT"
msgid "A sneaky hat. Very shady. I'd wear it."
msgstr "鬼鬼祟祟的帽子，很可疑。我会戴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITMAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITMAP"
msgid "A treasure map! Finally, something worth walking for."
msgstr "藏宝图！终于有值得走路的东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITTREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDITTREASURE"
msgid "Loot! It's not stealing if he stole it first."
msgstr "宝藏！他先偷的，我拿走不算偷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BASEFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BASEFAN"
msgid "A fan. Point it at me and leave me alone."
msgstr "风扇。对着我吹，然后别管我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATHAT"
msgid "A hat made of bat. I prefer my bats wooden."
msgstr "蝙蝠做的帽子。我还是喜欢木头球棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_HIDE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_HIDE"
msgid "Pig skin? Bat skin? It's skin. Whatever."
msgstr "猪皮？蝙蝠皮？反正就是皮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.DEAD"
msgid "That's what you get."
msgstr "活该。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.GENERIC"
msgid "A spiky duck thing. Don't come any closer."
msgstr "带刺的鸭子怪，别再靠近了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL.SLEEPING"
msgid "Snoring like it's in class."
msgstr "打着呼，跟在课上睡觉一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL_QUILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BILL_QUILL"
msgid "A quill. Could stab someone. Or do homework, I guess."
msgstr "一根刺。能扎人，大概也能写作业。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUNDERBUSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUNDERBUSS"
msgid "A big gun. Loud and messy. Bit like me."
msgstr "大枪。又吵又乱来，有点像我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT"
msgid "Slap it on the boat and done."
msgstr "往船上一拍就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO"
msgid "Big boat. Room for all my snacks."
msgstr "大船，能装下我所有零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CORK"
msgid "A cork bowl. This is a terrible idea."
msgstr "软木碗。这主意烂透了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT"
msgid "Logs tied together. Floats, probably."
msgstr "绑在一起的木头。应该能浮吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW"
msgid "All arms, no engine. Good thing I'm strong."
msgstr "全靠手臂划。还好我力气大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH"
msgid "A torch for the boat. Hands-free. Nice."
msgstr "船上的火把，不用手拿，不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESTAFF"
msgid "A snake skull on a stick. So edgy."
msgstr "棍子上插个蛇头骨，好中二。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLESPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLESPIKE"
msgid "Thorns everywhere. My legs are gonna get scratched."
msgstr "全是刺，腿要被划伤了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLE_BULB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLE_BULB"
msgid "A weird bulb. Probably worth whacking."
msgstr "奇怪的球茎，大概值得敲一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLE_CORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAMBLE_CORE"
msgid "Pretty flower, tons of thorns. Worth it?"
msgstr "花很好看，刺超多。值得吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGREPELLENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGREPELLENT"
msgid "Bug spray. Get away from me, bugs."
msgstr "驱虫剂。虫子都给我走开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURR"
msgid "Spiky ball. Something's inside. Probably."
msgstr "带刺的球，里面大概有东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURR_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURR_SAPLING"
msgid "A sapling. It's trying its best."
msgstr "树苗，它在努力了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANDLEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANDLEHAT"
msgid "A candle on my head. Please don't drip."
msgstr "头上顶根蜡烛，拜托别滴下来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_ROC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT_ROC"
msgid "Plugged up. Want me to bash it open?"
msgstr "被堵上了。要我砸开吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHITIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHITIN"
msgid "Bits of bug shell. Crunchy."
msgstr "虫壳碎片，脆脆的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_HAMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_HAMMER"
msgid "An official hammer. Feels like student council stuff."
msgstr "办公用的锤子，感觉是学生会的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_LAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_LAMP.GENERIC"
msgid "Street lamp. Off. Like me in the morning."
msgstr "路灯，没开。跟早上的我一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_LAMP.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CITY_LAMP.ON"
msgid "Lit up. Good, I hate walking in the dark."
msgstr "亮了。很好，我讨厌摸黑走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAWPALMTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAWPALMTREE"
msgid "That tree's got claws. Even the trees are delinquents here."
msgstr "树还长爪子，这里连树都是不良。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAWPALMTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAWPALMTREE_SAPLING"
msgid "Little claw tree. Cute. For now."
msgstr "小爪子树，现在还算可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLIPPINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLIPPINGS"
msgid "Leaf scraps. Proof I did yard work."
msgstr "碎叶子，证明我干过园艺活。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING"
msgid "It's lit! Throw it, throw it!"
msgstr "点着了！快扔快扔！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC"
msgid "A coconut bomb. Needs a light first."
msgstr "椰子炸弹，得先点火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE"
msgid "Coffee. Maybe now I'll stay awake in class."
msgstr "咖啡。这下上课说不定不会睡着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS"
msgid "Raw beans. They need a good roasting. Like my classmates."
msgstr "生豆子，得好好烤一烤。跟我同学一样欠收拾。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED"
msgid "Roasted. Smells way better now."
msgstr "烤好了，现在香多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COI"
msgid "A fish. Lunch, probably."
msgstr "一条鱼，大概是午饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COI_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COI_COOKED"
msgid "Grilled fish. Hand it over."
msgstr "烤鱼。给我拿来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CONSTRUCTION_PERMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CONSTRUCTION_PERMIT"
msgid "A permit to make my house bigger. Paperwork. Ugh."
msgstr "扩建许可证。又是文件，烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORK"
msgid "Cork. It floats. That's about it."
msgstr "软木，能浮。就这样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORKCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORKCHEST"
msgid "A cork barrel. Keeps the bugs out of my stuff."
msgstr "软木桶，能防虫子钻进我的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORK_BAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORK_BAT"
msgid "A cork bat! Light, but still a bat."
msgstr "软木棒！轻是轻，但还是根棒子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURTAIN_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURTAIN_DOOR"
msgid "Just a curtain. Barely a door."
msgstr "就一块帘子，算不上门。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS"
msgid "A swordfish sword. Smells fishy."
msgstr "剑鱼做的剑，有股鱼腥味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTNETTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTNETTLE"
msgid "Nettles. One sniff and my nose is clear. Weird."
msgstr "荨麻，闻一下鼻子就通了。奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ANTIQUITIES_BEEFALO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ANTIQUITIES_BEEFALO"
msgid "A beefalo head on the wall. He's not happy about it."
msgstr "墙上挂着个牦牛头，它看起来很不爽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ANTIQUITIES_WALLFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ANTIQUITIES_WALLFISH"
msgid "A fish on the wall. Found the smell."
msgstr "墙上的鱼。找到臭味的源头了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CAVE_BAT_BURROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CAVE_BAT_BURROW"
msgid "A hole full of bats. Not going near it."
msgstr "满是蝙蝠的洞，不靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CAVE_BEAM_ROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CAVE_BEAM_ROOM"
msgid "A rock pillar holding up the ceiling. Good job."
msgstr "撑着天花板的岩柱，辛苦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_BENCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_BENCH"
msgid "A bench. Long enough to lie down on."
msgstr "长凳，长度够我躺下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_CLASSIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_CLASSIC"
msgid "Classic chair. Looks like the teacher's."
msgstr "古典椅，看起来像老师坐的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_CORNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_CORNER"
msgid "A corner chair. Perfect for sulking."
msgstr "角落的椅子，最适合闹别扭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_FOOTREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_FOOTREST"
msgid "A footrest. My legs deserve this."
msgstr "踏板，我的腿值得拥有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_HORNED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_HORNED"
msgid "A chair with horns. Looks like the boss's seat."
msgstr "带角的椅子，像老大坐的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_LOUNGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_LOUNGE"
msgid "A lounge chair. Wake me up never."
msgstr "休息椅。永远别叫醒我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_MASSAGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_MASSAGER"
msgid "It vibrates. I don't trust it. ...Maybe just once."
msgstr "会震的椅子。我不信它……就试一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_OTTOMAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_OTTOMAN"
msgid "Seat, footrest, nap spot. Three in one."
msgstr "座位、踏板、午睡点，三合一。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_ROCKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_ROCKING"
msgid "Rocking chair. I'd be asleep in two seconds."
msgstr "摇椅。两秒就能睡着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_STUFFED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAIR_STUFFED"
msgid "Soft and comfy. I'm not getting up."
msgstr "又软又舒服，我不起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAISE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_CHAISE"
msgid "A fancy couch. Too fancy for my muddy shoes."
msgstr "高级躺椅，配不上我沾满泥的鞋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2EMBROIDERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2EMBROIDERED"
msgid "Two lamps with frilly stuff. Very grandma."
msgstr "两盏带花边的灯，很有奶奶风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2FRINGES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2FRINGES"
msgid "Double fringe. Double the dusting."
msgstr "双条纹，掸灰也要双倍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2UPTURNS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_2UPTURNS"
msgid "Two lamps pointing up. Like they're surrendering."
msgstr "两盏灯朝上，像在举手投降。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ADJUSTABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ADJUSTABLE"
msgid "Adjustable lamp. For homework I won't do."
msgstr "可调灯，适合写我不会写的作业。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_BELLSHADE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_BELLSHADE"
msgid "Looks like a bell. Don't ring it."
msgstr "像个钟，别敲它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CANDELABRA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CANDELABRA"
msgid "Candles on a lamp. Very haunted house."
msgstr "灯上插蜡烛，很有鬼屋风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CERAMIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CERAMIC"
msgid "Ceramic. One swing and it's gone."
msgstr "陶瓷的，一棒就没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CRYSTALS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_CRYSTALS"
msgid "Sparkly. Probably costs more than my uniform."
msgstr "闪闪发光，大概比我的制服还贵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_DOWNBRIDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_DOWNBRIDGE"
msgid "Points down. Like my mood."
msgstr "往下照，就像我的心情。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_EDISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_EDISON"
msgid "Just a bare bulb. Put some clothes on it."
msgstr "光秃秃一个灯泡，给它穿件衣服吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ELIZABETHAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ELIZABETHAN"
msgid "Old and fancy. Like the principal's office."
msgstr "又老又讲究，像校长室。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_FRINGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_FRINGE"
msgid "Frilly lamp. Too cute for me."
msgstr "带流苏的灯，对我来说太可爱了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_GLASS"
msgid "Glass lamp. Don't let me near it."
msgstr "玻璃灯，别让我靠近，我会弄坏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_GOTHIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_GOTHIC"
msgid "Gothic lamp. Edgy. Approved."
msgstr "哥特灯，够酷，批准了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_HOOFSPA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_HOOFSPA"
msgid "A spa lamp. Smells like fancy soap."
msgstr "水疗店的灯，有股高级香皂味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ORB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_ORB"
msgid "A glowing ball. I wanna hit it out of the park."
msgstr "发光的球，好想一棒打出本垒打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_RIGHTANGLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_RIGHTANGLES"
msgid "All right angles. My math teacher would love it."
msgstr "全是直角，我数学老师肯定喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_SPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_SPOOL"
msgid "A thread spool lamp. Plain, like my lunch."
msgstr "线轴灯，朴素，跟我的午饭一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_STAINGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_STAINGLASS"
msgid "Colorful glass. Okay, that's pretty."
msgstr "彩色玻璃。好吧，是很好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_UPTURN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_LAMP_UPTURN"
msgid "Lamp facing up. Lighting the ceiling, I guess."
msgstr "朝上的灯，大概是在照天花板。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MARBLE"
msgid "A marble pillar that glows. Show-off."
msgstr "会发光的大理石柱，爱现。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MARBLE_CORNERBEAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MARBLE_CORNERBEAM"
msgid "Marble in the corners too. Rich pigs."
msgstr "连角落都是大理石，有钱的猪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MILLINERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_MILLINERY"
msgid "A pillar shaped like a hat stand. Kinda cute."
msgstr "像帽架一样的柱子，算是可爱吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BASIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BASIC"
msgid "Pot. Plant. Done."
msgstr "盆，植物，完事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BIRDCAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BIRDCAGE"
msgid "A plant in a birdcage. Did it try to fly away?"
msgstr "鸟笼里的植物，它想飞走吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BONSAI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_BONSAI"
msgid "Tiny tree. Someone spent years on that."
msgstr "小树，有人在它身上花了好几年。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_DISHGARDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_DISHGARDEN"
msgid "A garden in a dish. Can I eat it?"
msgstr "盘子里的花园，能吃吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_DRACEANA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_DRACEANA"
msgid "Spiky leaves. Looks like my bedhead."
msgstr "叶子刺刺的，像我睡醒的头发。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FANCY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FANCY"
msgid "Way too fancy. I'd knock it over."
msgstr "太讲究了，我会碰倒的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FERN"
msgid "A hanging fern. Mind your head."
msgstr "吊着的蕨，小心撞头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FERNSTAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_FERNSTAND"
msgid "A fern on a stand. Peak boring."
msgstr "架子上的蕨，无聊到顶点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_MARBLE"
msgid "A marble pot. Heavy. I could still lift it."
msgstr "大理石盆，很重，我还是举得起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_ORCHID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_ORCHID"
msgid "Orchids. Pretty and picky."
msgstr "兰花，好看又挑剔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PALM"
msgid "A tiny palm. Vacation vibes, zero vacation."
msgstr "小棕榈树，有度假感，没有假期。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PHILODENDRON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PHILODENDRON"
msgid "Big leaves. Good for fanning myself."
msgstr "叶子很大，适合拿来扇风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PITCHERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PITCHERS"
msgid "Pitcher plants. They eat bugs. Respect."
msgstr "猪笼草，会吃虫子，尊敬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PLANTPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_PLANTPET"
msgid "A plant you keep like a pet. No walks needed. Nice."
msgstr "当宠物养的植物，不用遛，好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_TERRARIUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_TERRARIUM"
msgid "A plant in a glass box. Plant jail."
msgstr "玻璃箱里的植物，植物监狱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_TRAPS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_TRAPS"
msgid "Snappy little plants. Keep your fingers out."
msgstr "会咬人的小植物，别把手指伸进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WINTERFEASTTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WINTERFEASTTREE"
msgid "A festive tree. Where are the presents?"
msgstr "节日树。礼物呢？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WINTERFEASTTREEOFSADNESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WINTERFEASTTREEOFSADNESS"
msgid "Saddest tree ever. Kinda relatable."
msgstr "史上最惨的树，有点能共情。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_WIP"
msgid "Not finished. Like my homework."
msgstr "没弄完，跟我的作业一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_XEROGRAPHICA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_XEROGRAPHICA"
msgid "Lives on air. Lazy plant. I respect that."
msgstr "靠空气就能活，懒惰的植物，我尊重它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_ZZ
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_PLANTHOLDER_ZZ"
msgid "A money tree. Doesn't grow any money. Scam."
msgstr "金钱树，又不会长钱，骗人的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_ROUND"
msgid "Round pillar. Good for leaning on."
msgstr "圆柱，适合靠着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_BEAM_ROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_BEAM_ROOM"
msgid "Old pillar. Don't knock it down. Probably."
msgstr "老柱子，别把它撞倒，大概吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_BEAM_ROOM_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_BEAM_ROOM_BLUE"
msgid "A blue pillar. Still just a pillar."
msgstr "蓝色的柱子，还是柱子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_ENDSWELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_ENDSWELL"
msgid "This well wants something. Not my lunch."
msgstr "这口井想要东西，反正不能是我的午饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_RUINS_FOUNTAIN"
msgid "A wishing well. I wish for a nap."
msgstr "许愿井。我许愿睡个午觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_BANKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_BANKER"
msgid "A serious desk. Makes me sleepy just looking at it."
msgstr "很正经的书桌，光看就想睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_CHESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_CHESS"
msgid "Chess. Way too much thinking."
msgstr "象棋，要动太多脑子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_CRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_CRATE"
msgid "A crate table. Cheap. Works."
msgstr "板条桌，便宜，能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_DIY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_DIY"
msgid "Homemade table. Wobbly, I bet."
msgstr "手工桌，肯定会晃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_RAW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_RAW"
msgid "Half a table. Someone gave up. Same."
msgstr "半张桌子。有人放弃了，我懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_ROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_TABLE_ROUND"
msgid "Round table. No head seat. Fair."
msgstr "圆桌，没有主位，公平。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_AXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_AXE"
msgid "An axe on the wall. Woodie would get jealous."
msgstr "墙上挂着斧头，伍迪会吃醋的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_BLACK_CAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_BLACK_CAT"
msgid "A black cat. Bad luck? I've had worse."
msgstr "黑猫。厄运？我遇过更糟的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_CAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_CAPE"
msgid "A cape on the wall. Who's the hero?"
msgstr "墙上挂着披风，谁是英雄啊？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_EMBROIDERY_HOOP"
msgid "Embroidery. I'd stab my finger in a second."
msgstr "刺绣，我一秒就会扎到手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_FULLLENGTH_MIRROR"
msgid "A mirror. Yep, still got bedhead."
msgstr "镜子。嗯，头发还是乱的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_GEARS_ART
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_GEARS_ART"
msgid "Gears as art. Winona would get it."
msgstr "齿轮当艺术品，薇诺娜应该懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_HUNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_HUNT"
msgid "Hunting stuff on the wall. Showing off much?"
msgstr "墙上挂打猎的东西，很爱炫嘛？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_MOSAIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_MOSAIC"
msgid "So many tiny tiles. My eyes hurt."
msgstr "一堆小瓷砖，看得眼睛痛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_NO_SMOKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_NO_SMOKING"
msgid "No smoking. I'm not a delinquent, okay?"
msgstr "禁止吸烟。我才不是不良少女好吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_PERIODIC_TABLE"
msgid "Periodic table. Chem class flashbacks."
msgstr "元素周期表。想起化学课了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_PHOTO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_PHOTO"
msgid "Who's the kid? Looks smug."
msgstr "那个小孩是谁？一脸得意。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_WREATH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WALLORNAMENT_WREATH"
msgid "A wreath. Cozy, I guess."
msgstr "花环，算温馨吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WOOD"
msgid "Wooden pillar. Sturdy enough."
msgstr "木柱，够结实。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WOOD_CORNERBEAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECO_WOOD_CORNERBEAM"
msgid "Wood in the corner, holding stuff up."
msgstr "角落里的木头，撑着东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEED"
msgid "A house deed. My own place. No curfew."
msgstr "房契。我自己的地方，没有门禁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEMOLITION_PERMIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEMOLITION_PERMIT"
msgid "Legal permission to smash stuff. Best paper ever."
msgstr "合法拆东西的许可。史上最棒的一张纸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISARMING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISARMING_KIT"
msgid "Tools for traps. Or I could just smash them."
msgstr "拆陷阱的工具。或者我直接砸掉也可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISGUISEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DISGUISEHAT"
msgid "A pig mask. Do I look piggy enough?"
msgstr "假猪面具。我看起来够像猪吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_NETTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_NETTLE"
msgid "A clump of nettles. Put it in the ground already."
msgstr "一簇荨麻，快种回地里吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBALL"
msgid "A ball of poop. Not touching it."
msgstr "一坨粪球，不碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.DEAD"
msgid "Rolled its last ball."
msgstr "滚完最后一颗球了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.GENERIC"
msgid "Rolls poop all day. And I thought my life was bad."
msgstr "整天滚粪球。我还以为我的人生已经够惨了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.SLEEPING"
msgid "Tired from rolling. I get it."
msgstr "滚累了，我懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.UNDUNGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGBEETLE.UNDUNGED"
msgid "Lost its ball. Now what, buddy?"
msgstr "球没了。现在怎么办，老兄？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGPILE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGPILE.GENERIC"
msgid "A pile of poop. Lovely."
msgstr "一堆粪。真美好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGPILE.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUNGPILE.PICKED"
msgid "Less poop. Still poop."
msgstr "粪少了，但还是粪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC"
msgid "Cloth. I could patch my skirt."
msgstr "布，可以补补我的裙子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_THUNDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_THUNDER"
msgid "This feather zaps. My hair's standing up."
msgstr "这根羽毛会电人，头发都竖起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEIJOADA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEIJOADA"
msgid "Beans and meat. Finally, real food."
msgstr "豆子加肉，终于有像样的饭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_RAINFOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_RAINFOREST"
msgid "A weird flower. Smells okay, I guess."
msgstr "奇怪的花，闻起来还算可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_POISON"
msgid "Poison frog legs. Hard pass."
msgstr "毒蛙腿，我不要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_POISON_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_POISON_COOKED"
msgid "Cooked. Still kinda scary to eat."
msgstr "熟了，但吃下去还是有点吓人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.DEAD"
msgid "Not hopping anymore."
msgstr "不会跳了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.GENERIC"
msgid "Bright colors mean don't touch. Got it."
msgstr "颜色这么鲜艳，意思是“别碰”。懂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG_POISON.SLEEPING"
msgid "A sleeping poison frog. Leave it be."
msgstr "睡着的毒蛙，别管它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASCLOUD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASCLOUD"
msgid "Nasty air. Hold my breath. Move."
msgstr "脏空气。憋气，快走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASMASKHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASMASKHAT"
msgid "A gas mask. Looks tough. I'm in."
msgstr "防毒面具，看起来很硬派，我要了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANTGRUB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIANTGRUB"
msgid "A giant grub. Absolutely not."
msgstr "巨型蛆虫。绝对不要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.DEAD"
msgid "The light went out."
msgstr "灯灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.GENERIC"
msgid "A bug with a lamp for a butt. Handy."
msgstr "屁股带灯的虫子，还蛮方便的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY.SLEEPING"
msgid "Dimmed for the night. Same."
msgstr "晚上调暗了，跟我一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY_COCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWFLY_COCOON"
msgid "Wrapped up like me in a blanket."
msgstr "包得跟裹着被子的我一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNAT"
msgid "Tiny bugs everywhere. Shoo!"
msgstr "到处都是小虫子。走开！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNATMOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNATMOUND"
msgid "A bug dirt pile. Kick it? No. Gross."
msgstr "虫子土堆。踢一脚？算了，恶心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE"
msgid "A gold machete. Flashy. Cuts the same."
msgstr "黄金砍刀，很浮夸，砍起来一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDPAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDPAN"
msgid "A pan for gold. Not for cooking. Sadly."
msgstr "淘金的盘子，不能做饭，可惜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLD_DUST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLD_DUST"
msgid "Gold dust. Tiny. Like my allowance."
msgstr "砂金，一点点，跟我的零用钱一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRABBING_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRABBING_VINE"
msgid "A vine that grabs. Hands off!"
msgstr "会抓人的藤，手拿开！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.BURNING"
msgid "Tall grass, tall fire."
msgstr "草长得高，火也烧得高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.GENERIC"
msgid "Too tough to pull. I need a blade."
msgstr "太硬了拔不动，得用刀。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_TALL.PICKED"
msgid "Cut it all. My arms are tired."
msgstr "全割完了，手好累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUMMY_CAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUMMY_CAKE"
msgid "Gummy cake. Sticky. Sweet. Yes."
msgstr "软糖蛋糕，黏，甜，好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALBERD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALBERD"
msgid "Long and pointy. Not my style, but fine."
msgstr "又长又尖。不是我的风格，但也可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANGING_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANGING_VINE"
msgid "Vines hanging down. Like a curtain nobody asked for."
msgstr "垂下来的藤，像没人要的门帘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARDSHELL_TACOS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARDSHELL_TACOS"
msgid "Crunchy shell. Don't tell me what's inside."
msgstr "脆壳，别告诉我里面是什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.BURNING"
msgid "The hedge is on fire. Wasn't me."
msgstr "树篱着火了，不是我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.BURNT"
msgid "Crispy hedge. The gardener's gonna cry."
msgstr "树篱烤焦了，园丁要哭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.GENERIC"
msgid "Neatly trimmed. Someone has way too much free time."
msgstr "修得整整齐齐，有人太闲了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.SHAVEABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE.SHAVEABLE"
msgid "Looks messy. Like my hair."
msgstr "看起来乱糟糟的，跟我的头发一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_BLOCK_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_BLOCK_ITEM"
msgid "A square hedge. Very rule-following."
msgstr "方形树篱，很守规矩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_CONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_CONE_ITEM"
msgid "A cone hedge. Like a party hat."
msgstr "锥形树篱，像派对帽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_LAYERED_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGE_LAYERED_ITEM"
msgid "Layered hedge. Plant it first, admire it later."
msgstr "多层树篱，先种下再欣赏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIPPOPOTAMOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIPPOPOTAMOOSE"
msgid "Hippo plus moose. Who approved this?"
msgstr "河马加驼鹿，谁批准的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIPPO_ANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIPPO_ANTLER"
msgid "A big antler. Heavy but useful."
msgstr "大角，很重，但有用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOGUSPORKUSATOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOGUSPORKUSATOR"
msgid "A pig science machine. Not my thing."
msgstr "猪人的科学机器，不是我的菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEDTEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEDTEA"
msgid "Iced tea. Cold. Sweet. Perfect."
msgstr "冰茶，冰的，甜的，完美。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INFUSED_IRON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INFUSED_IRON"
msgid "Iron with something weird in it. It tingles."
msgstr "加了怪东西的铁，摸起来麻麻的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_CHECK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_CHECK"
msgid "Checkered floor. A giant chessboard I'll never play."
msgstr "棋盘格地板，像一个我永远不会下的大棋盘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_GARDENSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_GARDENSTONE"
msgid "Stone floor. Cold on bare feet."
msgstr "石头地板，光脚踩很冰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_GEOMETRICTILES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_GEOMETRICTILES"
msgid "Shapes everywhere. Makes me dizzy."
msgstr "到处都是几何图形，看得我头晕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HERRINGBONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HERRINGBONE"
msgid "Zigzag floor. Fancy fish bones."
msgstr "锯齿形地板，高级鱼骨头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HEXAGON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HEXAGON"
msgid "Hexagons. Like a beehive with no honey."
msgstr "六边形，像没有蜂蜜的蜂巢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HOOF_CURVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_HOOF_CURVY"
msgid "Curvy hoof pattern. Very pig."
msgstr "弯弯的猪蹄花纹，很猪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_MARBLE"
msgid "Marble floor. Slippery when I'm sleepy."
msgstr "大理石地板，想睡的时候特别滑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_OCTAGON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_OCTAGON"
msgid "Octagons. Eight sides of boring."
msgstr "八角形，八条边的无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_PLAID_TILE"
msgid "Slate floor. Like a giant blackboard."
msgstr "石板地板，像一块大黑板。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_SHAG_CARPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_SHAG_CARPET"
msgid "Fluffy carpet. I could sleep right here."
msgstr "毛茸茸的地毯，我能直接躺这里睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_SHEET_METAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_SHEET_METAL"
msgid "Metal floor. Clanky footsteps."
msgstr "金属地板，走起来哐哐响。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_TRANSITIONAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_TRANSITIONAL"
msgid "Half one floor, half another. Can't decide? Me neither."
msgstr "一半这个一半那个，拿不定主意？我也是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_WOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_WOOD"
msgid "Wood floor. Creaks when I sneak out."
msgstr "木地板，偷溜的时候会吱吱响。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_WOODPANELS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_FLOOR_WOODPANELS"
msgid "Wood panels. Neat. Too neat."
msgstr "镶嵌木板，整齐，太整齐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_CHECKERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_CHECKERED"
msgid "Checkered wallpaper. Busy."
msgstr "格子墙纸，看久了眼花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_CIRCLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_CIRCLES"
msgid "Circles on the wall. Hypnotizing. Zzz."
msgstr "墙上的圆圈，盯久了想睡……呼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_FLORAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_FLORAL"
msgid "Flower wallpaper. Grandma's house vibes."
msgstr "碎花墙纸，奶奶家的感觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_FULLWALL_MOULDING"
msgid "A whole wall of moulding. Fancy squares."
msgstr "整面墙的造型，高级的方格子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_HARLEQUIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_HARLEQUIN"
msgid "Diamond pattern. Like a clown's pajamas."
msgstr "菱形图案，像小丑的睡衣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_MARBLE"
msgid "Marble walls. Cold and rich."
msgstr "大理石墙，又冷又有钱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_MAYORSOFFICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_MAYORSOFFICE"
msgid "Official-looking wall. Makes me want to skip class."
msgstr "很官方的墙，一看就想翘课。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PEAGAWK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PEAGAWK"
msgid "Eyes on the wallpaper. Stop staring."
msgstr "墙纸上全是眼睛，别盯着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PLAIN_DS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PLAIN_DS"
msgid "Orange wall. Loud color."
msgstr "橙色墙，颜色好吵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PLAIN_ROG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_PLAIN_ROG"
msgid "Purple wall. Kinda moody. I like it."
msgstr "紫色墙，有点忧郁，我喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_ROPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_ROPE"
msgid "Rope on the wall. All tied up nicely."
msgstr "墙上的麻绳，绑得很整齐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_SUNFLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_SUNFLOWER"
msgid "Sunflowers. Too cheerful for me."
msgstr "向日葵，对我来说太开朗了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_UPHOLSTERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_UPHOLSTERED"
msgid "A padded wall. Good for head-butting."
msgstr "软垫墙，适合拿头撞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_WOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INTERIOR_WALL_WOOD"
msgid "Wooden walls. Smells like a cabin."
msgstr "木板墙，有小木屋的味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRON"
msgid "Iron ore. Heavy. I'll carry it anyway."
msgstr "铁矿石，很重，反正我搬得动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRON_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRON_DOOR"
msgid "Iron bars on a door. Feels like detention."
msgstr "门上有铁栏杆，感觉像被关禁闭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBUG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBUG"
msgid "Bugs that look like beans. Do not trust."
msgstr "长得像豆子的虫，别信。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBUG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBUG_COOKED"
msgid "Cooked bugs. I'm not that hungry. ...Yet."
msgstr "熟虫子。我还没饿到那份上……暂时。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KEY_TO_CITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KEY_TO_CITY"
msgid "Key to the city. Do I get free lunch?"
msgstr "城镇之钥。能免费吃午饭吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.DEAD"
msgid "No more fishing for you."
msgstr "你不用再抓鱼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.GENERIC"
msgid "Pointy beak. Don't poke me."
msgstr "尖尖的嘴，别戳我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KINGFISHER.SLEEPING"
msgid "Dozing. Lucky bird."
msgstr "在打瞌睡，好命的鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL"
msgid "Lava. Nope. Not even I can punch that."
msgstr "岩浆。不行，连我都打不了它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.BURNING"
msgid "The decoration's on fire. Oh well."
msgstr "装饰着火了。算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.BURNT"
msgid "Burnt to a crisp. It was tacky anyway."
msgstr "烧焦了，反正本来就很俗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAWNORNAMENT.GENERIC"
msgid "Lawn decoration. It's begging for a swing."
msgstr "草坪装饰，好像在求我挥一棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIFEPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIFEPLANT"
msgid "A flower that loves itself. Must be nice."
msgstr "很爱自己的花，真好啊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LILYPAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LILYPAD"
msgid "A lily pad. Don't step on it, you'll sink."
msgstr "睡莲叶，别踩，会沉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVING_ARTIFACT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVING_ARTIFACT"
msgid "It's alive?! Okay, that's creepy."
msgstr "它是活的？！好吧，这很吓人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS"
msgid "Lotus plant. Pretty, for a pond thing."
msgstr "睡莲，以池塘里的东西来说算好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS_FLOWER"
msgid "A lotus flower. Smells nice."
msgstr "睡莲花，闻起来很香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS_FLOWER_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOTUS_FLOWER_COOKED"
msgid "Cooked lotus root. Crunchy. Not bad."
msgstr "熟莲藕，脆脆的，不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE"
msgid "A machete. For chopping anything in my way."
msgstr "砍刀，专砍挡路的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGNIFYING_GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGNIFYING_GLASS"
msgid "Magnifying glass. Detective mode. Kinda fun."
msgstr "放大镜，侦探模式，有点好玩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKEHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKEHOUSE"
msgid "A screamy hill. My ears already hurt."
msgstr "会尖叫的土丘，耳朵已经开始痛了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKEMAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKEMAN"
msgid "A big mandrake. Please don't scream."
msgstr "大曼德拉草，拜托别叫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.DEAD"
msgid "Wilted. Good riddance."
msgstr "蔫了，走好不送。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.GENERIC"
msgid "A baby plant with teeth. Already rude."
msgstr "长牙的小苗，已经很没礼貌了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAN_FLYTRAP.SLEEPING"
msgid "Sleep tight, biter."
msgstr "好好睡吧，咬人精。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATED_NETTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATED_NETTLE"
msgid "Meat wrapped in nettle. Spicy and meaty."
msgstr "荨麻裹肉，又辣又有肉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.METALPLATEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.METALPLATEHAT"
msgid "A tin helmet. My head's safe. My hair isn't."
msgstr "铁头盔，头安全了，发型没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NECTAR_POD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NECTAR_POD"
msgid "Nectar. Sweet. I wanna lick it."
msgstr "花蜜，甜的，想舔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.DEFAULT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.DEFAULT"
msgid "Nettle vine. Clears my nose in a second."
msgstr "荨麻藤，鼻子一下就通了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.EMPTY"
msgid "Picked clean. It'll grow back. Hopefully."
msgstr "摘光了，会再长的吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.MOIST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.MOIST"
msgid "Watered and happy. Lucky plant."
msgstr "浇过水，很开心，好命的植物。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLE.WITHERED"
msgid "It hates this dirt. Me too."
msgstr "它讨厌这土，我也是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLELOSANGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NETTLELOSANGE"
msgid "Nettle rolls. Tastes like medicine."
msgstr "荨麻卷，味道像药。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN"
msgid "Obsidian. Hot rock. Shiny."
msgstr "黑曜石，烫手的石头，亮亮的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC"
msgid "One oinc. Can't buy much. Still mine."
msgstr "一枚呼噜币，买不了什么，但是我的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC10
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC10"
msgid "Ten oincs! Snack money!"
msgstr "十元呼噜币！零食钱有了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC100
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC100"
msgid "A hundred! I'm rich. Lunch is on me. Maybe."
msgstr "一百！我发财了，午饭我请……大概。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORGANIC_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORGANIC_DOOR"
msgid "A door made of forest. It's looking at me."
msgstr "用森林做的门，它在看我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE"
msgid "It makes it rain. Why is it wet already?"
msgstr "能让天下雨的笛子，为什么已经湿了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN"
msgid "A horn. Snapped it right off."
msgstr "牛角，直接掰下来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANGOLDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANGOLDEN"
msgid "It poops gold. Best pet ever."
msgstr "会拉金子，最好的宠物。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.DEAD"
msgid "That parrot's done talking."
msgstr "这鹦鹉不会说话了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.GENERIC"
msgid "Blue parrot. Don't repeat what I say."
msgstr "蓝鹦鹉。别学我说话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_BLUE.SLEEPING"
msgid "Quiet for once. Nice."
msgstr "难得安静，不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.DEAD"
msgid "All those eyes, closed for good."
msgstr "那么多眼睛，全闭上了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.GENERIC"
msgid "That bush is staring. Wait, it's a bird!"
msgstr "那丛灌木在盯着我。等等，是只鸟！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK.SLEEPING"
msgid "Every eye is shut. Finally."
msgstr "每只眼睛都闭上了，总算。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWKFEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWKFEATHER"
msgid "The feather's still blinking. Stop it."
msgstr "羽毛还在眨眼，别眨了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK_BUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEAGAWK_BUSH"
msgid "A blinking bush. Totally normal. Not."
msgstr "会眨眼的灌木丛，很正常……才怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEDESTAL_KEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEDESTAL_KEY"
msgid "A royal key. Opens something fancy."
msgstr "皇家钥匙，能开什么高级东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHEROMONESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHEROMONESTONE"
msgid "A stone that talks to bugs. Through smell. Gross."
msgstr "能跟虫子说话的石头，用气味说。恶心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGBANDIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGBANDIT"
msgid "A masked pig. Hey! Give back my oincs!"
msgstr "蒙面猪人。喂！把我的呼噜币还来！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGCROWNHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGCROWNHAT"
msgid "A crown. Do I look like royalty? No."
msgstr "王冠。我看起来像王室吗？不像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.DEAD"
msgid "Stopped cooing."
msgstr "不咕咕叫了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.GENERIC"
msgid "A pigeon. Probably full of germs."
msgstr "鸽子，身上大概全是细菌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGEON.SLEEPING"
msgid "Asleep right on the ground. Gutsy."
msgstr "直接睡在地上，胆子真大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGHOST"
msgid "A pig ghost. ...Nope. Not real. Not looking."
msgstr "猪的幽灵……不，不是真的，我不看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_CITY.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_CITY.BURNING"
msgid "House fire! Somebody get water!"
msgstr "房子着火了！谁去拿水！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_CITY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_CITY.GENERIC"
msgid "A pig's town house. Nicer than my room."
msgstr "猪的城镇房屋，比我房间还好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_FARM.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_FARM.BURNING"
msgid "The farm's burning! Not good!"
msgstr "农场着火了！糟了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_FARM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_FARM.GENERIC"
msgid "A farmhouse. Quiet. Smells like hay."
msgstr "农场房屋，很安静，有干草味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_MINE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_MINE.BURNING"
msgid "The quarry house is on fire!"
msgstr "采石场住所着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_MINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE_MINE.GENERIC"
msgid "Miners live here. Strong folks. I respect that."
msgstr "矿工住这里，都是有力气的人，我尊重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BANKER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BANKER.GENERIC"
msgid "The money pig. Can I borrow some?"
msgstr "管钱的猪。能借我一点吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BANKER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BANKER.SLEEPING"
msgid "Sleeping on a pile of money, probably."
msgstr "大概睡在钱堆上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BEAUTICIAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BEAUTICIAN.GENERIC"
msgid "Beautician. Don't touch my hair."
msgstr "美容师。别碰我头发。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_BEAUTICIAN.SLEEPING"
msgid "Beauty sleep. Never worked for me."
msgstr "美容觉。对我从来没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_COLLECTOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_COLLECTOR.GENERIC"
msgid "He collects junk. Should I sell him my homework?"
msgstr "收破烂的。要不要把我的作业卖给他？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_COLLECTOR.SLEEPING"
msgid "Dreaming of rare junk."
msgstr "梦里都是稀有破烂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ERUDITE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ERUDITE.GENERIC"
msgid "Sells spooky stuff. Very mysterious. Very overpriced."
msgstr "卖诡异东西的，很神秘，也很贵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ERUDITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ERUDITE.SLEEPING"
msgid "Even the magic pig needs sleep."
msgstr "连会魔法的猪也要睡觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FARMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FARMER.GENERIC"
msgid "A farmer. Gets up early. Can't relate."
msgstr "农民，起得很早。我做不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FARMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FARMER.SLEEPING"
msgid "Finally sleeping in. Good for him."
msgstr "终于睡懒觉了，替他高兴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FLORIST.GENERIC"
msgid "The flower pig. Smells nice, at least."
msgstr "卖花的猪，至少闻起来很香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FLORIST.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_FLORIST.SLEEPING"
msgid "Asleep among the flowers. Cute."
msgstr "睡在花丛里，可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HATMAKER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HATMAKER.GENERIC"
msgid "Hat maker. Got anything that goes with a uniform?"
msgstr "帽匠。有配制服的帽子吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HATMAKER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HATMAKER.SLEEPING"
msgid "Sleeping with a hat on. Bold."
msgstr "戴着帽子睡觉，有胆量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HUNTER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HUNTER.GENERIC"
msgid "A hunter. Got anything better than my bat? Doubt it."
msgstr "猎人。有比我的球棒更好的吗？我不信。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HUNTER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_HUNTER.SLEEPING"
msgid "Even hunters nap."
msgstr "猎人也会打瞌睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MAYOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MAYOR.GENERIC"
msgid "The mayor. Looks like a student council president."
msgstr "镇长，看起来像学生会长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MAYOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MAYOR.SLEEPING"
msgid "Sleeping on the job. My kind of mayor."
msgstr "上班睡觉，我喜欢的那种镇长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MECHANIC.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MECHANIC.GENERIC"
msgid "A worker pig. Fixes the stuff I break."
msgstr "工人猪，修我弄坏的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MECHANIC.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MECHANIC.SLEEPING"
msgid "Taking a break. Earned it."
msgstr "在休息，应得的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MINER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MINER.GENERIC"
msgid "A miner. Strong arms. Respect."
msgstr "矿工，手臂很有力，尊敬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MINER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_MINER.SLEEPING"
msgid "Worn out from digging. Fair."
msgstr "挖累了，合理。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_PROFESSOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_PROFESSOR.GENERIC"
msgid "Old professor pig. Please don't lecture me."
msgstr "老教授猪。拜托别给我上课。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_PROFESSOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_PROFESSOR.SLEEPING"
msgid "Fell asleep mid-lecture. Ha. Relatable."
msgstr "讲课讲到一半睡着了。哈，我懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_QUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_QUEEN"
msgid "The pig queen. Bossy aura. Don't make eye contact."
msgstr "猪女王，气场很强势，别跟她对视。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD.GENERIC"
msgid "A guard. I didn't do anything. This time."
msgstr "守卫。我什么都没做。这次没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD.SLEEPING"
msgid "A sleeping guard. Great security."
msgstr "睡觉的守卫，真是好安保。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD_2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD_2.GENERIC"
msgid "Another guard. Feels like the school gate."
msgstr "又一个守卫，感觉像学校门口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD_2.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_ROYALGUARD_2.SLEEPING"
msgid "He's out cold. I won't snitch."
msgstr "睡死了，我不会告密的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_STOREOWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_STOREOWNER.GENERIC"
msgid "Shopkeep. Got a discount for broke students?"
msgstr "店主，有穷学生折扣吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_STOREOWNER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_STOREOWNER.SLEEPING"
msgid "Asleep at the counter. Free stuff? No. Bad idea."
msgstr "趴在柜台睡着了。免费拿？不行，坏主意。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_USHER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_USHER.GENERIC"
msgid "Loves sweets. We'd get along."
msgstr "爱吃甜食，我们合得来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_USHER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN_USHER.SLEEPING"
msgid "Sugar crash. Happens to the best of us."
msgstr "糖分耗尽了，常有的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_GUARD_TOWER.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_GUARD_TOWER.BURNING"
msgid "The tower's on fire! Not me!"
msgstr "塔着火了！不是我！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_GUARD_TOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_GUARD_TOWER.GENERIC"
msgid "A watch tower. They're watching me. Rude."
msgstr "瞭望塔，一直盯着我看，没礼貌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_PALACE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_PALACE"
msgid "A palace. Too shiny. I'd get lost in there."
msgstr "宫殿，太闪了，我会在里面迷路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ANT"
msgid "Some ant carving. Or a bug. Whatever."
msgstr "蚂蚁雕刻，或者是虫子，随便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ARTICHOKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ARTICHOKE"
msgid "Crumbly stone. One tap and it's dust."
msgstr "碎碎的石头，敲一下就成灰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_CREEPING_VINES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_CREEPING_VINES"
msgid "Vines everywhere. Machete time."
msgstr "到处都是藤，该用砍刀了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_DART_STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_DART_STATUE"
msgid "That statue's mouth has holes. Totally a trap."
msgstr "雕像嘴里有洞，肯定是陷阱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_DART_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_DART_TRAP"
msgid "Nice carving. Probably shoots stuff."
msgstr "好看的雕刻，大概会射东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE.GENERIC"
msgid "Ruins. Adventure. Ugh, fine."
msgstr "遗迹，冒险，唉，好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE.LOCKED"
msgid "Locked. I'll find a way. Or break one."
msgstr "锁着。我会找到办法的，或者砸出一条路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE2"
msgid "Where does it go? Somewhere dark, I bet."
msgstr "通到哪里？我猜是黑漆漆的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE3"
msgid "Another entrance. They really love doors here."
msgstr "又一个入口，这里的人真爱门。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE4"
msgid "Deeper we go. Should've brought snacks."
msgstr "越走越深，早该带零食的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE5"
msgid "More ruins. More stairs. More tired."
msgstr "更多遗迹，更多台阶，更累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_ENTRANCE_SMALL"
msgid "A small way in. I'll squeeze through."
msgstr "小入口，挤一挤能进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT"
msgid "The way out! Freedom!"
msgstr "出口！自由了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT2"
msgid "Exit. Thank goodness."
msgstr "出口，谢天谢地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_EXIT4"
msgid "Looks like the way out. Let's go."
msgstr "看起来是出去的路，走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_HEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_HEAD"
msgid "A big stone face. Looks as bored as I am."
msgstr "大石脸，看起来跟我一样无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_IDOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_IDOL"
msgid "Tempting idol. Totally a trap. Still want it."
msgstr "诱人的石像，肯定是陷阱，但还是想要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_MUSHROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_MUSHROOM"
msgid "A jeweled truffle. Can I eat it? No? Lame."
msgstr "宝石松露。能吃吗？不能？无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_PLAQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_PLAQUE"
msgid "Old totem. Some pig would pay for this."
msgstr "老图腾，会有猪人花钱买的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_PRESSURE_PLATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_PRESSURE_PLATE"
msgid "Suspicious stone. Not stepping on it."
msgstr "可疑的石头，不踩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SOW"
msgid "The blue sow. Looks expensive."
msgstr "蓝色母猪，看起来很贵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP"
msgid "Holes in the wall. Spears, probably."
msgstr "墙上的洞，大概会出矛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP_BROKEN"
msgid "Busted trap. Ha. Take that."
msgstr "坏掉的陷阱。哈，活该。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP_TRIGGERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_SPEAR_TRAP_TRIGGERED"
msgid "Spears out. Almost turned me into a kebab."
msgstr "矛都出来了，差点把我串成烤串。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_TORCH"
msgid "A broken brazier. Throw some wood in."
msgstr "破火盆，丢点木头进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_TORCH_WALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_RUINS_TORCH_WALL"
msgid "Wall brazier. Needs fuel."
msgstr "墙上的火盆，要加燃料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SCEPTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SCEPTER"
msgid "A scepter. Looks like a fancy bat."
msgstr "权杖，看起来像高级球棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ACADEMY.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ACADEMY.BURNING"
msgid "The academy's burning! ...I didn't do it, I swear."
msgstr "学会着火了！……发誓不是我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ACADEMY.GENERIC"
msgid "A museum. Feels like a school field trip."
msgstr "博物馆，感觉像学校组织的参观。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ANTIQUITIES.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ANTIQUITIES.BURNING"
msgid "The junk shop's on fire!"
msgstr "古董店着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ANTIQUITIES.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ANTIQUITIES.GENERIC"
msgid "Weird old stuff for sale. They buy junk too."
msgstr "卖奇怪老东西的店，还收破烂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ARCANE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ARCANE.BURNING"
msgid "Magic shop's burning! Even the fire sparkles!"
msgstr "魔法商店着火了！火都亮闪闪的！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ARCANE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_ARCANE.GENERIC"
msgid "Magic shop. Spooky stuff, spookier prices."
msgstr "魔法商店，东西诡异，价格更诡异。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_BANK.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_BANK.BURNING"
msgid "The money's burning!"
msgstr "钱烧起来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_BANK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_BANK.GENERIC"
msgid "The bank. Where money hides from me."
msgstr "银行，钱都躲在这里不让我找到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL.BURNING"
msgid "City hall's on fire. Not me. Really."
msgstr "市政厅着火了，不是我，真的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL.GENERIC"
msgid "City hall. Like the principal's office, but bigger."
msgstr "市政厅，像放大版的校长室。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.BURNING"
msgid "My city hall?! Who did this?!"
msgstr "我的市政厅？！谁干的？！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_CITYHALL_PLAYER.GENERIC"
msgid "My city hall. Rule one: naps are mandatory."
msgstr "我的市政厅。第一条规定：必须午睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_DELI.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_DELI.BURNING"
msgid "The deli's burning! My lunch!"
msgstr "熟食店着火了！我的午饭！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_DELI.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_DELI.GENERIC"
msgid "The deli. My favorite building in town."
msgstr "熟食店，镇上我最喜欢的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_FLORIST.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_FLORIST.BURNING"
msgid "Flowers on fire. What a waste."
msgstr "花着火了，好浪费。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_FLORIST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_FLORIST.GENERIC"
msgid "Flower shop. Way too pink for me."
msgstr "花店，对我来说太粉嫩了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_GENERAL.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_GENERAL.BURNING"
msgid "The general store's on fire!"
msgstr "杂货店着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_GENERAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_GENERAL.GENERIC"
msgid "General store. Snacks, I hope."
msgstr "杂货店，希望有零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HATSHOP.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HATSHOP.BURNING"
msgid "The hats are on fire! Hot hats!"
msgstr "帽子着火了！真够“火”的！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HATSHOP.GENERIC"
msgid "Hat shop. Maybe I'll find a cool cap."
msgstr "帽子店，说不定能找到酷一点的帽子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HOOFSPA.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HOOFSPA.BURNING"
msgid "The spa's burning! Hot mud everywhere!"
msgstr "水疗店着火了！到处是热泥浆！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_HOOFSPA.GENERIC"
msgid "A mud spa. Pigs pay to get muddy. Huh."
msgstr "泥浆水疗，猪花钱把自己弄脏。嗯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_PRODUCE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_PRODUCE.BURNING"
msgid "The food's burning! Not like this!"
msgstr "食物烧起来了！不该是这样的！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_PRODUCE.GENERIC"
msgid "Grocery store. Fresh food. Finally."
msgstr "食品店，新鲜食物，终于。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_TINKER.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_TINKER.BURNING"
msgid "The tinker tower's on fire. Science failed."
msgstr "发明塔着火了，科学失败了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_TINKER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_TINKER.GENERIC"
msgid "Gadgets and blueprints. Wilson would move in."
msgstr "满是小玩意和蓝图，威尔逊肯定想住进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_WEAPONS.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_WEAPONS.BURNING"
msgid "The weapon shop's on fire!"
msgstr "武器店着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_SHOP_WEAPONS.GENERIC"
msgid "Weapon shop. Do they sell bats?"
msgstr "武器店。有卖球棒吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.DEAD"
msgid "Sorry, little guy."
msgstr "对不起了，小家伙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.GENERIC"
msgid "A thieving squirrel. Hey! That's mine!"
msgstr "偷东西的松鼠。喂！那是我的！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO.SLEEPING"
msgid "Dreaming of stolen stuff, probably."
msgstr "大概梦见偷来的东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.DEAD"
msgid "Orange and still. Sorry."
msgstr "橙色的，不动了。对不起。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.GENERIC"
msgid "An orange one. Makes me want tea for some reason."
msgstr "橙色的，不知道为什么想喝茶了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIKO_ORANGE.SLEEPING"
msgid "Curled up in a ball. Kinda cute."
msgstr "蜷成一团，有点可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PILLAR_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PILLAR_DOOR"
msgid "A gothic door. Edgy. Bats behind it, I bet."
msgstr "哥特式大门，很酷，后面肯定有蝙蝠。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITHHAT"
msgid "Keeps the sun off. Looks dorky."
msgstr "能遮太阳，但看起来很呆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLATE_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLATE_DOOR"
msgid "Industrial door. Looks heavy. I'll manage."
msgstr "工业大门，看起来很重，我能行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.BURNT"
msgid "My house... burnt. Great."
msgstr "我的房子……烧了。真棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.FORSALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.FORSALE"
msgid "A slanty shanty for sale. Cheap, I hope."
msgstr "在卖的歪斜小木屋，希望便宜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.SOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYERHOUSE_CITY.SOLD"
msgid "My house. My rules. Nap time."
msgstr "我的房子，我说了算，午睡时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_BRICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_BRICK"
msgid "Brick home. Sturdy. Like me."
msgstr "砖房，结实，跟我一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_BRICK_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_BRICK_CRAFT"
msgid "Brick home kit. Some assembly required."
msgstr "砖房套件，需要自己组装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_COTTAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_COTTAGE"
msgid "A cottage. Small and cozy."
msgstr "小屋，小小的，很温馨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_COTTAGE_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_COTTAGE_CRAFT"
msgid "Cottage kit. Tiny house, tiny effort."
msgstr "小屋套件，小房子，小工程。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_GOTHIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_GOTHIC"
msgid "Gothic house. Dark and moody. Mine."
msgstr "哥特房子，又暗又忧郁，归我了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_GOTHIC_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_GOTHIC_CRAFT"
msgid "Gothic kit. Finally some style."
msgstr "哥特套件，终于有点品味了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_MANOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_MANOR"
msgid "A manor. Way too big to clean."
msgstr "庄园，太大了，打扫不过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_MANOR_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_MANOR_CRAFT"
msgid "Manor kit. I'll need a nap after building it."
msgstr "庄园套件，盖完得睡一觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TUDOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TUDOR"
msgid "Tudor house. Old-fashioned. Fine."
msgstr "都铎式房屋，很老派，还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TUDOR_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TUDOR_CRAFT"
msgid "Tudor kit. Straight out of a history textbook."
msgstr "都铎式套件，像从历史课本里走出来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TURRET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TURRET"
msgid "A house with a tower. I could nap at the top."
msgstr "带塔的房子，能在顶上午睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TURRET_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_TURRET_CRAFT"
msgid "Turret kit. My own little castle."
msgstr "角塔套件，我自己的小城堡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_VILLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_VILLA"
msgid "A villa. Fancy. Too fancy?"
msgstr "别墅，很高级，会不会太高级了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_VILLA_CRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOUSE_VILLA_CRAFT"
msgid "Villa kit. Living large."
msgstr "别墅套件，要过上好日子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.APORKALYPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.APORKALYPSE"
msgid "Whoa, what happened to you?!"
msgstr "哇，你怎么变成这样了？！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.FOLLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.FOLLOWER"
msgid "It's following me. Don't eat my snacks."
msgstr "它在跟着我。别吃我的零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.GENERIC"
msgid "Always hungry. Same, buddy."
msgstr "总是很饿。我也是，兄弟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POG.SLEEPING"
msgid "A sleeping pog. Don't wake it."
msgstr "睡着的哈巴狸，别吵醒它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM"
msgid "Poison balm. Smells bad. Works great."
msgstr "毒药膏，味道差，效果好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_BALLOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_BALLOON"
msgid "The balloon's dead. So is my ride home."
msgstr "气球瘪了，我回家的交通工具也没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_BASKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_BASKET"
msgid "A wicker basket. That's how I got here? Yikes."
msgstr "柳条篮。我就是坐这个过来的？天啊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_FLAGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_FLAGS"
msgid "Useless flags. Accurate name."
msgstr "没用的彩旗，名字很贴切。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_SANDBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_SANDBAG"
msgid "A bag of sand. Heavy and pointless."
msgstr "一大包沙子，又重又没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_SUITCASE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_SUITCASE"
msgid "Somebody's luggage. Not carrying it."
msgstr "别人的行李箱，我不帮忙提。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_TRUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORKLAND_INTRO_TRUNK"
msgid "Fancy initials on it. Not my bag."
msgstr "上面有花押字，不是我的包。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PROP_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PROP_DOOR"
msgid "A door. Wow. Thrilling."
msgstr "门。哇，好刺激。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK"
msgid "A giant snake-pig thing. Who made that?!"
msgstr "巨大的蛇猪怪，谁弄出来的？！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_CORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_CORPSE"
msgid "Bones turned to stone. Creepy."
msgstr "变成石头的骨头，瘆人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_FOUNTAIN"
msgid "Fountain of youth. I'm already young, though."
msgstr "不老泉。不过我本来就很年轻啊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_RUINS_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_RUINS_PILLAR"
msgid "This pillar's wobbly. One hit and down it goes."
msgstr "柱子摇摇晃晃，一棒就倒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_SKULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_SKULL"
msgid "A big skull. Nice trophy."
msgstr "大头骨，不错的战利品。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_TRAP_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUGALISK_TRAP_DOOR"
msgid "Ominous carving. Not stepping there."
msgstr "不祥的雕刻，不往那里走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.DEAD"
msgid "Not so crazy now."
msgstr "现在不疯了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.GENERIC"
msgid "That beetle's totally lost it."
msgstr "那只甲虫彻底疯掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABID_BEETLE.SLEEPING"
msgid "Even crazy bugs sleep."
msgstr "疯虫子也要睡觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH"
msgid "A radish. Crunchy. Spicy."
msgstr "水萝卜，脆，辣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_COOKED"
msgid "Cooked radish. Softer now."
msgstr "熟水萝卜，软多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_PLANTED"
msgid "Radish hiding in the dirt. I see you."
msgstr "藏在土里的萝卜，我看到你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RADISH_SEEDS"
msgid "Drip seeds. Plant and wait. Zzz."
msgstr "水滴状种子，种下去等……呼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.BURNING"
msgid "The tree's on fire! Back off!"
msgstr "树着火了！退后！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.BURNT"
msgid "Charcoal now."
msgstr "现在是木炭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.CHOPPED"
msgid "Stump. Done."
msgstr "树桩，完事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE.GENERIC"
msgid "A jungle tree. Huge and leafy."
msgstr "雨林树，又大又多叶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE_ROT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINFORESTTREE_ROT"
msgid "A sick tree. Stay back, it might be catching."
msgstr "生病的树，离远点，可能会传染。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECONSTRUCTION_PROJECT.RUBBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECONSTRUCTION_PROJECT.RUBBLE"
msgid "Rubble. Needs fixing. Not by me."
msgstr "一堆瓦砾，要修，但不是我修。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECONSTRUCTION_PROJECT.SCAFFOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECONSTRUCTION_PROJECT.SCAFFOLD"
msgid "Scaffolding. Almost done. Sort of."
msgstr "脚手架，快好了，算是吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS_WATER"
msgid "Reeds in the water. Good for pan flutes."
msgstr "水里的芦苇，能做排箫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_1.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_1.GENERIC"
msgid "A lost idol. Old and probably pricey."
msgstr "遗失的塑像，很旧，大概很值钱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_1.SUNKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_1.SUNKEN"
msgid "Something's sunk down there."
msgstr "那下面沉着东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_2.GENERIC"
msgid "An old totem. A museum would want it."
msgstr "老图腾，博物馆会想要的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_2.SUNKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_2.SUNKEN"
msgid "Covered in gunk. Underwater junk."
msgstr "沾满了泥，水底的破烂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_3.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_3.GENERIC"
msgid "A relic fragment. Kinda shiny."
msgstr "遗迹碎片，有点闪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_3.SUNKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_3.SUNKEN"
msgid "Gotta fish that out. Ugh."
msgstr "得把它捞上来。唉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_4.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_4.GENERIC"
msgid "The blue sow. Very royal. Very blue."
msgstr "蓝色母猪，很皇家，很蓝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_4.SUNKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_4.SUNKEN"
msgid "Something fancy underwater."
msgstr "水底有高级的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_5.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_5.GENERIC"
msgid "A jeweled truffle. Looks tasty. Isn't."
msgstr "宝石松露，看着好吃，其实不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_5.SUNKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC_5.SUNKEN"
msgid "Found something. Getting wet for it? Fine."
msgstr "找到东西了。要为它弄湿自己？好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ANTCAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ANTCAVE"
msgid "A stalagmite. Pointy rock."
msgstr "石笋，尖尖的石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_BASALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_BASALT"
msgid "Basalt. Too hard even for me."
msgstr "玄武岩，连我都敲不动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_FLIPPABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_FLIPPABLE"
msgid "A stone slab. Flip it. Something might be under there."
msgstr "小石板，翻过来，说不定下面有东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_HEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_HEAD"
msgid "A giant bird head. Friendly? Sure, why not."
msgstr "巨大的鸟头。友善？好吧，为什么不。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_LEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_LEG"
msgid "A giant leg. Don't step on me."
msgstr "巨大的腿，别踩我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BRANCH1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BRANCH1"
msgid "A weathered branch. Something big was here."
msgstr "风化的树枝，有大家伙来过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BRANCH2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BRANCH2"
msgid "Another branch. Nest stuff."
msgstr "又一根树枝，鸟巢的材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_BUSH"
msgid "A worn-out shrub. Same."
msgstr "累坏的灌木，我也是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS1"
msgid "Sticks. Lots of sticks."
msgstr "树枝，好多树枝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS2"
msgid "More sticks. Nest building is messy."
msgstr "更多树枝，筑巢真乱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS3"
msgid "Sticks stuck together. Like gum under a desk."
msgstr "粘在一起的树枝，像课桌底下的口香糖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_DEBRIS4"
msgid "Sticks again. I'm bored."
msgstr "又是树枝，无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG1"
msgid "Petrified egg. Can't fry this."
msgstr "石化的蛋，没法煎。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG2"
msgid "Another stone egg. What's inside?"
msgstr "又一个石头蛋，里面是什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG3"
msgid "Big egg. Now I'm nervous."
msgstr "好大的蛋，有点紧张了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_EGG4"
msgid "Cracked open. Something hatched."
msgstr "裂开了，有东西孵出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_HOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_HOUSE"
msgid "An old house. Hello? Anybody?"
msgstr "老房子。喂？有人吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_RUSTY_LAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_RUSTY_LAMP"
msgid "Rusty lamp. Busted."
msgstr "生锈的街灯，坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TREE1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TREE1"
msgid "Weathered tree. Still standing. Tough."
msgstr "风化的树，还站着，很硬气。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TREE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TREE2"
msgid "Another old tree. Looks tired."
msgstr "又一棵老树，看起来很累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TRUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_NEST_TRUNK"
msgid "A broken trunk. Something huge smashed it."
msgstr "断掉的树桩，被什么巨大的东西砸断了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_ROBIN_EGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_ROBIN_EGG"
msgid "Cold as a rock. Because it is one."
msgstr "冰得像石头。因为它就是石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_TAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROC_TAIL"
msgid "The tail. That's one big bird."
msgstr "尾巴。好大一只鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOTTRUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOTTRUNK"
msgid "Stuff goes in here, comes out somewhere else."
msgstr "东西放进去，从别的地方拿出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROUND_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROUND_DOOR"
msgid "Round doorway. Like walking into a mouth."
msgstr "圆形大门，像走进一张嘴里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROYAL_GALLERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROYAL_GALLERY"
msgid "Look, don't touch. My worst skill."
msgstr "只能看不能碰，我最不擅长了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RO_BIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RO_BIN"
msgid "Ro Bin. Carries my stuff. Best bird."
msgstr "露比，帮我搬东西，最棒的鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RO_BIN_GIZZARD_STONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RO_BIN_GIZZARD_STONE"
msgid "Ro Bin's stone. Kinda gross. Kinda important."
msgstr "露比的砂囊石，有点恶心，有点重要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_BEARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_BEARD"
msgid "A beard rug. Wilson's? Ew."
msgstr "胡须地毯。威尔逊的？呃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_BRAID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_BRAID"
msgid "Braided rug. Cozy."
msgstr "编织地毯，很舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_CATCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_CATCOON"
msgid "A catcoon rug. Poor guy."
msgstr "浣猫地毯，可怜的家伙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_CRIME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_CRIME"
msgid "A crime scene rug. Wasn't me."
msgstr "犯罪现场地毯，不是我干的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_FUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_FUR"
msgid "Fur rug. Soft. Nap-worthy."
msgstr "毛皮地毯，软软的，值得一睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_HEDGEHOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_HEDGEHOG"
msgid "Hedgehog rug. Don't step on it barefoot."
msgstr "刺猬地毯，别光脚踩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_HOOFPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_HOOFPRINT"
msgid "Hoofprints. A muddy pig, or decoration?"
msgstr "蹄印。泥巴猪踩的，还是装饰？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_METAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_METAL"
msgid "A metal rug. That's not how rugs work."
msgstr "金属地毯，地毯不是这么用的吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_NAILBED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_NAILBED"
msgid "Bed of nails. Not a nap spot."
msgstr "钉床，这个不能睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_OCTAGON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_OCTAGON"
msgid "Eight-sided rug. Sure."
msgstr "八边形地毯，好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_OVAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_OVAL"
msgid "Oval rug. It's fine."
msgstr "椭圆地毯，还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_PORCUPUSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_PORCUPUSS"
msgid "A platapine hide. Prickly to sit on."
msgstr "鸭嘴兽地毯，坐上去扎屁股。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_RECTANGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_RECTANGLE"
msgid "Big rug. Room to roll around."
msgstr "大地毯，够我滚来滚去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_ROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_ROUND"
msgid "An eye on the rug. Stop watching me."
msgstr "地毯上有只眼睛，别看我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_RUBBERMAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_RUBBERMAT"
msgid "Rubber mat. Like the gym floor."
msgstr "橡胶地毯，像体育馆的地板。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_SQUARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_SQUARE"
msgid "Square rug. Very square."
msgstr "方形地毯，很方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_SWIRL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_SWIRL"
msgid "Swirly. Like my brain in math class."
msgstr "转来转去，像我上数学课时的脑子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_TILES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_TILES"
msgid "A soccer rug. I'd rather play baseball."
msgstr "足球地毯。我宁愿打棒球。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_WEB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_WEB"
msgid "Web rug. Webber would like it."
msgstr "网状地毯，韦伯会喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_WORMHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUG_WORMHOLE"
msgid "A wormhole rug. Fake. I checked."
msgstr "虫洞地毯，假的，我试过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN"
msgid "Snakeskin sail. Strong and scaly."
msgstr "蛇皮帆，结实又有鳞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND"
msgid "Sand. It gets in my shoes. Everywhere."
msgstr "沙子，会进鞋子，到处都是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.DEAD"
msgid "Good. Stay down."
msgstr "很好，别再起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.GENERIC"
msgid "A scorpion. Pointy tail. Stay away."
msgstr "毒蝎，尾巴尖尖的，离远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORPION.SLEEPING"
msgid "Asleep. Smack it now?"
msgstr "睡着了。现在拍它？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITYCONTRACT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITYCONTRACT"
msgid "I can hire my own guard? Bodyguard. Cool."
msgstr "能雇自己的守卫？有保镖了，酷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEDIMENTPUDDLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEDIMENTPUDDLE"
msgid "Sparkly puddle. Gold in there, maybe."
msgstr "闪光的水坑，里面可能有金子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHEARS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHEARS"
msgid "Shears. Snip snip."
msgstr "剪刀，咔嚓咔嚓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_ADJUSTABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_ADJUSTABLE"
msgid "Adjustable shelf. For stuff."
msgstr "活动架，放东西的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_AFRAME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_AFRAME"
msgid "A-frame shelf. Shaped like a tent."
msgstr "A型架，像个帐篷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_BASIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_BASIC"
msgid "Bookshelf. I won't read any of those."
msgstr "书架，那些书我一本都不会看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_CINDERBLOCKS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_CINDERBLOCKS"
msgid "Cinderblock shelf. Very student dorm."
msgstr "砖砌书架，很有学生宿舍风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_CRATES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_CRATES"
msgid "Crate shelf. Cheap and it works."
msgstr "板条架，便宜好用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_FLOATING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_FLOATING"
msgid "Floating shelf. Magic? No, just nails."
msgstr "浮架，魔法？不，就是钉子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_FRIDGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_FRIDGE"
msgid "A fridge. Why is there no food in it?"
msgstr "冰箱，为什么里面没吃的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_GLASS"
msgid "Glass shelf. One bump and it's over."
msgstr "玻璃架，碰一下就完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HATTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HATTREE"
msgid "Hat tree. Hang my stuff."
msgstr "衣帽架，挂我的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HOOKS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HOOKS"
msgid "Hooks. Hang things. Done."
msgstr "挂钩，挂东西，完事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HUTCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_HUTCH"
msgid "A hutch. For storage. Thrilling."
msgstr "储物架，储物，真刺激。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_INDUSTRIAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_INDUSTRIAL"
msgid "Industrial shelf. Tough. I like tough."
msgstr "工业货架，很结实，我喜欢结实的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_LADDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_LADDER"
msgid "Ladder shelf. Don't climb it."
msgstr "梯架，别往上爬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_MARBLE"
msgid "Marble shelf. Rich-person storage."
msgstr "大理石架，有钱人的储物方式。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_METAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_METAL"
msgid "Metal shelf. Clanky."
msgstr "金属架，叮叮当当。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_MIDCENTURY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_MIDCENTURY"
msgid "A windowed cabinet. For showing off."
msgstr "玻璃柜，炫耀东西用的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_PALLET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_PALLET"
msgid "Pallet shelf. Needs sanding."
msgstr "托盘架，得打磨一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_PIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_PIPE"
msgid "Pipe shelf. Very factory."
msgstr "水管架，很工厂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_WALLMOUNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_WALLMOUNT"
msgid "Wall shelf. Up high. Out of reach."
msgstr "墙上置物架，太高了，够不着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_WOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELF_WOOD"
msgid "Carved bookshelf. Pretty. I still won't read."
msgstr "木刻书架，好看，但我还是不看书。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUGBUG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUGBUG"
msgid "A gummy slug. Looks like candy. Isn't."
msgstr "糖蛞蝓，看起来像糖，其实不是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUGBUG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLUGBUG_COOKED"
msgid "Cooked slug. I must be really hungry."
msgstr "熟蛞蝓。我肯定是饿疯了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMASHINGPOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMASHINGPOT"
msgid "A pot for smashing. Finally, my specialty."
msgstr "可以砸的瓦罐，终于轮到我的专长了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.BURNT"
msgid "The smelter burnt down. Ironic."
msgstr "炼钢炉烧坏了，真讽刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.COOKING_SHORT"
msgid "Still melting. I'll nap."
msgstr "还在熔，我先睡一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.DONE"
msgid "Done! Iron time."
msgstr "好了！拿铁咯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMELTER.EMPTY"
msgid "Empty smelter. Feed it some ore."
msgstr "空的炼钢炉，喂它点矿石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEBONESOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEBONESOUP"
msgid "Snake bone soup. Better than it sounds."
msgstr "蛇骨汤，比听起来好喝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL"
msgid "Snake oil. Pretty sure it's a scam."
msgstr "蛇油，我很确定是骗人的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN"
msgid "Snakeskin. Scaly and cool."
msgstr "蛇皮，有鳞片，很酷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT"
msgid "Snakeskin hat. Keeps the rain off my head."
msgstr "蛇皮帽，能挡雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_AMPHIBIOUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_AMPHIBIOUS"
msgid "A viper! Get lost!"
msgstr "蝰蛇！滚开！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_BONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_BONE"
msgid "Snake bone. A trophy."
msgstr "蛇骨，战利品。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.DEAD"
msgid "Down for good."
msgstr "彻底倒下了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.GENERIC"
msgid "A huge spider monkey. Nope nope nope."
msgstr "巨大的蜘蛛猴，不要不要不要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY.SLEEPING"
msgid "Sleeping. I'm tiptoeing."
msgstr "在睡觉，我踮着脚走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY_NEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY_NEST"
msgid "A webby nest. Not going in there."
msgstr "满是蛛网的窝，我不进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY_TREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MONKEY_TREE"
msgid "A web-covered tree. Creepy."
msgstr "布满蛛网的树，瘆人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPRINKLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPRINKLER"
msgid "A sprinkler. Free shower."
msgstr "洒水器，免费淋浴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEAMEDHAMSANDWICH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEAMEDHAMSANDWICH"
msgid "Steamed ham sandwich. Basically a burger."
msgstr "蒸火腿三明治，基本就是汉堡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_DOOR"
msgid "Stone archway. Solid."
msgstr "石拱门，很结实。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_RELIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_RELIC"
msgid "Something sank here. Fish it out?"
msgstr "这里沉着东西，捞上来吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT1"
msgid "A swinging light. Not very bright."
msgstr "摇摇晃晃的灯，不太亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_BASIC_BULB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_BASIC_BULB"
msgid "A bare bulb on a wire. Depressing."
msgstr "电线上吊着一个灯泡，看着好丧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_BASIC_METAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_BASIC_METAL"
msgid "Metal lamp. Does the job."
msgstr "金属电灯，能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_CHANDALIER_CANDLES"
msgid "A chandelier. Don't fall on me."
msgstr "吊灯，别掉下来砸我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_DERBY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_DERBY"
msgid "A hat lamp. Who hung a hat up there?"
msgstr "帽灯，谁把帽子挂上去的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_BLOOMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_BLOOMER"
msgid "Flower lamp. Pretty."
msgstr "花灯，好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_BULB"
msgid "Glass flower bulb. Delicate. Unlike me."
msgstr "玻璃花灯，很精致，跟我不一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_SCALLOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_FLORAL_SCALLOP"
msgid "Blooming lamp. Fancy."
msgstr "美丽花灯，很高级。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_PENDANT_CHERRIES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_PENDANT_CHERRIES"
msgid "Cherry lamp. Now I want cherries."
msgstr "樱桃灯，现在想吃樱桃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_ROPE_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_ROPE_1"
msgid "A rope light. Plain."
msgstr "绳索吊灯，很朴素。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_ROPE_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_ROPE_2"
msgid "Two rope lights. Double plain."
msgstr "两根绳索吊灯，双倍朴素。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_TOPHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWINGING_LIGHT_TOPHAT"
msgid "Top hat lamp. Is that Maxwell's?"
msgstr "高礼帽灯，是麦斯威尔的吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEA"
msgid "Tea. Warm. Calming. Zzz."
msgstr "茶，暖暖的，很安神……呼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE"
msgid "Tea tree. Smells nice."
msgstr "茶树，闻起来很香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT"
msgid "Seed pod. Stops sneezing, supposedly."
msgstr "茶籽，据说能止喷嚏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT_COOKED"
msgid "Cooked seed pod. Crunchy."
msgstr "熟茶籽，脆脆的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEATREE_NUT_SAPLING"
msgid "Tiny tea tree. Grow up already."
msgstr "小茶树，快点长大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERBIRD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERBIRD"
msgid "Thunderbird. Zappy. Don't touch."
msgstr "雷鸟，会放电，别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERBIRDNEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERBIRDNEST"
msgid "Thunder nest. Feathers everywhere."
msgstr "雷鸟巢，到处都是羽毛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THUNDERHAT"
msgid "Thunder hat. My hair's gonna be a mess."
msgstr "雷帽，我的头发要乱成一团了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPIARY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPIARY"
msgid "Trimmed with hooves. Impressive, honestly."
msgstr "用蹄子修出来的，说真的，很厉害。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN"
msgid "A toucan. Big beak. Bigger attitude."
msgstr "大嘴鸟，嘴大，脾气更大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET"
msgid "Trawl net. Drag it and see."
msgstr "拖网，拖着看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC"
msgid "Full of stuff. Let's see."
msgstr "装满东西了，看看是什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON"
msgid "It's sinking! Grab it!"
msgstr "要沉了！快抓住！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH"
msgid "Sinking slowly. Hurry up, me."
msgstr "慢慢沉了，我得快点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_PILLAR"
msgid "A huge stalk. Blocks out the whole sky."
msgstr "巨大的树干，把整片天都挡住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_1"
msgid "A little queen figure. Trade it?"
msgstr "女王小雕像，拿去换东西？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_3"
msgid "A postcard. \"Wish you were here.\" Nah."
msgstr "明信片。“希望你在这里。”才不要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_GIFTSHOP_4"
msgid "Silly string. Ooh, I could prank someone."
msgstr "喷彩摩丝，噢，能拿来整人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUSTY_SHOOTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUSTY_SHOOTER"
msgid "A pew-pew horn. Tiny. Cute. Dangerous."
msgstr "气枪喇叭，小，可爱，危险。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBERTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBERTREE"
msgid "Tuber tree. An axe won't do it. Need a blade."
msgstr "块茎树，斧头没用，得用刀。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_BLOOM_CROP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_BLOOM_CROP"
msgid "Blooming tuber. Pretty, for a potato."
msgstr "开花块茎，作为土豆算漂亮的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_BLOOM_CROP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_BLOOM_CROP_COOKED"
msgid "Fried with the flower on. Fancy fries."
msgstr "连花一起煎，高级薯条。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_CROP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_CROP"
msgid "A tuber. Poison? Maybe. Cook it."
msgstr "块茎，有毒？可能，煮熟再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_CROP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUBER_CROP_COOKED"
msgid "Fried tuber. Hope it's safe now."
msgstr "煎块茎，希望现在安全了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN"
msgid "Canned tuna. Where'd this come from? Don't care. Eating."
msgstr "金枪鱼罐头。哪来的？不管了，吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COBBLEROAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COBBLEROAD"
msgid "Paved road. Civilization."
msgstr "铺好的路，文明啊。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DEEPRAINFOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DEEPRAINFOREST"
msgid "Dense jungle turf. Dirt."
msgstr "茂密雨林地皮，土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DEEPRAINFOREST_NOCANOPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DEEPRAINFOREST_NOCANOPY"
msgid "Dense turf. Also dirt."
msgstr "茂密地皮，也是土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FIELDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FIELDS"
msgid "Field turf. Farm dirt."
msgstr "耕地地皮，农场的土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FOUNDATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FOUNDATION"
msgid "Flat stone. Good for building on."
msgstr "平整的石头，适合盖房子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_GASJUNGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_GASJUNGLE"
msgid "Toxic turf. Don't sniff it."
msgstr "毒性地皮，别闻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_LAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_LAWN"
msgid "Lawn turf. Neat grass."
msgstr "草坪地皮，整齐的草。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSS"
msgid "Mossy turf. Squishy."
msgstr "苔藓地皮，软乎乎的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PAINTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PAINTED"
msgid "Painted sand. Colorful dirt. Fancy."
msgstr "彩绘沙，彩色的土，很讲究。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PIGRUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PIGRUINS"
msgid "Ancient stone turf. An old floor."
msgstr "古代石地皮，老地板。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PLAINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PLAINS"
msgid "Plains turf. More dirt."
msgstr "平原地皮，又是土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RAINFOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RAINFOREST"
msgid "Rainforest turf. Dirt, again."
msgstr "雨林地皮，还是土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.DEAD"
msgid "Bat down. My bat wins."
msgstr "蝙蝠倒下了，还是球棒厉害。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.GENERIC"
msgid "A vampire bat. Keep your teeth off me."
msgstr "吸血蝙蝠，别用牙碰我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBAT.SLEEPING"
msgid "Sleeping upside down. Weird."
msgstr "倒挂着睡觉，好怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBATCAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIREBATCAVE"
msgid "Bats live in there. Nope."
msgstr "蝙蝠住在里面，不去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIRE_BAT_WING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAMPIRE_BAT_WING"
msgid "A bat wing. Still gross."
msgstr "蝙蝠翅膀，还是恶心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND"
msgid "Venom gland. Fight poison with poison."
msgstr "毒腺，以毒攻毒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENUS_STALK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENUS_STALK"
msgid "Flytrap stalk. Might be useful."
msgstr "捕蝇草根，可能有用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE"
msgid "A vine. Basically rope."
msgstr "藤蔓，基本就是绳子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGSTICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGSTICK"
msgid "A walking stick. I'm not old."
msgstr "手杖，我又不老。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLCRACK_RUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLCRACK_RUINS"
msgid "A suspicious crack. Hit it?"
msgstr "可疑的裂痕，敲一下？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_PIG_RUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_PIG_RUINS"
msgid "An old wall. Still standing."
msgstr "古墙，还立着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERDROP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERDROP"
msgid "Magic water. Drink it? Plant it?"
msgstr "魔力泉水，喝掉？还是种下去？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEEVOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEEVOLE"
msgid "A weevole. Tiny pest."
msgstr "象鼻鼠虫，小害虫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEEVOLE_CARAPACE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEEVOLE_CARAPACE"
msgid "Weevole shell. Light and tough."
msgstr "象鼻鼠虫壳，又轻又硬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHEELER_TRACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHEELER_TRACKER"
msgid "Wheeler's gadget. It points at stuff."
msgstr "薇勒尔的小玩意，会指方向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_GREENHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_GREENHOUSE"
msgid "Big greenhouse window. Lots of sun."
msgstr "温室大窗，阳光很多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_LARGE_SQUARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_LARGE_SQUARE"
msgid "Square window. For looking out of."
msgstr "方形窗户，往外看的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_LARGE_SQUARE_CURTAIN"
msgid "Curtains. Close them, I'm napping."
msgstr "有窗帘。拉上，我要睡觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND"
msgid "Round window. Like on a ship."
msgstr "圆窗，像船上的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND_BURLAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND_BURLAP"
msgid "Burlap curtain. Scratchy."
msgstr "麻布窗帘，粗粗的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND_CURTAINS_NAILS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_ROUND_CURTAINS_NAILS"
msgid "Curtains nailed on. Okay then."
msgstr "窗帘是钉上去的。行吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_SMALL_PEAKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_SMALL_PEAKED"
msgid "Peaked window. Pointy top."
msgstr "拱窗，顶是尖的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_SMALL_PEAKED_CURTAIN"
msgid "Sunlight through the curtain. Too bright."
msgstr "阳光透过窗帘照进来，太亮了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_TALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_TALL"
msgid "Tall window. Taller than me."
msgstr "高窗，比我还高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_TALL_CURTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDOW_TALL_CURTAIN"
msgid "Tall window with curtains. Fancy."
msgstr "带窗帘的高窗，很高级。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_DOOR"
msgid "Hardwood door. Knock knock."
msgstr "硬木门，咚咚。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1"
msgid "If it's still watertight, I'm keeping the patch."
msgstr "船还没漏，补丁我先留着。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2"
msgid "Show me a hole first. Then I'll get the kit."
msgstr "先让我看看哪儿破了，再去拿工具。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS.1"
msgid "The signal's stronger here. Let me take another look."
msgstr "这里的反应变强了。让我再看看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.CLOSETOSUCCESS.2"
msgid "Hold still. I think I found the right spot."
msgstr "先别动。我好像找对地方了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.GENERIC.1"
msgid "I can barely make out these marks. Where's the lens?"
msgstr "这些痕迹快看不清了。放大镜呢？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.GENERIC.2"
msgid "If I'm supposed to see something, somebody lend me a magnifying glass."
msgstr "要我看出点什么，就先借我个放大镜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE.1"
msgid "I'll check one more patch. Then I'm taking a break."
msgstr "我再查一块地方。查完就休息。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SEARCH_MYSTERY.SEARCHFORAWHILE.2"
msgid "Nothing yet. Stop standing in my light."
msgstr "还没找到。别挡我的光。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.CANTPAY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.CANTPAY.1"
msgid "How much? Give me a second to count what I've got."
msgstr "多少？等我数数手里有几个。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.CANTPAY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.CANTPAY.2"
msgid "Apparently looking broke doesn't get you a discount."
msgstr "看来穷得很明显也不给打折。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.GENERIC.1"
msgid "Fine. Put it back on the shelf."
msgstr "行吧，放回架子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.SHOP.GENERIC.2"
msgid "Guess I'm leaving with what I came in with."
msgstr "看来我进来时拿了什么，出去还拿着什么。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.GENERIC.1"
msgid "I pushed. I pulled. Your turn."
msgstr "推过了，拉过了。轮到你了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.GENERIC.2"
msgid "The handle won't budge. Guess we go around."
msgstr "把手扳不动。绕过去吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.LOCKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.LOCKED.1"
msgid "Locked. Who's got the key?"
msgstr "锁了。钥匙在谁那儿？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.LOCKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.USEDOOR.LOCKED.2"
msgid "I can wait for the key. For a little while."
msgstr "我可以等钥匙。只能等一会儿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_ALARMOVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_ALARMOVER.1"
msgid "They stopped chasing. Give me a second to breathe."
msgstr "他们没追了。让我喘口气。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_ALARMOVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_ALARMOVER.2"
msgid "Finally quiet. I'm sitting down before they change their minds."
msgstr "总算安静了。趁他们没改主意，我先坐一会儿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_BATS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_BATS.1"
msgid "Bats overhead. Keep an eye on the shadows."
msgstr "头顶有蝙蝠。留意地上的影子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_BATS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_BATS.2"
msgid "Here they come. I hate pitching to myself."
msgstr "来了。又得我自己追着打。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_OTHERWORLD_DEED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_OTHERWORLD_DEED.1"
msgid "This deed's for a house in another world. I checked."
msgstr "我看过了。这张地契上的房子在另一个世界。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_OTHERWORLD_DEED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_OTHERWORLD_DEED.2"
msgid "Wrong place. The deed won't help us find a bed here."
msgstr "地方不对。这张地契在这儿换不到床。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_UNDERLEAFCANOPY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_UNDERLEAFCANOPY.1"
msgid "Look how dark it gets under these leaves."
msgstr "树叶底下竟然这么暗。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_UNDERLEAFCANOPY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUCE_UNDERLEAFCANOPY.2"
msgid "I was hoping for shade. This'll do."
msgstr "我正想找地方遮阴。这里就行。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1"
msgid "I can see water through the crack. Get the kit."
msgstr "裂缝里渗水了。拿修船套件来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2"
msgid "The boat leaked before I touched it. Probably."
msgstr "这船在我碰到之前就在漏了。大概。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1"
msgid "My feet are wet. Tell me we're close to shore."
msgstr "我脚都湿了。离岸不远了吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2"
msgid "We're taking on water. I'll row if you bail."
msgstr "船在进水。你舀水，我来划。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1"
msgid "Get out! The boat's going under!"
msgstr "快离开！船要沉下去了！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2"
msgid "Leave the bags! We need dry ground, now!"
msgstr "包先别管了！马上找块干地！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_GAS_DAMAGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_GAS_DAMAGE.1"
msgid "I breathed it in! Get me out of here!"
msgstr "我吸进去了！快带我出去！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_GAS_DAMAGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_GAS_DAMAGE.2"
msgid "Fresh air. Now. I can't stop coughing."
msgstr "快去外面。我咳得停不下来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1"
msgid "Good thing I didn't wear a clean sleeve today."
msgstr "还好今天的袖子本来就不干净。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2"
msgid "I need nettles. And a tissue. Mostly a tissue."
msgstr "我得找荨麻。还得找纸巾。先找纸巾。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1"
msgid "I can finally get through a whole sentence."
msgstr "总算能一口气说完一句话了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2"
msgid "I can breathe through both sides again. About time."
msgstr "两边鼻子总算都通了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HOUSE_DOOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HOUSE_DOOR.1"
msgid "I even need permission for a door? Seriously?"
msgstr "加扇门也要许可？认真的？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HOUSE_DOOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_HOUSE_DOOR.2"
msgid "Hold that spot. Apparently I need the city's autograph first."
msgstr "地方先留着。我还得让市政厅先签个字。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_FOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_FOUND.1"
msgid "There was a door behind that wall the whole time?"
msgstr "墙后面一直有扇门？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_FOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_FOUND.2"
msgid "Hey, it opens. Want me to go first?"
msgstr "还真能开。要我先进去吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND.1"
msgid "Just more wall. I checked."
msgstr "还是墙。我确认过了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_DOOR_NOT_FOUND.2"
msgid "No door. I'm done tapping every brick."
msgstr "没门。我不想再一块块敲砖了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_FOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_FOUND.1"
msgid "Wait, I actually found something here."
msgstr "等等，这里真有东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_FOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_FOUND.2"
msgid "It's right here. Hold the light steady."
msgstr "就在这儿。灯拿稳点。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_NOREWARD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_NOREWARD.1"
msgid "Nothing to take home. Not even a snack."
msgstr "什么都带不回去，连吃的都没有。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_NOREWARD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MYSTERY_NOREWARD.2"
msgid "Fine. Next time somebody else does the digging."
msgstr "行吧。下次换个人挖。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NOTHING_FOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NOTHING_FOUND.1"
msgid "Nothing yet. Try moving it a little closer."
msgstr "没反应。再拿近点试试。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NOTHING_FOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_NOTHING_FOUND.2"
msgid "Still no signal. I must be looking in the wrong spot."
msgstr "还是没反应。我找的地方可能不对。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOM_STUCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOM_STUCK.1"
msgid "If I close this off, how am I getting out?"
msgstr "把这儿堵上，我怎么出去？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOM_STUCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_ROOM_STUCK.2"
msgid "I'll move things around after I leave myself a way out."
msgstr "先留条出路，再挪东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1"
msgid "Ah-CHOO! ... I need a tissue."
msgstr "阿嚏！……给我张纸巾。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2"
msgid "Hhh... Achoo! Fine, I felt that one coming."
msgstr "哈……阿嚏！好吧，我知道这下躲不过。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SUITUP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SUITUP.1"
msgid "It's on. How do I move in this thing?"
msgstr "穿上了。这身该怎么活动？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SUITUP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SUITUP.2"
msgid "Suit fits. Give me a minute to get used to it."
msgstr "大小合适。给我一点时间适应。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TAXDAY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TAXDAY.1"
msgid "Time to pick up the oincs. I can finally pay for lunch."
msgstr "该收呼噜币了。午饭总算有着落。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TAXDAY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TAXDAY.2"
msgid "Tax day? For once, getting called to the office pays."
msgstr "收税日？难得去趟办公室还能领钱。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOOLCORRODED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOOLCORRODED.1"
msgid "The handle's all that's left. Well, that's useless."
msgstr "就剩柄了。这下没法用了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOOLCORRODED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TOOLCORRODED.2"
msgid "It ate through the tool before I could put it away."
msgstr "还没来得及收起来，工具就被腐蚀了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FAR.1"
msgid "It's barely reacting out here. Keep walking."
msgstr "在这儿几乎没反应。继续走吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FAR.2"
msgid "Still too far. I'll check it again up ahead."
msgstr "还离得远。我往前走走再看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FOUND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FOUND.1"
msgid "It's got a direction now. Come on."
msgstr "现在有方向了。走吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FOUND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRACKER_FOUND.2"
msgid "Okay, I see where it's pointing. Stay close."
msgstr "好，我看见它指哪儿了。跟紧点。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TURFTOOHARD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TURFTOOHARD.1"
msgid "The ground won't budge. My wrists will, if I keep trying."
msgstr "地纹丝不动。再撬下去，先撑不住的是我的手腕。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TURFTOOHARD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TURFTOOHARD.2"
msgid "I need something stronger for this patch of ground."
msgstr "这块地得用更结实的家伙来挖。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1"
msgid "Hey, we caught the wave!"
msgstr "哇，赶上浪了！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2"
msgid "For once, getting soaked was worth it."
msgstr "难得淋湿一次还挺值。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.DEAD.1"
msgid "The snaptooth flytrap hasn't moved since we got here. I think we're fine."
msgstr "从我们过来到现在，利齿捕蝇草没动过。应该没事了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.DEAD.2"
msgid "The snaptooth flytrap won't be getting up again. Let's move on."
msgstr "利齿捕蝇草不会再起来了。走吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.GENERIC.1"
msgid "Let me get my bat before the snaptooth flytrap gets any ideas."
msgstr "趁利齿捕蝇草还没动静，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.GENERIC.2"
msgid "That's a snaptooth flytrap. Stay over there, thanks."
msgstr "是利齿捕蝇草。麻烦待在那边。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.SLEEPING.1"
msgid "Don't wake the snaptooth flytrap. We'll be gone in a minute."
msgstr "别吵醒利齿捕蝇草。我们一会儿就走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.SLEEPING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ADULT_FLYTRAP.SLEEPING.2"
msgid "Even the snaptooth flytrap found time to sleep. I should take notes."
msgstr "连利齿捕蝇草都能抽空睡觉。我该学学。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALLOY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALLOY.1"
msgid "If we have any more alloy, put it with this batch."
msgstr "还有合金的话，就放到这堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALLOY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALLOY.2"
msgid "Keep that alloy. I might need it later."
msgstr "合金先留着。晚点我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE.1"
msgid "Put the aloe where I can reach it. I'll be hungry later."
msgstr "芦荟放在我够得着的地方。晚点我会饿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE.2"
msgid "I'll try the aloe. Save me a bite."
msgstr "芦荟我想试试。给我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_COOKED.1"
msgid "Hand me the cooked aloe. I haven't eaten since we left."
msgstr "把熟芦荟递给我。出门以后我还没吃过东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_COOKED.2"
msgid "I had plans. Then somebody made cooked aloe."
msgstr "我原本还有事要做。现在有人做了熟芦荟。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_PLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_PLANTED.1"
msgid "I wonder what the aloe looks like after a good rain."
msgstr "不知道下场雨以后，芦荟会长成什么样。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_PLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_PLANTED.2"
msgid "If you're taking some aloe, leave a bit for later."
msgstr "要摘芦荟的话，留点下次再来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_SEEDS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_SEEDS.1"
msgid "Somebody mark where we plant the supple seed pods. I forget these things."
msgstr "种软籽荚的地方做个记号。过几天我就忘了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_SEEDS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ALOE_SEEDS.2"
msgid "I've got the supple seed pods. Now I need a patch of dirt and some patience."
msgstr "软籽荚有了。现在得找块地，还得有点耐心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HERALD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HERALD.1"
msgid "It announced itself. I wish it hadn't."
msgstr "它还专门通报了一声。真希望它没来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HERALD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HERALD.2"
msgid "Whatever that thing is saying, it's saying it too loud."
msgstr "不管它说什么，声音都太大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HULK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HULK.1"
msgid "How long has that machine been standing down here?"
msgstr "这台机器在下面站了多久？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HULK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_HULK.2"
msgid "It takes one step and the whole floor shakes. I wanna see it do that again."
msgstr "它走一步地板就抖一下。还想再看一次。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_REMNANT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_REMNANT.1"
msgid "Keep that dark tatters. I might need it later."
msgstr "暗影碎布先留着。晚点我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_REMNANT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_REMNANT.2"
msgid "I should make space in my bag for the dark tatters."
msgstr "我应该在包里给暗影碎布腾点位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY.1"
msgid "I want a closer look at the large iron hulk. Can you watch my back?"
msgstr "我想凑近看看大块废铁。帮我留意身后好吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOTS_ASSEMBLY.2"
msgid "Something about the large iron hulk makes me want to look at the floor before I step."
msgstr "看见大块废铁，我就觉得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_CLAW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_CLAW.1"
msgid "I've got the iron hulk. I hope the other pieces are nearby."
msgstr "废铁找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_CLAW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_CLAW.2"
msgid "This iron hulk came off something. Look for the rest of it."
msgstr "废铁是从什么上面拆下来的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_HEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_HEAD.1"
msgid "This iron hulk came off something. Look for the rest of it."
msgstr "废铁是从什么上面拆下来的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_HEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_HEAD.2"
msgid "I've got the iron hulk. I hope the other pieces are nearby."
msgstr "废铁找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_LEG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_LEG.1"
msgid "This iron hulk came off something. Look for the rest of it."
msgstr "废铁是从什么上面拆下来的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_LEG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_LEG.2"
msgid "I've got the iron hulk. I hope the other pieces are nearby."
msgstr "废铁找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_RIBS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_RIBS.1"
msgid "I'll hold on to the iron hulk till we figure out where it fits."
msgstr "废铁我先拿着，等弄清该装在哪儿再说。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_RIBS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANCIENT_ROBOT_RIBS.2"
msgid "I've got the iron hulk. I hope the other pieces are nearby."
msgstr "废铁找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCHEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCHEST.1"
msgid "I put something in the honey chest. Remind me to take it out later."
msgstr "我往蜜箱里放了东西。回头提醒我拿出来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCHEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCHEST.2"
msgid "I'm opening the honey chest. Let me know if I pick up anything that isn't mine."
msgstr "我开蜜箱看看。要是误拿了别人的东西，告诉我一声。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCOMBHOME.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCOMBHOME.1"
msgid "I could wait by the antcomb home, if we're stopping here."
msgstr "如果要在这里停一会儿，我可以在蚁巢旁边等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCOMBHOME.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTCOMBHOME.2"
msgid "That's the antcomb home. I wonder if anyone's inside."
msgstr "那是蚁巢。不知道里面有没有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTHILL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTHILL.1"
msgid "I can see the mant hill from here. Want to go look?"
msgstr "从这里能看见蚁人丘。要过去看看吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTHILL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTHILL.2"
msgid "That's the mant hill. I wonder if anyone's inside."
msgstr "那是蚁人丘。不知道里面有没有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.1"
msgid "I hope I don't need the anti venom. Bring it anyway."
msgstr "希望用不上抗毒血清。还是带上吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.2"
msgid "I'll keep the anti venom handy. I never know what I'll step on."
msgstr "抗毒血清得随身带着。谁知道我会踩到什么。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER.1"
msgid "One blow and the bird can hear me. I'll wait till we're outside."
msgstr "吹一下鸟就能听见。我还是等出门再吹。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER.2"
msgid "I get a whistle, the bird gets to come all the way over here. Fair deal for me."
msgstr "我吹个哨，鸟就得一路飞过来。对我倒是挺划算。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER_CORRUPTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER_CORRUPTED.1"
msgid "I don't like how that whistle sounds anymore."
msgstr "这哨子现在吹起来，我听着不舒服。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER_CORRUPTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTLER_CORRUPTED.2"
msgid "Something's changed in there. Keep it away from my mouth for now."
msgstr "里头有哪里变了。先别拿到我嘴边。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.DEAD.1"
msgid "The ant worker hasn't moved since we got here. I think we're fine."
msgstr "从我们过来到现在，蚁人没动过。应该没事了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.DEAD.2"
msgid "I think the ant worker is done. I'm still not putting my hand near it."
msgstr "蚁人应该已经死了。我还是不把手伸过去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.GENERIC.1"
msgid "I was having a quiet day till that ant worker showed up."
msgstr "那只蚁人来之前，我过得还挺清静。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.GENERIC.2"
msgid "Hey, ant worker. You don't have to come any closer."
msgstr "喂，蚁人。你待在那边就行。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.SLEEPING.1"
msgid "Even the ant worker found time to sleep. I should take notes."
msgstr "连蚁人都能抽空睡觉。我该学学。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.SLEEPING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN.SLEEPING.2"
msgid "Don't wake the ant worker. We'll be gone in a minute."
msgstr "别吵醒蚁人。我们一会儿就走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR.1"
msgid "Leave some room between us and that mant warrior."
msgstr "和那只蚁人战士保持点距离。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR.2"
msgid "Hey, mant warrior. You don't have to come any closer."
msgstr "喂，蚁人战士。你待在那边就行。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR_EGG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR_EGG.1"
msgid "How much mant warrior egg do we have now? I lost count."
msgstr "现在有多少蚁人战士卵了？我数乱了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR_EGG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMAN_WARRIOR_EGG.2"
msgid "If we have any more mant warrior egg, put it with this batch."
msgstr "还有蚁人战士卵的话，就放到这堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMASKHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMASKHAT.1"
msgid "How am I going to keep the mant mask from falling off?"
msgstr "我要怎么戴，蚁人面具才不会掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMASKHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTMASKHAT.2"
msgid "Think the mant mask goes with my uniform? I'm wearing it either way."
msgstr "蚁人面具配我的制服吗？反正我会戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN.1"
msgid "All those workers and she still has to yell."
msgstr "手下这么多，还得靠吼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN.2"
msgid "I don't want to find out what happens when the queen calls for help."
msgstr "我可不想见识蚁后喊帮手的样子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_CHAMBERS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_CHAMBERS.1"
msgid "The queen gets a whole chamber and I get the floor."
msgstr "蚁后有整间屋子，我只能坐地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_CHAMBERS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_CHAMBERS.2"
msgid "Quiet around the queen's room. I don't want a tour."
msgstr "经过蚁后的房间时小点声。我可不想被领进去参观。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_THRONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_THRONE.1"
msgid "I wonder if that seat is comfortable enough to be worth guarding."
msgstr "这座位到底有多舒服，值得专门守着吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_THRONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTQUEEN_THRONE.2"
msgid "I'll sit anywhere but there. I already know who it belongs to."
msgstr "我坐哪儿都行，就不坐那儿。我知道那是谁的位子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTSUIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTSUIT.1"
msgid "How much mant suit do we have now? I lost count."
msgstr "现在有多少蚁人盔甲了？我数乱了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTSUIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTSUIT.2"
msgid "Sort the mant suit out from the rest of the pile for me, will you?"
msgstr "能帮我把蚁人盔甲从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANT_CAVE_LANTERN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANT_CAVE_LANTERN.1"
msgid "I'm glad that lamp's here. I couldn't see where I was stepping."
msgstr "还好这里有盏灯。刚才连脚踩哪儿都看不见。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANT_CAVE_LANTERN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANT_CAVE_LANTERN.2"
msgid "Keep it lit. Down here I don't want to walk by feel."
msgstr "让灯亮着。在底下我不想摸黑走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.1"
msgid "It's keeping time. I'd rather not think about what for."
msgstr "还在走时。我不太想知道是给什么倒数。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.2"
msgid "If I could make the clock run slower, now would be a good time."
msgstr "这钟要是能调慢，现在正合适。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORVORTEXCLOAK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORVORTEXCLOAK.1"
msgid "I hope the vortex cloak is easier to take off than it is to put on."
msgstr "希望旋涡斗篷脱起来比穿起来容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORVORTEXCLOAK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORVORTEXCLOAK.2"
msgid "I'll try the vortex cloak, as long as I can still swing a bat."
msgstr "只要还能挥球棒，旋涡斗篷我就愿意穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.1"
msgid "If the tin suit fits over my uniform, I'll take it."
msgstr "铁罐甲能套在制服外面的话，我就穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.2"
msgid "Let me move around in the tin suit before we go anywhere."
msgstr "出发前，让我穿着铁罐甲活动一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.1"
msgid "Let me move around in the snakeskin jacket before we go anywhere."
msgstr "出发前，让我穿着蛇皮夹克活动一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.2"
msgid "I hope the snakeskin jacket is easier to take off than it is to put on."
msgstr "希望蛇皮夹克脱起来比穿起来容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.1"
msgid "Let me move around in the weevole mantle before we go anywhere."
msgstr "出发前，让我穿着象鼻鼠虫披风活动一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.2"
msgid "If the weevole mantle fits over my uniform, I'll take it."
msgstr "象鼻鼠虫披风能套在制服外面的话，我就穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.1"
msgid "I wonder what the asparagus looks like after a good rain."
msgstr "不知道下场雨以后，芦笋苗会长成什么样。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.2"
msgid "There's some asparagus growing here. Watch where you step."
msgstr "这里长着芦笋苗。走路当心脚下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPEIN_HAMMER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPEIN_HAMMER.1"
msgid "If you borrow my ball pein hammer, put it back where you found it."
msgstr "借我的圆头锤可以，用完放回原处。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPEIN_HAMMER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPEIN_HAMMER.2"
msgid "Somebody show me how the ball pein hammer works. Keep it short."
msgstr "谁给我演示一下圆头锤怎么用。简单说就行。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.1"
msgid "Sort the bamboo out from the rest of the pile for me, will you?"
msgstr "能帮我把竹子从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.2"
msgid "I'll carry the bamboo if somebody else carries the rest."
msgstr "其他东西谁拿一下，竹子我来带。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITHAT.1"
msgid "How am I going to keep the swashy hat from falling off?"
msgstr "我要怎么戴，鬼祟帽才不会掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITHAT.2"
msgid "I'll try the swashy hat on. Does it flatten my hair?"
msgstr "我戴一下鬼祟帽。会把头发压扁吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITMAP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITMAP.1"
msgid "I need the bandit stash map for this? Fine. Where do I sign?"
msgstr "这也要用到强盗藏匿地图？好吧，在哪儿签名？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITMAP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITMAP.2"
msgid "The bandit stash map goes in my bag. That way I only have to get it once."
msgstr "强盗藏匿地图放我包里。免得下次又要去拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITTREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITTREASURE.1"
msgid "I didn't expect to find a secret bandit camp here. Do you want it?"
msgstr "没想到这里会有强盗秘密营地。你想要吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITTREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDITTREASURE.2"
msgid "I'll put the secret bandit camp in my pocket. I can decide what to do with it later."
msgstr "强盗秘密营地先揣兜里。晚点再想怎么处理。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BASEFAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BASEFAN.1"
msgid "Give me the oscillating fan. Let me see how it feels to use it."
msgstr "把摆动风扇给我。我试试顺不顺手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BASEFAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BASEFAN.2"
msgid "Somebody show me how the oscillating fan works. Keep it short."
msgstr "谁给我演示一下摆动风扇怎么用。简单说就行。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BATHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BATHAT.1"
msgid "How am I going to keep the cowl from falling off?"
msgstr "我要怎么戴，蝙蝠兜帽才不会掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BATHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BATHAT.2"
msgid "The cowl can go on the hook when I get home."
msgstr "回家以后，蝙蝠兜帽可以挂到钩子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAT_HIDE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAT_HIDE.1"
msgid "I'll carry the bat hide if somebody else carries the rest."
msgstr "其他东西谁拿一下，蝙蝠皮我来带。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAT_HIDE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAT_HIDE.2"
msgid "Keep that bat hide. I might need it later."
msgstr "蝙蝠皮先留着。晚点我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.DEAD.1"
msgid "The platapine won't be getting up again. Let's move on."
msgstr "鸭嘴豪猪不会再起来了。走吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.DEAD.2"
msgid "I think the platapine is done. I'm still not putting my hand near it."
msgstr "鸭嘴豪猪应该已经死了。我还是不把手伸过去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.GENERIC.1"
msgid "That platapine is hard to keep track of."
msgstr "一转眼就找不到那只鸭嘴豪猪了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.GENERIC.2"
msgid "I'll leave the platapine alone if it leaves me alone."
msgstr "只要鸭嘴豪猪不来打扰我，我也不去打扰它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.SLEEPING.1"
msgid "Don't wake the platapine. We'll be gone in a minute."
msgstr "别吵醒鸭嘴豪猪。我们一会儿就走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.SLEEPING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL.SLEEPING.2"
msgid "Even the platapine found time to sleep. I should take notes."
msgstr "连鸭嘴豪猪都能抽空睡觉。我该学学。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL_QUILL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL_QUILL.1"
msgid "I should make space in my bag for the platapine quill."
msgstr "我应该在包里给鸭嘴豪猪刺腾点位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL_QUILL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BILL_QUILL.2"
msgid "Sort the platapine quill out from the rest of the pile for me, will you?"
msgstr "能帮我把鸭嘴豪猪刺从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUNDERBUSS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUNDERBUSS.1"
msgid "Stand back a little. I want to see what the blunderbuss can do."
msgstr "后退一点。我想看看喇叭型前膛枪好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUNDERBUSS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUNDERBUSS.2"
msgid "Let me get a feel for the blunderbuss before anything comes after us."
msgstr "趁还没东西追过来，让我先试试喇叭型前膛枪的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.1"
msgid "I can handle the boat repair kit. You keep the boat steady."
msgstr "修船套件交给我。你稳住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.2"
msgid "Put the boat repair kit where I can reach it from my seat."
msgstr "把修船套件放到我坐着也够得着的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.1"
msgid "I'll check the cargo boat before we leave the dock."
msgstr "离开码头前，我先检查一下货船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.2"
msgid "Put the cargo boat where I can reach it from my seat."
msgstr "把货船放到我坐着也够得着的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CORK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CORK.1"
msgid "Put the cork bowl canoe where I can reach it from my seat."
msgstr "把碗状软木舟放到我坐着也够得着的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CORK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CORK.2"
msgid "I can handle the cork bowl canoe. You keep the boat steady."
msgstr "碗状软木舟交给我。你稳住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1"
msgid "I can handle the log raft. You keep the boat steady."
msgstr "木筏交给我。你稳住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2"
msgid "Put the log raft where I can reach it from my seat."
msgstr "把木筏放到我坐着也够得着的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.1"
msgid "I'll check the row boat before we leave the dock."
msgstr "离开码头前，我先检查一下划艇。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.2"
msgid "I can handle the row boat. You keep the boat steady."
msgstr "划艇交给我。你稳住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.1"
msgid "If the boat torch comes loose at sea, I'm making you go get it."
msgstr "船载火炬要是在海上松脱了，我就让你去捞。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.2"
msgid "I can handle the boat torch. You keep the boat steady."
msgstr "船载火炬交给我。你稳住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BONESTAFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BONESTAFF.1"
msgid "Let me get a feel for the pugalisk wand before anything comes after us."
msgstr "趁还没东西追过来，让我先试试翘鼻蛇怪权杖的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BONESTAFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BONESTAFF.2"
msgid "Stand back a little. I want to see what the pugalisk wand can do."
msgstr "后退一点。我想看看翘鼻蛇怪权杖好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLESPIKE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLESPIKE.1"
msgid "Heads up. There's a brambles right here."
msgstr "当心，这儿就有荆棘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLESPIKE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLESPIKE.2"
msgid "I saw the brambles. Let me get a little farther away first."
msgstr "我看见荆棘了。先让我退远点。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_BULB.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_BULB.1"
msgid "Sort the bramble bulb out from the rest of the pile for me, will you?"
msgstr "能帮我把荆棘球茎从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_BULB.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_BULB.2"
msgid "Keep that bramble bulb. I might need it later."
msgstr "荆棘球茎先留着。晚点我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_CORE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_CORE.1"
msgid "Sort the bramble bloom out from the rest of the pile for me, will you?"
msgstr "能帮我把荆棘花从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_CORE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAMBLE_CORE.2"
msgid "I should make space in my bag for the bramble bloom."
msgstr "我应该在包里给荆棘花腾点位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGREPELLENT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGREPELLENT.1"
msgid "I hope I don't need the bug spray. Bring it anyway."
msgstr "希望用不上驱虫剂。还是带上吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGREPELLENT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUGREPELLENT.2"
msgid "I'll keep the bug spray handy. I never know what I'll step on."
msgstr "驱虫剂得随身带着。谁知道我会踩到什么。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR.1"
msgid "I'll carry the jungle burr if somebody else carries the rest."
msgstr "其他东西谁拿一下，雨林刺果我来带。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR.2"
msgid "I should make space in my bag for the jungle burr."
msgstr "我应该在包里给雨林刺果腾点位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR_SAPLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR_SAPLING.1"
msgid "Give the rainforest tree sapling room to take root. I don't want to move it twice."
msgstr "给雨林树苗留够扎根的地方。我可不想再挪一次。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR_SAPLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURR_SAPLING.2"
msgid "Come on, rainforest tree sapling. Grow before I forget where I put you."
msgstr "雨林树苗快长吧，免得我忘了种在哪儿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANDLEHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANDLEHAT.1"
msgid "Think the cork candle hat goes with my uniform? I'm wearing it either way."
msgstr "软木蜡烛帽配我的制服吗？反正我会戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANDLEHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CANDLEHAT.2"
msgid "How am I going to keep the cork candle hat from falling off?"
msgstr "我要怎么戴，软木蜡烛帽才不会掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_ROC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_ROC.1"
msgid "Something about the stone plug makes me want to look at the floor before I step."
msgstr "看见堵塞物，我就觉得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_ROC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVE_EXIT_ROC.2"
msgid "I want a closer look at the stone plug. Can you watch my back?"
msgstr "我想凑近看看堵塞物。帮我留意身后好吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHITIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHITIN.1"
msgid "I should make space in my bag for the chitin."
msgstr "我应该在包里给甲壳质腾点位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHITIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHITIN.2"
msgid "If we have any more chitin, put it with this batch."
msgstr "还有甲壳质的话，就放到这堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_HAMMER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_HAMMER.1"
msgid "If you borrow my executive hammer, put it back where you found it."
msgstr "借我的执行官锤可以，用完放回原处。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_HAMMER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_HAMMER.2"
msgid "I'll be careful with the executive hammer. Stop looking at me like that."
msgstr "我会小心用执行官锤。别那样看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.GENERIC.1"
msgid "A lamp post. Shame the light's off when I need it."
msgstr "路灯。偏偏在我要用的时候没亮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.GENERIC.2"
msgid "I can see the post just fine. The rest of the street could use some light."
msgstr "杆子倒是看得见。路上其他地方需要点光。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.ON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.ON.1"
msgid "I'll stand here by the lamp post till you catch up."
msgstr "我在路灯旁等你过来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.ON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CITY_LAMP.ON.2"
msgid "That light from the lamp post is just enough for me."
msgstr "路灯这点光倒是够我用了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE.1"
msgid "There's some claw palm tree growing here. Watch where you step."
msgstr "这里长着爪棕榈树。走路当心脚下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE.2"
msgid "I wonder what the claw palm tree looks like after a good rain."
msgstr "不知道下场雨以后，爪棕榈树会长成什么样。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE_SAPLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE_SAPLING.1"
msgid "Come on, claw palm sapling. Grow before I forget where I put you."
msgstr "爪棕榈树苗快长吧，免得我忘了种在哪儿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE_SAPLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLAWPALMTREE_SAPLING.2"
msgid "Give the claw palm sapling room to take root. I don't want to move it twice."
msgstr "给爪棕榈树苗留够扎根的地方。我可不想再挪一次。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLIPPINGS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLIPPINGS.1"
msgid "I'll carry the clippings if somebody else carries the rest."
msgstr "其他东西谁拿一下，碎叶我来带。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLIPPINGS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CLIPPINGS.2"
msgid "Sort the clippings out from the rest of the pile for me, will you?"
msgstr "能帮我把碎叶从这堆东西里挑出来吗？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.1"
msgid "Move! That fuse is already going!"
msgstr "快走开！引线已经点上了！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.2"
msgid "It's burning. I'm not hanging around to count the seconds."
msgstr "烧起来了。我可不留在这里数秒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.1"
msgid "Let me get a feel for the coconade before anything comes after us."
msgstr "趁还没东西追过来，让我先试试椰弹的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.2"
msgid "Stand back a little. I want to see what the coconade can do."
msgstr "后退一点。我想看看椰弹好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.1"
msgid "The smell alone's enough to get me out of bed."
msgstr "光闻到这个味道，我就愿意起床。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.2"
msgid "First coffee. Then whatever it is you just said."
msgstr "先喝咖啡。你刚才说的事待会儿再办。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1"
msgid "How much coffee beans do we have now? I lost count."
msgstr "现在有多少咖啡豆了？我数乱了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2"
msgid "If we have any more coffee beans, put it with this batch."
msgstr "还有咖啡豆的话，就放到这堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1"
msgid "Hand me the roasted coffee beans. I haven't eaten since we left."
msgstr "把烤咖啡豆递给我。出门以后我还没吃过东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2"
msgid "The roasted coffee beans smells good. I get the first bite, right?"
msgstr "烤咖啡豆闻起来不错。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI.1"
msgid "I could eat that plateau carp after a little time over a fire."
msgstr "高原鲤鱼上火烤一会儿，我就能吃了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI.2"
msgid "Leave the plateau carp out of the sun. We'll cook it when we stop."
msgstr "别把高原鲤鱼放在太阳底下。停下来再煮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI_COOKED.1"
msgid "Put the cooked plateau carp where I can reach it. I'll be hungry later."
msgstr "熟高原鲤鱼放在我够得着的地方。晚点我会饿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COI_COOKED.2"
msgid "The cooked plateau carp smells good. I get the first bite, right?"
msgstr "熟高原鲤鱼闻起来不错。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CONSTRUCTION_PERMIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CONSTRUCTION_PERMIT.1"
msgid "It took longer to get the house expansion permit than it will to use it."
msgstr "拿到房屋扩建许可证花的时间，比用它办事还长。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CONSTRUCTION_PERMIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CONSTRUCTION_PERMIT.2"
msgid "The house expansion permit goes in my bag. That way I only have to get it once."
msgstr "房屋扩建许可证放我包里。免得下次又要去拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK.1"
msgid "If we have any more cork, put it with this batch."
msgstr "还有软木的话，就放到这堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK.2"
msgid "Keep that cork. I might need it later."
msgstr "软木先留着。晚点我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORKCHEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORKCHEST.1"
msgid "I'm opening the cork barrel. Let me know if I pick up anything that isn't mine."
msgstr "我开软木桶看看。要是误拿了别人的东西，告诉我一声。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORKCHEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORKCHEST.2"
msgid "I put something in the cork barrel. Remind me to take it out later."
msgstr "我往软木桶里放了东西。回头提醒我拿出来。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK_BAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK_BAT.1"
msgid "Finally, a bat I can carry all day without wrecking my shoulder."
msgstr "总算有根背一天也不会肩膀酸的球棒了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK_BAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORK_BAT.2"
msgid "Made of cork. Feels odd, but my swing hasn't changed."
msgstr "软木做的，手感有点怪。挥起来倒没区别。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURTAIN_DOOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURTAIN_DOOR.1"
msgid "Leave the curtained door shut if you go out. I'm trying to keep it quiet in here."
msgstr "出去时把窗帘门关上。我想让这里安静一点。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURTAIN_DOOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CURTAIN_DOOR.2"
msgid "I'll go through the curtained door. Tell me if it's the wrong room."
msgstr "我从窗帘门进去。房间走错了就告诉我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.1"
msgid "Stand back a little. I want to see what the cutlass supreme can do."
msgstr "后退一点。我想看看剑鱼短剑好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.2"
msgid "Let me get a feel for the cutlass supreme before anything comes after us."
msgstr "趁还没东西追过来，让我先试试剑鱼短剑的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.1"
msgid "Pack the nettle where we can find it in a hurry."
msgstr "把荨麻放到急用时找得到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.2"
msgid "I'll keep the nettle handy. I never know what I'll step on."
msgstr "荨麻得随身带着。谁知道我会踩到什么。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_BEEFALO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_BEEFALO.1"
msgid "Whoever picked the beefalo mounting gets to dust it."
msgstr "谁挑的牦牛挂饰，以后谁来掸灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_BEEFALO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_BEEFALO.2"
msgid "Hang the beefalo mounting a little higher. My bat might catch it."
msgstr "牦牛挂饰挂高一点。我的球棒有可能碰到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_WALLFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_WALLFISH.1"
msgid "Hang the tasteful fish mounting a little higher. My bat might catch it."
msgstr "美味的鱼挂饰挂高一点。我的球棒有可能碰到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_WALLFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_ANTIQUITIES_WALLFISH.2"
msgid "Whoever picked the tasteful fish mounting gets to dust it."
msgstr "谁挑的美味的鱼挂饰，以后谁来掸灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BAT_BURROW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BAT_BURROW.1"
msgid "We can look at the spooky hole from here. That'll do."
msgstr "在这里看看毛骨悚然的洞就够了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BAT_BURROW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BAT_BURROW.2"
msgid "Don't stick your hand in the spooky hole. Something lives there."
msgstr "别把手伸进毛骨悚然的洞。里面住着东西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BEAM_ROOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BEAM_ROOM.1"
msgid "I could use the unimportant rock pillar. Where are we putting it?"
msgstr "不重要的岩柱能用得上。我们要放在哪儿？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BEAM_ROOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CAVE_BEAM_ROOM.2"
msgid "I'll dust the unimportant rock pillar when I've got nothing else to do."
msgstr "等我实在没事可做了，再给不重要的岩柱掸灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_BENCH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_BENCH.1"
msgid "Anyone using the bench? My legs need a break."
msgstr "有人坐长凳吗？我腿累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_BENCH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_BENCH.2"
msgid "I looked at the bench and forgot what I was about to do. Must be time to sit."
msgstr "看了眼长凳，我就把刚才要做什么给忘了。看来该坐会儿了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_CLASSIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DECO_CHAIR_CLASSIC.1"
