msgid ""
msgstr ""
"Language: zh-CN\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"POT Version: 2.0"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DEHUMID.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_DEHUMID.1"
msgid "Ahh...it's cooled down."
msgstr "啊...它在冷却了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEHUMID.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEHUMID.1.1"
msgid "I can finally breathe more easily."
msgstr "呼吸终于舒畅些了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEHUMID.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEHUMID.1.2"
msgid "My sleeves don't cling quite so much now."
msgstr "袖子总算没那么贴身了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER"
msgid "My sinuses are burning."
msgstr "我的鼻子在燃烧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.1"
msgid "My nose is itching again."
msgstr "鼻子又开始痒了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER.2"
msgid "Is there pollen on my collar?"
msgstr "我衣领上沾花粉了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER_OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_HAYFEVER_OFF"
msgid "Sniff! I feel better now!"
msgstr "嗅！我觉得好多了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.1"
msgid "There, a whole breath without sneezing."
msgstr "好了，总算能好好吸口气了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAYFEVER_OFF.2"
msgid "My eyes have stopped watering."
msgstr "眼睛不流泪了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.1"
msgid "Ick!"
msgstr "糟糕！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.1.1"
msgid "I'll need to wash my hands."
msgstr "得去洗洗手。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.1.2"
msgid "Oh, that smell."
msgstr "这气味……"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.2"
msgid "Gross!"
msgstr "好恶心！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.2.1"
msgid "Best get this over with."
msgstr "还是快点收拾完吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.2.2"
msgid "This had better help the garden."
msgstr "希望菜园用得上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_PICKPOOP.3"
msgid "Burn it all!!"
msgstr "全部烧掉吧！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.3.1"
msgid "Pass me a shovel next time."
msgstr "下次递我一把铲子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_PICKPOOP.3.2"
msgid "I'm keeping this away from my sleeves."
msgstr "别沾到袖子上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNEEZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_SNEEZE"
msgid "Achoo!!"
msgstr "啊嚏！！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.1"
msgid "Ah... achoo!"
msgstr "啊……阿嚏！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_SNEEZE.2"
msgid "Excuse me! Does anyone have a handkerchief?"
msgstr "失礼了！谁有手帕？"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOO_HUMID.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOO_HUMID.1"
msgid "It's burning hot. But not in a good way."
msgstr "它在燃烧。但不是以好的方式。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.1.1"
msgid "Even my collar is damp."
msgstr "连领口都潮了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.1.2"
msgid "This air is hard to breathe."
msgstr "空气闷得人喘不过气。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOO_HUMID.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_TOO_HUMID.2"
msgid "It's too hot."
msgstr "太热了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.2.1"
msgid "There's no breeze at all."
msgstr "一丝风也没有。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_TOO_HUMID.2.2"
msgid "I ought to find somewhere cooler."
msgstr "得找个凉快的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ALLOY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ALLOY"
msgid "Fire makes everything better."
msgstr "火可以让一切东西变得更好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALLOY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALLOY.1"
msgid "I can see where the metals flowed together."
msgstr "能看出几种金属熔在一起的纹路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALLOY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ALLOY.2"
msgid "I'll ask the smith what heat this takes."
msgstr "我去问问铁匠，这要烧到多少火候。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.APORKALYPSE_CLOCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.APORKALYPSE_CLOCK"
msgid "Looks ominous. I like it."
msgstr "看上去很不祥。我喜欢。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.1"
msgid "I don't think those rings are counting ordinary hours."
msgstr "那些圆环恐怕不是用来报时的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.APORKALYPSE_CLOCK.2"
msgid "I'd like to know what happens when the marks meet."
msgstr "我想知道刻线重合时会发生什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_METALPLATE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_METALPLATE"
msgid "I feel like a tin can."
msgstr "我感觉跟个铁罐子似的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.1"
msgid "I'd check the fit of the tin suit before I rely on it."
msgstr "得先试过铁罐甲合不合身，再指望它护着我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_METALPLATE.2"
msgid "I'll check the fastening twice."
msgstr "我得再检查一次搭扣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_WEEVOLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ARMOR_WEEVOLE"
msgid "This feels gross. I hope it works."
msgstr "感觉怪恶心的。希望它有用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.1"
msgid "I'd check the fit of the weevole mantle before I rely on it."
msgstr "得先试过象鼻鼠虫披风合不合身，再指望它护着我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ARMOR_WEEVOLE.2"
msgid "I'll have to set aside the weevole carapace if I make another."
msgstr "想再做一件，得多备些象鼻鼠虫壳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ASPARAGUS_PLANTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ASPARAGUS_PLANTED"
msgid "Haha! Found you!"
msgstr "哈哈！找到你了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.1"
msgid "I'd remember where that patch grows."
msgstr "我会记住这片植物长在哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ASPARAGUS_PLANTED.2"
msgid "I want to see how it grows in this soil."
msgstr "我想看看它在这片土里怎么长。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BASEFAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BASEFAN"
msgid "Fan the flames."
msgstr "煽风点火。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BASEFAN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BASEFAN.1"
msgid "I'd watch the oscillating fan at work before adjusting anything."
msgstr "调整以前，我想先看看摆动风扇怎么运作。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BASEFAN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.BASEFAN.2"
msgid "I'll listen for any loose parts before I try it."
msgstr "试之前先听听有没有零件松动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHITIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHITIN"
msgid "Bug skin."
msgstr "虫子的皮肤。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHITIN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHITIN.1"
msgid "I wonder what I could make with the chitin."
msgstr "不知甲壳质能做成什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHITIN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CHITIN.2"
msgid "The texture isn't what I expected."
msgstr "摸起来和我想的不一样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEE"
msgid "I suddenly feel motivated."
msgstr "我突然感觉有动力了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEE.1"
msgid "That smell alone has me sitting up straighter."
msgstr "光闻到香味，我就坐直了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEE.2"
msgid "A small cup before morning practice would be lovely."
msgstr "晨练前来一小杯就好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEEBEANS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEEBEANS"
msgid "These could use fire."
msgstr "这些用得上火。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1"
msgid "I'll grind these just before I brew them."
msgstr "要煮之前再磨。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2"
msgid "There's enough for a cup to share."
msgstr "够煮一杯，分着喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEEBEANS_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COFFEEBEANS_COOKED"
msgid "Ahhh, that aroma."
msgstr "啊，太香了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1"
msgid "I'll grind these just before I brew them."
msgstr "要煮之前再磨。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2"
msgid "There's enough for a cup to share."
msgstr "够煮一杯，分着喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTNETTLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTNETTLE"
msgid "It smells funny."
msgstr "闻起来怪怪的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.1"
msgid "I'll wrap these leaves instead of touching them again."
msgstr "这些叶子还是包好，别直接用手碰。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.CUTNETTLE.2"
msgid "That sharp green smell goes straight to my nose."
msgstr "这股青涩气味直往鼻子里钻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBALL"
msgid "Can't even set it on fire."
msgstr "烧都烧不了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBALL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBALL.1"
msgid "I wonder what the dung ball looked like when this place was new."
msgstr "不知道这里刚建成时，粪球是什么样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBALL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBALL.2"
msgid "I want to know why it's here in this particular spot."
msgstr "我想知道它为什么偏偏在这个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.DEAD"
msgid "Squashed."
msgstr "被碾碎了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.DEAD.1"
msgid "There's no breath left in it."
msgstr "已经没气息了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.DEAD.2"
msgid "I'll give it a quiet moment."
msgstr "让我安静陪它一会儿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.GENERIC"
msgid "Beat it, smelly beetle!"
msgstr "打它，臭虫子！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.GENERIC.1"
msgid "I can hear the dung beetle moving before I see it."
msgstr "还没见到屎壳郎就能听到它活动的声音。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.GENERIC.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.SLEEPING"
msgid "How do you sleep with that smell?"
msgstr "你睡觉时怎么能忍受这种臭味？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.SLEEPING.1"
msgid "Quiet footsteps near the dung beetle, please."
msgstr "经过屎壳郎时请放轻脚步。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.SLEEPING.2"
msgid "I'll come by again when it's awake."
msgstr "等它醒了我再过来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.UNDUNGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGBEETLE.UNDUNGED"
msgid "You better run."
msgstr "你最好逃跑。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.UNDUNGED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.UNDUNGED.1"
msgid "Where's the ball it was rolling?"
msgstr "它滚的那颗粪球呢？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.UNDUNGED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGBEETLE.UNDUNGED.2"
msgid "Its legs are free for the moment."
msgstr "它的几条腿这下空出来了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGPILE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGPILE.GENERIC"
msgid "Haha, that pile's huge!"
msgstr "哈哈，那可真大！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.GENERIC.1"
msgid "I'd like to see the dung pile in daylight."
msgstr "我想看看日光下的粪堆。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.GENERIC.2"
msgid "I want to know why it's here in this particular spot."
msgstr "我想知道它为什么偏偏在这个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGPILE.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DUNGPILE.PICKED"
msgid "What? I needed it."
msgstr "啥？我需要它。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.PICKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.PICKED.1"
msgid "There's nothing left to pick from the dung pile today."
msgstr "今天从粪堆上已经摘不到东西了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.PICKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.DUNGPILE.PICKED.2"
msgid "Best to leave the roots undisturbed now."
msgstr "这时候还是别动根了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_RAINFOREST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_RAINFOREST"
msgid "It's kinda ugly. But it burns."
msgstr "有点丑，但能烧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOWER_RAINFOREST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOWER_RAINFOREST.1"
msgid "I'd like to see how the exotic flower changes with the season."
msgstr "想看看换季时异域花朵会有什么变化。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOWER_RAINFOREST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.FLOWER_RAINFOREST.2"
msgid "I should mind where I step near the roots."
msgstr "在根边走，得留意脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.DEAD"
msgid "Squashed."
msgstr "被碾碎了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.DEAD.1"
msgid "I don't see any movement now."
msgstr "现在看不到动静了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.DEAD.2"
msgid "I wish there had been another way."
msgstr "真希望当时还有别的办法。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.GENERIC"
msgid "Looks slimy."
msgstr "看起来黏糊糊的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.GENERIC.1"
msgid "I'd give the glowfly a little room to pass."
msgstr "我给发光飞虫让一点路。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.GENERIC.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY.SLEEPING"
msgid "(Psst... you're gross.)"
msgstr "（小心...它很恶心。）"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.SLEEPING.1"
msgid "Quiet footsteps near the glowfly, please."
msgstr "经过发光飞虫时请放轻脚步。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY.SLEEPING.2"
msgid "I ought to move on before I wake it."
msgstr "我该在吵醒它之前离开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY_COCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWFLY_COCOON"
msgid "Doing a bad job of hiding from me."
msgstr "你没有藏好还是让我发现了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY_COCOON.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY_COCOON.1"
msgid "There's a tiny glow inside the wrapping."
msgstr "茧里透出一点微光。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY_COCOON.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GLOWFLY_COCOON.2"
msgid "I'd like to be here when the wings unfold."
msgstr "真想看看它展开翅膀的那一刻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENMACHETE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENMACHETE"
msgid "I don't want to scuff it up."
msgstr "我不想它被划伤。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.1"
msgid "I'd like to feel the balance of the luxury machete."
msgstr "我想掂一下黄金砍刀的重心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.2"
msgid "I can see where the gold nugget went into it."
msgstr "看得出哪里用上了金块。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDPAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDPAN"
msgid "You mean I have to do work?"
msgstr "你的意思是我必须得干活？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDPAN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDPAN.1"
msgid "I'd test the balance of the gold pan before putting it to work."
msgstr "我想先掂掂淘金盘的重心，再上手使用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDPAN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLDPAN.2"
msgid "I can see where the iron ore went into it."
msgstr "看得出哪里用上了铁矿石。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLD_DUST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLD_DUST"
msgid "It's probably not worth much."
msgstr "这可能不值得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLD_DUST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLD_DUST.1"
msgid "I'd like to know what Warly would serve with the gold dust."
msgstr "不知道沃利会给砂金配什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLD_DUST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GOLD_DUST.2"
msgid "I should save some for the gold nugget."
msgstr "我该给金块留一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRABBING_VINE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRABBING_VINE"
msgid "Ugh, vines!"
msgstr "啊，藤蔓！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRABBING_VINE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRABBING_VINE.1"
msgid "Where would I find the hanging vine after dark?"
msgstr "不知道垂下的藤蔓天黑以后会去哪里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRABBING_VINE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRABBING_VINE.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.BURNING"
msgid "I win."
msgstr "我赢了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.BURNING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.BURNING.1"
msgid "The fire's spreading over the tall grass!"
msgstr "火快把高草吞没了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.BURNING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.BURNING.2"
msgid "Quick, before the next thing catches!"
msgstr "快，别让旁边也着起来！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.GENERIC"
msgid "This grass is tough!"
msgstr "这草很强硬！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.GENERIC.1"
msgid "I wonder what the tall grass looked like when this place was new."
msgstr "不知道这里刚建成时，高草是什么样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.GENERIC.2"
msgid "I want to know why it's here in this particular spot."
msgstr "我想知道它为什么偏偏在这个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_TALL.PICKED"
msgid "Not tough enough!"
msgstr "还不够强硬！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.PICKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.PICKED.1"
msgid "We should give the tall grass time to grow back."
msgstr "得给高草些时间重新生长。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.PICKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.GRASS_TALL.PICKED.2"
msgid "Best to leave the roots undisturbed now."
msgstr "这时候还是别动根了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALBERD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALBERD"
msgid "Weapons are only good if they're twice your size."
msgstr "比你大两倍的武器才是好武器。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HALBERD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HALBERD.1"
msgid "I'll keep the halberd where it won't catch on my sleeve."
msgstr "我会把戟放在不勾袖口的位置。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HALBERD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HALBERD.2"
msgid "I'll need this if I decide to make the watch tower."
msgstr "要做瞭望塔，就得用到这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANGING_VINE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANGING_VINE"
msgid "Ugh, vines!"
msgstr "啊，藤蔓！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HANGING_VINE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HANGING_VINE.1"
msgid "I'd stop by the hanging vine again when we have more time."
msgstr "等我们有闲暇，我想再来看看垂下的藤蔓。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HANGING_VINE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.HANGING_VINE.2"
msgid "I can see a little more from the other side."
msgstr "从另一边还能多看到一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEDTEA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEDTEA"
msgid "I prefer hot things."
msgstr "我更喜欢热的东西"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEDTEA.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEDTEA.1"
msgid "I should ask how long to steep the iced tea."
msgstr "得问问冰茶泡多久合适。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEDTEA.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ICEDTEA.2"
msgid "I brought enough cups to share."
msgstr "我带的杯子够大家分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IRON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IRON"
msgid "I can't burn it with just my lighter."
msgstr "我的打火机点不着它。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.IRON.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.IRON.1"
msgid "Could we take the iron ore on the road with us?"
msgstr "路上能带着铁矿石吃吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.IRON.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.IRON.2"
msgid "I'll need this if I decide to make the magnifying glass."
msgstr "要做放大镜，就得用到这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MACHETE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MACHETE"
msgid "Or I could just burn my way through."
msgstr "或者我可以烧出一条路来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MACHETE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MACHETE.1"
msgid "I'd like to feel the balance of the machete."
msgstr "我想掂一下砍刀的重心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MACHETE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MACHETE.2"
msgid "I can see where the twigs went into it."
msgstr "看得出哪里用上了树枝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PANGOLDEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PANGOLDEN"
msgid "Yeesh, he's sucking up all the gold!"
msgstr "噫，他吸走了所有金子！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PANGOLDEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PANGOLDEN.1"
msgid "It's sifting the mud far more neatly than I could."
msgstr "它筛泥比我仔细多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PANGOLDEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PANGOLDEN.2"
msgid "I'll wait until its snout comes up for air."
msgstr "我等它把鼻子从泥里抬起来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.DEAD"
msgid "Very dead."
msgstr "死透了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.DEAD.1"
msgid "There's no breath left in it."
msgstr "已经没气息了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.DEAD.2"
msgid "I wish there had been another way."
msgstr "真希望当时还有别的办法。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.GENERIC"
msgid "Jeepers peepers!"
msgstr "窥视着一切！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.GENERIC.1"
msgid "I'd like to sketch the peagawk before it moves again."
msgstr "趁呆望雀没动，我想画下它的样子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.GENERIC.2"
msgid "Something made it turn just then."
msgstr "刚才好像有什么让它转了身。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK.SLEEPING"
msgid "I wonder what burning feathers smell like."
msgstr "我想知道它羽毛燃烧的味道。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.SLEEPING.1"
msgid "I'll let the peagawk sleep a little longer."
msgstr "让呆望雀再睡一会儿吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK.SLEEPING.2"
msgid "I ought to move on before I wake it."
msgstr "我该在吵醒它之前离开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWKFEATHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWKFEATHER"
msgid "Fancy feathers."
msgstr "漂亮的羽毛。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWKFEATHER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWKFEATHER.1"
msgid "I'd like to keep the peagawk plume between two dry pages."
msgstr "我想把呆望羽毛夹在两页干纸之间。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWKFEATHER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWKFEATHER.2"
msgid "It barely stirs the palm of my hand."
msgstr "落在手心，几乎感觉不到重量。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK_BUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PEAGAWK_BUSH"
msgid "A bush. I think."
msgstr "一株灌木丛，至少我觉得是。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK_BUSH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK_BUSH.1"
msgid "I'd like a drawing of the blinkbush for my notes."
msgstr "我想把眨眼的灌木丛的样子画进笔记。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK_BUSH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PEAGAWK_BUSH.2"
msgid "I should mind where I step near the roots."
msgstr "在根边走，得留意脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.DEAD"
msgid "Didn't run fast enough."
msgstr "还是跑得不够快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.DEAD.1"
msgid "Poor thing. It lies so still."
msgstr "可怜，一动也不动了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.DEAD.2"
msgid "It's over. We can lower our guard."
msgstr "结束了，可以放松些了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.GENERIC"
msgid "Squirrelly little guy."
msgstr "松鼠般的小家伙。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.GENERIC.1"
msgid "I'd like to sketch the piko before it moves again."
msgstr "趁异食松鼠没动，我想画下它的样子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.GENERIC.2"
msgid "Let's stay still and see what it does."
msgstr "先别动，看看它接下来做什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO.SLEEPING"
msgid "I bet I could catch it now."
msgstr "我打赌我现在可以抓到它。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.SLEEPING.1"
msgid "I'll let the piko sleep a little longer."
msgstr "让异食松鼠再睡一会儿吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO.SLEEPING.2"
msgid "I'll come by again when it's awake."
msgstr "等它醒了我再过来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.DEAD"
msgid "Didn't run fast enough."
msgstr "还是跑得不够快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.DEAD.1"
msgid "Poor thing. It lies so still."
msgstr "可怜，一动也不动了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.DEAD.2"
msgid "It's over. We can lower our guard."
msgstr "结束了，可以放松些了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.GENERIC"
msgid "Squirrelly little guy."
msgstr "松鼠般的小家伙。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.GENERIC.1"
msgid "What an unusual colour for such a little squirrel."
msgstr "这么小的松鼠，颜色还真少见。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.GENERIC.2"
msgid "I saw a flash of orange and then it was gone."
msgstr "眼前橙色一闪，它就没影了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PIKO_ORANGE.SLEEPING"
msgid "I bet I could catch it now."
msgstr "我打赌我现在可以抓到它。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.SLEEPING.1"
msgid "Shh. I can see the orange piko breathing."
msgstr "轻点，能看见橙色异食松鼠呼吸的起伏。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.PIKO_ORANGE.SLEEPING.2"
msgid "I'll come by again when it's awake."
msgstr "等它醒了我再过来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.DEAD"
msgid "Looks dead to me."
msgstr "死亡在看着我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.DEAD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.DEAD.1"
msgid "I don't see any movement now."
msgstr "现在看不到动静了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.DEAD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.DEAD.2"
msgid "It's over. We can lower our guard."
msgstr "结束了，可以放松些了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.GENERIC"
msgid "What're you so mad about?"
msgstr "什么事情让你这么火大？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.GENERIC.1"
msgid "I'll watch the rabid beetle without startling it."
msgstr "我尽量不惊动疯狂甲虫，看看它在做什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.GENERIC.2"
msgid "I'd like to know where it shelters."
msgstr "我想知道它在哪里歇脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABID_BEETLE.SLEEPING"
msgid "I should draw a mustache on its mustache while it sleeps."
msgstr "我应该在它睡觉的时候挂它的胡子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.SLEEPING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.SLEEPING.1"
msgid "Shh. I can see the rabid beetle breathing."
msgstr "轻点，能看见疯狂甲虫呼吸的起伏。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.SLEEPING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.RABID_BEETLE.SLEEPING.2"
msgid "I'll come by again when it's awake."
msgstr "等它醒了我再过来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SEDIMENTPUDDLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SEDIMENTPUDDLE"
msgid "Yeesh, there's a lot of sparkles in there."
msgstr "噫，那里面有很多闪光的东西。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.1"
msgid "I'll mark the sparkling pool on my map."
msgstr "我在图上标一下闪光的水坑。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.2"
msgid "Let's keep the way back in sight."
msgstr "先别走到看不见来路的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHEARS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHEARS"
msgid "Not as good as fire, but I guess it has its uses."
msgstr "不如火好，但我想它有它的用途。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHEARS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHEARS.1"
msgid "I'd test the balance of the shears before putting it to work."
msgstr "我想先掂掂剪刀的重心，再上手使用。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHEARS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SHEARS.2"
msgid "I'll have to set aside the iron ore if I make another."
msgstr "想再做一件，得多备些铁矿石。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.BURNT"
msgid "Okay, that's a liitle bit too far."
msgstr "好吧，这是有一点点过火了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.BURNT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.BURNT.1"
msgid "I wish I'd reached the smelter before the fire did."
msgstr "要是我能赶在起火前来到炼钢炉旁边就好了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.BURNT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.BURNT.2"
msgid "I'll come back when the embers cool."
msgstr "等余烬冷了我再来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.COOKING_SHORT"
msgid "The fire is doing its thing!"
msgstr "火的工作就快完成了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.COOKING_SHORT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.COOKING_SHORT.1"
msgid "I think the smelter is nearly finished."
msgstr "我看炼钢炉就快好了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.COOKING_SHORT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.COOKING_SHORT.2"
msgid "Just time to lay things out before it's done."
msgstr "趁还差那么一会儿，把东西摆好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.DONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.DONE"
msgid "When are we do this again?"
msgstr "我们什么时候再来一次？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.DONE.1"
msgid "I think the smelter is ready now."
msgstr "我看炼钢炉这边已经准备好了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.DONE.2"
msgid "I got here just in time."
msgstr "我来得正是时候。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SMELTER.EMPTY"
msgid "Oh yeah! Now I can burn metal."
msgstr "哦耶！现在我能烧金属了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.EMPTY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.EMPTY.1"
msgid "There's nothing in the smelter at the moment."
msgstr "炼钢炉里面什么也没有。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.EMPTY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.SMELTER.EMPTY.2"
msgid "I'll have to come back with something for it."
msgstr "下次得带点东西来放进去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEA"
msgid "Fire makes everything better."
msgstr "火可以让一切东西变得更好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEA.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEA.1"
msgid "I should ask how long to steep the tea."
msgstr "得问问茶泡多久合适。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEA.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEA.2"
msgid "I'll wait for the leaves to settle first."
msgstr "等茶叶沉下去再喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE"
msgid "It'll burn. That's all I care about."
msgstr "它能燃烧。我只关心这一点。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE.1"
msgid "I'd like to see how the tea tree changes with the season."
msgstr "想看看换季时茶树会有什么变化。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE.2"
msgid "I should mind where I step near the roots."
msgstr "在根边走，得留意脚下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT"
msgid "I'd burn it but it helps my allergies."
msgstr "我想烧了它，但是它对我的过敏很有帮助。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT.1"
msgid "I want to look at the seed pod in better light."
msgstr "我想在亮些的地方仔细看看茶籽。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT.2"
msgid "I'll take a closer look without pulling anything up."
msgstr "靠近点看就好，不必把它拔出来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT_COOKED"
msgid "I set it on fire so now I can eat it."
msgstr "我把它放进了火里了，现在我可以吃了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_COOKED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_COOKED.1"
msgid "Someone saved me a portion of the cooked seed pod."
msgstr "有人给我留了一份熟茶籽。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_COOKED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_COOKED.2"
msgid "I'll keep the last bit for the walk back."
msgstr "最后一点留给回程。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TEATREE_NUT_SAPLING"
msgid "It's not even worth burning."
msgstr "烧掉这个东西真浪费我的火。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_SAPLING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_SAPLING.1"
msgid "I know a patch of soil for the tea tree sapling."
msgstr "我知道有块地适合茶树苗。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_SAPLING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TEATREE_NUT_SAPLING.2"
msgid "A little earth around the roots should help."
msgstr "给根边培些土会好一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_PILLAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_PILLAR"
msgid "That's a big ol' tree."
msgstr "那是一棵巨大的古树。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_PILLAR.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_PILLAR.1"
msgid "I'd like a drawing of the great leafy stalk for my notes."
msgstr "我想把巨大树干的样子画进笔记。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_PILLAR.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.TREE_PILLAR.2"
msgid "I'd leave room for new growth."
msgstr "得留些地方让它长开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WEEVOLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WEEVOLE"
msgid "Stand still so I can burn you."
msgstr "站住，我要烧死你。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE.1"
msgid "Is that the usual gait for the weevole?"
msgstr "象鼻鼠虫平时也是这样活动的吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE.2"
msgid "I won't stand between it and its way home."
msgstr "我不想挡住它回去的路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WEEVOLE_CARAPACE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WEEVOLE_CARAPACE"
msgid "Ew."
msgstr "哦。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE_CARAPACE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE_CARAPACE.1"
msgid "I want to see whether I can turn freely in the weevole carapace."
msgstr "我想试试穿上象鼻鼠虫壳还能不能灵活转身。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE_CARAPACE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WEEVOLE_CARAPACE.2"
msgid "It has to leave my shoulders free."
msgstr "肩膀得活动得开。"
