msgstr "在閃。誰去拿淘金盤。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEDIMENTPUDDLE.2"
