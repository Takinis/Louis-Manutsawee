msgid ""
msgstr ""
"Language: zh-TW\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"POT Version: 2.0"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.EMBARK.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.EMBARK.INUSE"
msgid "Someone's still on it. I'll wait on dry land."
msgstr "船上還有人。我在岸上等。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ERASE_PAPER.FLOODED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ERASE_PAPER.FLOODED"
msgid "This paper's soaked. It'll tear if I rub it."
msgstr "紙濕透了，再擦就破了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.GENERIC.UNDERBOAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.GENERIC.UNDERBOAT"
msgid "My boat's right over it. I'll have to move."
msgstr "船就在上面。我得把船挪開。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.INSPECTBOAT.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.INSPECTBOAT.INUSE"
msgid "Someone's checking it already. Works for me."
msgstr "已經有人在檢查了。正好。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.BUSY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.BUSY"
msgid "Hold on. I can't leave in the middle of this."
msgstr "等等，手上的事還沒做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE"
msgid "Can't get through. Guess we're staying here."
msgstr "過不去。看來得留在這裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.FLOODED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.FLOODED"
msgid "I'm not setting my tools down in a puddle."
msgstr "我才不把工具放在水坑裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.OPEN_CRAFTING.SLEEPING"
msgid "Let me wake up first."
msgstr "等我睡醒再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.REPAIRBOAT.GENERIC"
msgid "The hull's fine. Save the kit."
msgstr "船底好好的，修船套件留著吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BERMUDA_FAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BERMUDA_FAIL"
msgid "I can't get through that thing. Figures."
msgstr "那東西過不去。我就知道。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_DAMAGED"
msgid "Hey, there's water coming through the hull."
msgstr "船底進水了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING"
msgid "The water's coming in faster. Start rowing."
msgstr "水進得更快了。開始劃！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_BOAT_SINKING_IMMINENT"
msgid "Forget the cargo! Get to land!"
msgstr "貨別管了！快上岸！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAB_ESCAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAB_ESCAPE"
msgid "It slipped into the sand. Cheap move."
msgstr "鑽進沙裡了。真會躲。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.1"
msgid "The ink's washed off. I can't read a word."
msgstr "墨都泡開了，一個字也看不清。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.2"
msgid "All I got out of that bottle was wet paper."
msgstr "瓶子裡就剩一張濕紙。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IA_MESSAGEBOTTLE.3"
msgid "These words are gone. Next time, use a better cork."
msgstr "字都沒了。下次換個結實點的瓶塞。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAGIC_FAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAGIC_FAIL"
msgid "Well, that didn't work here."
msgstr "在這裡用不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_LOSECONTROL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_LOSECONTROL"
msgid "I can't tell which way we're drifting anymore."
msgstr "我看不出船往哪邊漂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_RETURN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_RETURN"
msgid "Out of the fog. Let me see where we ended up."
msgstr "出霧了。看看漂到哪裡了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_WARN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAPWRAP_WARN"
msgid "That's a lot of fog. I can barely see the bow."
msgstr "霧真大，連船頭都快看不見了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MORETREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MORETREASURE"
msgid "There's more? All right, pass the shovel back."
msgstr "還有？行，把鏟子還我。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_PLANT"
msgid "Wrong soil. Find somewhere better for it."
msgstr "土不合適，給它換塊地吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_TREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTHER_WORLD_TREASURE"
msgid "Wrong waters. That map isn't much use here."
msgstr "海域不對，這張圖在這裡用不上。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHARX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHARX"
msgid "Something's chasing the boat. Keep rowing."
msgstr "有東西追著船。繼續劃。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAWL_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAWL_FULL"
msgid "Net's full. Help me pull it in."
msgstr "網滿了。來幫我拉一把。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE"
msgid "X marks it. All that's left is digging."
msgstr "標記就在這裡。剩下的就是挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE_DISCOVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TREASURE_DISCOVER"
msgid "Found it. Finally, something worth digging up."
msgstr "找到了。總算挖出點值得的東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VOLCANO_ERUPT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VOLCANO_ERUPT"
msgid "The volcano's going off! Look up!"
msgstr "火山噴發了！注意頭頂！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WAVE_BOOST"
msgid "Whoa! That was faster than rowing."
msgstr "哇！這可比劃船快多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY"
msgid "Those bubbles are getting bigger. We're close."
msgstr "氣泡越來越大了。就在附近。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL"
msgid "Bubbles stopped. There goes the trail."
msgstr "氣泡沒了，線索也斷了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING"
msgid "The swell washed out the trail."
msgstr "浪太大，把蹤跡衝沒了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AERODYNAMICHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AERODYNAMICHAT"
msgid "With the wind in my face, I might finally wake up."
msgstr "風迎面一吹，我說不定終於能醒了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTIVENOM"
msgid "I'd rather wince at the taste than at the bite."
msgstr "難喝就難喝，總比傷口疼好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORCACTUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORCACTUS"
msgid "Can somebody help me get into this without bleeding?"
msgstr "誰來幫我穿一下？別讓我扎出血就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORLIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORLIMESTONE"
msgid "A suit made of rock. Getting into it counts as weights."
msgstr "用岩石做的衣服。光穿上就算練負重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOROBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOROBSIDIAN"
msgid "This stuff gets hot when I fight. I'll watch my sleeves."
msgstr "打起架來這身會發燙。我得留意袖子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSEASHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSEASHELL"
msgid "If these shells crack, at least it won't be my ribs."
msgstr "貝殼裂就裂吧。至少裂的不是我的肋骨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LIFEJACKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LIFEJACKET"
msgid "I'll wear it. Nobody needs to see how I swim."
msgstr "我穿上。省得你們看見我怎麼游泳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SNAKESKIN"
msgid "Good jacket. I'd have picked another pattern."
msgstr "夾克不錯。花紋我會挑別的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WINDBREAKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_WINDBREAKER"
msgid "Maybe now I can walk across the beach without fixing my hair every ten steps."
msgstr "這下過沙灘，不用每走十步就理一次頭髮了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYOX"
msgid "It's got little horns already. I wonder how they'll turn out."
msgstr "這麼小就長角了。不知道長大是什麼樣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHIN"
msgid "How do they jump that high without a running start?"
msgstr "都不用助跑，怎麼能跳那麼高？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHINHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLPHINHOUSE"
msgid "The ballphins get a palace. I get wet socks."
msgstr "海豚住宮殿，我只能穿濕襪子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOO"
msgid "Light enough to carry. Long enough to hit the doorframe."
msgstr "拿著不重，進門倒是肯定會撞門框。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNING"
msgid "The bamboo patch caught fire. Somebody get water!"
msgstr "竹叢著火了！誰去拿點水！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.BURNT"
msgid "The bamboo patch is pretty much ash now. Leave it to cool."
msgstr "竹叢燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.CHOPPED"
msgid "The bamboo patch is cut back. My arms can rest now."
msgstr "竹叢砍完了。胳膊可以休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAMBOOTREE.GENERIC"
msgid "I'll cut a few stalks. Stop me if I start clearing the whole patch."
msgstr "我砍幾根。要是砍得停不下來，你提醒我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_POISON"
msgid "Good. A bandage for the kind of scratch that gets worse."
msgstr "好，遇到越來越疼的傷口就用這種繃帶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARREL_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARREL_GUNPOWDER"
msgid "Let me put my bat down before we move that."
msgstr "等我先把球棒放下，再來搬這個桶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERMUDATRIANGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERMUDATRIANGLE"
msgid "Can't we take a shortcut that doesn't make my hair stand up?"
msgstr "就不能有一條走過去頭髮不會豎起來的近路嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIOLUMINESCENCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIOLUMINESCENCE"
msgid "Even the sea has its own night-light. Good for it."
msgstr "連海裡都有自己的小夜燈。真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISQUE"
msgid "If there's more soup, I can stay awake for another bowl."
msgstr "湯還有的話，我可以晚點睡，再喝一碗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FLUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FLUP"
msgid "Quit looking at me. It's weird enough holding the thing."
msgstr "別看我了。拿著這個已經夠怪了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_POISON"
msgid "I'll keep the point away from my fingers."
msgstr "尖頭得離我的手指遠點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBER"
msgid "A wad of whale fat. Whose bag is this going in?"
msgstr "一大塊鯨脂。這要放進誰包裡？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBERSUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUBBERSUIT"
msgid "Every time I move, it makes a noise. I'm pretending I can't hear it."
msgstr "一動它就響，我當沒聽見。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATCANNON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATCANNON"
msgid "That goes on the boat, right? Give me some room."
msgstr "裝在船上的吧？給我讓點地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATREPAIRKIT"
msgid "Good. Something that fixes holes faster than I make them."
msgstr "好，修洞得比我弄出洞快才行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ARMOURED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ARMOURED"
msgid "Thick hull. I like my boats hard to break."
msgstr "船底夠厚。我就喜歡結實的船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE"
msgid "Better the limestone takes the bump than the hull."
msgstr "讓石灰岩先撞上，總比讓船底挨一下好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT"
msgid "I'll put the bumper together before I hit anything else."
msgstr "趁還沒再撞上什麼，我先把保險槓裝好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CARGO"
msgid "There's room for a whole week's lunches in there."
msgstr "裡頭能裝一整個星期的午餐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ENCRUSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ENCRUSTED"
msgid "That shell plating better hold out at sea."
msgstr "這些殼最好能在海上撐久一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LANTERN"
msgid "A lantern on the bow frees up both hands."
msgstr "燈掛船頭，兩隻手就都空出來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LOGRAFT"
msgid "Logs and rope. This is all the boat I get?"
msgstr "幾根木頭幾條繩。這就是我的船？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_RAFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_RAFT"
msgid "A bamboo raft. Light enough to push off by myself."
msgstr "竹筏。夠輕，我自己就能推下水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROW"
msgid "A rowboat. So much for resting my arms."
msgstr "划艇。我的胳膊別想休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_SURFBOARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_SURFBOARD"
msgid "I'll stand on it as soon as it stops moving."
msgstr "等它不晃了我就站上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_TORCH"
msgid "Good, I can see what I'm about to run into."
msgstr "好，至少能看見自己快撞上什麼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_WOODLEGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_WOODLEGS"
msgid "Woodlegs gets an entire ship to himself. Lucky."
msgstr "伍德萊格一個人就有整條船。真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_METEOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_METEOR"
msgid "I was going to skip the reading. Then I saw what it does."
msgstr "原本不想讀的。直到看見它能幹什麼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOTTLELANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOTTLELANTERN"
msgid "Odd light. Still better than feeling around in the dark."
msgstr "這光真奇怪。總比在黑裡亂摸好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAINJELLYHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRAINJELLYHAT"
msgid "I don't mind getting smarter. Do I have to get slimier too?"
msgstr "變聰明我沒意見。一定要連頭頂也跟著黏糊糊嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUOY"
msgid "I can use that to tell whether I've been rowing in circles."
msgstr "可以靠它看看我是不是又劃回原處了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURIEDTREASURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURIEDTREASURE"
msgid "That's the spot. Start digging before the tide comes in."
msgstr "就在這裡。漲潮前先挖開。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNING"
msgid "That's smoke coming off the viney bush. Back up a little."
msgstr "是藤蔓叢在冒煙。往後退一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.BURNT"
msgid "So much for the viney bush. Is anything under the ash still good?"
msgstr "藤蔓叢算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.CHOPPED"
msgid "The viney bush is cut back. My arms can rest now."
msgstr "藤蔓叢砍完了。胳膊可以休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSH_VINE.GENERIC"
msgid "If I get tangled up, I'm taking the whole bush with me."
msgstr "要是纏住我，我就把整叢拖走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAPTAINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAPTAINHAT"
msgid "I'll wear it. You can still tell me which way to go."
msgstr "帽子我戴。往哪裡開還是你來說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN"
msgid "I'd rather be on the handle end of that saw."
msgstr "這把鋸子，我還是站在有柄的那頭吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVIAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVIAR"
msgid "Fish eggs in a little jar. Who decided that's fancy?"
msgstr "小罐子裡裝點魚卵，怎麼就成高級菜了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KRAKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KRAKEN"
msgid "I like the Quacken this size. It can't reach my boat."
msgstr "我喜歡這麼大的海妖。它夠不到我的船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SEAL"
msgid "A seal in stone. Now I can finally put my hat down."
msgstr "石頭做的海豹。這回總算不用按著帽子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TIGERSHARK"
msgid "I can get a good look at its teeth now. Much better."
msgstr "現在可以仔細看看它的牙了。好多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWISTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWISTER"
msgid "Good. A Sealnado that stays where I put it."
msgstr "好極了。這隻豹捲風放下就不會動。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMINEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHIMINEA"
msgid "With that much shelter, even I can keep the fire going."
msgstr "圍得這麼嚴實，我也能讓火一直燒著了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.BURNING"
msgid "It's lit! Don't stand there holding it!"
msgstr "點著了！別拿在手裡發呆！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONADE.GENERIC"
msgid "That's a coconut. I know enough not to crack it open."
msgstr "是顆椰子。我還沒糊塗到要去敲開它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT"
msgid "There's a good drink in there. It's putting up a fight."
msgstr "裡面有好喝的，就是不肯輕易讓我喝到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_COOKED"
msgid "That smells better than anything I made in cooking class."
msgstr "聞起來比烹飪課上我做過的東西都香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_HALVED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_HALVED"
msgid "Finally got it open. That took more swings than it should have."
msgstr "總算開了。多敲了好幾下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COCONUT_SAPLING"
msgid "It can grow close to home. I could use a little shade."
msgstr "可以種在家附近。我正好缺塊陰涼地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEE"
msgid "One cup and suddenly I can finish things."
msgstr "喝一杯，手上的事總算能做完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS"
msgid "I want coffee. First I've got to roast these."
msgstr "我想喝咖啡。還得先把豆子烤了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBEANS_COOKED"
msgid "Now it smells like coffee. Still needs hot water."
msgstr "這下有咖啡香了。還差熱水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.BARREN"
msgid "The coffee plant looks dried out. Can we still do anything for it?"
msgstr "咖啡叢看起來乾透了。還有辦法救嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.GENERIC"
msgid "Coffee growing out here. Now there's a reason to go for a walk."
msgstr "咖啡長在這裡。這下有理由出門走走了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.PICKED"
msgid "We can come back for the coffee plant after it's had some time to grow."
msgstr "等咖啡叢長好了，我們可以再來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COFFEEBUSH.WITHERED"
msgid "I'll leave the coffee plant alone till we know how to help it."
msgstr "先別動咖啡叢。等弄清怎麼救它再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL"
msgid "I like the color. I'll put some on my desk if it fits."
msgstr "顏色不錯。桌上放得下就擺一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORALLARVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORALLARVE"
msgid "That's alive? I thought it was a wet chip of rock."
msgstr "原來是活的？我還當是塊濕石頭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN"
msgid "That thing looks more like a brain than anything I want to eat."
msgstr "看著太像腦子了，實在下不了口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORAL_BRAIN_ROCK"
msgid "At least there's an easier place to find a brain than math class."
msgstr "至少要找腦子，不用非得去數學課上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORMORANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORMORANT"
msgid "Did that bird dive all the way down for lunch?"
msgstr "那隻鳥為了吃飯，直接潛下去那麼深？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.GENERIC"
msgid "Hold on. I'm trying to walk sideways too."
msgstr "等一下，我也在試著橫過來走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.HIDDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRAB.HIDDEN"
msgid "I can see where it dug in. That's about it."
msgstr "看得出它在哪裡鑽進去的。也就只能看出這些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABHOLE"
msgid "It's in there. I can wait longer than it can. Probably."
msgstr "它就在裡頭。我能比它等得更久。大概。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRATE"
msgid "No name on the crate. Guess I'll see what's inside."
msgstr "箱子上沒名字。打開看看吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROCODOG"
msgid "I don't care how much it acts like a dog. Look at the jaws."
msgstr "它再像狗也沒用，看看那張嘴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLASS"
msgid "The handle's fine. The rest smells like lunch left in the sun."
msgstr "握柄還可以。剩下的聞起來像曬了一天的午餐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BAMBOOTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BAMBOOTREE"
msgid "I already took what I could from the bamboo patch. I'll check back later."
msgstr "竹叢上能採的都採了。晚點再來看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_BUSH_VINE"
msgid "We can come back for the viney bush after it's had some time to grow."
msgstr "等藤蔓叢長好了，我們可以再來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS_WATER"
msgid "Nothing left on the water grass for now. Give it time."
msgstr "水草暫時採不出東西了。再等等吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORSALFIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DORSALFIN"
msgid "Glad I can see the fin without the rest of the fish attached."
msgstr "還好只有魚鰭，沒連著下面那條魚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOUBLE_UMBRELLAHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOUBLE_UMBRELLAHAT"
msgid "Two umbrellas and both hands still free. I'll take the funny looks."
msgstr "撐兩把傘，還能空著兩隻手。笑就笑吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOY"
msgid "I don't think it knows I'm here. I'm right in front of it."
msgstr "我都站在它面前了，它好像還不知道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYBABY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYBABY"
msgid "Small enough to get lost in the grass. I'll watch where I step."
msgstr "小得往草裡一站就看不見了。我走路小心點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG"
msgid "Leave it be if we want more of those birds."
msgstr "還想見到這種鳥的話，先別碰這顆蛋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_COOKED"
msgid "Hand me the fried doydoy egg. I haven't eaten since we left."
msgstr "把煎渡渡鳥蛋遞給我。出門以後我還沒吃過東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYEGG_CRACKED"
msgid "The shell's split. I hope that's all that broke."
msgstr "蛋殼裂了。希望裡面沒事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYFEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYFEATHER"
msgid "That's one thing the bird managed to leave behind."
msgstr "這鳥倒是留下了一樣東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYNEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOYDOYNEST"
msgid "I can see why they'd stop here. Looks good for a nap."
msgstr "難怪它們會選這裡。看起來蠻適合睡覺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOON"
msgid "That lizard's looking at me wrong. And it's hot enough from here."
msgstr "這蜥蜴看我的眼神不對。離這麼遠都能感覺到熱了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONDEN"
msgid "Keep your distance. I doubt the lizards take visitors."
msgstr "離遠點。我看那群蜥蜴不接待客人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONEGG"
msgid "It's warmer than an egg ought to be. I'm putting it down."
msgstr "比一般的蛋燙多了。我還是放下吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONHEART
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONHEART"
msgid "I'm not putting that in my pocket while it's still warm."
msgstr "還熱著呢。我才不放兜裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONSPIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGOONSPIT"
msgid "It spat where I was standing. I'm standing somewhere else now."
msgstr "它剛朝我腳下吐了一口。我換個地方站。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUBLOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUBLOON"
msgid "Money I can dig up. This beats asking for an allowance."
msgstr "挖地就能拿到錢。比討零花錢好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BAMBOOTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BAMBOOTREE"
msgid "I'll carry the bamboo root. Can you dig the hole?"
msgstr "竹根我來拿。你能挖坑嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BUSH_VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BUSH_VINE"
msgid "Find a spot for the viney bush root before the roots dry out."
msgstr "趁藤蔓根的根還沒乾，先找塊地方種下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_COFFEEBUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_COFFEEBUSH"
msgid "Find a spot for the coffee plant before the roots dry out."
msgstr "趁咖啡叢的根還沒乾，先找塊地方種下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_ELEPHANTCACTUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_ELEPHANTCACTUS"
msgid "I'll carry the elephant cactus. Can you dig the hole?"
msgstr "象仙人掌根我來拿。你能挖坑嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_LIMESTONE"
msgid "Somebody show me how the limestone dumbbell works. Keep it short."
msgstr "誰給我演示一下石灰石啞鈴怎麼用。簡單說就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_OBSIDIAN"
msgid "Somebody show me how the obsidian dumbbell works. Keep it short."
msgstr "誰給我演示一下黑曜石啞鈴怎麼用。簡單說就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARRING"
msgid "Shiny enough to find if I drop it. Still, I'd rather not."
msgstr "亮得掉了也好找。能不掉最好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.BARREN"
msgid "Something's wrong with the elephant cactus. It wasn't this droopy before."
msgstr "象仙人掌不對勁。之前沒這麼蔫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.GENERIC"
msgid "I'll look at the spikes with both hands behind my back."
msgstr "我看看刺就好，兩隻手都放到背後。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.PICKED"
msgid "I already took what I could from the elephant cactus. I'll check back later."
msgstr "象仙人掌上能採的都採了。晚點再來看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS.WITHERED"
msgid "The elephant cactus looks dried out. Can we still do anything for it?"
msgstr "象仙人掌看起來乾透了。還有辦法救嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_ACTIVE"
msgid "Ow! Those spikes weren't pointing at me a second ago."
msgstr "疼！剛才那些刺還沒對著我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_STUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELEPHANTCACTUS_STUMP"
msgid "Finally. Nothing left to stick in my sleeve."
msgstr "總算清了。再也沒有刺會扎進袖子裡了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FABRIC"
msgid "I could patch three holes with this. Maybe two, with my sewing."
msgstr "能補三個洞吧。憑我的針線活，可能是兩個。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINHOLE"
msgid "The fish are all in one spot. That's unusual cooperation."
msgstr "魚都聚在一塊兒。難得這麼配合。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.BLUEFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.BLUEFISH"
msgid "That's a lot of blue fish. I should get the net."
msgstr "有這麼多藍魚了。我該去拿網了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.EMPTY"
msgid "Empty. Who's got the fish eggs?"
msgstr "空的。魚卵在誰手裡？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.ONEFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.ONEFISH"
msgid "There's one. I'll try not to plan the whole menu around it."
msgstr "有一條了。晚餐也別全指望它吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.REDFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.REDFISH"
msgid "I can see the red ones now. Looks like it worked."
msgstr "現在能看見紅魚了，看來成了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.STOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.STOCKED"
msgid "Eggs are in. Now comes the part I'm bad at: waiting."
msgstr "魚卵放進去了。現在輪到我不擅長的事了，等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.TWOFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_FARM.TWOFISH"
msgid "Two fish. This is starting to look worth the trouble."
msgstr "兩條了。現在看著開始值得費這工夫了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_TROPICAL"
msgid "It has more colors than the shirt I had to wear on sports day."
msgstr "它身上的顏色比運動會上發的衣服還多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLAMEGEYSER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLAMEGEYSER"
msgid "I'm happy to watch the fire from exactly this far away."
msgstr "我就站在離火這麼遠的地方看，蠻好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTSAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTSAM"
msgid "Something washed out to sea. I might be able to fish it out."
msgstr "有東西漂出海了。興許撈得上來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLUP"
msgid "I can see your eye. Quit pretending I can't."
msgstr "看得見你的眼睛。別以為我沒看見。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GASHAT"
msgid "I'll try the particulate purifier on. Does it flatten my hair?"
msgstr "我戴一下顆粒淨化器。會把頭髮壓扁嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENMACHETE"
msgid "The gold part doesn't help me swing. Does look nice, though."
msgstr "鍍金也沒讓我砍得更順手。好看倒是真的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_WATER"
msgid "At least nobody has to remember to water this grass."
msgstr "這草至少不用誰惦記著澆水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAIL_ICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAIL_ICE"
msgid "Ice from the sky. I liked it better when it was in a drink."
msgstr "天上掉的冰。我比較喜歡它待在飲料裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARPOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARPOON"
msgid "I'll need a running start. On second thought, we're on a boat."
msgstr "我得先助跑兩步。等等，我們在船上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_BOAT_NAMEPLATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_BOAT_NAMEPLATE"
msgid "Put my name on it. Make it big enough to read in the rain."
msgstr "寫我的名字。寫大點，下雨也能看清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1"
msgid "Hang the pirate ghost decoration a little higher. My bat might catch it."
msgstr "海盜鬼魂裝飾掛高一點。我的球棒有可能碰到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2"
msgid "Whoever picked the stink ray decoration gets to dust it."
msgstr "誰挑的惡臭蝠鱝裝飾，以後誰來撣灰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3"
msgid "The tropical spider warrior decoration can go on the wall. Just don't make me stand there admiring it."
msgstr "毒蜘蛛裝飾可以掛牆上。別讓我站那裡一直看就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4"
msgid "Hang the doydoy decoration a little higher. My bat might catch it."
msgstr "渡渡鳥裝飾掛高一點。我的球棒有可能碰到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_14"
msgid "Don't lose the worn-out doll now that we finally found it."
msgstr "好不容易找到磨損的玩偶，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_15
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_15"
msgid "I don't know what an old ukulele is worth here. I could ask."
msgstr "不知道舊尤克里裡在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_17
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_17"
msgid "I've got room in my bag for the lost old boot, if nobody else wants it."
msgstr "沒人要丟失的舊靴子的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_18"
msgid "I don't know what a mother's favorite vase is worth here. I could ask."
msgstr "不知道媽媽最愛的花瓶在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_20
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_20"
msgid "I've got room in my bag for the lost father's sextant, if nobody else wants it."
msgstr "沒人要爸爸丟失的六分儀的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_21
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_LOST_TOY_21"
msgid "I've got room in my bag for the favorite toy boat, if nobody else wants it."
msgstr "沒人要最喜歡的玩具船的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLE"
msgid "I'd use a sealed bottle too if nobody picked up my letters."
msgstr "沒人來收我的信，我也會把信塞進密封瓶子裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_MESSAGEBOTTLEEMPTY"
msgid "All the way across the sea and now it's an empty bottle."
msgstr "漂過那麼大一片海，到頭來就剩個空瓶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED"
msgid "I'll listen to Shipwrecked. Give me somewhere to sit first."
msgstr "我想聽聽《海難》。先給我找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED"
msgid "I'll listen to Beached. Give me somewhere to sit first."
msgstr "我想聽聽《沙灘》。先給我找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD"
msgid "Did we bring a player for Castaway? I'd like to hear it."
msgstr "有沒有能放《漂流者》的唱機？我想聽聽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_TRIDENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IA_TRIDENT"
msgid "Three points to keep track of. A bat was simpler."
msgstr "三個尖都得留意。還是球棒省事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.HIGH"
msgid "I can hear the ice maker 3000 working. We'll check on it in a minute."
msgstr "聽得見製冰機3000在運轉。待會兒再來看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.LOW"
msgid "The ice maker 3000 needs more fuel. Did we bring any?"
msgstr "製冰機3000要加燃料了。我們帶了嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.NORMAL"
msgid "The ice maker 3000 is running. Can I sit down now?"
msgstr "製冰機3000運轉起來了。我現在能坐下了嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.OUT"
msgid "No ice. No fuel. There goes my cold drink."
msgstr "沒冰了，燃料也沒了。我的冰飲料也沒了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.VERYLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEMAKER.VERYLOW"
msgid "It's sputtering. Fuel, quick, before it stops."
msgstr "開始斷斷續續響了。趕快加燃料，別讓它停。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRONWIND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IRONWIND"
msgid "This can move the boat while I sit down. Good."
msgstr "這下我坐著，船也能走。好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH"
msgid "It can sting even if it looks like dessert. I know now."
msgstr "看起來像點心，也照樣會蜇人。我現在知道了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISHJELLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISHJELLY"
msgid "The jellyfish jelly can cool off while I find somewhere to sit."
msgstr "先讓水母凍涼一涼。我去找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_COOKED"
msgid "Put the cooked jellyfish where I can reach it. I'll be hungry later."
msgstr "熟水母放在我夠得著的地方。晚點我會餓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_DEAD"
msgid "Dead. I'm still keeping my fingers off the tentacles."
msgstr "死了。我還是不拿手碰觸鬚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYFISH_PLANTED"
msgid "There it goes, drifting around with its stingers out."
msgstr "它又帶著觸鬚在水裡漂來漂去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYJERKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYJERKY"
msgid "I chewed and chewed. It stayed practically the same size."
msgstr "嚼了半天，幾乎沒小一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYOPOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYOPOP"
msgid "Finally, a jellyfish I can eat from the safe end."
msgstr "總算有一種能握著另一頭吃的水母了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNING"
msgid "The jungle tree caught fire. Somebody get water!"
msgstr "叢林樹著火了！誰去拿點水！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.BURNT"
msgid "The jungle tree is already burnt through. Too late to bring a bucket."
msgstr "叢林樹都燒透了。現在拿桶也晚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.CHOPPED"
msgid "The jungle tree is cut back. My arms can rest now."
msgstr "叢林樹砍完了。胳膊可以休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREE.GENERIC"
msgid "That's a big tree. I'll check the ground for surprises before I start chopping."
msgstr "這麼大的樹。開砍前我先看看下面藏沒藏東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED"
msgid "I want the shade this grows into. I don't want to wait that long."
msgstr "想要它長成大樹給我遮陰，又不想等那麼久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNGLETREESEED_SAPLING"
msgid "Give the jungle tree sapling room to take root. I don't want to move it twice."
msgstr "給叢林樹苗留夠紮根的地方。我可不想再挪一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_SILVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_SILVER"
msgid "I'll keep the silver key in my pocket where it won't get lost."
msgstr "銀鑰匙先放兜裡，免得弄丟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY_TROPICAL"
msgid "I'll keep the loot stash key in my pocket where it won't get lost."
msgstr "贓物袋鑰匙先放兜裡，免得弄丟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHTBOAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHTBOAT"
msgid "Someone taught a clockwork knight to sail. Thanks a lot."
msgstr "還有人教了發條騎士開船。可真會教。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN"
msgid "That thing is wider than the boat. Don't stop rowing."
msgstr "那東西比船還寬。別停槳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKENCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKENCHEST"
msgid "After all that rowing, I'm opening this one."
msgstr "劃了這麼久，這箱我來開。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAKEN_TENTACLE"
msgid "Keep that arm off my boat!"
msgstr "觸手別搭到我船上！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAPOOL"
msgid "The heat's coming through my shoes. This is far enough."
msgstr "隔著鞋都覺得燙。到這裡就可以了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_PALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_PALM"
msgid "I didn't expect the tree to come after me. I can take the hint."
msgstr "沒想到樹會追上來。行，我走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMESTONENUGGET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMESTONENUGGET"
msgid "Light-colored rock. Still makes my bag heavy."
msgstr "石頭顏色淺，裝包裡也一樣沉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS"
msgid "They're hanging onto the rock harder than I hang onto my bed in the morning."
msgstr "它們抓石頭抓得比我早上賴床還牢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIMPETS_COOKED"
msgid "Put the cooked limpets where I can reach it. I'll be hungry later."
msgstr "熟帽貝放在我夠得著的地方。晚點我會餓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGJUNGLETREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGJUNGLETREE"
msgid "I can't say what's off about it. I'm still picking a different tree."
msgstr "說不上哪裡不對。我還是去挑另一棵吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER"
msgid "If I get pinched, somebody else cooks dinner."
msgstr "我要是被夾了，晚餐換個人做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERHOLE"
msgid "I see where it lives. I'm not reaching in bare-handed."
msgstr "知道它住哪了，我也不會空手伸進去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD"
msgid "The claws stopped moving. Now I don't mind holding it."
msgstr "鉗子不動了。現在我敢拿著了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTER_DEAD_COOKED"
msgid "I'll try the delicious wobster. Save me a bite."
msgstr "美味的龍蝦我想試試。給我留一口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUGGAGECHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUGGAGECHEST"
msgid "Somebody's luggage. I hope the clasp still opens."
msgstr "不知道誰的行李。希望卡扣還能開。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MACHETE"
msgid "Now that's a tool for getting straight through the weeds."
msgstr "拿這東西開路，就能直接從草裡走過去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGIC_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGIC_SEAL"
msgid "It's still glowing. I don't know what it's doing, but it's still glowing."
msgstr "還在發光。我不知道它要幹什麼，反正光還亮著。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK"
msgid "That rock was liquid once. I'm glad I got here later."
msgstr "那石頭以前是流動的。還好我來晚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK_GOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGMAROCK_GOLD"
msgid "I see gold in there. Pass me the pickaxe and stand back."
msgstr "裡頭有金子。把鎬遞給我，再退遠點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.BURNT"
msgid "The mangrove is pretty much ash now. Leave it to cool."
msgstr "紅樹燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE.GENERIC"
msgid "It grows right in the water. Must be nice never needing a watering can."
msgstr "直接長在水裡。連澆水壺都不用，真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_BURNT"
msgid "I didn't think a tree standing in water could end up that dry."
msgstr "沒想到長在水裡的樹也能燒得這麼幹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANGROVETREE_SAPLING"
msgid "Give the mangrove sapling room to take root. I don't want to move it twice."
msgstr "給紅樹樹苗留夠紮根的地方。我可不想再挪一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT_TROPICAL"
msgid "It grows in the wet stuff. I'll stay on the edge."
msgstr "它長在水裡。我在邊上看看就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMFISHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMFISHER"
msgid "That merm looks like it knows a better fishing spot than I do."
msgstr "這個魚人看著就比我會找地方釣魚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER"
msgid "That's the fishermerm's hut. I wonder if anyone's inside."
msgstr "那是漁人小屋。不知道裡面有沒有人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER_CRAFTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_FISHER_CRAFTED"
msgid "That's the anglermerm house. I wonder if anyone's inside."
msgstr "那是漁人工藝屋。不知道裡面有沒有人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.BURNT"
msgid "So much for the merm hut. Is anything under the ash still good?"
msgstr "魚人小屋算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC"
msgid "I can see the merm hut from here. Want to go look?"
msgstr "從這裡能看見魚人小屋。要過去看看嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBALL"
msgid "If the monkey wants the ball that much, it can stop touching my bag."
msgstr "猴子這麼喜歡球，就別再翻我的包了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB_YELLOW"
msgid "That's a whole lot of bad smell in one little package."
msgstr "這麼小一包，裝了這麼多臭氣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER_YELLOW"
msgid "It came out of a mosquito. If the plants want it, they can have it."
msgstr "從蚊子身上弄出來的。植物想要就給它們吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE_YELLOW"
msgid "That's meant for the merms. Set it somewhere they can see it."
msgstr "這個是給魚人的。放到他們看得見的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK_YELLOW"
msgid "If that smell keeps the mosquitoes off, I'll put up with it."
msgstr "這味道要能趕走蚊子，我就忍一忍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK_YELLOW"
msgid "That fell off a mosquito. You can carry it."
msgstr "那是蚊子身上掉下來的。你拿吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO_POISON"
msgid "I hate regular mosquitoes enough already."
msgstr "普通蚊子已經夠讓我煩了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL"
msgid "I think I can see the wrecked postern from here. Hold up the light."
msgstr "從這裡好像能看到殘損之門。把燈舉高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL"
msgid "I could pry it open. I could also wait till dinner."
msgstr "我可以把它撬開。也可以等到晚餐時再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSELBOUILLABAISE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSELBOUILLABAISE"
msgid "Put the mussel bouillabaise where I can reach it. I'll be hungry later."
msgstr "貽貝濃湯放在我夠得著的地方。晚點我會餓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_BED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_BED"
msgid "So that's where mussels come from. Can we put some closer to home?"
msgstr "貽貝原來從這裡來。能把一些移到離家近點的地方嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_COOKED"
msgid "Hand me the cooked mussel. I haven't eaten since we left."
msgstr "把熟貽貝遞給我。出門以後我還沒吃過東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.GENERIC"
msgid "There are mussels down there. I need a stick to get at them."
msgstr "底下有貽貝。得弄根貽貝棒才能採。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.STICKPLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_FARM.STICKPLANTED"
msgid "Stick's in place. The mussels can do the rest."
msgstr "貽貝棒插好了。剩下的交給貽貝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_STICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSSEL_STICK"
msgid "You tell me why the mussels like this stick. I'll listen if it's short."
msgstr "你可以告訴我貽貝為什麼喜歡這根棍。講得短我就聽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_RANDOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_RANDOM"
msgid "I'll let the spiders work out what kind of snack this is."
msgstr "這是哪種點心，就讓蜘蛛自己嚐出來吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR"
msgid "That's for the spider. Don't mix it up with my lunch."
msgstr "那個是給蜘蛛的。別跟我的午餐混了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MYSTERYMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MYSTERYMEAT"
msgid "I'll go hungry before I try to guess what that is."
msgstr "我寧願餓著，也不想猜那是什麼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEEDLESPEAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEEDLESPEAR"
msgid "That's one cactus thorn I don't want under my fingernail."
msgstr "這根仙人掌刺，我可不想扎到指甲縫裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO"
msgid "I can see that fish coming from here. Does it know how bright it is?"
msgstr "魚還離得老遠就看得見。它知道自己有多亮嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NEON_QUATTRO_COOKED"
msgid "Hand me the cooked neon quattro. I haven't eaten since we left."
msgstr "把熟霓虹魚遞給我。出門以後我還沒吃過東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUBBIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUBBIN"
msgid "Part of a reef that I can carry. It'll go back in the sea."
msgstr "一塊能帶走的珊瑚礁。還得放回海裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT"
msgid "How am I going to keep the ingenius gardeneer hat from falling off?"
msgstr "我要怎麼戴，天才耕作先驅帽才不會掉？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_BAMBOO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_BAMBOO"
msgid "Put the bamboo oar where I can reach it from my seat."
msgstr "把竹槳放到我坐著也夠得著的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_TIGERSHARK"
msgid "I'll check the tigoar before we leave the dock."
msgstr "離開碼頭前，我先檢查一下虎鯊槳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN"
msgid "It looks like glass till I try to pick it up."
msgstr "看起來像玻璃，拿起來才知道有多沉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANAXE"
msgid "Hot enough on its own. I don't have to swing harder."
msgstr "斧頭已經夠燙了，不用再多使勁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANBUGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANBUGNET"
msgid "I want to catch the bug before the handle gets warm."
msgstr "我想趁柄還沒熱起來把蟲抓住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.BURNING"
msgid "Everybody back! That one's already lit!"
msgstr "都退開！那個已經點著了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANCOCONADE.GENERIC"
msgid "A coconut with obsidian on it. I'm putting it down carefully."
msgstr "椰子上加了黑曜石。得輕點放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.EMBERS"
msgid "It's down to coals. Look for some dry wood."
msgstr "只剩炭火了。找點乾木頭吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.GENERIC"
msgid "A ring of obsidian. Looks like it can hold a serious fire."
msgstr "一圈黑曜石。看起來能燒很大的火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.HIGH"
msgid "Step back. The flames in the obsidian fire pit are getting high."
msgstr "退遠點。黑曜石火坑裡的火越燒越高了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.LOW"
msgid "The obsidian fire pit barely puts out any heat right now."
msgstr "黑曜石火坑現在幾乎沒什麼熱氣了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.NORMAL"
msgid "Can we stop here for a minute? The obsidian fire pit is keeping me warm."
msgstr "我們能在這裡停會兒嗎？靠著黑曜石火坑蠻暖和。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANFIREPIT.OUT"
msgid "Any spare wood? I let the obsidian fire pit go out while I was resting."
msgstr "還有木頭嗎？我一休息，黑曜石火坑裡的火就滅了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANMACHETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIANMACHETE"
msgid "Clear the trail and mind the heat. I think I can manage both."
msgstr "把路砍出來，還得當心別燙到。我兩件都能做到吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN_WORKBENCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OBSIDIAN_WORKBENCH"
msgid "I can make hot tools here. Can I make the handles stay cold?"
msgstr "在這裡能做出發熱的工具。能讓柄保持涼快嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY"
msgid "If the doydoy quill float comes loose at sea, I'm making you go get it."
msgstr "渡渡鳥浮漂要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSCHEST"
msgid "Deal's done. I'm opening the chest while we still have daylight."
msgstr "東西換完了。趁天還亮，我先開箱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCTOPUSKING"
msgid "Eight arms and still too relaxed to move. I respect that."
msgstr "八條胳膊，還能懶得動。我服了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX"
msgid "That beefalo doesn't seem to mind getting its feet wet."
msgstr "這水牛好像完全不嫌腳濕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OXHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OXHAT"
msgid "I finally have horns that aren't just my hair sticking up."
msgstr "總算有真的角了。以前只有頭髮翹起來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_FLUTE"
msgid "If I play it, it rains. I'm tempted to play it outside somebody's window."
msgstr "吹了就下雨。真想站在誰窗外試一試。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OX_HORN"
msgid "It's hollow. I shouldn't blow into it unless I want the whole camp to know I'm here."
msgstr "裡面是空的。我一吹，營地所有人都知道我來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM"
msgid "If you carry my stuff, I'll stop asking why you follow me."
msgstr "你要肯幫我帶東西，我就不問你為什麼跟著我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM_FISHBONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PACKIM_FISHBONE"
msgid "I'll hang on to it. The bird seems to care where it goes."
msgstr "先收好吧。那隻鳥好像蠻在意它在哪裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF"
msgid "I could cool off with this if my arm didn't have to do all the work."
msgstr "拿它扇風能涼快點。要是不用自己一直扇就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_HUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_HUT"
msgid "Shade without having to sit under a falling coconut. Perfect."
msgstr "能乘涼，還不用擔心頭上掉椰子。正好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_UMBRELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMLEAF_UMBRELLA"
msgid "I'll take that. My hair's got enough salt in it already."
msgstr "我要拿著。我頭髮上的鹽已經夠多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNING"
msgid "That's smoke coming off the palm tree. Back up a little."
msgstr "是椰樹在冒煙。往後退一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.BURNT"
msgid "The palm tree is pretty much ash now. Leave it to cool."
msgstr "椰樹燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.CHOPPED"
msgid "That's enough chopping for now. What's left of the palm tree can stay."
msgstr "先砍到這裡。剩下的椰樹就留著吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMTREE.GENERIC"
msgid "I want the coconuts. The coconuts are way up there. Typical."
msgstr "我想要椰子。椰子在那麼高的地方。果然。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT"
msgid "That's a better color than anything I'm allowed to wear to school."
msgstr "這顏色比學校讓穿的所有衣服都好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_PIRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PARROT_PIRATE"
msgid "Loud. Whoever taught it to talk owes me some peace and quiet."
msgstr "真吵。誰教它說話的，來還我一點清靜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEG_LEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEG_LEG"
msgid "That's a leg somebody can swing. I still like my bat."
msgstr "這條腿可以拿來揮。我還是喜歡球棒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH"
msgid "Does the clownfish know it's easier to spot in that color?"
msgstr "小丑魚知道這個顏色特別顯眼嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIERROT_FISH_COOKED"
msgid "The cooked pierrot fish smells good. I get the first bite, right?"
msgstr "熟小丑魚聞起來不錯。我可以吃第一口吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEGHOST"
msgid "Being dead didn't make it any quieter."
msgstr "死了也沒安靜一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEHAT"
msgid "How am I going to keep the pirate hat from falling off?"
msgstr "我要怎麼戴，海盜帽才不會掉？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATEPACK"
msgid "I'll carry the booty bag if somebody else carries the rest."
msgstr "其他東西誰拿一下，藏寶袋我來帶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.BURNT"
msgid "The piratihatitator is pretty much ash now. Leave it to cool."
msgstr "靈子海盜帽燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATIHATITATOR.GENERIC"
msgid "Somebody built a whole thing around a pirate hat. Fair enough."
msgstr "有人圍著一頂海盜帽做了整套裝置。好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONBALM"
msgid "Poison treatment. I hope it doesn't sting more than the bite."
msgstr "解毒膏。希望塗上去別比咬那一下還疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONCROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONCROCODOG"
msgid "That one's got venom. Don't let it get its teeth on you."
msgstr "那只有毒。別讓它咬到你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POISONHOLE"
msgid "I saw the fumes. I'm going the long way around."
msgstr "看見冒出來的毒氣了。我繞遠一點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTAL_SHIPWRECKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTAL_SHIPWRECKED"
msgid "I think I can see the portal from here. Hold up the light."
msgstr "從這裡好像能看到傳送門。把燈舉高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPE"
msgid "I saw it looking at my bag. I'm not putting it down."
msgstr "我看見它在盯我的包。包我不放下了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPEBARREL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIMEAPEBARREL"
msgid "I wonder where they keep all the stuff they take."
msgstr "不知道它們拿走的東西都藏在哪裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER"
msgid "I can see a purple fish. Hard to lose that one."
msgstr "看見一條紫魚了。這顏色很難跟丟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLE_GROUPER_COOKED"
msgid "The cooked purple grouper can cool off while I find somewhere to sit."
msgstr "先讓熟紫石斑魚涼一涼。我去找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENBEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENBEAK"
msgid "That's some beak. Glad it's off the thing now."
msgstr "好大一張喙。還好已經掉下來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENDRILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENDRILL"
msgid "A drill for the sea. At least it's lighter than hauling the sea to a workbench."
msgstr "在海上用的鑽子。至少比把海搬到工作台上輕鬆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.EMPTY"
msgid "The can's dry. Who's going to refill it?"
msgstr "壺幹了。誰去灌水？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKENWATERINGCAN.GENERIC"
msgid "The big beak makes a pretty decent spout. Who knew?"
msgstr "那麼大的喙，裝上去還真是個像樣的壺嘴。誰想得到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKERINGRAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUACKERINGRAM"
msgid "I'll keep my head behind it when it hits. Learned that much."
msgstr "撞上去的時候，頭要縮在後面。這點我學會了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH"
msgid "A rainbow with stingers. I'll look from here."
msgstr "會蜇人的彩虹。我在這裡看就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISHMOUSSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISHMOUSSE"
msgid "Hand me the rainbow mousse. I haven't eaten since we left."
msgstr "把彩虹慕斯遞給我。出門以後我還沒吃過東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_COOKED"
msgid "I had plans. Then somebody made cooked rainbow jellyfish."
msgstr "我原本還有事要做。現在有人做了熟彩虹水母。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_DEAD"
msgid "It stopped moving. The colors didn't go anywhere."
msgstr "不動了。顏色倒還在。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINBOWJELLYFISH_PLANTED"
msgid "I can see the colors through the water. See, I don't have to touch it."
msgstr "隔著水就看得到顏色。看吧，我用不著伸手碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAWLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAWLING"
msgid "A ball my bat can't hit. We should probably talk about that."
msgstr "有顆球不能拿球棒打。我們可能得談談這件事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CHARCOAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CHARCOAL"
msgid "My hands are black, and I barely touched it."
msgstr "我都沒怎麼碰，手就黑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CORAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_CORAL"
msgid "The reef's pretty when I'm not scraping the bottom of my boat on it."
msgstr "只要船底沒在上面刮，珊瑚礁看起來蠻好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.GENERIC"
msgid "There's dinner, stuck to a rock with no plans to leave."
msgstr "晚餐就在那裡，扒著塊石頭不想下來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIMPET.PICKED"
msgid "I already took what I could from the limpet rock. I'll check back later."
msgstr "帽貝巖上能採的都採了。晚點再來看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_OBSIDIAN"
msgid "I'm not carrying the whole rock. I'll break off what I need."
msgstr "我才不搬整塊。要多少敲多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE"
msgid "All those eggs in one pile. I thought it would look more like dinner."
msgstr "一堆魚卵。我以為會更像能吃的東西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROE_COOKED"
msgid "I had plans. Then somebody made cooked roe."
msgstr "我原本還有事要做。現在有人做了熟魚卵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_CLOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_CLOTH"
msgid "The stitching looks solid. Don't make me repair it."
msgstr "縫線看著結實。可別讓我補。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_FEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_FEATHER"
msgid "That's a light sail. Good, I'll be the one hauling it up."
msgstr "帆蠻輕。正好，反正升帆的是我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_PALMLEAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_PALMLEAF"
msgid "I could have used those leaves for shade. A sail works too."
msgstr "那些葉子本來能遮陰。做帆也可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_SNAKESKIN"
msgid "At least the snake won't be doing the steering."
msgstr "還好掌舵的用不著那條蛇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_WOODLEGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAIL_WOODLEGS"
msgid "I know whose sail that is. Think he'll give me a lift?"
msgstr "我認得那是誰的帆。他會讓我搭船嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAND"
msgid "I'll be finding this in my shoes for a week."
msgstr "接下來一個星期，我鞋裡都會有這個。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG"
msgid "Keep that gap closed. I don't want water in the house again."
msgstr "把缺口堵好。我不想屋裡再進水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL"
msgid "I'll take the sandbag with me. Better than walking back for it."
msgstr "我把沙袋帶上吧，省得走一半還得回來拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAGSMALL_ITEM"
msgid "Somebody show me how the sandbag works. Keep it short."
msgstr "誰給我演示一下沙袋怎麼用。簡單說就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBAG_ITEM"
msgid "It's full. Somebody help me carry it where the water's coming in."
msgstr "袋子裝滿了。誰幫我搬到進水的地方？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.GENERIC"
msgid "Good castle. I wouldn't build it any closer to the water."
msgstr "城堡不錯。我可不會再往水邊修。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.SAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDCASTLE.SAND"
msgid "I'll build the wall once the sand stops crumbling in my hands."
msgstr "等沙子不再從手裡散下去，我就修城牆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDDUNE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDDUNE"
msgid "A whole pile of sand. I'll walk around it and save myself the climb."
msgstr "好大一堆沙。繞過去吧，省得爬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL"
msgid "My lunch is in my bag for a reason. There it is."
msgstr "我把午餐收包裡是有原因的。看，那隻來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAGULL_WATER"
msgid "It gets to sit there without having to steer. Nice."
msgstr "它可以浮在那裡，還不用掌舵。真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASACK"
msgid "As long as what's inside stays fresh, I'll deal with the wet straps."
msgstr "只要裝進去的東西不壞，揹帶濕我也忍了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL"
msgid "I thought I'd put it to my ear. First I'll check if someone's still in it."
msgstr "本來想拿它聽聽。先看看裡頭還有沒有東西住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL_BEACHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASHELL_BEACHED"
msgid "The tide left it here. I'll pick it up before it takes it back."
msgstr "潮水把它送到這裡。趁還沒捲走，我先撿起來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEATRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEATRAP"
msgid "Set it and stand back. I like fishing when I can sit down."
msgstr "放好就退開。我喜歡能坐著等的捕魚法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED"
msgid "Lunch from the sea. Tastes like a lot of sea."
msgstr "海裡來的午餐。吃著滿嘴都是海水味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_COOKED"
msgid "The roasted seaweed can cool off while I find somewhere to sit."
msgstr "先讓熟海帶涼一涼。我去找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_DRIED"
msgid "Much easier to carry when it isn't dripping."
msgstr "不滴水以後好帶多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.GENERIC"
msgid "I can see the seaweed. I can't quite reach it."
msgstr "海帶看得見，就是差一點夠不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_PLANTED.PICKED"
msgid "I already took what I could from the seaweed. I'll check back later."
msgstr "海帶上能採的都採了。晚點再來看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_STALK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWEED_STALK"
msgid "A seaweed stalk. Water's still running down my sleeve."
msgstr "海帶莖。水還在順著我的袖子往下淌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.BROKEN"
msgid "One of the pieces is out of place. I don't think sitting harder will help."
msgstr "有零件不對。我想再用力坐也沒用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.GENERIC"
msgid "A chair that gets me off the island? I'll try sitting down."
msgstr "坐椅子就能離開這座島？我來坐坐看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.INSIDE_SW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAWORTHY.INSIDE_SW"
msgid "I sat down and now we're going somewhere. That's just how I like to travel."
msgstr "一坐下就能出發。我就喜歡這樣趕路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.EMBERS"
msgid "I can see a few red coals. Have you got any dry wood?"
msgstr "還能看見幾塊紅炭。你有乾木頭嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.GENERIC"
msgid "A stove on the water. I'll keep a hand on it when the waves come."
msgstr "水上還能放火爐。來浪的時候我會扶住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.HIGH"
msgid "Step back. The flames in the buoyant chiminea are getting high."
msgstr "退遠點。漂浮火爐裡的火越燒越高了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.LOW"
msgid "I can still see embers in the buoyant chiminea. We haven't lost the fire yet."
msgstr "還能看見漂浮火爐裡的餘燼。火還沒徹底熄。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.NORMAL"
msgid "I'll sit near the buoyant chiminea till my sleeves dry."
msgstr "我在漂浮火爐旁邊坐到袖子幹了再走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_CHIMINEA.OUT"
msgid "The buoyant chiminea went out. Let's get it lit again."
msgstr "漂浮火爐裡的火熄了。重新升起來吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_LAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_LAB"
msgid "I'd like to see how they keep the experiments from rolling overboard."
msgstr "真想看看他們怎麼讓實驗器材不滾下船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.LOWFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.LOWFUEL"
msgid "The sea yard needs more fuel. Did we bring any?"
msgstr "修船碼頭要加燃料了。我們帶了嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.OFF"
msgid "Can somebody turn the sea yard back on? I need it in a minute."
msgstr "誰能把修船碼頭重新打開？我待會兒要用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEA_YARD.ON"
msgid "I'll leave the sea yard on until it's done."
msgstr "讓修船碼頭開著吧，等它忙完再關。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKFINSOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKFINSOUP"
msgid "Now that there's shark fin soup, can we stop for lunch?"
msgstr "既然有魚翅湯了，能停下來吃飯嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTEN"
msgid "Little fins. Big teeth. Where's its mother?"
msgstr "鰭小，牙可不小。它媽媽在哪裡？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.GENERIC"
msgid "There are little fins coming out of that sand. I'm backing up."
msgstr "沙裡冒出來好幾片小魚鰭。我要退後了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKITTENSPAWNER.INACTIVE"
msgid "Nothing's coming out of the sand right now. Let's not change that."
msgstr "沙裡現在沒動靜。我們別去打擾。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_FIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_FIN"
msgid "One fin I don't have to watch coming at me."
msgstr "這回不用盯著魚鰭朝我游過來了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_GILLS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_GILLS"
msgid "I don't know how those let it breathe underwater. School never covered that."
msgstr "不知道那東西怎麼讓它在水底呼吸。學校也沒講這個。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_TEETHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK_TEETHHAT"
msgid "Now I've got shark teeth over my head instead of behind me."
msgstr "現在鯊魚牙在我頭上，不在我身後了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARX"
msgid "They caught up already. I should've taken the lighter boat."
msgstr "這麼快就追上來了。早知道該坐那條輕一點的船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECK"
msgid "There's a reason that boat never made it back."
msgstr "那條船沒能回去，肯定有原因。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_ENTRANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_ENTRANCE"
msgid "Take a look at the entrance. Tell me if anything around it moves."
msgstr "看看入口。旁邊有東西動就告訴我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIPWRECKED_EXIT"
msgid "I want a closer look at the exit. Can you watch my back?"
msgstr "我想湊近看看出口。幫我留意身後好嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LIMESTONE"
msgid "Keep the limestone rounds in the pouch till we need them."
msgstr "石灰岩彈先放在袋裡，要用時再拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN"
msgid "I brought the obsidian rounds. Who packed the slingshot?"
msgstr "黑曜石彈我帶了。誰拿彈弓？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POISON"
msgid "I brought the stink bombs. Who packed the slingshot?"
msgstr "臭彈我帶了。誰拿彈弓？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_TAR"
msgid "Keep the tar rounds in the pouch till we need them."
msgstr "焦油彈先放在袋裡，要用時再拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN"
msgid "This slithering slingshot band came off something. Look for the rest of it."
msgstr "滑行彈弓皮筋是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN"
msgid "This obsidian slingshot frame came off something. Look for the rest of it."
msgstr "黑曜石彈弓框是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_TAR"
msgid "This slingshot tar grip came off something. Look for the rest of it."
msgstr "焦油彈弓手柄是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOTMACHINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLOTMACHINE"
msgid "I can lose all my money without turning a handle. What's the point?"
msgstr "不用搖把手我也能把錢花光。這有什麼意思？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE"
msgid "A snake. Where'd it come from? I was looking right at the ground."
msgstr "蛇？哪裡來的？我一直看著地上呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNING"
msgid "The viney bush caught fire. Somebody get water!"
msgstr "藤蔓叢著火了！誰去拿點水！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.BURNT"
msgid "The viney bush is already burnt through. Too late to bring a bucket."
msgstr "藤蔓叢都燒透了。現在拿桶也晚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.CHOPPED"
msgid "That's all the vines I can cut without checking for snakes."
msgstr "不先看看有沒有蛇的話，藤蔓就砍到這裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEDEN.GENERIC"
msgid "If something starts moving in those vines, I'm stepping back."
msgstr "藤裡有什麼動起來的話，我就往後退。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKEOIL"
msgid "Keep that snake oil. I might need it later."
msgstr "蛇油先留著。晚點我可能用得上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKIN"
msgid "It's got the pattern without the snake in it. Good."
msgstr "花紋還在，蛇不在。很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKESKINHAT"
msgid "The rain rolls right off. Wish my shoes did that."
msgstr "雨水一滴不沾地滑下來了。鞋也能這樣就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAKE_POISON"
msgid "See the fangs? Don't wait to find out what's on them."
msgstr "看見毒牙了嗎？別等咬到了才知道有毒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH"
msgid "It's following the boat. I don't have anything to throw it."
msgstr "它跟著船。我沒東西可以丟給它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOLOFISH_DEAD"
msgid "We've got the dead dogfish. Now someone's got to clean it."
msgstr "死狗魚到手了。現在還得有人收拾它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LAUNCHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LAUNCHER"
msgid "It throws the spear for me. Doesn't do the aiming, though."
msgstr "不用我丟矛。準頭還得靠我自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_OBSIDIAN"
msgid "Let me get a feel for the obsidian spear before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試黑曜石長矛的手感。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_POISON"
msgid "Stand back a little. I want to see what the poison spear can do."
msgstr "後退一點。我想看看毒矛好不好用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUNGRAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUNGRAY"
msgid "I can smell it before I can see it. I don't need to get any closer."
msgstr "還沒看見就聞到了。我不用再往前走了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.ABANDONED"
msgid "Nobody left on board. Only thing moving is the water."
msgstr "船上沒人了。只有海水還在動。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT.GENERIC"
msgid "Somebody's still over there. Let's see what they've got to say."
msgstr "那裡還有人。過去聽聽要說什麼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_BURNT"
msgid "It managed to burn and sink. Rough day."
msgstr "不光燒了，還沉了。真倒黴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_1"
msgid "The sextant was in the wreck. I bet it used to get someone home."
msgstr "在沉船裡找到的六分儀。從前肯定帶誰回過家。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_2"
msgid "I don't know what a toy boat is worth here. I could ask."
msgstr "不知道玩具船在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_3"
msgid "Don't lose the bottle candle now that we finally found it."
msgstr "好不容易找到酒瓶蠟燭，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_4"
msgid "Don't lose the odd trinket now that we finally found it."
msgstr "好不容易找到奇怪的小飾品，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKEN_BOAT_TRINKET_5"
msgid "Only found one boot in the wreck. Some help that is."
msgstr "沉船裡只找到一隻靴子。這能有什麼用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTELESCOPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTELESCOPE"
msgid "I can see the next island from here. Can I get there without rowing?"
msgstr "從這裡能看到下一個島。能不能不划船就過去？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFBOARD_ITEM"
msgid "I'll carry the board. Somebody else can go first."
msgstr "衝浪板我來拿。誰想試誰先上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATOSOUFFLE"
msgid "The sweet potato souffle can cool off while I find somewhere to sit."
msgstr "先讓甘薯蛋奶酥涼一涼。我去找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO"
msgid "If I roast this, I'm not sharing the crispy parts."
msgstr "烤了以後，焦脆的那塊可不分。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_COOKED"
msgid "I'll try the cooked sweet potato. Save me a bite."
msgstr "熟甘薯我想試試。給我留一口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_OVERSIZED"
msgid "Too big to fit in my bag. That's a good problem to have."
msgstr "大得塞不進包。這樣的問題我倒不嫌多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_PLANTED"
msgid "There's food under those leaves. I have to wait, don't I?"
msgstr "葉子底下就是吃的。我還得等，對吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEET_POTATO_SEEDS"
msgid "Somebody mark where we plant the stellar seeds. I forget these things."
msgstr "種圓形種子的地方做個記號。過幾天我就忘了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH"
msgid "Stop pointing that at me. I get it, you're a swordfish."
msgstr "別把嘴尖對著我。我知道你是劍魚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORDFISH_DEAD"
msgid "Pointy end's still pointy. Pick it up from the back."
msgstr "嘴還是尖的，從後頭拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR"
msgid "It stuck to my hand. Now it's on my other hand."
msgstr "先粘住一隻手。現在另一隻也沾上了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARLAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARLAMP"
msgid "Good light. I'll try not to get tar on the handle."
msgstr "蠻亮。我儘量不讓手柄也沾上焦油。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARSUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TARSUIT"
msgid "It sticks to me and everything I touch. Great."
msgstr "粘我身上，也粘我碰的每樣東西。真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.LOWFUEL"
msgid "Keep some fuel by the tar extractor. We'll need it soon."
msgstr "在焦油提取器旁放點燃料吧。很快就要用到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.OFF"
msgid "The tar extractor isn't running. Check it before we start."
msgstr "焦油提取器沒開。啟動前先檢查一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_EXTRACTOR.ON"
msgid "I'll leave the tar extractor on until it's done."
msgstr "讓焦油提取器開著吧，等它忙完再關。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_POOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_POOL"
msgid "I see the slick. I'm keeping my oar out of it."
msgstr "看見那層油了。槳別伸進去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAR_TRAP"
msgid "I can feel it sticking just by looking at it."
msgstr "光看都覺得要被粘住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BASE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BASE"
msgid "It has places to put things. That's the part I understand."
msgstr "上面有幾個能裝東西的地方。這個我看明白了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_BOX"
msgid "One box. Now all I need is the machine it belongs to."
msgstr "找到個盒子。現在還得找到該裝它的機器。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_CRANK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_CRANK"
msgid "A crank. Something's expecting me to turn this."
msgstr "一個曲柄。看來得裝到什麼上面去轉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_POTATO"
msgid "Looks like a potato. I already checked, it's not lunch."
msgstr "像個馬鈴薯。我確認過了，不能拿來吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_RING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_SW_RING"
msgid "I don't think I'm supposed to wear this ring."
msgstr "這個環應該不是拿來戴的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESCOPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESCOPE"
msgid "I can check if there's land before we go all the way out there."
msgstr "不用劃那麼遠就能先看看有沒有陸地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THATCHPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THATCHPACK"
msgid "Light enough to carry. It'll be nice until it rains."
msgstr "揹著蠻輕。只要不下雨就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDALPOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDALPOOL"
msgid "There's a little sea left in the hole. Anything else in there?"
msgstr "坑裡留了一點海水，裡頭還有別的東西嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDAL_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIDAL_PLANT"
msgid "If you're taking some tidal plant, leave a bit for later."
msgstr "要摘潮間帶植物的話，留點下次再來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGEREYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGEREYE"
msgid "It's unsettling how well it still looks back."
msgstr "它居然還能看得像在盯著我，怪嚇人的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGERSHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIGERSHARK"
msgid "A shark that hunts like a cat. I hate that it can do both."
msgstr "鯊魚還能像貓那樣撲過來。兩樣我都不想碰上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIROEMISU
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TIROEMISU"
msgid "The tiroemisu smells good. I get the first bite, right?"
msgstr "提卵米蘇聞起來不錯。我可以吃第一口吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOUCAN"
msgid "That's a lot of beak to carry around all day."
msgstr "頂著那麼大的嘴過一天，怪累的吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNET"
msgid "I'll trail it behind me. Get ready to help when I pull."
msgstr "我把網拖在後面。收的時候來幫我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.GENERIC"
msgid "Get one end of the trawl net. I'll lift the other."
msgstr "你提拖網一頭，我抬另一頭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOON"
msgid "Quick, pull the trawl net aboard. There isn't much of it left above water!"
msgstr "快把拖網拉上船。露出水面的部分不多了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAWLNETDROPPED.SOONISH"
msgid "The trawl net is starting to sink. Let's work on getting it back."
msgstr "拖網開始往下沉了。想辦法收回來吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_13
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_13"
msgid "I don't know what an orange soda is worth here. I could ask."
msgstr "不知道橘子汽水在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_14"
msgid "I don't know what a voodoo doll is worth here. I could ask."
msgstr "不知道巫毒人偶在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_15
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_15"
msgid "I've got room in my bag for the ukulele, if nobody else wants it."
msgstr "沒人要尤克里裡的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_16
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_16"
msgid "Don't lose the license plate now that we finally found it."
msgstr "好不容易找到車牌，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_17
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_17"
msgid "I've got room in my bag for the old boot, if nobody else wants it."
msgstr "沒人要舊靴子的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_18"
msgid "Don't lose the ancient vase now that we finally found it."
msgstr "好不容易找到古代花瓶，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_19
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_19"
msgid "I don't know what a brain cloud pill is worth here. I could ask."
msgstr "不知道腦雲丸在這裡值多少。我可以去問問。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_20
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_20"
msgid "Don't lose the sextant now that we finally found it."
msgstr "好不容易找到六分儀，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_21
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_21"
msgid "I've got room in my bag for the toy boat, if nobody else wants it."
msgstr "沒人要玩具船的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_22
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_22"
msgid "I've got room in my bag for the wine bottle candle, if nobody else wants it."
msgstr "沒人要酒瓶蠟燭的話，我包裡還能裝下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_23
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_IA_23"
msgid "Don't lose the broken aac device now that we finally found it."
msgstr "好不容易找到損壞的溝通輔助裝置，別再弄丟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALBOUILLABAISSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALBOUILLABAISSE"
msgid "The tropical bouillabaisse smells good. I get the first bite, right?"
msgstr "熱帶魚湯聞起來不錯。我可以吃第一口吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPICALFAN"
msgid "I'd keep using it if it didn't move my hair into my mouth."
msgstr "要不是一直把頭髮吹進嘴裡，我還想接著扇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUNACAN"
msgid "Pull the lid back. Lunch is ready."
msgstr "把蓋拉開，午餐就有了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURBINE_BLADES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURBINE_BLADES"
msgid "Those could move some air. Keep the sharp edge away from my bag."
msgstr "能扇起不少風。尖的那邊離我的包遠點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN"
msgid "Anybody using the terra firma forger? I could use a turn."
msgstr "有人在用土地鍛造器嗎？我正想用一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ASH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ASH"
msgid "Try a strip of ashy turf by the door. See how it looks."
msgstr "門口鋪一條灰燼地皮試試，看看效果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEACH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEACH"
msgid "How much beach turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少沙灘地皮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_JUNGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_JUNGLE"
msgid "The jungle turf can go here. I'm tired of carrying it."
msgstr "叢林地皮就鋪這裡吧。我搬累了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MAGMAFIELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MAGMAFIELD"
msgid "How much magma turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少岩漿岩地皮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MEADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MEADOW"
msgid "How much meadow turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少草甸地皮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SNAKESKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SNAKESKIN"
msgid "Let's lay the snakeskin rug before putting all the furniture back."
msgstr "先把蛇皮地毯鋪好，再把東西搬回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_TIDALMARSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_TIDALMARSH"
msgid "How much tidal marsh turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少潮澤地皮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VOLCANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VOLCANO"
msgid "Try a strip of volcano turf by the door. See how it looks."
msgstr "門口鋪一條火山地皮試試，看看效果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER"
msgid "That wind's picking everything up. Hang on to the boat!"
msgstr "風把東西都捲起來了。抓緊船！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER_SEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWISTER_SEAL"
msgid "That little seal made all that wind?"
msgstr "那麼大的風，就這隻小海豹弄出來的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VENOMGLAND"
msgid "Handle it from the outside. I want the poison to stay in it."
msgstr "從外邊拿。我可不想讓裡頭的毒漏出來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VINE"
msgid "It bends better than rope I made in class. That's not saying much."
msgstr "比我上手工課搓的繩子還好彎。也沒什麼好誇的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO"
msgid "That's an entire mountain I'd rather admire from the beach."
msgstr "整座山就站在沙灘上看吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANOSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANOSTAFF"
msgid "I could call down rocks with this. I'd better not do it under a roof."
msgstr "能用它叫石頭砸下來。我最好不要站在屋頂底下試。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.GENERIC"
msgid "It takes snacks. I'd like to know how many before we start."
msgstr "它收吃的。開始之前能先告訴我要多少嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_ALTAR.OPEN"
msgid "It's open. Put the food in before I change my mind."
msgstr "開了。趁我還沒改主意，把吃的放進去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_EXIT"
msgid "Outside. Where the ground doesn't have to be hot."
msgstr "出去吧。到地面沒那麼燙的地方去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_SHRUB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLCANO_SHRUB"
msgid "Somehow it's still standing in all that ash."
msgstr "周圍全是灰，它居然還站著。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.ATTACKER"
msgid "%s, take a breath. What's this about?"
msgstr "%s，先冷靜。這是怎麼回事？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.FIRESTARTER"
msgid "%s, I can smell burning from here. What happened?"
msgstr "%s，我在這裡都聞見焦味了。怎麼回事？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GENERIC"
msgid "%s, show me how you stay on that board."
msgstr "%s，教我怎麼在板上站穩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.GHOST"
msgid "%s, don't drift out past the breakers. I'll be back."
msgstr "%s，別飄到浪外頭。我會回來的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.MURDERER"
msgid "%s, drop it. You're done hurting people."
msgstr "%s，把手上的東西放下。別再傷人了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALANI.REVIVER"
msgid "%s, thanks for bringing them back. Let me carry the board today."
msgstr "%s，謝謝你把人救回來。今天我替你拿板。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLYINTRO_DEBRIS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALLYINTRO_DEBRIS"
msgid "I hope whatever broke into all these pieces was empty when it happened."
msgstr "碎成這麼多塊。希望壞掉的時候裡頭沒人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE"
msgid "I can handle the sea wall. You keep the boat steady."
msgstr "海牆交給我。你穩住船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM"
msgid "If the sea wall comes loose at sea, I'm making you go get it."
msgstr "海牆要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE"
msgid "I should make space in my bag for the limestone wall."
msgstr "我應該在包裡給石灰岩牆騰點位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_LIMESTONE_ITEM"
msgid "I'll carry the limestone wall if somebody else carries the rest."
msgstr "其他東西誰拿一下，石灰岩牆我來帶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.GENERIC"
msgid "A chest that can float. Now I can lose my stuff farther from home."
msgstr "能浮起來的箱子。這下我的東西能丟得更遠了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE"
msgid "More room in the chest. I want to know why it still floats."
msgstr "箱子能裝更多了。我想知道它怎麼還浮得起來。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCROCODOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERCROCODOG"
msgid "Great. It can swim faster than I can row."
msgstr "很好。它遊得比我劃得還快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERYGRAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERYGRAVE"
msgid "Somebody chose a quiet spot. I'll keep my voice down."
msgstr "有人找了塊清靜地方。我說話小聲點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BLUE"
msgid "I've never been next to a fish that made my boat look this small."
msgstr "還沒遇見過哪條魚，能讓我的船看起來這麼小。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BUBBLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_BUBBLES"
msgid "Those bubbles are coming from something. Follow them, slowly."
msgstr "底下有東西在冒泡。慢慢跟著。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_BLUE"
msgid "That smell's worse than I thought it would be."
msgstr "這味道比我想的還難受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_WHITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_CARCASS_WHITE"
msgid "Whole whale out here. I'm sad it ended up like that."
msgstr "這麼大一頭鯨就留在這裡了。真可惜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_TRACK"
msgid "I see the next patch of bubbles. That's where we're going."
msgstr "下一片氣泡我看見了。往那邊劃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_WHITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHALE_WHITE"
msgid "It's not moving out of our way. Turn the boat around."
msgstr "它沒有要讓的意思。把船調頭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.ATTACKER"
msgid "%s, put that down. That's enough."
msgstr "%s，放下。夠了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.FIRESTARTER"
msgid "%s, don't let the fire reach the trees."
msgstr "%s，別讓火燒到樹上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GENERIC"
msgid "%s, got a spare banana? I'll trade you."
msgstr "%s，還有香蕉嗎？我拿東西跟你換。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.GHOST"
msgid "%s, hang on. I've got to find you a heart."
msgstr "%s，撐一下。我得去給你找顆心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.MURDERER"
msgid "%s, enough! Back up. Now."
msgstr "%s，夠了！現在就退開。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR.REVIVER"
msgid "%s, good job. You earned my last banana."
msgstr "%s，幹得好。最後一根香蕉歸你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_CROWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_CROWN"
msgid "Small crown. That must be for a very particular head."
msgstr "這麼小的王冠，肯定挑頭型。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_UNLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILBUR_UNLOCK"
msgid "He's got the crown. Let him decide where it goes."
msgstr "王冠是他的，讓他決定戴哪裡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBORE"
msgid "It looks at me the way I look at somebody in my seat."
msgstr "它看我的樣子，像我看見有人佔了座位。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHEAD"
msgid "I was going to ask what that smell was. Never mind."
msgstr "本來還想問那股味道是什麼。知道了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILDBOREHOUSE"
msgid "I got this far without waking anybody. I'll stop here."
msgstr "走這麼近還沒弄醒誰。我就停這裡吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINDSTAFF"
msgid "Stick for the sails. A lot easier than arguing with the wind."
msgstr "管風帆的棍子。比跟風過不去省事多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIND_CONCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WIND_CONCH"
msgid "Whatever it does, I'm facing it away from my ears."
msgstr "不管它能幹什麼，都先別對著我耳朵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERBISQUE"
msgid "The wobster bisque can cool off while I find somewhere to sit."
msgstr "先讓龍蝦湯涼一涼。我去找個地方坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTERDINNER"
msgid "I had plans. Then somebody made wobster dinner."
msgstr "我原本還有事要做。現在有人做了龍蝦晚宴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.ATTACKER"
msgid "%s, put the weapon away before you come aboard."
msgstr "%s，先把武器收起來，再上船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.FIRESTARTER"
msgid "%s, douse that before it reaches the rigging."
msgstr "%s，快撲滅，別燒到帆索。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GENERIC"
msgid "%s, taking the Sea Legs out today?"
msgstr "%s，今天打算開海腿號出海嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.GHOST"
msgid "%s, stay by the dock. I'll find a heart."
msgstr "%s，在碼頭等。我去找顆心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.MURDERER"
msgid "%s, that's enough. Get away from them."
msgstr "%s，夠了。離他們遠點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS.REVIVER"
msgid "%s, you got them back safe. Thanks, captain."
msgstr "%s，人平安回來了。謝謝船長。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGSHAT"
msgid "I'll try the lucky hat on. Does it flatten my hair?"
msgstr "我戴一下幸運帽。會把頭髮壓扁嗎？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_CAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_CAGE"
msgid "You know about the lock. I'm looking for the key."
msgstr "鎖你清楚。我在找鑰匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY1"
msgid "I'll keep the bone key in my pocket where it won't get lost."
msgstr "骨鑰匙先放兜裡，免得弄丟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY2"
msgid "I've got the golden key. Which lock takes it?"
msgstr "金鑰匙拿到了。它能開什麼鎖？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODLEGS_KEY3"
msgid "I've got the iron key. Which lock takes it?"
msgstr "鐵鑰匙拿到了。它能開什麼鎖？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC_TROPICAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC_TROPICAL"
msgid "WX can bring the island music along. Turn it down if I doze off."
msgstr "WX 能把島上的音樂一路帶著了。我要是睡著了，音量調低點。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_POISON"
msgid "WX, see if this helps with the poison. I'm not testing it myself."
msgstr "WX，看看這個能不能防毒。我可不親自試。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_WATER"
msgid "A waterproof circuit. Wish WX could waterproof my shoes too."
msgstr "防水電路。希望 WX 也能幫我把鞋弄成防水的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.1"
msgid "Go ahead and finish. I'm in no hurry to get soaked."
msgstr "你先忙完。我還沒急著下水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.EMBARK.INUSE.2"
msgid "I can wait. This is the only dry spot I've found all day."
msgstr "我等得起。這是我今天找到的唯一一塊乾地。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.1"
msgid "First get it out of the water. Then I'll erase it."
msgstr "先把紙從水裡撈出來，再說擦字的事。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.ERASE_PAPER.FLOODED.2"
msgid "Great. Even the eraser needs a dry desk."
msgstr "好吧，連橡皮都得找張幹桌子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.1"
msgid "Can't reach with the hull in the way."
msgstr "隔著船底，夠不著。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.GENERIC.UNDERBOAT.2"
msgid "Let me row aside first. I can't reach through wood."
msgstr "先把船劃開。我又不能把手穿過木板。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.1"
msgid "I'll wait until they're finished with the boat."
msgstr "等他們把船檢查完再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.INSPECTBOAT.INUSE.2"
msgid "Sure, check the whole hull. I can sit here."
msgstr "檢查仔細點。我在這裡坐會兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.1"
msgid "In a minute. Let me finish up here."
msgstr "稍等，先讓我把這邊的事處理完。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.BUSY.2"
msgid "I'm still busy. The next island can wait."
msgstr "我這邊還忙，下一個島等著吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.1"
msgid "Huh. That route's closed."
msgstr "咦，那條路走不通。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.MIGRATE.WORLDNOTAVAILABLE.2"
msgid "No way across right now. I'll put my bag down."
msgstr "現在過不去。我先把包放下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.1"
msgid "A dry workbench would be nice. A dry anything, actually."
msgstr "有張幹工作台就好了。哪怕有塊乾地也可以。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.FLOODED.2"
msgid "Can't work here till the water goes down."
msgstr "等水退了才能在這裡做東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.1"
msgid "Five more minutes. Then you can give me work."
msgstr "再睡五分鐘，你再給我派活。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.OPEN_CRAFTING.SLEEPING.2"
msgid "I'm asleep. Put the tools down."
msgstr "我還在睡。把工具放下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.1"
msgid "It passed inspection. Mine, anyway."
msgstr "檢查通過。至少我覺得沒問題。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ACTIONFAIL.REPAIRBOAT.GENERIC.2"
msgid "I'll patch it when there's a hole to patch."
msgstr "真有洞的時候我會補。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.1"
msgid "I took the shortcut and got exactly nowhere."
msgstr "抄了條近路，結果哪裡都沒去成。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BERMUDA_FAIL.2"
msgid "Guess I'll take the long way across."
msgstr "看來只能繞遠路了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.1"
msgid "Pass me the patches. One of those cracks is leaking."
msgstr "把補丁遞給我。有條裂縫在漏。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_DAMAGED.2"
msgid "That's a leak. Anybody bring a repair kit?"
msgstr "漏水了。有人帶修船套件嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.1"
msgid "This boat's going down. Which way's the beach?"
msgstr "船快沉了。沙灘在哪邊？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING.2"
msgid "I've got water around my ankles. Get us to shore."
msgstr "水沒到腳踝了。快靠岸。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.1"
msgid "We're out of time! Shore, anywhere!"
msgstr "沒時間了！哪邊有岸就往哪邊劃！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINKING_IMMINENT.2"
msgid "It's going under! Move!"
msgstr "船要沉了！快走！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.1"
msgid "I had it! How does it run sideways that fast?"
msgstr "差一點就抓住了！它橫著跑怎麼還這麼快？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_CRAB_ESCAPE.2"
msgid "Fine, hide. I didn't want to dig anyway."
msgstr "躲吧。我本來就不想挖。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.1"
msgid "Save the magic for somewhere it'll actually work."
msgstr "留到能用的地方再施法吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAGIC_FAIL.2"
msgid "I knew that looked too easy."
msgstr "我就知道沒這麼簡單。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.1"
msgid "Where'd the horizon go?!"
msgstr "海平線呢？！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_LOSECONTROL.2"
msgid "I've lost my bearings. Keep your hands inside the boat."
msgstr "我分不清方向了。手別伸出船外。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.1"
msgid "I can see the water again. That's a start."
msgstr "又能看見海面了。至少有點進展。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_RETURN.2"
msgid "Next time somebody else steers through that."
msgstr "下次過這片霧，換個人掌舵。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.1"
msgid "Slow down. We can't see what's ahead."
msgstr "慢點，前面什麼都看不見。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MAPWRAP_WARN.2"
msgid "I'd rather not find out what's in that fog by hitting it."
msgstr "霧裡有什麼，我可不想撞上才知道。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.1"
msgid "One more haul and I can call today a good day."
msgstr "再挖到一箱，今天就算沒白忙。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_MORETREASURE.2"
msgid "Guess I can put off my nap for one more chest."
msgstr "為了再開一箱，我可以晚點睡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.1"
msgid "I can dig all I want. It still won't grow here."
msgstr "挖多少坑都一樣，它在這裡長不了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_PLANT.2"
msgid "Save it for an island with the right dirt."
msgstr "留著吧，等找到合適的島再種。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.1"
msgid "I'm not rowing in circles over a map of somewhere else."
msgstr "我才不拿著別處的圖在這片海上繞圈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_OTHER_WORLD_TREASURE.2"
msgid "Put the map away till we reach the right place."
msgstr "先把地圖收起來，等到了地方再看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.1"
msgid "Sea hounds. Of course they can swim."
msgstr "海獵犬。它們果然會游泳。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_SHARX.2"
msgid "Watch the fins. Those aren't friendly."
msgstr "留意那些背鰭。它們可沒打算打招呼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.1"
msgid "I hope that weight is fish and not rocks."
msgstr "這麼沉，希望撈到的是魚。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TRAWL_FULL.2"
msgid "That's enough trawling. Let's see what we caught."
msgstr "拖到這裡吧，看看撈到了什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.1"
msgid "We found the spot. Who's holding the shovel?"
msgstr "地方找到了。鏟子在誰手裡？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE.2"
msgid "If this turns out to be another empty box, I'm going home."
msgstr "再挖到空箱，我就回去了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.1"
msgid "There it is! Move over, I want to see inside."
msgstr "就在這裡！讓一下，我要看看裡面。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_TREASURE_DISCOVER.2"
msgid "Treasure. For once the map was right."
msgstr "是寶藏。這回地圖總算沒畫錯。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.1"
msgid "Get away from those shadows! Rocks are coming down!"
msgstr "離地上的影子遠點！有石頭要掉下來了！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_VOLCANO_ERUPT.2"
msgid "Great, it's raining rocks. Find cover!"
msgstr "好極了，要下石頭了。找地方躲！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.1"
msgid "Caught it! Let's do that again."
msgstr "趕上浪了！再來一次。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WAVE_BOOST.2"
msgid "Now that was worth getting my socks wet."
msgstr "這一趟，襪子濕了也值。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.1"
msgid "Something big's right under us. Steady."
msgstr "有個大傢伙就在下面。穩住。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_BEAST_NEARBY.2"
msgid "Ready the gear. I think we found it."
msgstr "把傢伙準備好。我想我們找到了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.1"
msgid "It got away. I'm resting my arms for a minute."
msgstr "跑掉了。我得休息休息胳膊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL.2"
msgid "Any sign of it? All I can see is water."
msgstr "還有蹤跡嗎？我只看得見海水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.1"
msgid "I can't pick out bubbles in waves like these."
msgstr "浪成這樣，根本看不見氣泡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.ANNOUNCE_WHALE_HUNT_LOST_TRAIL_SPRING.2"
msgid "Call it off. I'm busy keeping the boat upright."
msgstr "算了吧。我光顧著讓船別翻了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AERODYNAMICHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AERODYNAMICHAT.1"
msgid "The sleek hat can go on the hook when I get home."
msgstr "回家以後，流線型帽子可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AERODYNAMICHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.AERODYNAMICHAT.2"
msgid "Think the sleek hat goes with my uniform? I'm wearing it either way."
msgstr "流線型帽子配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.1"
msgid "I hope I don't need the anti venom. Bring it anyway."
msgstr "希望用不上抗毒血清。還是帶上吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ANTIVENOM.2"
msgid "I'll keep the anti venom handy. I never know what I'll step on."
msgstr "抗毒血清得隨身帶著。誰知道我會踩到什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORCACTUS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORCACTUS.1"
msgid "I'll try the cactus armor, as long as I can still swing a bat."
msgstr "只要還能揮球棒，仙人掌護甲我就願意穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORCACTUS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORCACTUS.2"
msgid "I hope the cactus armor is easier to take off than it is to put on."
msgstr "希望仙人掌護甲脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLIMESTONE.1"
msgid "I hope the limestone suit is easier to take off than it is to put on."
msgstr "希望石灰岩甲脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORLIMESTONE.2"
msgid "Let me move around in the limestone suit before we go anywhere."
msgstr "出發前，讓我穿著石灰岩甲活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOROBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOROBSIDIAN.1"
msgid "I hope the obsidian armor is easier to take off than it is to put on."
msgstr "希望黑曜石護甲脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOROBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOROBSIDIAN.2"
msgid "If the obsidian armor fits over my uniform, I'll take it."
msgstr "黑曜石護甲能套在制服外面的話，我就穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORSEASHELL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORSEASHELL.1"
msgid "If the seashell suit fits over my uniform, I'll take it."
msgstr "海貝甲能套在制服外面的話，我就穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORSEASHELL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMORSEASHELL.2"
msgid "I hope the seashell suit is easier to take off than it is to put on."
msgstr "希望海貝甲脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_LIFEJACKET.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_LIFEJACKET.1"
msgid "Let me move around in the life jacket before we go anywhere."
msgstr "出發前，讓我穿著救生衣活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_LIFEJACKET.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_LIFEJACKET.2"
msgid "I hope the life jacket is easier to take off than it is to put on."
msgstr "希望救生衣脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.1"
msgid "Let me move around in the snakeskin jacket before we go anywhere."
msgstr "出發前，讓我穿著蛇皮夾克活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_SNAKESKIN.2"
msgid "I hope the snakeskin jacket is easier to take off than it is to put on."
msgstr "希望蛇皮夾克脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WINDBREAKER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WINDBREAKER.1"
msgid "Let me move around in the windbreaker before we go anywhere."
msgstr "出發前，讓我穿著防風衣活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WINDBREAKER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ARMOR_WINDBREAKER.2"
msgid "I hope the windbreaker is easier to take off than it is to put on."
msgstr "希望防風衣脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BABYOX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BABYOX.1"
msgid "That baby water beefalo is hard to keep track of."
msgstr "一轉眼就找不到那隻小水牛了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BABYOX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BABYOX.2"
msgid "Is that a baby water beefalo? Hold still, I want a better look."
msgstr "那是小水牛嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHIN.1"
msgid "I'll leave the bottlenose ballphin alone if it leaves me alone."
msgstr "只要瓶鼻海豚不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHIN.2"
msgid "Is that a bottlenose ballphin? Hold still, I want a better look."
msgstr "那是瓶鼻海豚嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHINHOUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHINHOUSE.1"
msgid "I can see the ballphin palace from here. Want to go look?"
msgstr "從這裡能看見海豚宮殿。要過去看看嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHINHOUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BALLPHINHOUSE.2"
msgid "That's the ballphin palace. I wonder if anyone's inside."
msgstr "那是海豚宮殿。不知道裡面有沒有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.1"
msgid "Sort the bamboo out from the rest of the pile for me, will you?"
msgstr "能幫我把竹子從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOO.2"
msgid "I'll carry the bamboo if somebody else carries the rest."
msgstr "其他東西誰拿一下，竹子我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNING.1"
msgid "Do we have time to save the bamboo patch? That fire's getting bigger."
msgstr "現在還來得及救竹叢嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNING.2"
msgid "That's smoke coming off the bamboo patch. Back up a little."
msgstr "是竹叢在冒煙。往後退一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNT.1"
msgid "The bamboo patch is already burnt through. Too late to bring a bucket."
msgstr "竹叢都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.BURNT.2"
msgid "So much for the bamboo patch. Is anything under the ash still good?"
msgstr "竹叢算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.CHOPPED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.CHOPPED.1"
msgid "I got all I could from the bamboo patch. No need for another swing."
msgstr "竹叢上能砍的我都砍了。用不著再揮一刀。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.CHOPPED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.CHOPPED.2"
msgid "That's enough chopping for now. What's left of the bamboo patch can stay."
msgstr "先砍到這裡。剩下的竹叢就留著吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.GENERIC.1"
msgid "If you're taking some bamboo patch, leave a bit for later."
msgstr "要摘竹叢的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BAMBOOTREE.GENERIC.2"
msgid "I wonder what the bamboo patch looks like after a good rain."
msgstr "不知道下場雨以後，竹叢會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDAGE_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDAGE_POISON.1"
msgid "Keep the venom strip wrapped up till I need it."
msgstr "毒液繃帶包好，要用的時候再拆。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDAGE_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BANDAGE_POISON.2"
msgid "I hope peeling it off is the worst part."
msgstr "希望最疼的只是撕掉的時候。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BARREL_GUNPOWDER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BARREL_GUNPOWDER.1"
msgid "How much gunpowder barrel do we have now? I lost count."
msgstr "現在有多少火藥桶了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BARREL_GUNPOWDER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BARREL_GUNPOWDER.2"
msgid "If we have any more gunpowder barrel, put it with this batch."
msgstr "還有火藥桶的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERMUDATRIANGLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERMUDATRIANGLE.1"
msgid "I saw the electric isosceles. Let me get a little farther away first."
msgstr "我看見電光三角了。先讓我退遠點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERMUDATRIANGLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BERMUDATRIANGLE.2"
msgid "Heads up. There's an electric isosceles right here."
msgstr "當心，這裡就有電光三角。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIOLUMINESCENCE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIOLUMINESCENCE.1"
msgid "Mark the bioluminescence on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下熒光生物的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIOLUMINESCENCE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BIOLUMINESCENCE.2"
msgid "I want a look at the bioluminescence. Bring us a little closer."
msgstr "我想看看熒光生物。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BISQUE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BISQUE.1"
msgid "Put the bisque where I can reach it. I'll be hungry later."
msgstr "鮮貝濃湯放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BISQUE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BISQUE.2"
msgid "The bisque smells good. I get the first bite, right?"
msgstr "鮮貝濃湯聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_FLUP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_FLUP.1"
msgid "Stand back a little. I want to see what the eyeshot can do."
msgstr "後退一點。我想看看眼睛吹箭好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_FLUP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_FLUP.2"
msgid "Let me get a feel for the eyeshot before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試眼睛吹箭的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_POISON.1"
msgid "Let me get a feel for the poison dart before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試淬毒吹箭的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLOWDART_POISON.2"
msgid "I can take the poison dart, but I'm bringing my bat too."
msgstr "淬毒吹箭可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBER.1"
msgid "How much blubber do we have now? I lost count."
msgstr "現在有多少鯨脂了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBER.2"
msgid "Keep that blubber. I might need it later."
msgstr "鯨脂先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBERSUIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBERSUIT.1"
msgid "Let me move around in the blubber suit before we go anywhere."
msgstr "出發前，讓我穿著鯨脂套裝活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBERSUIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BLUBBERSUIT.2"
msgid "I hope the blubber suit is easier to take off than it is to put on."
msgstr "希望鯨脂套裝脫起來比穿起來容易。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATCANNON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATCANNON.1"
msgid "Who decided a rowboat needed a cannon? I owe them a snack."
msgstr "誰想到給船裝炮的？我得請他吃點東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATCANNON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATCANNON.2"
msgid "I like the cannon. The noise is going to be a problem."
msgstr "我喜歡這門炮。就是開起來太吵。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.1"
msgid "I'm keeping the repair kit within reach this time."
msgstr "這次我把修船套件放在手邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOATREPAIRKIT.2"
msgid "A patch now beats swimming later."
msgstr "現在補一下，總比待會兒游回去好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ARMOURED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ARMOURED.1"
msgid "Go on, knock on it. Hear how solid that is?"
msgstr "敲一下聽聽，多結實。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ARMOURED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ARMOURED.2"
msgid "With that much armor, I can spend less time patching holes."
msgstr "護得這麼嚴實，我就能少補幾個洞。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE.1"
msgid "If the encrusted bumper comes loose at sea, I'm making you go get it."
msgstr "硬殼保險槓要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE.2"
msgid "I'll check the encrusted bumper before we leave the dock."
msgstr "離開碼頭前，我先檢查一下硬殼保險槓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT.1"
msgid "Put the encrusted bumper kit where I can reach it from my seat."
msgstr "把硬殼保險槓套件放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_BUMPER_LIMESTONE_KIT.2"
msgid "I'll check the encrusted bumper kit before we leave the dock."
msgstr "離開碼頭前，我先檢查一下硬殼保險槓套件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.1"
msgid "I'll take the big boat. Fewer trips that way."
msgstr "我坐這條大船，能少跑幾趟。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_CARGO.2"
msgid "If you've got luggage, now's the time to load it."
msgstr "有行李現在就搬上來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ENCRUSTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ENCRUSTED.1"
msgid "Whoever put on all those shells had more patience than me."
msgstr "能把這麼多殼貼上去，真有耐心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ENCRUSTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ENCRUSTED.2"
msgid "Shells on the outside. Dry socks on the inside, hopefully."
msgstr "外面這層歸貝殼。希望裡面能留給我的幹襪子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LANTERN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LANTERN.1"
msgid "I can see the waves without having to hold a light."
msgstr "不用舉著燈也能看清海浪了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LANTERN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LANTERN.2"
msgid "Leave the light on till we find the dock."
msgstr "找到碼頭之前別熄燈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.1"
msgid "Tell me somebody checked those knots."
msgstr "最好有人檢查過這些繩結。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_LOGRAFT.2"
msgid "It's floating. I'll take that as a good sign."
msgstr "還浮著。姑且算個好兆頭。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.1"
msgid "If I keep low, I can stay dry. Maybe."
msgstr "坐低一點，說不定就不會濕。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_RAFT.2"
msgid "It's a raft. I wasn't expecting a seat cushion."
msgstr "竹筏而已，我也沒指望能有坐墊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.1"
msgid "I can pull both oars. You watch where we're going."
msgstr "兩支槳我都能劃。你看著路。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_ROW.2"
msgid "I'll get there. Don't ask how my shoulders feel after."
msgstr "總能劃到。到了別問我肩膀酸不酸。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_SURFBOARD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_SURFBOARD.1"
msgid "Watching Walani do it looked a lot easier."
msgstr "看瓦拉尼站上去時可容易多了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_SURFBOARD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_SURFBOARD.2"
msgid "If I fall off, you're all looking the other way."
msgstr "我要是掉下去，你們都轉過去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.1"
msgid "Keep that torch out of the spray. I need it to see shore."
msgstr "別讓浪打濕火把。我還得靠它找岸。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_TORCH.2"
msgid "Stick it on the boat. I've got enough to hold already."
msgstr "裝在船上吧。我手上拿得夠多了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_WOODLEGS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_WOODLEGS.1"
msgid "Want a ride on the Sea Legs? Ask the captain."
msgstr "想坐海腿號？去問船長。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_WOODLEGS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOAT_WOODLEGS.2"
msgid "That ship's seen rougher water than I have."
msgstr "這船見過的風浪比我多。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_METEOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_METEOR.1"
msgid "If you borrow my joy of Volcanology, put it back where you found it."
msgstr "借我的火山學的樂趣可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_METEOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOOK_METEOR.2"
msgid "Anybody using the joy of Volcanology? I could use a turn."
msgstr "有人在用火山學的樂趣嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOTTLELANTERN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOTTLELANTERN.1"
msgid "I'll be careful with the bottle lantern. Stop looking at me like that."
msgstr "我會小心用水瓶提燈。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOTTLELANTERN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BOTTLELANTERN.2"
msgid "Somebody show me how the bottle lantern works. Keep it short."
msgstr "誰給我演示一下水瓶提燈怎麼用。簡單說就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAINJELLYHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAINJELLYHAT.1"
msgid "How am I going to keep the brain of Thought from falling off?"
msgstr "我要怎麼戴，智慧帽才不會掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAINJELLYHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BRAINJELLYHAT.2"
msgid "The brain of Thought can go on the hook when I get home."
msgstr "回家以後，智慧帽可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUOY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUOY.1"
msgid "That's the buoy. Can we see it from the boat?"
msgstr "那是浮標。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUOY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUOY.2"
msgid "I want a look at the buoy. Bring us a little closer."
msgstr "我想看看浮標。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURIEDTREASURE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURIEDTREASURE.1"
msgid "The X is right here. Somebody hold the map."
msgstr "標記就在這裡。誰幫我拿一下圖。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURIEDTREASURE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BURIEDTREASURE.2"
msgid "Guess I have a good reason to pick up the shovel this time."
msgstr "這回我總算有理由拿鏟子了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNING.1"
msgid "Do we have time to save the viney bush? That fire's getting bigger."
msgstr "現在還來得及救藤蔓叢嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNING.2"
msgid "The viney bush caught fire. Somebody get water!"
msgstr "藤蔓叢著火了！誰去拿點水！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNT.1"
msgid "The viney bush is already burnt through. Too late to bring a bucket."
msgstr "藤蔓叢都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.BURNT.2"
msgid "The viney bush is pretty much ash now. Leave it to cool."
msgstr "藤蔓叢燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.CHOPPED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.CHOPPED.1"
msgid "I got all I could from the viney bush. No need for another swing."
msgstr "藤蔓叢上能砍的我都砍了。用不著再揮一刀。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.CHOPPED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.CHOPPED.2"
msgid "That's enough chopping for now. What's left of the viney bush can stay."
msgstr "先砍到這裡。剩下的藤蔓叢就留著吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.GENERIC.1"
msgid "I'll leave the viney bush alone today. It can keep growing."
msgstr "今天先不動藤蔓叢。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.BUSH_VINE.GENERIC.2"
msgid "If you're taking some viney bush, leave a bit for later."
msgstr "要摘藤蔓叢的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAPTAINHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAPTAINHAT.1"
msgid "Think the captain hat goes with my uniform? I'm wearing it either way."
msgstr "船長帽配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAPTAINHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAPTAINHAT.2"
msgid "I'll try the captain hat on. Does it flatten my hair?"
msgstr "我戴一下船長帽。會把頭髮壓扁嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN.1"
msgid "Give me the obsidian saw blade. Let me see how it feels to use it."
msgstr "把黑曜石鋸片給我。我試試順不順手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CARPENTRY_BLADE_OBSIDIAN.2"
msgid "I'll take the obsidian saw blade with me. Better than walking back for it."
msgstr "我把黑曜石鋸片帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVIAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVIAR.1"
msgid "The caviar can cool off while I find somewhere to sit."
msgstr "先讓魚子醬涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVIAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CAVIAR.2"
msgid "Hand me the caviar. I haven't eaten since we left."
msgstr "把魚子醬遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_KRAKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_KRAKEN.1"
msgid "The quacken figure can sit there. Good thing this one stays put."
msgstr "海妖雕塑就放那裡。幸好這回它不會亂動。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_KRAKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_KRAKEN.2"
msgid "Don't drop the quacken figure. I don't want to go looking for a replacement."
msgstr "別把海妖雕塑摔了。我可不想重新找一個。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_SEAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_SEAL.1"
msgid "Don't drop the seal figure. I don't want to go looking for a replacement."
msgstr "別把海豹雕塑摔了。我可不想重新找一個。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_SEAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_SEAL.2"
msgid "I can get a closer look at the seal figure now. Haven't had that chance before."
msgstr "現在可以湊近看看海豹雕塑了。之前還真沒機會。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TIGERSHARK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TIGERSHARK.1"
msgid "Don't drop the tiger shark figure. I don't want to go looking for a replacement."
msgstr "別把虎鯊雕塑摔了。我可不想重新找一個。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TIGERSHARK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TIGERSHARK.2"
msgid "I can get a closer look at the tiger shark figure now. Haven't had that chance before."
msgstr "現在可以湊近看看虎鯊雕塑了。之前還真沒機會。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TWISTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TWISTER.1"
msgid "Don't drop the sealnado figure. I don't want to go looking for a replacement."
msgstr "別把豹捲風雕塑摔了。我可不想重新找一個。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TWISTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHESSPIECE_TWISTER.2"
msgid "The sealnado figure can sit there. Good thing this one stays put."
msgstr "豹捲風雕塑就放那裡。幸好這回它不會亂動。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMINEA.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMINEA.1"
msgid "Can we stop here for a minute? The chiminea is keeping me warm."
msgstr "我們能在這裡停會兒嗎？靠著防風火爐蠻暖和。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMINEA.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CHIMINEA.2"
msgid "The chiminea is warm enough. Leave me a spot by it."
msgstr "防風火爐夠暖了。旁邊給我留個位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.1"
msgid "The coconade caught fire. Somebody get water!"
msgstr "椰子炸彈著火了！誰去拿點水！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.BURNING.2"
msgid "Do we have time to save the coconade? That fire's getting bigger."
msgstr "現在還來得及救椰子炸彈嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.1"
msgid "Let me get a feel for the coconade before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試椰子炸彈的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONADE.GENERIC.2"
msgid "Stand back a little. I want to see what the coconade can do."
msgstr "後退一點。我想看看椰子炸彈好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT.1"
msgid "Sort the coconut out from the rest of the pile for me, will you?"
msgstr "能幫我把椰子從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT.2"
msgid "How much coconut do we have now? I lost count."
msgstr "現在有多少椰子了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_COOKED.1"
msgid "The roasted coconut can cool off while I find somewhere to sit."
msgstr "先讓烤椰子涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_COOKED.2"
msgid "The roasted coconut smells good. I get the first bite, right?"
msgstr "烤椰子聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_HALVED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_HALVED.1"
msgid "Sort the halved coconut out from the rest of the pile for me, will you?"
msgstr "能幫我把半個椰子從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_HALVED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_HALVED.2"
msgid "How much halved coconut do we have now? I lost count."
msgstr "現在有多少半個椰子了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_SAPLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_SAPLING.1"
msgid "Give the palm tree sapling room to take root. I don't want to move it twice."
msgstr "給椰樹苗留夠紮根的地方。我可不想再挪一次。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_SAPLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COCONUT_SAPLING.2"
msgid "Come on, palm tree sapling. Grow before I forget where I put you."
msgstr "椰樹苗快長吧，免得我忘了種在哪裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.1"
msgid "Why didn't I bring this to first period?"
msgstr "我怎麼沒想到把它帶去上第一節課？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEE.2"
msgid "Let me drink it while it's hot. Then I'll move."
msgstr "讓我趁熱喝完。喝完我就出發。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.1"
msgid "How much coffee beans do we have now? I lost count."
msgstr "現在有多少咖啡豆了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS.2"
msgid "If we have any more coffee beans, put it with this batch."
msgstr "還有咖啡豆的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.1"
msgid "Hand me the roasted coffee beans. I haven't eaten since we left."
msgstr "把烤咖啡豆遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBEANS_COOKED.2"
msgid "The roasted coffee beans smells good. I get the first bite, right?"
msgstr "烤咖啡豆聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.BARREN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.BARREN.1"
msgid "Something's wrong with the coffee plant. It wasn't this droopy before."
msgstr "咖啡叢不對勁。之前沒這麼蔫。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.BARREN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.BARREN.2"
msgid "I'll leave the coffee plant alone till we know how to help it."
msgstr "先別動咖啡叢。等弄清怎麼救它再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.GENERIC.1"
msgid "I wonder what the coffee plant looks like after a good rain."
msgstr "不知道下場雨以後，咖啡叢會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.GENERIC.2"
msgid "I'll leave the coffee plant alone today. It can keep growing."
msgstr "今天先不動咖啡叢。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.PICKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.PICKED.1"
msgid "Nothing left on the coffee plant for now. Give it time."
msgstr "咖啡叢暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.PICKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.PICKED.2"
msgid "I already took what I could from the coffee plant. I'll check back later."
msgstr "咖啡叢上能採的都採了。晚點再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.WITHERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.WITHERED.1"
msgid "The coffee plant looks dried out. Can we still do anything for it?"
msgstr "咖啡叢看起來乾透了。還有辦法救嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.WITHERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.COFFEEBUSH.WITHERED.2"
msgid "Something's wrong with the coffee plant. It wasn't this droopy before."
msgstr "咖啡叢不對勁。之前沒這麼蔫。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL.1"
msgid "If we have any more coral, put it with this batch."
msgstr "還有珊瑚的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL.2"
msgid "Keep that coral. I might need it later."
msgstr "珊瑚先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORALLARVE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORALLARVE.1"
msgid "I'll carry the coral larva if somebody else carries the rest."
msgstr "其他東西誰拿一下，珊瑚幼蟲我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORALLARVE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORALLARVE.2"
msgid "Keep that coral larva. I might need it later."
msgstr "珊瑚幼蟲先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN.1"
msgid "I should make space in my bag for the brainy matter."
msgstr "我應該在包裡給智慧果騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN.2"
msgid "Sort the brainy matter out from the rest of the pile for me, will you?"
msgstr "能幫我把智慧果從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN_ROCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN_ROCK.1"
msgid "Mark the brainy sprout on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下智慧樹的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN_ROCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORAL_BRAIN_ROCK.2"
msgid "That's the brainy sprout. Can we see it from the boat?"
msgstr "那是智慧樹。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORMORANT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORMORANT.1"
msgid "That cormorant is hard to keep track of."
msgstr "一轉眼就找不到那隻鸕鷀了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORMORANT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CORMORANT.2"
msgid "I'll leave the cormorant alone if it leaves me alone."
msgstr "只要鸕鷀不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.GENERIC.1"
msgid "I'll leave the crabbit alone if it leaves me alone."
msgstr "只要兔蟹不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.GENERIC.2"
msgid "Is that a crabbit? Hold still, I want a better look."
msgstr "那是兔蟹嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.HIDDEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.HIDDEN.1"
msgid "Is that a crabbit? Hold still, I want a better look."
msgstr "那是兔蟹嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.HIDDEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRAB.HIDDEN.2"
msgid "I'll leave the crabbit alone if it leaves me alone."
msgstr "只要兔蟹不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABHOLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABHOLE.1"
msgid "Keep quiet around the crabbit den. I don't want anything coming out."
msgstr "經過兔蟹洞的時候小點聲。我可不想把裡面的東西引出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABHOLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRABHOLE.2"
msgid "We can look at the crabbit den from here. That'll do."
msgstr "在這裡看看兔蟹洞就夠了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRATE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRATE.1"
msgid "I'm opening the crate. Let me know if I pick up anything that isn't mine."
msgstr "我開板條箱看看。要是誤拿了別人的東西，告訴我一聲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRATE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CRATE.2"
msgid "I put something in the crate. Remind me to take it out later."
msgstr "我往板條箱裡放了東西。回頭提醒我拿出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CROCODOG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CROCODOG.1"
msgid "Hey, crocodog. You don't have to come any closer."
msgstr "喂，鱷狗。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CROCODOG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CROCODOG.2"
msgid "Let me get my bat before the crocodog gets any ideas."
msgstr "趁鱷狗還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.1"
msgid "Stand back a little. I want to see what the cutlass supreme can do."
msgstr "後退一點。我想看看劍魚短劍好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.CUTLASS.2"
msgid "Let me get a feel for the cutlass supreme before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試劍魚短劍的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BAMBOOTREE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BAMBOOTREE.1"
msgid "We can come back for the bamboo patch after it's had some time to grow."
msgstr "等竹叢長好了，我們可以再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BAMBOOTREE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BAMBOOTREE.2"
msgid "Nothing left on the bamboo patch for now. Give it time."
msgstr "竹叢暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BUSH_VINE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BUSH_VINE.1"
msgid "Nothing left on the viney bush for now. Give it time."
msgstr "藤蔓叢暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BUSH_VINE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_BUSH_VINE.2"
msgid "I already took what I could from the viney bush. I'll check back later."
msgstr "藤蔓叢上能採的都採了。晚點再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_GRASS_WATER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_GRASS_WATER.1"
msgid "I already took what I could from the water grass. I'll check back later."
msgstr "水草上能採的都採了。晚點再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_GRASS_WATER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DEPLETED_GRASS_WATER.2"
msgid "We can come back for the water grass after it's had some time to grow."
msgstr "等水草長好了，我們可以再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORSALFIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORSALFIN.1"
msgid "Sort the dorsal fin out from the rest of the pile for me, will you?"
msgstr "能幫我把背鰭從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORSALFIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DORSALFIN.2"
msgid "Keep that dorsal fin. I might need it later."
msgstr "背鰭先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOUBLE_UMBRELLAHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOUBLE_UMBRELLAHAT.1"
msgid "I'll try the dumbrella on. Does it flatten my hair?"
msgstr "我戴一下雙層傘帽。會把頭髮壓扁嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOUBLE_UMBRELLAHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOUBLE_UMBRELLAHAT.2"
msgid "Think the dumbrella goes with my uniform? I'm wearing it either way."
msgstr "雙層傘帽配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOY.1"
msgid "Look, a doydoy. Try not to scare it off."
msgstr "看，有渡渡鳥。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOY.2"
msgid "I'll leave the doydoy alone if it leaves me alone."
msgstr "只要渡渡鳥不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYBABY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYBABY.1"
msgid "Is that a baby doydoy? Hold still, I want a better look."
msgstr "那是渡渡鳥寶寶嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYBABY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYBABY.2"
msgid "That baby doydoy is hard to keep track of."
msgstr "一轉眼就找不到那隻渡渡鳥寶寶了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG.1"
msgid "Sort the doydoy egg out from the rest of the pile for me, will you?"
msgstr "能幫我把渡渡鳥蛋從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG.2"
msgid "How much doydoy egg do we have now? I lost count."
msgstr "現在有多少渡渡鳥蛋了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_COOKED.1"
msgid "The fried doydoy egg can cool off while I find somewhere to sit."
msgstr "先讓煎渡渡鳥蛋涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_COOKED.2"
msgid "The fried doydoy egg smells good. I get the first bite, right?"
msgstr "煎渡渡鳥蛋聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_CRACKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_CRACKED.1"
msgid "Keep that doydoy egg. I might need it later."
msgstr "渡渡鳥蛋先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_CRACKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYEGG_CRACKED.2"
msgid "If we have any more doydoy egg, put it with this batch."
msgstr "還有渡渡鳥蛋的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYFEATHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYFEATHER.1"
msgid "I should make space in my bag for the doydoy feather."
msgstr "我應該在包裡給渡渡鳥羽毛騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYFEATHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYFEATHER.2"
msgid "How much doydoy feather do we have now? I lost count."
msgstr "現在有多少渡渡鳥羽毛了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYNEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYNEST.1"
msgid "Keep quiet around the doydoy nest. I don't want anything coming out."
msgstr "經過渡渡鳥巢的時候小點聲。我可不想把裡面的東西引出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYNEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DOYDOYNEST.2"
msgid "We can look at the doydoy nest from here. That'll do."
msgstr "在這裡看看渡渡鳥巢就夠了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOON.1"
msgid "I was having a quiet day till that dragoon showed up."
msgstr "那隻呆龍來之前，我過得還蠻清靜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOON.2"
msgid "Hey, dragoon. You don't have to come any closer."
msgstr "喂，呆龍。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONDEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONDEN.1"
msgid "We can look at the dragoon den from here. That'll do."
msgstr "在這裡看看呆龍巢穴就夠了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONDEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONDEN.2"
msgid "Keep quiet around the dragoon den. I don't want anything coming out."
msgstr "經過呆龍巢穴的時候小點聲。我可不想把裡面的東西引出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONEGG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONEGG.1"
msgid "Sort the dragoon egg out from the rest of the pile for me, will you?"
msgstr "能幫我把呆龍蛋從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONEGG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONEGG.2"
msgid "I should make space in my bag for the dragoon egg."
msgstr "我應該在包裡給呆龍蛋騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONHEART.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONHEART.1"
msgid "Sort the dragoon heart out from the rest of the pile for me, will you?"
msgstr "能幫我把呆龍心臟從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONHEART.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONHEART.2"
msgid "If we have any more dragoon heart, put it with this batch."
msgstr "還有呆龍心臟的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONSPIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONSPIT.1"
msgid "Heads up. There's a dragoon saliva right here."
msgstr "當心，這裡就有呆龍唾液。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONSPIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DRAGOONSPIT.2"
msgid "I saw the dragoon saliva. Let me get a little farther away first."
msgstr "我看見呆龍唾液了。先讓我退遠點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUBLOON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUBLOON.1"
msgid "Keep the dubloons somewhere it won't get lifted."
msgstr "把金幣放到不會被偷走的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUBLOON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUBLOON.2"
msgid "I've got dubloons. Is that enough for lunch?"
msgstr "我有金幣。夠買午餐了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BAMBOOTREE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BAMBOOTREE.1"
msgid "Find a spot for the bamboo root before the roots dry out."
msgstr "趁竹根的根還沒乾，先找塊地方種下去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BAMBOOTREE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BAMBOOTREE.2"
msgid "I didn't dig up the bamboo root to leave it in my bag."
msgstr "我費力挖出竹根，可不是為了放在包裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BUSH_VINE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BUSH_VINE.1"
msgid "I didn't dig up the viney bush root to leave it in my bag."
msgstr "我費力挖出藤蔓根，可不是為了放在包裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BUSH_VINE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_BUSH_VINE.2"
msgid "I'll carry the viney bush root. Can you dig the hole?"
msgstr "藤蔓根我來拿。你能挖坑嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_COFFEEBUSH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_COFFEEBUSH.1"
msgid "I'll carry the coffee plant. Can you dig the hole?"
msgstr "咖啡叢我來拿。你能挖坑嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_COFFEEBUSH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_COFFEEBUSH.2"
msgid "I didn't dig up the coffee plant to leave it in my bag."
msgstr "我費力挖出咖啡叢，可不是為了放在包裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_ELEPHANTCACTUS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_ELEPHANTCACTUS.1"
msgid "I didn't dig up the elephant cactus to leave it in my bag."
msgstr "我費力挖出象仙人掌根，可不是為了放在包裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_ELEPHANTCACTUS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUG_ELEPHANTCACTUS.2"
msgid "Find a spot for the elephant cactus before the roots dry out."
msgstr "趁象仙人掌根的根還沒乾，先找塊地方種下去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_LIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_LIMESTONE.1"
msgid "I'll take the limestone dumbbell with me. Better than walking back for it."
msgstr "我把石灰石啞鈴帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_LIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_LIMESTONE.2"
msgid "If you borrow my limestone dumbbell, put it back where you found it."
msgstr "借我的石灰石啞鈴可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_OBSIDIAN.1"
msgid "I'll be careful with the obsidian dumbbell. Stop looking at me like that."
msgstr "我會小心用黑曜石啞鈴。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.DUMBBELL_OBSIDIAN.2"
msgid "Give me the obsidian dumbbell. Let me see how it feels to use it."
msgstr "把黑曜石啞鈴給我。我試試順不順手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EARRING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EARRING.1"
msgid "There's an one true earring. I wonder who's supposed to wear it."
msgstr "這裡有至尊耳環。不知道原本該誰戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EARRING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.EARRING.2"
msgid "The one true earring looks a little fancy for me. I might try it anyway."
msgstr "至尊耳環對我來說有點講究。我還是想試試。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.BARREN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.BARREN.1"
msgid "I'll leave the elephant cactus alone till we know how to help it."
msgstr "先別動象仙人掌。等弄清怎麼救它再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.BARREN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.BARREN.2"
msgid "The elephant cactus looks dried out. Can we still do anything for it?"
msgstr "象仙人掌看起來乾透了。還有辦法救嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.GENERIC.1"
msgid "If you're taking some elephant cactus, leave a bit for later."
msgstr "要摘象仙人掌的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.GENERIC.2"
msgid "I wonder what the elephant cactus looks like after a good rain."
msgstr "不知道下場雨以後，象仙人掌會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.PICKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.PICKED.1"
msgid "Nothing left on the elephant cactus for now. Give it time."
msgstr "象仙人掌暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.PICKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.PICKED.2"
msgid "We can come back for the elephant cactus after it's had some time to grow."
msgstr "等象仙人掌長好了，我們可以再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.WITHERED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.WITHERED.1"
msgid "Something's wrong with the elephant cactus. It wasn't this droopy before."
msgstr "象仙人掌不對勁。之前沒這麼蔫。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.WITHERED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS.WITHERED.2"
msgid "I'll leave the elephant cactus alone till we know how to help it."
msgstr "先別動象仙人掌。等弄清怎麼救它再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_ACTIVE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_ACTIVE.1"
msgid "Heads up. There's a prickly elephant cactus right here."
msgstr "當心，這裡就有易怒的象仙人掌。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_ACTIVE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_ACTIVE.2"
msgid "How much room do we have to go around the prickly elephant cactus?"
msgstr "繞開易怒的象仙人掌還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_STUMP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_STUMP.1"
msgid "There's some elephant cactus stump growing here. Watch where you step."
msgstr "這裡長著象仙人掌樁。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_STUMP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ELEPHANTCACTUS_STUMP.2"
msgid "I'll leave the elephant cactus stump alone today. It can keep growing."
msgstr "今天先不動象仙人掌樁。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FABRIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FABRIC.1"
msgid "If we have any more cloth, put it with this batch."
msgstr "還有布的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FABRIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FABRIC.2"
msgid "Sort the cloth out from the rest of the pile for me, will you?"
msgstr "能幫我把布從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHINHOLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHINHOLE.1"
msgid "That's the shoal. Can we see it from the boat?"
msgstr "那是魚群。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHINHOLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISHINHOLE.2"
msgid "I want a look at the shoal. Bring us a little closer."
msgstr "我想看看魚群。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.BLUEFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.BLUEFISH.1"
msgid "This brings in fish without a whole day of rowing. Excellent."
msgstr "不用劃一天的船也能弄到魚。真好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.BLUEFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.BLUEFISH.2"
msgid "We've got enough fish to cook for everybody now."
msgstr "現在這些魚夠做給大家吃了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.EMPTY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.EMPTY.1"
msgid "We ought to stock it before I start planning dinner."
msgstr "得先放魚卵進去，我才能想晚餐的事。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.EMPTY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.EMPTY.2"
msgid "I set it up. Somebody else can find the eggs."
msgstr "架子我搭好了。魚卵換個人找吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.ONEFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.ONEFISH.1"
msgid "Look, one fish. That's more than I caught all morning."
msgstr "看，有一條魚。比我一早上釣的都多。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.ONEFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.ONEFISH.2"
msgid "One so far. I'll give it time."
msgstr "現在一條。再等等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.REDFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.REDFISH.1"
msgid "The fish farm's filling up. I can stop checking it every five minutes."
msgstr "養魚場裡魚多起來了。我不用每隔五分鐘來看一次了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.REDFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.REDFISH.2"
msgid "Those fish are finally worth the wait."
msgstr "等了這麼久，總算沒白等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.STOCKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.STOCKED.1"
msgid "I'll check back when the fish start moving on their own."
msgstr "等魚自己遊起來，我再回來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.STOCKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.STOCKED.2"
msgid "Still only eggs. I probably shouldn't be staring this hard."
msgstr "現在還都是魚卵。我也不用這麼盯著看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.TWOFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.TWOFISH.1"
msgid "There's another one in there. I'm glad I left the first alone."
msgstr "又多一條。還好我沒動第一條。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.TWOFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_FARM.TWOFISH.2"
msgid "Let them grow a bit. I can wait if there's more coming."
msgstr "讓它們再長一下。有更多的話，我等得起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_TROPICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_TROPICAL.1"
msgid "A tropical fish. It's a lot easier to see than it is to catch."
msgstr "是熱帶魚。看見容易，抓到就難了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_TROPICAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FISH_TROPICAL.2"
msgid "Can we get the tropical fish without me leaning any farther over the side?"
msgstr "不再往船外探身，能抓到熱帶魚嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLAMEGEYSER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLAMEGEYSER.1"
msgid "Heads up. There's a krissure right here."
msgstr "當心，這裡就有地熱火泉。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLAMEGEYSER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLAMEGEYSER.2"
msgid "How much room do we have to go around the krissure?"
msgstr "繞開地熱火泉還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.1"
msgid "It keeps drifting out of reach. Where's the hook?"
msgstr "老是漂到夠不著的地方。鉤子呢？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLOTSAM.2"
msgid "I'll grab it if the current brings it any closer."
msgstr "水流再送近一點，我就伸手拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLUP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLUP.1"
msgid "That's a flup. Stay over there, thanks."
msgstr "是獨眼彈塗魚。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLUP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.FLUP.2"
msgid "I was having a quiet day till that flup showed up."
msgstr "那隻獨眼彈塗魚來之前，我過得還蠻清靜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASHAT.1"
msgid "How am I going to keep the particulate purifier from falling off?"
msgstr "我要怎麼戴，顆粒淨化器才不會掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GASHAT.2"
msgid "The particulate purifier can go on the hook when I get home."
msgstr "回家以後，顆粒淨化器可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.1"
msgid "If you borrow my luxury machete, put it back where you found it."
msgstr "借我的黃金砍刀可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GOLDENMACHETE.2"
msgid "I'll be careful with the luxury machete. Stop looking at me like that."
msgstr "我會小心用黃金砍刀。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GRASS_WATER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GRASS_WATER.1"
msgid "There's some grass growing here. Watch where you step."
msgstr "這裡長著草。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GRASS_WATER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.GRASS_WATER.2"
msgid "I wonder what the grass looks like after a good rain."
msgstr "不知道下場雨以後，草會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAIL_ICE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAIL_ICE.1"
msgid "How much room do we have to go around the hail?"
msgstr "繞開冰雹還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAIL_ICE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HAIL_ICE.2"
msgid "Heads up. There's a hail right here."
msgstr "當心，這裡就有冰雹。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARPOON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARPOON.1"
msgid "Stand back a little. I want to see what the harpoon can do."
msgstr "後退一點。我想看看魚叉好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARPOON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.HARPOON.2"
msgid "I can take the harpoon, but I'm bringing my bat too."
msgstr "魚叉可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_BOAT_NAMEPLATE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_BOAT_NAMEPLATE.1"
msgid "Keep that boat plaque. I might need it later."
msgstr "船牌先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_BOAT_NAMEPLATE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_BOAT_NAMEPLATE.2"
msgid "How much boat plaque do we have now? I lost count."
msgstr "現在有多少船牌了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1.1"
msgid "Whoever picked the pirate ghost decoration gets to dust it."
msgstr "誰挑的海盜鬼魂裝飾，以後誰來撣灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_1.2"
msgid "The pirate ghost decoration can go on the wall. Just don't make me stand there admiring it."
msgstr "海盜鬼魂裝飾可以掛牆上。別讓我站那裡一直看就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2.1"
msgid "The stink ray decoration can go on the wall. Just don't make me stand there admiring it."
msgstr "惡臭蝠鱝裝飾可以掛牆上。別讓我站那裡一直看就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_2.2"
msgid "Hang the stink ray decoration a little higher. My bat might catch it."
msgstr "惡臭蝠鱝裝飾掛高一點。我的球棒有可能碰到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3.1"
msgid "Whoever picked the tropical spider warrior decoration gets to dust it."
msgstr "誰挑的毒蜘蛛裝飾，以後誰來撣灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_3.2"
msgid "Hang the tropical spider warrior decoration a little higher. My bat might catch it."
msgstr "毒蜘蛛裝飾掛高一點。我的球棒有可能碰到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4.1"
msgid "The doydoy decoration can go on the wall. Just don't make me stand there admiring it."
msgstr "渡渡鳥裝飾可以掛牆上。別讓我站那裡一直看就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_HALLOWEEN_ORNAMENT_4.2"
msgid "Whoever picked the doydoy decoration gets to dust it."
msgstr "誰挑的渡渡鳥裝飾，以後誰來撣灰。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_14.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_14.1"
msgid "I don't know what a worn-out doll is worth here. I could ask."
msgstr "不知道磨損的玩偶在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_14.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_14.2"
msgid "I've got room in my bag for the worn-out doll, if nobody else wants it."
msgstr "沒人要磨損的玩偶的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_15.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_15.1"
msgid "I've got room in my bag for the old ukulele, if nobody else wants it."
msgstr "沒人要舊尤克里裡的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_15.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_15.2"
msgid "Don't lose the old ukulele now that we finally found it."
msgstr "好不容易找到舊尤克里裡，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_17.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_17.1"
msgid "I don't know what a lost old boot is worth here. I could ask."
msgstr "不知道丟失的舊靴子在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_17.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_17.2"
msgid "Don't lose the lost old boot now that we finally found it."
msgstr "好不容易找到丟失的舊靴子，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_18.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_18.1"
msgid "Don't lose the mother's favorite vase now that we finally found it."
msgstr "好不容易找到媽媽最愛的花瓶，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_18.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_18.2"
msgid "I've got room in my bag for the mother's favorite vase, if nobody else wants it."
msgstr "沒人要媽媽最愛的花瓶的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_20.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_20.1"
msgid "Don't lose the lost father's sextant now that we finally found it."
msgstr "好不容易找到爸爸丟失的六分儀，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_20.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_20.2"
msgid "I don't know what a lost father's sextant is worth here. I could ask."
msgstr "不知道爸爸丟失的六分儀在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_21.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_21.1"
msgid "Don't lose the favorite toy boat now that we finally found it."
msgstr "好不容易找到最喜歡的玩具船，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_21.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_LOST_TOY_21.2"
msgid "I don't know what a favorite toy boat is worth here. I could ask."
msgstr "不知道最喜歡的玩具船在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLE.1"
msgid "Keep that message in a Bottle. I might need it later."
msgstr "漂流瓶先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLE.2"
msgid "Sort the message in a Bottle out from the rest of the pile for me, will you?"
msgstr "能幫我把漂流瓶從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLEEMPTY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLEEMPTY.1"
msgid "I should make space in my bag for the empty bottle."
msgstr "我應該在包裡給空瓶子騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLEEMPTY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_MESSAGEBOTTLEEMPTY.2"
msgid "I'll carry the empty bottle if somebody else carries the rest."
msgstr "其他東西誰拿一下，空瓶子我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED.1"
msgid "Put Shipwrecked on for a minute. We can pack up after it finishes."
msgstr "放一下《海難》吧。聽完再收拾。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED.2"
msgid "Did we bring a player for Shipwrecked? I'd like to hear it."
msgstr "有沒有能放《海難》的唱機？我想聽聽。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED.1"
msgid "Did we bring a player for Beached? I'd like to hear it."
msgstr "有沒有能放《沙灘》的唱機？我想聽聽。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_BEACHED.2"
msgid "Put Beached on for a minute. We can pack up after it finishes."
msgstr "放一下《沙灘》吧。聽完再收拾。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD.1"
msgid "I'll listen to Castaway. Give me somewhere to sit first."
msgstr "我想聽聽《漂流者》。先給我找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_RECORD_SHIPWRECKED_OLD.2"
msgid "Put Castaway on for a minute. We can pack up after it finishes."
msgstr "放一下《漂流者》吧。聽完再收拾。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_TRIDENT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_TRIDENT.1"
msgid "I'm putting the trident somewhere I won't step on it."
msgstr "我得把三叉戟放到自己踩不到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_TRIDENT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IA_TRIDENT.2"
msgid "Let me get a feel for the trident before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試三叉戟的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.HIGH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.HIGH.1"
msgid "The ice maker 3000 is running. Can I sit down now?"
msgstr "製冰機3000運轉起來了。我現在能坐下了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.HIGH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.HIGH.2"
msgid "I'll leave the ice maker 3000 on until it's done."
msgstr "讓製冰機3000開著吧，等它忙完再關。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.LOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.LOW.1"
msgid "Let's top up the ice maker 3000 before it stops working."
msgstr "趁製冰機3000還沒停，先把燃料加上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.LOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.LOW.2"
msgid "Keep some fuel by the ice maker 3000. We'll need it soon."
msgstr "在製冰機3000旁放點燃料吧。很快就要用到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.NORMAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.NORMAL.1"
msgid "I can hear the ice maker 3000 working. We'll check on it in a minute."
msgstr "聽得見製冰機3000在運轉。待會兒再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.NORMAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.NORMAL.2"
msgid "I'll leave the ice maker 3000 on until it's done."
msgstr "讓製冰機3000開著吧，等它忙完再關。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.OUT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.OUT.1"
msgid "All right, who's carrying the fuel? It won't start without it."
msgstr "好吧，燃料誰拿著？沒有就沒辦法啟動。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.OUT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.OUT.2"
msgid "It's gone quiet. Let's fill it up before I forget."
msgstr "一點聲音也沒有了。趁我還記得，先加滿吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.VERYLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.VERYLOW.1"
msgid "We might get one more lump of ice out of it. Keep the fuel ready."
msgstr "可能還出得來最後一塊冰。燃料備好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.VERYLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ICEMAKER.VERYLOW.2"
msgid "Look at that gauge. Nearly empty. Didn't we just fill it?"
msgstr "看看錶，快空了。不是剛加滿嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IRONWIND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IRONWIND.1"
msgid "I'll check the iron wind before we leave the dock."
msgstr "離開碼頭前，我先檢查一下螺旋槳。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IRONWIND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.IRONWIND.2"
msgid "If the iron wind comes loose at sea, I'm making you go get it."
msgstr "螺旋槳要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH.1"
msgid "That jellyfish is hard to keep track of."
msgstr "一轉眼就找不到那隻水母了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH.2"
msgid "Is that a jellyfish? Hold still, I want a better look."
msgstr "那是水母嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISHJELLY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISHJELLY.1"
msgid "Put the jellyfish jelly where I can reach it. I'll be hungry later."
msgstr "水母凍放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISHJELLY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISHJELLY.2"
msgid "I'll try the jellyfish jelly. Save me a bite."
msgstr "水母凍我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_COOKED.1"
msgid "The cooked jellyfish can cool off while I find somewhere to sit."
msgstr "先讓熟水母涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_COOKED.2"
msgid "Now that there's cooked jellyfish, can we stop for lunch?"
msgstr "既然有熟水母了，能停下來吃飯嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_DEAD.1"
msgid "How much dead jellyfish do we have now? I lost count."
msgstr "現在有多少死水母了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_DEAD.2"
msgid "I'll carry the dead jellyfish if somebody else carries the rest."
msgstr "其他東西誰拿一下，死水母我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_PLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_PLANTED.1"
msgid "There's some jellyfish growing here. Watch where you step."
msgstr "這裡長著水母。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_PLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYFISH_PLANTED.2"
msgid "I wonder what the jellyfish looks like after a good rain."
msgstr "不知道下場雨以後，水母會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYJERKY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYJERKY.1"
msgid "Hand me the dried jellyfish. I haven't eaten since we left."
msgstr "把晾乾的水母遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYJERKY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYJERKY.2"
msgid "I'll try the dried jellyfish. Save me a bite."
msgstr "晾乾的水母我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYOPOP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYOPOP.1"
msgid "Put the jelly-o pop where I can reach it. I'll be hungry later."
msgstr "水母凍放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYOPOP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JELLYOPOP.2"
msgid "The jelly-o pop can cool off while I find somewhere to sit."
msgstr "先讓水母凍涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNING.1"
msgid "That's smoke coming off the jungle tree. Back up a little."
msgstr "是叢林樹在冒煙。往後退一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNING.2"
msgid "Do we have time to save the jungle tree? That fire's getting bigger."
msgstr "現在還來得及救叢林樹嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNT.1"
msgid "The jungle tree is pretty much ash now. Leave it to cool."
msgstr "叢林樹燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.BURNT.2"
msgid "So much for the jungle tree. Is anything under the ash still good?"
msgstr "叢林樹算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.CHOPPED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.CHOPPED.1"
msgid "I got all I could from the jungle tree. No need for another swing."
msgstr "叢林樹上能砍的我都砍了。用不著再揮一刀。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.CHOPPED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.CHOPPED.2"
msgid "That's enough chopping for now. What's left of the jungle tree can stay."
msgstr "先砍到這裡。剩下的叢林樹就留著吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.GENERIC.1"
msgid "If you're taking some jungle tree, leave a bit for later."
msgstr "要摘叢林樹的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREE.GENERIC.2"
msgid "I'll leave the jungle tree alone today. It can keep growing."
msgstr "今天先不動叢林樹。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED.1"
msgid "I'll plant the jungle tree seed. You're in charge of remembering to water it."
msgstr "叢林樹種我來種。記得澆水就交給你了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED.2"
msgid "I've got the jungle tree seed. Now I need a patch of dirt and some patience."
msgstr "叢林樹種有了。現在得找塊地，還得有點耐心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED_SAPLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED_SAPLING.1"
msgid "I know it's a jungle tree sapling. I just wish it was a little farther along."
msgstr "我知道這是叢林樹苗。就是希望它能再長大一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED_SAPLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.JUNGLETREESEED_SAPLING.2"
msgid "Come on, jungle tree sapling. Grow before I forget where I put you."
msgstr "叢林樹苗快長吧，免得我忘了種在哪裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_SILVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_SILVER.1"
msgid "One silver key. I hope finding the lock takes less time."
msgstr "銀鑰匙到手。希望找鎖能快一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_SILVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_SILVER.2"
msgid "I've got the silver key. Which lock takes it?"
msgstr "銀鑰匙拿到了。它能開什麼鎖？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_TROPICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_TROPICAL.1"
msgid "I've got the loot stash key. Which lock takes it?"
msgstr "贓物袋鑰匙拿到了。它能開什麼鎖？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_TROPICAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KLAUSSACKKEY_TROPICAL.2"
msgid "One loot stash key. I hope finding the lock takes less time."
msgstr "贓物袋鑰匙到手。希望找鎖能快一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNIGHTBOAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNIGHTBOAT.1"
msgid "Let me get my bat before the floaty boaty knight gets any ideas."
msgstr "趁浮船騎士還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNIGHTBOAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KNIGHTBOAT.2"
msgid "That's a floaty boaty knight. Stay over there, thanks."
msgstr "是浮船騎士。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN.1"
msgid "That's a lot of arms to keep away from my hull."
msgstr "那麼多觸手，別讓它們搭上船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN.2"
msgid "Wait until it comes up for another swing. I've got my bat ready."
msgstr "等它再冒頭。我的球棒備好了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKENCHEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKENCHEST.1"
msgid "It came from down there? Hope the contents are dry."
msgstr "從水底出來的？希望裡頭沒進水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKENCHEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKENCHEST.2"
msgid "If the tentacles want it back, they can wait their turn."
msgstr "觸手還想把它拿回去？那得排隊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN_TENTACLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN_TENTACLE.1"
msgid "Next one that reaches over the rail gets the bat."
msgstr "哪條觸手再伸過來，我就打哪條。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN_TENTACLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.KRAKEN_TENTACLE.2"
msgid "Row clear. It can reach farther than I can."
msgstr "劃遠點。它夠得比我遠。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAPOOL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAPOOL.1"
msgid "I saw the lava pool. Let me get a little farther away first."
msgstr "我看見岩漿池了。先讓我退遠點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAPOOL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LAVAPOOL.2"
msgid "How much room do we have to go around the lava pool?"
msgstr "繞開岩漿池還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LEIF_PALM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LEIF_PALM.1"
msgid "Let me get my bat before the treeguard gets any ideas."
msgstr "趁椰樹守衛還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LEIF_PALM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LEIF_PALM.2"
msgid "Hey, treeguard. You don't have to come any closer."
msgstr "喂，椰樹守衛。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMESTONENUGGET.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMESTONENUGGET.1"
msgid "How much limestone do we have now? I lost count."
msgstr "現在有多少石灰岩了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMESTONENUGGET.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMESTONENUGGET.2"
msgid "Keep that limestone. I might need it later."
msgstr "石灰岩先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS.1"
msgid "We've got the limpets. Now someone's got to clean it."
msgstr "帽貝到手了。現在還得有人收拾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS.2"
msgid "Leave the limpets out of the sun. We'll cook it when we stop."
msgstr "別把帽貝放在太陽底下。停下來再煮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS_COOKED.1"
msgid "The cooked limpets can cool off while I find somewhere to sit."
msgstr "先讓熟帽貝涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIMPETS_COOKED.2"
msgid "The cooked limpets smells good. I get the first bite, right?"
msgstr "熟帽貝聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIVINGJUNGLETREE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIVINGJUNGLETREE.1"
msgid "There's some jungle tree growing here. Watch where you step."
msgstr "這裡長著叢林樹。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIVINGJUNGLETREE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LIVINGJUNGLETREE.2"
msgid "I'll leave the jungle tree alone today. It can keep growing."
msgstr "今天先不動叢林樹。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER.1"
msgid "A wobster. It's a lot easier to see than it is to catch."
msgstr "是龍蝦。看見容易，抓到就難了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER.2"
msgid "Can we get the wobster without me leaning any farther over the side?"
msgstr "不再往船外探身，能抓到龍蝦嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTERHOLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTERHOLE.1"
msgid "We can look at the wobster den from here. That'll do."
msgstr "在這裡看看龍蝦巢就夠了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTERHOLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTERHOLE.2"
msgid "Keep quiet around the wobster den. I don't want anything coming out."
msgstr "經過龍蝦巢的時候小點聲。我可不想把裡面的東西引出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD.1"
msgid "Save it for dinner. We did all that work to catch it."
msgstr "留著做晚餐吧。抓它費了好些工夫。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD.2"
msgid "I hope somebody knows how to cook a wobster around here."
msgstr "希望這裡有人知道龍蝦怎麼煮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD_COOKED.1"
msgid "Hand me the delicious wobster. I haven't eaten since we left."
msgstr "把美味的龍蝦遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LOBSTER_DEAD_COOKED.2"
msgid "Put the delicious wobster where I can reach it. I'll be hungry later."
msgstr "美味的龍蝦放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUGGAGECHEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUGGAGECHEST.1"
msgid "I'm opening the steamer trunk. Let me know if I pick up anything that isn't mine."
msgstr "我開海上旅行箱看看。要是誤拿了別人的東西，告訴我一聲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUGGAGECHEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.LUGGAGECHEST.2"
msgid "Is there room in the steamer trunk for one more thing?"
msgstr "海上旅行箱裡還能再裝一樣嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MACHETE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MACHETE.1"
msgid "If you borrow my machete, put it back where you found it."
msgstr "借我的砍刀可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MACHETE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MACHETE.2"
msgid "Anybody using the machete? I could use a turn."
msgstr "有人在用砍刀嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGIC_SEAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGIC_SEAL.1"
msgid "I'll put the magic seal in my pocket. I can decide what to do with it later."
msgstr "魔法豹印先揣兜裡。晚點再想怎麼處理。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGIC_SEAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGIC_SEAL.2"
msgid "Put the magic seal somewhere it won't get broken again."
msgstr "把魔法豹印放到不容易摔壞的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK.1"
msgid "If you want that magma pile broken up, somebody get me a decent handle."
msgstr "要敲開熔岩礦堆的話，先給我拿把趁手的鎬。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK.2"
msgid "That magma pile looks like a job for a pickaxe."
msgstr "熔岩礦堆看起來得用鎬來敲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK_GOLD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK_GOLD.1"
msgid "If you want that magma pile broken up, somebody get me a decent handle."
msgstr "要敲開熔岩礦堆的話，先給我拿把趁手的鎬。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK_GOLD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MAGMAROCK_GOLD.2"
msgid "That magma pile looks like a job for a pickaxe."
msgstr "熔岩礦堆看起來得用鎬來敲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.BURNT.1"
msgid "So much for the mangrove. Is anything under the ash still good?"
msgstr "紅樹算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.BURNT.2"
msgid "The mangrove is already burnt through. Too late to bring a bucket."
msgstr "紅樹都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.GENERIC.1"
msgid "I wonder what the mangrove looks like after a good rain."
msgstr "不知道下場雨以後，紅樹會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE.GENERIC.2"
msgid "I'll leave the mangrove alone today. It can keep growing."
msgstr "今天先不動紅樹。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_BURNT.1"
msgid "There's charcoal where the branches used to be."
msgstr "原先長樹枝的地方，現在剩下些炭。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_BURNT.2"
msgid "Even with the roots in water, the fire got to it."
msgstr "根泡在水裡，還是被火燒到了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_SAPLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_SAPLING.1"
msgid "Come on, mangrove sapling. Grow before I forget where I put you."
msgstr "紅樹樹苗快長吧，免得我忘了種在哪裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_SAPLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MANGROVETREE_SAPLING.2"
msgid "I know it's a mangrove sapling. I just wish it was a little farther along."
msgstr "我知道這是紅樹樹苗。就是希望它能再長大一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_PLANT_TROPICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_PLANT_TROPICAL.1"
msgid "I wonder what the plant looks like after a good rain."
msgstr "不知道下場雨以後，植物會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_PLANT_TROPICAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MARSH_PLANT_TROPICAL.2"
msgid "I'll leave the plant alone today. It can keep growing."
msgstr "今天先不動植物。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMFISHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMFISHER.1"
msgid "I'll leave the fishermerm alone if it leaves me alone."
msgstr "只要魚人漁夫不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMFISHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMFISHER.2"
msgid "That fishermerm is hard to keep track of."
msgstr "一轉眼就找不到那隻魚人漁夫了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER.1"
msgid "I can see the fishermerm's hut from here. Want to go look?"
msgstr "從這裡能看見漁人小屋。要過去看看嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER.2"
msgid "If I lose you, meet me by the fishermerm's hut."
msgstr "要是走散了，就在漁人小屋旁邊碰面。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER_CRAFTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER_CRAFTED.1"
msgid "If I lose you, meet me by the anglermerm house."
msgstr "要是走散了，就在漁人工藝屋旁邊碰面。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER_CRAFTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_FISHER_CRAFTED.2"
msgid "I can see the anglermerm house from here. Want to go look?"
msgstr "從這裡能看見漁人工藝屋。要過去看看嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.BURNT.1"
msgid "The merm hut is already burnt through. Too late to bring a bucket."
msgstr "魚人小屋都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.BURNT.2"
msgid "The merm hut is pretty much ash now. Leave it to cool."
msgstr "魚人小屋燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC.1"
msgid "I could wait by the merm hut, if we're stopping here."
msgstr "如果要在這裡停一下，我可以在魚人小屋旁邊等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MERMHOUSE_TROPICAL.GENERIC.2"
msgid "That's the merm hut. I wonder if anyone's inside."
msgstr "那是魚人小屋。不知道裡面有沒有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MONKEYBALL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MONKEYBALL.1"
msgid "I'll put the silly monkey ball in my pocket. I can decide what to do with it later."
msgstr "逗猴球先揣兜裡。晚點再想怎麼處理。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MONKEYBALL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MONKEYBALL.2"
msgid "Someone kept this silly monkey ball for a reason. I wonder why."
msgstr "有人特地留著這個逗猴球。不知道為什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOBOMB_YELLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOBOMB_YELLOW.1"
msgid "Keep it intact till we're out of range of the smell."
msgstr "等離遠了再用，別讓臭氣飄過來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOBOMB_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOBOMB_YELLOW.2"
msgid "Even I know not to toss that upwind."
msgstr "我也知道不能朝上風處丟。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOFERTILIZER_YELLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOFERTILIZER_YELLOW.1"
msgid "I'll feed it to the plants if somebody else opens the packet."
msgstr "誰幫我把它打開，我就拿去給植物施肥。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOFERTILIZER_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOFERTILIZER_YELLOW.2"
msgid "The plants can have it. I don't want it in my bag any longer."
msgstr "給植物吧，我不想再把它放在包裡了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE_YELLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE_YELLOW.1"
msgid "No thanks. Tell the merms their medicine is ready."
msgstr "我就不用了。告訴魚人藥準備好了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMERMSALVE_YELLOW.2"
msgid "I won't mix that up with mine. It's got mosquito in it."
msgstr "我不會跟自己的弄混。裡面有蚊子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK_YELLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK_YELLOW.1"
msgid "I can smell it from here. I hope the bugs can too."
msgstr "我站這裡都能聞到。希望蚊子也聞得到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOMUSK_YELLOW.2"
msgid "I'll keep it near me till the buzzing lets up."
msgstr "在蚊子不再嗡嗡叫以前，我都帶著它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.1"
msgid "I should make space in my bag for the yellow mosquito sack."
msgstr "我應該在包裡給毒蚊血囊騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITOSACK_YELLOW.2"
msgid "I'll carry the yellow mosquito sack if somebody else carries the rest."
msgstr "其他東西誰拿一下，毒蚊血囊我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITO_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITO_POISON.1"
msgid "Look, a poison mosquito. Try not to scare it off."
msgstr "看，有毒蚊子。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITO_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MOSQUITO_POISON.2"
msgid "That poison mosquito is hard to keep track of."
msgstr "一轉眼就找不到那隻毒蚊子了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL.1"
msgid "Take a look at the wrecked postern. Tell me if anything around it moves."
msgstr "看看殘損之門。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MULTIPLAYER_PORTAL_TROPICAL.2"
msgid "I want a closer look at the wrecked postern. Can you watch my back?"
msgstr "我想湊近看看殘損之門。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL.1"
msgid "We've got the mussel. Now someone's got to clean it."
msgstr "貽貝到手了。現在還得有人收拾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL.2"
msgid "Leave the mussel out of the sun. We'll cook it when we stop."
msgstr "別把貽貝放在太陽底下。停下來再煮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSELBOUILLABAISE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSELBOUILLABAISE.1"
msgid "The mussel bouillabaise smells good. I get the first bite, right?"
msgstr "貽貝濃湯聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSELBOUILLABAISE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSELBOUILLABAISE.2"
msgid "I had plans. Then somebody made mussel bouillabaise."
msgstr "我原本還有事要做。現在有人做了貽貝濃湯。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_BED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_BED.1"
msgid "If we have any more mussel bed, put it with this batch."
msgstr "還有貽貝巖的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_BED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_BED.2"
msgid "I should make space in my bag for the mussel bed."
msgstr "我應該在包裡給貽貝巖騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_COOKED.1"
msgid "The cooked mussel smells good. I get the first bite, right?"
msgstr "熟貽貝聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_COOKED.2"
msgid "I'll try the cooked mussel. Save me a bite."
msgstr "熟貽貝我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.GENERIC.1"
msgid "Mussels! I hope somebody brought a mussel stick."
msgstr "是貽貝！希望有人帶了貽貝棒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.GENERIC.2"
msgid "I'm not diving for them. There's an easier way."
msgstr "我才不潛下去撈。有更省力的辦法。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.STICKPLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.STICKPLANTED.1"
msgid "Give them time to grab onto it. I'm going to sit down."
msgstr "等它們爬上去吧。我先去坐會兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.STICKPLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_FARM.STICKPLANTED.2"
msgid "Don't pull that stick up yet. It's got a job to do."
msgstr "先別把棒拔起來。它還有用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_STICK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_STICK.1"
msgid "Anybody using the mussel stick? I could use a turn."
msgstr "有人在用貝棒嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_STICK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUSSEL_STICK.2"
msgid "If you borrow my mussel stick, put it back where you found it."
msgstr "借我的貝棒可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_RANDOM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_RANDOM.1"
msgid "Anybody using the rainbow switcherdoodle? I could use a turn."
msgstr "有人在用彩虹變身塗鴉嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_RANDOM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_RANDOM.2"
msgid "I'll be careful with the rainbow switcherdoodle. Stop looking at me like that."
msgstr "我會小心用彩虹變身塗鴉。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR.1"
msgid "If you borrow my tropical switcherdoodle, put it back where you found it."
msgstr "借我的毒液變身塗鴉可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MUTATOR_TROPICAL_SPIDER_WARRIOR.2"
msgid "Anybody using the tropical switcherdoodle? I could use a turn."
msgstr "有人在用毒液變身塗鴉嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MYSTERYMEAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MYSTERYMEAT.1"
msgid "Sort the bile-covered slop out from the rest of the pile for me, will you?"
msgstr "能幫我把膽汁蓋肉從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MYSTERYMEAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.MYSTERYMEAT.2"
msgid "I'll carry the bile-covered slop if somebody else carries the rest."
msgstr "其他東西誰拿一下，膽汁蓋肉我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEEDLESPEAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEEDLESPEAR.1"
msgid "Let me get a feel for the cactus spike before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試仙人掌刺的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEEDLESPEAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEEDLESPEAR.2"
msgid "I'm putting the cactus spike somewhere I won't step on it."
msgstr "我得把仙人掌刺放到自己踩不到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO.1"
msgid "There goes a neon quattro. Is the net ready?"
msgstr "一條霓虹魚游過去了。網準備好了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO.2"
msgid "Can we get the neon quattro without me leaning any farther over the side?"
msgstr "不再往船外探身，能抓到霓虹魚嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO_COOKED.1"
msgid "I'll try the cooked neon quattro. Save me a bite."
msgstr "熟霓虹魚我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NEON_QUATTRO_COOKED.2"
msgid "I had plans. Then somebody made cooked neon quattro."
msgstr "我原本還有事要做。現在有人做了熟霓虹魚。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUBBIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUBBIN.1"
msgid "That's the coral nubbin. Can we see it from the boat?"
msgstr "那是珊瑚礁塊。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUBBIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUBBIN.2"
msgid "I want a look at the coral nubbin. Bring us a little closer."
msgstr "我想看看珊瑚礁塊。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT.1"
msgid "I'll try the ingenius gardeneer hat on. Does it flatten my hair?"
msgstr "我戴一下天才耕作先驅帽。會把頭髮壓扁嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.NUTRIENTSGOGGLES_OBSIDIANHAT.2"
msgid "Think the ingenius gardeneer hat goes with my uniform? I'm wearing it either way."
msgstr "天才耕作先驅帽配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_BAMBOO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_BAMBOO.1"
msgid "I'll check the bamboo oar before we leave the dock."
msgstr "離開碼頭前，我先檢查一下竹槳。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_BAMBOO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_BAMBOO.2"
msgid "If the bamboo oar comes loose at sea, I'm making you go get it."
msgstr "竹槳要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_TIGERSHARK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_TIGERSHARK.1"
msgid "If the tigoar comes loose at sea, I'm making you go get it."
msgstr "虎鯊槳要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_TIGERSHARK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OAR_TIGERSHARK.2"
msgid "Put the tigoar where I can reach it from my seat."
msgstr "把虎鯊槳放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN.1"
msgid "Keep that obsidian. I might need it later."
msgstr "黑曜石先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN.2"
msgid "Sort the obsidian out from the rest of the pile for me, will you?"
msgstr "能幫我把黑曜石從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANAXE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANAXE.1"
msgid "I can take the obsidian axe, but I'm bringing my bat too."
msgstr "黑曜石斧可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANAXE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANAXE.2"
msgid "Let me get a feel for the obsidian axe before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試黑曜石斧的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANBUGNET.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANBUGNET.1"
msgid "Somebody show me how the obsidian net works. Keep it short."
msgstr "誰給我演示一下黑曜石網怎麼用。簡單說就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANBUGNET.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANBUGNET.2"
msgid "I'll be careful with the obsidian net. Stop looking at me like that."
msgstr "我會小心用黑曜石網。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.BURNING.1"
msgid "That's smoke coming off the obsidian coconade. Back up a little."
msgstr "是黑曜石椰彈在冒煙。往後退一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.BURNING.2"
msgid "Do we have time to save the obsidian coconade? That fire's getting bigger."
msgstr "現在還來得及救黑曜石椰彈嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.GENERIC.1"
msgid "Stand back a little. I want to see what the obsidian coconade can do."
msgstr "後退一點。我想看看黑曜石椰彈好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANCOCONADE.GENERIC.2"
msgid "Let me get a feel for the obsidian coconade before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試黑曜石椰彈的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.EMBERS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.EMBERS.1"
msgid "We're going to lose the fire if it gets any colder."
msgstr "再冷下去，火就要滅了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.EMBERS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.EMBERS.2"
msgid "I can see a little red under the ash. Let's clear some space for fuel."
msgstr "灰底下還透著紅。清出點地方加柴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.GENERIC.1"
msgid "I doubt the stones need replacing anytime soon."
msgstr "這些石頭短時間裡應該不用換。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.GENERIC.2"
msgid "If I have to mind a fire all night, at least the pit looks sturdy."
msgstr "真要守一整夜的火，至少這個火坑夠結實。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.HIGH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.HIGH.1"
msgid "I think that's enough fuel for the obsidian fire pit. No, really."
msgstr "給黑曜石火坑加的燃料夠多了。真的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.HIGH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.HIGH.2"
msgid "The obsidian fire pit is burning hot. Watch your sleeves."
msgstr "黑曜石火坑燒得很旺。當心袖子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.LOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.LOW.1"
msgid "The flame in the obsidian fire pit is getting small. Throw another log on."
msgstr "黑曜石火坑裡的火變小了。再添根木頭吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.LOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.LOW.2"
msgid "I can still see embers in the obsidian fire pit. We haven't lost the fire yet."
msgstr "還能看見黑曜石火坑裡的餘燼。火還沒徹底熄。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.NORMAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.NORMAL.1"
msgid "The obsidian fire pit is warm enough. Leave me a spot by it."
msgstr "黑曜石火坑夠暖了。旁邊給我留個位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.NORMAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.NORMAL.2"
msgid "I'll sit near the obsidian fire pit till my sleeves dry."
msgstr "我在黑曜石火坑旁邊坐到袖子幹了再走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.OUT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.OUT.1"
msgid "The obsidian fire pit went out. Let's get it lit again."
msgstr "黑曜石火坑裡的火熄了。重新升起來吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.OUT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANFIREPIT.OUT.2"
msgid "There's no heat coming from the obsidian fire pit. Guess I have to start over."
msgstr "黑曜石火坑一點熱氣也沒有了。看來得重新生火。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANMACHETE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANMACHETE.1"
msgid "I'll be careful with the obsidian machete. Stop looking at me like that."
msgstr "我會小心用黑曜石砍刀。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANMACHETE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIANMACHETE.2"
msgid "I'll take the obsidian machete with me. Better than walking back for it."
msgstr "我把黑曜石砍刀帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN_WORKBENCH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN_WORKBENCH.1"
msgid "I'll take the obsidian workbench with me. Better than walking back for it."
msgstr "我把黑曜石工作台帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN_WORKBENCH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OBSIDIAN_WORKBENCH.2"
msgid "Somebody show me how the obsidian workbench works. Keep it short."
msgstr "誰給我演示一下黑曜石工作台怎麼用。簡單說就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY.1"
msgid "Put the doydoy quill float where I can reach it from my seat."
msgstr "把渡渡鳥浮漂放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCEANFISHINGBOBBER_DOYDOY.2"
msgid "I can handle the doydoy quill float. You keep the boat steady."
msgstr "渡渡鳥浮漂交給我。你穩住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSCHEST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSCHEST.1"
msgid "I'm opening the octo chest. Let me know if I pick up anything that isn't mine."
msgstr "我開章魚寶箱看看。要是誤拿了別人的東西，告訴我一聲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSCHEST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSCHEST.2"
msgid "Is there room in the octo chest for one more thing?"
msgstr "章魚寶箱裡還能再裝一樣嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSKING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSKING.1"
msgid "Hey, I've got seafood. What have you got for me?"
msgstr "喂，我帶了海鮮。你拿什麼換？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSKING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OCTOPUSKING.2"
msgid "Must be nice to do all your trading from the same seat."
msgstr "做買賣都不用挪窩。真好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX.1"
msgid "I see the water beefalo. Think it's noticed me?"
msgstr "我看見水牛了。它注意到我了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX.2"
msgid "A water beefalo. I'm giving it some room."
msgstr "是水牛。我先讓它一點地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OXHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OXHAT.1"
msgid "How am I going to keep the horned helmet from falling off?"
msgstr "我要怎麼戴，牛角盔才不會掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OXHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OXHAT.2"
msgid "The horned helmet can go on the hook when I get home."
msgstr "回家以後，牛角盔可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_FLUTE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_FLUTE.1"
msgid "If you borrow my dripple pipes, put it back where you found it."
msgstr "借我的滴水排簫可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_FLUTE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_FLUTE.2"
msgid "Anybody using the dripple pipes? I could use a turn."
msgstr "有人在用滴水排簫嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_HORN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_HORN.1"
msgid "Let me get a feel for the horn before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試水牛角的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_HORN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.OX_HORN.2"
msgid "I can take the horn, but I'm bringing my bat too."
msgstr "水牛角可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM.1"
msgid "Is that a packim baggims? Hold still, I want a better look."
msgstr "那是鵜鶘嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM.2"
msgid "Look, a packim baggims. Try not to scare it off."
msgstr "看，有鵜鶘。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM_FISHBONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM_FISHBONE.1"
msgid "Put the fishbone somewhere it won't get broken again."
msgstr "把魚骨放到不容易摔壞的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM_FISHBONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PACKIM_FISHBONE.2"
msgid "I didn't expect to find a fishbone here. Do you want it?"
msgstr "沒想到這裡會有魚骨。你想要嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF.1"
msgid "Keep that palm leaf. I might need it later."
msgstr "椰樹葉先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF.2"
msgid "I should make space in my bag for the palm leaf."
msgstr "我應該在包裡給椰樹葉騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_HUT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_HUT.1"
msgid "That's the palm leaf hut. I wonder if anyone's inside."
msgstr "那是椰樹葉棚。不知道裡面有沒有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_HUT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_HUT.2"
msgid "I can see the palm leaf hut from here. Want to go look?"
msgstr "從這裡能看見椰樹葉棚。要過去看看嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_UMBRELLA.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_UMBRELLA.1"
msgid "I can handle the palm leaf umbrella. You keep the boat steady."
msgstr "熱帶陽傘交給我。你穩住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_UMBRELLA.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMLEAF_UMBRELLA.2"
msgid "Put the palm leaf umbrella where I can reach it from my seat."
msgstr "把熱帶陽傘放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNING.1"
msgid "Do we have time to save the palm tree? That fire's getting bigger."
msgstr "現在還來得及救椰樹嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNING.2"
msgid "The palm tree caught fire. Somebody get water!"
msgstr "椰樹著火了！誰去拿點水！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNT.1"
msgid "The palm tree is already burnt through. Too late to bring a bucket."
msgstr "椰樹都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.BURNT.2"
msgid "So much for the palm tree. Is anything under the ash still good?"
msgstr "椰樹算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.CHOPPED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.CHOPPED.1"
msgid "I got all I could from the palm tree. No need for another swing."
msgstr "椰樹上能砍的我都砍了。用不著再揮一刀。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.CHOPPED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.CHOPPED.2"
msgid "The palm tree is cut back. My arms can rest now."
msgstr "椰樹砍完了。胳膊可以休息了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.GENERIC.1"
msgid "If you're taking some palm tree, leave a bit for later."
msgstr "要摘椰樹的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PALMTREE.GENERIC.2"
msgid "I wonder what the palm tree looks like after a good rain."
msgstr "不知道下場雨以後，椰樹會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT.1"
msgid "Is that a parrot? Hold still, I want a better look."
msgstr "那是鸚鵡嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT.2"
msgid "That parrot is hard to keep track of."
msgstr "一轉眼就找不到那隻鸚鵡了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT_PIRATE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT_PIRATE.1"
msgid "Is that a pirate parrot? Hold still, I want a better look."
msgstr "那是海盜鸚鵡嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT_PIRATE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PARROT_PIRATE.2"
msgid "That pirate parrot is hard to keep track of."
msgstr "一轉眼就找不到那隻海盜鸚鵡了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PEG_LEG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PEG_LEG.1"
msgid "Stand back a little. I want to see what the peg leg can do."
msgstr "後退一點。我想看看假腿好不好用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PEG_LEG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PEG_LEG.2"
msgid "Let me get a feel for the peg leg before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試假腿的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH.1"
msgid "I think that's a pierrot fish. I need to get a little closer."
msgstr "好像是小丑魚。我得湊近點看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH.2"
msgid "Can we get the pierrot fish without me leaning any farther over the side?"
msgstr "不再往船外探身，能抓到小丑魚嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH_COOKED.1"
msgid "The cooked pierrot fish can cool off while I find somewhere to sit."
msgstr "先讓熟小丑魚涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIERROT_FISH_COOKED.2"
msgid "I had plans. Then somebody made cooked pierrot fish."
msgstr "我原本還有事要做。現在有人做了熟小丑魚。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEGHOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEGHOST.1"
msgid "That's a pirate ghost. Stay over there, thanks."
msgstr "是海盜幽靈。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEGHOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEGHOST.2"
msgid "Let me get my bat before the pirate ghost gets any ideas."
msgstr "趁海盜幽靈還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEHAT.1"
msgid "I'll try the pirate hat on. Does it flatten my hair?"
msgstr "我戴一下海盜帽。會把頭髮壓扁嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEHAT.2"
msgid "The pirate hat can go on the hook when I get home."
msgstr "回家以後，海盜帽可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEPACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEPACK.1"
msgid "If we have any more booty bag, put it with this batch."
msgstr "還有藏寶袋的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEPACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATEPACK.2"
msgid "Sort the booty bag out from the rest of the pile for me, will you?"
msgstr "能幫我把藏寶袋從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.BURNT.1"
msgid "So much for the piratihatitator. Is anything under the ash still good?"
msgstr "靈子海盜帽算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.BURNT.2"
msgid "The piratihatitator is already burnt through. Too late to bring a bucket."
msgstr "靈子海盜帽都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.GENERIC.1"
msgid "Don't make me carry the piratihatitator all the way back here if you change your mind."
msgstr "你要是改主意，別讓我把靈子海盜帽再搬回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PIRATIHATITATOR.GENERIC.2"
msgid "Can we set the piratihatitator down somewhere it won't get knocked over?"
msgstr "能把靈子海盜帽放在碰不倒的地方嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONBALM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONBALM.1"
msgid "I'll keep the poison balm handy. I never know what I'll step on."
msgstr "解毒膏得隨身帶著。誰知道我會踩到什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONBALM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONBALM.2"
msgid "Pack the poison balm where we can find it in a hurry."
msgstr "把解毒膏放到急用時找得到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONCROCODOG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONCROCODOG.1"
msgid "Leave some room between us and that poison crocodog."
msgstr "和那隻毒鱷狗保持點距離。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONCROCODOG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONCROCODOG.2"
msgid "Let me get my bat before the poison crocodog gets any ideas."
msgstr "趁毒鱷狗還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONHOLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONHOLE.1"
msgid "I saw the poisonous hole. Let me get a little farther away first."
msgstr "我看見毒穴了。先讓我退遠點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONHOLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.POISONHOLE.2"
msgid "How much room do we have to go around the poisonous hole?"
msgstr "繞開毒穴還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PORTAL_SHIPWRECKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PORTAL_SHIPWRECKED.1"
msgid "Take a look at the portal. Tell me if anything around it moves."
msgstr "看看傳送門。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PORTAL_SHIPWRECKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PORTAL_SHIPWRECKED.2"
msgid "Something about the portal makes me want to look at the floor before I step."
msgstr "看見傳送門，我就覺得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPE.1"
msgid "I'll leave the prime ape alone if it leaves me alone."
msgstr "只要猿猴不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPE.2"
msgid "Look, a prime ape. Try not to scare it off."
msgstr "看，有猿猴。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPEBARREL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPEBARREL.1"
msgid "That's the prime ape hut. I wonder if anyone's inside."
msgstr "那是猿猴小窩。不知道裡面有沒有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPEBARREL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PRIMEAPEBARREL.2"
msgid "If I lose you, meet me by the prime ape hut."
msgstr "要是走散了，就在猿猴小窩旁邊碰面。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER.1"
msgid "There goes a purple grouper. Is the net ready?"
msgstr "一條紫石斑魚游過去了。網準備好了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER.2"
msgid "A purple grouper. It's a lot easier to see than it is to catch."
msgstr "是紫石斑魚。看見容易，抓到就難了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER_COOKED.1"
msgid "Hand me the cooked purple grouper. I haven't eaten since we left."
msgstr "把熟紫石斑魚遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.PURPLE_GROUPER_COOKED.2"
msgid "Now that there's cooked purple grouper, can we stop for lunch?"
msgstr "既然有熟紫石斑魚了，能停下來吃飯嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENBEAK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENBEAK.1"
msgid "Sort the quacken beak out from the rest of the pile for me, will you?"
msgstr "能幫我把海妖之喙從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENBEAK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENBEAK.2"
msgid "I should make space in my bag for the quacken beak."
msgstr "我應該在包裡給海妖之喙騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENDRILL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENDRILL.1"
msgid "If the quacken drill comes loose at sea, I'm making you go get it."
msgstr "海妖鑽子要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENDRILL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENDRILL.2"
msgid "I can handle the quacken drill. You keep the boat steady."
msgstr "海妖鑽子交給我。你穩住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.EMPTY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.EMPTY.1"
msgid "I can hear how empty it is. I'll go get water."
msgstr "光聽聲就知道空了。我去打水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.EMPTY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.EMPTY.2"
msgid "No more water. I'm calling that a break."
msgstr "沒水了。我先休息一下兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.GENERIC.1"
msgid "It's got water in it. Let's do the plants nearest the door first."
msgstr "壺裡有水。先澆離門最近的幾株吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKENWATERINGCAN.GENERIC.2"
msgid "Don't leave it tipped over. I just filled it."
msgstr "別把它放倒。我剛灌滿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKERINGRAM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKERINGRAM.1"
msgid "Put the quackering ram where I can reach it from my seat."
msgstr "把海妖撞錘放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKERINGRAM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.QUACKERINGRAM.2"
msgid "If the quackering ram comes loose at sea, I'm making you go get it."
msgstr "海妖撞錘要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH.1"
msgid "Is that a rainbow jellyfish? Hold still, I want a better look."
msgstr "那是彩虹水母嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH.2"
msgid "Look, a rainbow jellyfish. Try not to scare it off."
msgstr "看，有彩虹水母。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISHMOUSSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISHMOUSSE.1"
msgid "Now that there's rainbow mousse, can we stop for lunch?"
msgstr "既然有彩虹慕斯了，能停下來吃飯嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISHMOUSSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISHMOUSSE.2"
msgid "The rainbow mousse smells good. I get the first bite, right?"
msgstr "彩虹慕斯聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_COOKED.1"
msgid "Now that there's cooked rainbow jellyfish, can we stop for lunch?"
msgstr "既然有熟彩虹水母了，能停下來吃飯嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_COOKED.2"
msgid "Put the cooked rainbow jellyfish where I can reach it. I'll be hungry later."
msgstr "熟彩虹水母放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_DEAD.1"
msgid "Sort the dead rainbow jellyfish out from the rest of the pile for me, will you?"
msgstr "能幫我把死彩虹水母從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_DEAD.2"
msgid "I should make space in my bag for the dead rainbow jellyfish."
msgstr "我應該在包裡給死彩虹水母騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_PLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_PLANTED.1"
msgid "I wonder what the rainbow jellyfish looks like after a good rain."
msgstr "不知道下場雨以後，彩虹水母會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_PLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAINBOWJELLYFISH_PLANTED.2"
msgid "If you're taking some rainbow jellyfish, leave a bit for later."
msgstr "要摘彩虹水母的話，留點下次再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAWLING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAWLING.1"
msgid "Keep that rawling. I might need it later."
msgstr "羅林先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAWLING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.RAWLING.2"
msgid "How much rawling do we have now? I lost count."
msgstr "現在有多少羅林了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CHARCOAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CHARCOAL.1"
msgid "I'll try a couple of swings at the charcoal boulder and see what comes loose."
msgstr "我先往木炭礦上敲兩下，看看能敲出什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CHARCOAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CHARCOAL.2"
msgid "If you want that charcoal boulder broken up, somebody get me a decent handle."
msgstr "要敲開木炭礦的話，先給我拿把趁手的鎬。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CORAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CORAL.1"
msgid "Mark the coral reef on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下珊瑚礁的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CORAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_CORAL.2"
msgid "That's the coral reef. Can we see it from the boat?"
msgstr "那是珊瑚礁。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.GENERIC.1"
msgid "Keep that limpet rock. I might need it later."
msgstr "帽貝巖先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.GENERIC.2"
msgid "If we have any more limpet rock, put it with this batch."
msgstr "還有帽貝巖的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.PICKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.PICKED.1"
msgid "We can come back for the limpet rock after it's had some time to grow."
msgstr "等帽貝巖長好了，我們可以再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.PICKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_LIMPET.PICKED.2"
msgid "Nothing left on the limpet rock for now. Give it time."
msgstr "帽貝巖暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_OBSIDIAN.1"
msgid "If you want that obsidian boulder broken up, somebody get me a decent handle."
msgstr "要敲開黑曜石礦的話，先給我拿把趁手的鎬。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROCK_OBSIDIAN.2"
msgid "I'll try a couple of swings at the obsidian boulder and see what comes loose."
msgstr "我先往黑曜石礦上敲兩下，看看能敲出什麼。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE.1"
msgid "I'll carry the roe if somebody else carries the rest."
msgstr "其他東西誰拿一下，魚卵我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE.2"
msgid "Keep that roe. I might need it later."
msgstr "魚卵先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE_COOKED.1"
msgid "Put the cooked roe where I can reach it. I'll be hungry later."
msgstr "熟魚卵放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.ROE_COOKED.2"
msgid "Now that there's cooked roe, can we stop for lunch?"
msgstr "既然有熟魚卵了，能停下來吃飯嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_CLOTH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_CLOTH.1"
msgid "The cloth sail can do the work once we catch the wind."
msgstr "等迎到風，就能讓布帆出力了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_CLOTH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_CLOTH.2"
msgid "Put the cloth sail up. I'd like to give my arms a break."
msgstr "把布帆升起來。我想讓胳膊休息一下兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_FEATHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_FEATHER.1"
msgid "The feather lite sail can do the work once we catch the wind."
msgstr "等迎到風，就能讓輕型羽帆出力了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_FEATHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_FEATHER.2"
msgid "Put the feather lite sail up. I'd like to give my arms a break."
msgstr "把輕型羽帆升起來。我想讓胳膊休息一下兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_PALMLEAF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_PALMLEAF.1"
msgid "Check the knots on the thatch sail while we're still on shore."
msgstr "趁還在岸上，把草帆的繩結檢查一遍。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_PALMLEAF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_PALMLEAF.2"
msgid "Put the thatch sail up. I'd like to give my arms a break."
msgstr "把草帆升起來。我想讓胳膊休息一下兒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_SNAKESKIN.1"
msgid "The snakeskin sail can do the work once we catch the wind."
msgstr "等迎到風，就能讓蛇皮帆出力了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_SNAKESKIN.2"
msgid "Check the knots on the snakeskin sail while we're still on shore."
msgstr "趁還在岸上，把蛇皮帆的繩結檢查一遍。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_WOODLEGS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_WOODLEGS.1"
msgid "The pirate sail can do the work once we catch the wind."
msgstr "等迎到風，就能讓海盜船帆出力了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_WOODLEGS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAIL_WOODLEGS.2"
msgid "Check the knots on the pirate sail while we're still on shore."
msgstr "趁還在岸上，把海盜船帆的繩結檢查一遍。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAND.1"
msgid "I should make space in my bag for the sand."
msgstr "我應該在包裡給沙騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SAND.2"
msgid "How much sand do we have now? I lost count."
msgstr "現在有多少沙了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG.1"
msgid "I'll take the sandbag with me. Better than walking back for it."
msgstr "我把沙袋帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG.2"
msgid "Anybody using the sandbag? I could use a turn."
msgstr "有人在用沙袋嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL.1"
msgid "Give me the sandbag. Let me see how it feels to use it."
msgstr "把沙袋給我。我試試順不順手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL.2"
msgid "I'll be careful with the sandbag. Stop looking at me like that."
msgstr "我會小心用沙袋。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL_ITEM.1"
msgid "I'll be careful with the sandbag. Stop looking at me like that."
msgstr "我會小心用沙袋。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAGSMALL_ITEM.2"
msgid "Anybody using the sandbag? I could use a turn."
msgstr "有人在用沙袋嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG_ITEM.1"
msgid "Somebody show me how the sandbag works. Keep it short."
msgstr "誰給我演示一下沙袋怎麼用。簡單說就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDBAG_ITEM.2"
msgid "I'll be careful with the sandbag. Stop looking at me like that."
msgstr "我會小心用沙袋。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.GENERIC.1"
msgid "Don't make me carry the sand castle all the way back here if you change your mind."
msgstr "你要是改主意，別讓我把沙堡再搬回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.GENERIC.2"
msgid "I'm looking at the sand castle. That's all I'm doing. Relax."
msgstr "我就看看沙堡。不會亂碰，放心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.SAND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.SAND.1"
msgid "Don't make me carry the sand castle all the way back here if you change your mind."
msgstr "你要是改主意，別讓我把沙堡再搬回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.SAND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDCASTLE.SAND.2"
msgid "Can we set the sand castle down somewhere it won't get knocked over?"
msgstr "能把沙堡放在碰不倒的地方嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDDUNE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDDUNE.1"
msgid "That's the sandy pile. Can we see it from the boat?"
msgstr "那是沙堆。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDDUNE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SANDDUNE.2"
msgid "I want a look at the sandy pile. Bring us a little closer."
msgstr "我想看看沙堆。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL.1"
msgid "That seagull is hard to keep track of."
msgstr "一轉眼就找不到那隻海鷗了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL.2"
msgid "Is that a seagull? Hold still, I want a better look."
msgstr "那是海鷗嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL_WATER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL_WATER.1"
msgid "That seagull is hard to keep track of."
msgstr "一轉眼就找不到那隻海鷗了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL_WATER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAGULL_WATER.2"
msgid "I'll leave the seagull alone if it leaves me alone."
msgstr "只要海鷗不來打擾我，我也不去打擾它。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASACK.1"
msgid "Keep that sea sack. I might need it later."
msgstr "海上保鮮袋先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASACK.2"
msgid "How much sea sack do we have now? I lost count."
msgstr "現在有多少海上保鮮袋了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL.1"
msgid "I'll carry the seashell if somebody else carries the rest."
msgstr "其他東西誰拿一下，貝殼我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL.2"
msgid "Sort the seashell out from the rest of the pile for me, will you?"
msgstr "能幫我把貝殼從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL_BEACHED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL_BEACHED.1"
msgid "I'll carry the seashell if somebody else carries the rest."
msgstr "其他東西誰拿一下，貝殼我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL_BEACHED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEASHELL_BEACHED.2"
msgid "How much seashell do we have now? I lost count."
msgstr "現在有多少貝殼了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEATRAP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEATRAP.1"
msgid "I'll check the sea trap before we leave the dock."
msgstr "離開碼頭前，我先檢查一下海上陷阱。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEATRAP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEATRAP.2"
msgid "I can handle the sea trap. You keep the boat steady."
msgstr "海上陷阱交給我。你穩住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED.1"
msgid "I'll carry the seaweed if somebody else carries the rest."
msgstr "其他東西誰拿一下，海帶我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED.2"
msgid "If we have any more seaweed, put it with this batch."
msgstr "還有海帶的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_COOKED.1"
msgid "Hand me the roasted seaweed. I haven't eaten since we left."
msgstr "把熟海帶遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_COOKED.2"
msgid "I'll try the roasted seaweed. Save me a bite."
msgstr "熟海帶我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_DRIED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_DRIED.1"
msgid "Dried seaweed. I'll keep it for when the boat runs out of food."
msgstr "海帶幹。留著船上沒吃的再拿出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_DRIED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_DRIED.2"
msgid "It crunches. I wasn't expecting that after hauling it out of the water."
msgstr "咬著是脆的。剛從水裡拖出來的時候還真想不到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.GENERIC.1"
msgid "I wonder what the seaweed looks like after a good rain."
msgstr "不知道下場雨以後，海帶會長成什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.GENERIC.2"
msgid "I'll leave the seaweed alone today. It can keep growing."
msgstr "今天先不動海帶。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.PICKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.PICKED.1"
msgid "We can come back for the seaweed after it's had some time to grow."
msgstr "等海帶長好了，我們可以再來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.PICKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_PLANTED.PICKED.2"
msgid "Nothing left on the seaweed for now. Give it time."
msgstr "海帶暫時採不出東西了。再等等吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_STALK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_STALK.1"
msgid "I should make space in my bag for the seaweed stalk."
msgstr "我應該在包裡給海帶莖騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_STALK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWEED_STALK.2"
msgid "Keep that seaweed stalk. I might need it later."
msgstr "海帶莖先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.BROKEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.BROKEN.1"
msgid "I think I can see the seaworthy from here. Hold up the light."
msgstr "從這裡好像能看到海洋之椅。把燈舉高。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.BROKEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.BROKEN.2"
msgid "I want a closer look at the seaworthy. Can you watch my back?"
msgstr "我想湊近看看海洋之椅。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.GENERIC.1"
msgid "I think I can see the seaworthy from here. Hold up the light."
msgstr "從這裡好像能看到海洋之椅。把燈舉高。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.GENERIC.2"
msgid "I want a closer look at the seaworthy. Can you watch my back?"
msgstr "我想湊近看看海洋之椅。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.INSIDE_SW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.INSIDE_SW.1"
msgid "Something about the seaworthy makes me want to look at the floor before I step."
msgstr "看見海洋之椅，我就覺得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.INSIDE_SW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEAWORTHY.INSIDE_SW.2"
msgid "Take a look at the seaworthy. Tell me if anything around it moves."
msgstr "看看海洋之椅。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.EMBERS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.EMBERS.1"
msgid "Careful with the paddle. One splash will finish those embers."
msgstr "用槳小心點。濺一下水，餘火就徹底沒了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.EMBERS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.EMBERS.2"
msgid "You call that a fire? Hand me something dry."
msgstr "這也算火？遞點乾的東西給我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.GENERIC.1"
msgid "I'll sit near the buoyant chiminea till my sleeves dry."
msgstr "我在漂浮火爐旁邊坐到袖子幹了再走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.GENERIC.2"
msgid "The buoyant chiminea is warm enough. Leave me a spot by it."
msgstr "漂浮火爐夠暖了。旁邊給我留個位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.HIGH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.HIGH.1"
msgid "The buoyant chiminea is burning hot. Watch your sleeves."
msgstr "漂浮火爐燒得很旺。當心袖子。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.HIGH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.HIGH.2"
msgid "I think that's enough fuel for the buoyant chiminea. No, really."
msgstr "給漂浮火爐加的燃料夠多了。真的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.LOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.LOW.1"
msgid "The buoyant chiminea barely puts out any heat right now."
msgstr "漂浮火爐現在幾乎沒什麼熱氣了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.LOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.LOW.2"
msgid "The flame in the buoyant chiminea is getting small. Throw another log on."
msgstr "漂浮火爐裡的火變小了。再添根木頭吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.NORMAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.NORMAL.1"
msgid "Can we stop here for a minute? The buoyant chiminea is keeping me warm."
msgstr "我們能在這裡停會兒嗎？靠著漂浮火爐蠻暖和。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.NORMAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.NORMAL.2"
msgid "The buoyant chiminea is warm enough. Leave me a spot by it."
msgstr "漂浮火爐夠暖了。旁邊給我留個位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.OUT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.OUT.1"
msgid "Any spare wood? I let the buoyant chiminea go out while I was resting."
msgstr "還有木頭嗎？我一休息，漂浮火爐裡的火就滅了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.OUT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_CHIMINEA.OUT.2"
msgid "There's no heat coming from the buoyant chiminea. Guess I have to start over."
msgstr "漂浮火爐一點熱氣也沒有了。看來得重新生火。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_LAB.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_LAB.1"
msgid "I could wait by the sea lab, if we're stopping here."
msgstr "如果要在這裡停一下，我可以在海上實驗室旁邊等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_LAB.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_LAB.2"
msgid "That's the sea lab. I wonder if anyone's inside."
msgstr "那是海上實驗室。不知道裡面有沒有人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.LOWFUEL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.LOWFUEL.1"
msgid "Let's top up the sea yard before it stops working."
msgstr "趁修船碼頭還沒停，先把燃料加上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.LOWFUEL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.LOWFUEL.2"
msgid "Keep some fuel by the sea yard. We'll need it soon."
msgstr "在修船碼頭旁放點燃料吧。很快就要用到。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.OFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.OFF.1"
msgid "We're not getting anything out of the sea yard while it's off."
msgstr "修船碼頭關著，什麼也做不了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.OFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.OFF.2"
msgid "The sea yard isn't running. Check it before we start."
msgstr "修船碼頭沒開。啟動前先檢查一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.ON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.ON.1"
msgid "The sea yard is running. Can I sit down now?"
msgstr "修船碼頭運轉起來了。我現在能坐下了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.ON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SEA_YARD.ON.2"
msgid "I can hear the sea yard working. We'll check on it in a minute."
msgstr "聽得見修船碼頭在運轉。待會兒再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKFINSOUP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKFINSOUP.1"
msgid "The shark fin soup can cool off while I find somewhere to sit."
msgstr "先讓魚翅湯涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKFINSOUP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKFINSOUP.2"
msgid "I'll try the shark fin soup. Save me a bite."
msgstr "魚翅湯我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTEN.1"
msgid "Cute. I'm still keeping my fingers out of its mouth."
msgstr "是蠻可愛。我也不會把手伸到它嘴邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTEN.2"
msgid "Aw, it pounced. From over there is fine."
msgstr "還會撲呢。在那邊撲就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.GENERIC.1"
msgid "That's the sandy pile. Can we see it from the boat?"
msgstr "那是沙堆。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.GENERIC.2"
msgid "Mark the sandy pile on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下沙堆的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.INACTIVE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.INACTIVE.1"
msgid "I want a look at the sandy pile. Bring us a little closer."
msgstr "我想看看沙堆。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.INACTIVE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARKITTENSPAWNER.INACTIVE.2"
msgid "That's the sandy pile. Can we see it from the boat?"
msgstr "那是沙堆。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_FIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_FIN.1"
msgid "How much shark fin do we have now? I lost count."
msgstr "現在有多少魚翅了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_FIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_FIN.2"
msgid "If we have any more shark fin, put it with this batch."
msgstr "還有魚翅的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_GILLS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_GILLS.1"
msgid "How much shark gills do we have now? I lost count."
msgstr "現在有多少鯊魚腮了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_GILLS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_GILLS.2"
msgid "I'll carry the shark gills if somebody else carries the rest."
msgstr "其他東西誰拿一下，鯊魚腮我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_TEETHHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_TEETHHAT.1"
msgid "The shark tooth crown can go on the hook when I get home."
msgstr "回家以後，鯊齒王冠可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_TEETHHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARK_TEETHHAT.2"
msgid "Think the shark tooth crown goes with my uniform? I'm wearing it either way."
msgstr "鯊齒王冠配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARX.1"
msgid "That's a sea hound. Stay over there, thanks."
msgstr "是海獵犬。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHARX.2"
msgid "I was having a quiet day till that sea hound showed up."
msgstr "那隻海獵犬來之前，我過得還蠻清靜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECK.1"
msgid "That's the wreck. Can we see it from the boat?"
msgstr "那是沉船。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECK.2"
msgid "Mark the wreck on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下沉船的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_ENTRANCE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_ENTRANCE.1"
msgid "I want a closer look at the entrance. Can you watch my back?"
msgstr "我想湊近看看入口。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_ENTRANCE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_ENTRANCE.2"
msgid "Something about the entrance makes me want to look at the floor before I step."
msgstr "看見入口，我就覺得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_EXIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_EXIT.1"
msgid "Take a look at the exit. Tell me if anything around it moves."
msgstr "看看出口。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_EXIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SHIPWRECKED_EXIT.2"
msgid "Something about the exit makes me want to look at the floor before I step."
msgstr "看見出口，我就覺得走路前得先看地上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.1"
msgid "Count the limestone rounds before you start. I don't want to have to go pick them all up."
msgstr "先數好石灰岩彈再動手。我可不想全都撿回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_LIMESTONE.2"
msgid "I brought the limestone rounds. Who packed the slingshot?"
msgstr "石灰岩彈我帶了。誰拿彈弓？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.1"
msgid "Keep the obsidian rounds in the pouch till we need them."
msgstr "黑曜石彈先放在袋裡，要用時再拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_OBSIDIAN.2"
msgid "Count the obsidian rounds before you start. I don't want to have to go pick them all up."
msgstr "先數好黑曜石彈再動手。我可不想全都撿回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_POISON.1"
msgid "Keep the stink bombs in the pouch till we need them."
msgstr "臭彈先放在袋裡，要用時再拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_POISON.2"
msgid "Count the stink bombs before you start. I don't want to have to go pick them all up."
msgstr "先數好臭彈再動手。我可不想全都撿回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_TAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_TAR.1"
msgid "I brought the tar rounds. Who packed the slingshot?"
msgstr "焦油彈我帶了。誰拿彈弓？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_TAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOTAMMO_TAR.2"
msgid "Count the tar rounds before you start. I don't want to have to go pick them all up."
msgstr "先數好焦油彈再動手。我可不想全都撿回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN.1"
msgid "I'll hold on to the slithering slingshot band till we figure out where it fits."
msgstr "滑行彈弓皮筋我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_BAND_SNAKESKIN.2"
msgid "I've got the slithering slingshot band. I hope the other pieces are nearby."
msgstr "滑行彈弓皮筋找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN.1"
msgid "I'll hold on to the obsidian slingshot frame till we figure out where it fits."
msgstr "黑曜石彈弓框我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_FRAME_OBSIDIAN.2"
msgid "I've got the obsidian slingshot frame. I hope the other pieces are nearby."
msgstr "黑曜石彈弓框找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_HANDLE_TAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_HANDLE_TAR.1"
msgid "I've got the slingshot tar grip. I hope the other pieces are nearby."
msgstr "焦油彈弓手柄找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_HANDLE_TAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLINGSHOT_HANDLE_TAR.2"
msgid "I'll hold on to the slingshot tar grip till we figure out where it fits."
msgstr "焦油彈弓手柄我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLOTMACHINE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLOTMACHINE.1"
msgid "Keep that slot machine. I might need it later."
msgstr "老虎機先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLOTMACHINE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SLOTMACHINE.2"
msgid "How much slot machine do we have now? I lost count."
msgstr "現在有多少老虎機了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE.1"
msgid "Let me get my bat before the snake gets any ideas."
msgstr "趁蛇還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE.2"
msgid "That's a snake. Stay over there, thanks."
msgstr "是蛇。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNING.1"
msgid "That's smoke coming off the viney bush. Back up a little."
msgstr "是藤蔓叢在冒煙。往後退一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNING.2"
msgid "Do we have time to save the viney bush? That fire's getting bigger."
msgstr "現在還來得及救藤蔓叢嗎？火越來越大了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNT.1"
msgid "The viney bush is pretty much ash now. Leave it to cool."
msgstr "藤蔓叢燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.BURNT.2"
msgid "So much for the viney bush. Is anything under the ash still good?"
msgstr "藤蔓叢算是完了。灰底下還有能用的東西嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.CHOPPED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.CHOPPED.1"
msgid "The vines are cut. I still don't want to stick a hand in there."
msgstr "藤砍了，我還是不想伸手進去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.CHOPPED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.CHOPPED.2"
msgid "Done cutting. Let's see how long the snakes stay out."
msgstr "砍完了。看看蛇能多久不回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.GENERIC.1"
msgid "We can look at the viney bush from here. That'll do."
msgstr "在這裡看看藤蔓叢就夠了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEDEN.GENERIC.2"
msgid "Keep quiet around the viney bush. I don't want anything coming out."
msgstr "經過藤蔓叢的時候小點聲。我可不想把裡面的東西引出來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEOIL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEOIL.1"
msgid "If we have any more snake oil, put it with this batch."
msgstr "還有蛇油的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEOIL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKEOIL.2"
msgid "Sort the snake oil out from the rest of the pile for me, will you?"
msgstr "能幫我把蛇油從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKIN.1"
msgid "Keep that snakeskin. I might need it later."
msgstr "蛇皮先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKIN.2"
msgid "I'll carry the snakeskin if somebody else carries the rest."
msgstr "其他東西誰拿一下，蛇皮我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKINHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKINHAT.1"
msgid "Think the snakeskin hat goes with my uniform? I'm wearing it either way."
msgstr "蛇皮帽配我的制服嗎？反正我會戴。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKINHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKESKINHAT.2"
msgid "I'll try the snakeskin hat on. Does it flatten my hair?"
msgstr "我戴一下蛇皮帽。會把頭髮壓扁嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE_POISON.1"
msgid "That's a poison snake. Stay over there, thanks."
msgstr "是毒蛇。麻煩待在那邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SNAKE_POISON.2"
msgid "Hey, poison snake. You don't have to come any closer."
msgstr "喂，毒蛇。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH.1"
msgid "Can we get the dogfish without me leaning any farther over the side?"
msgstr "不再往船外探身，能抓到狗魚嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH.2"
msgid "I think that's a dogfish. I need to get a little closer."
msgstr "好像是狗魚。我得湊近點看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH_DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH_DEAD.1"
msgid "Leave the dead dogfish out of the sun. We'll cook it when we stop."
msgstr "別把死狗魚放在太陽底下。停下來再煮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH_DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SOLOFISH_DEAD.2"
msgid "I could eat that dead dogfish after a little time over a fire."
msgstr "死狗魚上火烤一下，我就能吃了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_LAUNCHER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_LAUNCHER.1"
msgid "I can take the speargun, but I'm bringing my bat too."
msgstr "矛槍可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_LAUNCHER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_LAUNCHER.2"
msgid "Let me get a feel for the speargun before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試矛槍的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_OBSIDIAN.1"
msgid "I can take the obsidian spear, but I'm bringing my bat too."
msgstr "黑曜石長矛可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_OBSIDIAN.2"
msgid "I'm putting the obsidian spear somewhere I won't step on it."
msgstr "我得把黑曜石長矛放到自己踩不到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_POISON.1"
msgid "I can take the poison spear, but I'm bringing my bat too."
msgstr "毒矛可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SPEAR_POISON.2"
msgid "Let me get a feel for the poison spear before anything comes after us."
msgstr "趁還沒東西追過來，讓我先試試毒矛的手感。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.STUNGRAY.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.STUNGRAY.1"
msgid "Hey, stink ray. You don't have to come any closer."
msgstr "喂，惡臭蝠鱝。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.STUNGRAY.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.STUNGRAY.2"
msgid "Leave some room between us and that stink ray."
msgstr "和那隻惡臭蝠鱝保持點距離。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.1"
msgid "That's the sunken boat. Can we see it from the boat?"
msgstr "那是沉船。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.ABANDONED.2"
msgid "I want a look at the sunken boat. Bring us a little closer."
msgstr "我想看看沉船。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.1"
msgid "Mark the sunken boat on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下沉船的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT.GENERIC.2"
msgid "I want a look at the sunken boat. Bring us a little closer."
msgstr "我想看看沉船。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.1"
msgid "The sunken boat is already burnt through. Too late to bring a bucket."
msgstr "沉船都燒透了。現在拿桶也晚了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_BURNT.2"
msgid "The sunken boat is pretty much ash now. Leave it to cool."
msgstr "沉船燒得差不多隻剩灰了。等它涼了再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_1.1"
msgid "I got it out of the water. Now I need someone who can read it."
msgstr "從水裡撈上來了。現在還得找個會看的人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_1.2"
msgid "A little salt on the sextant. Let me wipe it off."
msgstr "六分儀上沾了點鹽。我來擦掉。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_2.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_2.1"
msgid "Don't lose the toy boat now that we finally found it."
msgstr "好不容易找到玩具船，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_2.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_2.2"
msgid "I've got room in my bag for the toy boat, if nobody else wants it."
msgstr "沒人要玩具船的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_3.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_3.1"
msgid "I've got room in my bag for the bottle candle, if nobody else wants it."
msgstr "沒人要酒瓶蠟燭的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_3.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_3.2"
msgid "I don't know what a bottle candle is worth here. I could ask."
msgstr "不知道酒瓶蠟燭在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_4.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_4.1"
msgid "I've got room in my bag for the odd trinket, if nobody else wants it."
msgstr "沒人要奇怪的小飾品的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_4.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_4.2"
msgid "I don't know what an odd trinket is worth here. I could ask."
msgstr "不知道奇怪的小飾品在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_5.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_5.1"
msgid "That boot's seen more water than the one I'm wearing."
msgstr "那隻靴子進過的水比我腳上這隻多。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_5.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUNKEN_BOAT_TRINKET_5.2"
msgid "I'll leave that old boot by the door. Somebody might know who it belonged to."
msgstr "舊靴子先放門邊吧。說不定有人認得它原來是誰的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUPERTELESCOPE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUPERTELESCOPE.1"
msgid "Anybody using the super spyglass? I could use a turn."
msgstr "有人在用超級望遠鏡嗎？我正想用一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUPERTELESCOPE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SUPERTELESCOPE.2"
msgid "I'll be careful with the super spyglass. Stop looking at me like that."
msgstr "我會小心用超級望遠鏡。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SURFBOARD_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SURFBOARD_ITEM.1"
msgid "This thing's wider than my bat, so I might stay on."
msgstr "比球棒寬多了，說不定我能站穩。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SURFBOARD_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SURFBOARD_ITEM.2"
msgid "Is this the part where I learn to balance?"
msgstr "這下該學站穩了吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEETPOTATOSOUFFLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEETPOTATOSOUFFLE.1"
msgid "Hand me the sweet potato souffle. I haven't eaten since we left."
msgstr "把甘薯蛋奶酥遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEETPOTATOSOUFFLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEETPOTATOSOUFFLE.2"
msgid "Put the sweet potato souffle where I can reach it. I'll be hungry later."
msgstr "甘薯蛋奶酥放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO.1"
msgid "I'll carry the sweet potato if somebody else carries the rest."
msgstr "其他東西誰拿一下，甘薯我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO.2"
msgid "Sort the sweet potato out from the rest of the pile for me, will you?"
msgstr "能幫我把甘薯從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_COOKED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_COOKED.1"
msgid "Put the cooked sweet potato where I can reach it. I'll be hungry later."
msgstr "熟甘薯放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_COOKED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_COOKED.2"
msgid "The cooked sweet potato smells good. I get the first bite, right?"
msgstr "熟甘薯聞起來不錯。我可以吃第一口吧？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_OVERSIZED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_OVERSIZED.1"
msgid "Sort the giant sweet potato out from the rest of the pile for me, will you?"
msgstr "能幫我把巨型甘薯從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_OVERSIZED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_OVERSIZED.2"
msgid "How much giant sweet potato do we have now? I lost count."
msgstr "現在有多少巨型甘薯了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_PLANTED.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_PLANTED.1"
msgid "I'll leave the sweet potato alone today. It can keep growing."
msgstr "今天先不動甘薯。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_PLANTED.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_PLANTED.2"
msgid "There's some sweet potato growing here. Watch where you step."
msgstr "這裡長著甘薯。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_SEEDS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_SEEDS.1"
msgid "I'll plant the stellar seeds. You're in charge of remembering to water it."
msgstr "圓形種子我來種。記得澆水就交給你了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_SEEDS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWEET_POTATO_SEEDS.2"
msgid "I've got the stellar seeds. Now I need a patch of dirt and some patience."
msgstr "圓形種子有了。現在得找塊地，還得有點耐心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH.1"
msgid "I have a bat. You have a sword. This is going to be loud."
msgstr "我拿球棒，你拿劍。這下有得打了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH.2"
msgid "That fish looks ready to lunge. Keep the boat moving."
msgstr "那魚看起來要衝過來。別停船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH_DEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH_DEAD.1"
msgid "It's done fighting. The sword might still be useful."
msgstr "它打不動了，那把劍興許還有用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH_DEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.SWORDFISH_DEAD.2"
msgid "I won. Now who's cleaning the fish?"
msgstr "我贏了。現在誰來收拾這條魚？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR.1"
msgid "How much tar do we have now? I lost count."
msgstr "現在有多少焦油了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR.2"
msgid "Sort the tar out from the rest of the pile for me, will you?"
msgstr "能幫我把焦油從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARLAMP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARLAMP.1"
msgid "If you borrow my tar lamp, put it back where you found it."
msgstr "借我的焦油燈可以，用完放回原處。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARLAMP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARLAMP.2"
msgid "I'll be careful with the tar lamp. Stop looking at me like that."
msgstr "我會小心用焦油燈。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARSUIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARSUIT.1"
msgid "Let me move around in the tar suit before we go anywhere."
msgstr "出發前，讓我穿著焦油套裝活動一下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARSUIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TARSUIT.2"
msgid "If the tar suit fits over my uniform, I'll take it."
msgstr "焦油套裝能套在制服外面的話，我就穿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.LOWFUEL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.LOWFUEL.1"
msgid "Let's top up the tar extractor before it stops working."
msgstr "趁焦油提取器還沒停，先把燃料加上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.LOWFUEL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.LOWFUEL.2"
msgid "The tar extractor needs more fuel. Did we bring any?"
msgstr "焦油提取器要加燃料了。我們帶了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.OFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.OFF.1"
msgid "We're not getting anything out of the tar extractor while it's off."
msgstr "焦油提取器關著，什麼也做不了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.OFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.OFF.2"
msgid "Can somebody turn the tar extractor back on? I need it in a minute."
msgstr "誰能把焦油提取器重新打開？我待會兒要用。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.ON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.ON.1"
msgid "The tar extractor is running. Can I sit down now?"
msgstr "焦油提取器運轉起來了。我現在能坐下了嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.ON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_EXTRACTOR.ON.2"
msgid "I can hear the tar extractor working. We'll check on it in a minute."
msgstr "聽得見焦油提取器在運轉。待會兒再來看。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_POOL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_POOL.1"
msgid "How much room do we have to go around the tar slick?"
msgstr "繞開焦油浮膜還剩多少地方可走？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_POOL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_POOL.2"
msgid "Heads up. There's a tar slick right here."
msgstr "當心，這裡就有焦油浮膜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_TRAP.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_TRAP.1"
msgid "I'll carry the tar trap if somebody else carries the rest."
msgstr "其他東西誰拿一下，焦油陷阱我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_TRAP.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TAR_TRAP.2"
msgid "Keep that tar trap. I might need it later."
msgstr "焦油陷阱先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BASE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BASE.1"
msgid "I've got the base. I hope the other pieces are nearby."
msgstr "傳送台底座找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BASE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BASE.2"
msgid "This base came off something. Look for the rest of it."
msgstr "傳送台底座是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BOX.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BOX.1"
msgid "I'll hold on to the box till we figure out where it fits."
msgstr "盒子我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BOX.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_BOX.2"
msgid "I've got the box. I hope the other pieces are nearby."
msgstr "盒子找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_CRANK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_CRANK.1"
msgid "I've got the crank. I hope the other pieces are nearby."
msgstr "曲柄找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_CRANK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_CRANK.2"
msgid "I'll hold on to the crank till we figure out where it fits."
msgstr "曲柄我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_POTATO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_POTATO.1"
msgid "I'll hold on to the stone potato till we figure out where it fits."
msgstr "石制馬鈴薯我先拿著，等弄清該裝在哪裡再說。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_POTATO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_POTATO.2"
msgid "This stone potato came off something. Look for the rest of it."
msgstr "石制馬鈴薯是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_RING.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_RING.1"
msgid "This ring came off something. Look for the rest of it."
msgstr "圓環是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_RING.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELEPORTATO_SW_RING.2"
msgid "I've got the ring. I hope the other pieces are nearby."
msgstr "圓環找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELESCOPE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELESCOPE.1"
msgid "Give me the spyglass. Let me see how it feels to use it."
msgstr "把望遠鏡給我。我試試順不順手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELESCOPE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TELESCOPE.2"
msgid "I'll take the spyglass with me. Better than walking back for it."
msgstr "我把望遠鏡帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.THATCHPACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.THATCHPACK.1"
msgid "Keep that thatch pack. I might need it later."
msgstr "茅草袋先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.THATCHPACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.THATCHPACK.2"
msgid "If we have any more thatch pack, put it with this batch."
msgstr "還有茅草袋的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDALPOOL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDALPOOL.1"
msgid "Mark the tidal pool on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下潮汐池的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDALPOOL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDALPOOL.2"
msgid "I want a look at the tidal pool. Bring us a little closer."
msgstr "我想看看潮汐池。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDAL_PLANT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDAL_PLANT.1"
msgid "I'll leave the tidal plant alone today. It can keep growing."
msgstr "今天先不動潮間帶植物。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDAL_PLANT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIDAL_PLANT.2"
msgid "There's some tidal plant growing here. Watch where you step."
msgstr "這裡長著潮間帶植物。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGEREYE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGEREYE.1"
msgid "I didn't expect to find an eye of the Tiger Shark here. Do you want it?"
msgstr "沒想到這裡會有虎鯊之眼。你想要嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGEREYE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGEREYE.2"
msgid "Is there a story behind the eye of the Tiger Shark? The short version, please."
msgstr "虎鯊之眼有什麼來歷嗎？請挑短的講。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGERSHARK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGERSHARK.1"
msgid "It saw the boat. Of course it saw the boat."
msgstr "它看見船了。就知道躲不掉。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGERSHARK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIGERSHARK.2"
msgid "Keep the fins on that side. I'll watch the other."
msgstr "盯住那邊的背鰭。我看另一邊。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIROEMISU.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIROEMISU.1"
msgid "The tiroemisu can cool off while I find somewhere to sit."
msgstr "先讓提卵米蘇涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIROEMISU.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TIROEMISU.2"
msgid "Hand me the tiroemisu. I haven't eaten since we left."
msgstr "把提卵米蘇遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TOUCAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TOUCAN.1"
msgid "That toucan is hard to keep track of."
msgstr "一轉眼就找不到那隻犀鳥了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TOUCAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TOUCAN.2"
msgid "Look, a toucan. Try not to scare it off."
msgstr "看，有犀鳥。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNET.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNET.1"
msgid "Put the trawl net where I can reach it from my seat."
msgstr "把拖網放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNET.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNET.2"
msgid "If the trawl net comes loose at sea, I'm making you go get it."
msgstr "拖網要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.GENERIC.1"
msgid "What's in the trawl net? I want to see if we got anything good."
msgstr "拖網裡有什麼？我想看看有沒有好東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.GENERIC.2"
msgid "Help me haul the trawl net in. It's heavier than I thought."
msgstr "幫我把拖網收進來。比我想的沉。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOON.1"
msgid "If we leave the trawl net any longer, we're losing the whole catch."
msgstr "拖網再不收，一網東西都要沒了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOON.2"
msgid "The trawl net is going under. Get a hand on it now!"
msgstr "拖網快沉了。馬上伸手抓住！"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOONISH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOONISH.1"
msgid "Bring us closer to the trawl net. It'll sink if we keep waiting."
msgstr "把船往拖網靠一點。再等下去就沉了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOONISH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRAWLNETDROPPED.SOONISH.2"
msgid "The trawl net is sitting lower in the water. I think it's time to pull it in."
msgstr "拖網比剛才沉下去一些。差不多該收了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_13.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_13.1"
msgid "Don't lose the orange soda now that we finally found it."
msgstr "好不容易找到橘子汽水，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_13.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_13.2"
msgid "I've got room in my bag for the orange soda, if nobody else wants it."
msgstr "沒人要橘子汽水的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_14.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_14.1"
msgid "Don't lose the voodoo doll now that we finally found it."
msgstr "好不容易找到巫毒人偶，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_14.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_14.2"
msgid "I've got room in my bag for the voodoo doll, if nobody else wants it."
msgstr "沒人要巫毒人偶的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_15.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_15.1"
msgid "I don't know what an ukulele is worth here. I could ask."
msgstr "不知道尤克里裡在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_15.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_15.2"
msgid "Don't lose the ukulele now that we finally found it."
msgstr "好不容易找到尤克里裡，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_16.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_16.1"
msgid "I've got room in my bag for the license plate, if nobody else wants it."
msgstr "沒人要車牌的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_16.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_16.2"
msgid "I don't know what a license plate is worth here. I could ask."
msgstr "不知道車牌在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_17.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_17.1"
msgid "Don't lose the old boot now that we finally found it."
msgstr "好不容易找到舊靴子，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_17.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_17.2"
msgid "I don't know what an old boot is worth here. I could ask."
msgstr "不知道舊靴子在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_18.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_18.1"
msgid "I've got room in my bag for the ancient vase, if nobody else wants it."
msgstr "沒人要古代花瓶的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_18.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_18.2"
msgid "I don't know what an ancient vase is worth here. I could ask."
msgstr "不知道古代花瓶在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_19.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_19.1"
msgid "Don't lose the brain cloud pill now that we finally found it."
msgstr "好不容易找到腦雲丸，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_19.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_19.2"
msgid "I've got room in my bag for the brain cloud pill, if nobody else wants it."
msgstr "沒人要腦雲丸的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_20.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_20.1"
msgid "I don't know what a sextant is worth here. I could ask."
msgstr "不知道六分儀在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_20.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_20.2"
msgid "I've got room in my bag for the sextant, if nobody else wants it."
msgstr "沒人要六分儀的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_21.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_21.1"
msgid "I don't know what a toy boat is worth here. I could ask."
msgstr "不知道玩具船在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_21.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_21.2"
msgid "Don't lose the toy boat now that we finally found it."
msgstr "好不容易找到玩具船，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_22.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_22.1"
msgid "I don't know what a wine bottle candle is worth here. I could ask."
msgstr "不知道酒瓶蠟燭在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_22.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_22.2"
msgid "Don't lose the wine bottle candle now that we finally found it."
msgstr "好不容易找到酒瓶蠟燭，別再弄丟了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_23.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_23.1"
msgid "I don't know what a broken aac device is worth here. I could ask."
msgstr "不知道損壞的溝通輔助裝置在這裡值多少。我可以去問問。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_23.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TRINKET_IA_23.2"
msgid "I've got room in my bag for the broken aac device, if nobody else wants it."
msgstr "沒人要損壞的溝通輔助裝置的話，我包裡還能裝下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALBOUILLABAISSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALBOUILLABAISSE.1"
msgid "I had plans. Then somebody made tropical bouillabaisse."
msgstr "我原本還有事要做。現在有人做了熱帶魚湯。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALBOUILLABAISSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALBOUILLABAISSE.2"
msgid "Hand me the tropical bouillabaisse. I haven't eaten since we left."
msgstr "把熱帶魚湯遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALFAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALFAN.1"
msgid "I'll be careful with the tropical fan. Stop looking at me like that."
msgstr "我會小心用熱帶風扇。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALFAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TROPICALFAN.2"
msgid "I'll take the tropical fan with me. Better than walking back for it."
msgstr "我把熱帶風扇帶上吧，省得走一半還得回來拿。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TUNACAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TUNACAN.1"
msgid "Canned tuna. Finally, something I don't have to chase."
msgstr "鮪魚罐頭。總算有不用追著跑的午餐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TUNACAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TUNACAN.2"
msgid "If lunch is in a tin, at least nobody's making me do dishes."
msgstr "午餐裝在罐頭裡，吃完也沒人讓我洗碗。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURBINE_BLADES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURBINE_BLADES.1"
msgid "I've got the turbine blades. I hope the other pieces are nearby."
msgstr "渦輪葉片找到了。希望其他零件也在附近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURBINE_BLADES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURBINE_BLADES.2"
msgid "This turbine blades came off something. Look for the rest of it."
msgstr "渦輪葉片是從什麼上面拆下來的。找找其他零件。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN.1"
msgid "I'll be careful with the terra firma forger. Stop looking at me like that."
msgstr "我會小心用土地鍛造器。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURFCRAFTINGSTATION_OBSIDIAN.2"
msgid "Somebody show me how the terra firma forger works. Keep it short."
msgstr "誰給我演示一下土地鍛造器怎麼用。簡單說就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_ASH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_ASH.1"
msgid "How much ashy turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少灰燼地皮？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_ASH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_ASH.2"
msgid "The ashy turf can go here. I'm tired of carrying it."
msgstr "灰燼地皮就鋪這裡吧。我搬累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_BEACH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_BEACH.1"
msgid "Let's lay the beach turf before putting all the furniture back."
msgstr "先把沙灘地皮鋪好，再把東西搬回去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_BEACH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_BEACH.2"
msgid "The beach turf can go here. I'm tired of carrying it."
msgstr "沙灘地皮就鋪這裡吧。我搬累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_JUNGLE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_JUNGLE.1"
msgid "Try a strip of jungle turf by the door. See how it looks."
msgstr "門口鋪一條叢林地皮試試，看看效果。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_JUNGLE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_JUNGLE.2"
msgid "How much jungle turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少叢林地皮？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MAGMAFIELD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MAGMAFIELD.1"
msgid "The magma turf can go here. I'm tired of carrying it."
msgstr "岩漿岩地皮就鋪這裡吧。我搬累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MAGMAFIELD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MAGMAFIELD.2"
msgid "Try a strip of magma turf by the door. See how it looks."
msgstr "門口鋪一條岩漿岩地皮試試，看看效果。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MEADOW.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MEADOW.1"
msgid "Try a strip of meadow turf by the door. See how it looks."
msgstr "門口鋪一條草甸地皮試試，看看效果。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MEADOW.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_MEADOW.2"
msgid "Let's lay the meadow turf before putting all the furniture back."
msgstr "先把草甸地皮鋪好，再把東西搬回去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_SNAKESKIN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_SNAKESKIN.1"
msgid "The snakeskin rug can go here. I'm tired of carrying it."
msgstr "蛇皮地毯就鋪這裡吧。我搬累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_SNAKESKIN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_SNAKESKIN.2"
msgid "Try a strip of snakeskin rug by the door. See how it looks."
msgstr "門口鋪一條蛇皮地毯試試，看看效果。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_TIDALMARSH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_TIDALMARSH.1"
msgid "The tidal marsh turf can go here. I'm tired of carrying it."
msgstr "潮澤地皮就鋪這裡吧。我搬累了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_TIDALMARSH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_TIDALMARSH.2"
msgid "Let's lay the tidal marsh turf before putting all the furniture back."
msgstr "先把潮澤地皮鋪好，再把東西搬回去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_VOLCANO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_VOLCANO.1"
msgid "Let's lay the volcano turf before putting all the furniture back."
msgstr "先把火山地皮鋪好，再把東西搬回去。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_VOLCANO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TURF_VOLCANO.2"
msgid "How much volcano turf do we need to cover that patch?"
msgstr "鋪滿那一塊要多少火山地皮？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER.1"
msgid "I can see the seal in there. I liked it better when it sat still."
msgstr "看得見裡頭那隻海豹了。我還是喜歡它坐著的時候。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER.2"
msgid "Wind like that can take my bat right out of my hands."
msgstr "風大成這樣，連球棒都能從我手裡捲走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER_SEAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER_SEAL.1"
msgid "It's cute when I'm not getting blown across the beach."
msgstr "我沒被吹得滿沙灘跑的時候，它還蠻可愛。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER_SEAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.TWISTER_SEAL.2"
msgid "I'm keeping one hand on my hat, just in case."
msgstr "我還是先按住帽子，以防萬一。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VENOMGLAND.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VENOMGLAND.1"
msgid "Keep that venom gland. I might need it later."
msgstr "毒腺先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VENOMGLAND.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VENOMGLAND.2"
msgid "I should make space in my bag for the venom gland."
msgstr "我應該在包裡給毒腺騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VINE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VINE.1"
msgid "I'll carry the vine if somebody else carries the rest."
msgstr "其他東西誰拿一下，藤蔓我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VINE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VINE.2"
msgid "How much vine do we have now? I lost count."
msgstr "現在有多少藤蔓了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO.1"
msgid "The ground's warm already. Real comforting."
msgstr "地都開始發燙了。真讓人放心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO.2"
msgid "If I wanted this much heat I'd stand next to the kitchen stove."
msgstr "想熱成這樣，我站灶台旁邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANOSTAFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANOSTAFF.1"
msgid "I can take the volcano staff, but I'm bringing my bat too."
msgstr "火山魔杖可以帶上，球棒我也要帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANOSTAFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANOSTAFF.2"
msgid "I'm putting the volcano staff somewhere I won't step on it."
msgstr "我得把火山魔杖放到自己踩不到的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.GENERIC.1"
msgid "Take a look at the volcano Altar of Snackrifice. Tell me if anything around it moves."
msgstr "看看火山祭壇。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.GENERIC.2"
msgid "I think I can see the volcano Altar of Snackrifice from here. Hold up the light."
msgstr "從這裡好像能看到火山祭壇。把燈舉高。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.OPEN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.OPEN.1"
msgid "I want a closer look at the volcano Altar of Snackrifice. Can you watch my back?"
msgstr "我想湊近看看火山祭壇。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.OPEN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_ALTAR.OPEN.2"
msgid "I think I can see the volcano Altar of Snackrifice from here. Hold up the light."
msgstr "從這裡好像能看到火山祭壇。把燈舉高。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_EXIT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_EXIT.1"
msgid "Take a look at the volcano exit. Tell me if anything around it moves."
msgstr "看看火山出口。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_EXIT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_EXIT.2"
msgid "I want a closer look at the volcano exit. Can you watch my back?"
msgstr "我想湊近看看火山出口。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_SHRUB.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_SHRUB.1"
msgid "I'll leave the burnt ash tree alone today. It can keep growing."
msgstr "今天先不動灰燼樹。讓它接著長吧。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_SHRUB.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.VOLCANO_SHRUB.2"
msgid "There's some burnt ash tree growing here. Watch where you step."
msgstr "這裡長著灰燼樹。走路當心腳下。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.ATTACKER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.ATTACKER.1"
msgid "%s, back off a bit. We can talk on shore."
msgstr "%s，先退開一點。上岸再談。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.ATTACKER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.ATTACKER.2"
msgid "%s, easy. You're going to tip the board."
msgstr "%s，動作輕點。板快翻了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.FIRESTARTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.FIRESTARTER.1"
msgid "%s, put that out before it reaches the board."
msgstr "%s，火燒到板子之前趕快撲滅。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.FIRESTARTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.FIRESTARTER.2"
msgid "%s, keep the flames on the beach, please."
msgstr "%s，火留在沙灘上，好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GENERIC.1"
msgid "%s, any good waves today?"
msgstr "%s，今天有好浪嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GENERIC.2"
msgid "%s, wait up. I can't paddle that fast."
msgstr "%s，等等我。我劃不了那麼快。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GHOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GHOST.1"
msgid "%s, leave the board here. I'll go find a heart."
msgstr "%s，把板留在這裡。我去找顆心。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GHOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.GHOST.2"
msgid "%s, stay close. We can still get you back on your feet."
msgstr "%s，別走遠。我們能讓你重新站起來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.MURDERER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.MURDERER.1"
msgid "%s, get off the board and talk to me."
msgstr "%s，從板上下來，跟我說清楚。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.MURDERER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.MURDERER.2"
msgid "%s, I'm staying right here till you stop."
msgstr "%s，你不停手，我就不走。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.REVIVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.REVIVER.1"
msgid "%s, that was a good save. You made it look easy."
msgstr "%s，救得漂亮。看你做起來真輕鬆。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.REVIVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALANI.REVIVER.2"
msgid "%s, you got there before me. I'm glad you did."
msgstr "%s，你比我先到了。還好有你。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALLYINTRO_DEBRIS.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALLYINTRO_DEBRIS.1"
msgid "I want a closer look at the debris. Can you watch my back?"
msgstr "我想湊近看看殘骸。幫我留意身後好嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALLYINTRO_DEBRIS.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALLYINTRO_DEBRIS.2"
msgid "Take a look at the debris. Tell me if anything around it moves."
msgstr "看看殘骸。旁邊有東西動就告訴我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE.1"
msgid "Put the sea wall where I can reach it from my seat."
msgstr "把海牆放到我坐著也夠得著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE.2"
msgid "I'll check the sea wall before we leave the dock."
msgstr "離開碼頭前，我先檢查一下海牆。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM.1"
msgid "I can handle the sea wall. You keep the boat steady."
msgstr "海牆交給我。你穩住船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_ENFORCEDLIMESTONE_ITEM.2"
msgid "I'll check the sea wall before we leave the dock."
msgstr "離開碼頭前，我先檢查一下海牆。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE.1"
msgid "Sort the limestone wall out from the rest of the pile for me, will you?"
msgstr "能幫我把石灰岩牆從這堆東西里挑出來嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE.2"
msgid "If we have any more limestone wall, put it with this batch."
msgstr "還有石灰岩牆的話，就放到這堆一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE_ITEM.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE_ITEM.1"
msgid "I should make space in my bag for the limestone wall."
msgstr "我應該在包裡給石灰岩牆騰點位置。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE_ITEM.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WALL_LIMESTONE_ITEM.2"
msgid "Keep that limestone wall. I might need it later."
msgstr "石灰岩牆先留著。晚點我可能用得上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.GENERIC.1"
msgid "Is there room in the sea chest for one more thing?"
msgstr "海上箱子裡還能再裝一樣嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.GENERIC.2"
msgid "I'm opening the sea chest. Let me know if I pick up anything that isn't mine."
msgstr "我開海上箱子看看。要是誤拿了別人的東西，告訴我一聲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE.1"
msgid "I'm opening the sea chest. Let me know if I pick up anything that isn't mine."
msgstr "我開海上箱子看看。要是誤拿了別人的東西，告訴我一聲。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCHEST.UPGRADED_STACKSIZE.2"
msgid "Is there room in the sea chest for one more thing?"
msgstr "海上箱子裡還能再裝一樣嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCROCODOG.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCROCODOG.1"
msgid "Hey, water crocodog. You don't have to come any closer."
msgstr "喂，水鱷狗。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCROCODOG.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERCROCODOG.2"
msgid "Leave some room between us and that water crocodog."
msgstr "和那隻水鱷狗保持點距離。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERYGRAVE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERYGRAVE.1"
msgid "I want a look at the watery grave. Bring us a little closer."
msgstr "我想看看海墓。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERYGRAVE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WATERYGRAVE.2"
msgid "Mark the watery grave on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下海墓的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BLUE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BLUE.1"
msgid "A blue whale. I'm giving it some room."
msgstr "是藍鯨。我先讓它一點地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BLUE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BLUE.2"
msgid "Nobody told me we'd be this close to a blue whale."
msgstr "也沒人告訴我會離藍鯨這麼近。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BUBBLES.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BUBBLES.1"
msgid "I want a look at the bubbles. Bring us a little closer."
msgstr "我想看看氣泡。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BUBBLES.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_BUBBLES.2"
msgid "Mark the bubbles on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下氣泡的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_BLUE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_BLUE.1"
msgid "That's the blue whale carcass. Can we see it from the boat?"
msgstr "那是藍鯨屍體。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_BLUE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_BLUE.2"
msgid "Mark the blue whale carcass on the map. I'm going to forget where we saw it."
msgstr "在地圖上標一下藍鯨屍體的位置。我肯定會忘。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_WHITE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_WHITE.1"
msgid "I want a look at the white whale carcass. Bring us a little closer."
msgstr "我想看看白鯨屍體。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_WHITE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_CARCASS_WHITE.2"
msgid "That's the white whale carcass. Can we see it from the boat?"
msgstr "那是白鯨屍體。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_TRACK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_TRACK.1"
msgid "I want a look at the trail of bubbles. Bring us a little closer."
msgstr "我想看看氣泡的蹤跡。把船往那邊靠一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_TRACK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_TRACK.2"
msgid "That's the trail of bubbles. Can we see it from the boat?"
msgstr "那是氣泡的蹤跡。在船上能看清嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_WHITE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_WHITE.1"
msgid "I was having a quiet day till that white whale showed up."
msgstr "那隻白鯨來之前，我過得還蠻清靜。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_WHITE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WHALE_WHITE.2"
msgid "Let me get my bat before the white whale gets any ideas."
msgstr "趁白鯨還沒動靜，我先把球棒拿上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.ATTACKER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.ATTACKER.1"
msgid "%s, give me some room. I don't want to swing at you."
msgstr "%s，退開一點。我不想對你揮棒。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.ATTACKER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.ATTACKER.2"
msgid "%s, stop throwing things and look at me."
msgstr "%s，先別丟東西了。看著我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.FIRESTARTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.FIRESTARTER.1"
msgid "%s, back up. I'll help put it out."
msgstr "%s，退後一點。我幫你撲火。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.FIRESTARTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.FIRESTARTER.2"
msgid "%s, did you do that? Get some water."
msgstr "%s，是你弄的？去拿點水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GENERIC.1"
msgid "%s, want to sit here for a while?"
msgstr "%s，要在這裡坐一下嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GENERIC.2"
msgid "%s, I'm putting my snacks where you can't reach them this time."
msgstr "%s，這回我會把零食放到你夠不著的地方。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GHOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GHOST.1"
msgid "%s, stay nearby. I'll bring you back, then we can eat."
msgstr "%s，別走遠。等你回來，我們一起吃東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GHOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.GHOST.2"
msgid "%s, I saved you a banana. I'll find a way to give it to you."
msgstr "%s，我給你留了香蕉。我會想辦法讓你回來吃。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.MURDERER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.MURDERER.1"
msgid "%s, stop. We're going to get help."
msgstr "%s，停手。我們去找人幫忙。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.MURDERER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.MURDERER.2"
msgid "%s, nobody else is getting hurt here."
msgstr "%s，我不會讓這裡再有人受傷。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.REVIVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.REVIVER.1"
msgid "%s, nice work getting them back."
msgstr "%s，還好你把人救回來了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.REVIVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR.REVIVER.2"
msgid "%s, thank you. Here, have a seat."
msgstr "%s，謝謝。來，坐這裡。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_CROWN.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_CROWN.1"
msgid "The crown looks a little fancy for me. I might try it anyway."
msgstr "王冠對我來說有點講究。我還是想試試。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_CROWN.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_CROWN.2"
msgid "I'll borrow the crown just long enough to find a mirror."
msgstr "王冠借我一下。我去照個鏡子就還。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_UNLOCK.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_UNLOCK.1"
msgid "Look, a monkey. Try not to scare it off."
msgstr "看，有猴子。別把它嚇跑了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_UNLOCK.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILBUR_UNLOCK.2"
msgid "Is that a monkey? Hold still, I want a better look."
msgstr "那是猴子嗎？別動，我想看清楚些。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBORE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBORE.1"
msgid "Leave some room between us and that wildbore."
msgstr "和那隻野豬保持點距離。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBORE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBORE.2"
msgid "Hey, wildbore. You don't have to come any closer."
msgstr "喂，野豬。你待在那邊就好。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHEAD.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHEAD.1"
msgid "Is there a story behind the wildbore head? The short version, please."
msgstr "野豬頭有什麼來歷嗎？請挑短的講。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHEAD.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHEAD.2"
msgid "I'll put the wildbore head in my pocket. I can decide what to do with it later."
msgstr "野豬頭先揣兜裡。晚點再想怎麼處理。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHOUSE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHOUSE.1"
msgid "I can see the wildbore house from here. Want to go look?"
msgstr "從這裡能看見野豬舍。要過去看看嗎？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHOUSE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WILDBOREHOUSE.2"
msgid "I could wait by the wildbore house, if we're stopping here."
msgstr "如果要在這裡停一下，我可以在野豬舍旁邊等。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WINDSTAFF.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WINDSTAFF.1"
msgid "I'll check the sail stick before we leave the dock."
msgstr "離開碼頭前，我先檢查一下帆杆。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WINDSTAFF.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WINDSTAFF.2"
msgid "If the sail stick comes loose at sea, I'm making you go get it."
msgstr "帆杆要是在海上鬆脫了，我就讓你去撈。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WIND_CONCH.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WIND_CONCH.1"
msgid "Give me the howling conch. Let me see how it feels to use it."
msgstr "把咆哮海螺給我。我試試順不順手。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WIND_CONCH.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WIND_CONCH.2"
msgid "I'll be careful with the howling conch. Stop looking at me like that."
msgstr "我會小心用咆哮海螺。別那樣看我。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERBISQUE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERBISQUE.1"
msgid "I'll try the wobster bisque. Save me a bite."
msgstr "龍蝦湯我想試試。給我留一口。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERBISQUE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERBISQUE.2"
msgid "Hand me the wobster bisque. I haven't eaten since we left."
msgstr "把龍蝦湯遞給我。出門以後我還沒吃過東西。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERDINNER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERDINNER.1"
msgid "The wobster dinner can cool off while I find somewhere to sit."
msgstr "先讓龍蝦晚宴涼一涼。我去找個地方坐。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERDINNER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOBSTERDINNER.2"
msgid "Put the wobster dinner where I can reach it. I'll be hungry later."
msgstr "龍蝦晚宴放在我夠得著的地方。晚點我會餓。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.ATTACKER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.ATTACKER.1"
msgid "%s, lower your hands. Some of us came here to sail."
msgstr "%s，手放下。我們還有人是來出海的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.ATTACKER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.ATTACKER.2"
msgid "%s, watch where you're swinging that."
msgstr "%s，注意你往哪裡揮。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.FIRESTARTER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.FIRESTARTER.1"
msgid "%s, I've seen what happens when a wooden ship catches fire."
msgstr "%s，我見過木船著火以後是什麼樣。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.FIRESTARTER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.FIRESTARTER.2"
msgid "%s, I'm getting a bucket. Don't light anything else."
msgstr "%s，我去拿桶。別再點火了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GENERIC.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GENERIC.1"
msgid "%s, got any charts that actually lead somewhere?"
msgstr "%s，有沒有能派上用場的海圖？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GENERIC.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GENERIC.2"
msgid "%s, you can tell the story after I've tied up the boat."
msgstr "%s，等我係好船，你再講。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GHOST.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GHOST.1"
msgid "%s, the ship's all right. Now let's get you back."
msgstr "%s，船沒事。現在得把你救回來。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GHOST.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.GHOST.2"
msgid "%s, you can get back to sailing as soon as I find a heart."
msgstr "%s，找到心以後，你就能接著開船。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.MURDERER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.MURDERER.1"
msgid "%s, drop what you're holding. I mean it."
msgstr "%s，把手上的東西放下。我是認真的。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.MURDERER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.MURDERER.2"
msgid "%s, it stops here. Back away."
msgstr "%s，到此為止。退後。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.REVIVER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.REVIVER.1"
msgid "%s, glad you were close enough to help."
msgstr "%s，還好你就在附近，趕得上救人。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.REVIVER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS.REVIVER.2"
msgid "%s, I'll cover the next watch. You've earned a break."
msgstr "%s，下一班我來守。你休息一休息。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGSHAT.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGSHAT.1"
msgid "How am I going to keep the lucky hat from falling off?"
msgstr "我要怎麼戴，幸運帽才不會掉？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGSHAT.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGSHAT.2"
msgid "The lucky hat can go on the hook when I get home."
msgstr "回家以後，幸運帽可以掛到鉤子上。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_CAGE.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_CAGE.1"
msgid "How much cage do we have now? I lost count."
msgstr "現在有多少籠子了？我數亂了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_CAGE.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_CAGE.2"
msgid "I'll carry the cage if somebody else carries the rest."
msgstr "其他東西誰拿一下，籠子我來帶。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY1.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY1.1"
msgid "I've got the bone key. Which lock takes it?"
msgstr "骨鑰匙拿到了。它能開什麼鎖？"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY1.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY1.2"
msgid "One bone key. I hope finding the lock takes less time."
msgstr "骨鑰匙到手。希望找鎖能快一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY2.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY2.1"
msgid "One golden key. I hope finding the lock takes less time."
msgstr "金鑰匙到手。希望找鎖能快一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY2.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY2.2"
msgid "I'll keep the golden key in my pocket where it won't get lost."
msgstr "金鑰匙先放兜裡，免得弄丟。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.1"
msgid "One iron key. I hope finding the lock takes less time."
msgstr "鐵鑰匙到手。希望找鎖能快一點。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WOODLEGS_KEY3.2"
msgid "I'll keep the iron key in my pocket where it won't get lost."
msgstr "鐵鑰匙先放兜裡，免得弄丟。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_MUSIC_TROPICAL.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_MUSIC_TROPICAL.1"
msgid "If WX plays that tune all the way home, I'll know it by tomorrow."
msgstr "要是 WX 一路都放這首，明天我就會唱了。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_MUSIC_TROPICAL.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_MUSIC_TROPICAL.2"
msgid "I'll let WX choose the song. I get to choose how loud."
msgstr "歌讓 WX 挑。音量我來定。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_POISON.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_POISON.1"
msgid "WX gets a circuit for venom. I get a bottle of medicine."
msgstr "WX 防毒用電路。我還是得喝藥。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_POISON.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_POISON.2"
msgid "That's for WX. Keep it separate from the antivenom."
msgstr "這是給 WX 的，別和解毒藥放一起。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_WATER.1
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_WATER.1"
msgid "I'm leaving the installation to WX. I just want to see it go in the water."
msgstr "裝就交給 WX。我只想看它下水。"

#. STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_WATER.2
msgctxt "STRINGS.KIRITZUKA_SPEECH_VARIANTS.DESCRIBE.WX78MODULE_WATER.2"
