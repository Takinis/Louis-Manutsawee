msgstr "我等不及要吃了你。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYBIG.1"
msgid "She's a big softie."
msgstr "她是个温柔的大块头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYBIG.2"
msgid "She's a big softie."
msgstr "她是个温柔的大块头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYSMALL.1"
msgid "She's a smelly, funny little dog. I like her."
msgstr "她是只臭臭的、有趣的小狗。我喜欢她。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBYSMALL.2"
msgid "She's a smelly, funny little dog. I like her."
msgstr "她是只臭臭的、有趣的小狗。我喜欢她。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.ATTACKER"
