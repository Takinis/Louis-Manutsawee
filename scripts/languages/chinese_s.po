msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.GENERIC"
msgid "Too cold and brittle. It needs heat."
msgstr "冷却后太脆了，需要加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.HOT"
msgid "Hot and ready. I'll work quickly."
msgstr "温度正好，抓紧时间用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM"
msgid "It's nearly cold. Better reheat it."
msgstr "快冷了，最好重新加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLEPICKAXE.WARM"
msgid "Still warm enough for a little more work."
msgstr "还热着，可以再用一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.GENERIC"
msgid "Too cold and brittle. It needs heat."
msgstr "冷却后太脆了，需要加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.HOT"
msgid "Hot and ready. I'll work quickly."
msgstr "温度正好，抓紧时间用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.LUKEWARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.LUKEWARM"
msgid "It's nearly cold. Better reheat it."
msgstr "快冷了，最好重新加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLESHOVEL.WARM"
msgid "Still warm enough for a little more work."
msgstr "还热着，可以再用一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC"
msgid "Too cold and brittle. It needs heat."
msgstr "冷却后太脆了，需要加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.HOT"
msgid "Hot and ready. I'll work quickly."
msgstr "温度正好，抓紧时间用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM"
msgid "It's nearly cold. Better reheat it."
msgstr "快冷了，最好重新加热。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUMAROLE_FARM_HOE.WARM"
msgid "Still warm enough for a little more work."
msgstr "还热着，可以再用一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.GENERIC"
msgid "I don't want that clinging to my sword."
msgstr "我可不想让它黏在刀上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "Hold on! We'll get you out!"
msgstr "坚持住！我们来救你！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "There's something trapped inside."
msgstr "有东西被困在里面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_BOTTLE"
msgid "Keep that lid tight."
msgstr "把盖子拧紧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "The supplies are sealed inside."
msgstr "物资封存在里面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "Empty, and ready for storage."
msgstr "空的，可以放东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "I'll put this somewhere we can reach easily."
msgstr "放在方便取用的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.BURNING"
msgid "There's nothing more we can do here."
msgstr "这里已经没什么能做的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "We were too late."
msgstr "我们来迟了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "That isn't a normal recovery. Stand back."
msgstr "这可不是正常的复苏，退后。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "It's occupied. Make sure it stays shut."
msgstr "里面有东西，确保关好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "An empty cage."
msgstr "一只空笼子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "Those look ready to explode. Keep moving!"
msgstr "那些东西随时可能爆炸，别停下！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWERHAT"
msgid "An unusual crown of flowers."
msgstr "一顶特别的花冠。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "Moonlight in an elixir. Wendy will know its use."
msgstr "带着月亮力量的灵药，温蒂知道怎么用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "I hope this brings someone back safely."
msgstr "希望它能让人平安回来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "I'll leave this dark elixir to Wendy."
msgstr "这瓶暗影灵药交给温蒂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVEURN.GENERIC"
msgid "A resting place, still empty."
msgstr "还空着的安息之所。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "I'll leave you to rest."
msgstr "我不打扰你安息。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE_FUMAROLE"
msgid "I'll apply this before entering the heat."
msgstr "进入高温区域前先涂好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "A warming drink after a cold journey."
msgstr "受冻以后喝一杯暖暖身子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "A quiet moment with a cup of tea."
msgstr "可以安静地喝会茶了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "A pleasant cup to clear my head."
msgstr "喝一杯，让思绪清楚些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "I'll try a small sip first."
msgstr "我先喝一小口试试。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "The floral scent is lovely."
msgstr "花香很好闻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "This tea makes me uneasy."
msgstr "这杯茶让我有些不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "Just what I need after all that heat."
msgstr "热了那么久，正需要这一杯。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "A medicinal tea. I'll drink it slowly."
msgstr "药草茶，慢慢喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "These lights need looking after."
msgstr "这些灯需要有人照料。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "A welcoming light along the shore."
msgstr "岸边有灯，走着安心多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "Let's brighten up her home."
msgstr "给她家附近添些灯光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "Let's choose a good place for her home."
msgstr "给她的新家选个好地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_SHELL"
msgid "I'll pay Pearl another visit."
msgstr "可以再去探望寄居蟹奶奶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "A cup of tea, please!"
msgstr "请给我一杯茶！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "Good tea is worth waiting for."
msgstr "好茶值得等一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "Her shop... We should help rebuild it."
msgstr "她的茶铺……我们帮忙重建吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "No tea being served just yet."
msgstr "现在还没有茶可以喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "Now this is worth putting my sword down for."
msgstr "这个值得让我放下刀休息一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "We'll need water before we can soak."
msgstr "得先有水才能泡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "A soak would ease my shoulders."
msgstr "泡一会能让肩膀放松些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "A little more work before we can rest."
msgstr "再做一点就可以休息了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "I'll give her laundry some space."
msgstr "别碰到她晾着的衣物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "It sounds lovely in the breeze."
msgstr "微风吹过时声音很好听。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORSESHOE"
msgid "I'll keep this for the celebration."
msgstr "留着节庆时用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF2"
msgid "Stronger ice magic. Mind your aim."
msgstr "冰冻魔法更强了，注意瞄准。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF3"
msgid "That should stop an enemy in its tracks."
msgstr "应该能让敌人停下来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "Winona's made something clever again."
msgstr "薇诺娜又做出了精巧的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
msgid "There's a plan up there. Watch the loose scrap."
msgstr "上面有张图纸，小心松动的废料。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KING_CANE.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KING_CANE.EMPTY"
msgid "The gem is missing."
msgstr "上面缺了一颗宝石。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KING_CANE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KING_CANE.GENERIC"
msgid "A fine staff for a ruler."
msgstr "很适合统治者的手杖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "Stay close. We'll go together."
msgstr "跟紧，我们一起走。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "It already has someone to follow."
msgstr "它已经有人带着了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "A knight with an unusual mount... or body."
msgstr "这位骑士的样子真特别。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LUNAR_SEED"
msgid "A piece of that strange crown."
msgstr "那顶奇异冠冕的一部分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "Someone important wore a face like this."
msgstr "重要人物曾戴着这样的面具。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "I'll handle the old mask carefully."
msgstr "这张古老的面具得小心拿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "That mask looks heavy."
msgstr "这张面具看着很重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_CHARLIE_BOSSHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_CHARLIE_BOSSHAT"
msgid "I'm not sure I want to wear her face."
msgstr "我不太想戴上她的面具。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_HALFWITHAT"
msgid "I should read the part before wearing this."
msgstr "戴上以前先读读角色的台词。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_PRINCESSHAT"
msgid "All right, I'll try the princess role."
msgstr "好，我试试演公主。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_SAGEHAT"
msgid "Do I look convincing as a sage?"
msgstr "我看着像一位贤者吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MASK_TOADYHAT"
msgid "I'll play the part, but don't expect flattery offstage."
msgstr "我会演好，但下台后可别指望我奉承。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "No one has tended this rack in a while."
msgstr "这个架子很久没人照料了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "We'll have to build another rack."
msgstr "得重新做一个晾晒架。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "The jerky is ready. Let's pack it."
msgstr "肉干好了，收起来吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "Dry enough to put away."
msgstr "已经干了，可以收好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "The salt is ready to collect."
msgstr "盐可以收起来了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "I'll come back when the meat is dry."
msgstr "等肉干好了再来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "The meat won't dry in this rain."
msgstr "这样淋雨，肉干不了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "We need a break in the rain."
msgstr "得等雨停。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "It needs a little more drying time."
msgstr "还需要再晾一会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "Plenty of room to dry supplies."
msgstr "可以晾晒不少物资。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMARMORHAT"
msgid "Made to fit a merm's head."
msgstr "按照鱼人的头做的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Better protection for the merm guards."
msgstr "能给鱼人守卫更好的防护。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.BURNING"
msgid "Keep away from the smoke."
msgstr "离烟远一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.GENERIC"
msgid "The merm didn't survive."
msgstr "这只鱼人没能活下来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMCORPSE.REVIVING"
msgid "It's getting up. Be ready!"
msgstr "它要起来了，准备战斗！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMGUARD_LUNAR"
msgid "A guard strengthened by the moon."
msgstr "受到月亮强化的守卫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERMGUARD_SHADOW"
msgid "A guard with dangerous shadow power."
msgstr "拥有危险暗影力量的守卫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_ARMORY"
msgid "The merms keep their equipment here."
msgstr "鱼人把装备存放在这里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "They've improved their equipment storage."
msgstr "它们改进了装备库。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_LUNAR"
msgid "Moonlight has changed this merm."
msgstr "月光改变了这只鱼人。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_SHADOW"
msgid "Shadow has changed this merm."
msgstr "暗影改变了这只鱼人。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOL"
msgid "Several tools combined into one."
msgstr "把几种工具合在了一起。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOLSHED"
msgid "A shed for the merms' tools."
msgstr "鱼人存放工具的棚子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "They take better care of their tools now."
msgstr "它们更懂得保管工具了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "A better tool for their work."
msgstr "更适合它们干活的工具。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND.COLD"
msgid "It's cooled down completely."
msgstr "已经完全冷却了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND.GENERIC"
msgid "This is where that heat came from."
msgstr "热量原来来自这里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MITEGLAND_COOKED"
msgid "Cooked doesn't always mean safe to eat."
msgstr "烤熟了也未必适合吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Nothing caught yet."
msgstr "还没捕捉到东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "I'll keep my distance from that energy."
msgstr "我会和那团能量保持距离。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "The moon blossoms have dried."
msgstr "月树花已经晒干了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOBOMB"
msgid "Throw it well away from our camp."
msgstr "要扔得离营地远一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOFERTILIZER"
msgid "I'll save this for the garden."
msgstr "把它留给菜园。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOMERMSALVE"
msgid "Medicine prepared for merms."
msgstr "专门为鱼人配制的药。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MOSQUITOMUSK"
msgid "Anything that keeps mosquitoes away is welcome."
msgstr "能赶走蚊子就好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "Don't touch the acid on that tree."
msgstr "别碰到树上的酸液。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBIRD"
msgid "That bird has changed. Watch its approach."
msgstr "那只鸟变异了，留意它靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "It's feeding. Don't get too close."
msgstr "它在进食，别靠太近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "I don't like the way it's watching us."
msgstr "它盯着我们的样子让我不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NONSLIPGRIT"
msgid "Better footing is always useful."
msgstr "站得稳总是好事。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "That should give me a steadier stance."
msgstr "这能让我站得更稳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "We made it through. Check the boat."
msgstr "我们出来了，检查一下船。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.GENERIC"
msgid "It needs kelp before anything else."
msgstr "先放些海带进去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "That's plenty of kelp."
msgstr "海带已经很多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "There's room for a little more kelp."
msgstr "还可以再放一些海带。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "It needs kelp before anything else."
msgstr "先放些海带进去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "That's plenty of kelp."
msgstr "海带已经很多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "There's room for a little more kelp."
msgstr "还可以再放一些海带。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTER"
msgid "Quick in the water. I'll keep an eye on my supplies."
msgstr "在水里很灵活，得看好物资。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN.GENERIC"
msgid "I'll keep my distance from their home."
msgstr "我会和它们的巢穴保持距离。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "They've collected quite a few things."
msgstr "它们收集了不少东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.OTTERDEN_DEAD"
msgid "It's falling apart. Get to solid ground!"
msgstr "要散架了，快回到陆地！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "Stand clear of the burning feathers."
msgstr "离燃烧的羽毛远一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "It's dead. Something killed it here."
msgstr "它死了，有什么东西杀了它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "It's moving again! Get back!"
msgstr "它又动了！退后！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PETALS_DRIED"
msgid "I'll save these for tea."
msgstr "留着这些花瓣泡茶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PETALS_EVIL_DRIED"
msgid "Drying them didn't make them inviting."
msgstr "晒干了也让人不放心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "I should read my part before the show."
msgstr "上台前先读好自己的台词。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "Another play. Who wrote this one?"
msgstr "又一出戏，这次是谁写的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Another script to learn."
msgstr "又有一份剧本要读。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "Something has taken control of them."
msgstr "有东西控制了他们。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYER_HOSTED.ME"
msgid "That's my body! Give it back!"
msgstr "那是我的身体！还给我！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PLAYING_CARD"
msgid "One card. I'll need the rest to play."
msgstr "只有一张牌，得找齐才能玩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "A campfire I can bring along."
msgstr "可以随身带走的篝火。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINCARVER"
msgid "A smaller blade for careful work."
msgstr "适合精细雕刻的小刀。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "Can you still recognize me?"
msgstr "还能认出我吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "I'll need to carve a face first."
msgstr "先刻出一张脸来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUEEN_TORCH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUEEN_TORCH"
msgid "I'll keep watch by this strange flame."
msgstr "我会借着这团奇异的火光警戒。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITHAT"
msgid "Warm ears for a cold day."
msgstr "天冷时可以暖暖耳朵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGHORN"
msgid "Let's see who answers this call."
msgstr "看看谁会回应号角。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "A way to call for storage when I need it."
msgstr "需要时可以召来储物的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Those guards aren't here for a friendly visit."
msgstr "那些守卫来者不善。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKINGSPEAR"
msgid "A spear with a sturdy grip."
msgstr "握起来很牢靠的长矛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "A furious ruler. Watch the claws."
msgstr "愤怒的统治者，小心它的爪子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_LUCKY"
msgid "I'll have to be quick to catch that one."
msgstr "想抓住它，动作得快。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RABBITKING_PASSIVE"
msgid "I'll approach with proper respect."
msgstr "我会礼貌地靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RECORD_BALATRO"
msgid "A good tune for another round."
msgstr "适合再玩一局的曲子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Music for a spooky evening."
msgstr "适合惊悚夜晚的音乐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY.ACID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY.ACID"
msgid "The acid is eating into its shell."
msgstr "酸液正在侵蚀它的甲壳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY.BOULDER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY.BOULDER"
msgid "I'll wait for it to come out."
msgstr "等它出来再说。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.ACID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.ACID"
msgid "Its shell is changing. Watch carefully."
msgstr "它的甲壳在变化，仔细看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.BOULDER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.BOULDER"
msgid "It's guarding itself. Wait for an opening."
msgstr "它正在防御，等破绽出现。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS.GENERIC"
msgid "Those claws have quite a reach."
msgstr "那对钳子的攻击范围很大。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROCKY_BOSS_SHADOW"
msgid "I'll need more than an ordinary blade for this."
msgstr "对付它得用更强的刀。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "I'll check both ends before crossing."
msgstr "过桥前先检查两端是否固定好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Not the glasses I usually see Winona wearing."
msgstr "和平时见薇诺娜戴的不太一样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SADDLE_SHADOW"
msgid "I'll check the saddle before riding."
msgstr "骑上去之前先检查马鞍。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTLICK_IMPROVED"
msgid "A better treat for our traveling companion."
msgstr "给旅途伙伴准备的更好盐舔块。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTY_DOG"
msgid "Hello there! Coming along?"
msgstr "你好！要一起走吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SALTY_DOGHAT"
msgid "A gift from a little friend."
msgstr "小伙伴送的礼物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Stay clear of its whole length."
msgstr "整段身体都要避开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "Now! Strike before it recovers!"
msgstr "趁现在！别让它恢复！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Watch the head. That's where it strikes."
msgstr "盯住头部，攻击从那里来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "Keep away from those jaws!"
msgstr "远离那张大嘴！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "I won't let that near anyone's head."
msgstr "我不会让它靠近任何人的头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_BATTLEAXE"
msgid "A powerful axe. I still prefer my katana."
msgstr "很强的斧头，我还是更喜欢自己的刀。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_BEEF_BELL"
msgid "I'll ring it with care."
msgstr "我会谨慎地摇响它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHADOW_HEART_VEIN"
msgid "I'll handle this with care."
msgstr "这东西得谨慎处理。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHALLOW_GRAVE"
msgid "I'll pay my respects."
msgstr "让我致以敬意。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHELLWEAVER"
msgid "Let's put these materials to good use."
msgstr "用这些材料做些有用的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROUDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROUDEN.GENERIC"
msgid "Keep your distance until we understand its attacks."
msgstr "先摸清攻击方式，保持距离。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROUDEN.PUDDLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SHROUDEN.PUDDLE"
msgid "There! Aim for the eye!"
msgstr "那里！瞄准眼睛！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "Those blossoms have changed the shrine."
msgstr "那些花改变了祭坛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "These flowers make the shrine feel unsettling."
msgstr "这些花让祭坛令人不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "Keep the ammunition sorted and ready."
msgstr "把弹药整理好，以便随时取用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "Dreadstone shots. Handle them carefully."
msgstr "绝望石弹药，得小心拿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "Sticky shots to slow an enemy."
msgstr "黏住敌人用的弹药。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "Explosive shots. Keep them away from fire."
msgstr "爆炸弹药，远离明火。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Honey makes a surprisingly sticky weapon."
msgstr "蜂蜜也能做出很黏的弹药。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "I don't want to stand near the impact."
msgstr "我可不想站在落点附近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Sharp husks packed into ammunition."
msgstr "把锋利的外壳做成了弹药。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Those fragments should strike sharply."
msgstr "那些碎片应该很锋利。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "Bright ammunition. Aim carefully."
msgstr "发亮的弹药，得小心瞄准。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER"
msgid "Metal feathers should carry quite an impact."
msgstr "金属羽毛打中应该很痛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_STINGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTAMMO_STINGER"
msgid "A sting delivered from a safe distance."
msgstr "可以站远一点射出蜂刺。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOTMODKIT"
msgid "Walter's kit for improving his weapon."
msgstr "沃尔特改进武器用的工具包。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_MIMIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_MIMIC"
msgid "That's a very unusual slingshot band."
msgstr "很不寻常的弹弓皮筋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_PIGSKIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_PIGSKIN"
msgid "A sturdy band for repeated shots."
msgstr "适合反复发射的结实皮筋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_TENTACLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_BAND_TENTACLE"
msgid "Flexible, though I don't like touching it."
msgstr "很有韧性，不过我不喜欢它的触感。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_BONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_BONE"
msgid "A frame carved from bone."
msgstr "用骨头做成的弓架。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_GEMS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_GEMS"
msgid "A gem-set frame. Quite elaborate."
msgstr "镶着宝石的弓架，相当精巧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK"
msgid "A finely engineered slingshot frame."
msgstr "结构精密的弹弓弓架。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0"
msgid "There's still work to do on this frame."
msgstr "这副弓架还需要加工。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_JELLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_JELLY"
msgid "A soft grip. I hope it stays secure."
msgstr "握柄很软，希望不会打滑。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_SILK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_SILK"
msgid "A neatly wrapped silk grip."
msgstr "用蛛丝仔细缠好的握柄。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_STICKY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_STICKY"
msgid "No chance of dropping that easily."
msgstr "这样就不容易脱手了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH"
msgid "A grip wrapped in that strange cloth."
msgstr "用那种奇异布料包好的握柄。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWBALL_ITEM"
msgid "Ready for a little target practice?"
msgstr "准备好练练投掷了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWMAN.GENERIC"
msgid "I'll give it a proper hat."
msgstr "给它戴一顶合适的帽子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "A good start. Let's add the rest."
msgstr "开了个好头，再把剩下的堆上去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "Keep the fire from spreading."
msgstr "别让火势蔓延。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "That spider won't bother us again."
msgstr "这只蜘蛛不会再袭击我们了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "It's getting back up!"
msgstr "它又爬起来了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "Stay clear until it's burned out."
msgstr "等烧完以后再靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "A hard fight, finally over."
msgstr "一场苦战，终于结束了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "Back into position! She's moving!"
msgstr "重新准备！它动了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STALKER_NPC"
msgid "I'll hear you out. For now."
msgstr "我先听听你要说什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "A firm seat after a long day."
msgstr "忙了一天，可以坐在这里歇歇。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "I'll find another seat."
msgstr "我找别的地方坐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_TABLE.GENERIC"
msgid "A sturdy table for our camp."
msgstr "适合营地的结实桌子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "Someone has already set something here."
msgstr "有人已经在上面放了东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "It's lost all that stored water."
msgstr "储存的水分都晒干了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.THULECITEBUGNET"
msgid "A net sturdy enough for difficult catches."
msgstr "足够结实，能对付难抓的目标。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TILLWEED_DRIED"
msgid "Dried herbs can still be useful."
msgstr "晒干的药草也有用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "It needs heat before it's useful."
msgstr "加热以后才能发挥作用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "I'd better put this down before it burns me."
msgstr "得赶快放下，免得烫伤。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "Hot enough. Mind where you step."
msgstr "温度够了，小心落脚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "Still dangerous, though it's cooling."
msgstr "虽然在冷却，但仍有危险。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.BURNING"
msgid "The tree is burning!"
msgstr "树烧起来了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "The trunk has been cut down."
msgstr "树干已经砍断了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK.GENERIC"
msgid "I'll check the trunk before swinging."
msgstr "动手前先看看树干。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK_SAPLING"
msgid "Give it room to grow."
msgstr "留点地方让它生长。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TREE_ROCK_SEED"
msgid "I'll find a place to plant it."
msgstr "找个地方种下吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURF_VAULT"
msgid "Flooring from that ancient place."
msgstr "来自那处古老遗迹的地皮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.TURF_VENT"
msgid "Ground from around the vents."
msgstr "喷口附近的地皮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "No light from that anymore."
msgstr "已经不能照明了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "I'll follow its direction, carefully."
msgstr "我会沿着它指的方向谨慎前进。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "This is the room it was pointing to."
msgstr "它指的就是这个房间。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "It doesn't guide me outside that place."
msgstr "离开那里就不能指路了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Watch above you!"
msgstr "小心头顶！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "It fits. I'll watch what changes."
msgstr "装进去了，看看有什么变化。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Let's check the room before pulling it."
msgstr "拉动之前先检查房间。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_DECON_DOOR"
msgid "I'll be ready when that door opens."
msgstr "门打开时我会做好准备。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_DECON_MISTER"
msgid "That nozzle looks ready to spray."
msgstr "那个喷头随时可能喷水。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY"
msgid "Let's find the lock this belongs to."
msgstr "找找它对应的锁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "This needs a source of power."
msgstr "需要给它供能。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_EXIT"
msgid "I can't secure a rope here."
msgstr "这里固定不了绳子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "There's the key. Check for traps."
msgstr "钥匙在那里，小心机关。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "The key has been taken."
msgstr "钥匙已经取走了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "A rope should give us a way back up."
msgstr "绑上绳子就能爬回去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_ORB"
msgid "An orb from the ruins. I'll keep it safe."
msgstr "遗迹里的球体，先妥善收好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_ORB_REFINED"
msgid "It's ready for the next step."
msgstr "已经处理好了，可以继续使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Keep clear of its attacks!"
msgstr "注意躲开它的攻击！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "We still need a few pieces."
msgstr "还缺一些部件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "I'll choose a defensible spot."
msgstr "选个适合防守的位置。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "A strong guard to fight beside."
msgstr "可以并肩作战的强力守卫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "I'll keep my distance from that tower."
msgstr "我会和那座塔保持距离。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "Built and ready. It needs power."
msgstr "已经建好，还需要供能。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "An important piece. Don't leave it behind."
msgstr "重要的部件，别落下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Ancient equipment that still has a purpose."
msgstr "古老的装置，依然可以使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_RUNE"
msgid "I can't read these markings."
msgstr "我看不懂这些符文。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE1"
msgid "There's a grim history carved here."
msgstr "这里刻着一段惨痛的历史。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE1_STALKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE1_STALKER"
msgid "I can understand why you remember this."
msgstr "我能理解你为什么记得这件事。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE2"
msgid "I'll study the carvings more closely."
msgstr "我再仔细看看雕刻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_STATUE.LORE3"
msgid "There's more to this history than I expected."
msgstr "这段历史比我想的复杂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "We need to repair it first."
msgstr "得先修好它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "Ready to travel. Keep your equipment close."
msgstr "可以传送了，带好装备。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "It needs power before we can leave."
msgstr "供能以后才能离开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION"
msgid "This way isn't ready yet."
msgstr "这条通路还没修好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "The switch is broken."
msgstr "开关坏了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "A switch for the lights? Let's check."
msgstr "照明的开关？检查一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "I'll make sure there's room for its return."
msgstr "得留出它飞回来的空间。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT"
msgid "That's an enormous machine. Watch its arms."
msgstr "好大的机器，小心它的手臂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "There's a lot of machinery under that cover."
msgstr "盖布下面有不少机械部件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "We'll need space to assemble this."
msgstr "需要空地来组装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "I'll keep the parts together."
msgstr "把部件都收在一起。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "One of its legs. Still enormous."
msgstr "它的一条腿，依旧很大。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "Something else is controlling that machine."
msgstr "有别的东西在控制那台机器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "There's more to this machine than I thought."
msgstr "这台机器比我想的复杂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_BEACON"
msgid "This should help us direct the machines."
msgstr "应该能帮助我们指挥机器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "Beyond repair, but some parts are still useful."
msgstr "修不好了，不过有些部件还能用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "A flying machine. Watch its approach."
msgstr "飞行机器，留意它靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "It's inactive. Check it before switching it on."
msgstr "还没启动，开启前先检查。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_PARTS"
msgid "Useful spare parts."
msgstr "能用的备用零件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "We can repair it or recover the parts."
msgstr "可以修好，也可以拆下零件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "Stay close, little machine."
msgstr "跟紧，小机器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Don't let it roll behind us."
msgstr "别让它滚到我们背后。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Not moving yet."
msgstr "还没有动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "A strong barrier. I'll look for a way through."
msgstr "坚固的障碍，找找能通过的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Flooring for a proper workshop."
msgstr "适合工坊的地板。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_LEVER"
msgid "Check what it controls before pulling."
msgstr "先看看它控制什么再拉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "A place to assemble and repair equipment."
msgstr "组装和修理装备的地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "A real glove, left behind."
msgstr "遗落的一只真正的手套。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "His notes might tell us something."
msgstr "他的记录也许能提供线索。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "I'd prefer to keep both feet on the boat."
msgstr "我还是想把双脚留在船上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "That beefalo looks rather unusual."
msgstr "那只皮弗娄牛有些奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "A trader! What have you brought?"
msgstr "商人！你带了些什么？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "A promise of another chance."
msgstr "意味着还能有一次机会。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "Too much power! Stand back!"
msgstr "能量过载了！退后！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "It's resting until it's needed."
msgstr "暂时停着，等需要时再用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.CHARGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.CHARGED"
msgid "Charged and ready to command the machines."
msgstr "充好电了，可以指挥机器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.CHARGING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.CHARGING"
msgid "Wait for the charge to finish."
msgstr "等它充完电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.GENERIC"
msgid "A control for Winona's machines."
msgstr "薇诺娜机器的控制器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_REMOTE.OFF"
msgid "It needs power first."
msgstr "得先通电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "It will be useful when darkness comes."
msgstr "天黑时就能派上用场。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "Ready to help with the supplies."
msgstr "可以帮忙搬运物资了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "I'll let it finish charging."
msgstr "等它充好电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "A useful little companion for camp chores."
msgstr "营地里做杂事的实用小帮手。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "No power. I'll check the supply."
msgstr "没电了，检查一下供电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "We'll leave it to rest for now."
msgstr "先让它休息。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "Ready for a quick journey."
msgstr "可以快速出行了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "It needs a little more charging time."
msgstr "还要再充一会电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "Winona has made traveling easier."
msgstr "薇诺娜让出行方便多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "No power for the journey yet."
msgstr "暂时没有传送用的能量。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "Put it out before the machinery is ruined!"
msgstr "赶快灭火，别让装置烧坏！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "The machinery is ruined."
msgstr "装置已经烧坏了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "I'll choose a safe place to arrive."
msgstr "选一个安全的落脚位置。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "It won't work without power."
msgstr "没有能量就无法使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "She made this with such care."
msgstr "她做得很用心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOBY_TREAT"
msgid "A reward for a very good companion."
msgstr "给好伙伴的奖励。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORM_BOSS"
msgid "Keep moving! Don't let it surround you!"
msgstr "继续移动！别让它围住你！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORM_BOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORM_BOSS_SHADOW"
msgid "Watch the ground. Don't let it surround us."
msgstr "留意地面，别让它包围我们。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_NABBAG"
msgid "That bag can carry quite a haul."
msgstr "那个袋子能装不少东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_REVIVER"
msgid "I'll keep it safe until it's needed."
msgstr "妥善收好，留到需要时使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WORTOX_SOULJAR"
msgid "Wortox should handle those souls."
msgstr "那些灵魂还是交给沃拓克斯处理。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "Moonlight has changed the swamp's power."
msgstr "月光改变了沼泽的力量。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "A dangerous kind of power for the swamp."
msgstr "给沼泽带来了一种危险的力量。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_CHESS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_CHESS"
msgid "A circuit for commanding clockworks."
msgstr "指挥发条机械的电路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_DIGESTION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_DIGESTION"
msgid "A circuit to improve digestion."
msgstr "改善消化的电路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_LIGHT2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_LIGHT2"
msgid "A brighter light for the dark."
msgstr "可以照得更亮的电路。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_RADAR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_RADAR"
msgid "Useful for finding what's nearby."
msgstr "可以用来探查附近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SCREECH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SCREECH"
msgid "I'll stand back before it makes a sound."
msgstr "发出声音之前，我先站远点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SHIELDING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SHIELDING"
msgid "Extra protection is always welcome."
msgstr "多些防护总是有益的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SPIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_SPIN"
msgid "Leave room before testing this circuit."
msgstr "测试前先留出空间。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78MODULE_STACKSIZE"
msgid "More supplies in the same space."
msgstr "同样的空间可以装更多物资。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_BACKUPBODY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "A spare body. That's quite a precaution."
msgstr "备用的身体，准备得真充分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A delivery machine. Keep the cargo secure."
msgstr "运输用的机器，货物要放稳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_SCOUT"
msgid "It can scout ahead of us."
msgstr "可以让它先去侦察。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_ZAP"
msgid "I should stay clear of its discharge."
msgstr "要避开它的放电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "This controls the electric drone."
msgstr "用来控制电击无人机。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "That's too hard for me to bite."
msgstr "太硬了，我可咬不动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It's soaked through now."
msgstr "现在已经泡湿了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I hope that trap holds."
msgstr "希望这个陷阱足够牢固。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "A container built for WX-78."
msgstr "给WX-78用的储物容器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_POSSESSEDBODY"
msgid "WX-78? Something is wrong with that body."
msgstr "WX-78？这具身体有问题。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "Watch what that shadow machine does."
msgstr "注意那台暗影机器的动作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WX78_SHADOWDRONE_HARVESTER"
msgid "A machine that gathers supplies."
msgstr "采集物资的机器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.W_RADIO"
msgid "Let's hear what comes through."
msgstr "听听能收到什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "A chair for a well-earned rest."
msgstr "可以好好休息的摇椅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTHAT"
msgid "A knight's hat. How does it look?"
msgstr "骑士的帽子，戴着怎么样？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "The celebration will need a new shrine."
msgstr "得重新做一座祭坛来庆祝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "It needs an offering first."
msgstr "得先放上供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "Let's prepare for the celebration!"
msgstr "准备过节吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.YOTH_KNIGHTSTICK
