msgid "Cooking phase in progress. Stay focused."
msgstr "烹饪进行中。保持专注。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "At long last!"
msgstr "终于！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "Oh, don't tell me I'm the one who has to cook..."
msgstr "哦，别告诉我得由我来做饭……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD1"
msgid "Honestly, who doesn't eat the head first?"
msgstr "说真的，谁不是先吃头的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD2"
msgid "Doesn't look too bad, considering."
msgstr "考虑到各种情况，看起来还不算太糟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD3"
msgid "Give me two of 'em and I can do a MacTusk impression."
msgstr "给我两根，我就能模仿麦克塔斯克了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD4"
msgid "Does anyone else smell something wicked?"
msgstr "还有别人闻到什么不祥的味道吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD5"
msgid "A log for eating, not for burning. A pleasant change."
msgstr "用来吃而不是用来烧的木头。真是令人愉快的变化。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD6"
msgid "I'm going to enjoy every bite."
msgstr "我要好好享受每一口。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD7"
msgid "Certainly beats rainwater."
msgstr "当然比雨水好喝。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD8"
msgid "I prefer it piping hot."
msgstr "我喜欢喝滚烫的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_FOOD9"
msgid "Who knew something from a bird could be so tasty?"
msgstr "谁想得到鸟身上的东西能这么好吃？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENT"
msgid "A lovely little bauble."
msgstr "可爱的小装饰球。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_ORNAMENTBOSS"
