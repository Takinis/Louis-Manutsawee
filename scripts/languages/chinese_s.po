msgstr "祝大家冬季盛宴快乐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Looks lovely."
msgstr "看起来真漂亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WINTER_TREE.YOUNG"
