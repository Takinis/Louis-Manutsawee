#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE.2"
msgid "The contest needs its judge."
msgstr "评判比赛总得有位裁判。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE.1"
msgid "I should find out where the judge is."
msgstr "先去看看裁判在哪儿。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE.2"
msgid "The contest needs its judge."
msgstr "评判比赛总得有位裁判。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN.1"
msgid "I remember this one from before."
msgstr "这个以前学过，我还记得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN.2"
msgid "Perhaps someone else could use the lesson."
msgstr "也许别人还没学过。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL_GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL_GENERIC.1"
msgid "I don't see a way to do that yet."
msgstr "我还没找到做法。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL_GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ACTIONFAIL_GENERIC.2"
msgid "I'll have to try another approach."
msgstr "得换个办法试试。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT.1"
msgid "Hold steady, just a little further."
msgstr "稳住，还差一点。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT.2"
msgid "I can still make it."
msgstr "还有机会。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT_DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT_DONE.1"
msgid "There. Just as I practiced."
msgstr "成了，和平时练的一样。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT_DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACCOMPLISHMENT_DONE.2"
msgid "Did you see that one?"
msgstr "刚才那下你看见了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDBATS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDBATS.1"
msgid "Cover your eyes! Something's dripping from those wings."
msgstr "护住眼睛！翅膀上有东西滴下来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDBATS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ACIDBATS.2"
msgid "Under cover, quickly!"
msgstr "快找地方躲雨！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ADVENTUREFAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ADVENTUREFAIL.1"
msgid "Maxwell, I'd like another try."
msgstr "麦斯威尔，我想再试一次。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ADVENTUREFAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ADVENTUREFAIL.2"
msgid "I'll remember where I went wrong."
msgstr "我记得是在哪一步出了错。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.1.1"
msgid "Get off that patch of ground!"
msgstr "快离开那块地！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.1.2"
msgid "Look where you step!"
msgstr "留意脚下！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.2.1"
msgid "A crack, right under my heel!"
msgstr "脚跟底下裂开了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.2.2"
msgid "Move before it caves in!"
msgstr "趁地面还没塌，快走！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.3.1"
msgid "Over here, the ground is still firm!"
msgstr "来这边，地还没塌！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_SINKHOLE.3.2"
msgid "Hold my hand, I'll pull you clear!"
msgstr "把手给我，我拉你上来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.1.1"
msgid "I hope this suits your taste."
msgstr "不知合不合您的心意。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.1.2"
msgid "May we camp here in peace?"
msgstr "能让我们安心在这里扎营吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.2.1"
msgid "I haven't come empty-handed."
msgstr "我带了东西来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.2.2"
msgid "Shall I set it by your feet?"
msgstr "我放在您脚边好吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.3.1"
msgid "For you, with my respects."
msgstr "请您收下这份心意。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ANTLION_TRIBUTE.3.2"
msgid "I've brought my share."
msgstr "这是我该给的那份。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE.1"
msgid "Oh! I see how the pieces fit now."
msgstr "原来如此，这几处能连起来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE.2"
msgid "Let me try that once from memory."
msgstr "让我凭记忆试一次。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NO_POWER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NO_POWER.1"
msgid "Even the little lights are out."
msgstr "连小灯都熄了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NO_POWER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_NO_POWER.2"
msgid "I think we need to restore the power first."
msgstr "得先恢复这里的供能。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE.1"
msgid "I've seen these marks before."
msgstr "我见过这些记号。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE.2"
msgid "I could recite this part by heart."
msgstr "这段我已经会背了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.1.1"
msgid "Back toward the entrance!"
msgstr "往入口退！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.1.2"
msgid "We should go, now."
msgstr "该走了，快！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.2.1"
msgid "Did you feel that jolt?"
msgstr "感觉到刚才那一下了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.2.2"
msgid "Mind the falling stones!"
msgstr "当心落石！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.3.1"
msgid "The walls are shaking!"
msgstr "墙在晃！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATRIUM_DESTABILIZING.3.2"
msgid "Nobody stay behind!"
msgstr "别有人落在后面！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ATTACK.1"
msgid "My arms feel light. Shall we practice?"
msgstr "手臂轻快多了，要对练吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ATTACK.2"
msgid "There's more strength in my swing today."
msgstr "今天挥刀格外有力。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK.1"
msgid "A spark jumped between my fingers!"
msgstr "指尖跳出了一点电光！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK.2"
msgid "Even my hair is standing up."
msgstr "连头发都竖起来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY.1"
msgid "The drops roll right off my sleeve."
msgstr "水珠顺着袖口滑下去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY.2"
msgid "I can walk in the rain like this."
msgstr "这样就能在雨里走了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION.1"
msgid "I can take a knock like this."
msgstr "现在挨一下也撑得住。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION.2"
msgid "My guard feels firmer already."
msgstr "防守比刚才稳多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE.1"
msgid "I could take the late watch tonight."
msgstr "今晚我可以守后半夜。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE.2"
msgid "I haven't yawned once."
msgstr "我连个哈欠都没打。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS.1"
msgid "My hands remember every step."
msgstr "每道工序我都记得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS.2"
msgid "I'll finish this before supper."
msgstr "晚饭前就能做好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BECOMEGHOST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BECOMEGHOST.1"
msgid "Oh. I can see through my hands."
msgstr "咦，我能透过手掌看东西了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BECOMEGHOST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BECOMEGHOST.2"
msgid "Can anyone hear me like this?"
msgstr "我这样说话有人听得见吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BEES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BEES.1"
msgid "That buzzing is getting closer!"
msgstr "嗡嗡声越来越近了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BEES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BEES.2"
msgid "Ow! Please find another target!"
msgstr "疼！别围着我了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_LEAK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_LEAK.1"
msgid "Water under the boards! Pass me a patch."
msgstr "船板在渗水！把补丁递给我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_LEAK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_LEAK.2"
msgid "I can feel water round my ankles."
msgstr "水都漫到我脚踝了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINK.1"
msgid "Everyone to shore! Leave the cargo!"
msgstr "往岸上去！先别管货物了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOAT_SINK.2"
msgid "The deck's going under!"
msgstr "甲板要没进水里了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOOMERANG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOOMERANG.1"
msgid "Back already? My hand was in the wrong place."
msgstr "这么快就回来了？手没接对。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOOMERANG.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BOOMERANG.2"
msgid "Next time I'll keep my eyes on it."
msgstr "下次得盯着它飞回来的方向。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BRAVERY_POTION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BRAVERY_POTION.1"
msgid "I can stand still when the bats come now."
msgstr "蝙蝠再来，我也能站稳了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BRAVERY_POTION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BRAVERY_POTION.2"
msgid "My hands have stopped shaking."
msgstr "手总算不抖了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BURNT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BURNT.1"
msgid "Ow! That left a mark."
msgstr "好烫！都烫红了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BURNT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_BURNT.2"
msgid "I'd better cool that burn."
msgstr "得给烫伤的地方降降温。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CALL_BEEF.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CALL_BEEF.1"
msgid "Come along. You know my voice."
msgstr "过来吧，你认得我的声音。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CALL_BEEF.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CALL_BEEF.2"
msgid "Here, beefalo! This way!"
msgstr "皮弗娄牛，这边！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANFIX.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANFIX.1"
msgid "\nI could mend that seam."
msgstr "\n这道裂缝我能补。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANFIX.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANFIX.2"
msgid "\nLet me fetch my repair kit."
msgstr "\n我去拿修理工具。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS.1"
msgid "I'm a few pieces short."
msgstr "还缺几份材料。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS.2"
msgid "Let me check what I have in my pack."
msgstr "我再翻翻包里有什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_STATION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_STATION.1"
msgid "This needs a proper workbench."
msgstr "这得在工作台上做。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_STATION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_STATION.2"
msgid "I'll take the pieces back to camp."
msgstr "我把材料带回营地再做。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_TECH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_TECH.1"
msgid "I haven't learned that technique yet."
msgstr "这种手法我还没学会。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_TECH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANNOT_BUILD.NO_TECH.2"
msgid "Would someone show me the first step?"
msgstr "谁能给我示范第一步？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANTBUILDHERE_YOTB_POST.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANTBUILDHERE_YOTB_POST.1"
msgid "The judge needs a clear view of the post."
msgstr "得让裁判看得见台子。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANTBUILDHERE_YOTB_POST.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANTBUILDHERE_YOTB_POST.2"
msgid "A little nearer the judging booth, I think."
msgstr "我看得再靠近评委席些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANT_ESCAPE_CURSE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANT_ESCAPE_CURSE.1"
msgid "I emptied that pocket a moment ago!"
msgstr "这个口袋刚刚明明清空了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANT_ESCAPE_CURSE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CANT_ESCAPE_CURSE.2"
msgid "How did this get back into my things?"
msgstr "它怎么又回到我东西里了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP.1"
msgid "Little one, the race is still on."
msgstr "小家伙，比赛还没结束。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP.2"
msgid "Open your eyes. There's the finish line."
msgstr "睁开眼，终点就在那边。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_STUNNED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_STUNNED.1"
msgid "Take a breath, little one."
msgstr "小家伙，先缓口气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_STUNNED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_STUNNED.2"
msgid "Steady now. Can you find the track?"
msgstr "站稳，找得到跑道吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WALKING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WALKING.1"
msgid "A bit more pace, if you please!"
msgstr "请跑快一点！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WALKING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WALKING.2"
msgid "Save the stroll for after the race!"
msgstr "等比完赛再散步吧！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1.1"
msgid "Turn around!"
msgstr "回头！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1.2"
msgid "The finish is behind you!"
msgstr "终点在你身后！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2.1"
msgid "Follow the track that way!"
msgstr "顺着那边的跑道走！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2.2"
msgid "This way, little runner!"
msgstr "小选手，这边！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_START_RACE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_START_RACE.1"
msgid "Ready? I'll meet you at the finish!"
msgstr "准备好了吗？终点见！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_START_RACE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CARRAT_START_RACE.2"
msgid "Off you go, little one!"
msgstr "小家伙，出发！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CAVEIN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CAVEIN.1"
msgid "Stones are coming loose overhead!"
msgstr "头顶的石头松了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CAVEIN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CAVEIN.2"
msgid "Away from the falling rubble!"
msgstr "躲开落石！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHAIR_ON_FIRE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHAIR_ON_FIRE.1"
msgid "Ow! That left a mark."
msgstr "好烫！都烫红了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHAIR_ON_FIRE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHAIR_ON_FIRE.2"
msgid "I'd better cool that burn."
msgstr "得给烫伤的地方降降温。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE.1"
msgid "I can't see my own hands."
msgstr "连自己的手都看不见了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE.2"
msgid "Where did I put my light?"
msgstr "我把照明的东西放哪儿了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE_ATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE_ATTACK.1"
msgid "Something struck me from the dark!"
msgstr "暗处有东西打了我一下！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE_ATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CHARLIE_ATTACK.2"
msgid "A light, quickly!"
msgstr "快把灯点起来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COLD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COLD.1"
msgid "My fingers are too stiff to tie a knot."
msgstr "手指冻得连结都打不了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COLD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COLD.2"
msgid "I'd like a place by the fire."
msgstr "我想去火边坐坐。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COMPASS_OUT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COMPASS_OUT.1"
msgid "The needle hasn't moved at all."
msgstr "指针一点都没动。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COMPASS_OUT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COMPASS_OUT.2"
msgid "I'll have to find my bearings another way."
msgstr "得换个办法辨别方向。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COZY_SLEEP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COZY_SLEEP.1"
msgid "How long was I asleep? I feel wonderful."
msgstr "我睡了多久？精神好多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COZY_SLEEP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_COZY_SLEEP.2"
msgid "I can face the morning now."
msgstr "现在我有精神起床了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAFTING_FAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAFTING_FAIL.1"
msgid "I'm a few pieces short."
msgstr "还缺几份材料。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAFTING_FAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_CRAFTING_FAIL.2"
msgid "Let me check what I have in my pack."
msgstr "我再翻翻包里有什么。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DAMP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DAMP.1"
msgid "That's water running down my collar."
msgstr "水顺着领口流进来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DAMP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DAMP.2"
msgid "I'll need a dry change of clothes."
msgstr "得找一身干衣服换上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEERCLOPS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEERCLOPS.1"
msgid "Listen. That's getting nearer."
msgstr "听，声音越来越近了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEERCLOPS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DEERCLOPS.2"
msgid "I should warn the others before it gets here."
msgstr "得赶在它到之前提醒大家。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DESPAWN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DESPAWN.1"
msgid "The light's getting brighter..."
msgstr "光越来越亮了……"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DESPAWN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DESPAWN.2"
msgid "Will I see everyone again?"
msgstr "我还能再见到大家吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ATTACK.1"
msgid "Back to the strength in my own arms."
msgstr "接下来靠我自己的力气了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ATTACK.2"
msgid "That last swing felt lighter."
msgstr "刚才那一下力道小了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK.1"
msgid "The last little spark just went out."
msgstr "最后一点电光也消失了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK.2"
msgid "I can touch metal normally again."
msgstr "现在碰金属也没事了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY.1"
msgid "Oh. That drop soaked straight through."
msgstr "啊，这滴水直接渗进去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY.2"
msgid "Better take a raincoat again."
msgstr "得重新带上雨衣。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION.1"
msgid "That bruise hurt. I'd better watch my guard."
msgstr "这下好疼，得小心防守了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION.2"
msgid "I can feel the knocks again."
msgstr "又能感觉到挨打的疼了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE.1"
msgid "There comes the yawn I was waiting for."
msgstr "终于打了个哈欠。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE.2"
msgid "Perhaps someone else can take the watch."
msgstr "也许该换个人守夜了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS.1"
msgid "I keep stopping for breath."
msgstr "做一会儿就得喘口气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS.2"
msgid "Give me another moment."
msgstr "再给我一点时间。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DIG_DISEASE_WARNING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DIG_DISEASE_WARNING.1"
msgid "Those spots weren't there before."
msgstr "这些斑点以前还没有。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DIG_DISEASE_WARNING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DIG_DISEASE_WARNING.2"
msgid "Keep that plant away from the healthy ones."
msgstr "得把这株和健康的植株分开。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING.1"
msgid "Back away from the spike!"
msgstr "离那根尖刺远点！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING.2"
msgid "Did you hear that stone crack?"
msgstr "听见石头开裂的声音了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DUSK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DUSK.1"
msgid "Enough practice. Time to light the fire."
msgstr "今天就练到这里，该生火了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DUSK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_DUSK.2"
msgid "We have a little daylight left to get home."
msgstr "还剩一点天光，够我们回营地。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.GENERIC.1"
msgid "Mm. I'm glad I saved room."
msgstr "嗯，还好我留了点胃口。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.GENERIC.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.GENERIC.2"
msgid "I wouldn't mind another helping."
msgstr "我还想再来一份。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.INVALID.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.INVALID.1"
msgid "I can't get that past my lips."
msgstr "这我实在吃不下去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.INVALID.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.INVALID.2"
msgid "Could we try something else for dinner?"
msgstr "晚饭能换道菜吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.PAINFUL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.PAINFUL.1"
msgid "Ow! What was in that mouthful?"
msgstr "疼！刚才那口里有什么？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.PAINFUL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.PAINFUL.2"
msgid "I'm going to chew more carefully."
msgstr "得仔细嚼才行。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.SPOILED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.SPOILED.1"
msgid "That tasted much better yesterday."
msgstr "昨天吃起来可好多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.SPOILED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.SPOILED.2"
msgid "I should have eaten it sooner."
msgstr "早些吃掉就好了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.STALE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.STALE.1"
msgid "That tasted much better yesterday."
msgstr "昨天吃起来可好多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.STALE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.STALE.2"
msgid "I should have eaten it sooner."
msgstr "早些吃掉就好了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.YUCKY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.YUCKY.1"
msgid "I can't get that past my lips."
msgstr "这我实在吃不下去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.YUCKY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EAT.YUCKY.2"
msgid "Could we try something else for dinner?"
msgstr "晚饭能换道菜吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EATING_NOT_FEASTING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EATING_NOT_FEASTING.1"
msgid "Shall we wait until everyone's seated?"
msgstr "等大家都落座好吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EATING_NOT_FEASTING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EATING_NOT_FEASTING.2"
msgid "It would taste better with company."
msgstr "和大家一起吃会更香。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_BOOSTED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_BOOSTED.1"
msgid "Abigail's had quite a dose already."
msgstr "阿比盖尔已经用了不少药了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_BOOSTED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_BOOSTED.2"
msgid "That's a strong mixture for one little ghost."
msgstr "对一个小幽灵来说，这药真够浓的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_GHOSTVISION.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_GHOSTVISION.1"
msgid "I can make things out even in the dark."
msgstr "就算在暗处也看得清了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_GHOSTVISION.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_GHOSTVISION.2"
msgid "So this is how a ghost sees the world."
msgstr "原来幽灵眼里是这样的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_PLAYER_SPEED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_PLAYER_SPEED.1"
msgid "I can barely hear my own steps!"
msgstr "几乎听不见自己的脚步声了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_PLAYER_SPEED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_PLAYER_SPEED.2"
msgid "My feet feel wonderfully light."
msgstr "脚下真轻快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_TOO_SUPER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_TOO_SUPER.1"
msgid "Abigail's had quite a dose already."
msgstr "阿比盖尔已经用了不少药了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_TOO_SUPER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ELIXIR_TOO_SUPER.2"
msgid "That's a strong mixture for one little ghost."
msgstr "对一个小幽灵来说，这药真够浓的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.1.1"
msgid "One step."
msgstr "再走一步。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.1.2"
msgid "Let me shift my grip."
msgstr "让我换个抓法。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.2.1"
msgid "Heavy..."
msgstr "真沉……"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.2.2"
msgid "Oof, my back."
msgstr "啊，我的腰。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.3.1"
msgid "Keep breathing."
msgstr "呼吸放稳。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.3.2"
msgid "Still got it."
msgstr "还拿得住。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.4.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.4.1"
msgid "I need a moment."
msgstr "让我缓一缓。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.4.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.4.2"
msgid "I'll rest at the bend."
msgstr "到拐角我得歇歇。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.5.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.5.1"
msgid "Steady, knees."
msgstr "膝盖撑住。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.5.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.5.2"
msgid "A little help?"
msgstr "能搭把手吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.6.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.6.1"
msgid "Don't drop it."
msgstr "别掉下去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.6.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.6.2"
msgid "Watch my toes."
msgstr "小心我的脚趾。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.7.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.7.1"
msgid "Nearly there."
msgstr "快到了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.7.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.7.2"
msgid "Make room, please."
msgstr "请让一让。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.8.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.8.1"
msgid "My shoulders ache."
msgstr "肩膀好酸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.8.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.8.2"
msgid "I can manage."
msgstr "我撑得住。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.9.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.9.1"
msgid "Just a bit further."
msgstr "再走一点。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.9.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.9.2"
msgid "No more on top!"
msgstr "别再往上放了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.10.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.10.1"
msgid "Easy now."
msgstr "慢些来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.10.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.10.2"
msgid "I miss my pack."
msgstr "还是背包轻。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.11.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.11.1"
msgid "Which way to camp?"
msgstr "营地往哪边走？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.11.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENCUMBERED.11.2"
msgid "Almost home."
msgstr "快到家了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_DARK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_DARK.1"
msgid "I can't see my own hands."
msgstr "连自己的手都看不见了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_DARK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_DARK.2"
msgid "Where did I put my light?"
msgstr "我把照明的东西放哪儿了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_LIGHT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_LIGHT.1"
msgid "There are my hands again."
msgstr "又能看得见自己的手了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_LIGHT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ENTER_LIGHT.2"
msgid "I'll stay within sight of this light."
msgstr "我会待在光照得到的地方。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EXIT_GELBLOB.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EXIT_GELBLOB.1"
msgid "Ugh, it's even in my hair."
msgstr "头发里都沾上了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EXIT_GELBLOB.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EXIT_GELBLOB.2"
msgid "Let me get the rest of that slime off."
msgstr "让我把剩下的黏液擦掉。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_ARRIVE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_ARRIVE.1"
msgid "Look up! The eye's coming this way!"
msgstr "抬头看！那只眼睛飞过来了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_ARRIVE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_ARRIVE.2"
msgid "I can see the pupil from here."
msgstr "从这里都看得见它的瞳孔。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYAWAY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYAWAY.1"
msgid "It's slipping out of sight."
msgstr "它飞出视线了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYAWAY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYAWAY.2"
msgid "I wonder if it will come back tonight."
msgstr "不知它今晚还会不会回来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYBACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYBACK.1"
msgid "Look up! The eye's coming this way!"
msgstr "抬头看！那只眼睛飞过来了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYBACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_EYEOFTERROR_FLYBACK.2"
msgid "I can see the pupil from here."
msgstr "从这里都看得见它的瞳孔。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FAN_OUT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FAN_OUT.1"
msgid "Oh. No more breeze."
msgstr "咦，风停了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FAN_OUT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FAN_OUT.2"
msgid "I'll have to find some shade instead."
msgstr "得另找一处阴凉了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FERTILIZER_RESEARCHED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FERTILIZER_RESEARCHED.1"
msgid "I'll jot that down before I forget."
msgstr "趁还记得，我先把它记下来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FERTILIZER_RESEARCHED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FERTILIZER_RESEARCHED.2"
msgid "That should help with the garden."
msgstr "照料菜园时能用得上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.1.1"
msgid "It burns where I brushed it!"
msgstr "擦到的地方火辣辣的！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.1.2"
msgid "Cold water, please!"
msgstr "请给我一点凉水！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.2.1"
msgid "My skin's hot to the touch!"
msgstr "皮肤烫得很！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN.2.2"
msgid "I should have worn longer sleeves."
msgstr "早知道就穿长袖了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN_DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN_DONE.1"
msgid "That feels a little more like me."
msgstr "感觉恢复了些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN_DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FIRENETTLE_TOXIN_DONE.2"
msgid "There. I can carry on now."
msgstr "好了，我能接着走了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLARE_SEEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLARE_SEEN.1"
msgid "A flare! Did someone call for us?"
msgstr "信号弹！有人在叫我们吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLARE_SEEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLARE_SEEN.2"
msgid "Look where that light went up."
msgstr "看，光是从那里升起来的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_HELD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_HELD.1"
msgid "Hold tight. I can catch my breath."
msgstr "抓紧了，能喘口气了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_HELD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_HELD.2"
msgid "This keeps my head above water."
msgstr "抓着它，头就能露出水面。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_LETGO.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_LETGO.1"
msgid "I need something to hold on to!"
msgstr "得找个能抓住的东西！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_LETGO.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOATER_LETGO.2"
msgid "My arms won't keep this up much longer."
msgstr "胳膊划不了多久了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOAT_SWIM_TIRED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOAT_SWIM_TIRED.1"
msgid "I need something to hold on to!"
msgstr "得找个能抓住的东西！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOAT_SWIM_TIRED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FLOAT_SWIM_TIRED.2"
msgid "My arms won't keep this up much longer."
msgstr "胳膊划不了多久了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FREEDOM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FREEDOM.1"
msgid "I can move again!"
msgstr "我又能动了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FREEDOM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_FREEDOM.2"
msgid "I'd nearly forgotten how that felt."
msgstr "都快忘记这种感觉了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GATHER_MERM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GATHER_MERM.1"
msgid "Everyone, over here!"
msgstr "大家到这边来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GATHER_MERM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GATHER_MERM.2"
msgid "Stay close, please."
msgstr "请跟紧我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GHOSTDRAIN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GHOSTDRAIN.1"
msgid "Someone's still waiting for a heart."
msgstr "还有人在等一颗心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GHOSTDRAIN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GHOSTDRAIN.2"
msgid "I can't leave a friend like this."
msgstr "不能让朋友一直这样飘着。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GOT_DECON_MISTED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GOT_DECON_MISTED.1"
msgid "Did you have to spray my glasses too?"
msgstr "一定得把我的眼镜也喷湿吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GOT_DECON_MISTED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GOT_DECON_MISTED.2"
msgid "Well, that cleared it off."
msgstr "好，这下洗掉了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE.1"
msgid "I can't see my own hands."
msgstr "连自己的手都看不见了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE.2"
msgid "Where did I put my light?"
msgstr "我把照明的东西放哪儿了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE_ATTACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE_ATTACK.1"
msgid "Something struck me from the dark!"
msgstr "暗处有东西打了我一下！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE_ATTACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_GRUE_NOCHARLIE_ATTACK.2"
msgid "A light, quickly!"
msgstr "快把灯点起来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAIR_TOO_SHORT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAIR_TOO_SHORT.1"
msgid "There's barely enough to tie back."
msgstr "这长度连扎起来都勉强。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAIR_TOO_SHORT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HAIR_TOO_SHORT.2"
msgid "I'll let it grow a little longer."
msgstr "再留长一点吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HASRAIKIRI.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HASRAIKIRI.1"
msgid "That flash passed me right by."
msgstr "那道电光擦身过去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HASRAIKIRI.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HASRAIKIRI.2"
msgid "Still standing. Thank goodness."
msgstr "还能站着，真好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE.1"
msgid "That feels a little more like me."
msgstr "感觉恢复了些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE.2"
msgid "There. I can carry on now."
msgstr "好了，我能接着走了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE.1"
msgid "That feels a little more like me."
msgstr "感觉恢复了些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE.2"
msgid "There. I can carry on now."
msgstr "好了，我能接着走了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE.1"
msgid "There's the shore I was looking for."
msgstr "是我要找的那片海岸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE.2"
msgid "Thank you for the passage."
msgstr "谢谢您送我过来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT.1"
msgid "This isn't a good landing place."
msgstr "这儿不适合落脚。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT.2"
msgid "I'll try the shell somewhere else."
msgstr "换个地方再用贝壳吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HIGHRESEARCH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HIGHRESEARCH.1"
msgid "Oh! I see how the pieces fit now."
msgstr "原来如此，这几处能连起来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HIGHRESEARCH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HIGHRESEARCH.2"
msgid "Let me try that once from memory."
msgstr "让我凭记忆试一次。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOT.1"
msgid "Even my sleeves feel too warm."
msgstr "连袖口都闷得慌。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOT.2"
msgid "I need shade and a sip of water."
msgstr "得找片阴凉，喝口水。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOUNDS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOUNDS.1"
msgid "Listen. That's getting nearer."
msgstr "听，声音越来越近了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOUNDS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HOUNDS.2"
msgid "I should warn the others before it gets here."
msgstr "得赶在它到之前提醒大家。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY.1"
msgid "I can hear my stomach over my footsteps."
msgstr "肚子的声音比脚步声还响。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY.2"
msgid "Practice can wait until after lunch."
msgstr "吃完饭再练吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.1.1"
msgid "My hands remember every step."
msgstr "每道工序我都记得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.1.2"
msgid "I'll finish this before supper."
msgstr "晚饭前就能做好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.2.1"
msgid "See how neatly that fits?"
msgstr "看，接缝多齐整。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.2.2"
msgid "One more while I'm at it."
msgstr "趁现在再做一件。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.3.1"
msgid "Pass the next piece, please."
msgstr "请把下一件递给我。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.3.2"
msgid "That took hardly any time."
msgstr "这次真快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.4.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.4.1"
msgid "Plenty of work left in me."
msgstr "我还有力气接着做。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.4.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_FASTBUILD.4.2"
msgid "I like working at this pace."
msgstr "照这个速度做很顺手。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.1.1"
msgid "I keep stopping for breath."
msgstr "做一会儿就得喘口气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.1.2"
msgid "Give me another moment."
msgstr "再给我一点时间。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.2.1"
msgid "My fingers have slowed down."
msgstr "手指慢下来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.2.2"
msgid "That's as fast as I can go."
msgstr "我只能做到这么快。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.3.1"
msgid "A meal would help with this."
msgstr "先吃点东西会好些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.3.2"
msgid "I'll finish this sitting down."
msgstr "我坐下把它做完吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.4.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.4.1"
msgid "I'm losing count of the pieces."
msgstr "零件都快数错了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.4.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNGRY_SLOWBUILD.4.2"
msgid "I'll have to take my time."
msgstr "这回得慢慢来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_AVOID_FORK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_AVOID_FORK.1"
msgid "These tracks don't quite match."
msgstr "这几枚脚印对不上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_AVOID_FORK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_AVOID_FORK.2"
msgid "Back to where the trail divided."
msgstr "回到足迹分开的地方去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_BEAST_NEARBY.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_BEAST_NEARBY.1"
msgid "Fresh signs. It can't be far."
msgstr "痕迹很新，它就在附近。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_BEAST_NEARBY.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_BEAST_NEARBY.2"
msgid "Quiet now. We're close."
msgstr "轻些，我们离它很近了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL.1"
msgid "Nothing past this point."
msgstr "到了这里就找不到痕迹了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL.2"
msgid "I can't tell where it went from here."
msgstr "看不出它接下来去了哪儿。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL_SPRING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL_SPRING.1"
msgid "Nothing past this point."
msgstr "到了这里就找不到痕迹了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL_SPRING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_LOST_TRAIL_SPRING.2"
msgid "I can't tell where it went from here."
msgstr "看不出它接下来去了哪儿。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_START_FORK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_START_FORK.1"
msgid "Two trails. I'll compare the marks."
msgstr "有两条路，我比一下痕迹。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_START_FORK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_START_FORK.2"
msgid "Which set was made more recently?"
msgstr "哪一行足迹更新些？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_SUCCESSFUL_FORK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_SUCCESSFUL_FORK.1"
msgid "Yes, the tracks line up again."
msgstr "对，脚印又对上了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_SUCCESSFUL_FORK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_SUCCESSFUL_FORK.2"
msgid "We picked the right trail."
msgstr "这次跟对了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_WRONG_FORK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_WRONG_FORK.1"
msgid "These tracks don't quite match."
msgstr "这几枚脚印对不上。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_WRONG_FORK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_HUNT_WRONG_FORK.2"
msgid "Back to where the trail divided."
msgstr "回到足迹分开的地方去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INSUFFICIENTFERTILIZER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INSUFFICIENTFERTILIZER.1"
msgid "That didn't quite feed the soil."
msgstr "这点肥料还不够。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INSUFFICIENTFERTILIZER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INSUFFICIENTFERTILIZER.2"
msgid "I'll bring another handful."
msgstr "我再去拿一把。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INV_FULL.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INV_FULL.1"
msgid "Both hands and every pocket are full."
msgstr "两只手和口袋都满了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INV_FULL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_INV_FULL.2"
msgid "Let me put something down first."
msgstr "让我先放下一件。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ISNIGHTMAREWILD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ISNIGHTMAREWILD.1"
msgid "This blade feels restless in my hand."
msgstr "这把刀握在手里有些不安分。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ISNIGHTMAREWILD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_ISNIGHTMAREWILD.2"
msgid "I ought to sheath it for now."
msgstr "还是先收刀吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IS_FEASTING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IS_FEASTING.1"
msgid "Mm. I'm glad I saved room."
msgstr "嗯，还好我留了点胃口。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IS_FEASTING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_IS_FEASTING.2"
msgid "I wouldn't mind another helping."
msgstr "我还想再来一份。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD.1"
msgid "There's a little nose!"
msgstr "小鼻子露出来了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD.2"
msgid "There you are, kitten."
msgstr "原来你在这里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1.1"
msgid "There's a little nose!"
msgstr "小鼻子露出来了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1.2"
msgid "There you are, kitten."
msgstr "原来你在这里。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2.1"
msgid "Your tail gave you away."
msgstr "尾巴露出来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2.2"
msgid "You nearly fooled me!"
msgstr "差点让你藏过去了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3.1"
msgid "Found you behind there!"
msgstr "找到你了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3.2"
msgid "Another pair of little ears!"
msgstr "又找到一对小耳朵！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4.1"
msgid "I heard that tiny meow."
msgstr "我听见小猫叫了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4.2"
msgid "A whisker! Come on out."
msgstr "看见胡须了！出来吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE.1"
msgid "That's everyone accounted for."
msgstr "这下全都找齐了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE.2"
msgid "There you are! The others are waiting."
msgstr "找到你了！大家在等你呢。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM.1"
msgid "Well spotted, {name}! That's the last kitten."
msgstr "{name}，眼力真好！最后一只也找到了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM.2"
msgid "Thanks to {name}, they're all here."
msgstr "多亏{name}，小猫都到齐了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE.1"
msgid "Just one still hiding."
msgstr "只剩一只还藏着。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE.2"
msgid "One more pair of ears to find."
msgstr "再找到一对小耳朵就齐了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME.1"
msgid "Good hiding places. You beat me."
msgstr "你们藏得真好，我认输。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME.2"
msgid "Come out, kittens. Time's up."
msgstr "小猫们，时间到了，出来吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP.1"
msgid "How much time do we have left?"
msgstr "还剩多少时间？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP.2"
msgid "I'd better check that last corner."
msgstr "得赶快看完最后那个角落。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR.1"
msgid "Back toward the hiding places."
msgstr "得往小猫藏身的地方走。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR.2"
msgid "I should keep the search close to home."
msgstr "得在附近找才行。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN.1"
msgid "Back toward the hiding places."
msgstr "得往小猫藏身的地方走。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN.2"
msgid "I should keep the search close to home."
msgstr "得在附近找才行。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN.1"
msgid "Shall I count while you hide?"
msgstr "你们藏，我来数好吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN.2"
msgid "Ready, little ones?"
msgstr "小家伙们，准备好了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_START.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_START.1"
msgid "Shall I count while you hide?"
msgstr "你们藏，我来数好吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_START.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KITCOON_HIDEANDSEEK_START.2"
msgid "Ready, little ones?"
msgstr "小家伙们，准备好了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_CALLFORHELP.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_CALLFORHELP.1"
msgid "He's calling something over!"
msgstr "他在招呼什么过来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_CALLFORHELP.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_CALLFORHELP.2"
msgid "Listen for the answer to that call."
msgstr "留意有没有回应他的声音。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_ENRAGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_ENRAGE.1"
msgid "Give him room! Look at those chains!"
msgstr "快退开！看他身上的锁链！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_ENRAGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_ENRAGE.2"
msgid "I don't like that change in his stance."
msgstr "他换了个架势，得当心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_UNCHAINED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_UNCHAINED.1"
msgid "Give him room! Look at those chains!"
msgstr "快退开！看他身上的锁链！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_UNCHAINED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KLAUS_UNCHAINED.2"
msgid "I don't like that change in his stance."
msgstr "他换了个架势，得当心。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KNOCKEDOUT.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KNOCKEDOUT.1"
msgid "How long was I down?"
msgstr "我倒下多久了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KNOCKEDOUT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_KNOCKEDOUT.2"
msgid "Give me a moment to find my feet."
msgstr "等我站稳一下。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.1.1"
msgid "There, a little flame."
msgstr "好了，有火了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.1.2"
msgid "Mind your sleeves."
msgstr "小心袖口。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.2.1"
msgid "The kindling caught."
msgstr "引火物点着了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.2.2"
msgid "I'll set the tinder aside."
msgstr "我把火绒收起来。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.3.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.3.1"
msgid "That should keep us warm."
msgstr "这下能取暖了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.3.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.3.2"
msgid "Give the flame some air."
msgstr "让火透点气。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.4.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.4.1"
msgid "Good, a steady light."
msgstr "好，火光稳了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.4.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.4.2"
msgid "That's bright enough."
msgstr "这样够亮了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.5.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.5.1"
msgid "The wood was dry enough."
msgstr "木头够干。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.5.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.5.2"
msgid "Pass me a small stick."
msgstr "递我根细枝吧。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.6.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.6.1"
msgid "I'll keep an eye on it."
msgstr "我看着火。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.6.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTFIRE.6.2"
msgid "There's the first spark."
msgstr "有火星了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED.1"
msgid "That flash passed me right by."
msgstr "那道电光擦身过去了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED.2"
msgid "Still standing. Thank goodness."
msgstr "还能站着，真好。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTSOUT_SHADOWHAND.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTSOUT_SHADOWHAND.1"
msgid "Hands off our fire!"
msgstr "别碰我们的火！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTSOUT_SHADOWHAND.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LIGHTSOUT_SHADOWHAND.2"
msgid "That shadow is reaching for the flames."
msgstr "那个影子在往火上伸。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LNCOMPREHENSIBLE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LNCOMPREHENSIBLE.1"
msgid "I haven't learned that technique yet."
msgstr "这种手法我还没学会。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LNCOMPREHENSIBLE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LNCOMPREHENSIBLE.2"
msgid "Would someone show me the first step?"
msgstr "谁能给我示范第一步？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LOWRESEARCH.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LOWRESEARCH.1"
msgid "There's still a page I don't understand."
msgstr "还有一页没看懂。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LOWRESEARCH.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LOWRESEARCH.2"
msgid "I'll have to study that again."
msgstr "得再学一遍。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARGUARDIAN_INCOMING.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARGUARDIAN_INCOMING.1"
msgid "Something is forcing its way through!"
msgstr "有什么正从里面挤出来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARGUARDIAN_INCOMING.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARGUARDIAN_INCOMING.2"
msgid "We'd better move away from that rift."
msgstr "得离那道裂隙远点。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_CORPSES.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_CORPSES.1"
msgid "Keep an eye on those birds!"
msgstr "留意那些鸟！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_CORPSES.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_CORPSES.2"
msgid "I don't like the look of those wings."
msgstr "那几双翅膀看起来不太对劲。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS.1"
msgid "Did you hear those wings overhead?"
msgstr "听见头顶的振翅声了吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS.2"
msgid "That's an odd call for a bird."
msgstr "这鸟的叫声好奇怪。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNAR_RIFT_MAX.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNAR_RIFT_MAX.1"
msgid "Something is forcing its way through!"
msgstr "有什么正从里面挤出来！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNAR_RIFT_MAX.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_LUNAR_RIFT_MAX.2"
msgid "We'd better move away from that rift."
msgstr "得离那道裂隙远点。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAX_CLOCKWORKS.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAX_CLOCKWORKS.1"
msgid "I think that's enough clockwork for now."
msgstr "我看发条造物已经够多了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAX_CLOCKWORKS.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MAX_CLOCKWORKS.2"
msgid "There's no room for another one."
msgstr "已经装不下一个了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MEGA_FLARE_SEEN.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MEGA_FLARE_SEEN.1"
msgid "A flare! Did someone call for us?"
msgstr "信号弹！有人在叫我们吗？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MEGA_FLARE_SEEN.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MEGA_FLARE_SEEN.2"
msgid "Look where that light went up."
msgstr "看，光是从那里升起来的。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.1.1"
msgid "Something feels wrong under my skin."
msgstr "皮肤底下感觉不对。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.1.2"
msgid "How long will this last?"
msgstr "这要持续多久？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.2.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.2.1"
msgid "I wish I hadn't touched that gland."
msgstr "早知道就不碰那腺体了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.2.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF.2.2"
msgid "I feel ill. Stay close, please."
msgstr "我有点难受，请别走远。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF_DONE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF_DONE.1"
msgid "That feels a little more like me."
msgstr "感觉恢复了些。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF_DONE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MITEGLAND_DEBUFF_DONE.2"
msgid "There. I can carry on now."
msgstr "好了，我能接着走了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_1.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_1.1"
msgid "I emptied that pocket a moment ago!"
msgstr "这个口袋刚刚明明清空了！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_1.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_1.2"
msgid "How did this get back into my things?"
msgstr "它怎么又回到我东西里了？"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGE.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGE.1"
msgid "When did I grow a tail?!"
msgstr "我什么时候长出尾巴了？！"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGE.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGE.2"
msgid "These hands look rather hairy..."
msgstr "手上怎么长了这么多毛……"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGEBACK.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGEBACK.1"
msgid "My own hands again. What a relief."
msgstr "手变回来了，总算放心了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGEBACK.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MONKEY_CURSE_CHANGEBACK.2"
msgid "I won't miss having a tail."
msgstr "我一点也不怀念那条尾巴。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW.1"
msgid "I can see something inside the stone."
msgstr "石头里面好像有东西。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW.2"
msgid "Careful. I don't want to chip what's inside."
msgstr "得轻些，不能敲坏里面的东西。"

