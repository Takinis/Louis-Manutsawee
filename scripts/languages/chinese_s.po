msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET.1"
msgid "Wendy, did you see the petals shift?"
msgstr "温蒂，看见花瓣动了吗？"

