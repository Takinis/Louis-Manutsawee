#. STRINGS.SKIN_QUOTES.manutsawee_uniform_black
msgctxt "STRINGS.SKIN_QUOTES.manutsawee_uniform_black"
msgid "\"It's because the light from Venus is reflected on...the swamp gas...so...\""
msgstr "“这是因为来自金星的光被反射在……沼泽气体上……所以……”"

#. STRINGS.SKIN_QUOTES.manutsawee_yukata
msgctxt "STRINGS.SKIN_QUOTES.manutsawee_yukata"
msgid "\"Shine omae! haha.'\""
