msgstr "那位主持人还在附近，先找他。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Empty. Waste of a look."
msgstr "空的。白看了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "Guess I wait till he's done."
msgstr "还要等他忙完。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "Just these few? That'd be over in a second."
msgstr "就这几只？一下就找完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "There's nowhere here for them to hide."
msgstr "这里根本藏不住几只。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "Already played today. Taking a break."
msgstr "今天已经找过了，歇一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Locked. So where's the key this time?"
msgstr "锁着。钥匙又在哪里？"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "It can't wear this one."
msgstr "这件它穿不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "It's over. Came too late."
msgstr "散场了。来迟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "Only a robot could use something like this."
msgstr "这种东西只有机器人用得了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMERM"
msgid "They don't listen to me."
msgstr "它们不听我的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMYBERNIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMYBERNIE"
msgid "That's Willow's bear."
msgstr "这是薇洛的熊。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
msgid "At least give me a pillow first."
msgstr "至少先给我一个枕头。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.APPLYELIXIR.TOO_SUPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.APPLYELIXIR.TOO_SUPER"
msgid "It's strong enough already. Any more and something's gonna go wrong."
msgstr "已经够强了，再加恐怕会出事。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Not my turn yet."
msgstr "还没轮到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I can't afford that right now."
msgstr "我现在可经不起这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "Already got one in there. Don't waste it."
msgstr "已经放过了，别浪费。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "The water's turned to glass."
msgstr "水面都变成玻璃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "Guess I'm waiting in line."
msgstr "还得排队。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.HASPET"
msgid "One pet's enough of a hassle."
msgstr "养一只就够费事了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.MOUNTED"
msgid "Let me get down first."
msgstr "先下去再做。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.BUILD.TICOON"
msgid "I'm already following a different one."
msgstr "我已经在跟着另一只了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "Just a little late. Again."
msgstr "迟了一点。再来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "Too hot to carve."
msgstr "烫手，没法刻。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "Someone's already carving it."
msgstr "有人在刻了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Put the fire out first. Clothes can wait."
msgstr "先灭火，衣服的事以后再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "This outfit's fine for today."
msgstr "今天这套就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Even changing means waiting."
msgstr "更衣也要等。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "Bring the beefalo over first."
msgstr "先把牛牵过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "What am I supposed to brush with this little hair?"
msgstr "这点毛还能怎么梳？"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Already full. No more charging."
msgstr "已经满了，别再充了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "Out of juice. Have to find another source."
msgstr "没电了，还得另外找。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
