msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOON_YOT"
msgid "Meow.. Meow.. Meow..."
msgstr "喵……喵……喵……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS"
msgid "A lump of coal would be useful, actually."
msgstr "其实一块煤也挺有用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUSSACKKEY"
msgid "Ha! I wouldn't want to get smacked with that thing!"
msgstr "哈！我可不想被那东西打到！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KLAUS_SACK"
msgid "Nothing says open me quite like a lock."
msgstr "没有什么比一把锁更让人想打开了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT"
msgid "It's a pony."
msgstr "是匹小马。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks pretty worn down."
msgstr "它看起来相当破旧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_CARCASS"
msgid "it was killed by other beasts."
msgstr "它被其他野兽杀死了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_SUMMER"
msgid "Chang.. Chang.. Chang..."
msgstr "大象……大象……大象……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFANT_WINTER"
msgid "Chang.. Chang.. Chang..."
msgstr "大象……大象……大象……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOALEFIG_TRUNK"
msgid "Sweet and rubbery."
msgstr "甜甜的，很有嚼劲。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KOSHIRAE"
msgid "Size doesn't matter."
msgstr "大小并不重要。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KRAMPUS"
msgid "Stay back, you big one!"
msgstr "退后一步，你这个大家伙！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KRAMPUS_SACK"
msgid "The holidays came early this year!"
msgstr "今年的节日来得早！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LANTERN"
msgid "A more civilized light."
msgstr "更加文明的光芒。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LATKES"
msgid "Don't skimp on the sour cream."
msgstr "酸奶油别舍不得放。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Nothing's going to get through that!"
msgstr "什么都打不穿那个！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That armor looks pretty safe."
msgstr "这套盔甲看起来很安全。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "This armor isn't very good."
msgstr "这铠甲不太好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "It barely does anything."
msgstr "它几乎没什么用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "This armor will stop a blow or two."
msgstr "这件盔甲能挡下一两击。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Good for striking hard."
msgstr "很适合用力进攻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I could use my skills more often with that."
msgstr "有了那个，我可以更频繁地使用技能。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "I should put that on."
msgstr "我应该穿上那个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "That flag has to come down."
msgstr "那面旗子必须拆掉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BERNIE"
msgid "You're always there for me, Bernie."
msgstr "你永远在我身边，伯尼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_BOARLORD"
msgid "I doubt he can even fight."
msgstr "我怀疑他根本不会打架。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "I'll take that one."
msgstr "我要那一顶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Whoa. How lovely."
msgstr "哇，真可爱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, give me!"
msgstr "哦哦，给我！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "A crown of feathers."
msgstr "羽毛做的王冠。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Everyone, stand back."
msgstr "大家退后。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "That's a lovely wreath."
msgstr "真是漂亮的花环。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "It makes you feel a little better when you wear it."
msgstr "当你佩戴它时，它会让你感觉好一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "I can't use that."
msgstr "我用不了那个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "There's no key in it."
msgstr "里面没有钥匙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Looks good."
msgstr "看起来不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Very pointy."
msgstr "很尖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_LUCY"
msgid "That's Woodie's axe."
msgstr "那是伍迪的斧头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "This is much nicer than our gate back home."
msgstr "这比我们家那扇门好多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Time to go."
msgstr "是时候该走了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "I'd like that one."
msgstr "我想要那个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Hey! come out of it."
msgstr "嘿！快出来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'd wear it if I felt like fighting."
msgstr "想打架的时候我会戴上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "It comes with a matching staff."
msgstr "还配了一根相称的法杖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE"
msgid "Why can't we be friends?"
msgstr "为什么我们不能成为朋友？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_COCOON"
msgid "Poor thing. It lost its spark."
msgstr "可怜的东西。它的火花没了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "There's a faint warmth coming from inside."
msgstr "一股淡淡的暖意从里面传来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "It has a chill."
msgstr "它有点着凉了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "That egg looks happy."
msgstr "那个蛋看起来很高兴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.CONTENT"
msgid "My own little fire companion."
msgstr "我自己的小火伙伴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.GENERIC"
msgid "She's... perfect."
msgstr "她是……完美的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "I think she wants something to eat."
msgstr "我想她想吃点东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_PET.STARVING"
msgid "I can see her ribs."
msgstr "我都看得到她的肋骨了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVAE_TOOTH"
msgid "I hope she's not a biter."
msgstr "希望她不咬人。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT.COOL"
msgid "Cool drool, literally."
msgstr "真的是凉掉的口水。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVASPIT.HOT"
msgid "Hot drool, literally."
msgstr "真的是热腾腾的口水。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVA_POND"
msgid "That's quite a view."
msgstr "这景色真壮观。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LAVA_POND_ROCK"
msgid "Another rock. How surprising."
msgstr "又一块石头。真令人惊讶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFLOAF"
msgid "Is it supposed to be green?"
msgstr "它本来就是绿色的吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFYMEATBURGER"
msgid "Does this burger taste a little odd to anyone else?"
msgstr "还有别人觉得这个汉堡味道有点怪吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Who combines dessert with vegetables? Brave, if nothing else."
msgstr "谁会把甜点和蔬菜放在一起？至少很有勇气。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF"
msgid "Where did that come from?!"
msgstr "那是从哪里来的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF_IDOL"
msgid "A tree guardian, carved in wood. I hope he's not offended."
msgstr "木头雕成的树木守卫。希望他不要介意。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEIF_SPARSE"
msgid "Where did that come from?!"
msgstr "那是从哪里来的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LICHEN"
msgid "A crusty little plant."
msgstr "一种硬邦邦的小植物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIFEINJECTOR"
msgid "Please don't stick that in me."
msgstr "请别把那个扎到我身上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTBULB"
msgid "It's called a \"lightbulb\" but it's rather heavy."
msgstr "它叫“灯泡”，可是还挺重的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTCRAB"
msgid "It glows like a little lantern."
msgstr "它像小灯笼一样发光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTER"
msgid "Playing with fire will make you wet the bed."
msgstr "玩火会让你尿床。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTFLIER"
msgid "Pleasant company on a dark path."
msgstr "走夜路时的好同伴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "You're quite energetic."
msgstr "您真有活力。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "A bouncy goat."
msgstr "一只蹦蹦跳跳的山羊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNINGGOATHORN"
msgid "I heard lightning when I held it to my ear."
msgstr "当我把它放在耳边时，我听到了闪电。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "It looks all glowy!"
msgstr "它整个都在发光！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "All the lightning goes here, I hope."
msgstr "希望所有的闪电都会落到这里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LITTLE_WALRUS"
msgid "He looks well fed."
msgstr "他看起来吃得不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGLOG"
msgid "It looks upset."
msgstr "看上去很不高兴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE"
msgid "It might be alive."
msgstr "它可能还活着。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE_ROOT"
msgid "I should plant this somewhere."
msgstr "我应该把它种在某个地方。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It's a monster kid. Like me!"
