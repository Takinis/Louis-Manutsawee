msgstr "可以摘了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Please make more."
msgstr "请再多结一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It's drying up."
msgstr "它快要干枯了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYSAUCE"
msgid "This is the best part."
msgstr "这才是最棒的部分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIBINGKA"
