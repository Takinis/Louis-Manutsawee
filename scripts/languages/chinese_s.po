msgstr "找到你了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
