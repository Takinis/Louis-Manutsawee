msgstr "总比到了风浪里再处理容易。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD.1"
msgid "I'll check the dragonfly light kit before we leave the shore."
msgstr "离岸前我要检查龙蝇灯套装。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD.2"
msgid "I won't go far from the dock until it's ready."
msgstr "准备妥当前，我不会离码头太远。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_YOTD.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.MASTUPGRADE_LAMP_YOTD.1"
