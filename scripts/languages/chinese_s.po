msgstr "冷静点，%s！冷静，大个子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Don't hurt yourself, big guy."
msgstr "别伤到自己，大个子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.GENERIC"
msgid "Hello, %s."
msgstr "您好，%s。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.WOLFGANG.GHOST"
