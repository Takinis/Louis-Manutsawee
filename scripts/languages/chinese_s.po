msgstr "在这样的高温下，什么都不会生长。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.BARREN"
