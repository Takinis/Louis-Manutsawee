msgstr "那一棵在地里待太久了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
