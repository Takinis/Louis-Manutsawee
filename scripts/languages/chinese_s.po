msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WALL_WOOD.BURNT.1"
msgid "I won't get any more use out of the wood wall."
msgstr "木墙烧成这样，用不了了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WALL_WOOD.BURNT.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WALL_WOOD.BURNT.2"
msgid "That smell stays on my sleeves."
msgstr "袖口都沾了焦味。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WALL_WOOD.GENERIC.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WALL_WOOD.GENERIC.1"
