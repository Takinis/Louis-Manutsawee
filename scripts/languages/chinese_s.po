msgstr "你闻起来不太健康。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
