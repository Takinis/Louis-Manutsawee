msgstr "啊！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLACKFLAG"
msgid "Looks like it's already charred."
msgstr "看起来已经烧焦了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_FIRE"
msgid "My, that's a clever little thing."
msgstr "哎呀，真是个聪明的小东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA"
msgid "Ptoo! Take that."
msgstr "呸！尝尝这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_LAVA2"
msgid "My, what firepower."
msgstr "哎呀，好强的火力。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_PIPE"
