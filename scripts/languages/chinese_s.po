#. STRINGS.SKIN_QUOTES.manutsawee_qipao
msgctxt "STRINGS.SKIN_QUOTES.manutsawee_qipao"
msgid "\"Ni hao ..? Happy Lunar New Year!'\""
msgstr "“你好……？新年快乐！”"

#. STRINGS.SKIN_QUOTES.manutsawee_sailor
