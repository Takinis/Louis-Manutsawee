msgstr "现在还拔不出来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "I'll leave that modification to Winona."
msgstr "改装的事情还是交给薇诺娜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.HEAL.NOT_MERM"
msgid "That medicine is meant for merms."
msgstr "这种药是给鱼人用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Nothing left inside."
msgstr "里面什么都没有了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.ACTIONFAIL.PICK.STUCK"
