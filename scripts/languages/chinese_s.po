msgstr "我喜欢可以从远处射击的武器。最好是在跑步时。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_SLEEP"
msgid "Just don't breathe in."
msgstr "只是不要吸气。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLOWDART_YELLOW"
msgid "It's a shock to the system."
msgstr "这对系统来说是一个冲击。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEAMULET"
msgid "I'm not a fan of this."
msgstr "我不太喜欢这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEGEM"
msgid "This one is a bit ugly."
msgstr "这颗有点难看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEMOONEYE"
msgid "That's not an eyeball. It's a rock."
msgstr "那不是眼球，是石头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.COMMON"
msgid "This will save some experimentation."
msgstr "这将节省一些实验。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUEPRINT.RARE"
msgid "Whoa. It doesn't burn."
msgstr "哇，它烧不起来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP"
msgid "It smells like a gym sock."
msgstr "闻起来像运动袜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_CAP_COOKED"
msgid "Transformed by fire."
msgstr "被火改变了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Just a mushroom."
msgstr "只是一朵蘑菇。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hello? Come up here, please."
msgstr "您好？请上来吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也许有一天它会回来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARDS"
msgid "Boards. Good and sturdy."
msgstr "木板。又好又结实。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARON"
msgid "Keep that snout to yourself."
msgstr "把你的猪鼻子拿开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOARRIOR"
msgid "He looks pretty haggard."
msgstr "他看起来很憔悴。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT03"
msgid "Well, there goes that."
msgstr "嗯，这下没了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT04"
msgid "Well, there goes that."
msgstr "嗯，这下没了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATFRAGMENT05"
msgid "Well, there goes that."
msgstr "嗯，这下没了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATPATCH"
msgid "Repairs are routine, but necessary."
msgstr "修补是例行工作，但很有必要。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "My brain is going into overload."
msgstr "我的大脑即将超负荷。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Strategic."
msgstr "战略。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Tryin' to throw a monkeywrench in my race"
msgstr "想在我的比赛里捣乱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK"
msgid "It's trying to wreak havoc on my game"
msgstr "它想毁了我的比赛。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Watch out for that buoy!"
msgstr "小心那个浮标！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "给我下水吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Into the water with ya!"
msgstr "给我下水吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Clap! Clap if you believe in me!"
msgstr "鼓掌！相信我的话就鼓掌！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START"
msgid "Here we go?"
msgstr "开始了？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "No, I don't want to play."
msgstr "不，我不想玩。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It's slimy."
msgstr "黏糊糊的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Building bumpers beats sinking, I suppose."
msgstr "我想，造保险杠总比沉船好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Nothing sturdier than seashells, clearly."
msgstr "显然没什么比贝壳更结实了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Building bumpers beats sinking, I suppose."
msgstr "我想，造保险杠总比沉船好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Those teeth are just decoration."
msgstr "那些牙齿只是装饰品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Let's paddle together~"
msgstr "一起来划桨吧~"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "The only fun part of sailing is firing the cannon."
msgstr "航海唯一有趣的部分就是开炮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It isn't loaded. How dull."
msgstr "没有装弹。真无聊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I'm out of ammunition... Wes, you always wanted to be a human cannonball, didn't you?"
msgstr "我没弹药了……韦斯，你一直想当人肉炮弹，对吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_CANNON_KIT"
msgid "If I build it, I get to fire it."
msgstr "既然是我造的，就该由我来开炮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_GRASS_ITEM"
msgid "It won't burn well if I put it in the water, but it will float."
msgstr "放进水里烧不太起来，但能浮着。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ITEM"
msgid "That's the boat part of the boat."
msgstr "这是船的船身部分。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_LEAK"
msgid "I should patch that up before we sink."
msgstr "我应该在我们沉没之前把它修好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "All right, it works fine. I was wrong to doubt it."
msgstr "好吧，运行正常。是我不该怀疑它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "A large magnet. Functional enough."
msgstr "一块大磁铁。够用了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I suppose that means it's working."
msgstr "我想这说明它在运作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This will attract any strong magnets nearby."
msgstr "这将吸引附近的强磁铁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Wilson, how am I supposed to put all this together?"
msgstr "威尔逊，这些东西我要怎么组装起来？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_MSURFBOARD"
msgid "Ride the waves!"
msgstr "乘风破浪！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR"
msgid "Let's see how fast we can spin without getting sick."
msgstr "来看看我们能转多快还不晕吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Alright, I'll install the rudder properly."
msgstr "好吧，我会好好把舵装上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "Bernie is much cuddlier than a hairy old pillow."
msgstr "伯尼比毛茸茸的旧枕头好抱多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_KELP"
msgid "This pillow is full of wet seaweed."
msgstr "这个枕头里全是湿海藻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_PETALS"
msgid "I guess that's one use for flowers."
msgstr "我想这就是花的用途之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "I'm fairly sure this is the worst pillow ever made."
msgstr "我敢肯定这是史上最糟糕的枕头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT"
msgid "Heh. Think fast."
msgstr "呵。接着。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood must have been tinkering with this one."
msgstr "这一定是沃姆伍德鼓捣出来的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESHARD"
msgid "I don't think these are good for much."
msgstr "我想这些没什么大用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESOUP"
msgid "I could happily finish a bowl of that."
msgstr "这个我能开心地喝完一碗。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BONESTEW"
msgid "Smells like Sunday supper."
msgstr "闻起来像周日的晚餐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.BURNT"
msgid "Knowledge can't be treated like this"
msgstr "知识不能这样对待"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Hey, who can remember what I learned in high school?"
msgstr "嘿，谁还记得我高中学过的东西？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BEES"
msgid "A book about bees. I'll read it carefully."
msgstr "一本关于蜜蜂的书。我会仔细读的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BIRDS"
msgid "Study first, action second."
msgstr "先学习，后行动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_BRIMSTONE"
msgid "That one looks dangerous. I'll be careful with it."
msgstr "这本看起来很危险。我会小心的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_ELEMENTAL"
msgid "Looks interesting."
msgstr "看起来很有意思。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FIRE"
msgid "I don't need books to teach me this!"
msgstr "我不需要书本来教我这个！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FISH"
msgid "It's as interesting as fishing."
msgstr "就像钓鱼一样有趣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_FOSSIL"
msgid "A book about fossils. Heavy reading, literally."
msgstr "一本关于化石的书。读起来真的很沉重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_GARDENING"
msgid "Basic cultivation knowledge. Useful."
msgstr "基础的栽培知识，很有用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE"
msgid "Horticulture notes. Worth learning."
msgstr "园艺笔记，值得学习。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "The knowledge within shall grant us bountiful harvests."
msgstr "里面的知识将会给我们带来丰富的收获。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT"
msgid "Sounds pretty mysterious!"
msgstr "听起来很神秘！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Let's keep this one close at hand, shall we?"
msgstr "让我们把这个放在手边，好吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_MOON"
msgid "I'm looking up at the moon~"
msgstr "我抬头看月亮~"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RAIN"
msgid "A book about rain. Not my favorite subject."
msgstr "一本关于雨的书。不是我喜欢的主题。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "More knowledge!"
msgstr "更多知识！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SILVICULTURE"
msgid "A book about growing trees. Patient work."
msgstr "一本关于种树的书。是需要耐心的工作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_SLEEP"
msgid "Rather dull. I may nod off."
msgstr "相当枯燥。我可能会打瞌睡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TEMPERATURE"
msgid "...Sorry, I nodded off."
msgstr "……抱歉，我打瞌睡了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_TENTACLES"
msgid "A book about tentacles. I'll read it with the lights on."
msgstr "一本关于触手的书。我会开着灯读的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOK_WEB"
msgid "Who would want to read a book about spiders?"
msgstr "谁会想读关于蜘蛛的书？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOMERANG"
msgid "It's not the most exciting weapon."
msgstr "这不是最令人兴奋的武器。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BOOTLEG"
msgid "Monkey pirates don't know how to wear shoes."
msgstr "猴子海盗不懂怎么穿鞋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Well, it's broken."
msgstr "嗯，它坏了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BRUSH"
msgid "It smells faintly like a beefalo."
msgstr "隐约有股皮弗娄牛的味道。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUGNET"
msgid "I don't think it would fit over Webber's head."
msgstr "我想这套不到韦伯头上吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "I bet we could eat that."
msgstr "我打赌我们可以吃那个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nothing left to take."
msgstr "没有什么可以拿走的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BULLKELP_ROOT"
msgid "Ha. This is handy."
msgstr "哈。这个真方便。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLE"
msgid "That oughta keep everything nice and fresh."
msgstr "这样应该能让东西都保持新鲜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNDLEWRAP"
msgid "Useful for wrapping things up neatly."
msgstr "用来把东西包得整整齐齐。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYMAN"
msgid "Unusual appearance, but I'll stay respectful."
msgstr "外表不太寻常，但我会保持尊重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUNNYSTEW"
msgid "It warms from the inside out."
msgstr "从里到外都暖和起来了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BURNT_MARSH_BUSH"
msgid "All burned up."
msgstr "全部烧毁了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUSHHAT"
msgid "A hat to hide in. A little passive, but sensible."
msgstr "可以躲起来的帽子。有点消极，不过很明智。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTER"
msgid "Tasty, and just a little bit insecty."
msgstr "好吃，就是有点虫子味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter along, butterfly."
msgstr "飞吧，蝴蝶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLY.HELD"
msgid "I'll let it go in a moment."
msgstr "我马上就放了它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYMUFFIN"
msgid "A butterfly in a muffin. Rather elegant, really."
msgstr "麦芬里有只蝴蝶。其实挺优雅的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUTTERFLYWINGS"
msgid "Poor butterfly. No more flying for it."
msgstr "可怜的蝴蝶。再也飞不了了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BUZZARD"
msgid "That is an unfortunate neck."
msgstr "那脖子长得真不幸。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CABBAGEROLLS"
msgid "Cabbage rolls. I can certainly roll with these."
msgstr "卷心菜卷。这个我可以接受。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.GENERIC"
msgid "Spines. How did you know my weakness?"
msgstr "尖刺。您怎么知道我的弱点？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS.PICKED"
msgid "We'll call it a tie."
msgstr "就算打平吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_FLOWER"
msgid "Yet another flower."
msgstr "又一朵花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT"
msgid "It still looks dangerous."
msgstr "看起来还是很危险。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "It seems fine now."
msgstr "现在看来还好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CALIFORNIAROLL"
msgid "Fish rolled in seaweed. One of my favorites."
msgstr "海苔卷着鱼。我最喜欢的之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "那场火需要更多的燃料，否则就会熄灭。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "总比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "这场大火已经失控了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "火势有点小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAMPFIRE.OUT"
msgid "Well, that's over."
msgstr "好了，就这样结束了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.GENERIC"
msgid "If it stops singing, I'll leave quickly."
msgstr "如果它不唱了，我就赶紧离开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY.HELD"
msgid "Still breathing? Just checking."
msgstr "还有气吗？我只是确认一下。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANARY_POISONED"
msgid "Uh, are you feeling okay?"
msgstr "呃，你感觉还好吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CANDYBAG"
