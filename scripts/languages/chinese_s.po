msgid "It looks like fruit for grandparents."
msgstr "看起来是老人家爱吃的水果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGATONI"
msgid "I won't turn down a plate of pasta."
msgstr "我不会拒绝一盘意大利面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIGKABAB"
msgid "Food on a stick. Practical."
msgstr "串在棍子上的食物。很实用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIG_COOKED"
msgid "Cooking improved it, as usual."
msgstr "和往常一样，煮过以后更好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "它从上方呼唤一颗流星。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRECRACKERS"
msgid "Don't worry Ms. Wicker, we'll be careful."
msgstr "别担心，威克女士，我们会小心的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish they wouldn't keep running away."
msgstr "真希望它们别老是跑开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREFLIES.HELD"
msgid "They make my pocket glow!"
msgstr "它们让我的口袋闪闪发光！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREHOUND"
msgid "I rather like that one."
msgstr "我还挺喜欢那只的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRENETTLES"
msgid "It's a weed? It looks rather nice to me."
msgstr "这是杂草？我觉得挺好看的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPEN"
msgid "I feel inspired to write."
msgstr "我有灵感想写点东西了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "我应该在火熄灭之前放点东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "总比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "幸好火被围住了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "火势有点小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "至少我可以重新开始。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESTAFF"
msgid "Powerful, and best handled with care."
msgstr "威力强大，最好小心使用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Running low on fuel."
msgstr "燃油不足。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "It's off."
msgstr "关了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "This would come in handy in a snowball fight."
msgstr "这在打雪仗时会派上用场。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH"
msgid "A slippery fish."
msgstr "一条滑溜溜的鱼。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGNET"
msgid "Throwing things to catch other things. Clever."
msgstr "扔东西来抓别的东西。真聪明。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHINGROD"
msgid "Fishing for the answer with a hook, line and sinker."
msgstr "用鱼钩、鱼线和铅坠钓答案。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT"
msgid "Once a fish, now food."
msgstr "曾经是鱼，现在是食物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_COOKED"
msgid "Grilled to perfection."
msgstr "烤至完美。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL"
msgid "Not much more than a quick fishy snack."
msgstr "也就够当一份鱼味小点心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Fish and a bit of heat go well together."
msgstr "鱼和一点火候很配。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHSTICKS"
msgid "What you see is what you get. Sticks of fish."
msgstr "所见即所得。鱼条。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISHTACOS"
msgid "Convenient taco-grip."
msgstr "方便手握的塔可。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_BOX"
msgid "Did we just... put a hole in the boat?"
msgstr "我们刚刚……在船上打了一个洞吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FISH_COOKED"
msgid "Flaky and moist. Delicious."
msgstr "酥软多汁。真好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLINT"
msgid "Aha, I've found some flint!"
msgstr "啊哈，我找到了一些打火石！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.GENERIC"
msgid "A flower. Pretty, in its way."
msgstr "一朵花。有它自己的美。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER.ROSE"
msgid "Bright red petals!"
msgstr "鲜红的花瓣！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERHAT"
msgid "A halo of flowers. Simple and tidy."
msgstr "花做的光环，简单又整洁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWERSALAD"
msgid "I'd rather have something more filling."
msgstr "我更想吃点能填饱肚子的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_CAVE"
msgid "It glows from within."
msgstr "它从里面发着光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_EVIL"
msgid "That smells terrible."
msgstr "闻起来真可怕。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FLOWER_WITHERED"
msgid "It's withered."
msgstr "它枯萎了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOLIAGE"
msgid "Soft and leafy."
msgstr "柔软而多叶。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "体育运动很难。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORGETMELOTS"
msgid "More flowers. Nice color balance."
msgstr "更多的花。色彩搭配不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It looks very stuffy and proper."
msgstr "看起来非常拘谨又正式。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_PIECE"
msgid "Old bits of bone."
msgstr "古老的骨头碎片。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Looks passable."
msgstr "看起来还过得去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That looks absolutely ridiculous."
msgstr "这看起来太荒唐了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "It needs more old bits."
msgstr "还需要更多古老的碎片。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRESHFRUITCREPES"
msgid "Ooo la la."
msgstr "噢啦啦。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This one is actually helping."
msgstr "这只真的在帮忙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.DEAD"
msgid "A hop too far."
msgstr "跳过头了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.GENERIC"
msgid "Ob.. Ob..."
msgstr "欧..欧.."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROG.SLEEPING"
msgid "Oblivious amphibious."
msgstr "两栖动物睡得毫无察觉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGFISHBOWL"
msgid "That's a lot of frogs."
msgstr "真是好多青蛙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGGLEBUNWICH"
msgid "If you close your eyes it's a little easier to get it down."
msgstr "闭上眼睛的话，比较容易吞下去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS"
msgid "It still twitches now and then. Unsettling."
msgstr "它偶尔还会抽动一下。让人不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGLEGS_COOKED"
msgid "Tastes like chicken."
msgstr "味道像鸡肉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROGNEWTON"
msgid "All that fig almost masks the frog flavor."
msgstr "所有的无花果几乎掩盖了青蛙的味道。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "It's very cold."
msgstr "真的很冰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They're pretty cute."
msgstr "它们非常可爱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.RIPE"
msgid "Mmm. Dragonfruit."
msgstr "嗯。火龙果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Good night, little guy."
msgstr "晚安，小家伙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLY"
msgid "Please stay out of the crops."
msgstr "请离庄稼远一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITFLYFRUIT"
msgid "Now I'm the the one giving the orders! To Fruit Flies, but still."
msgstr "现在换我发号施令了！虽然只是对果蝇。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRUITMEDLEY"
msgid "Lovely fruit."
msgstr "很棒的水果。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FURTUFT"
msgid "Black and white and fuzzy all over!"
msgstr "黑白相间，毛茸茸的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING"
msgid "It's very creepy."
msgstr "真让人毛骨悚然。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "They sure go out with a bang."
msgstr "它们走得真是轰轰烈烈。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_HOUND"
msgid "A large stone ornament."
msgstr "一件很大的石头摆设。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARGOYLE_WEREPIG"
msgid "At least it doesn't smell anymore."
msgstr "至少现在没有味道了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC"
msgid "It's just a couple cloves of garlic."
msgstr "只是几瓣大蒜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_COOKED"
msgid "Cooking made it better."
msgstr "煮过以后好多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_OVERSIZED"
msgid "My breath would be unforgettable if I ate the whole thing."
msgstr "要是把这一整颗吃完，我的口气一定令人难忘。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GARLIC_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "只是一堆种子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GAZPACHO"
msgid "I prefer my soup warm."
msgstr "我更喜欢喝热汤。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEARS"
msgid "These must make them move."
msgstr "一定是这些让它们动起来的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.GEMS"
msgid "It's so empty."
msgstr "空荡荡的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GEMSOCKET.VALID"
msgid "I wonder how they hover?"
msgstr "我想知道它们是如何悬停的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT"
msgid "It feels like they're speaking inside my head!"
msgstr "感觉就像他们在我脑子里说话！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GESTALT_GUARD"
msgid "They sure hate those shadow creeps."
msgstr "他们确实讨厌那些暗影怪物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST"
msgid "Resentment wakes it up. \n You can't kill what's already dead."
msgstr "怨恨将其唤醒。 \n 你无法杀死已经死去的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTFLOWER"
msgid "Another spooky flower."
msgstr "又一朵阴森的花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "I not trust tiny bottles made by creepy girl."
msgstr "我才不信那个吓人女孩做的小瓶子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST_KILL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GHOST_KILL"
msgid "Die again and you're free"
msgstr "再死一次你就自由了"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIFT"
msgid "Is it for me?"
msgstr "是给我的吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GIFTWRAP"
msgid "I want to give someone something nice!"
msgstr "我想给别人一些好东西！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADHOUSE"
msgid "Let's eat it!"
msgstr "我们来吃吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADPIG"
msgid "Please come back here!"
msgstr "请回来！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GINGERBREADWARG"
msgid "Desserts should not be eating people."
msgstr "甜点不该吃人。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSBLOCK"
msgid "It's a big hunk of glass."
msgstr "这是一块大玻璃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSCUTTER"
msgid "This could take an arm off. I'll be careful."
msgstr "这东西能切断手臂。我会小心的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLASSSPIKE"
msgid "That's a hazardous decoration."
msgstr "这是一种危险的装饰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMER.GENERIC"
msgid "It's fuzzy. And slimy."
msgstr "毛茸茸的，还黏糊糊的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMER.SLEEPING"
msgid "All right, it's rather cute."
msgstr "好吧，还挺可爱的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "It smells worse now."
msgstr "现在味道更臭了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "It doesn't smell very nice."
msgstr "闻起来不太好闻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERFUEL"
msgid "It's goopy and weird."
msgstr "它又粘又奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOMMERWINGS"
msgid "They're so small!"
msgstr "它们太小了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GLOWBERRYMOUSSE"
msgid "That's going straight into my mouth."
msgstr "这个要直接送进我嘴里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Not so fierce without your horn."
msgstr "没了角就没那么凶了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "You look off-balance without your horn."
msgstr "没了角，你看起来有点站不稳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "There we go. You're on my side now."
msgstr "这就对了。现在你站在我这边了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL.GENERIC"
msgid "Look at the nose on that one."
msgstr "看看那家伙的鼻子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GNARWAIL_HORN"
msgid "Rather elegant."
msgstr "相当优雅。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOATMILK"
msgid "It's fuzzy with electricity. Strange."
msgstr "带着电，麻麻的。真奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOGGLESHAT"
msgid "What a look."
msgstr "这造型真不得了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENAXE"
msgid "Life is okay when you've got a golden axe."
msgstr "当你有一把金斧头时，生活就美好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENPICKAXE"
msgid "The finest pickaxe of them all."
msgstr "最好的镐子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENPITCHFORK"
msgid "We can do some fancy forking with this."
msgstr "可以用它耍点花样了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDENSHOVEL"
msgid "We're going to dig so many holes."
msgstr "我们要挖好多好多洞了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDEN_FARM_HOE"
msgid "Fancy garden hoe good for planting seeds!"
msgstr "很讲究的锄头，适合播种！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOLDNUGGET"
msgid "What should we spend it on?"
msgstr "我们要拿它买什么呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GOOSE_FEATHER"
msgid "So soft."
msgstr "好软。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.BARREN"
msgid "It needs fertilizer."
msgstr "它需要肥料。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.BURNING"
msgid "It's on fire!"
msgstr "着火了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.DISEASED"
msgid "Disease detected. Remove and contain."
msgstr "发现病害，清除并隔离。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.DISEASING"
msgid "You smell unwell."
msgstr "你闻起来不太健康。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.GENERIC"
msgid "It's a grass."
msgstr "这是草。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.PICKED"
msgid "Grass stubble is kind of useless."
msgstr "草茬有点没用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS.WITHERED"
msgid "Nice, dry."
msgstr "不错，干燥。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGATOR"
msgid "E'Hia..., Ha.. Ha.. Ha..."
msgstr "艾希亚……，哈……哈……哈……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "That's doubly unpleasant."
msgstr "真是双重的不舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Kapom?"
msgstr "卡波姆？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRASS_UMBRELLA"
msgid "Pretty as can be."
msgstr "要多漂亮有多漂亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GRAVY"
msgid "More gravy, please."
msgstr "请再来点肉汁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENAMULET"
msgid "I feel my mind opening when I wear it."
msgstr "戴上它，我感觉思路都打开了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENGEM"
msgid "This one feels really light."
msgstr "这个感觉真的很轻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENMOONEYE"
msgid "A large green stone."
msgstr "一块很大的绿色石头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREENSTAFF"
msgid "This will come in handy."
msgstr "这会派上用场的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_CAP"
msgid "Plain, but useful."
msgstr "很普通，但有用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_CAP_COOKED"
msgid "Cooking transformed it."
msgstr "煮过以后变样了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Green mushroom specimen."
msgstr "绿蘑菇样本。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Hello? Come up here, please."
msgstr "您好？请上来吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也许有一天它会回来。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GROTTO_POOL_BIG"
msgid "This whole place is damp. I'm not fond of it."
msgstr "这整个地方都潮湿，我不太喜欢。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GROTTO_POOL_SMALL"
msgid "This whole place is damp. I'm not fond of it."
msgstr "这整个地方都潮湿，我不太喜欢。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUACAMOLE"
msgid "Goodness, that's tasty."
msgstr "天哪，真好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUANO"
msgid "Unpleasant, but useful."
msgstr "不太舒服，但有用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.GUNPOWDER"
msgid "It looks like pepper."
msgstr "看起来像胡椒。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_1"
msgid "Oh, Wendy! I'll trade you for your choco pigs!"
msgstr "哦，温蒂！我想跟你换巧克力猪！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_10"
msgid "Candy candy candy!"
msgstr "糖糖糖糖！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_11"
msgid "Mmm! Sweet revenge!"
msgstr "嗯！甜蜜的复仇！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_12"
msgid "Wriggly, yet satisfying."
msgstr "扭来扭去的，但吃着很满足。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_13"
msgid "I like these a lot."
msgstr "我非常喜欢这些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_14"
msgid "Gosh, it's spicy."
msgstr "天哪，太辣了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_2"
msgid "Haha ew! It's weird!"
msgstr "哈哈，呃！好奇怪！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_3"
msgid "Haha, that's not candy!"
msgstr "哈哈，这不是糖果！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_4"
msgid "We aren't totally comfortable with this."
msgstr "我们不太能接受这个。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_5"
msgid "I forgot what good things tasted like!"
msgstr "我都忘了好东西是什么味道了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_6"
msgid "No worse than the other stuff we've eaten out here!"
msgstr "不比我们在这里吃过的其他东西差！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_7"
msgid "Oh, Ms. Wicker! I saved these for you!"
msgstr "哦，威克女士！这些是我为您留的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_8"
msgid "Candy candy candy!"
msgstr "糖糖糖糖！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENCANDY_9"
msgid "Gummy worms, yummy worms!"
msgstr "软糖虫，好吃的虫！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Makes us feel big and strong!"
msgstr "让我们觉得自己又高大又强壮！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "It's pretty powerful."
msgstr "药效相当强。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "It's only a little powerful."
msgstr "药效只有一点点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Neat! It's like firecrackers."
msgstr "真不错！就像鞭炮一样。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Should I drink it? Probably not."
msgstr "我该喝吗？大概不该。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Oooh. Spooky. I should decorate!"
msgstr "哦，阴森森的。我该拿来装饰！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Gosh. That almost looks real."
msgstr "天哪。这看起来几乎是真的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "Aw. It's not real. Let's hang it somewhere."
msgstr "噢。这不是真的。我们把它挂在某个地方吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Let's hang it somewhere for Halloween!"
msgstr "让我们把它挂在某个地方庆祝万圣节吧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "I should put this guy in a tree!"
msgstr "我应该把这个家伙放在树上！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "If I put it in a tree it'd look almost real."
msgstr "如果我把它放在树上，它看起来几乎是真的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMBAT"
msgid "This seems unsanitary."
msgstr "这看起来不卫生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMMER"
msgid "Stop! It's time! To hammer things!"
msgstr "停！是时候！敲东西了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAMMER_MJOLNIR"
msgid "That weapon looks plain, but solid."
msgstr "这把武器看起来朴素，但很结实。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "Bernie is much cuddlier than a hairy old pillow."
msgstr "伯尼比毛茸茸的旧枕头好抱多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_KELP"
msgid "This pillow is full of wet seaweed."
msgstr "这个枕头里全是湿海藻。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_PETALS"
msgid "I guess that's one use for flowers."
msgstr "我想这就是花的用途之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "The worst pillow ever. Maybe I can use it for something else."
msgstr "史上最糟的枕头。也许可以拿去做别的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HARAKIRI"
msgid "For Honor!"
msgstr "为了荣誉！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAREBALL"
msgid "That's nasty. I'm not the one who has to eat it, am I?"
msgstr "真恶心。不是要我吃的吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HAWAIIANSHIRT"
msgid "Grandpa's style, definitely."
msgstr "绝对是爷爷的风格。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE"
msgid "The stinging means that it's working."
msgstr "刺痛意味着它正在起作用。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSALVE_ACID"
msgid "I'll apply this before facing the acid."
msgstr "面对酸液之前先涂好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEALINGSTAFF"
msgid "I could take a crack at it."
msgstr "我可以试试看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.COLD"
msgid "That's a cold stone."
msgstr "那是一块冰冷的石头。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.FROZEN"
msgid "It's colder than ice."
msgstr "比冰还要冷。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.GENERIC"
msgid "I could manipulate its temperature."
msgstr "我可以调节它的温度。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.HOT"
msgid "Nice and toasty hot!"
msgstr "暖烘烘的，真舒服！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEATROCK.WARM"
msgid "It's quite warm and cuddly... for a rock!"
msgstr "以一块石头来说，它相当暖和又好抱！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEDGEHOUND"
msgid "It's an ambush!"
msgstr "这是埋伏！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HEDGEHOUND_BUSH"
msgid "It's a bush."
msgstr "这是一丛灌木。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITCRAB"
msgid "Heh. I rather like her."
msgstr "呵。我还挺喜欢她的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "Everyone needs a home, I suppose."
msgstr "我想，每个人都需要一个家。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "It's rather cluttered."
msgstr "相当杂乱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_BUNDLE"
msgid " I was happy to help old lady!"
msgstr "我很高兴能帮上老婆婆的忙！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "I like the plink-plonk shells."
msgstr "我喜欢叮叮当当的贝壳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "Oh dear."
msgstr "哎呀。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HERMIT_PEARL"
msgid "Don't worry, ma'am, it's safe with me."
msgstr "别担心，女士，放在我这里很安全。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HITOKIRI"
msgid "It's going to make me mad."
msgstr "它会让我发狂。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HIVEHAT"
msgid "That bee's head looks rather tasty, doesn't it?"
msgstr "那个蜜蜂头看起来挺好吃的，对吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HMINGOT"
msgid "It's hammer time."
msgstr "锤子时间到了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOME"
msgid "Someone must live here."
msgstr "一定有人住在这里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.BURNT"
msgid "\"Don't play with matches.\""
msgstr "“不要玩火柴。”"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.GENERIC"
msgid "It says \"You are here\"."
msgstr "它说“你在这里”。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "The sign is currently blank."
msgstr "这块牌子现在是空白的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEY"
msgid "Sweet and delicious."
msgstr "又甜又好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYCOMB"
msgid "It's waxy."
msgstr "它是蜡状的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYHAM"
msgid "Ham and honey go well together."
msgstr "火腿和蜂蜜是绝配。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HONEYNUGGETS"
msgid "Honey-covered morsels."
msgstr "裹满蜂蜜的小块肉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORN"
msgid "I can hear those hairy beasts inside."
msgstr "我能听到里面那些毛茸茸的野兽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HORRORFUEL"
msgid "That must be what nightmares have nightmares about."
msgstr "这一定是噩梦才会做的噩梦。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTCHILI"
msgid "Now that's a proper kick."
msgstr "这才够辣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.BOMBED"
msgid "The bombs make a lovely splash."
msgstr "炸弹溅起的水花真漂亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.EMPTY"
msgid "I'll just have to wait for it to fill up again."
msgstr "只能等它再次注满了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.GENERIC"
msgid "So warm. Lovely."
msgstr "好暖和。真舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOTSPRING.GLASS"
msgid "Should we break it up?"
msgstr "我们要把它敲碎吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUND"
msgid "It just a dog"
msgstr "它只是一只狗"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDBONE"
msgid "Not pleasant."
msgstr "不太舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "That's the end of it."
msgstr "到此为止了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "So... now what do we do with it?"
msgstr "那么...现在我们该怎么办呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "Quickly, step back!"
msgstr "快，退后！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDMOUND"
msgid "I don't like the look of that."
msgstr "我不喜欢那东西的样子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDSTOOTH"
msgid "It's sharp. I like it."
msgstr "很锋利。我喜欢。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "A blowpipe made of teeth. Clever."
msgstr "用牙齿做的吹箭筒。真聪明。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HOUNDWHISTLE"
msgid "Stay."
msgstr "别动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT"
msgid "Man eat man......will go down in history."
msgstr "人吃人……这会被载入史册。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT_COOKED"
msgid "I will never accept this kind of behavior, no matter what."
msgstr "我无论如何都不会接受这种行为。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUMANMEAT_DRIED"
msgid "I'm not in that era, nor in that place, I would never touch it."
msgstr "我不处在那个时代，也不在那个地方，我绝不会碰它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH"
msgid "What's your angle?"
msgstr "你打的是什么主意？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It's quite wet."
msgstr "湿漉漉的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It's still quite wet."
msgstr "还是湿漉漉的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICE"
msgid "Chilly."
msgstr "好凉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG.GENERIC"
msgid "That's a lot of ice."
msgstr "那是很多冰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG.MELTED"
msgid "It looks pretty melted."
msgstr "它看起来快化光了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBERG_MELTED"
msgid "It looks pretty melted."
msgstr "它看起来快化光了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEBOX"
msgid "I'm all for making things last longer."
msgstr "我很赞成让东西放得更久。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICECREAM"
msgid "Well, sometimes cold things are all right."
msgstr "嗯，有时候冷的东西也不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEHAT"
msgid "It's a real mood dampener."
msgstr "戴上它真让人提不起劲。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEHOUND"
msgid "Cold!"
msgstr "好冷！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICEPACK"
msgid "A fuzzy backpack."
msgstr "一个毛茸茸的背包。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICESTAFF"
msgid "Rather dull."
msgstr "相当无趣。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.ICE_BLUEPRINT"
msgid "Don't beefalo already have hairy winter coats?"
msgstr "皮弗娄牛不是已经有厚厚的冬毛了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Am I seeing things?"
msgstr "是我眼花了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "I wonder what that does."
msgstr "不知道那是做什么用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.INSPECTSELF"
msgid "Am I still in one piece?"
msgstr "我还完好无损吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IPECACSYRUP"
msgid "The smell alone is enough to make you sick."
msgstr "光是这味道就够让人想吐了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.IVY_SNARE"
msgid "Clear this weed safely."
msgstr "安全地清除这些杂草。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JAMMYPRESERVES"
msgid "Jam. Simple and lovely."
msgstr "果酱。简单又美味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JELLYBEAN"
msgid "Nothing better than a handful of jellybeans."
msgstr "没有什么比一把软糖更好的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE"
msgid "There might be useful parts in there."
msgstr "里面可能有能用的零件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUNK_PILE_BIG.GENERIC"
msgid "That pile doesn't look stable."
msgstr "这堆东西看起来不稳。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.JUSTEGGS"
msgid "Eggs and more eggs."
msgstr "鸡蛋，还有更多的鸡蛋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KABOBS"
msgid "Foods on a stick!"
msgstr "串在棍子上的食物！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KAGE"
msgid "At the end of its blueprint it reads:\n\"We are dust and shadows\""
msgstr "在其蓝图的末尾写道：\n“我们是尘埃和影子”"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KATANABLADE"
msgid "It has no hilt and will be uncomfortable to use."
msgstr "它没有刀柄，使用起来会很不舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KATANABODY"
msgid "Wrapped with rope and sharpened."
msgstr "缠上了绳子，也磨利了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP"
msgid "Raw kelp. I'm tempted, but no."
msgstr "生海带。有点想吃，但还是算了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELPHAT"
msgid "It feels rather like snot."
msgstr "摸起来很像鼻涕。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP_COOKED"
msgid "Now I hardly have to chew."
msgstr "这下几乎不用嚼了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KELP_DRIED"
msgid "It's not half bad."
msgstr "这还不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KILLERBEE.GENERIC"
msgid "I like the cut of that bee's jib."
msgstr "我欣赏那只蜜蜂的气势。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KILLERBEE.HELD"
msgid "Buzz."
msgstr "嗡嗡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "Combustion!"
msgstr "燃烧！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "It's not a real bird, but the kits don't know that."
msgstr "它不是真正的鸟，但幼崽们不知道这一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR1_KIT"
msgid "It looks like there's some assembly required."
msgstr "看起来需要一些组装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "It went up in flames."
msgstr "它着火了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "Those kits are so easily distracted. Now what was I doing again?"
msgstr "那些小家伙真容易分心。我刚才在做什么来着？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDECOR2_KIT"
msgid "It doesn't look too hard to build."
msgstr "看起来建造起来并不太难。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.BURNT"
msgid "NOOOO!"
msgstr "不！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.GENERIC"
msgid "You'd have to be pretty small to fit in there."
msgstr "得非常小才钻得进去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "Now where could they be..."
msgstr "现在他们可能在哪里......"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "Not much time left! Where are they?!"
msgstr "剩下的时间不多了！他们在哪里？！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.KITCOONDEN_KIT
