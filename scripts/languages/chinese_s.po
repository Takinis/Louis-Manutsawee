msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL.1"
msgid "There you are, out of the stone."
msgstr "找到你了，总算从石头里出来了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL.2"
