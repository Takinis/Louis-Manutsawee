msgstr "真漂亮。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHROOM.INGROUND"
