msgstr "醒醒，小鸟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIRDCAGE.STARVING"
msgid "He won't be quiet."
msgstr "它一直叫个不停。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.BIRDTRAP"
