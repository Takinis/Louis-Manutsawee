msgstr "不能再有人受伤了。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX.REVIVER.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX.REVIVER.1"
msgid "%s, you took care of our friend. I won't forget it."
msgstr "%s，你救了我们的朋友，我会记得。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX.REVIVER.2
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX.REVIVER.2"
msgid "%s, thank you for going back when someone needed help."
msgstr "%s，谢谢你在有人需要帮忙时赶了回去。"

#. STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX_NABBAG.1
msgctxt "STRINGS.MANUTSAWEE_SPEECH_VARIANTS.DESCRIBE.WORTOX_NABBAG.1"
