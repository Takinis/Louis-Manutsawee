#. STRINGS.SKILL.KIRITZUKA_SLAM_READY.1
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY.1"
msgid "Ready. Next swing's the big one."
msgstr "准备好了，下一击！"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY.2
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY.2"
msgid "Next one's gonna leave a dent."
msgstr "下一下会砸出个坑。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY.3
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY.3"
msgid "Alright, putting my back into this one."
msgstr "好，这下要使出全力了。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY.4
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY.4"
msgid "Stand back. Or don't, your call."
msgstr "退后点。不退也行，随你。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.1
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.1"
msgid "Okay, no holding back this time."
msgstr "好，这次不收着了。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.2
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.2"
msgid "Everybody off the ground."
msgstr "大家都离地面远点。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.3
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.3"
msgid "This one's gonna leave a crater field."
msgstr "这下要砸出一片坑。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.4
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_READY_2.4"
msgid "Full swing. Don't say I didn't warn you."
msgstr "全力一击，别说我没提醒。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.1
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.1"
msgid "Eh, next time."
msgstr "算了，下次吧。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.2
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.2"
msgid "Never mind."
msgstr "当我没说。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.3
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.3"
msgid "Changed my mind."
msgstr "改主意了。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.4
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_CANCEL.4"
msgid "Too much effort."
msgstr "太累人了，不干了。"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.1
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.1"
msgid "This thing? Not my style."
msgstr "这玩意儿不趁手。"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.2
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.2"
msgid "I need something I can actually swing."
msgstr "得换个抡得动的家伙。"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.3
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.3"
msgid "Not with this. Where's my bat?"
msgstr "拿这个可不行，我的球棒呢？"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.4
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.4"
msgid "Too light. Feels like I'm holding nothing."
msgstr "太轻了，跟没拿一样。"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.5
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.5"
msgid "I'd break this before I break anything else."
msgstr "别的还没打坏，它先坏了。"

#. STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.6
msgctxt "STRINGS.SKILL.KIRITZUKA_WEAPON_REFUSE.6"
msgid "Just give me my bat back."
msgstr "把球棒还给我就好。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.1
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.1"
msgid "Slam out here? We'd all go swimming."
msgstr "在这儿砸？大家都得下水。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.2
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.2"
msgid "Nothing solid to land on out here."
msgstr "这儿没地方落脚。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.3
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.3"
msgid "I'm not putting a hole in the only floor we've got."
msgstr "我可不想把唯一的地板砸穿。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.4
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.4"
msgid "Slam the water? That's just a big splash."
msgstr "砸水面？只会溅一身水。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.5
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.5"
msgid "The boat would go down before they do."
msgstr "敌人还没事，船先沉了。"

#. STRINGS.SKILL.KIRITZUKA_SLAM_SEA.6
msgctxt "STRINGS.SKILL.KIRITZUKA_SLAM_SEA.6"
msgid "Wait till we're on land."
msgstr "等上岸再说。"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.1
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.1"
msgid "Ugh, so gross in there."
msgstr "呕，里面真恶心。"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.2
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.2"
msgid "I'm never getting this smell out."
msgstr "这味道洗不掉了吧……"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.3
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.3"
msgid "Blegh. Never again."
msgstr "呸呸呸，再也不进去了。"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.4
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.4"
msgid "Slimy... it's all over me."
msgstr "黏糊糊的……弄得全身都是。"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.5
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.5"
msgid "Should've just walked."
msgstr "早知道还是走路好了。"

#. STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.6
msgctxt "STRINGS.SKILL.KIRITZUKA_WORM_DISGUST.6"
msgid "My uniform... ugh."
msgstr "我的制服……呃。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_ON.1
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_ON.1"
msgid "Anything in the way goes."
msgstr "挡路的都别想留。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_ON.2
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_ON.2"
msgid "Collateral damage is fine, right?"
msgstr "顺手拆点东西没关系吧？"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_ON.3
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_ON.3"
msgid "Not holding back on the furniture."
msgstr "家具什么的就不客气了。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_ON.4
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_ON.4"
msgid "Whatever breaks, breaks."
msgstr "坏了就坏了。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.1
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.1"
msgid "Fine, I'll leave the scenery alone."
msgstr "好吧，不拆了。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.2
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.2"
msgid "Okay, okay, I'll be careful."
msgstr "好啦好啦，我会小心的。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.3
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.3"
msgid "Somebody's gonna yell at me otherwise."
msgstr "不然又要挨骂了。"

#. STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.4
msgctxt "STRINGS.SKILL.KIRITZUKA_DESTROY_OFF.4"
msgid "Hands off the buildings. Got it."
msgstr "不碰建筑，知道了。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.1
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.1"
msgid "Batter up."
msgstr "打者就位。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.2
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.2"
msgid "Swing's loaded."
msgstr "蓄满了。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.3
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.3"
msgid "This one's going far."
msgstr "这一下能飞很远。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.4
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_READY.4"
msgid "Hold still, I'm aiming."
msgstr "别动，我在瞄准。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.1
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.1"
msgid "Outta the park!"
msgstr "飞出场外！"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.2
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.2"
msgid "Bye-bye."
msgstr "拜拜。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.3
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.3"
msgid "That's a home run."
msgstr "本垒打。"

#. STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.4
msgctxt "STRINGS.SKILL.KIRITZUKA_HOMERUN_FULL.4"
msgid "Didn't even need to run the bases."
msgstr "连垒都不用跑。"

#. STRINGS.SKILL.KIRITZUKA_DASH_READY.1
msgctxt "STRINGS.SKILL.KIRITZUKA_DASH_READY.1"
msgid "Point me at something."
msgstr "选个目标吧。"

#. STRINGS.SKILL.KIRITZUKA_DASH_READY.2
msgctxt "STRINGS.SKILL.KIRITZUKA_DASH_READY.2"
msgid "Just say where."
msgstr "说个方向就行。"

#. STRINGS.SKILL.KIRITZUKA_DASH_READY.3
msgctxt "STRINGS.SKILL.KIRITZUKA_DASH_READY.3"
msgid "I'll close the distance."
msgstr "距离交给我。"

#. STRINGS.SKILL.KIRITZUKA_DASH_READY.4
msgctxt "STRINGS.SKILL.KIRITZUKA_DASH_READY.4"
msgid "One step and I'm there."
msgstr "一步就到。"

#. STRINGS.SKILL.KIRITZUKA_FLURRY_READY.1
msgctxt "STRINGS.SKILL.KIRITZUKA_FLURRY_READY.1"
msgid "Don't blink."
msgstr "别眨眼。"

#. STRINGS.SKILL.KIRITZUKA_FLURRY_READY.2
msgctxt "STRINGS.SKILL.KIRITZUKA_FLURRY_READY.2"
msgid "This'll be quick."
msgstr "很快就完事。"

#. STRINGS.SKILL.KIRITZUKA_FLURRY_READY.3
msgctxt "STRINGS.SKILL.KIRITZUKA_FLURRY_READY.3"
msgid "Count the hits if you can."
msgstr "数得清就数数打了几下。"

#. STRINGS.SKILL.KIRITZUKA_FLURRY_READY.4
msgctxt "STRINGS.SKILL.KIRITZUKA_FLURRY_READY.4"
msgid "Gonna swing a lot. Stay clear."
msgstr "要乱挥一通了，躲远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "The host's still around here. Find him first."
msgstr "那位主持人还在附近，先找他。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Empty. Waste of a look."
msgstr "空的。白看了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "Guess I wait till he's done."
msgstr "还要等他忙完。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "Just these few? That'd be over in a second."
msgstr "就这几只？一下就找完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "There's nowhere here for them to hide."
msgstr "这里根本藏不住几只。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "Already played today. Taking a break."
msgstr "今天已经找过了，歇一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Locked. So where's the key this time?"
msgstr "锁着。钥匙又在哪里？"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "It can't wear this one."
msgstr "这件它穿不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "It's over. Came too late."
msgstr "散场了。来迟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "Only a robot could use something like this."
msgstr "这种东西只有机器人用得了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ACTIONFAIL.ACTIVATE.NOTMERM"
