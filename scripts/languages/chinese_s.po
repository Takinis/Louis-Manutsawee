msgctxt "STRINGS.M_LOADINGTIPS.ABIGAIL_TENSEIGA"
msgid "\"I'm sorry, Tenseiga can't do anything to save her.\" - L"
msgstr "“抱歉，天生牙也无力回天。” -L"

#. STRINGS.M_LOADINGTIPS.TOKIJIN
msgctxt "STRINGS.M_LOADINGTIPS.TOKIJIN"
msgid "\"I can't suppress its evil spirit, I can't control tokijin.\" - L"
msgstr "“我无法压制它的邪气，我无法控制斗鬼神。” -L"

#. STRINGS.M_LOADINGTIPS.WANDA_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WANDA_REDEYES"
msgid "\"emmmm, that's weird, I can't see your past timeline, it's shrouded in a white mist.\" - W"
msgstr "“emmmm，奇怪了，我看不到你过去的时间线，被白雾笼罩了。” -W"

#. STRINGS.M_LOADINGTIPS.WATHGRITHR_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WATHGRITHR_REDEYES"
msgid "\"Loki has given power to you!\" - W"
msgstr "“洛基已经把力量给了你！” -W"

#. STRINGS.M_LOADINGTIPS.WAXWELL_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WAXWELL_REDEYES"
msgid "\"I guess your eyes turned red, not from magic, but from a curse, a curse that doesn't belong here.\" - W"
msgstr "“我猜你的眼睛变红了，不是因为魔法，而是因为诅咒，一个不属于这里的诅咒。” -W"

#. STRINGS.M_LOADINGTIPS.WEBBER_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WEBBER_REDEYES"
msgid "\"Sorry, Miss Louis, I thought you were wearing red contact lenses\" - W"
msgstr "“抱歉，露易丝小姐，我以为你戴着红色隐形眼镜”-W"

#. STRINGS.M_LOADINGTIPS.WICKERBOTTOM_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WICKERBOTTOM_REDEYES"
msgid "\"science can't explain why your eyes turn red, and neither can magic.\" - W"
msgstr "“科学无法解释为什么你的眼睛会变红，魔法也无法解释。” -W"

#. STRINGS.M_LOADINGTIPS.WILSON_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WILSON_REDEYES"
msgid "\"It doesn't matter, nothing is strange here, including this girl with red eyes.\" - W"
msgstr "“没关系，这里没什么奇怪的，包括这个红眼睛的女孩。” -W"

#. STRINGS.M_LOADINGTIPS.WORTOX_REDEYES
msgctxt "STRINGS.M_LOADINGTIPS.WORTOX_REDEYES"
msgid "\"I guess you can see things that we can't see?\" - W"
msgstr "“我猜你能看到我们看不到的东西？” -W"

