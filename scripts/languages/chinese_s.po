#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "It's a good thing we have extra arms to carry all these tickets!"
msgstr "幸好我们有多余的手臂来携带所有这些门票！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Maybe now we can go get a prize!"
msgstr "也许现在我们可以去拿奖品了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "Bird food."
msgstr "鸟食。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_A"
msgid "A lovely shade of red."
msgstr "很漂亮的红色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_B"
msgid "It's like wearing my own shade tree."
msgstr "就像穿着属于自己的遮荫树。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARNIVAL_VEST_C"
msgid "Breezy."
msgstr "微风习习。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "That's a pity."
msgstr "真可惜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I love stuff made out of wood!"
msgstr "我喜欢用木头做的东西！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.DEAD"
msgid "Oh, it's dead."
msgstr "哦，它死了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.GENERIC"
msgid "I want to roast it!"
msgstr "我想烤了它！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.HELD"
msgid "It keeps squirming."
msgstr "它一直在蠕动。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT.SLEEPING"
msgid "It's snoring."
msgstr "打鼾了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARRAT_GHOSTRACER"
msgid "That's a weird looking Carrat."
msgstr "那只胡萝卜鼠看起来好奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT"
msgid "A very vegetable-y carrot."
msgstr "非常有蔬菜味的胡萝卜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_COOKED"
msgid "Still vegetable-y, but better for having been cooked."
msgstr "还是有蔬菜味，不过煮过以后好多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_OVERSIZED"
msgid "A big old carrot."
msgstr "一根又大又老的胡萝卜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_PLANTED"
msgid "Maybe its special carrot friend is in the ground."
msgstr "也许它的胡萝卜好朋友就在地里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARROT_SEEDS"
msgid "Some seeds."
msgstr "一些种子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Oh no, the maps!"
msgstr "哦不，地图！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Well, I remember most of the map."
msgstr "嗯，大部分地图我都还记得。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I could show everyone where I've been."
msgstr "我可以让大家看看我去过哪里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOON"
msgid "Meow.. Meow.. Meow..."
msgstr "喵……喵……喵……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.EMPTY"
msgid "The nine lives thing is true!"
msgstr "九条命的传说是真的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Trunk house."
msgstr "树干屋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATCOONHAT"
msgid "Meow hat."
msgstr "喵帽子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CATTOY_MOUSE"
msgid "Mice with wheels.."
msgstr "带轮子的老鼠.."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I'll break it up carefully."
msgstr "我会小心地把它敲碎。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't reach that."
msgstr "我够不着。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA"
msgid "Bananas!"
msgstr "香蕉！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_BURNT"
msgid "That was all I wanted..."
msgstr "我只想要这个……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Delicious."
msgstr "真好吃。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_BANANA_TREE"
msgid "A banana tree. Wonderful."
msgstr "一棵香蕉树。太好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE"
msgid "Who plugged that hole?"
msgstr "谁堵住了这个洞？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people down there."
msgstr "下面人太多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I'd rather not go into that hole."
msgstr "我不太想进那个洞。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "I hope there's something interesting down there."
msgstr "希望下面有些有趣的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Who plugged that hole?"
msgstr "谁堵住了这个洞？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people up there."
msgstr "上面的人太多了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "It's cooler down here, anyway."
msgstr "无论如何，这里比较凉爽。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_EXIT.OPEN"
msgid "It's too dark and stuffy down here."
msgstr "这里太黑、太闷了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CAVE_FERN"
msgid "Swirly plants."
msgstr "漩涡状植物。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CEVICHE"
msgid "It's still slimy."
msgstr "它还是粘糊糊的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARCOAL"
msgid "It smells faintly of smoke."
msgstr "隐约有股烟味。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HAND"
msgid "You want something from me?"
msgstr "你想从我这里得到什么？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_HECKLER"
msgid "They're just here to stir up drama."
msgstr "他们只是来闹事的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_LECTURN"
msgid "Is someone doing a play?"
msgstr "有人演戏吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_NPC.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_NPC.GENERIC"
msgid "Have I seen her before...?"
msgstr "我以前见过她吗……？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHARLIE_STAGE_POST"
msgid "It's a setup! It feels too... staged."
msgstr "这是圈套！感觉太……像演出来的了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK1"
msgid "Dead windup horsey."
msgstr "坏掉的发条马。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK2"
msgid "Dead windup priest."
msgstr "坏掉的发条主教。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSJUNK3"
msgid "Dead windup castle."
msgstr "坏掉的发条城堡。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "It's as heavy as it looks."
msgstr "它和看起来一样重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Can't shake anything up like that."
msgstr "这样可什么都撼动不了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Those are some pointy teeth."
msgstr "那是一些尖尖的牙齿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Somehow it seems crankier than the real one."
msgstr "不知怎的，它看起来比真的还暴躁。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "They captured his good side."
msgstr "他们雕出了它最好看的一面。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Took the sting out of her stinger."
msgstr "她的毒刺也没那么吓人了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A bishop piece."
msgstr "一枚主教棋子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到里面会出来什么！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It looks nice, doesn't it?"
msgstr "看起来很不错，不是吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Now all I can think of is carrots."
msgstr "现在我满脑子都是胡萝卜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CATCOON"
msgid "Meow.. Meow.. Meow..."
msgstr "喵……喵……喵……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It almost looks friendly."
msgstr "它看起来几乎很友好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It doesn't look so tough now."
msgstr "现在看起来没那么厉害了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Was the treasure worth it?"
msgstr "宝藏值得吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Why do the troublesome ones always get statues?"
msgstr "为什么总是麻烦的家伙才有雕像？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "We managed it, in the end."
msgstr "我们总算还是办到了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "Creepy, trembling all over."
msgstr "毛骨悚然，浑身颤抖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "I think... I think I understand art."
msgstr "我想……我想我了解艺术。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Haha, Your soul is mine!"
msgstr "哈哈，你的灵魂是我的！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_FORMAL"
msgid "I'm not afraid of that fellow. He doesn't even have arms."
msgstr "我才不怕这家伙。他连手臂都没有。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I'd be happy never seeing that thing again."
msgstr "我希望再也不要见到那东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Ow. I think I chipped a tooth."
msgstr "哎哟。我的牙好像磕掉一块。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KITCOON"
msgid "These ones are much easier to find."
msgstr "这些更容易找到。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Ha. You can't get me now."
msgstr "哈。这下你抓不到我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A horse with no butt."
msgstr "一匹没有屁股的马。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到里面会出来什么！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "She was a pretty tough old bird."
msgstr "她是只相当顽强的老鸟。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Good times."
msgstr "美好时光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "I never had a guardian, and I turned out fine. Mostly."
msgstr "我从来没有监护人，也长得好好的。大概吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOON"
msgid "I guess it's nice."
msgstr "我想这很好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Looks as awkward as the real one."
msgstr "和真的一样笨拙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_MUSE"
msgid "She doesn't have a head. That's unsettling."
msgstr "她没有头。真让人不安。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PAWN"
msgid "What sort of peasant doesn't carry a lantern?"
msgstr "哪有农民不提灯笼的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_PIPE"
msgid "That was never really my thing."
msgstr "那从来不是我的爱好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "That one looks like it could do some damage."
msgstr "那个看起来可能会造成一些伤害。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "I don't want to see what comes outta that!"
msgstr "我可不想看到里面会出来什么！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_STALKER"
msgid "Not so tough now, are you?"
msgstr "现在没那么厉害了吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "What are you looking at?"
msgstr "你在看什么？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "Now they'll always be together."
msgstr "现在他们会永远在一起。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Now it won't summon puppies"
msgstr "现在它不会召唤小狗了"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESSPIECE_YOTD"
msgid "Meaningless reward."
msgstr "无意义的奖励。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER"
msgid "He's so fuzzy."
msgstr "他毛茸茸的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's rude to stare."
msgstr "盯着别人看很不礼貌。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "At least it's not looking at me anymore."
msgstr "至少它不再看我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "More room for supplies. Excellent!"
msgstr "能装更多物资，很好！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CHUM"
msgid "Fish eat that?"
msgstr "鱼吃那个？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.GENERIC"
msgid "This dog is stone cold!"
msgstr "这狗真是铁石心肠！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYHOUND.STATUE"
msgid "That's an odd shape for a rock."
msgstr "这块石头的形状真奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.GENERIC"
msgid "How do you get your eyes to do that?"
msgstr "您的眼睛是怎么做到那样的？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CLAYWARG.STATUE"
msgid "Did someone carve this thing?"
msgstr "有人雕刻过这个东西吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.EMBERS"
msgid "That fire needs more fuel or it's going to go out."
msgstr "那场火需要更多的燃料，否则就会熄灭。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.GENERIC"
msgid "Sure beats darkness."
msgstr "总比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.HIGH"
msgid "That fire is getting out of hand!"
msgstr "这场大火已经失控了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.LOW"
msgid "The fire's getting a bit low."
msgstr "火势有点小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIRE.OUT"
msgid "Well, that's over."
msgstr "好了，就这样结束了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should put something on the fire before it goes out."
msgstr "我应该在火熄灭之前放点东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Sure beats darkness."
msgstr "总比黑暗好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Good thing it's contained!"
msgstr "幸好火被围住了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.LOW"
msgid "The fire's getting a bit low."
msgstr "火势有点小了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Nice and comfy."
msgstr "暖和又舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLDFIREPIT.OUT"
msgid "At least I can start it up again."
msgstr "至少我可以重新开始。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COLLAPSEDCHEST"
msgid "Too much damage. Let's recover what we can."
msgstr "损坏太严重了，先收回能拿的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "东。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.GENERIC"
msgid "Can't get a reading."
msgstr "读不出方向。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "东北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "西北。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "东南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "西南。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOST"
msgid "No, thank you."
msgstr "不了，谢谢。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "It looks acceptable, for a pile of rotting things."
msgstr "作为一堆腐烂的东西，看起来还算可以。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Well. That's one way to finish it."
msgstr "嗯。这也算是种结束方式。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Is it supposed to be that dry?"
msgstr "应该这么干吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Why do we have this, again?"
msgstr "我们为什么要留着这个来着？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's wet and unpleasant."
msgstr "又湿又让人不舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COMPOSTWRAP"
msgid "That's rather disgusting."
msgstr "真有点恶心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'd rather break things down than build them up."
msgstr "比起建造，我更想拆东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKBOOK"
msgid "Now i'll never forget a recipe!"
msgstr "现在我永远不会忘记食谱！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMANDRAKE"
msgid "Poor little guy."
msgstr "可怜的小家伙。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMEAT"
msgid "Unseasoned meat. How exciting."
msgstr "没调味的肉。真让人兴奋。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still unappealing."
msgstr "还是没有食欲。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKEDSMALLMEAT"
msgid "I'll need many small portions to get by out here."
msgstr "在这里要吃好多小份才活得下去。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTER"
msgid "Please stop staring."
msgstr "请别再盯着我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERHAT"
msgid "It matches my prickly side."
msgstr "和我带刺的一面很相配。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKIECUTTERSHELL"
msgid "I borrowed its house. Permanently."
msgstr "我借了它的房子。永久地。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "It records a lot of delicious food!"
msgstr "记录了很多美食！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.BURNT"
msgid "The pot got cooked."
msgstr "锅被煮熟了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This is going to take a while."
msgstr "这需要一段时间。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It's almost done!"
msgstr "快好了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.DONE"
msgid "Mmmmm! It's ready to eat!"
msgstr "嗯嗯！可以吃了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COOKPOT.EMPTY"
msgid "It makes me hungry just to look at it."
msgstr "光是看着它就让我感到饥饿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COONTAIL"
msgid "I've kept stranger things than that."
msgstr "我还保留过比那更奇怪的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN"
msgid "A sweet vegetable."
msgstr "一种甜甜的蔬菜。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_COOKED"
msgid "It pops nicely when it's cooked."
msgstr "煮熟后爆得很好听。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_OVERSIZED"
msgid "That's a lot of corn."
msgstr "真是好多玉米。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CORN_SEEDS"
msgid "Some seeds."
msgstr "一些种子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It's a blacksmith costume."
msgstr "这是铁匠装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It's a doll costume."
msgstr "这是娃娃装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It's a fool's costume."
msgstr "这是小丑的服装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_KING_BODY"
msgid "It's a King costume."
msgstr "这是国王的服装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It's a costume."
msgstr "这是一套服装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It's a Queen costume."
msgstr "这是女王装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COSTUME_TREE_BODY"
msgid "It's a tree costume."
msgstr "这是树服装。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起来在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "That's better."
msgstr "这样更好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起来在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "That looks lovely lit."
msgstr "点亮后真好看。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "It looks like it's waiting for an offering."
msgstr "看起来在等待供品。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Flame is stable."
msgstr "火焰很稳定。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COTL_TRINKET"
msgid "Finder's keepers."
msgstr "谁捡到就是谁的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.COZY_BUNNYMAN"
msgid "They look comfortable."
msgstr "他们看起来很舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.GENERIC"
msgid "He doesn't look too happy..."
msgstr "他看上去不太高兴……"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING.INERT"
msgid "I think it could use something glittery."
msgstr "我想它需要些闪闪发光的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRABKING_CLAW"
msgid "Please keep your claws off my boat."
msgstr "请把您的钳子从我的船上拿开。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTERLAB"
msgid "Is there anything cute in there?"
msgstr "里面有什么可爱的东西吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_DRAGONLING"
msgid "I think we'll get along."
msgstr "我想我们会相处得很好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "You're looking well today."
msgstr "你今天气色不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_GLOMLING"
msgid "Aw, what a funny little face."
msgstr "呀，真是张滑稽的小脸。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_KITTEN"
msgid "You're the perfect lapwarmer."
msgstr "你是完美的暖腿垫。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LAMB"
msgid "Look at those little eyes. How odd. How sweet."
msgstr "看看那双小眼睛。真奇怪。真可爱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "She loves light."
msgstr "她喜欢光。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PERDLING"
msgid "You're adorable."
msgstr "你真可爱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRITTER_PUPPY"
msgid "You don't even know you're smelly, do you?"
msgstr "你还不知道自己很臭吧？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.GENERIC"
msgid "I think it's waiting for something to go wrong."
msgstr "我想它在等着出事。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CROW.HELD"
msgid "Not so smart now, are you?"
msgstr "现在不那么聪明了，是吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CRUMBS"
msgid "That little fellow is losing his parts."
msgstr "那小家伙在掉零件。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "I already have a curse more powerful than this. This one has no effect on me."
msgstr "我已经有比这更强大的诅咒了。这个对我来说没有任何影响。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for crafting."
msgstr "割下的草，可以用来制作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLESS"
msgid "A wooden sword. Better than nothing."
msgstr "一把木剑，总比没有好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTLICHEN"
msgid "It tastes a lot like sawdust."
msgstr "吃起来很像锯末。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for crafting."
msgstr "割下的芦苇，可以用来制作。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.CUTSTONE"
msgid "Perfectly squared. Very satisfying."
msgstr "方方正正，让人非常满足。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.GENERIC"
msgid "I was only trying to help!"
msgstr "我只是想帮忙而已！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Looks like somebody's having a bad day."
msgstr "看来某人今天过得很糟糕。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.BURIED"
msgid "He's buried in scrap. Approach carefully."
msgstr "他被埋在废料里，小心靠近。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.GENERIC"
msgid "I'll leave him alone while he's calm."
msgstr "他还平静的时候就别打扰。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "He's ready to fight. So am I."
msgstr "他准备动手了，我也准备好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It won't break. I didn't try that hard, but still."
msgstr "它砸不破。虽然我也没那么用力。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "How crazy would I have to be to try and break that pillar?"
msgstr "得多疯狂才会想打破那根柱子？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEADLYFEAST"
msgid "Cooking didn't cure this dish of being nasty."
msgstr "再怎么煮也改变不了这道菜有多恶心。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEAD_SEA_BONES"
msgid "What if I had stepped on it by accident?"
msgstr "要是不小心踩到了怎么办？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "What a waste of wood."
msgstr "多么浪费木材啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I feel like I could have prevented that."
msgstr "我觉得我本可以阻止这种情况发生。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Take that, nature!"
msgstr "吃我一斧，大自然！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's all leafy. Most of the time."
msgstr "都是绿叶。大多数时候。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It looks unhappy about me stealing those birchnuts!"
msgstr "我偷了那些桦栗果，它看起来很不高兴！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_CENTERPIECE"
msgid "Okay."
msgstr "好的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "It's empty. Time to refill."
msgstr "空了。该补上了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "At least we won't be in the dark."
msgstr "至少我们不会摸黑了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "A simple flower arrangement."
msgstr "简单的插花。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "We're going to be in the dark soon."
msgstr "我们很快就要摸黑了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Those need replacing."
msgstr "那些需要更换。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_LAMP"
msgid "A lamp. Simple and warm."
msgstr "一盏灯。简单又温暖。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It's fine."
msgstr "还不错。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Drawing isn't really my talent, but I may try."
msgstr "画画不是我的长项，不过我可以试试。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "The portrait is missing a certain spark."
msgstr "这幅肖像少了一点神韵。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.ANTLER"
msgid "That antler is impressive. Don't let it go to your head, deer."
msgstr "那鹿角真了不起。不过别太得意了，小鹿。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER.GENERIC"
msgid "Everyone fawns over the deer. I can't blame them."
msgstr "大家都喜欢这只鹿。也不能怪他们。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS"
msgid "Oh my."
msgstr "天哪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "This is the best way to handle it..."
msgstr "这是最好的处理方式..."

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Quick, toss that Deerclops carcass into the fire, don't give them a chance!"
msgstr "快，把鹿角怪的尸体扔进火里，别给他们机会！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "That's... not good."
msgstr "这……不太好吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "It keeps a watchful eye for us."
msgstr "它帮我们盯着周围。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "There we go."
msgstr "好了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Looks like it's easy to assemble"
msgstr "看起来很容易组装"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Please stop staring."
msgstr "请别再盯着我了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_ANTLER"
msgid "It's a big, weird antler."
msgstr "这是一个又大又奇怪的鹿角。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEER_GEMMED"
msgid "Marginally better smelling than most animals here."
msgstr "比这里的大多数动物的气味略好一些。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "What a sorry looking piece of... grass?"
msgstr "一块看起来多么可怜的……草？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DESERTHAT"
msgid "Not very stylish."
msgstr "不是很时尚。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL"
msgid "A strange tool with a familiar smell."
msgstr "工具很奇怪，气味却很熟悉。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DEVTOOL_NODEV"
msgid "I can't wield this properly."
msgstr "我没法好好使用它。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIRTPILE"
msgid "Who just leaves dirt lying around in the forest?"
msgstr "谁会把泥土堆在森林里？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.COLD"
msgid "Buzz buzz buzz, What sound did you hear?"
msgstr "嗡嗡嗡，你听到了什么声音？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.GENERIC"
msgid "This thing looks like it's full of electronic waste!"
msgstr "这东西看起来里面装满了电子垃圾！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.HOT"
msgid "Please stop beeping. It's so noisy."
msgstr "请别再响了，太吵了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARM"
msgid "This thing is getting noisier and noisier."
msgstr "这东西越来越吵了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGROD.WARMER"
msgid "It feels like we're almost there! What kind of treasure could it be?"
msgstr "感觉我们就快到了！到底会是怎样的宝物呢？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "I'm not sure what this does."
msgstr "我不确定这是做什么用的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.READY"
msgid "It just needs a key to unlock it."
msgstr "只要一把钥匙就能开启。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It's whirring now."
msgstr "它现在开始嗡嗡响了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DIVININGRODSTART"
msgid "I'll make something out of it."
msgstr "我会用它做点什么。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_KIT"
msgid "Everything I need to build a dock for my boat."
msgstr "为我的船建造码头所需的一切。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Aha! I thought the dock was missing something."
msgstr "啊哈！我以为码头缺少什么东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DOLL_BLUEPRINT"
msgid "Awww, my beefalo's going to be so hideous and adorable!"
msgstr "呜啊，我的牛会变得又丑又可爱！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_KIT"
msgid "\"Dragon Boat\""
msgstr "《龙舟》"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBOAT_PACK"
msgid "\"Dragon Boat\" Kit"
msgstr "“龙舟”套装"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONBODYHAT"
msgid "I'm not sure I want to be in *another* belly."
msgstr "我不确定我想进入*另一个*肚子里。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONCHILISALAD"
msgid "I can hardly wait to eat it."
msgstr "我都等不及要吃了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLY"
msgid "Oh, don't you just drag on."
msgstr "哦，别再拖拖拉拉了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Chest is not afraid of fire."
msgstr "这箱子不怕火。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Let's turn it back on."
msgstr "我们把它重新打开吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "That's certainly a look."
msgstr "这造型可真不一般。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It's warm and rather lovely."
msgstr "暖暖的，真舒服。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Another gem should do it."
msgstr "再放一颗宝石就好。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT"
msgid "What a weird fruit."
msgstr "多么奇怪的水果啊。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "The fruit's still weird."
msgstr "水果还是很奇怪。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "I'd hoped it would be a bit smaller."
msgstr "我本来希望它能小一点。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "这是一颗种子。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONHEADHAT"
msgid "The front part's sort of scary."
msgstr "前面的部分有点吓人"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONPIE"
msgid "The dragonfruit is very filling."
msgstr "火龙果吃得很饱。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGONTAILHAT"
msgid "I like the tail!"
msgstr "我喜欢尾巴！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRAGON_SCALES"
msgid "They don't weigh much for scales."
msgstr "作为鳞片，它们并不重。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE"
msgid "Why does this rock feel so cold and clammy?"
msgstr "这块石头为什么摸起来又冷又潮？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONEHAT"
msgid "Do I really have to wear it on my head?"
msgstr "真的要把它戴在头上吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DREADSTONE_STACK"
msgid "It's growing from way down below."
msgstr "它是从很深的地下长出来的。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_LOG"
msgid "Dry wood. Good utility material."
msgstr "干木头，很实用的材料。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "That driftwood's burning!"
msgstr "那块浮木着火了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Well. That's the end of that."
msgstr "嗯。这下全完了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "There might still be something worth digging up."
msgstr "或许还有值得挖掘的东西。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.DRIFTWOOD_TREE.GENERIC
