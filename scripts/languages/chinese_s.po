msgstr "好了。开动吧。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
