msgstr "看看这尊山羊雕像。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
