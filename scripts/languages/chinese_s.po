msgstr "我太幸运了！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_CAP"
msgid "I like the color."
msgstr "我喜欢这个颜色。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_CAP_COOKED"
msgid "Cooking transformed it."
msgstr "煮过以后变样了。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.RED_MUSHROOM.GENERIC"
