msgstr "放这里，裁判根本看不见。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Knew it wouldn't be that easy to shake off."
msgstr "果然没这么容易摆脱。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "The race isn't over. Get up."
msgstr "比赛还没结束，起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "Stop spacing out, run."
msgstr "别发呆了，快跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Run, not walk."
msgstr "用跑的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Wrong way."
msgstr "跑反了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "Turn around, it's that way."
msgstr "回头，那边才对。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CARRAT_START_RACE"
msgid "It's started. Once it's over, I can rest."
msgstr "开始了，跑完就能休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CAVEIN"
msgid "The ceiling's coming down!"
msgstr "上面要塌了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHAIR_ON_FIRE"
msgid "The chair's on fire, why are we still sitting!"
msgstr "椅子着火了，还坐什么！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHARLIE"
msgid "Who's there?"
msgstr "谁在那边？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! Don't touch me!"
msgstr "痛！别碰我！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COLD"
msgid "So cold... I want to go back to bed."
msgstr "好冷……想回被窝。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COMPASS_OUT"
msgid "The compass broke too."
msgstr "指南针也坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_COZY_SLEEP"
msgid "Slept enough."
msgstr "睡够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_CRAFTING_FAIL"
msgid "Still don't have all the materials."
msgstr "材料还没凑齐。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DAMP"
msgid "Rain. What a pain."
msgstr "下雨了，真麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DEERCLOPS"
msgid "Those are some loud footsteps."
msgstr "这个脚步声可不小。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DESPAWN"
msgid "Finally get to leave this place?"
msgstr "终于能离开这里了？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength's back to normal."
msgstr "力气恢复原样了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "No more electricity."
msgstr "不带电了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Back to dodging the rain."
msgstr "又得躲雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "The protection's gone. Be careful."
msgstr "护身的效果没了，小心点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Starting to get sleepy..."
msgstr "开始困了……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "Slow again. What a pain."
msgstr "又变慢了，真麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Digging it up helped a lot."
msgstr "挖掉就好多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DREADSTONE_SPIKE_EXPLODING"
msgid "It's gonna blow, get away!"
msgstr "要炸了，快躲开！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_DUSK"
msgid "Almost dark again."
msgstr "又快天黑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.GENERIC"
msgid "This one's alright."
msgstr "这个还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.INVALID"
msgid "You call this food?"
msgstr "这也算食物？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.PAINFUL"
msgid "My stomach feels awful... what did I even eat?"
msgstr "胃好难受……我吃的到底是什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.SPOILED"
msgid "Rotten like this, how could I eat it."
msgstr "坏成这样，怎么能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.STALE"
msgid "Sat around too long. Tastes terrible."
msgstr "放太久了，味道很差。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EAT.YUCKY"
msgid "Get it away from me. I'm not eating that."
msgstr "拿远一点，我不吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I'll wait till everyone's seated."
msgstr "等大家坐齐了再吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_BOOSTED"
msgid "The potion got stronger."
msgstr "药效变强了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Now I can even see ghosts clearly."
msgstr "现在连幽灵都能看清了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "Walk faster, finish sooner."
msgstr "走快一点，早点结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "This potion's way too strong."
msgstr "这个药效也太强了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.1"
msgid "So heavy..."
msgstr "好重……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.2"
msgid "Why do I have to carry this..."
msgstr "为什么要我搬……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.3"
msgid "My arms are already sore..."
msgstr "手已经酸了……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.4"
msgid "How much farther..."
msgstr "还有多远……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.5"
msgid "Quit rushing me..."
msgstr "先别催……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.6"
msgid "My uniform's getting all wrinkled..."
msgstr "制服都压皱了……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.7"
msgid "Let me catch my breath..."
msgstr "让我缓一口气……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.8"
msgid "A few more steps..."
msgstr "再走几步……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENCUMBERED.9"
msgid "Next time I'm getting someone to help..."
msgstr "下次找人一起搬……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENTER_DARK"
msgid "Where's a light? I can't see anything."
msgstr "灯呢？什么也看不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ENTER_LIGHT"
msgid "Now I can see."
msgstr "这下能看清了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EXIT_GELBLOB"
msgid "Finally out. My clothes are all stuck together."
msgstr "总算出来了，衣服全黏住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "An eye this big, and it flies too."
msgstr "这么大一只眼睛，还会飞。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Leaving now? It's already kept me up all night."
msgstr "现在才走，已经折腾一夜了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Back again. Still not over?"
msgstr "又来了。还没结束？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FAN_OUT"
msgid "The fan broke."
msgstr "扇子坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "If I'm researching this, at least skip the exam."
msgstr "研究这个就别安排考试了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "So hot... my stomach hurts."
msgstr "好烫……肚子在疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "My stomach's burning... who said this wasn't spicy?"
msgstr "肚子好烫……谁说这个不辣的？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "It finally stopped hurting. Never touching that again."
msgstr "终于不疼了，不碰那个了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLARE_SEEN"
msgid "Someone's signaling over there."
msgstr "那边有人发信号。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOATER_HELD"
msgid "Keep me afloat, don't let go."
msgstr "先让我浮着，别松手。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOATER_LETGO"
msgid "Wait, I'm not on shore yet!"
msgstr "等等，我还没上岸！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "Can't swim anymore... gotta get to shore fast."
msgstr "游不动了……得赶快上岸。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_FREEDOM"
msgid "Finally, I can go."
msgstr "终于可以走了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GATHER_MERM"
msgid "Looks like the merms are gathering."
msgstr "鱼人好像在集合。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GHOSTDRAIN"
msgid "Staying near ghosts feels worse and worse."
msgstr "待在幽灵旁边，越来越难受了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GOT_DECON_MISTED"
msgid "My clothes are soaked from the spray."
msgstr "衣服都喷湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GRUE_NOCHARLIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GRUE_NOCHARLIE"
msgid "Is there something else in the dark?"
msgstr "黑暗里还有别的东西？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GRUE_NOCHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_GRUE_NOCHARLIE_ATTACK"
msgid "Something bit me!"
msgstr "什么东西咬我！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "The acid protection wore off."
msgstr "防酸的药效过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "It's burning again. Any salve left?"
msgstr "又开始烫了，药膏还有吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Made it... maybe slower next time."
msgstr "到了……下次能不能慢一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Why am I still here? Let's go somewhere else."
msgstr "怎么还在这里，换个地方吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HIGHRESEARCH"
msgid "Actually learned quite a bit this time."
msgstr "这次居然学到了不少。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOT"
msgid "So hot... where's some shade."
msgstr "好热……哪里有阴凉。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HOUNDS"
msgid "That howling again."
msgstr "又是那种叫声。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNGRY"
msgid "Hungry. Want something tasty."
msgstr "饿了。要好吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This way should be less trouble."
msgstr "走这边应该少些麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Fresh tracks. It's close."
msgstr "脚印很新，它就在附近。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "The trail's gone cold."
msgstr "线索断了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The rain washed the tracks away."
msgstr "脚印都被雨冲掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_START_FORK"
msgid "This path looks like a hassle."
msgstr "这条路看着就很麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "Found it. Worth the walk."
msgstr "找到了，没白走。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Feels like something's watching me."
msgstr "好像有东西在盯着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Needs more fertilizer."
msgstr "还要再施肥。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "口袋已经满了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_IS_FEASTING"
msgid "Happy Winter's Feast. Save me something sweet."
msgstr "冬季盛宴快乐。给我留点甜的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Knew one was hiding here."
msgstr "这里果然藏了一只。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you."
msgstr "找到你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Here."
msgstr "在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "This spot's way too obvious."
msgstr "这个位置太明显了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Come on out, I see you."
msgstr "出来吧，我看到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Last one."
msgstr "最后一只。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "{name} found the last one. That's it."
msgstr "{name}找到最后一只了，结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Where's the last one hiding?"
msgstr "还剩一只藏在哪里？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Didn't find them all. Next time."
msgstr "没找齐。下次再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Almost out of time, gotta keep looking."
msgstr "时间快到了，还得再找找。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "It wouldn't hide this far."
msgstr "应该不会躲得这么远。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Back to searching nearby."
msgstr "回去附近找。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Hide-and-seek? Count me in."
msgstr "捉迷藏？算我一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Three, two, one. All hidden?"
msgstr "三，二，一。藏好了？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "It called for backup too."
msgstr "它还叫了帮手。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_ENRAGE"
msgid "Don't fight it head-on, back off!"
msgstr "别硬打，先退！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KLAUS_UNCHAINED"
msgid "The chains broke, watch out!"
msgstr "锁链断了，小心！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_KNOCKEDOUT"
msgid "My head hurts..."
msgstr "头好疼……"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Good thing that blocked it."
msgstr "还好挡住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "That hand's trying to put the light out again."
msgstr "那只手又想把灯弄灭。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LOWRESEARCH"
msgid "All that fuss to learn this little."
msgstr "折腾这么久，就学到这么一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "It's coming again."
msgstr "它又来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Don't hit me, someone's standing here."
msgstr "别砸到我，这里还站着人。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Why's it so noisy out there."
msgstr "外面怎么这么吵。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "That moonlight's a little too bright to be normal."
msgstr "那道月光，亮得有点不正常。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Already got two. That's enough for now."
msgstr "已经有两只了，先这样吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That kind of signal attracts trouble."
msgstr "这种信号会引来麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "So hot, and now my stomach hurts too."
msgstr "好烫，肚子也开始痛了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "Should've never eaten that."
msgstr "早知道就不吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "Finally not burning. Let me rest a while."
msgstr "总算不烫了，让我歇一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_1"
msgid "Something's off with my body."
msgstr "身上有点不对劲。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What happened to my hair!"
msgstr "我的头发怎么变成这样了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Finally back to normal."
msgstr "总算变回来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "A few more hits."
msgstr "再敲几下。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Something's stuck in there."
msgstr "里面卡着东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Finally got it out."
msgstr "总算取出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost got it."
msgstr "马上就能拿到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Gotta keep hitting it."
msgstr "还得接着敲。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "It's out."
msgstr "出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Just a little more."
msgstr "就差一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "There's still something in there."
msgstr "还有东西在里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Got this piece too."
msgstr "这块也拿到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOONPOTION_FAILED"
msgid "No reaction. Have to redo it."
msgstr "没反应，又要重做。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOSQUITOS"
msgid "Mosquitoes, stay away from me."
msgstr "蚊子，别靠近我。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "You're hurt pretty bad. Rest first."
msgstr "你伤得很重，先休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Back again, and tougher to deal with."
msgstr "又来了，还变得更难对付了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERGIFT"
msgid "Clear out the area first."
msgstr "先把周围清理干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERSIESTA"
msgid "Can't sleep at a time like this."
msgstr "这种时候可睡不着。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODANGERSLEEP"
msgid "It's too dangerous around here."
msgstr "附近太危险了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODAYSLEEP"
msgid "Too bright, can't sleep."
msgstr "太亮了，睡不着。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Not sleepy yet."
msgstr "现在还不困。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOHUNGERSIESTA"
msgid "Eat first, or I won't sleep."
msgstr "先吃饭，不然睡不着。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOHUNGERSLEEP"
msgid "There's no sleeping on an empty stomach."
msgstr "饿着肚子根本睡不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOMOUNTEDGIFT"
msgid "Get off the beefalo first."
msgstr "先从牛背上下来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NONIGHTSIESTA"
msgid "It's nighttime already. Just go to bed."
msgstr "都晚上了，直接睡觉吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "Resting here feels uneasy somehow."
msgstr "这里休息总觉得不安稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "The pumpkin's on fire, why would I carve it."
msgstr "南瓜都烧起来了，还刻什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOSLEEPONFIRE"
msgid "Put out the fire first."
msgstr "先把火灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NOWARDROBEONFIRE"
msgid "The wardrobe's on fire!"
msgstr "衣柜着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_NO_TRAP"
msgid "No trap. Let's go."
msgstr "没有陷阱。走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Bad cast."
msgstr "甩歪了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Got away. Another wait for nothing."
msgstr "跑了。又白等了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Still no bites."
msgstr "鱼还没上钩。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Would somewhere else be faster? Forget it, too far."
msgstr "换个地方会不会快一点？算了，太远。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "An ocean this big, and still no fish."
msgstr "海这么大，鱼也不来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Should've stayed ashore and slept."
msgstr "早知道就留在岸上睡觉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "The line snapped. All that for nothing."
msgstr "线断了，前面都白忙了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Time to reel in a bit."
msgstr "该收一点线了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "There's something huge in the water."
msgstr "水里有个很大的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OFF_SCRIPT"
msgid "I think I botched that line."
msgstr "好像演错了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "The den's gone, and the boat went with it."
msgstr "巢拆掉了，船也跟着散了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "This kind of boat can't go into deep water."
msgstr "这种船不能开到深水里。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PECKED"
msgid "Don't peck me!"
msgstr "别啄我！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PETRIFED_TREES"
msgid "That noise just now came from the trees?"
msgstr "刚才的声音是树发出来的？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "This smell's not quite right."
msgstr "这个味道不太对。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PIRATES_ARRIVE"
msgid "Now pirates too. What a hassle of a day."
msgstr "海盗也来了，今天真麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PLANT_RANDOMSEED"
msgid "Let's see what grows."
msgstr "看看能长出什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "Noted. Don't make me memorize it again."
msgstr "记下来了，别让我再背。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Couldn't that have been a softer landing."
msgstr "落地也不能轻一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_PREFALLINVOID"
msgid "There's no ground down there!"
msgstr "下面根本没有地！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_QUAKE"
msgid "Shaking again. Watch your head."
msgstr "又在震了，小心头顶。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Rabbits won't come here."
msgstr "兔子不会到这里来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Whatever's underground is coming out. Back up."
msgstr "地下的东西要出来了，退后。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_LUCKY"
msgid "That rabbit's kind of special."
msgstr "那只兔子有点特别。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got it. Worth the chase."
msgstr "抓到了，没白追。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's moving underground."
msgstr "地下有动静。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REPELLED"
msgid "Can't hit through it, it's got a shield."
msgstr "打不进去，有护盾。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RESEARCH"
msgid "That's enough studying for today."
msgstr "今天的学习就到这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Thanks. That really wasn't fun."
msgstr "谢谢。刚才可真难受。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Up you get. Take a moment."
msgstr "起来吧，先缓一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_REVIVING_CORPSE"
msgid "Don't move, I've got you."
msgstr "别动，我来帮你。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.1"
msgid "Your Majesty."
msgstr "陛下。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.2"
msgid "Your Highness."
msgstr "殿下。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY.3"
msgid "Hello. Can we talk business now?"
msgstr "您好，能说正事了吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Yes, Your Majesty."
msgstr "好的，陛下。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your Highness, done with the act?"
msgstr "殿下，演够了吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Really think you're a king, huh."
msgstr "还真把自己当国王了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_RUINS_RESET"
msgid "All back again. Have to clear it all over."
msgstr "又都回来了，还得再清一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SACREDCHEST_NO"
msgid "Wrong. Gotta try again."
msgstr "不对，还要再试。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SACREDCHEST_YES"
msgid "Finally passed."
msgstr "总算通过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SCRAPBOOK_FULL"
msgid "Already got all these written down."
msgstr "这些已经全记过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Why does it keep following me!"
msgstr "怎么一直跟着我！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "What bit me? I can't see it!"
msgstr "什么咬了我？看不见！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "That rift's getting less and less normal."
msgstr "那道裂隙越来越不正常了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SHELTER"
msgid "It's a bit less wet under a tree."
msgstr "在树下能少淋一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNARED"
msgid "Caught by the bones. It hurts."
msgstr "被骨头卡住了，好痛。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNARED_IVY"
msgid "The vines have got me!"
msgstr "藤蔓缠住我了！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Not enough snow."
msgstr "雪不够。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "Can't push it any bigger."
msgstr "已经推不大了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SOAKED"
msgid "Soaked through. I really want to change clothes."
msgstr "全湿了。真想换身衣服。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_SPOOKED"
msgid "That thing just now, you saw it too?"
msgstr "刚才那个，你也看见了？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_STOMP_SHROUDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_STOMP_SHROUDEN"
msgid "Don't let it get back up this time."
msgstr "这次可别让它再爬起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "You've grown a little taller."
msgstr "你又长高了一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "As long as you don't get bugs."
msgstr "别长虫就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "Talking to plants again."
msgstr "又要对着植物说话了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Once you're grown, that's one more dish."
msgstr "等你长好，就能加一道菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "That's enough talking today. I'm sitting down."
msgstr "今天的话说完了，我坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_THORNS"
msgid "Pricked myself."
msgstr "扎到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_THURIBLE_OUT"
msgid "The incense burned out."
msgstr "香烧完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_ABANDONED"
msgid "I'll find them myself from here."
msgstr "接下来我自己找。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_DEAD"
msgid "It's dead... keep the kittens away from here."
msgstr "它死了……别再让小猫靠近这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "I know, I'm following you."
msgstr "知道了，我跟着你。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Someone else found it first."
msgstr "被别人先找到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "It should be close."
msgstr "应该就在附近。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Nothing else. Let's head back."
msgstr "没有别的了，回去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_START_TRACKING"
msgid "Found the scent? Let's go."
msgstr "找到气味了？走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "It's still waiting for me. Gotta catch up."
msgstr "还在等我，得跟上。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOADESCAPED"
msgid "It got away after all."
msgstr "还是跑掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOADESCAPING"
msgid "It's trying to run."
msgstr "它想跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOL_SLIP"
msgid "Too slippery, I lost my grip."
msgstr "太滑了，没拿住。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOOL_TOOWEAK"
msgid "Need a sturdier tool."
msgstr "得换把结实的工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TORCH_OUT"
msgid "The torch went out, find a light quick."
msgstr "火把灭了，快找光。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Here. At least I didn't have to walk."
msgstr "到了。至少不用走过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_TRAP_WENT_OFF"
msgid "Stepped right on it. Just my luck."
msgstr "踩中了，真倒霉。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_UNIMPLEMENTED"
msgid "It's not finished, and it hurts to touch."
msgstr "还没做好，碰着疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Since they're helping, let's not hit them for now."
msgstr "既然在帮忙，就先别打它们。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "Nothing happened. Have to check the other side."
msgstr "没有反应，还得检查另一边。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WASHED_ASHORE"
msgid "Still alive. My clothes are soaked, though."
msgstr "还活着。衣服倒是全湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEAK_RAT"
msgid "How's it gonna train like that? Let it rest."
msgstr "它这样还怎么训练，先休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEAPON_TOOWEAK"
msgid "Can't dent it. Need a different weapon."
msgstr "打不动，得换把武器。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "重量：{weight}"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nThis one was finally worth the wait."
msgstr "重量：{weight}\n这条总算值得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WET"
msgid "My uniform's starting to get wet."
msgstr "制服开始湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WETTER"
msgid "It's soaked through now."
msgstr "已经湿到里面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Grabbed wide."
msgstr "抓偏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Didn't fish up anything."
msgstr "什么也没捞到。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Today doesn't seem so boring."
msgstr "今天好像没那么无聊。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Back to normal."
msgstr "又恢复平常了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMHOLE"
msgid "Gross... can we walk next time."
msgstr "恶心……下次能走路吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMS"
msgid "Something's moving under my feet."
msgstr "脚下有东西在动。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORMS_BOSS"
msgid "That's way too much racket."
msgstr "这个动静也太大了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Didn't make it... Wortox, does this tuft of fur get shy too?"
msgstr "没传过去……沃拓克斯，你这撮毛也会认生吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Learned another beefalo outfit."
msgstr "又学会一款牛的衣服。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOBOATS"
msgid "Have to steer the boat near the start."
msgstr "得把船开近起点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "No checkpoints set yet."
msgstr "检查点还没设。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "Not enough boat slots."
msgstr "船位不够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.1"
msgid "Ugh, that got me."
msgstr "呜，碰到我了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.2"
msgid "This scratch, I'll remember it."
msgstr "这点伤，先记着。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.3"
msgid "Don't touch my uniform."
msgstr "别碰我的制服。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.4"
msgid "Just a graze... still hurts, though."
msgstr "只是擦到一点……还是疼的。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.5"
msgid "I saw where you hit."
msgstr "我看见你打到哪里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.LIGHT.6"
msgid "I can take this much."
msgstr "这点伤还能忍。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.1"
msgid "Ow! That one really hurt."
msgstr "疼！这下真疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.2"
msgid "Quit rushing, I'm still standing."
msgstr "别催，我还站得住。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.3"
msgid "Falling back a step, that really hurts."
msgstr "先退一步，真的疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.4"
msgid "Can't pretend that one didn't hurt."
msgstr "这下可没办法装作不疼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.5"
msgid "That really hurts this time, don't practice on me."
msgstr "这次是真的疼，别拿我练手。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.MEDIUM.6"
msgid "Could you hit a little softer... never mind."
msgstr "能不能轻一点……算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.1"
msgid "It hurts... don't come any closer!"
msgstr "好痛……先别过来！"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.2"
msgid "No good, gotta back away first."
msgstr "不行，得先退开。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.3"
msgid "Stop chasing me... let me catch my breath."
msgstr "别追了……让我喘口气。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.4"
msgid "Still standing, don't worry. I'm backing away a bit."
msgstr "我还站着，不用担心。先退远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.5"
msgid "That one... that was a bit much. Don't leave me here."
msgstr "这一下……有点受不了了。别把我留在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_HURT.HEAVY.6"
msgid "Don't make me talk, even breathing hurts."
msgstr "别催我说话，呼吸都疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "Not ready yet? Then I'll sit for a bit."
msgstr "还没准备好？那我先坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Don't fly this way!"
msgstr "别往这边飞！"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.1"
msgid "Don't run around."
msgstr "别乱跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.2"
msgid "Hold still, just for a second."
msgstr "站住，就一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.3"
msgid "Don't run, I don't feel like chasing you."
msgstr "别跑，我不想追。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.DEER.4"
msgid "If you want to negotiate, there's still time."
msgstr "要商量的话，现在还来得及。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.1"
msgid "Let's wrap this up."
msgstr "快点结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.2"
msgid "Alright, my turn."
msgstr "好了，轮到我了。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.3"
msgid "You insist on coming over, so come on."
msgstr "既然你非要过来，那就来吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.GENERIC.4"
msgid "I'm watching your moves."
msgstr "我在看着你的动作。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.1"
msgid "Don't charge at me."
msgstr "别冲过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.2"
msgid "Once we're done, we all go eat."
msgstr "打完就各自吃饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.3"
msgid "Lunch is negotiable. Stepping on my shoes isn't."
msgstr "午饭可以商量，踩我的鞋不行。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PIG.4"
msgid "Being strong doesn't mean you get to shove people."
msgstr "力气大也别乱推人。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.1"
msgid "Don't make me chase you too long."
msgstr "别让我追太久。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.2"
msgid "That's far enough, stop running."
msgstr "就到这里，别跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.3"
msgid "I'm already thinking about sitting down for a rest."
msgstr "我已经开始想坐下来休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.PREY.4"
msgid "Any farther and it's too far."
msgstr "再往前就太远了。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.1"
msgid "Stay away from me."
msgstr "离我远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.2"
msgid "Don't crawl on my skirt!"
msgstr "别往裙子上爬！"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.3"
msgid "All this space, and you have to crowd over here."
msgstr "地方那么多，非要往我这里挤。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER.4"
msgid "So you've got a lot of legs. And?"
msgstr "腿多了不起吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.1"
msgid "Any closer and I start swinging."
msgstr "再靠近就动手了。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.2"
msgid "No jumping out all of a sudden!"
msgstr "不许突然跳过来！"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.3"
msgid "I can see you're about to jump. Same trick won't work."
msgstr "看见你要跳了。同一招没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.BATTLECRY.SPIDER_WARRIOR.4"
msgid "Lots of legs, jumpy, and bad-tempered too."
msgstr "腿多、会跳，脾气还大。"

#. STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.GENERIC"
msgid "That's enough."
msgstr "就到这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.PIG"
msgid "Don't come any closer."
msgstr "别再过来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.PREY"
msgid "Forget it, not chasing you."
msgstr "算了，不追了。"

#. STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.SPIDER"
msgid "Back to your web."
msgstr "回你的网里去。"

#. STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Just don't follow me."
msgstr "别跟过来就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Abigail, your bow's a little crooked."
msgstr "阿比盖尔，蝴蝶结歪了一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Wendy's over there, I'll go with you."
msgstr "温蒂在那边，我陪你一起过去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Feeling better? Wendy was just looking for you."
msgstr "精神好些了？温蒂刚才还在找你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "You two sisters are never lonely, even when nobody's talking."
msgstr "你们姐妹在一起，连不说话的时候也不冷清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Fly slower, your bow can't keep up."
msgstr "飞慢一点，蝴蝶结都跟不上你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "It's really good she's got you."
msgstr "有你陪着她，真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "The flower Wendy always carries."
msgstr "温蒂一直带着的花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Something's moving by the flower."
msgstr "花旁边有东西在动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Wendy, you'd better hold it."
msgstr "温蒂，还是你来拿吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Doesn't have much energy today."
msgstr "今天没什么精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "The petals have opened a bit more. She's getting better."
msgstr "花瓣又展开一点了。她在好起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "She's in good spirits today."
msgstr "她今天很有精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Looking at it too long makes me feel a bit sick."
msgstr "看久了有点难受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's a little unsettling."
msgstr "有点不安。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Feels like something's about to come out."
msgstr "好像有什么要出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "That definitely wasn't moving a second ago."
msgstr "刚才明明还没动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "It had better really just be a statue."
msgstr "最好真的只是一尊雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Another trial? Let's read the rules first."
msgstr "又要试炼？先看看规则。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Someone keeps track of this stuff?"
msgstr "做这些也有人记下来？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN"
msgid "Bury it, and it's still a long wait."
msgstr "埋下去还得等很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN_COOKED"
msgid "Roasted pretty well."
msgstr "烤得还行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ACORN_SAPLING"
msgid "I'll have graduated by the time it's grown."
msgstr "等它长大，我都毕业了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ADVENTURE_PORTAL"
msgid "Go in, and it's more adventuring?"
msgstr "进去还得再冒险？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIANHAT"
msgid "Wear it, and quiet's no longer an option."
msgstr "戴上以后，想安静也不行了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Just one shard and it's still this bright."
msgstr "就这么一片也很亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's locked up so they can drain its energy."
msgstr "它被关起来抽取能量了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "First round's over."
msgstr "第一回合结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "How many more times do I have to fight this?"
msgstr "这种东西还要打几次？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "Met it again, and it's more trouble than last time."
msgstr "又遇到了，比上次更麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "That must be the one we're looking for."
msgstr "这应该就是要找的那一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Can it stop now?"
msgstr "这回能停了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Knew it wasn't over."
msgstr "果然还没结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Don't step on it, it's sharp."
msgstr "别踩，尖的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "Another round."
msgstr "还要再来一轮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Don't go near yet, make sure first."
msgstr "先别靠近，确认一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "That ball of energy hasn't gone away yet."
msgstr "那团能量还没散。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Get close and you get sleepy. Have to go around."
msgstr "一靠近就困，得绕开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "How is there another round!"
msgstr "怎么还有下一轮！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AMULET"
msgid "One more chance. Hopefully I won't need it."
msgstr "多一次机会，最好用不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCHOR"
msgid "Once it's parked, I can rest."
msgstr "停稳了就能休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCHOR_ITEM"
msgid "Gotta install it myself too."
msgstr "还要自己装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Gems growing on trees is about normal here."
msgstr "树上结宝石，这里倒也正常。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "It's still moving... I don't want to eat it."
msgstr "还在动……我不想吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "At least it's not moving now."
msgstr "至少现在不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Even gems can grow on trees."
msgstr "宝石也能长在树上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "All picked. Just a stump."
msgstr "采完了，只剩树桩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Being near this tree feels weird."
msgstr "靠近这棵树总觉得不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "All chopped."
msgstr "砍完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Looks like there's a long wait yet."
msgstr "看起来还要等很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Wrong season. No use rushing."
msgstr "季节不对，急也没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Have to find different ground."
msgstr "还得换块地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Gotta find a good spot to plant it."
msgstr "得找个合适的地方栽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENTTREE_SEED"
msgid "You'll only know what it is once it's planted."
msgstr "种下去才能知道长什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ALTAR"
msgid "Still working after all these years. More reliable than the school's water fountain."
msgstr "用这么多年还没坏，比学校的饮水机可靠多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It's broken. And I just complimented it."
msgstr "坏了。刚才还夸过它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_HUSK"
msgid "What on earth happened here."
msgstr "这里以前到底发生过什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANCIENT_STATUE"
msgid "Just looking at it makes me uneasy."
msgstr "看着就不太舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANIMAL_TRACK"
msgid "Follow them, and it's another long walk."
msgstr "顺着走，又是一段路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTCHOVIES"
msgid "Can I not eat this?"
msgstr "我能不吃这个吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.GENERIC"
msgid "Here to collect again."
msgstr "又来收东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.UNHAPPY"
msgid "Doesn't look easy to deal with."
msgstr "看着就不好应付。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Should be quiet for a few days now."
msgstr "这下应该能安静几天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLIONHAT"
msgid "Wear it, and you're on digging duty too."
msgstr "戴上还得负责刨地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ANTLIONTRINKET"
msgid "Someone might want this toy."
msgstr "这玩具或许有人想要。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "Why is there fighting in a library."
msgstr "图书馆里为什么还要打架。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Finally stopped."
msgstr "总算停下来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Even the pot burned away."
msgstr "锅都烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It'll be a long wait yet."
msgstr "还得等很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost done."
msgstr "快好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "It's ready? Hold on, did anyone actually put ingredients in here?"
msgstr "做好了？先等等，这里真的放过食材吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Nothing but ash inside."
msgstr "里面全是灰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "The knowledge is inside. Now I have to figure out how to open it."
msgstr "知识装在里面，还要想办法打开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Standing here won't get someone to solve it for me."
msgstr "站这里也不会有人替我解题。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "No power, can't get anything out."
msgstr "没能源，什么也取不出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "The people here really liked the moon."
msgstr "这里的人很喜欢月亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Another puzzle. Can't it just give it to me?"
msgstr "又要解谜，不能直接给我吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Everything else moved, and this still does nothing."
msgstr "其他东西都动了，它还是没反应。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It's been shut down for a long time."
msgstr "已经停用很久了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Just follow it."
msgstr "跟着它走就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "This area's all searched."
msgstr "附近已经找完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "A finder. If I'd had this sooner, I wouldn't have lost my homework."
msgstr "寻物仪。早点有这个，我的作业也不会丢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Can't read it, don't want to copy it."
msgstr "看不懂，不想抄。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "The letters look different from the ones outside."
msgstr "字形和外面的不一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "No footnotes here either."
msgstr "这里也没有注释。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Need someone to translate."
msgstr "得找人翻译。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "I'm dropping this class."
msgstr "这门课我放弃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Look around before touching it."
msgstr "碰它之前先看看周围。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Already shut down."
msgstr "已经停机了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Follow this light."
msgstr "跟着这道光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "Still missing a gem."
msgstr "还缺宝石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "Put the gems in right and it works."
msgstr "宝石放对了就能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORDRAGONFLY"
msgid "Won't this be hotter in summer?"
msgstr "夏天穿不会更热吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORDREADSTONE"
msgid "Pretty light. Not tiring to wear."
msgstr "倒是挺轻，穿着不累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORGRASS"
msgid "As long as there aren't bugs in it."
msgstr "别有虫子就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORMARBLE"
msgid "How am I supposed to walk in this."
msgstr "穿这个还怎么走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORRUINS"
msgid "Lighter than it looks."
msgstr "比看起来轻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSKELETON"
msgid "Wearing bones. Still not used to it."
msgstr "穿着骨头，还是有点不习惯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSLURPER"
msgid "Wet and sticky. Do I have to wear it?"
msgstr "又湿又黏，非穿不可？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORSNURTLESHELL"
msgid "Hide in there and I don't have to deal with anyone."
msgstr "躲进去就不用应付外面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORWAGPUNK"
msgid "Well protected, and also buried in parts."
msgstr "护住了，人也快被零件埋了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMORWOOD"
msgid "Beats getting hit directly."
msgstr "总比直接挨打强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_BRAMBLE"
msgid "Don't poke yourself putting it on."
msgstr "穿的时候先别扎到自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_CARROTLURE"
msgid "Rabbits like this kind of getup?"
msgstr "兔子会喜欢这种装扮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Fix it up and I can keep wearing it."
msgstr "修好以后还能接着穿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Keep those spikes off me."
msgstr "别让那些尖刺碰到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_ROCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_ROCKY"
msgid "A bit heavy, but it blocks hits."
msgstr "穿着有点重，不过能挡住攻击。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_SANITY"
msgid "My body's fine, but my head starts hurting first."
msgstr "身体没伤着，头先疼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Light to wear, but it doesn't look very reassuring."
msgstr "穿着轻，就是看着不太安心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Better check if you can walk in it before putting it on."
msgstr "穿上去以前先试试能不能走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "The writing burned off too."
msgstr "字也烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "That way."
msgstr "往那边走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Who's gonna write it? My handwriting's bad."
msgstr "谁来写？我字不好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Just a charred piece of wood left."
msgstr "只剩一块焦木。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Read it. I know which way now."
msgstr "看过了，知道方向了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Nothing written yet."
msgstr "还没写字。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.GENERIC"
msgid "Sweeping again."
msgstr "又要打扫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eye bone didn't make it over."
msgstr "眼骨没能一起过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower burned up as soon as it came over."
msgstr "花过来就烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "What can't be brought over ends up like this."
msgstr "不能带过来的东西，最后就这样了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS"
msgid "Vegetables for dinner again?"
msgstr "晚饭又是蔬菜？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUSSOUP"
msgid "So bland it's overdoing it."
msgstr "清淡得有点过头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_COOKED"
msgid "At least it's cooked."
msgstr "至少煮熟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Gonna be eating asparagus for days."
msgstr "要连吃几天芦笋了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Have to start from seeds."
msgstr "还得从种子开始。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Building up energy."
msgstr "正在积蓄能量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It has to wait, and I want a break too."
msgstr "它要等，我也想歇会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Something's going to happen, get back."
msgstr "要出事了，离远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.OFF"
msgid "What's missing to start it?"
msgstr "差什么才能启动？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.ON"
msgid "It works now. Want to go now?"
msgstr "能用了，要现在走吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.RITUAL_SUMMONING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_GATE.RITUAL_SUMMONING"
msgid "Is it still not too late to get away?"
msgstr "现在离远一点还来得及吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_KEY"
msgid "Just holding it feels wrong."
msgstr "拿着就感觉不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "The lights aren't on yet."
msgstr "灯还没亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "This light makes me even less at ease."
msgstr "这光照着更不安心了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I don't recognize a single word of this."
msgstr "这些字一个也不认识。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_BAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_BAT.GENERIC"
msgid "Holding this is really uncomfortable."
msgstr "拿着这个实在不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_BAT.IN_RITUAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_BAT.IN_RITUAL"
msgid "It's set. Now what?"
msgstr "放好了，然后呢？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_ROCKY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_ROCKY.GENERIC"
msgid "A claw this big. Just put it down."
msgstr "这么大的钳子，先放好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_ROCKY.IN_RITUAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_ROCKY.IN_RITUAL"
msgid "It's set. Now what?"
msgstr "放好了，然后呢？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_WORM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_WORM.GENERIC"
msgid "Got what we need. Don't make me hold it forever."
msgstr "要用的东西拿到了，别让我一直拿着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_WORM.IN_RITUAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RITUAL_ORGAN_WORM.IN_RITUAL"
msgid "It's set. Now what?"
msgstr "放好了，然后呢？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "The people look hungry and afraid."
msgstr "人们看起来又饿又害怕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Too worn to make anything out."
msgstr "磨损得什么也看不清了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Something black covered the city."
msgstr "有黑色的东西覆盖了城市。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "They shed their skin, and what's inside changed."
msgstr "他们脱下皮，里面变了模样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "In the end they built a city this big."
msgstr "最后建成了这么大的城市。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ATRIUM_STATUE"
msgid "Stare too long and you start doubting your own eyes."
msgstr "看久了会怀疑自己的眼睛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.AXE"
msgid "Axe. Feels good, but it means more chores."
msgstr "斧头。手感不错，就是活多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "The little one's pretty cute."
msgstr "小的倒是很可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Quiet, don't wake it."
msgstr "轻一点，别吵它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BACKPACK"
msgid "Even my school bag isn't this much to carry."
msgstr "书包还不用背这么多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BACONEGGS"
msgid "Eggs with bacon, not bad. Wrap it in rice and it's an omelette rice."
msgstr "蛋配培根，不错。包上饭就是蛋包饭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAKUSAIGA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAKUSAIGA"
msgid "Looks really sharp. Stay away from the edge."
msgstr "看着就很锋利，离刃远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALATRO_MACHINE"
msgid "A few rounds. Nothing else to do anyway."
msgstr "打几局，反正没别的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOON"
msgid "Someone sells these after school, too."
msgstr "放学的时候也有人卖这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONHAT"
msgid "My hair's gonna stick straight up."
msgstr "头发会全翘起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONPARTY"
msgid "It even has little balloons inside."
msgstr "居然还套着小气球。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Just decoration now."
msgstr "现在只剩装饰用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Hold on to it and you walk a bit less."
msgstr "拿着能少走一会路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONS_EMPTY"
msgid "Blowing them up one by one uses all my words for the day."
msgstr "一个个吹起来，我今天的话就全用在这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BALLOONVEST"
msgid "Squeaks with every step, way too noisy."
msgstr "走一步响一下，太吵了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANABUSH"
msgid "So that's how bananas grow."
msgstr "香蕉原来还能这么长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANAJUICE"
msgid "Tastes pretty good."
msgstr "喝起来还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANANAPOP"
msgid "It's cold. Works for me."
msgstr "冰的，可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE"
msgid "Wrap up the wound first."
msgstr "先把伤口包起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Looks pretty, but it needs to stop the bleeding too."
msgstr "看着漂亮，也得能止血才行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLE"
msgid "Do I have to eat this."
msgstr "非要吃这个吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLEPITA"
msgid "Looks a lot better wrapped up."
msgstr "包起来以后顺眼多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "One look and I've lost my appetite."
msgstr "看一眼就没胃口了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLESUSHI"
msgid "One bite, then I'll decide."
msgstr "尝一口再决定。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLE_COOKED"
msgid "Cooked, and I still don't see what's good about it."
msgstr "熟了也看不出哪里好吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BARNACLINGUINE"
msgid "The pasta's alright, at least."
msgstr "意面倒是可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BASALT"
msgid "Tools can't even dent it. Walk around."
msgstr "工具都敲不动，绕路吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT.ACID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT.ACID"
msgid "Stay away, it'll eat through my clothes."
msgstr "离我远点，会把衣服腐蚀掉的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT.GENERIC"
msgid "Don't dive into my hair!"
msgstr "别往我头发里钻！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBAT"
msgid "A club made of bats. Not as good as my metal bat."
msgstr "蝙蝠做的棒子，没我的金属棒好使。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBOSSCAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBOSSCAVE.GENERIC"
msgid "Something seems to be in there. Don't go in yet."
msgstr "里面好像有东西，先别过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBOSSCAVE.VACANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATBOSSCAVE.VACANT"
msgid "Not in there. Perfect time to leave."
msgstr "不在里面，正好可以离开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATCAVE"
msgid "Tread lightly. Don't wake them."
msgstr "轻点走，别惊动它们。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATHBOMB"
msgid "Finally, a nice long soak."
msgstr "总算能好好泡一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSE"
msgid "Are we really keeping this?"
msgstr "这个真要留着？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSEHAT"
msgid "Why make drinking milk this complicated."
msgstr "非要把牛奶喝得这么麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATNOSE_COOKED"
msgid "Still don't want it roasted."
msgstr "烤过也不想吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_CONTAINER"
msgid "Full of sheet music. Is it as heavy as a school bag?"
msgstr "放满了乐谱，和书包一样重吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Sing it and how many fewer repairs?"
msgstr "唱完能少修几次武器？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Fireproofing. That's actually useful."
msgstr "能防火，倒是实用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Heal while singing, saves on medicine."
msgstr "边唱边治伤，省药了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "Lines that make you want to run when you hear them."
msgstr "听到就想跑的台词。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "You can sing someone back?"
msgstr "还能把人唱回来？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "I'm not reading those taunting lines."
msgstr "这种挑衅的话我不想念。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "A song for fighting shadows."
msgstr "用来对付暗影的歌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Singing together makes it less scary."
msgstr "一起唱就没那么怕了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Listening calms you down."
msgstr "听着能冷静下来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "A song for fighting the moon."
msgstr "用来对付月亮的歌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATWING"
msgid "Don't put that near my food."
msgstr "别放到我的饭旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BATWING_COOKED"
msgid "Still looks like a stretch."
msgstr "看起来还是很勉强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS.ACID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS.ACID"
msgid "It's hard enough to deal with already."
msgstr "它已经够难对付了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS.GENERIC"
msgid "A bat this big is tough to even dodge."
msgstr "这么大的蝙蝠，躲都不好躲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSSCORPSEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSSCORPSEHAT"
msgid "Are we really wearing this on our heads."
msgstr "真的要把这个戴在头上吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BAT_BOSS_SHADOW"
msgid "Still gotta fight it, like that?"
msgstr "变成这样了还要打？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARDHAIR"
msgid "Whose beard is this? Take it away."
msgstr "谁的胡子，拿走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGER"
msgid "So big. Dodge first."
msgstr "这么大只。先躲开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "Burn it, good. Just don't get back up."
msgstr "烧掉也好，别再起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Reeks. Stay back."
msgstr "味道很重，离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "It's not over?"
msgstr "还没结束？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERFUR_SACK"
msgid "Holds plenty, but it does smell a bit."
msgstr "能装不少，就是味道有点重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGERVEST"
msgid "Wearing it makes me sleepy."
msgstr "穿着就想睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEARGER_FUR"
msgid "Would make a warm winter coat."
msgstr "做件冬衣会很暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEAST_BLUEPRINT"
msgid "Clothes for a beefalo. Pretty over the top."
msgstr "给牛穿的，挺夸张。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEDROLL_FURRY"
msgid "I don't want to go out today."
msgstr "今天就不想出去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEDROLL_STRAW"
msgid "A bit scratchy, but at least I can lie down."
msgstr "有点扎，至少能躺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEE.GENERIC"
msgid "I won't go near you, so don't come over."
msgstr "我不靠近，你也别过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEE.HELD"
msgid "Just don't sting me."
msgstr "别蛰我就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.BURNT"
msgid "The honey's gone too."
msgstr "蜂蜜也没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.FULLHONEY"
msgid "It's full. Time to collect."
msgstr "装满了，该收了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.GENERIC"
msgid "If you want honey, you have to raise them yourself."
msgstr "想要蜂蜜还得自己养。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.NOHONEY"
msgid "Not a single drop."
msgstr "一滴都没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.READY"
msgid "There's honey to take."
msgstr "有蜂蜜可以拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Gotta wait a while longer."
msgstr "还要等一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Should tell her about this."
msgstr "得告诉她一声。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Nothing but honey in there."
msgstr "里面全是蜂蜜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Her bees are even busier than she is."
msgstr "她养的蜂，比她还忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Nothing to take for now."
msgstr "暂时没得拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Time to collect the honey."
msgstr "该收蜂蜜了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Hasn't built up enough yet."
msgstr "还没攒够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DEAD"
msgid "No more worrying about it ramming me."
msgstr "不用再担心它撞过来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "...Should've never brought you along."
msgstr "……早知道就不带你来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "At least it won't just headbutt me."
msgstr "至少不会随便顶我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Keep up, don't get lost."
msgstr "跟紧点，别走丢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.GENERIC"
msgid "Doesn't smell as bad from a distance."
msgstr "隔远一点就没那么臭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.MYPARTNER"
msgid "Let's go. I'm counting on you to carry me."
msgstr "走吧，还得靠你带我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.NAKED"
msgid "Shaved bald. Don't catch a cold."
msgstr "毛剃光了，别着凉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.ORNERY"
msgid "What a terrible temper."
msgstr "脾气也太差了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.PUDGY"
msgid "You eat a lot better than I do."
msgstr "你吃得比我好多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.RIDER"
msgid "Leaving the long walks to you."
msgstr "走远路就拜托你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO.SLEEPING"
msgid "It sure sleeps soundly."
msgstr "它倒是睡得很安稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOFEED"
msgid "That's for beefalo. Don't give it to me."
msgstr "这是牛吃的，别拿给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOHAT"
msgid "Warm, but it flattens my hair."
msgstr "暖和，就是头发会被压塌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOTREAT"
msgid "Smells okay, but it's still a beefalo snack."
msgstr "闻着还行，也只是牛的零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALOWOOL"
msgid "Gotta wash the smell out first."
msgstr "得先把味道洗掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Even the grooming spot burned down."
msgstr "连梳毛的地方都烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "The beefalo's not here yet."
msgstr "牛还没牵来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "What look today?"
msgstr "今天换个什么样子？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Find a roomy spot and set it up."
msgstr "找个宽一点的位置摆好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEF_BELL"
msgid "With this, the beefalo's willing to follow."
msgstr "有了它，牛就愿意跟着走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEGUARD"
msgid "You don't have to guard that hard, do you."
msgstr "不用保护得这么认真吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEHAT"
msgid "Messy hair beats a stung face."
msgstr "头发乱点，总比脸被蛰强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEHIVE"
msgid "You can hear it from way down the path."
msgstr "隔着一段路都听得到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEMINE"
msgid "Remember where you put it before you step on it."
msgstr "踩之前先记好放在哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEMINE_MAXWELL"
msgid "Noisy even through the jar."
msgstr "隔着瓶子都觉得吵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEEN"
msgid "Keep me away from that stinger."
msgstr "别让我靠近那根刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "My shoe soles are about to stick."
msgstr "鞋底都要黏住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "More of it's grown back."
msgstr "又长出来了一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Way bigger than before."
msgstr "比之前大得太多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEESWAX"
msgid "Saving it for candles."
msgstr "留着做蜡烛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEESWAX_SPRAY"
msgid "Makes decorations last a while longer."
msgstr "能让装饰多留一阵子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BEETLETAUR"
msgid "You can smell it before you get near."
msgstr "还没走近就闻到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BELL"
msgid "One ring's enough, don't overdo it."
msgstr "摇一下就行，别摇太多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_ACTIVE"
msgid "Willow's bear is walking on its own again."
msgstr "薇洛的熊又自己走起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_BIG"
msgid "Having it around means less to worry about."
msgstr "有它在就少担心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "Willow's gonna have to stitch that."
msgstr "得让薇洛缝一缝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "Burn marks all over."
msgstr "全是烧过的痕迹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES"
msgid "Have a few, it's not a real meal."
msgstr "先吃几个，不能当正餐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_COOKED"
msgid "Some sugar would help."
msgstr "加点糖会好一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_JUICY"
msgid "These are sweet. Eat them while they're fresh."
msgstr "这个甜，趁新鲜吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Gotta eat them quickly."
msgstr "要赶快吃掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.BARREN"
msgid "Still needs fertilizer."
msgstr "还得施肥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.BURNING"
msgid "The berries are burning too."
msgstr "果子也要烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's gotten really sick."
msgstr "已经病得很厉害了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.DISEASING"
msgid "The leaves don't look right."
msgstr "叶子看着不太对。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Could pick some for a snack."
msgstr "能摘一些当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.PICKED"
msgid "All picked, waiting again."
msgstr "摘完了，又要等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot, no berries."
msgstr "太热了，不长果子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "No fertilizer, no berries."
msgstr "不施肥就没果子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Quick, put it out before it all burns."
msgstr "快灭火，别全烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Can't keep this one."
msgstr "这棵不能留了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks like it's starting to get sick."
msgstr "好像开始生病了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I'll pick them when I'm hungry."
msgstr "想吃的时候再摘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Already picked today."
msgstr "今天已经摘过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Even this thing can't handle this weather."
msgstr "连它也受不了这天气。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BERRYSAUCE"
msgid "Could go with something else."
msgstr "可以配点别的吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIBINGKA"
msgid "This one's soft. Save me a piece."
msgstr "这个软，留一块给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIGFOOT"
msgid "Get out from under that foot!"
msgstr "快躲开那只脚！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRCHNUTDRAKE"
msgid "Even the nuts chase people down."
msgstr "果子也要追着人打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.DEAD"
msgid "...I need to remember to feed it next time."
msgstr "……以后得记得喂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Just missing a bird."
msgstr "还差一只鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "I know you're hungry, stop pecking the cage."
msgstr "知道你饿了，别啄笼子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "At least it doesn't have to go to school."
msgstr "至少不用上学。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Not even a feather left."
msgstr "连羽毛也没剩下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Don't bother it."
msgstr "别吵它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCAGE.STARVING"
msgid "Feed it soon or it'll be too late."
msgstr "再不喂就来不及了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.BURNING"
msgid "That really doesn't smell good."
msgstr "这个味道真不好闻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "It's dead, stop touching it."
msgstr "已经死了，别碰了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "It's clearly dead, how is it moving!"
msgstr "明明已经死了，怎么还会动！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRDTRAP"
msgid "Set it up, then wait."
msgstr "放好了就等着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_EGG"
msgid "For omelette rice."
msgstr "拿来做蛋包饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_EGG_COOKED"
msgid "Fried just right. Now a bit of rice."
msgstr "煎得刚好。再来点饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_MUTANT"
msgid "Something's wrong with this crow."
msgstr "这只乌鸦哪里不对劲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "It's aiming this way, dodge first."
msgstr "它在瞄准这边，先躲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP"
msgid "Don't fire at me."
msgstr "别对着我发射。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ow, didn't dodge in time."
msgstr "好痛，没躲开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Busted up like that and still going... stay away."
msgstr "坏成这样还不停……别过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLACKFLAG"
msgid "So you hang this up and you're a pirate?"
msgstr "挂上就算海盗了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_FIRE"
msgid "Don't use it near camp."
msgstr "别在营地旁边用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_LAVA"
msgid "Works from far away, too."
msgstr "站远一点也能打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_LAVA2"
msgid "Have to aim before you blow."
msgstr "得先瞄准再吹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_PIPE"
msgid "At least I don't have to get close."
msgstr "至少不用贴近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_SLEEP"
msgid "Breathing in by accident would be trouble."
msgstr "吸反了可就麻烦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLOWDART_YELLOW"
msgid "It shocks when it hits. Hold it steady."
msgstr "吹出去会带电。拿稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEAMULET"
msgid "Just right to wear when it's hot."
msgstr "热的时候戴着刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEGEM"
msgid "Cool to the touch."
msgstr "碰着凉凉的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEMOONEYE"
msgid "Put it here, and I don't have to find the way next time."
msgstr "放在这里，下次不用找路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEPRINT.COMMON"
msgid "More studying."
msgstr "还得学习。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUEPRINT.RARE"
msgid "Haven't seen this one before."
msgstr "这个倒是没见过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_CAP"
msgid "Better not eat this color raw."
msgstr "这种颜色的，还是别生吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_CAP_COOKED"
msgid "Have to be careful even once it's cooked."
msgstr "煮熟以后也得小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Mushrooms again."
msgstr "又是蘑菇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Not time to pick it yet."
msgstr "还没到采的时候。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Already picked."
msgstr "已经采完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARDS"
msgid "Nail them up and they work."
msgstr "钉起来就能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARON"
msgid "Being little doesn't mean you can charge at me."
msgstr "个子小也别冲我来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOARRIOR"
msgid "This huge, and I have to fight it?"
msgstr "这么大，还要我打？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT03"
msgid "The boat's in pieces."
msgstr "船都碎了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT04"
msgid "Keeping it won't put it back together."
msgstr "留着也拼不回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATFRAGMENT05"
msgid "This is all that's left."
msgstr "只剩这些了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATPATCH"
msgid "Hopefully I never need it."
msgstr "最好一直用不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATPATCH_KELP"
msgid "Plug it first, worry later."
msgstr "先堵住再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Go through here, got it."
msgstr "从这里过，记住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Gotta set up the checkpoints too."
msgstr "还得自己设检查点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Stop tailing my boat."
msgstr "别一直跟着我的船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK"
msgid "Don't crash into it."
msgstr "别撞上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Monkeys setting things up even at sea."
msgstr "猴子连海上都要布置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Adds obstacles to the course."
msgstr "给赛道添障碍的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Remember where you put it down."
msgstr "放下去可得记住位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Thanks, you're more excited than I am."
msgstr "谢谢，你比我还兴奋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_START"
msgid "Start here, finish fast."
msgstr "从这里开始，尽快跑完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Have to set the start line first."
msgstr "得先把起点设好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Cargo goes in here."
msgstr "货物能装这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "A boat this old, can it really be trusted?"
msgstr "这么旧的船，真的靠得住？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Softens the blow when you crash."
msgstr "撞到的时候能挡一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Adds a layer of protection to the hull."
msgstr "给船沿加层保护。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_KELP"
msgid "A bit soft, but better than a direct hit."
msgstr "软一点，总比直接撞强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Put it on the side of the boat first."
msgstr "先装到船边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Shells are pretty sturdy."
msgstr "贝壳倒挺结实。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Another lap around the boat to install."
msgstr "又要沿着船装一圈。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Protect the boat before the race."
msgstr "比赛之前先护好船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Install it and then go race."
msgstr "装上再去参赛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Loaded. Let me cover my ears."
msgstr "装好了。我先捂耳朵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Still needs a cannonball."
msgstr "还差炮弹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Out of cannonballs."
msgstr "炮弹打完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_CANNON_KIT"
msgid "Still has to be assembled into a cannon."
msgstr "还要组装成大炮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_GRASS_ITEM"
msgid "This counts as a boat?"
msgstr "这也能当船？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ITEM"
msgid "Do we have to go out to sea."
msgstr "非得出海吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_LEAK"
msgid "Quit staring, patch it!"
msgstr "别看了，快补。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "The boat's started moving."
msgstr "船开始动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "At least it saves some rowing."
msgstr "至少能省点划船的力气。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Pulling the boat this way."
msgstr "正在把船引过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It calls to the magnet on the boat from here."
msgstr "在这里吸引船上的磁铁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Install it soon and I row less."
msgstr "早点装好就能少划几下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MSURFBOARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_MSURFBOARD"
msgid "Keeping steady standing on it, impressive."
msgstr "站在上面还能稳住，真厉害。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROTATOR"
msgid "Makes turning easy, at least."
msgstr "转向倒是方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Put it on the boat, then try it."
msgstr "装到船上再试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "Warm to hug, but wash the smell out first."
msgstr "抱着暖和，味道先洗一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_KELP"
msgid "How would you sleep hugging something that wet."
msgstr "湿成这样怎么抱着睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_PETALS"
msgid "This one smells pretty good."
msgstr "这个闻着还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Who would want to sleep on this."
msgstr "谁会想枕着这个睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOMB_LUNARPLANT"
msgid "Don't throw it at your feet."
msgstr "别在脚边扔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood, don't put that next to me."
msgstr "沃姆伍德，这个别放在我旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESHARD"
msgid "Bone chips. Store them separately."
msgstr "碎骨头，收起来也得单独放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESOUP"
msgid "Warly made it, so the taste should be fine."
msgstr "沃利做的，应该不用担心味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BONESTEW"
msgid "Filling, and it tastes alright."
msgstr "够吃饱，味道也过得去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOKSTATION.BURNT"
msgid "No books to borrow today."
msgstr "今天没书可借了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Even here you have to go to the library."
msgstr "到了这里还得进图书馆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BEES"
msgid "Reading it summons bees? I'm not reading it."
msgstr "看了会把蜜蜂叫来？我不看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BIRDS"
msgid "Extracurricular reading about birds."
msgstr "鸟类的课外读物。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_BRIMSTONE"
msgid "Not one to read aloud casually."
msgstr "这本可不能随便念。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_ELEMENTAL"
msgid "Can't even read the words."
msgstr "字都看不懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FIRE"
msgid "Better have water ready before reading this."
msgstr "看这本得先准备水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FISH"
msgid "So no more waiting to fish?"
msgstr "能不用等着钓鱼了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_FOSSIL"
msgid "Can make them hold still for a while."
msgstr "能让它们暂时别动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_GARDENING"
msgid "Easier than planting one by one myself."
msgstr "比自己一棵棵种省事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_HORTICULTURE"
msgid "Finish reading and the vegetables are grown?"
msgstr "读完菜就长好了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "The sooner they grow, the sooner I eat."
msgstr "早点长好，就能早点吃饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_LIGHT"
msgid "No more carrying torches."
msgstr "不用再拿火把了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "This one shines longer."
msgstr "这本能照得更久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_MOON"
msgid "You can even change the moon's phase with a book."
msgstr "连月相也能用书改。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RAIN"
msgid "I don't want to get rained on any more."
msgstr "我可不想多淋一场雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Librarians look things up even to craft."
msgstr "图书管理员连制作都要查书。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_SILVICULTURE"
msgid "Makes trees grow faster."
msgstr "能让树快点长好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_SLEEP"
msgid "Just opening it makes me sleepy."
msgstr "才翻开就开始困了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_TEMPERATURE"
msgid "If only the weather were a bit nicer."
msgstr "天气舒服点就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_TENTACLES"
msgid "The cover alone makes me not want to open it."
msgstr "看封面就不想翻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOK_WEB"
msgid "Finish reading and then I have to clean up spiderwebs?"
msgstr "读完还要清蜘蛛网？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOMERANG"
msgid "After throwing it, you still have to catch it yourself."
msgstr "扔完还得自己接住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BOOTLEG"
msgid "Only one boot."
msgstr "只有一只靴子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It's still fixable, keep it for now."
msgstr "还能修，先留着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Have to reheat it to fix it."
msgstr "还要重新加热才能修。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BRUSH"
msgid "I can't even be bothered to brush my own hair, and now a beefalo's."
msgstr "自己头发都懒得梳，还要给牛梳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUGNET"
msgid "More running around."
msgstr "又要跑来跑去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "There's kelp growing down there."
msgstr "下面长着海带。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Already harvested here."
msgstr "这里已经采过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BULLKELP_ROOT"
msgid "Plant it in water."
msgstr "要栽到水里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNDLE"
msgid "Open it when it's needed."
msgstr "要用的时候再拆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNDLEWRAP"
msgid "Bundled up, it won't spoil so easily."
msgstr "捆好就不容易坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNNYMAN"
msgid "Don't let it see meat."
msgstr "别让它看到肉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUNNYSTEW"
msgid "Stew it till soft, then bring it over."
msgstr "炖软了再端上来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "The thorns burned too."
msgstr "刺也烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUSHHAT"
msgid "Wear it and I talk to fewer people."
msgstr "戴上就能少和别人说话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTER"
msgid "Should be good on bread."
msgstr "配面包应该不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Watching it fly kills some time."
msgstr "看看它飞，倒能消磨一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLY.HELD"
msgid "Okay, no more keeping you. Go."
msgstr "好啦，不关着你了。走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Don't tell me what's in there."
msgstr "别告诉我里面放了什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUTTERFLYWINGS"
msgid "Looks better on a butterfly."
msgstr "还是长在蝴蝶身上好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARD"
msgid "Don't stare at my food."
msgstr "别盯着我的食物。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "That really doesn't smell good."
msgstr "这个味道真不好闻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "It's dead, stop touching it."
msgstr "已经死了，别碰了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "It's clearly dead, how is it moving!"
msgstr "明明已经死了，怎么还会动！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CABBAGEROLLS"
msgid "There's meat wrapped inside, not bad."
msgstr "里面包了肉，还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS.GENERIC"
msgid "If you want to eat it, you get pricked first."
msgstr "想吃还得先挨扎。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS.PICKED"
msgid "All picked, but the spines are still there."
msgstr "摘完了，刺倒还在。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_FLOWER"
msgid "Looks pretty nice growing here."
msgstr "长在这里倒挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_MEAT"
msgid "Get all the spines out first."
msgstr "先把刺处理干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Now I can eat it."
msgstr "这回总能吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CALIFORNIAROLL"
msgid "I could eat a few more of these."
msgstr "这个可以多吃几个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Almost out."
msgstr "快灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I'll just stay near it."
msgstr "待在旁边就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.HIGH"
msgid "Too big! No more wood!"
msgstr "火太大了！别再加柴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.LOW"
msgid "More wood again."
msgstr "又得添柴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Just right. I'll sit a while."
msgstr "正好，坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAMPFIRE.OUT"
msgid "Have to relight it."
msgstr "得重新点火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY.GENERIC"
msgid "Yellow, really stands out."
msgstr "黄色的，挺显眼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY.HELD"
msgid "Careful with it, don't squeeze."
msgstr "小心点拿，别捏着它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANARY_POISONED"
msgid "It's nearly done for. Take it above ground first."
msgstr "它快不行了，先带回地面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANDYBAG"
msgid "Good for holding candy."
msgstr "拿来装糖果就很合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANE"
msgid "Makes walking a bit faster, take it."
msgstr "走路能快一点，拿着吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Don't drop it on your foot."
msgstr "别砸到脚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "My ears are still ringing."
msgstr "耳朵还在响。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Warn me before it goes off."
msgstr "要响以前先说一声。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Have to put the fireworks cannon together myself."
msgstr "还要自己把礼炮装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "A bit better looking than classroom decorations."
msgstr "比教室布置好看一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Even have to set up the fair myself."
msgstr "连游园会也要自己布置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Watching it spin a few times is enough."
msgstr "看它转几圈就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Won't know what it is till I open it."
msgstr "拆开才知道是什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Another duplicate."
msgstr "又是重复的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "This one was finally worth the trade."
msgstr "这个总算没白换。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Not too common, this one."
msgstr "这款不太常见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Just opening one."
msgstr "就开一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Will there be a new one this time."
msgstr "这回会不会有新款。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON3"
msgid "Let's open it. No duplicates this time, please."
msgstr "拆开看看，这次别再重复了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "Saving it for night."
msgstr "留着晚上用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Have to set up even the lamp myself."
msgstr "灯也得自己装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "A little potted plant, no real upkeep."
msgstr "小小一盆，倒不用太费心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Open it, then set it out."
msgstr "拆开再摆好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "You have to chew while you drink?"
msgstr "喝的时候还要嚼？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "It's for the chicks."
msgstr "给小鸟吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Set up the bird-feeding game first."
msgstr "先把喂鸟游戏搭起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "Chicks come out of here."
msgstr "小鸟从这里出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "Costs a token to play once."
msgstr "玩一次还要代币。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Feed them one by one."
msgstr "一个个喂过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "Don't roll far, I'm not chasing it."
msgstr "别滚远了，我不想追着捡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "It's just golf, no need to grip that tight."
msgstr "只是打球，用不着握那么紧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "Setting up the course yourself takes a lot of time too."
msgstr "自己摆场地也得花不少时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "Start with the easy one."
msgstr "先从简单的开始。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "Just so you know, don't rush me if I miss."
msgstr "先说好，打不进也别催我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
msgid "This difficulty should be alright."
msgstr "这个难度应该还行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_CUTOUT"
msgid "Right in the way, of course."
msgstr "正好挡在前面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "Even have to mind the wind just to hit a ball."
msgstr "连打个球都要看风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
msgid "Have to go around."
msgstr "还得绕过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
msgid "Hold on, can't get through yet."
msgstr "等一下，现在还过不去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
msgid "It spins so much it's making me dizzy."
msgstr "它转得我都快看晕了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
msgid "Don't bounce the ball somewhere I can't find it."
msgstr "别把球弹到找不着的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLFPROP_WORMHOLE"
msgid "The ball can go through, I'm not."
msgstr "球能过去就行，我可不进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
msgid "Get it in here and you're done."
msgstr "进了这里就算完成了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
msgid "Set up the hole first."
msgstr "球洞先摆好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
msgid "Have to find a token first."
msgstr "还得先找代币。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.INACTIVE"
msgid "Can't play yet, set up the course first."
msgstr "还不能玩，先把场地弄好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE.PLAYING"
msgid "My turn, don't block me."
msgstr "轮到我了，别挡着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_GOLF_TEE_KIT"
msgid "Tee off from here."
msgstr "从这里开始打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Don't run around, get back."
msgstr "别乱跑，回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Set it up, then you can herd chicks."
msgstr "搭好才能赶小鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "Pay the token first."
msgstr "先付代币。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Harder to herd than I thought."
msgstr "比想的还难赶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "Flip it over and you'll know."
msgstr "翻开就知道了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "It's definitely this one."
msgstr "肯定是这张。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "A memory game beats memorizing textbooks."
msgstr "记忆游戏，总比背课文好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "A round to kill some time."
msgstr "玩一局消磨时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Hold on, I still remember."
msgstr "等一下，我还记得。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "Shouldn't be hard to set up."
msgstr "这个搭起来应该不难。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "Tokens again."
msgstr "又要代币。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "Where it lands is pure luck."
msgstr "落在哪里全靠运气。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "Haven't paid, pressing it won't help."
msgstr "还没付钱，按了也没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Let's try pressing it."
msgstr "按下去试试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "A shooting game. Set it up and play once."
msgstr "打靶的游戏，装好玩一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "Buy a round first."
msgstr "先买一局。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Aim, then shoot."
msgstr "瞄好了再打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "Targets pop up from here."
msgstr "靶子会从这里冒出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Quit moving around."
msgstr "别动来动去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "Even have to build the wheel myself."
msgstr "转盘也要自己搭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "Give it a token and it spins."
msgstr "给个代币就能转。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Don't stop on the worst one."
msgstr "别停在最差的那格。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_BALL"
msgid "Kicking it around passes the time."
msgstr "踢几下也能打发时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_CROWKID"
msgid "Don't you kids have school?"
msgstr "你们不用上学？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "One more. Last one."
msgstr "再玩一次。最后一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_HOST"
msgid "Is the host always this energetic."
msgstr "主持人一直这么精神吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Not set up yet."
msgstr "还没布置好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "A few more decorations and it's about there."
msgstr "再加一些装饰就差不多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "Now it looks like a fair."
msgstr "这回像游园会了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Plant this tree first."
msgstr "先种下这棵树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "A few tickets short of the one I want."
msgstr "想换的那个还差几张券。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I have to build the prize booth too?"
msgstr "奖品的摊子也要我搭？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "One. Have to save up more."
msgstr "一张，只能再攒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Enough for something good!"
msgstr "够换好东西了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Enough for some little things."
msgstr "能换点小东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "Chicks eat this. I want something else."
msgstr "小鸟吃这个，我要别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_A"
msgid "A change of clothes isn't bad."
msgstr "换件衣服也好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_B"
msgid "Wearing it keeps me a bit cooler."
msgstr "穿着能凉快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARNIVAL_VEST_C"
msgid "Check for bugs inside first."
msgstr "先检查里面有没有虫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "So sharp it hurts just to look at."
msgstr "锋利得看着就疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "No more making furniture."
msgstr "家具也做不成了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Making my own furniture. Even after school wasn't this busy."
msgstr "自己做家具，放学也没这么忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.DEAD"
msgid "It stopped moving."
msgstr "不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.GENERIC"
msgid "Carrots that run on their own."
msgstr "胡萝卜还会自己跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.HELD"
msgid "Don't gnaw on stuff in my pocket."
msgstr "别在我口袋里啃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT.SLEEPING"
msgid "Pretty quiet when it's asleep."
msgstr "睡着倒挺安静。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Even ghosts join the race."
msgstr "幽灵也来参加赛跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT"
msgid "Are there any other vegetables?"
msgstr "有别的菜吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_COOKED"
msgid "Boil it soft and it's edible."
msgstr "煮软一点还能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_OVERSIZED"
msgid "How many meals of carrots is that."
msgstr "要吃多少顿胡萝卜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_PLANTED"
msgid "Pull it up and save the cost of a meal."
msgstr "拔起来就能省一顿饭的钱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARROT_SEEDS"
msgid "Waiting for it to sprout again."
msgstr "又要等它发芽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "The map's about to burn."
msgstr "地图要烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "All the routes are gone."
msgstr "路线全没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Draw the route so nobody else gets lost."
msgstr "把路线画下来，省得别人也迷路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOON"
msgid "Could watch it play for a while."
msgstr "可以看它玩一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONDEN.EMPTY"
msgid "No more residents."
msgstr "已经没有住客了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONDEN.GENERIC"
msgid "It lives inside the stump."
msgstr "它住在树桩里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATCOONHAT"
msgid "The ears on the hat are pretty cute."
msgstr "帽子上的耳朵倒挺可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CATTOY_MOUSE"
msgid "With this you can quit biting my stuff."
msgstr "有这个就别咬我的东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "This one can be moved. More work."
msgstr "这块能搬开，又要出力。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "Have to deal with what's underneath first."
msgstr "得先处理下面的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA"
msgid "Looks edible."
msgstr "看着还能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Not even the banana's left."
msgstr "连香蕉也没剩下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_COOKED"
msgid "This one's sweet, it's edible."
msgstr "这个甜，能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_BANANA_TREE"
msgid "No sun down here, and it still bears fruit."
msgstr "这里没太阳也能结果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE"
msgid "Have to move this rock to get down."
msgstr "搬开这块石头才能下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "Lines down there too."
msgstr "下面也要排队。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Can't go down right now."
msgstr "现在下不去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Get a light ready before going down."
msgstr "下去以前先准备灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "There's another level down there?"
msgstr "下面还有一层？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.FULL"
msgid "It's packed up on the surface too."
msgstr "地面也挤满了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Can't get back for now."
msgstr "暂时回不去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_EXIT.OPEN"
msgid "I want to go back to the surface."
msgstr "想回地面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_FERN"
msgid "Green leaves in a cave, even."
msgstr "洞里也有绿叶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_FERN_WITHERED"
msgid "All withered, it's way too hot here."
msgstr "都枯了，这里实在太热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "Finally stopped moving."
msgstr "终于不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Don't crawl on me."
msgstr "别爬到我身上来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Don't wake it, I don't want another fight."
msgstr "别吵醒它，我不想再打一场。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Venting again. Step back first."
msgstr "又在喷气，先退远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "That smell tells me not to stay long."
msgstr "闻起来就不适合久待。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "Quiet for now. Don't get too close."
msgstr "暂时没动静，别靠得太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Don't have to touch it to know it's hot."
msgstr "不用摸也知道烫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "The air's this bad, let's get out of here."
msgstr "空气这么糟，赶快出去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CEILING_ROPE"
msgid "If the rope's strong enough, I can climb up."
msgstr "绳子结实就能爬上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CEVICHE"
msgid "This serving's too small."
msgstr "这份太小了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARCOAL"
msgid "Touch it and my hands are black again."
msgstr "碰完手又黑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEARENA_SPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEARENA_SPIKE"
msgid "Have to keep watching my feet here."
msgstr "走路还得一直看着脚下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEARENA_TELEPORTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIEARENA_TELEPORTER"
msgid "Have you got everything? Don't come back for it again."
msgstr "东西都带上了吧，别又回来拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_BOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_BOSS"
msgid "There's really no avoiding this one now."
msgstr "这次真的没法避开了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_HAND"
msgid "Whatever it wants has got to be trouble."
msgstr "它想要的东西肯定很麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_HECKLER"
msgid "If you're watching the show, be quiet."
msgstr "看戏就安静一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_LECTURN"
msgid "I have to go on stage and read lines too?"
msgstr "还要上台念台词？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.GENERIC"
msgid "Charlie... is it really her?"
msgstr "查理……真的是她？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.SCENE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.SCENE2"
msgid "What is she trying to do."
msgstr "她到底想做什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.SCENE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_NPC.SCENE3"
msgid "I'd like to know when she's going to stop."
msgstr "我想知道她什么时候才会停下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHARLIE_STAGE_POST"
msgid "No rush to get on stage."
msgstr "先别急着上台。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK1"
msgid "Parts of a broken chess piece."
msgstr "坏棋子的零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK2"
msgid "A pile here, too."
msgstr "这里也堆了一批。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSJUNK3"
msgid "Just how many have broken."
msgstr "到底坏过多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Just looking at it, I know I can't lift it."
msgstr "光看着就觉得搬不动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ANTLION"
msgid "At least this one won't nag me for tribute."
msgstr "这只至少不会催着收贡品。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BATBOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BATBOSS_SHADOW"
msgid "Just sit there. Don't actually fly."
msgstr "摆在这里就行，别真的飞起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Good thing it won't steal food."
msgstr "不会偷吃东西就很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Even the statue looks mean."
msgstr "连雕像也显得很凶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "No feeding, no grooming."
msgstr "不用喂，也不用梳毛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Doesn't sting. Safe to look at."
msgstr "不会蛰人，能放心看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A bishop chess piece, made of stone."
msgstr "主教棋子，石头做的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "It moved on its own, step back."
msgstr "它自己动了，退后。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Looks nice on display."
msgstr "这件摆着挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CARRAT"
msgid "A souvenir for winning the race."
msgstr "跑赢了才有的纪念。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CATCOON"
msgid "Is there a live one to pet?"
msgstr "没有活的可以摸吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CHARLIE_BOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CHARLIE_BOSS"
msgid "Looking at this reminds me of that rough fight."
msgstr "看着这个就想起那场苦战。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "This one had better stay still."
msgstr "这只最好一直别动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "Beat it, and now I have to haul its statue."
msgstr "打完还得搬它的雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Much easier to deal with than the real thing."
msgstr "比真的好应付多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Seeing it reminds me of that fight."
msgstr "看到它就想起那次打架。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "They even sculpted that pile of junk."
msgstr "连那堆破烂都雕进去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "Turn it around. Don't face it at my bed."
msgstr "换个方向，别朝着我的床。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "The eye's too noticeable."
msgstr "眼睛太显眼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "Never thought it'd get a statue."
msgstr "没想到还会给它做雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Better quiet."
msgstr "还是安静的比较好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Looking at me again."
msgstr "又在看我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_FORMAL"
msgid "All dressed up and standing around. Waiting for school to end too?"
msgstr "穿这么正式一直站着，你也在等放学吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "A quiet guardian is the best kind."
msgstr "安静的守卫者，最好看的守卫者。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Too bad what's inside isn't edible."
msgstr "可惜里面的不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KITCOON"
msgid "This one won't hide."
msgstr "这只不会藏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Put this up for the holidays and nobody will sleep."
msgstr "节日摆这个，晚上会睡不着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Somebody's got to move this horse too."
msgstr "这匹马也得有人搬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "I saw you move!"
msgstr "看见你动了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "As long as it doesn't flip boats."
msgstr "不会掀船就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Looks soft, feels like nothing but stone."
msgstr "看着软，摸着全是石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Finally staying quiet."
msgstr "终于能安静待着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MOON"
msgid "They even sculpted the moon."
msgstr "月亮也雕了一件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "They even got the expression the same."
msgstr "连表情都做得一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_MUSE"
msgid "I think I've seen this face."
msgstr "这张脸好像见过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_PAWN"
msgid "The least noticeable one."
msgstr "最不起眼的那一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_PIPE"
msgid "It can stay on display. I don't use it."
msgstr "摆着就好，我不用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROCKYBOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROCKYBOSS_SHADOW"
msgid "This one's finally not swinging its claws."
msgstr "这只总算不会挥钳子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It looks heavy."
msgstr "看着就很重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "It's about to move, don't stand in front."
msgstr "它要动了，别站前面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "At least this time there's no running on ice."
msgstr "这次总算不用在冰上跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SHROUDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_SHROUDEN"
msgid "I don't want to see a live one again."
msgstr "我可不想再见到活的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_STALKER"
msgid "Bones are better not moving."
msgstr "骨头还是不动比较好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "It doesn't stink now, so it can go on display."
msgstr "不臭了倒能摆出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "Both eyes are facing this way."
msgstr "两个眼睛都朝着这边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "Put here, it won't block the road."
msgstr "放在这里就不会挡路了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "After the fight, looking at the statue's plenty."
msgstr "打完以后看看雕像就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "They carved all those parts."
msgstr "这么多零件都刻出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Much nicer without that stench."
msgstr "没了那股臭气顺眼多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "Thinking about it, I still feel the ground shake."
msgstr "想起来还觉得地面在晃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WORMBOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_WORMBOSS_SHADOW"
msgid "Not so scary as a statue."
msgstr "做成雕像就没那么吓人了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTD"
msgid "A souvenir from the end of the race."
msgstr "比赛结束的纪念品。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTH"
msgid "This one looks nice beside it."
msgstr "这匹摆在旁边挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESSPIECE_YOTS"
msgid "Gold, and heavy to move too."
msgstr "金色的，搬起来也很重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER"
msgid "Carry this for me, please."
msgstr "帮我背着，拜托了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Bring it along and Chester follows."
msgstr "带着它，切斯特就会跟着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Its eye closed. Have to wait a while."
msgstr "眼睛闭上了，得等一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Finally, a few fewer chests to organize."
msgstr "终于能少整理几个箱子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Even chests can't leave me in peace!"
msgstr "箱子也不让人省心！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CHUM"
msgid "This is for the fish."
msgstr "这个留给鱼吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I knew it moved!"
msgstr "果然会动！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYHOUND.STATUE"
msgid "Looks way too alive."
msgstr "看着太像活的了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYWARG.GENERIC"
msgid "This big, and it chases people too."
msgstr "这么大还会追人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CLAYWARG.STATUE"
msgid "Did it just move?"
msgstr "刚才是不是动了一下？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.EMBERS"
msgid "Gotta add something quick."
msgstr "得赶紧添东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.GENERIC"
msgid "It gives light and isn't hot."
msgstr "能照明，还不热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.HIGH"
msgid "Too close gets cold."
msgstr "靠得太近会冷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.LOW"
msgid "Almost out of fuel."
msgstr "快没燃料了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.NORMAL"
msgid "This temperature's just right."
msgstr "这个温度刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIRE.OUT"
msgid "Out again."
msgstr "又灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "About to go out."
msgstr "马上就灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Sit here in summer."
msgstr "夏天坐这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A fire this big, and not hot at all."
msgstr "火这么大，却一点也不烫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.LOW"
msgid "Needs more fuel."
msgstr "得添燃料了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "So much cooler."
msgstr "凉快多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLDFIREPIT.OUT"
msgid "Can still relight it."
msgstr "还能重新点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COLLAPSEDCHEST"
msgid "The chest burst, everything fell out."
msgstr "箱子撑坏了，东西全掉出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "东。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.GENERIC"
msgid "Check directions first."
msgstr "先确认方向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "北。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "东北。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "西北。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "南。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "东南。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "西南。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOST"
msgid "For plants. Keep it away from food."
msgstr "给植物的，别往饭边放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "This'll do, no need to add more."
msgstr "这样就行，不用再加。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Smells even worse burned."
msgstr "烧完更难闻了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Too dry, add something wet."
msgstr "太干了，加点湿的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "You have to hold your breath even walking past."
msgstr "路过都得屏住呼吸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTINGBIN.WET"
msgid "Too wet, add something dry."
msgstr "太湿了，加点干的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COMPOSTWRAP"
msgid "Wormwood, just use it on plants."
msgstr "沃姆伍德，给植物用就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "After reading it, I still have to build it."
msgstr "看完还得照着做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKBOOK"
msgid "Just want to flip to the tasty pages."
msgstr "只想翻好吃的那几页。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMANDRAKE"
msgid "Cooked, and I still don't have much appetite."
msgstr "煮完也没多少胃口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMEAT"
msgid "Roasted just right."
msgstr "烤得刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Don't give it to me even cooked."
msgstr "熟了也别拿给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKEDSMALLMEAT"
msgid "This little isn't enough."
msgstr "这么一点，还不够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTER"
msgid "Don't bite our boat!"
msgstr "别咬我们的船！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTERHAT"
msgid "At least it keeps out rain."
msgstr "至少能挡雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKIECUTTERSHELL"
msgid "Its shell's pretty hard."
msgstr "它的壳还挺硬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Can the writing be a bit clearer."
msgstr "字能写清楚一点吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.BURNT"
msgid "Even the pot's gone. What are we eating?"
msgstr "连锅都没了，吃什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Why's it still taking so long."
msgstr "怎么还要这么久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost done, wait a sec."
msgstr "快好了，先等着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.DONE"
msgid "It's ready. Let me smell it first."
msgstr "好了，先闻一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOKPOT.EMPTY"
msgid "What's for dinner tonight?"
msgstr "今晚煮什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COOLANT"
msgid "It's coolant, don't grab the wrong one."
msgstr "这是冷却液，别拿错了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COONTAIL"
msgid "It's like that and still moving? Don't make me hold it."
msgstr "已经这样了还在动？先别让我拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN"
msgid "Cook it first, then eat."
msgstr "煮熟了再吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_COOKED"
msgid "This works as a snack."
msgstr "这个可以当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_OVERSIZED"
msgid "Definitely can't finish it in one meal."
msgstr "一顿肯定吃不完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CORN_SEEDS"
msgid "Gotta plant it to get corn."
msgstr "种下去才能有玉米。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Me, as a blacksmith?"
msgstr "我演铁匠？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_DOLL_BODY"
msgid "This costume's a little unsettling."
msgstr "这身看着有点不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Can I switch roles?"
msgstr "能换个角色吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_KING_BODY"
msgid "Even a king's costume is pretty heavy."
msgstr "国王的戏服也挺沉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Playing a mirror. No lines to memorize."
msgstr "演一面镜子。不用背台词。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Nice outfit, hopefully not too many lines."
msgstr "衣服不错，希望台词别太多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Wearing this means keeping my back straight the whole time."
msgstr "穿这个要一直挺直背。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COSTUME_TREE_BODY"
msgid "At least not too many lines to memorize."
msgstr "至少不用背太多台词。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Needs fuel."
msgstr "缺燃料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "Just the right amount of light."
msgstr "这点光正好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Still needs more."
msgstr "还得添东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Much nicer once it's lit."
msgstr "亮起来以后顺眼多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "No fuel, no light."
msgstr "没燃料就不亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Stare too long and my mind wanders."
msgstr "看久了有点走神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COTL_TRINKET"
msgid "A tiny little crown."
msgstr "小小一顶冠。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.COZY_BUNNYMAN"
msgid "Looks like it knows how to rest better than I do."
msgstr "看起来比我还会休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING.GENERIC"
msgid "Don't get too close to the boat."
msgstr "别靠船太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING.INERT"
msgid "Put gems in it and it reacts?"
msgstr "往里面放宝石就会有反应？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Have to dodge cannonballs even at sea."
msgstr "海上也得躲炮弹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_CLAW"
msgid "Don't let it pinch you."
msgstr "别让它夹到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_ICEWALL"
msgid "The path's blocked again."
msgstr "路又被挡住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_MOB"
msgid "Another bunch."
msgstr "又来了一群。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Shell's this thick, it's tiring to hit."
msgstr "壳这么厚，打着很费力。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTERLAB"
msgid "Any little guys in there?"
msgstr "里面有小家伙吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_BULBIN"
msgid "Stay small, don't grow too big."
msgstr "小小的就好，别长太大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_DRAGONLING"
msgid "The small one's way cuter than the big one."
msgstr "小的比大的可爱多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_EETS"
msgid "You can follow me, just don't run around."
msgstr "跟着我可以，别到处乱跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "You can look at me, just don't get close in the middle of the night."
msgstr "看着我可以，别半夜贴过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_GLOMLING"
msgid "Fly slower, don't lose me."
msgstr "飞得慢一点，别跟丢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_KITTEN"
msgid "Come here, sit with me for a bit."
msgstr "过来，陪我坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_LAMB"
msgid "At least it doesn't drip slime everywhere."
msgstr "还好不会到处滴黏液。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "I can see you even at night."
msgstr "晚上也能看清你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_PERDLING"
msgid "This one shouldn't steal berries."
msgstr "这只应该不会偷吃浆果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRITTER_PUPPY"
msgid "Stay with me. Don't copy the ones outside."
msgstr "跟着我，别学外面的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROW.GENERIC"
msgid "It's spacing out here too."
msgstr "它也在这里发呆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CROW.HELD"
msgid "Don't peck my hand."
msgstr "别啄我的手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CRUMBS"
msgid "Dropped all over. Who was eating?"
msgstr "掉得到处都是。谁负责吃的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Best not to take things like this."
msgstr "这种东西还是少拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTGRASS"
msgid "Put it away, I'll need it."
msgstr "收好了，还要用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLESS"
msgid "Don't get splinters in your hand."
msgstr "别让木刺扎到手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTLICHEN"
msgid "If there's anything else, I'm not eating this."
msgstr "有别的就别吃这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTREEDS"
msgid "Could be used to make paper."
msgstr "可以拿来做纸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.CUTSTONE"
msgid "Cut stone saves me some work."
msgstr "磨好了就省点工。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER.GENERIC"
msgid "Should've never unlocked it."
msgstr "早知道就别解开了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Being chained here all this time must be rough too."
msgstr "一直锁在这里也很难受吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.BURIED"
msgid "Trapped under junk."
msgstr "被破烂压住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Don't provoke him yet."
msgstr "先别惹他。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "He's not easy to talk to right now."
msgstr "他现在可不好说话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "This hard, I need a different tool."
msgstr "这么硬，得换工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "Something's glinting inside."
msgstr "里面有什么在闪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEADLYFEAST"
msgid "You can't eat this. Stay away."
msgstr "这道菜不能吃，离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEAD_SEA_BONES"
msgid "Sun-bleached bones."
msgstr "晒干了的骨头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "More wood going to waste."
msgstr "木头又要浪费了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Just charred wood."
msgstr "只剩焦木。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "All chopped, taking a break."
msgstr "砍完了，歇会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Looks nice in autumn."
msgstr "秋天看着还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Picked a few nuts and now it's mad?"
msgstr "摘点果子就生气了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECK_OF_CARDS"
msgid "Anyone want to play a round with me?"
msgstr "有人陪我打一局吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_CENTERPIECE"
msgid "The table's finally not so empty."
msgstr "桌上总算没那么空。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "The vase is still empty."
msgstr "花瓶还空着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It gives a bit of light at night too."
msgstr "晚上也能照一点光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "A bunch of flowers would be nice."
msgstr "摆束花也挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "The light's about to go out."
msgstr "灯快不亮了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Time to change the flowers again."
msgstr "又要换花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_LAMP"
msgid "Sitting here reading won't be too dark."
msgstr "坐这里看书不会太暗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Nice to look at on the wall."
msgstr "挂着看还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Hasn't been drawn yet."
msgstr "还没画好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "Looks nice like this."
msgstr "这样摆着挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER.ANTLER"
msgid "Those are some big antlers."
msgstr "角长得真大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER.GENERIC"
msgid "Can it see me?"
msgstr "它看得见我吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS"
msgid "Don't head for camp!"
msgstr "别往营地走！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Just don't get back up."
msgstr "别再起来就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "It's really down this time, right."
msgstr "这回真的倒下了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "How is it standing up again!"
msgstr "怎么又站起来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "Looking at it makes me a little cold."
msgstr "看得我有点冷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It's still missing an eye."
msgstr "上面还缺一只眼睛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Better be ready before installing this."
msgstr "装这个之前得先准备好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Don't hold it in front of my eyes."
msgstr "别拿到我眼前。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER_ANTLER"
msgid "This works as a key?"
msgstr "这个能当钥匙？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEER_GEMMED"
msgid "It's just being controlled too. Stay away."
msgstr "它也只是被控制了。离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "Even this bit of grass dried out."
msgstr "这点草也干掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESERTHAT"
msgid "At least the sand stops getting in my eyes."
msgstr "至少沙子不会再进眼睛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESICCANT"
msgid "With this, I don't have to worry about damp all the time."
msgstr "有了这个就不用总担心受潮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DESICCANTBOOSTED"
msgid "This should last longer."
msgstr "这份应该能用久一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVTOOL"
msgid "Picking it up saves me a lot of trouble."
msgstr "拿起来能省不少事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DEVTOOL_NODEV"
msgid "Can't lift it. Forget it."
msgstr "拿不动，算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIRTPILE"
msgid "Have to squat down to check."
msgstr "还得蹲下来查。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.COLD"
msgid "Still far."
msgstr "还远得很。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.GENERIC"
msgid "Take it to find the way."
msgstr "拿着它找路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.HOT"
msgid "Right nearby, I can hear it!"
msgstr "就在附近，听到了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.WARM"
msgid "Right direction."
msgstr "方向对了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGROD.WARMER"
msgid "Should be almost there."
msgstr "应该快到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Have to find a way to start it."
msgstr "得想办法开动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.READY"
msgid "Still missing a big key."
msgstr "还缺一把大钥匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Now it works."
msgstr "这下能用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DIVININGRODSTART"
msgid "Should come in handy."
msgstr "带着应该用得上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOCK_KIT"
msgid "Have to build the dock myself too."
msgstr "码头也得自己搭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Put these posts along the edge."
msgstr "沿边装这些柱子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DOLL_BLUEPRINT"
msgid "A cute outfit for the beefalo."
msgstr "给牛做一套可爱的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBOAT_KIT"
msgid "Have to assemble it to enter the race."
msgstr "装完才能参加比赛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBOAT_PACK"
msgid "At least the materials are all in there."
msgstr "至少材料都在里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONBODYHAT"
msgid "Have to walk together with the people in front and behind."
msgstr "还得和前后的人一起走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONCHILISALAD"
msgid "Less spice to start."
msgstr "先少放点辣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLY"
msgid "Stay away from it, it's really hot."
msgstr "离它远一点，真的很热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Finally, a chest that isn't scared of fire."
msgstr "终于有个不怕火的箱子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Now I don't have to build a few more."
msgstr "这样就不用再造几个了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Warm, but I still need a light at night."
msgstr "暖和，晚上却还得点灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Have to fix it first."
msgstr "得先修好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Too hot, back up."
msgstr "太烫了，后退。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Staying here all winter sounds good."
msgstr "冬天待在这里就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT"
msgid "Peel it and see."
msgstr "剥开看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Softer once it's cooked."
msgstr "煮熟以后软了一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "One of these makes a lot of pie."
msgstr "一个能做好多派。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Want pie, gotta plant first."
msgstr "想吃派还得先种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONHEADHAT"
msgid "You want me in front?"
msgstr "让我走最前面？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONPIE"
msgid "Save this for me."
msgstr "这份可以留给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGONTAILHAT"
msgid "Being last is good. No leading the way."
msgstr "在最后也好，不用带路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRAGON_SCALES"
msgid "Still warm to the touch."
msgstr "摸着还是热的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONE"
msgid "Just looking at this stone is unnerving."
msgstr "这石头看着就让人不安。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONEHAT"
msgid "It protects my head, so I'll wear it for now."
msgstr "能护住头就先戴着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DREADSTONE_STACK"
msgid "Still has to be mined from the crack."
msgstr "还得从裂缝里开采。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_LOG"
msgid "Dry it out before using it."
msgstr "晒干了再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Caught fire after all."
msgstr "还是烧起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Not much wood left."
msgstr "剩不下什么木料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Even the stump needs digging."
msgstr "树桩也得挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "A dead tree washed ashore."
msgstr "被冲上岸的枯树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRUMSTICK"
msgid "Roasting this tonight."
msgstr "晚上烤这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DRUMSTICK_COOKED"
msgid "Eat it hot, don't let it get cold."
msgstr "趁热吃，别放凉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BANANABUSH"
msgid "Plant it closer, less walking later."
msgstr "种近一点，以后少走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BERRYBUSH"
msgid "Taking it back to plant."
msgstr "带回去种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "Just right to plant beside camp."
msgstr "种在营地旁边刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_GRASS"
msgid "Find an empty patch and plant it."
msgstr "找块空地种下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_MARSH_BUSH"
msgid "Don't prick your hands planting it."
msgstr "种的时候别扎手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_MONKEYTAIL"
msgid "Find somewhere to plant it back."
msgstr "找个地方栽回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_SAPLING"
msgid "Can't keep it in my pocket forever."
msgstr "不能一直放口袋里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Flip it over and it can't be set."
msgstr "翻过来就装不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL"
msgid "Isn't gym class over yet."
msgstr "体育课还没结束吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Heavy and cold."
msgstr "又重又凉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_GEM"
msgid "I can't take this weight."
msgstr "这重量我可受不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_GOLDEN"
msgid "This much gold, and you made it all a dumbbell?"
msgstr "这么多金子，全做成哑铃？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_HEAT"
msgid "Gotta wipe off the sweat after working out."
msgstr "练完还得擦汗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_MARBLE"
msgid "Wolfgang, you take it."
msgstr "沃尔夫冈，你来拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUMBBELL_REDGEM"
msgid "Burns my hand when I lift it."
msgstr "举起来还烫手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN"
msgid "This smell... let me think about it."
msgstr "这个味道……我再考虑一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_COOKED"
msgid "Smells even stronger cooked."
msgstr "煮完味道更重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_OVERSIZED"
msgid "Keep it away from the dinner table."
msgstr "离饭桌远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DURIAN_SEEDS"
msgid "Don't plant it where I sleep."
msgstr "先别种在我睡的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMERINGUE"
msgid "Save this for the dust moths."
msgstr "这个留给尘蛾。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMOTH"
msgid "Much more diligent than me."
msgstr "比我勤快多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.DUSTMOTHDEN"
msgid "Finished cleaning, comes back here to rest."
msgstr "打扫完就回这里休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EARMUFFSHAT"
msgid "Nice and warm. I can't hear anything."
msgstr "暖乎乎的。听不见了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EEL"
msgid "Cook it into something good."
msgstr "做得好吃一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EEL_COOKED"
msgid "Smells pretty good."
msgstr "闻着还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT"
msgid "Is there anything else for dinner?"
msgstr "晚饭还有别的吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_COOKED"
msgid "Just don't only boil it."
msgstr "别只用水煮就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "How long's it gonna take to slice this."
msgstr "这得切多久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EGGPLANT_SEEDS"
msgid "Another packet to plant."
msgstr "又一包要种的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ELIXIR_CONTAINER"
msgid "It's all medicine for ghosts in here."
msgstr "里面都是给幽灵用的药。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EMBERLIGHT"
msgid "No need to add wood. Great."
msgstr "不用添柴，太好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.BURNT"
msgid "Table and flowers both gone."
msgstr "桌子和花都没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.EMPTY"
msgid "It's still missing something on top."
msgstr "上面还缺点东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A little light, just right."
msgstr "有一点光，刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.GENERIC"
msgid "Sitting beside it spacing out's not bad."
msgstr "坐旁边发呆也不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Needs a new light source."
msgstr "得换新的发光材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ENDTABLE.WILTED"
msgid "Time to change the flowers."
msgstr "花该换了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.BURNING"
msgid "It's burning, don't go near."
msgstr "烧起来了，别靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.BURNT"
msgid "Just charred wood."
msgstr "只剩焦木。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.CHOPPED"
msgid "This tree's chopped."
msgstr "这棵砍完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN.GENERIC"
msgid "More tree chopping."
msgstr "又得砍树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Couldn't avoid the fire after all."
msgstr "还是没躲过火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Pitch black."
msgstr "黑漆漆的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Got all the wood I can."
msgstr "能收的木头都收了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Not even a pinecone."
msgstr "连松果都没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEBRELLAHAT"
msgid "Great at keeping off rain. Let's not talk about how it looks."
msgstr "挡雨很好，样子就不提了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEMASKHAT"
msgid "Don't let anyone see me eating with this on."
msgstr "戴着吃东西的样子别让人看到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR"
msgid "At least the target's obvious."
msgstr "目标倒是很明显。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI"
msgid "Don't crowd around staring at me."
msgstr "别围着我看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "While it hasn't hatched yet."
msgstr "趁它还没孵出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYEPLANT"
msgid "Even the flowers on the ground are staring at people."
msgstr "连地上的花都在看人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYETURRET"
msgid "Get it right, don't shoot me."
msgstr "认清楚，别打我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.EYETURRET_ITEM"
msgid "Set it up and it guards camp."
msgstr "摆好就能守着营地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.BURNT"
msgid "Even the soil's burned."
msgstr "连地都烧坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.GENERIC"
msgid "Gotta plant vegetables too."
msgstr "还得种菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.GROWING"
msgid "Growing way too slow."
msgstr "长得还是太慢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "More fertilizer."
msgstr "又要施肥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_HOE"
msgid "Hoe. An iron one's easy to hold."
msgstr "锄头。铁的拿着顺手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.BURNING"
msgid "Put the fire out first, dinner's in there."
msgstr "先灭火，晚饭还在里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL"
msgid "Finally ready to pick."
msgstr "终于能摘了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "This harvest'll last a long time."
msgstr "这回收的够吃很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "All that care, and it's a weed."
msgstr "照顾了半天，居然是杂草。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Can't tell what it is yet."
msgstr "暂时认不出是什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.GROWING"
msgid "Not fully grown yet."
msgstr "还没长好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Forgot to harvest. All rotten."
msgstr "忘了收，全坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "One this big, all wasted."
msgstr "这么大一个，全浪费了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLANT.SEED"
msgid "Waiting for it to sprout."
msgstr "等发芽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLOW"
msgid "If only it would till for me."
msgstr "它能替我翻土就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_PLOW_ITEM"
msgid "Pick a spot, then put it down."
msgstr "选好地方再放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Clear this away first."
msgstr "先把这些清掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERFAN"
msgid "Finally, I can cool off a bit."
msgstr "终于能凉快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERHAT"
msgid "Too flashy to wear."
msgstr "戴着太显眼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHERPENCIL"
msgid "Pretty feather, but a normal pen's easier to write with."
msgstr "羽毛很漂亮，写字还是普通笔省事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_CANARY"
msgid "A yellow feather."
msgstr "黄色的羽毛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_CROW"
msgid "A black one. I'll keep it."
msgstr "黑色的，收着吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_ROBIN"
msgid "A nice shade of red."
msgstr "红得挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Easier to find in winter."
msgstr "冬天才容易捡到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FEM_PUPPET"
msgid "Have to find a way to let her out."
msgstr "得想办法把她放出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE"
msgid "Once it's fenced, no more wandering off."
msgstr "围好以后别再乱跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Not linked yet, no rush to try it."
msgstr "还没接上，先别忙着试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "It's electrified, keep away."
msgstr "已经通电了，离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "Just don't fence yourself in after setting it up."
msgstr "摆好以后别把自己也拦住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_GATE"
msgid "Remember to close it on the way out."
msgstr "出门记得关。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_GATE_ITEM"
msgid "Still have to put a gate in at the end."
msgstr "最后还得装一道门。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ITEM"
msgid "How big of a circle?"
msgstr "要围多大一圈？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_JUNK"
msgid "If it blocks things, I'll use it for now."
msgstr "能挡住就先用着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FENCE_ROTATOR"
msgid "If it can adjust direction, no need to rebuild."
msgstr "能调整方向就省得重装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FERTILIZER"
msgid "Don't put that next to me."
msgstr "别放在我旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FESTIVEFISH"
msgid "Eat something good for the holiday."
msgstr "过节能吃点好的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Even the beefalo gets a change of clothes for the holiday."
msgstr "牛也要过节换衣服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIG"
msgid "Let me try one."
msgstr "尝一个看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIGATONI"
msgid "Who knew pasta and figs could go together."
msgstr "意面和无花果居然能配。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIGKABAB"
msgid "Just keep a good grip on the skewer."
msgstr "把签子拿稳就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIG_COOKED"
msgid "Cooked, it's a little sweeter."
msgstr "熟了，味道更甜一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREBALLSTAFF"
msgid "Have to watch overhead too."
msgstr "头顶也得小心了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRECRACKERS"
msgid "Warn me before lighting them."
msgstr "点之前先说一声。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREFLIES.GENERIC"
msgid "Nice to watch for a while."
msgstr "看一会倒挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREFLIES.HELD"
msgid "Still glowing in my pocket."
msgstr "口袋里也亮着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREHOUND"
msgid "Don't fight it in camp!"
msgstr "别在营地里打它！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRENETTLES"
msgid "Hot when you get close. Better pull them out."
msgstr "靠近就热，还是拔掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRENETTLES_DRIED"
msgid "Don't touch them casually, even dried."
msgstr "晒干了也别随便碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPEN"
msgid "Write homework with this, and will it vanish after?"
msgstr "拿它写作业，会不会写完就消失？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.EMBERS"
msgid "Almost out, move fast."
msgstr "快灭了，动作快点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.GENERIC"
msgid "Sit here and rest a bit."
msgstr "坐这里休息一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.HIGH"
msgid "No more wood."
msgstr "别再添柴了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.LOW"
msgid "More logs again."
msgstr "又要加木头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.NORMAL"
msgid "Warm, just right."
msgstr "暖和，刚刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIREPIT.OUT"
msgid "Still need it tomorrow."
msgstr "明天还得用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESTAFF"
msgid "Don't point that near the house."
msgstr "别往屋子旁边指。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Fuel's almost out."
msgstr "燃料快没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "It's off, don't forget to turn it on."
msgstr "关着，别忘了开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "This way, I don't have to keep watching it."
msgstr "这样就不用一直盯着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH"
msgid "Dinner's here."
msgstr "晚饭有了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINGNET"
msgid "One cast and less waiting."
msgstr "一网下去能少等一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHINGROD"
msgid "Ready to space out."
msgstr "准备好发呆了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT"
msgid "Get the bones out first."
msgstr "先把刺处理干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_COOKED"
msgid "Don't roast it too dry."
msgstr "别烤得太干。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_DRIED"
msgid "No need to cook it, easy to carry."
msgstr "不用现做，带着挺方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL"
msgid "Not enough to eat."
msgstr "这点不够吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "One bite, two bites. Gone."
msgstr "一口，两口。没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Just enough to nibble, no fire needed."
msgstr "正好吃一点，不用开火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHSTICKS"
msgid "These are easy to eat."
msgstr "这个吃起来方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISHTACOS"
msgid "Crunchy, better eat soon."
msgstr "脆的，要趁早吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_BOX"
msgid "The fish are all crammed in there."
msgstr "鱼都挤在里面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FISH_COOKED"
msgid "Roasted alright this time."
msgstr "这次烤得还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLINT"
msgid "The edge is sharp, don't cut your hand."
msgstr "边很锋利，别割到手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "It deflated. Have to do it again."
msgstr "瘪下去了，还得再弄一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Just look up and you can see it. Nice."
msgstr "抬头就能看见，挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "Hold on, I want to release one too."
msgstr "等一下，我也要放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOTATIONCUSHION"
msgid "If I fall in the water, this is it."
msgstr "真掉进水里就靠它了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER.GENERIC"
msgid "One flower on the table would be nice."
msgstr "插一朵在桌上也好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER.ROSE"
msgid "Pretty. Don't touch the thorns."
msgstr "好看，别碰到刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWERHAT"
msgid "Withers after you wear it a while."
msgstr "戴一会就会枯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWERSALAD"
msgid "Really having flowers for lunch?"
msgstr "真要把花当午饭？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_CAVE"
msgid "Even a little light in the cave."
msgstr "洞里也能有点光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "Once withered, not even the light's left."
msgstr "枯了以后连光都没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_EVIL"
msgid "Just looking at it feels wrong."
msgstr "看着就不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FLOWER_WITHERED"
msgid "It's dried out."
msgstr "已经干掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOLIAGE"
msgid "Picked leaves."
msgstr "摘下来的叶子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOLIAGE_DRIED"
msgid "Now it won't get wet when I store it."
msgstr "现在收起来就不会湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOOTBALLHAT"
msgid "Even here, no escaping gym equipment."
msgstr "这里也逃不过体育装备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORGETMELOTS"
msgid "Pretty little blue flowers."
msgstr "蓝色的小花，挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Save it for tea next time."
msgstr "先收好，下次泡茶用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FORMAL_BLUEPRINT"
msgid "Even beefalo have to dress this formally."
msgstr "牛也要穿得这么正式。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_PIECE"
msgid "Put it together and I bet there's trouble."
msgstr "拼起来恐怕又要出事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "No rush to get it moving."
msgstr "先别急着让它动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "This piece is definitely in the wrong place."
msgstr "这块肯定放错了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Not finished yet."
msgstr "还没拼完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRESHFRUITCREPES"
msgid "I'd get up early for this breakfast."
msgstr "这个早餐我愿意早起。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRIENDLYFRUITFLY"
msgid "With its help I worry less."
msgstr "有它帮忙就能少操一点心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.DEAD"
msgid "Now it won't be stealing anything."
msgstr "这下不会抢东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.GENERIC"
msgid "Don't jump on me."
msgstr "别跳到我身上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROG.SLEEPING"
msgid "Go around while I can."
msgstr "趁现在绕过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGFISHBOWL"
msgid "Why would you stuff a frog in there."
msgstr "为什么要把青蛙塞进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGGLEBUNWICH"
msgid "The legs inside... don't let me see them."
msgstr "里面的腿……别让我看见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS"
msgid "Cook it first, then we'll talk."
msgstr "先做熟再谈。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGLEGS_COOKED"
msgid "Doesn't taste as bad as I thought."
msgstr "尝起来倒没有想的差。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROGNEWTON"
msgid "What a weird combo."
msgstr "搭配得有点奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Anything cold works for me."
msgstr "冰的我都行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Not ripe yet, but pretty cute."
msgstr "还没熟，倒挺可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.RIPE"
msgid "It's ripe, and its temper changed too."
msgstr "熟了，脾气也变了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Quiet, let it sleep."
msgstr "安静一点，让它睡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITFLY"
msgid "Stay away from the food."
msgstr "离饭远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITFLYFRUIT"
msgid "Bring it along and something helps look after the vegetables."
msgstr "带着它就有帮忙照顾菜的了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FRUITMEDLEY"
msgid "It's already cut up, easy to eat."
msgstr "切好了，吃着省事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "Stone cold. Have to heat it up before using it."
msgstr "凉透了，得先加热再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.HOT"
msgid "While it's hot, get the work done quick."
msgstr "趁还热着，赶快把活做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "Barely any heat left."
msgstr "只剩一点温度了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEAXE.WARM"
msgid "Still usable, finish what's in my hands first."
msgstr "还能用，先把手上的做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.GENERIC"
msgid "Stone cold. Have to heat it up before using it."
msgstr "凉透了，得先加热再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.HOT"
msgid "While it's hot, get the work done quick."
msgstr "趁还热着，赶快把活做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.LUKEWARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.LUKEWARM"
msgid "Barely any heat left."
msgstr "只剩一点温度了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEHAMMER.WARM"
msgid "Still usable, finish what's in my hands first."
msgstr "还能用，先把手上的做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.GENERIC"
msgid "Stone cold. Have to heat it up before using it."
msgstr "凉透了，得先加热再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.HOT"
msgid "While it's hot, get the work done quick."
msgstr "趁还热着，赶快把活做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.LUKEWARM"
msgid "Barely any heat left."
msgstr "只剩一点温度了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLEPICKAXE.WARM"
msgid "Still usable, finish what's in my hands first."
msgstr "还能用，先把手上的做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.GENERIC"
msgid "Stone cold. Have to heat it up before using it."
msgstr "凉透了，得先加热再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.HOT"
msgid "While it's hot, get the work done quick."
msgstr "趁还热着，赶快把活做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.LUKEWARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.LUKEWARM"
msgid "Barely any heat left."
msgstr "只剩一点温度了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLESHOVEL.WARM"
msgid "Still usable, finish what's in my hands first."
msgstr "还能用，先把手上的做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC"
msgid "Stone cold. Have to heat it up before using it."
msgstr "凉透了，得先加热再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.HOT"
msgid "While it's hot, get the work done quick."
msgstr "趁还热着，赶快把活做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM"
msgid "Barely any heat left."
msgstr "只剩一点温度了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUMAROLE_FARM_HOE.WARM"
msgid "Still usable, finish what's in my hands first."
msgstr "还能用，先把手上的做完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FURTUFT"
msgid "A little tuft of fur, floating on the wind."
msgstr "一小撮毛，随风飘来飘去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUSED_SHADELING"
msgid "Growing bigger doesn't mean your temper has to grow too! Get back!"
msgstr "长个子也不用连脾气一起长吧！离远点！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "That thing's about to blow, get back."
msgstr "这东西快炸了，离远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARGOYLE_HOUND"
msgid "Just don't move suddenly."
msgstr "别突然动起来就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Way too lifelike."
msgstr "做得太像活的了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC"
msgid "Not too much, it's strong."
msgstr "别放太多，味道很重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_COOKED"
msgid "Much better roasted."
msgstr "烤过就好多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_OVERSIZED"
msgid "How long will it take to peel this."
msgstr "这要剥到什么时候。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GARLIC_SEEDS"
msgid "Just a little for seasoning is enough."
msgstr "留一点调味就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GAZPACHO"
msgid "Cold soup's actually not bad."
msgstr "冷汤居然也不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEARS"
msgid "Gears. Metal, I'll keep them."
msgstr "齿轮。金属的，收着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.GENERIC"
msgid "Don't get on my shoes."
msgstr "别黏到我鞋上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "Someone's in there, help!"
msgstr "人在里面，快帮忙！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Something's stuck inside. Who's reaching in first?"
msgstr "东西黏在里面了。谁先伸手？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_BOTTLE"
msgid "Screw the lid on tighter."
msgstr "瓶盖拧紧一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Are you sure things won't spoil stored like this?"
msgstr "东西这样放真的不会坏？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "Still empty inside."
msgstr "里面还空着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "It can store things. Set it up first."
msgstr "能存东西，先装起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEMSOCKET.GEMS"
msgid "Still missing a gem."
msgstr "还缺宝石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GEMSOCKET.VALID"
msgid "It's set, ready to use."
msgstr "放好了，可以用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.BURNING"
msgid "Stay away from the fire, it's too late."
msgstr "别靠近火，已经来不及了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "There's no saving it."
msgstr "已经救不回来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "How's it moving again, back off first."
msgstr "怎么又动起来了，先离远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT"
msgid "It seems to want me to know something."
msgstr "它好像想让我知道什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "There's already one in there."
msgstr "里面已经有了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Empty. Still have to go catch one."
msgstr "空着，还得去抓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_GUARD"
msgid "Don't get close, you'll get hit."
msgstr "别靠近，会挨打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "This kind explodes too, back away."
msgstr "这种还会炸，退远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOST"
msgid "Even ghosts are common here."
msgstr "这里连幽灵也很常见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTFLOWER"
msgid "A flower you can't quite touch."
msgstr "摸不太清楚的花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTFLOWERHAT"
msgid "Wear it and bring extra water."
msgstr "戴上就得多准备点水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "It makes Abigail's attacks stronger."
msgstr "给阿比盖尔增强攻击的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "Makes her recover faster."
msgstr "能让她快点恢复。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "A potion with moon power."
msgstr "带着月亮力量的药。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "Touching her hurts you too."
msgstr "碰她也会受伤。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "She'll need it when she comes back."
msgstr "她回来时会用上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "This one's got shadow power."
msgstr "这种带着暗影力量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "Blocks a hit for her."
msgstr "能替她挡一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "Slow recovery is fine too."
msgstr "慢慢恢复也没关系。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "Makes her fly faster."
msgstr "让她飞快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOST_KILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GHOST_KILL"
msgid "This time, don't get trapped again."
msgstr "这次，别再被困住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIFT"
msgid "For me? Can I open it now?"
msgstr "我的？能现在拆吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GIFTWRAP"
msgid "Might as well wrap it nicely."
msgstr "包得好看一点也行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADHOUSE"
msgid "It might get eaten before anyone moves in."
msgstr "住进去以前会不会先被吃完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADPIG"
msgid "Let's follow it and see."
msgstr "跟着它看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GINGERBREADWARG"
msgid "A dessert this big's no snack anymore! Run!"
msgstr "甜点长这么大也不能叫加餐了！快跑！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSBLOCK"
msgid "It's clear, don't walk into it."
msgstr "透明的，别迎面撞上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSCUTTER"
msgid "Sharp, don't touch the edge."
msgstr "锋利，别碰刃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLASSSPIKE"
msgid "It's pointy, go around."
msgstr "尖的，绕着走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMER.GENERIC"
msgid "Kind of cute once you look long enough."
msgstr "看久了还有点可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMER.SLEEPING"
msgid "I'll sit quietly with it a while."
msgstr "陪它安静坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "The petals are drooping."
msgstr "花瓣已经垂下来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "The petals sparkle in the light."
msgstr "花瓣在光里一闪一闪的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERFUEL"
msgid "That smell's way too strong."
msgstr "味道也太重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOMMERWINGS"
msgid "Don't use these to decorate my clothes."
msgstr "别拿来装饰我的衣服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GLOWBERRYMOUSSE"
msgid "Warly really knows his desserts."
msgstr "沃利做甜点的手艺真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Its horn's broken."
msgstr "角断了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "No horn, so be careful."
msgstr "没有角就小心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "You can follow, just don't bump me."
msgstr "跟着可以，别撞我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL.GENERIC"
msgid "Don't ram the boat with that horn."
msgstr "别用角顶船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GNARWAIL_HORN"
msgid "Have to store this one separately."
msgstr "这个得单独收好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOATMILK"
msgid "I'm a little worried about getting shocked drinking this."
msgstr "喝之前有点担心会触电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOGGLESHAT"
msgid "Looks good on top of keeping out sand."
msgstr "挡沙子以外也挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENAXE"
msgid "Golden axe. A bit soft, but shiny."
msgstr "金斧头。软是软了点，亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENPICKAXE"
msgid "Golden pickaxe. No regrets, I'm still just hitting things with it."
msgstr "金镐。不心疼，反正还是用来敲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENPITCHFORK"
msgid "Using gold just to shovel turf."
msgstr "铲块地还要用金的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDENSHOVEL"
msgid "Golden shovel. A few more digs and I'm done."
msgstr "金铲子。多挖几次就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDEN_FARM_HOE"
msgid "However nice it looks, it's still just a hoe."
msgstr "再好看也只是锄地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOLDNUGGET"
msgid "Shiny, but it won't buy lunch."
msgstr "闪闪的，就是不能拿来买午饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GOOSE_FEATHER"
msgid "So soft. Don't get it wet."
msgstr "软软的，别弄湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.BARREN"
msgid "Needs fertilizer."
msgstr "要施肥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.BURNING"
msgid "Grass sure burns fast."
msgstr "草烧得可真快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.DISEASED"
msgid "It's already sick."
msgstr "已经病了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.DISEASING"
msgid "The color's a little off."
msgstr "颜色有点不对。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.GENERIC"
msgid "Still need to cut some more."
msgstr "还得再割一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.PICKED"
msgid "All cut."
msgstr "割完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS.WITHERED"
msgid "It's too hot to grow."
msgstr "天气太热，长不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGATOR"
msgid "It doesn't look too happy to see me."
msgstr "它看起来不太欢迎我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "You're not feeling well either? Don't run."
msgstr "你也不舒服了？别跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Grass that runs off on its own."
msgstr "草还会自己跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRASS_UMBRELLA"
msgid "A bit less wet is still something."
msgstr "能少湿一点也好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVEURN.GENERIC"
msgid "No spirit in it yet."
msgstr "里面还没有灵魂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "It should be a little quieter here."
msgstr "在这里能安静一点吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GRAVY"
msgid "Just a little on top."
msgstr "浇一点就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENAMULET"
msgid "Crafting uses fewer materials."
msgstr "做东西能少用些材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENGEM"
msgid "This green's kinda nice."
msgstr "这个绿色还挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENMOONEYE"
msgid "Remember this spot. No more detours next time."
msgstr "记住这里，下次别再绕路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREENSTAFF"
msgid "If it can dismantle things, no need to find materials again."
msgstr "能拆回来就不用重新找材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_CAP"
msgid "Looking normal doesn't mean you can just eat it."
msgstr "看起来正常也不能乱吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_CAP_COOKED"
msgid "Cooked, at least I can consider it."
msgstr "熟的至少能考虑一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Only comes out at dusk."
msgstr "傍晚才出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Can't pick it now."
msgstr "现在还采不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Already picked."
msgstr "已经摘了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GROTTO_POOL_BIG"
msgid "Glass keeps growing in the water."
msgstr "水里一直在长玻璃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GROTTO_POOL_SMALL"
msgid "Same with this little pool."
msgstr "这小池子也一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUACAMOLE"
msgid "Decent as a dip."
msgstr "蘸着吃还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUANO"
msgid "Don't get it on my shoes."
msgstr "别沾到鞋上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.GUNPOWDER"
msgid "Keep it away from fire when storing."
msgstr "收的时候离火远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_1"
msgid "I could take another one of these."
msgstr "这种糖我可以再拿一颗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_10"
msgid "Suck on it slowly and it lasts a long time."
msgstr "慢慢含着就能吃很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_11"
msgid "As candy, it's not so scary."
msgstr "做成糖果就没那么可怕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_12"
msgid "Did that just move? Is this edible?"
msgstr "刚才动了？这能吃吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_13"
msgid "So hard my teeth hurt."
msgstr "硬得牙都要疼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_14"
msgid "Even this has spice in it?"
msgstr "这个也要放辣？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_2"
msgid "Weird looking. Try one first."
msgstr "长得奇怪，先尝一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_3"
msgid "Looks like corn."
msgstr "看着像玉米。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_4"
msgid "Don't make it look so much like bugs."
msgstr "别做得那么像虫子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_5"
msgid "A little too sweet."
msgstr "甜得有点过头了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_6"
msgid "I'll pass on this kind."
msgstr "这种样子的就算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_7"
msgid "Raisins count as candy?"
msgstr "葡萄干也算糖果？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_8"
msgid "I can save this for tonight."
msgstr "这根能留到晚上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENCANDY_9"
msgid "Stuck in my teeth again."
msgstr "又黏牙了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Drink it and I won't fear those trees?"
msgstr "喝完就能不怕那些树？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "This bottle's pretty strong."
msgstr "这一瓶药效挺强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Just this little?"
msgstr "就这么一点？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Let's put it in a fire and see."
msgstr "放进火里看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Something to do with the moon again."
msgstr "又和月亮有关系。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Hang a ghost and it's decorated."
msgstr "挂个幽灵就算布置好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "This bat won't fly around."
msgstr "这只蝙蝠不会乱飞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "A little wooden ornament."
msgstr "木头做的小装饰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Don't make it look so much like a real tentacle."
msgstr "别做得和真的触手一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Once it's hung up, stop swaying."
msgstr "挂好就别乱晃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "A crow ornament, pretty fitting."
msgstr "乌鸦的装饰，倒挺合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMBAT"
msgid "A ham for a bat? I've got a metal one."
msgstr "拿火腿当球棒？我有金属的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMMER"
msgid "Hammer. Better than chopping trees."
msgstr "锤子。敲东西比砍树爽。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAMMER_MJOLNIR"
msgid "This heavy, it takes both hands."
msgstr "这么重，得用两只手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "Wash the smell out before hitting people with it."
msgstr "拍人以前先把味道洗掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_KELP"
msgid "It'll splash water with every hit."
msgstr "打一下会溅出水吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_PETALS"
msgid "This one smells nice, I'll take it."
msgstr "这个闻着好，拿这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "Using this in a pillow fight is way too serious."
msgstr "用这个打枕头仗也太认真了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARAKIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HARAKIRI"
msgid "Put this away, don't think weird things."
msgstr "把这个收好，别想奇怪的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAREBALL"
msgid "It's not even fully dry. Don't give it to me."
msgstr "毛都没弄干净，别给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HAWAIIANSHIRT"
msgid "Finally, I don't have to wear my uniform all the time."
msgstr "总算不用一直穿制服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE"
msgid "Stings a little going on. Just bear with it."
msgstr "涂的时候有点疼，忍一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE_ACID"
msgid "Blocks acid rain, keep it."
msgstr "能挡酸雨，留着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSALVE_FUMAROLE"
msgid "This should make me feel a bit better."
msgstr "涂了这个应该能好受一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEALINGSTAFF"
msgid "I'm counting on this for healing."
msgstr "治疗的事就靠它了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.COLD"
msgid "Nice and cool."
msgstr "凉凉的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.FROZEN"
msgid "So cold I can't hold it."
msgstr "已经冷得拿不住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.GENERIC"
msgid "Adjust the temperature first."
msgstr "先调整一下温度。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.HOT"
msgid "Just warmed it up, let's take it and go."
msgstr "刚热好，带上再走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEATROCK.WARM"
msgid "Feels good to keep with me."
msgstr "放在身边很舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGEHOUND"
msgid "Hounds can spring out of bushes too!"
msgstr "草丛里也能蹿出狗！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HEDGEHOUND_BUSH"
msgid "That bush had better not move."
msgstr "这丛草最好别动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB"
msgid "Living alone this long must be boring."
msgstr "一个人住这么久，会很无聊吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "I'll have this one when it's cold."
msgstr "冷的时候再喝这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "Let's finish this cup before heading out."
msgstr "喝完这杯再出发吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "I feel a lot better after that."
msgstr "喝完以后舒服多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "This taste's a little special."
msgstr "这个味道有点特别。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "This cup smells wonderful."
msgstr "这一杯闻着就很舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "You can make tea with this flower?"
msgstr "这种花也能拿来泡茶吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "Something cool to drink. Finally comfortable."
msgstr "喝点凉快的，终于舒服了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "Taste aside, as long as it's good for me."
msgstr "味道先不说，能养好身体就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "Nobody's tending it, the light's gone to ruin."
msgstr "没人照管，灯都荒废了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "Now I can see the road at night too."
msgstr "晚上也能看清路了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "Let's see where it's best to hang it."
msgstr "先看看挂在哪里合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "Help her move and then I can rest."
msgstr "帮她搬完就能休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_SHELL"
msgid "Let's not shake around too much on the way over."
msgstr "过去的时候最好别晃得太厉害。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "Can I sit here for a while?"
msgstr "这里可以坐一会吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "Take your time brewing. I'm resting anyway."
msgstr "慢慢泡吧，我正好休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "The tea shop burned down, we have to help her fix it."
msgstr "茶铺都烧了，得帮她修好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "Not open yet, I'll come back later."
msgstr "还没开门，晚一点再来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "Finally I can have a nice soak."
msgstr "终于可以好好泡一下了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "No water at all, how would I soak."
msgstr "水都没有，怎么泡。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "After walking so long, I really want to soak in there."
msgstr "走了那么久，真想进去泡着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "If you want a hot spring, you have to fix it first."
msgstr "想泡温泉还得先修好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "Much more comfortable to live in now."
msgstr "现在住着舒服多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "Let's patch up her roof first."
msgstr "先替她补好屋顶吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "The laundry's not dry, don't spray water on it."
msgstr "衣服还没干，别往上面喷水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "You can hear it sitting here."
msgstr "坐在这里就能听见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_BUNDLE"
msgid "She gave it to me. Let's open it."
msgstr "她给的，拆开看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "It's all shells inside."
msgstr "里面全是贝壳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "...How am I going to tell her when I go back."
msgstr "……回去怎么和她说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HERMIT_PEARL"
msgid "Better take good care of it, she entrusted it to me."
msgstr "得好好保管，这是她托付的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HITOKIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HITOKIRI"
msgid "Don't stand too close to me holding that."
msgstr "拿着的时候别靠我太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HIVEHAT"
msgid "It's a little quieter wearing it."
msgstr "戴着倒能安静一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HMINGOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HMINGOT"
msgid "Still hot. Wait for it to cool down."
msgstr "还烫着，等凉一点再拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOME"
msgid "Someone lives here."
msgstr "有人住这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.BURNT"
msgid "Can't make out anything."
msgstr "什么也看不清了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.GENERIC"
msgid "If you can read, no need to ask for directions."
msgstr "认得字，就不用再问路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Nobody's written on it."
msgstr "还没人写。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEY"
msgid "This could go in a dessert."
msgstr "这个可以放进甜点里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYCOMB"
msgid "Bees used to live here."
msgstr "以前住过蜜蜂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYHAM"
msgid "Sweet and salty, just right. This works."
msgstr "甜咸刚好，这个可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HONEYNUGGETS"
msgid "I'd have a few more."
msgstr "再来几块也行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORN"
msgid "One blow and they all come."
msgstr "一吹就都跟过来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORRORFUEL"
msgid "Holding it feels cold."
msgstr "拿着就觉得冷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HORSESHOE"
msgid "Keep it, it should still be useful."
msgstr "先收好，应该还有用处。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTCHILI"
msgid "Get me a glass of water first."
msgstr "先给我准备一杯水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.BOMBED"
msgid "It's bubbling, wait a moment."
msgstr "冒泡了，等一等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.EMPTY"
msgid "No water left. Have to wait."
msgstr "水没了，还得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.GENERIC"
msgid "I really want to soak for a while."
msgstr "真想泡一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOTSPRING.GLASS"
msgid "The water's turned to glass."
msgstr "水面变成玻璃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUND"
msgid "It's chasing me again."
msgstr "又追过来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDBONE"
msgid "Don't put that next to the bed."
msgstr "别放在床边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "This should stop it moving."
msgstr "这回应该不会动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "The smell alone keeps me away."
msgstr "闻着就不想靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "It can stand back up?"
msgstr "还会站起来？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDMOUND"
msgid "Go around, don't disturb what's in there."
msgstr "绕开，别惊动里面的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDSTOOTH"
msgid "Those teeth are sharp too."
msgstr "牙也这么尖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "Wash it before using it."
msgstr "用之前先洗干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HOUNDWHISTLE"
msgid "If only it made them stop for a moment."
msgstr "能让它们停一下就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT"
msgid "Take it away. I'm not touching it."
msgstr "拿走。我不碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT_COOKED"
msgid "Cooked or not, no way am I eating it."
msgstr "煮熟了也不可能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUMANMEAT_DRIED"
msgid "Don't mix it in with the normal jerky."
msgstr "别混在正常的肉干里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH"
msgid "Leaving the underground stuff with you to carry."
msgstr "地下的东西就拜托你背了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Bring the fishbowl and it follows."
msgstr "带着鱼缸就会跟来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "No reaction for now, wait a while."
msgstr "暂时没反应，等一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICE"
msgid "Ice. For making ice cream."
msgstr "冰块。拿去做冰淇淋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG.GENERIC"
msgid "Go around, don't touch the boat."
msgstr "绕过去，别碰船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG.MELTED"
msgid "It's all melted."
msgstr "已经化光了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBERG_MELTED"
msgid "Nothing left."
msgstr "什么也没剩下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEBOX"
msgid "Ice box. Ice cream goes here."
msgstr "冰箱。冰淇淋放这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICECREAM"
msgid "Ice cream. Today was worth it."
msgstr "冰淇淋。今天值了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEHAT"
msgid "My hair's going to get soaked."
msgstr "头发会全湿掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEHOUND"
msgid "Even the winter ones chase people."
msgstr "冬天的也要追人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICEPACK"
msgid "Now the ice cream can come out with me."
msgstr "冰淇淋能带出门了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF"
msgid "It's icy. If only it could make ice cream."
msgstr "冰的。要是能做冰淇淋就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF2"
msgid "Colder than before, don't point it at me."
msgstr "比原来更冷了，别对着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICESTAFF3"
msgid "This should freeze things more solid."
msgstr "这下应该能冻得更牢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ICE_BLUEPRINT"
msgid "A beefalo in this looks even colder."
msgstr "牛穿这个看着更冷了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "It wasn't this tall a second ago."
msgstr "刚才还没这么高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "A short little rock."
msgstr "一块矮矮的石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "Winona always looks at things more carefully than I do."
msgstr "薇诺娜看东西总比我仔细。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.INSPECTSELF"
msgid "My uniform's still in one piece."
msgstr "制服还完整。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IPECACSYRUP"
msgid "Don't make me drink this."
msgstr "别让我喝这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.IVY_SNARE"
msgid "Even vines are blocking the road."
msgstr "连藤都要拦路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JAMMYPRESERVES"
msgid "Goes great with some bread."
msgstr "配点面包就很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JELLYBEAN"
msgid "Save a few for me."
msgstr "留几颗给我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE"
msgid "Are we really sticking a hand in there to search?"
msgstr "真要把手伸进去找？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
msgid "The blueprint's on top. Don't collapse it taking it."
msgstr "图纸在上面，拿的时候别弄塌了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUNK_PILE_BIG.GENERIC"
msgid "Don't touch it, it looks ready to collapse."
msgstr "别乱碰，看着快塌了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.JUSTEGGS"
msgid "Eggs alone aren't enough, I need rice."
msgstr "光有蛋不行，得有饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KABOBS"
msgid "Easy to eat with one hand."
msgstr "拿着吃很方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KAGE"
msgid "Can't quite see the edge of the blade."
msgstr "看不太清刀身的边缘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KATANABLADE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KATANABLADE"
msgid "No handle yet, don't grip it directly."
msgstr "还没装柄，别直接握。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KATANABODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KATANABODY"
msgid "Just a few more steps before it's usable."
msgstr "还差最后几步才能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP"
msgid "My pockets are all wet."
msgstr "口袋里都湿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELPHAT"
msgid "Cool, sure, but too slimy."
msgstr "凉是凉，太黏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP_COOKED"
msgid "So soft I can barely pick it up."
msgstr "软得快夹不起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KELP_DRIED"
msgid "So salty I need water with it."
msgstr "咸得得配水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KILLERBEE.GENERIC"
msgid "This kind comes straight at you!"
msgstr "这种会直接冲过来！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KILLERBEE.HELD"
msgid "Better not put it in my pocket."
msgstr "还是别放口袋里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KING_CANE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KING_CANE.EMPTY"
msgid "Have to put a gem in first."
msgstr "得先装上宝石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KING_CANE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KING_CANE.GENERIC"
msgid "Holding this really stands out."
msgstr "拿着这个还挺显眼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.ATTACKER"
msgid "%s, put your hands down. We're not here to fight."
msgstr "%s，把手放下，我们不是来打架的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.FIRESTARTER"
msgid "%s, being bored doesn't mean you get to burn things."
msgstr "%s，无聊也不能烧东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.GENERIC"
msgid "%s, spacing out today too?"
msgstr "%s，今天也在发呆？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.GHOST"
msgid "%s, don't go, I don't want to be left alone."
msgstr "%s，别走，我可不想只剩自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.MURDERER"
msgid "%s, stop! Do you know what you're doing!"
msgstr "%s，停下！你知道自己在做什么吗！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KIRITZUKA.REVIVER"
msgid "%s, thanks."
msgstr "%s，谢谢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "The toy burned too."
msgstr "玩具也烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "The kittens are playing harder than I am."
msgstr "小猫玩得比我认真。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR1_KIT"
msgid "Set it up and let them play."
msgstr "装好给它们玩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "Have to make another one."
msgstr "得再做一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "I could sit half the day watching them play."
msgstr "看它们玩也能坐半天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDECOR2_KIT"
msgid "This should be easy to set up."
msgstr "这个应该很好装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.BURNT"
msgid "Did all the kittens get out?"
msgstr "小猫都跑出来了吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.GENERIC"
msgid "Sleeps quite a few in there."
msgstr "里面睡得下好几只。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "Where'd they hide this time."
msgstr "又藏到哪里去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "Not much time, and I haven't found them all."
msgstr "时间不多了，还没找全。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOONDEN_KIT"
msgid "Give them a home."
msgstr "给它们安个家。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_DECIDUOUS"
msgid "This one's a really nice color."
msgstr "这只的颜色真好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_DESERT"
msgid "Don't overheat in the desert."
msgstr "在沙漠里别热着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_FOREST"
msgid "Come here, let me pet you."
msgstr "过来，给我摸一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_GRASS"
msgid "When it's not moving, you really can't find it."
msgstr "不动的时候还真找不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_MARSH"
msgid "Don't run deeper into the marsh."
msgstr "别往沼泽深处跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_MOON"
msgid "Even from the moon, they're this small."
msgstr "月亮来的也这么小。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_NAMETAG"
msgid "Even coming up with a name takes forever."
msgstr "起名字也得想半天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_ROCKY"
msgid "Don't hide in the cracks."
msgstr "别躲进石缝里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_SAVANNA"
msgid "Follow me somewhere with shade."
msgstr "跟着我去有阴凉的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KITCOON_YOT"
msgid "I want to take this one home too."
msgstr "这只也想带回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS"
msgid "The sack's owner is here."
msgstr "袋子的主人来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUSSACKKEY"
msgid "This horn's finally useful."
msgstr "这根角终于能派上用场。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KLAUS_SACK"
msgid "There should be something good inside."
msgstr "里面会有好东西吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT"
msgid "Don't charge over and kick me."
msgstr "别冲过来踢人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Its parts are loose and it still wants to kick."
msgstr "零件都松了还想踢人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "Just follow, don't step on me."
msgstr "跟着就好，别踩到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "Someone's leading, so it's not my problem."
msgstr "有人带路，倒不用我费心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "Let's see if it charges first."
msgstr "先看看它会不会冲过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_CARCASS"
msgid "Finally, no more chasing."
msgstr "终于不用再追了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_SUMMER"
msgid "Chased it this far, finally found it."
msgstr "追了这么远，总算看到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFANT_WINTER"
msgid "That coat must be warm."
msgstr "这身毛应该很暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOALEFIG_TRUNK"
msgid "Slice it before serving."
msgstr "端上来之前切开吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOSHIRAE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KOSHIRAE"
msgid "Nice decoration, but don't forget it's a sword."
msgstr "装饰挺好看，也别忘了它是刀。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAMPUS"
msgid "Don't take my stuff!"
msgstr "别拿我的东西！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.KRAMPUS_SACK"
msgid "I'll carry it after it's washed."
msgstr "洗干净以后再背。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LANTERN"
msgid "Less hassle than carrying a torch."
msgstr "比拿火把省心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LATKES"
msgid "Crispy only if you eat them hot."
msgstr "趁热吃才脆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Wear this and I probably can't walk."
msgstr "穿上恐怕就走不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Sturdy, sure, just heavy."
msgstr "结实是结实，就是重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Light to wear, won't block much either."
msgstr "穿着轻，也挡不了太多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Run faster, get hit less."
msgstr "跑快点能少挨打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "The weight's about acceptable."
msgstr "这件重量还能接受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "As long as the fight ends sooner."
msgstr "能早点打完就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "A little less waiting on skills."
msgstr "技能能少等一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Wearing it's somewhat reassuring."
msgstr "穿着能安心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Take down the flag first."
msgstr "先把旗子拆掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BERNIE"
msgid "It can help draw attention."
msgstr "它能帮忙吸引注意。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_BOARLORD"
msgid "So he's the one who keeps making us fight?"
msgstr "就是他让我们一直打？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Wear it, finish quickly."
msgstr "戴上就尽快解决。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "This pile of rocks will fight for us."
msgstr "这堆石头会帮我们打。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "For spells, don't just wear it."
msgstr "法术用的，别乱戴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Light when you run, really."
msgstr "跑起来确实轻快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Don't throw it at your feet."
msgstr "别在脚下扔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "Speeds up healing."
msgstr "让治疗快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Slow recovery beats none."
msgstr "慢慢恢复，总比没有好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "Doesn't look easy to swing."
msgstr "看着就不好挥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "Still missing a key."
msgstr "还差钥匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "It's in. Should open now."
msgstr "放好了，该开了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "It does a bit more damage."
msgstr "能多打一点伤害。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_LUCY"
msgid "Look before you throw."
msgstr "扔出去之前先看清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "We still have to get back through here at the end."
msgstr "最后还得从这里回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "We can go. I'll go first."
msgstr "可以走了，我先过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Speeds up cooldowns a bit."
msgstr "冷却能快一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_SPAWNER"
msgid "So this is where they come from."
msgstr "原来它们从这里出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Hits harder wearing it."
msgstr "戴着打会更重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Have to take healing seriously."
msgstr "治疗的事得认真一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE"
msgid "Stay away, it really burns."
msgstr "别靠近，真的会烧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_COCOON"
msgid "Finally cooled down."
msgstr "总算凉下来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "It's warm inside. Don't treat my tent as a snack when you hatch."
msgstr "里面暖暖的。孵出来别把我的帐篷当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "Needs warming up."
msgstr "还得暖一暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "This is warm enough."
msgstr "这样就够暖了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.CONTENT"
msgid "Quiet once it's full."
msgstr "吃饱就安静了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.GENERIC"
msgid "Don't burn my stuff."
msgstr "别把我的东西烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Time to feed it again."
msgstr "又该喂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_PET.STARVING"
msgid "It's starving, find something to eat quick."
msgstr "饿坏了，快找点吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVAE_TOOTH"
msgid "Fell out when it hatched."
msgstr "孵出来的时候掉的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT.COOL"
msgid "Cooled off and turned to stone."
msgstr "凉了就成了石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVASPIT.HOT"
msgid "Don't step on it, it's burning hot."
msgstr "别踩，正烫着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVA_POND"
msgid "It's hot even from far away."
msgstr "站远一点都热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LAVA_POND_ROCK"
msgid "Don't go too close just for a rock."
msgstr "别为了石头靠太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFLOAF"
msgid "Looks like meat, tastes like vegetables."
msgstr "看着像肉，吃着又像菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFYMEATBURGER"
msgid "Once it's in the bun, let's not talk ingredients."
msgstr "夹好以后就别说原料了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Looks okay. I'll try a bit first."
msgstr "看着还行，先尝一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF"
msgid "Even trees get up and hit people."
msgstr "树也要起来打人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_IDOL"
msgid "A tree carved out of wood. So patient."
msgstr "木头雕的树，真有耐心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LEIF_SPARSE"
msgid "Stop chasing me, I'll keep my distance."
msgstr "别追了，我离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LICHEN"
msgid "Is this the only thing to eat?"
msgstr "只有这个能吃？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIFEINJECTOR"
msgid "If I have to get a shot, I'll just bear it."
msgstr "非要打针也只能忍了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTBULB"
msgid "Saving it to fuel a lamp."
msgstr "留着给灯补充燃料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTCRAB"
msgid "It glows on its own."
msgstr "它自己会发光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTER"
msgid "The lighter Willow always carries."
msgstr "薇洛一直带着的打火机。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTFLIER"
msgid "Bring one along and I don't need a hand free for a lamp."
msgstr "带一只就不用腾手拿灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Definitely don't touch it now."
msgstr "现在绝对别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "I won't touch you, so don't headbutt me."
msgstr "我不碰你，你也别顶我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It might still be charged, careful."
msgstr "还可能带电，小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Good thing that last strike didn't hit anyone."
msgstr "刚才那一下还好没劈到人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Draws the lightning away."
msgstr "把雷引远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LITTLE_WALRUS"
msgid "Even the little one's armed."
msgstr "小的也带着武器。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGLOG"
msgid "Looks even more reluctant than I am."
msgstr "它看着比我还不情愿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE"
msgid "Stop staring at me."
msgstr "别一直看着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE_ROOT"
msgid "There's still something in there, gotta dig."
msgstr "里面还有东西，得挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Don't stand outside my window when you grow up."
msgstr "长大后别站在我窗外。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERBISQUE"
msgid "This soup's alright."
msgstr "这道汤可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOBSTERDINNER"
msgid "Eating pretty well today."
msgstr "今天吃得挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOG.BURNING"
msgid "Can't take this one, it's hot."
msgstr "这根不能拿，会烫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOG.GENERIC"
msgid "A few more and I'm heading back."
msgstr "再捡几根就回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LORDFRUITFLY"
msgid "Don't ruin all the vegetables."
msgstr "别把菜全弄坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_1"
msgid "Someone left a toy here."
msgstr "有人把玩具丢在这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_10"
msgid "Someone should be coming back for it."
msgstr "应该还会有人回来找吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_11"
msgid "This one doesn't look like a normal toy."
msgstr "这件看着不像普通的玩具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_14"
msgid "Remember the spot first, don't just take it."
msgstr "先记住位置，别随便拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_18"
msgid "Who'd leave it here."
msgstr "谁会把它留在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_19"
msgid "Can't quite touch it. So weird."
msgstr "碰不太清楚，真奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_2"
msgid "Losing this must be sad."
msgstr "丢了这个会很难过吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_42"
msgid "Let Wendy take a look."
msgstr "让温蒂来看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_43"
msgid "Someone seems unwilling to part with it."
msgstr "好像还有谁舍不得它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LOST_TOY_7"
msgid "Who's been holding on to this?"
msgstr "这是谁一直留着的东西？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "My luck's not bad today."
msgstr "今天运气还不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUCY"
msgid "Woodie, your axe."
msgstr "伍迪，你的斧头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUMPY_SAPLING"
msgid "Growing kind of funny."
msgstr "长得有点奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARFROG"
msgid "Stop staring at me."
msgstr "别再盯着我了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANTHAT"
msgid "It glows on top of my head."
msgstr "戴着头顶亮亮的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANT_HUSK"
msgid "This hard, it should make good gear."
msgstr "这么硬，应该能拿来做装备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARPLANT_KIT"
msgid "Need this to fix gear when it breaks."
msgstr "装备坏了还得靠这个修。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "So bright it stings."
msgstr "亮得有点刺眼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARRIFT_PORTAL"
msgid "What's actually in there, I still can't see."
msgstr "里面到底有什么，还看不清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARTHRALL_PLANT"
msgid "So many vines they've blocked the road."
msgstr "长这么多藤，路都堵了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "Don't come over and tangle me."
msgstr "别靠过来缠人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_FORGE"
msgid "Have to come here to make gear."
msgstr "还得来这里做装备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_FORGE_KIT"
msgid "Set it up once there are enough materials."
msgstr "材料够了就装起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_GRAZER"
msgid "It came out of the rift too?"
msgstr "它也是从裂隙里出来的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUNAR_SEED"
msgid "Still glowing in my hand."
msgstr "拿着还在发光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLANT"
msgid "Don't get fooled by that meat on top."
msgstr "别被上面那块肉骗了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUREPLANTBULB"
msgid "Wherever you plant it, be careful."
msgstr "种在哪里都得小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.LUTEFISK"
msgid "Let me smell it before I decide."
msgstr "先闻一下再决定吃不吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MADSCIENCE_LAB"
msgid "Even on vacation there's no escaping lab class."
msgstr "放假也逃不过实验课。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAGICIAN_CHEST"
msgid "Putting things in there doesn't quite feel safe."
msgstr "把东西放进去总觉得有点不放心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAID_HB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAID_HB"
msgid "Wear it and I have to start cleaning?"
msgstr "戴上就得开始打扫吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS"
msgid "Don't target our boat."
msgstr "别拿我们的船当目标。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_BEAK"
msgid "Way too strong a smell."
msgstr "味道太重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_FEATHER"
msgid "Pretty feather, at least."
msgstr "羽毛倒挺漂亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "Sew it up and it makes a sail."
msgstr "缝好就能拿来做帆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MALE_PUPPET"
msgid "Let's get him out of there first."
msgstr "得先把他放出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE"
msgid "It looks like a tiny person."
msgstr "长得像个小人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKESOUP"
msgid "In soup it finally stops screaming."
msgstr "煮成汤以后终于不叫了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Quit screaming!"
msgstr "别再叫了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_COOKED"
msgid "Finally quiet."
msgstr "终于安静了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANDRAKE_PLANTED"
msgid "Think before you pull."
msgstr "拔之前先考虑一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANRABBIT_TAIL"
msgid "So soft. Let me touch it."
msgstr "软软的，摸一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.ATTACKER"
msgid "%s, sheathe it first. Let's talk this out."
msgstr "%s，刀先收好，有话慢慢说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.FIRESTARTER"
msgid "%s, put the fire out before you practice."
msgstr "%s，先把火灭了再练。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.GENERIC"
msgid "%s, done practicing?"
msgstr "%s，练完了吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.GHOST"
msgid "%s, this time I'll protect you."
msgstr "%s，这次换我来保护你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.MURDERER"
msgid "%s, stop! Don't let your blade hurt your friends anymore!"
msgstr "%s，住手！别再让刀伤到同伴！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MANUTSAWEE.REVIVER"
msgid "%s, I'm glad you're here... don't make me say that twice."
msgstr "%s，有你在真好……这句话别让我再说一遍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAPSCROLL"
msgid "Even blank paper needs someone to draw the map."
msgstr "白纸也得等有人画地图。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLE"
msgid "Pretty, just heavy."
msgstr "好看，就是重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEBEAN"
msgid "Even stones can be planted."
msgstr "石头也能种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "Thought someone had carved it already."
msgstr "还以为是谁雕好的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLEPILLAR"
msgid "Break it down for some materials."
msgstr "拆了能拿点材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLESHRUB"
msgid "Once it looks like this, it can be harvested?"
msgstr "长成这样就能采了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARBLETREE"
msgid "An axe probably can't dent it."
msgstr "斧头恐怕敲不动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Thorns burned along with it."
msgstr "刺也一起烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.BURNT"
msgid "One less prickly bush."
msgstr "少一丛扎人的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "Gotta watch my hands again."
msgstr "又得小心手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Picked, and my hands got pricked."
msgstr "摘完了，手也扎了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_PLANT"
msgid "Grass growing by the water."
msgstr "水边长着的草。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.BURNING"
msgid "Stay away, it's hot and spiky."
msgstr "别靠近，烫还带刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.BURNT"
msgid "Burned up and still prickly."
msgstr "烧完了还是扎人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Chop it, and it's less trouble."
msgstr "砍完就少点麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MARSH_TREE.GENERIC"
msgid "The tree's covered in spikes."
msgstr "树上全是尖刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASHEDPOTATOES"
msgid "Softer's better."
msgstr "口感软一点比较好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "Can you still see where you're going with this on?"
msgstr "戴上以后还能看清路吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "This mask is so old, don't break it."
msgstr "面具这么旧了，别碰坏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "Wearing it too long has to tire your neck."
msgstr "戴久了脖子会累吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "A blacksmith's mask."
msgstr "铁匠的面具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_CHARLIE_BOSSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_CHARLIE_BOSSHAT"
msgid "Better put this one away for now."
msgstr "这个还是先收起来吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "It's cracked, looks even scarier."
msgstr "裂开了，看着更吓人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLHAT"
msgid "A doll's face is too stiff."
msgstr "人偶的脸太僵了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "Repaired, but you can still see the crack."
msgstr "修好了也看得出裂痕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_FOOLHAT"
msgid "Can this role have fewer lines?"
msgstr "这个角色能少说几句吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_HALFWITHAT"
msgid "Even wearing it, I don't want to play this."
msgstr "戴上也不想演这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_KINGHAT"
msgid "A king must have a lot of lines to memorize."
msgstr "国王要背很多台词吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_MIRRORHAT"
msgid "You can see your own face in it."
msgstr "能照到自己的脸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_PRINCESSHAT"
msgid "Wear it and I have to go on stage?"
msgstr "戴上以后就要上台了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_QUEENHAT"
msgid "A queen's mask."
msgstr "女王的面具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_SAGEHAT"
msgid "Wearing it won't make me suddenly smarter."
msgstr "戴着也不会突然懂更多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_TOADYHAT"
msgid "This role has to agree with everyone all the time."
msgstr "这个角色还要一直附和别人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASK_TREEHAT"
msgid "You can play this just standing still."
msgstr "站着不动也能演。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST"
msgid "With wind, no need to row."
msgstr "有风就不用划了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "At night, one less hand tied up."
msgstr "晚上能少腾一只手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Give the racing boat a lamp too."
msgstr "给赛船也装盏灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "The dragon's eyes are glowing."
msgstr "龙眼亮起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Even at sea you need protection from lightning."
msgstr "海上也得防雷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_ITEM"
msgid "Install it and save some effort."
msgstr "装好以后能省点力。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_MALBATROSS"
msgid "Faster than a normal one."
msgstr "比普通的跑得快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Lighter than I thought."
msgstr "拿着比想的轻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_YOTD"
msgid "This sail's actually got presence."
msgstr "这帆倒挺有气势。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAST_YOTD_ITEM"
msgid "Install it, then we go."
msgstr "装完再出发。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELL"
msgid "Another lecture? Just say what you want from me."
msgstr "又要讲大道理？直接说要我干什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLHEAD"
msgid "Why's your face so big."
msgstr "脸放这么大干什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLLIGHT"
msgid "Stays lit even with no fuel."
msgstr "没有燃料也一直亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLLOCK"
msgid "There should be a key that goes here."
msgstr "这里应该要插钥匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "So that's where the music's from. Can it stop for a sec?"
msgstr "原来音乐从这里来，能停一下吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MAXWELLTHRONE"
msgid "Doesn't even look comfortable to sit on."
msgstr "光看着就坐不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAT"
msgid "Cook it, then bring it over."
msgstr "做熟了再拿过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATBALLS"
msgid "Convenient, but you get sick of them."
msgstr "方便是方便，总吃也会腻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.BURNT"
msgid "Even the rack's burned."
msgstr "架子也烤焦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DONE"
msgid "Finally dry."
msgstr "终于干好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "This one's dry too."
msgstr "这份也干了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYING"
msgid "Air-drying's so slow."
msgstr "风干真慢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Have to wait till the rain stops."
msgstr "雨不停就还得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Rained on again. That drying was for nothing."
msgstr "又淋湿了，白晾了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Not dried all the way yet."
msgstr "还没干透。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK.GENERIC"
msgid "Put some meat up and wait."
msgstr "放点肉上去等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Have to help her rebuild."
msgstr "得帮她重搭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The jerky's done."
msgstr "肉干做好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Ready to take down."
msgstr "可以收起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Still drying."
msgstr "还在晾着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "The rain's holding it up again."
msgstr "这场雨又耽误了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "It won't dry in the rain."
msgstr "淋着雨可干不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Have to wait some more."
msgstr "还要再等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Her rack still has room."
msgstr "她的架子上还能放些东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "That's what happens when you leave it."
msgstr "放着不管就成这样了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "The rack burned too."
msgstr "架子也烧坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "Finally ready to eat."
msgstr "终于能吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "Dried, no more waiting."
msgstr "晒好了，不用再等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "The salt's crystallized. Bag it up."
msgstr "盐结出来了，先装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "Meat's still drying, do something else for now."
msgstr "肉还在晾，先做点别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "Rain's not stopping, so keep waiting."
msgstr "雨不停就还得继续等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "It only gets wetter. No way to dry it."
msgstr "越淋越湿，没办法晒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "Not dried all the way yet."
msgstr "还没干透。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "It dries more at once. Handy."
msgstr "一次能多晾一点，挺方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEATYSALAD"
msgid "Looks like a salad, but it's pretty filling."
msgstr "看着像沙拉，倒是很顶饱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEAT_DRIED"
msgid "Handy for eating on the road."
msgstr "路上吃倒方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MEGAFLARE"
msgid "Light this and forget about peace and quiet."
msgstr "点了以后就别想清静了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM"
msgid "Smells like unwashed fish."
msgstr "闻起来像没洗过的鱼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMARMORHAT"
msgid "For merms. I can't wear that."
msgstr "鱼人戴的，我戴不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Sturdier now, still doesn't fit my head."
msgstr "做得更结实了，还是不合我的头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.BURNING"
msgid "This smell's really awful."
msgstr "这气味实在难闻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.GENERIC"
msgid "It's dead."
msgstr "已经死了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMCORPSE.REVIVING"
msgid "It's getting back up, watch out."
msgstr "又要起来了，小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD"
msgid "Even passing through, I get stared at."
msgstr "过路也得被盯着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD_LUNAR"
msgid "It's carrying moonlight now."
msgstr "它现在还带着月光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMGUARD_SHADOW"
msgid "Harder and harder to see it."
msgstr "越来越看不清它了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHAT"
msgid "Wear it and you have to put up with the smell."
msgstr "戴上还得忍住味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHEAD.BURNT"
msgid "Burned, it smells even worse."
msgstr "烧过味道更难受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHEAD.GENERIC"
msgid "Keep it far from camp."
msgstr "离营地远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE.BURNT"
msgid "Well, nobody can live there now."
msgstr "这下不能住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE.GENERIC"
msgid "I wouldn't want to live in a house like this."
msgstr "这种房子我可不想住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Have to rebuild it again."
msgstr "又得重盖了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "Wurt really put effort into building this."
msgstr "沃特搭得倒挺认真。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMKING"
msgid "Your Majesty, shall I give you food first?"
msgstr "陛下，要先给你吃的吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE.BURNT"
msgid "The throne's gone too."
msgstr "王位也没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Their king sits here."
msgstr "他们的国王坐这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Burned before it was finished."
msgstr "还没搭好就烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "What's Wurt up to now."
msgstr "沃特又在忙什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "Standing guard even without a king?"
msgstr "没有国王也要守着？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Now there's a king to guard."
msgstr "现在有国王可守了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_ARMORY"
msgid "They won't let me in."
msgstr "他们不让我进。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "Upgraded gear, and they still won't let me use it."
msgstr "装备升级了，还是不让我用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_LUNAR"
msgid "The moon changed it too."
msgstr "月亮也改变了它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_PRINCE"
msgid "Another heir to the throne."
msgstr "又有新的王位继承人了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_SHADOW"
msgid "Covered in shadow all over."
msgstr "浑身都带着暗影。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOL"
msgid "Lots of functions, but awkward to use."
msgstr "功能不少，用着却不顺手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOLSHED"
msgid "It's full of merm tools."
msgstr "里面都是鱼人的工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "Even repaired, it's still just for them."
msgstr "修过以后还是他们专用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "This one should be easier to use."
msgstr "这把应该好用一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MESSAGEBOTTLE"
msgid "Someone's letter floated here."
msgstr "有人写信漂到这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "An empty bottle. I'll keep it."
msgstr "空瓶子，先留着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "No workout today."
msgstr "今天不用练了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "This is more tiring than gym class."
msgstr "这比体育课还累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MILKYWHITES"
msgid "Don't use this as milk."
msgstr "这种东西别拿来当奶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINERHAT"
msgid "Frees up my hands to do stuff."
msgstr "能空出手来做事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINGOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINGOT"
msgid "A metal ingot. Give me one and I can hit stuff."
msgstr "金属锭。给我一根，我能敲点东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIBOATLANTERN"
msgid "Even little boats have lamps now."
msgstr "小船也有灯了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIFAN"
msgid "You have to run to get any breeze. What a pain."
msgstr "得跑起来才有风，真麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINIFLARE"
msgid "Lets everyone know where I am."
msgstr "让大家知道我在哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN.GENERIC"
msgid "You can recognize it from the picture."
msgstr "看图也能认出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Nothing drawn yet."
msgstr "还没画。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINISIGN_ITEM"
msgid "Stick it in the ground first."
msgstr "先插到地上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAUR"
msgid "Don't get in the way of its charge."
msgstr "别挡着它冲过来的路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAURCHEST"
msgid "All that trouble, there'd better be something useful in there."
msgstr "折腾这么久，里面最好有用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MINOTAURHORN"
msgid "Good thing it didn't gore me."
msgstr "还好没顶到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND.COLD"
msgid "Cooled off. At least it won't burn my hand."
msgstr "凉了，至少不烫手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND.GENERIC"
msgid "Careful, it's hot to hold."
msgstr "拿着的时候小心烫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MITEGLAND_COOKED"
msgid "Even roasted, I don't really want to eat it."
msgstr "烤过了我也不太想吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MMIKO_ARMOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MMIKO_ARMOR"
msgid "Wear this and I have to go on shift at a shrine?"
msgstr "穿着这个就要去神社值班？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MNAGINATA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MNAGINATA"
msgid "This naginata's long. Check your sides before turning."
msgstr "这把薙刀够长，转身时先看看旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.ABOVEGROUND"
msgid "It's out. Fast little thing."
msgstr "出来了，动作真快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.HELD"
msgid "Don't keep digging in my pocket."
msgstr "别在口袋里继续挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLE.UNDERGROUND"
msgid "Something's digging down there."
msgstr "下面有东西在挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEBAT"
msgid "Its nose stands out more than its face."
msgstr "鼻子比脸还显眼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEBATHILL"
msgid "We're really digging through its den?"
msgstr "真要从它的窝里翻东西？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEHAT"
msgid "I can see clearly, but the smell's rough."
msgstr "看得清了，味道可不好受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOLEHILL"
msgid "It's resting here."
msgstr "它在这里休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY"
msgid "There are no bananas in there, stop rummaging."
msgstr "里面没有香蕉，别翻了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYBARREL"
msgid "Seems like there's something inside."
msgstr "里面好像有东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYHUT.BURNT"
msgid "Wooden houses still don't like fire."
msgstr "木头房子还是怕火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Living in a tree sounds pretty cushy."
msgstr "住在树上也挺会享受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "Can't go in, but it sure keeps spitting stuff out."
msgstr "进去不行，往外倒东西倒挺勤。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "I think I've seen these parts before."
msgstr "这些零件好像见过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYPILLAR"
msgid "Monkeys like setting up pillars too."
msgstr "猴子也爱摆柱子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYQUEEN"
msgid "If you want bananas, you could've just said so."
msgstr "想要香蕉就早点说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEYTAIL"
msgid "Check for monkeys before picking."
msgstr "采之前先看看有没有猴子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Wear this and people follow my orders?"
msgstr "戴上就有人听我指挥吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONKEY_SMALLHAT"
msgid "Keeps out a bit of rain."
msgstr "能挡一点雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERLASAGNA"
msgid "I'll pass on this kind of lasagna."
msgstr "这种千层饼就算了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERMEAT"
msgid "Just looking at it kills my appetite."
msgstr "看着就没胃口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Drying doesn't make it taste any better."
msgstr "晾干也不能把味道变好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MONSTERTARTARE"
msgid "Keep looking, there's got to be something else to eat."
msgstr "再找找，肯定还有别的吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.BROKEN"
msgid "Fix it first."
msgstr "先修好再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.GENERIC"
msgid "Still missing something in the middle."
msgstr "中间还缺东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The moonlight changed it."
msgstr "月光把它变了样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.STAFFED"
msgid "It's set, and now I have to wait?"
msgstr "放好了，还得等？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Wrong staff."
msgstr "法杖拿错了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Even the butterflies are different here."
msgstr "这里的蝴蝶也不一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Hold it steady."
msgstr "拿稳一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Thin, and glowing too."
msgstr "薄薄的，还发着光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "A butterfly that grows into a tree."
msgstr "蝴蝶居然能种成树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.CAVE"
msgid "You can't see the moon underground."
msgstr "地下看不到月亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.GENERIC"
msgid "For checking moon phases."
msgstr "看月相用的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.GLASSED"
msgid "The water's not quite right."
msgstr "水面不太对劲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Full moon. Be careful tonight."
msgstr "满月，今晚小心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "New moon. It's even darker out there."
msgstr "新月，外面更暗了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon's waning."
msgstr "月亮在变小。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon's waxing."
msgstr "月亮在变大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS"
msgid "The edge is sharp."
msgstr "边缘很锋利。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASSAXE"
msgid "Chop faster, rest sooner."
msgstr "早点砍完就能早点休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_CHARGED"
msgid "Use it while it's still glowing."
msgstr "趁还亮着赶紧用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_ROCK"
msgid "Like a broken mirror."
msgstr "像面破镜子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "Moon wobsters live in there."
msgstr "月亮的龙虾住在里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKCRATER"
msgid "A gem can go here."
msgstr "这里能放一颗宝石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKIDOL"
msgid "Hold this and you can go in?"
msgstr "拿着它就能进去了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKNUGGET"
msgid "A rock that fell from the moon."
msgstr "月亮上掉下来的石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCKSEED"
msgid "There's something inside, gotta crack it open."
msgstr "里面还有东西，得敲开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONROCK_PIECES"
msgid "Can be broken up further."
msgstr "还能再敲小一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSPIDERDEN"
msgid "I want to touch this even less than a regular spider den."
msgstr "比普通的蜘蛛巢更不想碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "It's just glass now."
msgstr "现在只是玻璃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "There's still energy inside."
msgstr "里面还有能量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "A potato on my head. Have to put up with it for now."
msgstr "头上顶土豆也只能先忍了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_SPARK"
msgid "Don't let it touch me before it's stored."
msgstr "收起来之前别让它碰到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC"
msgid "Still discharging."
msgstr "还在放电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Still empty inside."
msgstr "里面还是空的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "My hair's standing straight up."
msgstr "头发全翘起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "Don't drift over here."
msgstr "别飘到我旁边来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "What did you just say?"
msgstr "你刚才说什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Have to keep assembling it."
msgstr "还要继续拼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "This is just one part of it."
msgstr "这里只是其中一部分。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "It seems to still be waiting for something else."
msgstr "它好像还在等别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Fished it up, and now it has to go to the rift."
msgstr "捞上来了，还得搬去裂隙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_GLASS"
msgid "It doesn't seem to like being on the ground."
msgstr "放地上它好像不满意。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ICON"
msgid "I remember where it goes."
msgstr "该放哪里，我记得。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Hauling this around again."
msgstr "又得搬着它走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_LINK"
msgid "What happens once they're all in place?"
msgstr "都放好以后会发生什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "There's a piece stuck inside."
msgstr "里面卡着一块。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Have to keep hitting it."
msgstr "还要继续敲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Something else buried in there."
msgstr "又有东西埋在里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_SEED"
msgid "Have to find a place for it."
msgstr "得给它找个位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_ALTAR_WARD"
msgid "Put it with the others."
msgstr "把它和另外几个放一起。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_CAP"
msgid "Doesn't look very tasty."
msgstr "这个看着就不太好吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_CAP_COOKED"
msgid "Cooked, still don't want to eat it much."
msgstr "熟了也没多想吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "Barely started."
msgstr "才搭好一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "Finally looks like something."
msgstr "总算像样了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "The energy's locked up inside."
msgstr "能量被关在里面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Getting close actually clears my head."
msgstr "靠近反而觉得脑袋清醒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Not glowing right now."
msgstr "现在不发光了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Plugged. At least it won't leak anymore."
msgstr "堵好了，至少不会再漏出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.BURNING"
msgid "Don't let the fire spread."
msgstr "别让火烧到旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.BURNT"
msgid "The leaves are all gone."
msgstr "叶子全没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Finally done chopping this one."
msgstr "这棵总算砍完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE.GENERIC"
msgid "Even moon trees need chopping."
msgstr "月亮的树也要砍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Would make a nice decoration."
msgstr "这个拿来做装饰挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "Dried, it can be put away."
msgstr "晒干以后可以收起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSE"
msgid "So is this a moose or a goose."
msgstr "这到底算鹿还是鹅。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSEEGG"
msgid "It's already moving inside."
msgstr "里面已经在动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Don't stand here, it'll come back."
msgstr "别站这里，它会回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOQUECA"
msgid "Warly, make this again next time."
msgstr "沃利，下次也做这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MORTALBLADE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MORTALBLADE"
msgid "Better not to draw this sword casually."
msgstr "这把刀最好别随便拔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO.GENERIC"
msgid "Don't bite me!"
msgstr "别叮我！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITO.HELD"
msgid "I hope that's not all my blood in there."
msgstr "里面该不会都是我的血。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOBOMB"
msgid "Throw it far. Don't blow yourself up."
msgstr "扔远一点，别炸到自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Plants' tastes are really hard to understand."
msgstr "植物的口味真难理解。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMERMSALVE"
msgid "For healing merms."
msgstr "给鱼人治伤的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOMUSK"
msgid "If only it kept mosquitoes away."
msgstr "能让蚊子别过来就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSQUITOSACK"
msgid "Don't crush it when packing."
msgstr "装的时候别挤破了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOSSLING"
msgid "So rowdy even when small."
msgstr "小的也这么能闹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOUND.DUG"
msgid "It's all dug up. Remember to clean up."
msgstr "都挖开了，记得收拾。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MOUND.GENERIC"
msgid "Better not disturb them."
msgstr "还是别打扰人家了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MSURFBOARD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MSURFBOARD_ITEM"
msgid "I'll watch from the shore first."
msgstr "我还是先在岸上看着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULLEDDRINK"
msgid "One sip and I'm warm."
msgstr "喝一口就暖起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Some come through here, and some never come back."
msgstr "有人从这里来，也有人再没回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Stands out even more with moon rock."
msgstr "换成月岩以后更显眼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Two tools in one, saves trouble. I like it."
msgstr "一件顶两件，省事。我喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHGNOME"
msgid "Don't get close, it'll shake spores all over."
msgstr "别靠近，会抖一身孢子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMBOMB"
msgid "Mushrooms explode too, get away."
msgstr "蘑菇也会炸，快躲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMHAT"
msgid "Wear it and you count as growing mushrooms."
msgstr "戴上就算长蘑菇了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Well, it won't be growing anymore."
msgstr "这下不会再长了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Growing way too fast."
msgstr "长得也太快了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "The mushrooms all burned up."
msgstr "蘑菇全烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Put in a mushroom first."
msgstr "先放个蘑菇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Wait a little more to harvest more."
msgstr "再等一下能多收点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Need a new living log again."
msgstr "又得换活木。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Too cold to grow anything."
msgstr "这么冷，长不出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "Only this much so far."
msgstr "才长出这么一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "It's full, time to pick."
msgstr "长满了，该采了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "The light's burned away."
msgstr "灯已经烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Put something glowing in first."
msgstr "先装点发光的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "It's nice lit up like this."
msgstr "这样亮着就很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "All the color burned away."
msgstr "颜色全烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "You have to choose colors too."
msgstr "还要挑颜色。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "I could read sitting here."
msgstr "坐这里看书也行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "It's covered in acid, don't touch."
msgstr "上面都是酸，别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "Don't let spores fall on my head."
msgstr "孢子别落在我头上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Such a big mushroom."
msgstr "这么大的蘑菇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_MOON"
msgid "Moon mushroom trees are even weirder."
msgstr "月亮的蘑菇树更奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "Acid's dripping off it."
msgstr "酸都挂在上面了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Stay back, don't breathe it in."
msgstr "离远一点，别吸进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "This counts as small?"
msgstr "这种算小的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "Don't stand under it either."
msgstr "下面也别站。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Far enough away and I can't smell it."
msgstr "远一点就闻不到了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "My neck's tired just looking up."
msgstr "仰头看也太累了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "Webs and acid, all stuck together."
msgstr "蛛网和酸，全沾在一起了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "Spiders live in the tree too."
msgstr "树上还住着蜘蛛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBEARGER"
msgid "Even tougher than last time."
msgstr "比上次还难应付。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBIRD"
msgid "Already looks harder to deal with than before."
msgstr "看着就比以前难对付。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "While it's eating, let's get out of here."
msgstr "趁它在吃东西，先走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "Don't look at me, I'm still alive."
msgstr "别盯着我，我还活着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDDEERCLOPS"
msgid "That eye's glowing wrong."
msgstr "那只眼睛亮得不对。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "Finally stopped."
msgstr "总算停下来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "What happened to it!"
msgstr "它怎么变成这样了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Don't wake it, just leave."
msgstr "别吵醒，直接走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATEDWARG"
msgid "Eyes glowing like that, keep back first."
msgstr "眼睛亮成这样，先离远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "It's really over this time."
msgstr "这回真结束了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Not cute at all anymore."
msgstr "一点都不可爱了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "It's asleep, keep it down."
msgstr "它睡着了，轻一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_DROPPER"
msgid "Webber, save this for your friends."
msgstr "韦伯，这个留给你的朋友吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_HEALER"
msgid "Thanks, I'll skip tasting it today."
msgstr "谢谢，我今天就不尝了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_HIDER"
msgid "You put a lot of work in, but I'm not eating it."
msgstr "做得很用心，不过我不吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_MOON"
msgid "Save the moon flavor for the spiders too."
msgstr "月亮味的也留给蜘蛛吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_SPITTER"
msgid "Just don't put it in my food."
msgstr "别往我的饭里放就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_WARRIOR"
msgid "Your little buddies will like it."
msgstr "你的小伙伴会喜欢的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.MUTATOR_WATER"
msgid "Give it to the ones that can swim."
msgstr "拿给会游泳的那几只。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_FOXMASK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_FOXMASK"
msgid "With this on, nobody can tell I'm spacing out."
msgstr "戴着就看不出我在发呆了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_PANTSU
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_PANTSU"
msgid "Whose are these? Put them away, quick."
msgstr "谁的？快收起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_SCARF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.M_SCARF"
msgid "With a scarf, the wind isn't so cold."
msgstr "有围巾，风就没那么冷了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NATURE_BLUEPRINT"
msgid "This set of flowers is really pretty."
msgstr "这套花挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTCAPHAT"
msgid "Wear it and I won't want to get up."
msgstr "戴上就不想起床了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTLIGHT"
msgid "There's light, but it's not very reassuring."
msgstr "有光，却没多安心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREFUEL"
msgid "Looking at it starts my headache."
msgstr "看着头就开始疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREGROWTH"
msgid "Best not touch crystals like this."
msgstr "这种晶体最好别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARELIGHT"
msgid "When does it light up?"
msgstr "它什么时候会亮？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMAREPIE"
msgid "Will eating this really not give me nightmares?"
msgstr "吃完真的不会做噩梦？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Safe now."
msgstr "现在安全。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Almost over, wait a bit."
msgstr "快结束了，再等一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "No reaction here."
msgstr "这里没有反应。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It'll last a while yet."
msgstr "还会持续一阵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "It's fading."
msgstr "正在退去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "Time to get ready to leave."
msgstr "该准备离开了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "It's getting stronger, go now."
msgstr "越来越强了，快走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTSTICK"
msgid "Don't let the shock hit yourself."
msgstr "别让电碰到自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NIGHTSWORD"
msgid "Just holding it feels bad."
msgstr "拿着就觉得不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NITRE"
msgid "Keep it for now, it'll be useful later."
msgstr "先收着，之后会用到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NITRE_FORMATION"
msgid "Still needs more digging."
msgstr "还要再挖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NONSLIPGRIT"
msgid "With this, slipping's less likely."
msgstr "有了这个就不容易滑倒。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "This one should grip even better."
msgstr "这份防滑效果应该更好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "Now I even have to check whether the soil has enough fertilizer."
msgstr "连土里的肥够不够也要检查。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR"
msgid "Just row. It won't move otherwise."
msgstr "划就是了，反正不划不动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_DRIFTWOOD"
msgid "A bit lighter, so my arms ache a bit less."
msgstr "轻一点，手能少酸一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OAR_MONKEY"
msgid "Good for rowing and fighting both."
msgstr "划船打架两边都用得上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OASISLAKE.EMPTY"
msgid "The water's gone, and no fish to catch either."
msgstr "水干了，鱼也没得钓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OASISLAKE.GENERIC"
msgid "Finally, somewhere that isn't all sand."
msgstr "总算有个不全是沙子的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "All that waiting for this?"
msgstr "等了半天就钓到这个？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "Just watch if it moves."
msgstr "看它动没动就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "Yellow, easy to see on the water."
msgstr "黄的，在水上看得清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "A float made from black feathers."
msgstr "黑羽毛做的浮标。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "This one should cast a little farther."
msgstr "这个应该能甩远一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "Catching that bird took some doing."
msgstr "抓那只鸟可没少费力。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "No bobber on it yet."
msgstr "还没装浮标。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "This bobber's a little easier on the eyes."
msgstr "这个浮标顺眼一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Red, hard to miss."
msgstr "红的，不容易看漏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Winter feathers come in handy too."
msgstr "冬天的羽毛也能派上用场。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Fish are easier to catch when they're calm."
msgstr "鱼能安静一点就好钓了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "This heavy, it's tiring to cast."
msgstr "这么沉，甩起来很累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "It only works in the rain?"
msgstr "非得下雨才好用？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "Fishing out in the snow now."
msgstr "还要顶着雪钓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Try this one at night."
msgstr "夜里用这个试试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Switch to this one at dusk."
msgstr "傍晚再换这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "This one's for daytime."
msgstr "白天用这枚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "For little fish at night."
msgstr "夜里给小鱼准备的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Little fish at dusk go for this one."
msgstr "傍晚的小鱼吃这套。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "For little fish during the day."
msgstr "白天钓小鱼的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISHINGROD"
msgid "New rod, still have to wait."
msgstr "换了竿，还是得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Hopefully it tastes better than it looks."
msgstr "希望吃起来比看起来好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "That was tough to reel in."
msgstr "钓上来可真费劲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "With a face like that, better be careful."
msgstr "这种长相，还是小心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "A black fish. Kinda pretty."
msgstr "黑色的鱼，也挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "So is this a fish or a corn cob."
msgstr "这到底是鱼还是玉米。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "A koi. Think my luck'll improve?"
msgstr "锦鲤，运气能好一点吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "This one's a really pretty color too."
msgstr "这只颜色也很漂亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "So cold it hurts my hand to hold."
msgstr "拿着冷得手疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "It smells sweet before it's even cooked."
msgstr "还没煮就有股甜味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_1"
msgid "So small, not even one bite."
msgstr "这么小，还不够一口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_2"
msgid "At least I'm not going back empty-handed."
msgstr "至少没空手回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_3"
msgid "Need a few more to make a meal."
msgstr "要再钓几条才够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_4"
msgid "Dinner can't just be this."
msgstr "晚饭不能只靠它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_5"
msgid "It actually looks like popcorn."
msgstr "居然像爆米花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_6"
msgid "It swims around with leaves on it."
msgstr "游着还带叶子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Flowers can bloom on a fish's head too."
msgstr "鱼头上也能开花。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_8"
msgid "It's burning my hand, put it down."
msgstr "烫手，先放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANFISH_SMALL_9"
msgid "Watch out for this kind spitting things too."
msgstr "这种鱼也得小心它吐东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREE"
msgid "Trees are growing out at sea now, too."
msgstr "树也长到海里来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREENUT"
msgid "Something's still growing in there."
msgstr "里面还有东西在长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANTREE_PILLAR"
msgid "Plenty of shade. Could stop and rest a bit."
msgstr "阴凉够大，能停下来歇会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE"
msgid "Hanging vines. Don't let them tangle the boat."
msgstr "垂下来的藤，别缠住船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE_COCOON"
msgid "Don't touch it, there might be spiders inside."
msgstr "别碰，里面可能有蜘蛛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "Burned out, so nothing's coming out of it now."
msgstr "烧完就不怕里面出来东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "We're out. Check the boat for damage first."
msgstr "出来了，先看看船有没有坏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEANWHIRLPORTAL"
msgid "Fix the boat before going in."
msgstr "进去以前先把船修好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Got something."
msgstr "有东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Got away again. Have to check it."
msgstr "又跑了，得检查一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "Fixed. Try again."
msgstr "修好了，再试一次。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "Let it wait for fish for me."
msgstr "让它替我等鱼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "It's down. Wait and haul it up."
msgstr "放下去了，等着收。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "Find somewhere with lots of fish first."
msgstr "先找个鱼多的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.GENERIC"
msgid "No kelp in it yet."
msgstr "里面还没放海带。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "That's enough kelp."
msgstr "海带已经够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "Can still add some more."
msgstr "还可以再放一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "Even upgraded, it needs kelp first."
msgstr "升级了也得先放海带。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "It's pretty full."
msgstr "装得挺满。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "A little more."
msgstr "再添一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC1000000
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OINC1000000"
msgid "This much money, could we buy lunch first."
msgstr "这么多钱，能不能先买一份午饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONEMANBAND"
msgid "One person's already noisy enough."
msgstr "一个人就够吵了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION"
msgid "Slicing it's the worst part."
msgstr "切的时候最麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_COOKED"
msgid "Not so sharp once it's cooked."
msgstr "熟了以后不那么冲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_OVERSIZED"
msgid "Will I still be able to see after slicing this."
msgstr "切完眼睛还能看清吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ONION_SEEDS"
msgid "Plant a few for seasoning and that's enough."
msgstr "种一些调味就够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALPRECIOUSGEM"
msgid "The color keeps changing. Pretty."
msgstr "颜色一直在变，挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OPALSTAFF"
msgid "It keeps me cool in summer."
msgstr "夏天就靠它凉快了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEAMULET"
msgid "Finally, no more bending down to pick things up."
msgstr "终于不用弯腰捡了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEGEM"
msgid "Put the orange one away first."
msgstr "橙色这颗先收好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGEMOONEYE"
msgid "Marking this spot."
msgstr "这里做个标记。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ORANGESTAFF"
msgid "Not having to walk is great."
msgstr "能不走路真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTER"
msgid "Don't take stuff off the boat."
msgstr "别把船上的东西拿走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN.GENERIC"
msgid "Their den."
msgstr "它们的窝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "Something's hidden inside."
msgstr "里面藏了东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.OTTERDEN_DEAD"
msgid "It's broken, don't step on it."
msgstr "破了，别踩上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONETREE"
msgid "Trees by the sea have fruit too."
msgstr "海边的树也有果子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SAPLING"
msgid "Have to wait for it to grow slowly."
msgstr "还得等它慢慢长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SCALE"
msgid "A hard flake peeled from the tree."
msgstr "树上剥下来的硬片。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PALMCONE_SEED"
msgid "Better to plant it by the sea."
msgstr "种在海边会合适一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANDORASCHEST"
msgid "Stand back before opening it."
msgstr "打开之前先往后站。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANETTONE"
msgid "Just give me a slice. A thick one."
msgstr "分我一片就好，厚一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PANFLUTE"
msgid "Let them all sleep a while."
msgstr "让它们都睡一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PAPYRUS"
msgid "A sheet of paper with nothing on it yet."
msgstr "一张还没写字的纸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PAVLOVA"
msgid "I should take a picture... no camera here."
msgstr "这个得先拍……这里没有相机。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEGHOOK"
msgid "What it spits eats away at your gear."
msgstr "它吐的东西会腐蚀装备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUIN"
msgid "Coming over in droves. How lively."
msgstr "一群群地过来，真热闹。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "That really doesn't smell good."
msgstr "这个味道真不好闻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "It's dead, stop touching it."
msgstr "已经死了，别碰了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "It's clearly dead, how is it moving!"
msgstr "明明已经死了，怎么还会动！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER"
msgid "Don't bite it directly."
msgstr "别直接咬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPERPOPPER"
msgid "Get water ready before eating."
msgstr "先准备水再吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_COOKED"
msgid "Cooked and still spicy."
msgstr "熟了也还是辣。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_OVERSIZED"
msgid "How many people could this knock out."
msgstr "这个能辣倒多少人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEPPER_SEEDS"
msgid "Just plant a few."
msgstr "少种几棵就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERD"
msgid "Leave me some berries!"
msgstr "给我留点浆果！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDFAN"
msgid "One wave cools you down for half a day."
msgstr "扇一下能凉快半天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.BURNT"
msgid "No more holiday."
msgstr "节也过不成了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Plant something first."
msgstr "先种点东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PERDSHRINE.GENERIC"
msgid "More new stuff to make."
msgstr "又能做些新东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PEROGIES"
msgid "This one's nice to eat."
msgstr "这份吃着挺舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS"
msgid "Picked them, need somewhere to put them."
msgstr "摘下来了，找个地方放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_DRIED"
msgid "Still has a little floral scent."
msgstr "还留着一点花香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_EVIL"
msgid "Even holding them feels wrong."
msgstr "拿着都不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETALS_EVIL_DRIED"
msgid "Better not eat these casually."
msgstr "这花瓣还是别随便吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PETRIFIED_TREE"
msgid "Even the trees turned to stone."
msgstr "树都变成石头了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHLEGM"
msgid "Get it away from me, now."
msgstr "立刻拿远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PHONOGRAPH"
msgid "Change the song, I've heard enough of that one."
msgstr "换一首，刚才那首听够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKAXE"
msgid "Pickaxe. I like smashing stuff."
msgstr "镐。敲东西我喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "As long as it digs faster."
msgstr "能快点挖完就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PICKLEDHERRING"
msgid "This taste's acceptable."
msgstr "这个味道还能接受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE1"
msgid "Stop staring at me."
msgstr "别一直盯着我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE2"
msgid "You took all the gold."
msgstr "金子全被你抢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE3"
msgid "Don't fling mud on me."
msgstr "泥别甩我身上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITE4"
msgid "Can you go fight someone else."
msgstr "能去找别人打吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER1"
msgid "Pay attention, it's starting."
msgstr "看清楚，要开打了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER2"
msgid "Put the gold down first."
msgstr "先把金子放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER3"
msgid "Don't stomp the arena into mud."
msgstr "别把场地踩得全是泥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGELITEFIGHTER4"
msgid "Hurry up and finish."
msgstr "快点打完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGUARD"
msgid "Better not go near this kind."
msgstr "这种就别靠近了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGGYBACK"
msgid "Too heavy on the back, can't walk fast."
msgstr "背着太重，走不快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHEAD.BURNT"
msgid "Doesn't look any better burned."
msgstr "烧过也不好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHEAD.GENERIC"
msgid "Who put this here."
msgstr "谁把这个放在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.BURNT"
msgid "The house is gone."
msgstr "房子没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.FULL"
msgid "Its nose is pressed up on the window."
msgstr "鼻子都贴到窗上了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.GENERIC"
msgid "They live better than I do."
msgstr "它们住得比我好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "I know you're home. No need to pretend."
msgstr "知道你在家，不用装了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGKING"
msgid "You can hear him from over here. I brought something to trade."
msgstr "站远一点也能听见吧。我带了东西来换。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.DEAD"
msgid "It's already gone."
msgstr "已经没气了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Stay close, no fighting."
msgstr "跟好，别打起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.GENERIC"
msgid "Too loud when it talks."
msgstr "说话也太大声了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.GUARD"
msgid "He doesn't want me near."
msgstr "他可不想让我靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGMAN.WEREPIG"
msgid "Back away, he's changed!"
msgstr "快退，他变了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.BURNT"
msgid "Burned out, can't use it."
msgstr "烧坏了，不能用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Give it some meat first."
msgstr "先给它点肉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSHRINE.GENERIC"
msgid "Prepping holiday materials again."
msgstr "又要准备节日材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGSKIN"
msgid "Clean it first."
msgstr "先处理干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGTENT"
msgid "You can smell what's inside from out here."
msgstr "外面就闻得到里面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIGTORCH"
msgid "They sure look comfy around that fire."
msgstr "他们围着火待得挺舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_COIN"
msgid "Can hire a helper in a fight."
msgstr "打架时能请个帮手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIG_TOKEN"
msgid "Keep it, it looks useful."
msgstr "先收着，像是有用的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINECONE"
msgid "Plant it and it's the next round of chopping."
msgstr "种下去就是下一轮砍树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PINECONE_SAPLING"
msgid "Grow. I'll sit for a while."
msgstr "长吧，我先坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATE_FLAG_POLE"
msgid "So hanging a flag means you've taken this place?"
msgstr "挂旗就算占下这里了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PIRATE_STASH"
msgid "Buried pretty carefully."
msgstr "埋得还挺仔细。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PITCHFORK"
msgid "Pitchfork. Lighter than a shovel, it'll do."
msgstr "叉子。比铲子轻，凑合。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTMEAT"
msgid "Meat growing on plants, still kind of hard to accept."
msgstr "植物上长肉，还是有点难接受。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTMEAT_COOKED"
msgid "It's cooked. Let me smell it first."
msgstr "煮熟了，先闻一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANTREGISTRYHAT"
msgid "Even growing vegetables needs research gear on your head."
msgstr "连种菜都得戴着做研究。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "Can't tell what it is yet."
msgstr "还看不出是什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Growing way too slowly."
msgstr "长得也太慢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.READY"
msgid "Finally ready to pick."
msgstr "终于可以摘了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Heat got it. All that planting for nothing."
msgstr "热坏了，白种了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "A puppet play written by C.W. Let's read the lines carefully first."
msgstr "C.W.写的人偶戏。先把台词看清楚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "Let's see how many lines I've got."
msgstr "先看看我有多少句。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "The signature's just one letter?"
msgstr "署名只有一个字母？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Doesn't look like a light story."
msgstr "看着就不是轻松的故事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.ATTACKER"
msgid "%s, put your weapon down first."
msgstr "%s，先把武器放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s, put out the fire, then we'll talk."
msgstr "%s，火灭了再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.GENERIC"
msgid "%s, nothing much going on today, right?"
msgstr "%s，今天也没什么事吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.GHOST"
msgid "%s, don't go far, I'll figure something out."
msgstr "%s，别走远，我会想办法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.MURDERER"
msgid "Stop hurting people!"
msgstr "别再伤害别人！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER.REVIVER"
msgid "%s, thanks for bringing them back."
msgstr "%s，谢谢你把人带回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "He's not available right now. Wait till he's free."
msgstr "他现在不方便。等他空下来再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYER_HOSTED.ME"
msgid "Looking at another me is still kind of weird."
msgstr "看着另一个自己，还是有点奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PLAYING_CARD"
msgid "Only one card. Can't play with that."
msgstr "就一张，还玩不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "Wanda's watch repair tool."
msgstr "旺达修表的工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "It can find the time before the injury."
msgstr "能把受伤前的时间找回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "Have to let it run a while."
msgstr "还得让它走一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PARTS"
msgid "These parts are way too weird."
msgstr "这些零件也太奇怪了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "Saves a long walk."
msgstr "能省下好长一段路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "Can't open it yet."
msgstr "暂时还开不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "Is there a light on the other side?"
msgstr "另一边有灯吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "If it goes straight there, I'm not walking."
msgstr "能直接到就不走路了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "Can the landing be a little softer."
msgstr "落下来的时候能轻一点吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "Going back, no need to walk it all again."
msgstr "回去不用再走一遍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "Not ready yet."
msgstr "还没准备好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "With it, I can bring people back."
msgstr "有它就能把人带回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "Have to wait for it to recover."
msgstr "要等它恢复。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Saves me from one hit."
msgstr "能少挨一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "Can't use it right now."
msgstr "现在还不能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "Hitting people with a pocket watch. That's something."
msgstr "拿怀表打人也太特别了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POCKET_SCALE"
msgid "Bringing a scale, but I have to catch something first."
msgstr "带着称，也得先钓到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLISHCOOKIE"
msgid "Save two for later."
msgstr "留两块，晚点再吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLY_ROGERS"
msgid "A bird that helps pick things up."
msgstr "帮忙捡东西的鸟。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POLLY_ROGERSHAT"
msgid "The little bird picks things up, I wear the hat."
msgstr "小鸟负责捡，我负责戴帽子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE"
msgid "Takes longer to peel than to eat."
msgstr "剥起来比吃起来费时。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_COOKED"
msgid "Cooked, you still have to eat seed by seed."
msgstr "熟了也得一粒粒吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "Peel this and the day's over."
msgstr "剥完今天就过去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Means even more peeling later."
msgstr "以后还得剥更多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POND"
msgid "Can't see the bottom. Don't stand too near the edge."
msgstr "看不清下面，别站太靠边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PONDEEL"
msgid "Cook it into something good."
msgstr "做得好吃一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PONDFISH"
msgid "One more dish tonight."
msgstr "今晚能加道菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POND_ALGAE"
msgid "Don't get it on the hook."
msgstr "别挂到鱼钩上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POOP"
msgid "Why does someone always have to do this job."
msgstr "这种差事为什么总得有人做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "One whirr and it's all blended."
msgstr "嗡一下，就都打好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "That long to wait."
msgstr "还要等这么久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "Almost done, I'll wait right here."
msgstr "快好了，我就在旁边等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Ready to eat. Dish me up some."
msgstr "能吃了，给我盛一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Nothing inside."
msgstr "里面什么也没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Can cook anywhere you go."
msgstr "走到哪里都能做饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "With this I can carry fewer rocks."
msgstr "有这个就能少带些石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Seasoning's ground."
msgstr "调料磨好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "It's only worth making if it tastes better."
msgstr "味道好一点才值得做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLETENT"
msgid "I want a good sleep in there."
msgstr "想在里面好好睡一觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PORTABLETENT_ITEM"
msgid "Find somewhere quiet to set it up."
msgstr "找个安静地方搭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO"
msgid "Any way you cook it beats eating it raw."
msgstr "怎么做都比生吃好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOSACK"
msgid "This sack's really heavy to carry."
msgstr "这一袋搬着真沉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOSOUFFLE"
msgid "A meal like this is worth eating properly."
msgstr "这种饭值得认真吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATOTORNADO"
msgid "Just right to eat on the go."
msgstr "边走边吃的刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_COOKED"
msgid "It's hot, blow on it first."
msgstr "热乎的，先吹一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_OVERSIZED"
msgid "One of these makes several meals."
msgstr "这一颗够做几顿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTATO_SEEDS"
msgid "Have to wait another season."
msgstr "还得再等一季。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POTTEDFERN"
msgid "Good, one that doesn't need much care."
msgstr "不用太照顾的就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWCAKE"
msgid "It's sat this long without spoiling. Not eating it."
msgstr "放这么久都不坏，我不吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.POWDER_MONKEY"
msgid "Don't take our boat apart!"
msgstr "别拆我们的船！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "Empty, have to get more water."
msgstr "空了，还是得去装水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "Saves me a few trips for water."
msgstr "能少跑几次打水了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PRIME_MATE"
msgid "So the biggest hat's the leader?"
msgstr "帽子最大的那个是头领？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.GENERIC"
msgid "This one looks pretty lively."
msgstr "这只看着挺精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.HELD"
msgid "Don't peck, I'll let you go in a second."
msgstr "别啄我，马上放你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUFFIN.SLEEPING"
msgid "Sleeping so comfortably."
msgstr "睡得真舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN"
msgid "Better as pie."
msgstr "做成派比较好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINCARVER"
msgid "Don't carve your own hand."
msgstr "别刻到自己的手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINCOOKIE"
msgid "Pumpkin makes good cookies too."
msgstr "南瓜做饼干也很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "Kind of hard to see in it."
msgstr "戴上以后看东西有点费劲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "No holes, so you can't see in it."
msgstr "没有孔，戴上也看不见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKINPIE"
msgid "Give me a little piece first. A bit bigger's fine."
msgstr "先给我一小块。再大一点也行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_COOKED"
msgid "If only it were made sweet."
msgstr "要是做成甜的就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_LANTERN"
msgid "Don't stick it in my face at night."
msgstr "晚上别突然放我面前。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Hollow it out and a person could sit in it."
msgstr "掏空以后人都能坐进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUMPKIN_SEEDS"
msgid "If you want pie, you start here."
msgstr "想吃派还得从这里开始。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUNCHINGBAG"
msgid "It counts up after you hit it."
msgstr "打完还会报数。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PUREBRILLIANCE"
msgid "Don't shine that in my eyes."
msgstr "别对着眼睛照。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEAMULET"
msgid "It keeps talking. Too noisy."
msgstr "它一直在说话，太吵了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEGEM"
msgid "Stare too long and my mind wanders."
msgstr "看久了有点走神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.PURPLEMOONEYE"
msgid "Good for marking, just stop looking at me."
msgstr "做标记很好，别一直看我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "It's still eating. I can catch my breath."
msgstr "它还在吃，能喘口气了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Need to make offerings, quick."
msgstr "得赶紧做贡品。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Don't bump the post."
msgstr "别撞到柱子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "The vines got all the way here."
msgstr "藤都爬到这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "That's a big carving."
msgstr "雕得挺大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It's been sitting here for a long time."
msgstr "已经摆了很久了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Just don't face those eyes at me."
msgstr "眼睛别朝着我就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "It's already very weak. Don't push it to walk."
msgstr "它已经很虚弱了。别再催它走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Not a single berry."
msgstr "一颗浆果也没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Even has to be in a silver bowl."
msgstr "还得用银碗装。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Have to plant carrots from scratch too."
msgstr "胡萝卜也要现种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "This dish bakes a big portion."
msgstr "这盘能烤一大份。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "This one's for small portions."
msgstr "小份用这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN1"
msgid "Only this little."
msgstr "才这么一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN2"
msgid "Can trade for some materials now."
msgstr "能换些材料了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN3"
msgid "This one should be worth a lot."
msgstr "这枚应该挺值钱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_COIN4"
msgid "A bit closer to getting back."
msgstr "离回去又近一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "This is fresh, don't waste it."
msgstr "这个新鲜，别浪费。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Save me a taste."
msgstr "留一点给我尝尝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Put it down and just wait."
msgstr "放下去等就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_CRATE"
msgid "It's full of cookware."
msgstr "里面全是厨具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FERN"
msgid "We're eating this too?"
msgstr "这也是要拿来吃的？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Finally, I can bake something."
msgstr "总算能烤点东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked leaves are still leaves."
msgstr "叶子煮熟也还是叶子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Bring it to the altar."
msgstr "端去祭坛吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This one should suit its taste."
msgstr "这份应该合它口味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Right dish, just too little of it."
msgstr "对了，就是量太少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "This isn't what it wants."
msgstr "它想吃的不是这份。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Burned. Make it over."
msgstr "烧焦了，重新做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Good for seasoning, just not too much."
msgstr "调味可以，别放太多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Tastes better roasted."
msgstr "烤熟味道就好一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Have to plant garlic from scratch too."
msgstr "蒜也要从头种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATKID"
msgid "This one's still little, don't scare it."
msgstr "这只还小，别吓着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Warm it up before drinking."
msgstr "喝之前先热一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "She's still looking after her kid."
msgstr "她还在照顾孩子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL"
msgid "Keep an eye on it while grilling."
msgstr "烤的时候看着点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "Set up the grill first."
msgstr "先把烤架装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Can only grill this little at a time."
msgstr "一次只能烤这么一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "A small grill, not too heavy."
msgstr "小烤架，拿着不太重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_HOE"
msgid "Off to work the fields again."
msgstr "又要下地干活。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_KEY"
msgid "Let's see what it opens."
msgstr "先看看能开哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "The park key. Don't lose it."
msgstr "公园的钥匙，别弄丢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Like the lights on the way home."
msgstr "像回家路上的灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "This little light's enough."
msgstr "这点光也够用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "Even have to grind the flour myself."
msgstr "磨面粉也要自己来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Better stay away from the door."
msgstr "还是离门口远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Let's see what I can trade for."
msgstr "看看能换些什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "There's always more to buy than money."
msgstr "想买的总比钱多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "This batch should be safe to eat."
msgstr "这批应该能放心吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Mushrooms growing on a stump."
msgstr "树桩上长着蘑菇。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "All picked. Don't know if they'll grow back."
msgstr "采完了，不知道还长不长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION"
msgid "I'm not crying, I'm just cutting onions."
msgstr "我没有哭，只是在切洋葱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Not so sharp once it's cooked."
msgstr "熟了就没那么冲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Plant however much you need."
msgstr "要用多少就种多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_OVEN"
msgid "Don't forget to watch the time."
msgstr "别忘了看时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Have to build the oven first again."
msgstr "又得先搭炉子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Iron spikes. It hurts if you touch them."
msgstr "是铁尖，碰了会痛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "A nice quiet statue."
msgstr "安安静静的雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Way too lifelike."
msgstr "做得太像真的了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "No water for a long time now."
msgstr "已经很久没水了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Can go in now."
msgstr "能进去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Have to find a key again."
msgstr "又得找钥匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "I can't read the stone tablet either."
msgstr "石碑也看不懂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Don't knock it over."
msgstr "别打翻了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Why did that rock just run away."
msgstr "石头怎么跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It stopped moving."
msgstr "已经不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "It's still in the mood for a stroll."
msgstr "它还有心情散步。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Don't bother it, go around."
msgstr "别吵它，绕着走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Good food needs a good plate."
msgstr "好菜还得配好盘子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "This water's definitely not for drinking."
msgstr "这水可不能直接喝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Another road with no way back."
msgstr "又是一条回不去的路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "This time we can go back, right?"
msgstr "这次总能回去了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT"
msgid "One pot makes more."
msgstr "一锅能煮更多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO"
msgid "Boiled, at least it fills me up."
msgstr "煮熟了总能吃饱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Eat while it's hot."
msgstr "热的时候吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Have to plant potatoes from scratch too."
msgstr "土豆也要现种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "The pot's hung up pretty securely."
msgstr "锅挂得还挺稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Set it up before hanging the pot."
msgstr "装好才能挂锅。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "A small portion is enough."
msgstr "做小份就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Don't walk away while making syrup."
msgstr "熬糖浆别走开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "This isn't even fit to offer."
msgstr "这个连献上去都不合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "If it weren't broken I could ride it back."
msgstr "要是没坏还能骑回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Even the carriage got taken apart."
msgstr "车也被拆散了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "It must have been beautiful once."
msgstr "以前应该很漂亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Even the chimney's fallen down."
msgstr "烟囱都塌了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Same with this house."
msgstr "这家也一样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Time stopped here."
msgstr "时间停在这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "Not much left of the clock tower."
msgstr "钟楼也没剩下多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Nobody lives here now."
msgstr "已经没人住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "The whole town was destroyed."
msgstr "整个镇子都被毁了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Where did the people who lived here go?"
msgstr "以前住在这里的人去了哪里？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "No shop behind the door either."
msgstr "门后也没有店了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "The roof fell to the ground."
msgstr "屋顶掉到地上了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Are the things inside alright?"
msgstr "里面的东西还好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Locked. Need a key."
msgstr "锁着，得找钥匙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALMON"
msgid "It's fresh. Cook it quick."
msgstr "新鲜的，赶紧做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Ready for the table."
msgstr "可以上桌了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT"
msgid "For seasoning, don't overdo it."
msgstr "调味用，别放过量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Grind it to salt for seasoning."
msgstr "磨成盐就能调味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Have to wait a while."
msgstr "还得慢慢等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt's formed, collect it."
msgstr "盐结好了，收起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "It goes beside the salt pond."
msgstr "得放到盐池边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAP"
msgid "It's sweet. Can boil it into syrup."
msgstr "甜甜的，能熬糖浆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "Hang it up, then wait to collect."
msgstr "挂好就能等着收。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAPLING"
msgid "Nothing left to pick."
msgstr "已经采不到东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "It's gone bad, can't be cooked."
msgstr "坏了，不能拿来煮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Open it, then still have to plant."
msgstr "拆开还得种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Better leave this job to someone else."
msgstr "这种差事还是找别人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Ground up, it smells pretty good."
msgstr "磨好闻着挺香。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "This twig's growing kind of weird."
msgstr "这枝子长得有点奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Already picked."
msgstr "已经摘完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "Have to grind it for seasoning."
msgstr "还得磨碎才能调味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "Sweet sap comes out of here."
msgstr "里面能取到甜树液。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Just a stump left."
msgstr "只剩树桩了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Bugs came for the sweet smell too."
msgstr "虫子也闻着甜味来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "The bucket's still empty."
msgstr "桶还空着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "It's full, can collect now."
msgstr "满了，可以收。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It seems like it can't take any more."
msgstr "它好像受不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Too much hair."
msgstr "毛也太多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "You're the one to ask about things here, right?"
msgstr "这里的事情得问您吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Wait till he wakes up."
msgstr "等他醒了再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Needs a good repair."
msgstr "得好好修一下了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Nobody can live there anymore."
msgstr "已经住不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Desserts all depend on this."
msgstr "甜点就靠这个了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO"
msgid "A nice red color."
msgstr "这个红得挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Should make good soup."
msgstr "煮汤应该不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Plant first, then wait."
msgstr "先种下再等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Can I trade for some materials?"
msgstr "能换点材料吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Hey shopkeeper, got anything cheaper? My money's way, way short."
msgstr "卖东西的，有便宜一点的没有？我的钱，大大的不够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP"
msgid "Still raw."
msgstr "还是生的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Better than raw."
msgstr "比生吃好一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Another row to plant."
msgstr "又得种一排。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_WHEAT"
msgid "Have to grind it to make pastry."
msgstr "磨了才能做面点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Still a long way from bread."
msgstr "想吃面包还早着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUEEN_TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.QUEEN_TORCH"
msgid "This fire doesn't look ordinary."
msgstr "这火看着就不太普通。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBIT.GENERIC"
msgid "It's looking for lunch too."
msgstr "它也在找午饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBIT.HELD"
msgid "Don't shake, I'll put you down in a second."
msgstr "别抖，等一下就放好你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHAT"
msgid "Cute ears, but I feel a bit guilty wearing it."
msgstr "耳朵挺可爱，戴着却有点心虚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Warm in there, and no classes."
msgstr "里面暖和又不用上课。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOLE.SPRING"
msgid "The entrance is blocked."
msgstr "入口都封住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Even a burned house isn't edible."
msgstr "烤焦的房子还是不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Shaped like a carrot, but you can't eat it."
msgstr "做成胡萝卜也不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGHORN"
msgid "Blow it and rabbits come?"
msgstr "一吹兔子就会来？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "Keep the horn in here, don't drop it."
msgstr "号角好好放着，别摔了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Don't all charge together."
msgstr "别一群一起冲过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKINGSPEAR"
msgid "Get a good grip before swinging."
msgstr "拿稳了再挥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "So mean, and we only just met."
msgstr "刚见面就这么凶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_LUCKY"
msgid "This one should be worth chasing."
msgstr "这只应该值得追一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RABBITKING_PASSIVE"
msgid "This rabbit king's pretty easy to talk to."
msgstr "这位兔王倒还好说话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAIKIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAIKIRI"
msgid "Don't test if it's electric next to me."
msgstr "别在我旁边试它带不带电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINCOAT"
msgid "My uniform finally doesn't have to stay wet."
msgstr "制服终于不用一直湿着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINHAT"
msgid "If my hair gets flattened, so be it."
msgstr "头发压塌就压塌吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINOMETER.BURNT"
msgid "Even the weather gauge burned."
msgstr "连看天气的也烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAINOMETER.GENERIC"
msgid "Tell me when it'll stop raining."
msgstr "告诉我什么时候能不下雨。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RATATOUILLE"
msgid "Cut it a bit smaller."
msgstr "切得小一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RAZOR"
msgid "Don't use that to shave my hair."
msgstr "别拿它乱剃我的头发。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD"
msgid "It's looping in my head again."
msgstr "又开始在脑子里重复了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_BALATRO"
msgid "This one's good for playing cards to."
msgstr "这首适合边听边打牌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Don't play this at night."
msgstr "晚上别放这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DANGER"
msgid "I can't sit still listening to it."
msgstr "听着就坐不住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DAWN"
msgid "It's fine to play in the morning."
msgstr "早上放还可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DRSTYLE"
msgid "Something different to listen to."
msgstr "这一首换着听听。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_DUSK"
msgid "Good for sitting and spacing out at dusk."
msgstr "适合傍晚坐着发呆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_EFS"
msgid "Don't really get this one."
msgstr "这首不太听得明白。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_END"
msgid "Like something's finally over."
msgstr "像什么事情终于结束了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "The holiday mood doesn't need to be this scary."
msgstr "节日气氛也不用这么吓人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_MAIN"
msgid "I know this part by heart already."
msgstr "这段已经很熟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "Listening to this doesn't make me want to work more."
msgstr "听着也不想多干活。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDGEM"
msgid "A little warm to hold."
msgstr "拿着有点暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDLANTERN"
msgid "Hang it up and it feels like a holiday."
msgstr "挂起来就有过节的感觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDMOONEYE"
msgid "This red one, you can see it from far off."
msgstr "红色这个，远远就看见了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REDPOUCH"
msgid "Let's see how much is inside."
msgstr "先看看里面放了多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_CAP"
msgid "You can tell by the color not to just eat it."
msgstr "这个颜色看着就不能乱吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_CAP_COOKED"
msgid "Even cooked, don't just try it."
msgstr "煮完也别随便尝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's red. Remember the spot."
msgstr "红的，先记住位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "Hasn't come up yet."
msgstr "现在还没冒出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Already picked."
msgstr "已经采了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.BURNING"
msgid "Almost burned away."
msgstr "快烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.GENERIC"
msgid "Have to go into the marsh to get it."
msgstr "还得进沼泽里采。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REEDS.PICKED"
msgid "All picked."
msgstr "采完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REFINED_DUST"
msgid "Don't stir it up, it'll make me sneeze."
msgstr "别扬起来，会打喷嚏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REFLECTIVEVEST"
msgid "The sun's finally not so harsh."
msgstr "太阳总算没那么晒了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RELIC"
msgid "People used these to live, once."
msgstr "以前的人也用这些生活。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB.BURNT"
msgid "No studying today."
msgstr "今天学不成了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "Research before doing, again."
msgstr "又得先研究再动手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Fancier, still not fireproof."
msgstr "高级一点也不防火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "You can learn more than from the last one."
msgstr "比上一个能学得更多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Burned up, at least it's quiet."
msgstr "烧完倒安静了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "The more of this class I take, the worse I feel."
msgstr "这课越学越不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "The hat burned away."
msgstr "帽子烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Wearing a top hat still counts as a machine."
msgstr "戴着高帽子也算机器。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESKIN_TOOL"
msgid "A change of look is nice."
msgstr "换个样子也好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Now it's really useless."
msgstr "这回真没用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Keeps your life, but you look like someone else."
msgstr "命留下来，样子倒是别人的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RESURRECTIONSTONE"
msgid "Touch it first, in case it's too late."
msgstr "先碰一下，免得来不及。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.REVIVER"
msgid "Here. Don't push yourself when you get back."
msgstr "拿着，回来以后别再逞强。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RHINODRILL"
msgid "Stay away from its drill."
msgstr "离它的钻头远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROASTTURKEY"
msgid "Finally, today's not just snacks."
msgstr "今天终于不用只吃零食了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN.GENERIC"
msgid "With it around, it's a bit brighter out here."
msgstr "有它在，外面都亮一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN.HELD"
msgid "Stay in my pocket for now."
msgstr "口袋里先待一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This cold, and it's still flying around."
msgstr "这么冷还在外面飞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBIN_WINTER.HELD"
msgid "So soft. It warms my hands a bit."
msgstr "软软的，手也暖和一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Sewing beefalo clothes needs welding too?"
msgstr "给牛缝衣服还要焊接？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROBOT_PUPPET"
msgid "Have to find a way to let them out."
msgstr "得想办法把他们放出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK"
msgid "This one's definitely not going in my pocket."
msgstr "这块肯定装不进口袋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKS"
msgid "A few rocks."
msgstr "几块石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.ACID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.ACID"
msgid "Its shell's been eaten by acid."
msgstr "它的壳都被腐蚀了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.BOULDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.BOULDER"
msgid "Curled up like that, just leave it for now."
msgstr "缩成这样就先别管它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY.GENERIC"
msgid "Don't get caught in its claws."
msgstr "别被它的钳子夹到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.ACID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.ACID"
msgid "Acid gets through even that thick a shell."
msgstr "酸液连这么厚的壳都能影响。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.BOULDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.BOULDER"
msgid "It's curled up, not worth hitting now."
msgstr "缩起来了，现在打不划算。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS.GENERIC"
msgid "Don't let it grab you, that'd really be bad."
msgstr "别让它夹到，真的会出事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCKY_BOSS_SHADOW"
msgid "Even more trouble now that it's a shadow."
msgstr "变成暗影以后更麻烦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It won't bear fruit anymore."
msgstr "再也不结果了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "The tree's burning too."
msgstr "树也烧起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It's already sick."
msgstr "已经病了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "The leaves don't look right."
msgstr "叶子看着不对。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "A tree that grows stone fruit."
msgstr "长石头果子的树。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "All picked. Have to wait."
msgstr "摘完了，还得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It's too hot, the fruit's not growing."
msgstr "天太热，果子不长了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "Bite it directly and my teeth break first."
msgstr "直接咬，牙肯定先坏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "Finally cracked open, and it still needs cooking."
msgstr "总算敲开了，还得煮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "Soft. That's how it's edible."
msgstr "软了，这样才能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Already sprouted, needs planting."
msgstr "已经发芽了，得种下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Chip some off to take back."
msgstr "敲一点带回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE.MELTED"
msgid "Have to wait for winter."
msgstr "还得等冬天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_ICE_MELTED"
msgid "All the ice melted."
msgstr "冰全化了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "Still lava under there, don't step on it."
msgstr "下面还是熔岩，别踩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.LOW"
msgid "It's crusting over."
msgstr "正在结壳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Warm enough from this far away."
msgstr "离这么远就够暖了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_LIGHT.OUT"
msgid "The surface looks very thin."
msgstr "表面看着很薄。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_MOON"
msgid "Fell from the moon."
msgstr "从月亮掉下来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "This tree's past using an axe."
msgstr "这树已经不能用斧头了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "It must have been a living tree once."
msgstr "以前也是棵活树吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOK"
msgid "Don't stand where it's charging."
msgstr "别站它冲过来的方向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROOK_NIGHTMARE"
msgid "Broken like that and it still rams."
msgstr "坏成这样还是会撞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROPE"
msgid "Handy for tying things up."
msgstr "捆东西用得上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "Build this and no more going the long way."
msgstr "搭完就不用绕远路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Doesn't look like what Winona usually wears."
msgstr "这副倒不像薇诺娜平时会戴的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Get it away from me, quick."
msgstr "快拿远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.ROYAL_JELLY"
msgid "Sweet, and feels good after."
msgstr "甜的，吃完还舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUBBLE"
msgid "Too broken to piece back together."
msgstr "碎得拼不回去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINSHAT"
msgid "Will it mess up my hair?"
msgstr "戴好了头发会乱吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINS_BAT"
msgid "It's hefty, but my bat fits my hand better."
msgstr "沉甸甸的，不过我的球棒更顺手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.RUINS_RUBBLE"
msgid "Another thing to repair."
msgstr "又一件要修的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "If it wants something, why can't it just say so."
msgstr "它想要什么，不能直接说吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "Still waiting on the result."
msgstr "还在等结果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLEHORN"
msgid "Use this to take off the saddle first."
msgstr "先用它把鞍拆下来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_BASIC"
msgid "With a saddle I walk less."
msgstr "有了鞍就能少走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_RACE"
msgid "Riding this gets me there sooner."
msgstr "骑这个能早点到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_SHADOW"
msgid "Riding it feels a little unsettling."
msgstr "骑着总觉得有点不安。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_WAR"
msgid "Even fights depend on the beefalo."
msgstr "打架也要靠牛帮忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Wigfrid made it. Even the saddle's over the top."
msgstr "薇格弗德做的，连鞍都这么夸张。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALSA"
msgid "Water, give me water first."
msgstr "水，先给我水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTBOX"
msgid "Fresh ingredients go here."
msgstr "新鲜的食材放这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTLICK"
msgid "Beefalo can stay here half the day."
msgstr "牛能在这里待半天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTLICK_IMPROVED"
msgid "A block this big lasts a long time."
msgstr "这么大一块，能用很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTROCK"
msgid "Grind it up for seasoning."
msgstr "磨一磨就能调味。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.GENERIC"
msgid "Salt grows at sea too."
msgstr "海上还长着盐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.GROWING"
msgid "It's growing upward again."
msgstr "又在往上长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "This batch is all mined."
msgstr "这一批敲完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTY_DOG"
msgid "You can follow, just don't steal my fish."
msgstr "可以跟着，不过别抢我的鱼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SALTY_DOGHAT"
msgid "Fits pretty well, actually."
msgstr "戴着还挺合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDBLOCK"
msgid "Sand in my shoes is annoying enough."
msgstr "鞋里进沙子就够烦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANDSPIKE"
msgid "Nearly got stabbed."
msgstr "差点被扎到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANITYROCK.ACTIVE"
msgid "This rock looks way too weird."
msgstr "这块石头看着太奇怪了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Where did the top part go."
msgstr "上面那部分去哪了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.BURNING"
msgid "The thin twigs burned right up."
msgstr "细枝一下就烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.DISEASED"
msgid "Clearly sick."
msgstr "病得很明显了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.DISEASING"
msgid "Looks a little droopy."
msgstr "看着有点蔫。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.GENERIC"
msgid "Have to pick even the little saplings one by one."
msgstr "小树苗也要一棵棵采。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.PICKED"
msgid "All the twigs are picked."
msgstr "枝条采完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SAPLING.WITHERED"
msgid "Check back when it cools down."
msgstr "凉下来以后再看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCANDATA"
msgid "Notes kept by a machine."
msgstr "机器记的笔记。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.BURNING"
msgid "Quick, put it out, it's all straw."
msgstr "快灭火，全是稻草。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.BURNT"
msgid "The clothes are gone too."
msgstr "衣服也没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCARECROW.GENERIC"
msgid "It's dressed with more energy than I have."
msgstr "穿得比我还有精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCORCHED_SKELETON"
msgid "Stop looking. Let's go."
msgstr "别再看了，走吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Somebody else is keeping records too."
msgstr "还有别人也在做记录。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAPHAT"
msgid "Don't get poked by those spikes on top."
msgstr "别被上面的尖角扎到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "Wearing it won't make me better at picking parts."
msgstr "戴上也不会更会挑零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Have to carve slowly."
msgstr "还得慢慢雕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "The table burned up."
msgstr "桌子烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Have to haul over a stone first."
msgstr "得先搬一块石头来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "It's done, ready to display."
msgstr "做好了，能摆出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "A really old statue."
msgstr "一座很旧的雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "It's put together. Now what."
msgstr "拼好了，接下来呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Something's moving inside, back up."
msgstr "里面在动，退后。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "A big chunk is missing."
msgstr "少了一大块。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "Hauling a head back again."
msgstr "又要把头搬回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Can't quite tell what it looked like."
msgstr "看不太清原来的样子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Finally complete."
msgstr "总算完整了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "It's getting up."
msgstr "它要起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "The head's not here."
msgstr "头不在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "The body's over on the other side."
msgstr "身体还在另一边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "This one needs clearing too."
msgstr "这座也得清理。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "It's put together, taking a rest."
msgstr "拼好了，歇一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Don't get too close, it's moving."
msgstr "别靠太近，它在动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Haven't found the missing part yet."
msgstr "缺的部分还没找到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Even the nose is this heavy."
msgstr "连鼻子都这么重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "The blueprints are gone too."
msgstr "图纸也没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Going to sea means learning a whole bunch first."
msgstr "想出海还得先学一堆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEAFOODGUMBO"
msgid "A very satisfying bowl."
msgstr "这一碗能吃得很满足。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEASTACK"
msgid "Don't crash here when sailing."
msgstr "开船别撞这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "It's empty. What goes in it?"
msgstr "空着，要装什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "A little ball of light. Kinda cute."
msgstr "一小团光，还挺可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDPOUCH"
msgid "Finally, no more pockets full of seeds."
msgstr "终于不用满口袋都是种子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDS"
msgid "Who knows what these'll grow into."
msgstr "不知道又会长出什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEEDS_COOKED"
msgid "Just a little snack."
msgstr "只能当点零嘴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SENTRYWARD"
msgid "Now I don't have to chart the map bit by bit myself."
msgstr "地图就不用自己一点点记了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_KIT"
msgid "If your clothes rip, you have to sew them yourself."
msgstr "衣服破了也得自己缝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "The clothes rack burned too."
msgstr "衣服架也烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Stands all day and never gets tired, must be nice."
msgstr "站一天也不会累，真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SEWING_TAPE"
msgid "Patch it first, before the tear gets bigger."
msgstr "先补好，别让口子更大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWDANCER"
msgid "Seeing this dance once is enough."
msgstr "这种舞看过就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWDIGGER"
msgid "If a shadow can do it, I don't have to dig."
msgstr "影子能代劳就不用我挖了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWHEART"
msgid "Why is it still beating."
msgstr "怎么还在跳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Looks like there's no bottom down there."
msgstr "下面像是根本没有底。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "So long that even going around is a hassle."
msgstr "太长了，绕过去都费事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "It's flipped over, hit it fast."
msgstr "翻过来了，赶快动手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Don't let it turn its head this way."
msgstr "别让它把头转向这边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "Get your hands off!"
msgstr "把手拿开！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "Looks like all it wants is a fight."
msgstr "看着就只想打架。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "Don't charge with your mouth open."
msgstr "别张着嘴冲过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Stay away from my head."
msgstr "别靠近我的头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Having wings doesn't mean you get to chase people."
msgstr "有翅膀也别追着人飞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_BATTLEAXE"
msgid "This axe is way too demanding."
msgstr "这把斧头的要求也太多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_BEEF_BELL"
msgid "This bell sounds nasty."
msgstr "这铃铛听着就不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_FORGE"
msgid "We're making gear from these shadows?"
msgstr "要用这些暗影做装备？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Careful setting it up."
msgstr "装的时候小心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Let's put it down, I don't want to keep holding it."
msgstr "先放好，我不想一直拿着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHALLOW_GRAVE"
msgid "Sleep here and you won't get up again."
msgstr "睡在这里就再也起不来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARK"
msgid "You can't handle this fish with a rod."
msgstr "这条鱼可不是拿钓竿能应付的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHARKBOI"
msgid "Quit barreling around on the ice!"
msgstr "别在冰上横冲直撞！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELLWEAVER"
msgid "Let's see what materials are still missing."
msgstr "看看还缺什么材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHELL_CLUSTER"
msgid "Crack it open for shells."
msgstr "敲开能找些贝壳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIELDOFTERROR"
msgid "You can block for me, just don't bite me."
msgstr "替我挡着可以，别咬我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHINAI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHINAI"
msgid "Today's gym class includes sword practice?"
msgstr "今天的体育课还包括练剑？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIRASAYA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHIRASAYA"
msgid "Looks simple, but be careful holding it."
msgstr "外表很简单，拿着可得小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOVEL"
msgid "Shovel. Holding it makes me want to dig something."
msgstr "铲子。拿着就想挖点什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "A few fewer shovels to replace."
msgstr "能少换几把铲子了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOMBAIT"
msgid "Smelling it makes me sleepy."
msgstr "闻着就开始困。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOMCAKE"
msgid "Mushroom cake's a bit of a stretch."
msgstr "蘑菇做蛋糕也太勉强了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROOM_SKIN"
msgid "This skin's uncomfortable to hold."
msgstr "这块皮拿着很不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROUDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROUDEN.GENERIC"
msgid "Not too close yet, I still don't get how it attacks."
msgstr "先别靠近，我还没看清它怎么攻击。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROUDEN.PUDDLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHROUDEN.PUDDLE"
msgid "Its eye's showing, now's the time."
msgstr "眼睛露出来了，趁现在。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHUSUI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SHUSUI"
msgid "This blade's really beautiful."
msgstr "这刀身倒很漂亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIESTAHUT.BURNT"
msgid "Not even a place for a nap now."
msgstr "连午睡的地方都没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SIESTAHUT.GENERIC"
msgid "I'd love to stay here all afternoon."
msgstr "下午就想待在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SILK"
msgid "Don't tell me where it came from again."
msgstr "来源就别再告诉我了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "This one's a lower sound."
msgstr "这个声音低一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Tap it and it makes a sound."
msgstr "敲一下就有声音。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Too high, my ears can't take it."
msgstr "太高了，耳朵有点受不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.GENERIC"
msgid "Let's put some flowers out for her."
msgstr "给她放些花吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "She should like this."
msgstr "她应该会喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "That sound... it's a little sad to hear."
msgstr "这个声音……听着有点难过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "Different flowers would be better."
msgstr "换些别的花会好一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Could add a few more."
msgstr "还可以再添几朵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON"
msgid "Someone else didn't make it back either."
msgstr "以前也有人没能回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETONHAT"
msgid "Wear it and you see things you don't want to."
msgstr "戴上就看到不想看的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_NOTPLAYER"
msgid "These aren't human bones."
msgstr "这不是人的骨头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s couldn't escape %s... don't lose their things."
msgstr "%s没能躲过%s……别把遗物弄丢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s couldn't escape %s... we were too late."
msgstr "%s没能躲过%s……我们来晚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s couldn't escape %s... let's take him back."
msgstr "%s没能躲过%s……把他带回去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s was taken apart by %s... is it still fixable?"
msgstr "%s被%s拆散了……还能修吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKETCH"
msgid "Even following this, carving takes half a day."
msgstr "照着雕也得花半天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SKULLCHEST"
msgid "Decide whether you're running before you open it."
msgstr "开之前先想好要不要跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLEEPBOMB"
msgid "Let them have a good long sleep."
msgstr "让它们好好睡一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT.GENERIC"
msgid "Walter, don't point it at the window."
msgstr "沃尔特，别对着窗户。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "All the ammo goes here, don't mix it with candy."
msgstr "弹药都放这里，别混着糖果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "Little pellets made of dreadstone."
msgstr "黯影石做的小弹丸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "It freezes what it hits."
msgstr "打中了会冻住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "Once it's stuck, it can't run fast."
msgstr "黏住以后就跑不快了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "That's gold, just shooting it away."
msgstr "金子就这么打出去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "This kind explodes, keep it safe."
msgstr "这种会炸，收好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "That has to be sticky if it hits."
msgstr "打中了肯定很黏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "This ammo looks cold."
msgstr "这种弹药看着就冷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Even plant husks can hit hard."
msgstr "植物壳也能打得很疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "Stone's heavier, so it hits heavier."
msgstr "石头重一点，打得也重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Don't get broken glass on your hands."
msgstr "碎玻璃别落在手上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "Don't touch me, and keep it away from food."
msgstr "别碰我，也别放饭旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "So tiny, yet so bright."
msgstr "小小一颗也这么亮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "Regular rocks are plenty."
msgstr "普通石头也够用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER"
msgid "Parts can be ammo too."
msgstr "零件也能当弹药。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "It stops them running so fast."
msgstr "能让它别跑那么快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_STINGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_STINGER"
msgid "Get hit, and then get stung too."
msgstr "被打到还得再挨一下扎。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Using this kind of material for a slingshot."
msgstr "这种材料也拿来打弹弓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOTMODKIT"
msgid "Walter's modifying his slingshot again."
msgstr "沃尔特又在改他的弹弓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_MIMIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_MIMIC"
msgid "This band doesn't look normal."
msgstr "这根皮筋看着不太正常。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_PIGSKIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_PIGSKIN"
msgid "A sturdier band."
msgstr "结实一点的皮筋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_BAND_TENTACLE"
msgid "Too slippery to touch."
msgstr "摸起来太滑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_BONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_BONE"
msgid "A frame made of bone."
msgstr "骨头做的支架。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_GEMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_GEMS"
msgid "All those gems just to shoot a slingshot."
msgstr "镶这么多宝石就为了打弹弓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK"
msgid "These mods keep getting more complicated."
msgstr "这下改得越来越复杂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0"
msgid "Not all the parts are on yet."
msgstr "零件还没装全。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_JELLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_JELLY"
msgid "Won't it slip out of your hand?"
msgstr "拿着不会滑掉吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_SILK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_SILK"
msgid "Should be more comfortable to grip."
msgstr "握着应该舒服一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_STICKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_STICKY"
msgid "Don't get your hands stuck too."
msgstr "别把手也黏住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH"
msgid "This grip's actually pretty light."
msgstr "这种握把倒挺轻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPER"
msgid "Don't jump on my head."
msgstr "别跳到我头上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPERPELT"
msgid "Still fluffy, even dead."
msgstr "死了也还是毛茸茸的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURPER_PELT"
msgid "Clean it up before using it."
msgstr "先清理干净再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLE"
msgid "Keep your slime away from me."
msgstr "黏液别蹭过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLEHAT"
msgid "Wear it and I'll have to wash my hair again."
msgstr "戴完又得洗头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLEHOLE"
msgid "Definitely stickier in there."
msgstr "这里面肯定更黏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLESLIME"
msgid "Useful, but it needs a separate container."
msgstr "有用也得单独装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Broken this badly, no need to piece it together."
msgstr "碎成这样就不用拼了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Little guy, stay close."
msgstr "小家伙，跟紧一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Hungry again?"
msgstr "又饿了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Finally asleep and quiet."
msgstr "终于安静睡着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLBIRD.STARVING"
msgid "Hold on, I'll find you something to eat."
msgstr "别急，我这就找吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLGHOST"
msgid "Don't cry, I'll help you look."
msgstr "别哭，我帮你找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLMEAT"
msgid "Too small, find something else too."
msgstr "太小了，再找点别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SMALLMEAT_DRIED"
msgid "Save it for a snack on the road."
msgstr "留在路上当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNAPPER"
msgid "Stay away from its mouth."
msgstr "离它嘴远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWBALL_ITEM"
msgid "Not in the face. Just saying."
msgstr "别砸脸，先说好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMAN.GENERIC"
msgid "It's built. What else should I add."
msgstr "堆好了，再加什么呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "Rolling it this big is tiring enough."
msgstr "滚到这大小就够累了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SNURTLE"
msgid "At least it's easier on the eyes than the other one."
msgstr "至少比另一只顺眼一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Leave it and let it ferment."
msgstr "放着，等它发酵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "That smell means it's ready?"
msgstr "这味道说明做好了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER.STALE"
msgid "The smell's getting stronger."
msgstr "味道开始变重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "It's for plants. Keep it away from your nose."
msgstr "给植物用，别靠近鼻子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPAT"
msgid "Don't spit on my clothes."
msgstr "别吐在我的衣服上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR"
msgid "Simple, but it works."
msgstr "简单一点也能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_GUNGNIR"
msgid "Lets you charge right through."
msgstr "能直接冲过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_LANCE"
msgid "Longer means not getting too close."
msgstr "长一点就不用贴太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Wigfrid made it. It's really sharp."
msgstr "薇格弗德做的，确实挺锋利。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "Have to watch out for shocks using it."
msgstr "用的时候还得防电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICEPACK"
msgid "Carry seasoning and ingredients together."
msgstr "调料和食材一起背着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_CHILI"
msgid "Go easy on mine."
msgstr "我的那份少放一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_GARLIC"
msgid "Don't pour the whole jar in."
msgstr "别一整瓶都倒进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_SALT"
msgid "Just a little is enough."
msgstr "一点就够。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPICE_SUGAR"
msgid "A bit more's fine in dessert."
msgstr "甜点里可以多一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.DEAD"
msgid "Finally stopped moving."
msgstr "总算不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.GENERIC"
msgid "Don't crawl on my skirt."
msgstr "别往裙子上爬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER.SLEEPING"
msgid "Get out while it's asleep."
msgstr "趁它睡着赶紧走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "Don't go near until it's burned out."
msgstr "烧完以前先别靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "It's dead, leave it alone."
msgstr "死了就别碰了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "How is it not over!"
msgstr "怎么还没完！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERDEN"
msgid "My soles are about to stick again."
msgstr "鞋底又要黏住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "Webber really put work into decorating it."
msgstr "韦伯装饰得倒挺用心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDEREGGSACK"
msgid "Don't you dare hatch in my pocket."
msgstr "可别在我口袋里孵出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERGLAND"
msgid "It heals, but you have to bear the smell first."
msgstr "能治伤也得先忍住味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHAT"
msgid "Clean off the slime before I put it on."
msgstr "戴之前请把黏液清干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHOLE"
msgid "That's some thick web."
msgstr "网结得也太厚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERHOLE_ROCK"
msgid "Spiders living in rock too."
msgstr "石头里也能住蜘蛛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEEN"
msgid "Something that big should stay away!"
msgstr "这么大的就别过来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "Don't stand in the smoke."
msgstr "别站在烟里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "So big it takes up space even lying down."
msgstr "这么大一只，倒下了也占地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "We have to fight it again?"
msgstr "还要再打一遍？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_DROPPER"
msgid "Have to watch overhead too."
msgstr "还要小心头顶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HEALER"
msgid "So they can heal too."
msgstr "它们居然也会治疗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "Webber, you hold this one."
msgstr "韦伯，这个你来拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_HIDER"
msgid "Hiding in a shell, but I can still tell it's a spider."
msgstr "躲在壳里也知道是蜘蛛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Let me check. It really stopped moving."
msgstr "确认一下，真的不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "The moon didn't make it any cuter."
msgstr "月亮也没让它变可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "Pass by quietly."
msgstr "安静走过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_REPELLENT"
msgid "If only I could use it too."
msgstr "要是我也能用就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_SPITTER"
msgid "Far away, and it still spits at you."
msgstr "站远了还要吐过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Just don't move again."
msgstr "别再动就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "This one jumps!"
msgstr "这只还会跳！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "Don't get too close."
msgstr "别靠太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WATER"
msgid "No escaping them even at sea."
msgstr "海上也躲不开它们。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPIDER_WHISTLE"
msgid "Why would I call them over on purpose."
msgstr "为什么要主动叫它们来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "This fish is past eating."
msgstr "这鱼已经不能吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "Rotten like this, no point keeping it."
msgstr "坏成这样就别留着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Drifting looks pretty relaxing."
msgstr "飘着倒挺轻松。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I'll keep some of that red light."
msgstr "留一点红色的光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_MOON"
msgid "Pretty to look at, but better stay away."
msgstr "看着好看，还是别靠近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "Like a little speck of green light."
msgstr "像一小点绿光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_SMALL.HELD"
msgid "Take it and put it in a lamp."
msgstr "拿去放灯里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_TALL.GENERIC"
msgid "Doesn't have to do anything but float."
msgstr "什么也不用做，只管飘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SPORE_TALL.HELD"
msgid "Got this blue one too."
msgstr "蓝色的这只也收好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SQUID"
msgid "Flashing on and off, and it's looking this way."
msgstr "一亮一亮的，在看这边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFFCOLDLIGHT"
msgid "Cool. Don't stand too close."
msgstr "凉快，别站得太近。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFFLIGHT"
msgid "Warm. Don't let anything catch fire."
msgstr "暖和，别让东西着火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFF_LUNARPLANT"
msgid "Check your direction before swinging."
msgstr "挥之前先看清方向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAFF_TORNADO"
msgid "Don't blow the camp away too."
msgstr "别把营地也卷走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEHAND.AWAKE"
msgid "Keep your hands off."
msgstr "手别伸过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEHAND.HIDING"
msgid "There seems to be something under the table."
msgstr "桌子底下好像有东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEUSHER.SITTING"
msgid "Even sitting there it looks suspicious."
msgstr "它坐在那里也很可疑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STAGEUSHER.STANDING"
msgid "I can walk on my own, stop pulling me."
msgstr "我自己会走，别来拉我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALAGMITE"
msgid "Rocks everywhere in this cave."
msgstr "洞里到处都是石头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALAGMITE_TALL"
msgid "This one's even taller."
msgstr "这一块还更高。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER"
msgid "I knew putting it together would cause trouble."
msgstr "拼起来以后果然出事了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_ATRIUM"
msgid "Why does it have to get this big."
msgstr "为什么还要变得这么大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_MINION"
msgid "Don't crowd around my feet."
msgstr "别往脚边挤。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STALKER_NPC"
msgid "Let's talk this through first."
msgstr "先把话说清楚吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STASH_MAP"
msgid "At least I know where to go this time."
msgstr "至少这回知道往哪走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "It's been emptied out."
msgstr "里面已经拿空了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "Is that a statue of Glommer?"
msgstr "雕的是格罗姆？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEHARP"
msgid "Headless and still playing the harp."
msgstr "头不见了，还在弹琴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "The flowers grew back. The head didn't."
msgstr "花长回来了，头没有。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUEMAXWELL"
msgid "Way taller than the real guy."
msgstr "比本人高出这么多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Another statue to haul."
msgstr "又一座要搬的雕像。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "This one has no head either."
msgstr "这座也没有头。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "Looks pretty formal."
msgstr "看起来挺正式。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "This must have taken a long time to carve."
msgstr "雕这个得花很久吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEELWOOL"
msgid "It's scratchy, don't stuff it in your clothes."
msgstr "扎手，别直接塞衣服里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL"
msgid "Steering means watching the road all the time too."
msgstr "掌舵也得一直看着路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "Set it up to make turning easier."
msgstr "装好才好转向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STINGER"
msgid "Keep it away from your fingers."
msgstr "离手指远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "A chair you can sit on. Very good."
msgstr "能坐的椅子，很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "Someone's already sitting there."
msgstr "已经有人坐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_TABLE.GENERIC"
msgid "Just put some food on it."
msgstr "摆点饭上去就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "There's already something on the table."
msgstr "桌上已经有东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "It's broken. Have to help it first."
msgstr "坏了，还得先帮它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "If only it could organize my school bag."
msgstr "要是能替我整理书包就好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STRAWHAT"
msgid "A bit scratchy, but it keeps off the sun."
msgstr "有点扎头，至少挡太阳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFEDEGGPLANT"
msgid "More filling inside."
msgstr "里面多放点馅。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.STUFFING"
msgid "Goes great with a main dish."
msgstr "这个配主菜刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PICKED"
msgid "Nice to display, I don't want to eat it."
msgstr "摆着挺好，不想拿来吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "Now it really has no moisture."
msgstr "这下真的没有水分了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_PLANT"
msgid "It should survive without much watering."
msgstr "不常浇水也能活吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUCCULENT_POTTED"
msgid "This kind of potted plant suits me."
msgstr "这种盆栽适合我养。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "Hauling it up had better pay off."
msgstr "捞上来总该有点收获。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "Still locked, can't just open it."
msgstr "还锁着，不能直接开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPERTACKLECONTAINER"
msgid "Another big box of stuff just for fishing."
msgstr "为了钓鱼又添一大箱东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR"
msgid "Fix this first, before it collapses."
msgstr "先修这个，别等它塌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "It can't hold up anymore."
msgstr "已经撑不住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "Now it's safer overhead."
msgstr "这下头顶能稳一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "Needs more materials."
msgstr "还得再加材料。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "Even something this hard can break."
msgstr "这么硬也会断。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "This one looks pretty solid."
msgstr "这根看着挺牢靠。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "Still being built, don't touch it."
msgstr "还在搭，别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "Not finished yet."
msgstr "还没完工。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SURFNTURF"
msgid "Seafood and meat both. This one's good."
msgstr "海鲜和肉都有，这份好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEATERVEST"
msgid "Looks like a change of school uniform."
msgstr "看着像换了套校服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETPOTATO"
msgid "If it's a little sweet, no need for sugar."
msgstr "甜一点就不用加糖了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWEETTEA"
msgid "Finish this cup, then I'll think about all that trouble."
msgstr "喝完这一杯，再去想那些麻烦事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.SWORD_LUNARPLANT"
msgid "Grip it well and finish early."
msgstr "拿好了，早点打完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Even the banquet table burned."
msgstr "聚餐的桌子也烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "Everyone sit down and eat together."
msgstr "大家一起坐下吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "Time to eat, save me a seat."
msgstr "能开饭了，给我留个位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "It's not time for this yet."
msgstr "现在还不是用这个的时候。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLECONTAINER"
msgid "Keep the tackle separate and it stays tidy."
msgstr "鱼具单独装就不乱了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLESKETCH"
msgid "Now I have to make lures from a diagram too."
msgstr "还要照着图做鱼饵。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TACKLESTATION"
msgid "So much prep before fishing."
msgstr "钓鱼前还得准备这么多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAFFY"
msgid "Eat it slowly, don't glue your teeth together."
msgstr "慢慢吃，别把牙黏住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRD"
msgid "Don't glare at me, I didn't take the egg."
msgstr "别瞪我，我没拿蛋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG"
msgid "An egg this big. Hold on to it."
msgstr "这么大一个蛋，拿稳了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Just one lasts a long time."
msgstr "一个就够吃很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "It needs to be warmer."
msgstr "得暖一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "It's about to come out."
msgstr "里面快出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Too hot, keep it away from the fire."
msgstr "太热了，离火远些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "Still a long watch ahead."
msgstr "还得守很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Almost, wait a bit more."
msgstr "快了，再等一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "Check for its mother before taking the big egg."
msgstr "拿大蛋以前先看看它妈妈。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "It's empty."
msgstr "里面空了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TALLEGGS"
msgid "One's worth several. Enough for omelette rice."
msgstr "一个顶好几个。蛋包饭够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TAMALES"
msgid "One first, don't get too full."
msgstr "吃一个先，别太撑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.GENERIC"
msgid "Grew up a bit, and its temper did too."
msgstr "长大了一点，脾气也大了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Time to feed it again."
msgstr "又该喂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.SLEEPING"
msgid "Only now does it act like a good kid."
msgstr "这会才像个乖孩子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TEENBIRD.STARVING"
msgid "Don't glare at me, I'll find food right now."
msgstr "别瞪我，马上找吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEBASE.GEMS"
msgid "Still missing purple gems."
msgstr "还缺紫宝石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEBASE.VALID"
msgid "Ready to teleport over."
msgstr "可以传过来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "Can I get out of here this time."
msgstr "这次能离开这里了吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "Looks like it could lead somewhere else."
msgstr "像是能通向别的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Still missing parts."
msgstr "还缺零件。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "Almost put together."
msgstr "快拼完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_BOX"
msgid "This box is part of the machine."
msgstr "这个盒子是机器的一部分。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_CRANK"
msgid "Found the crank."
msgstr "找到手柄了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_POTATO"
msgid "Shaped like a potato, but you can't eat it."
msgstr "做得像土豆也不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELEPORTATO_RING"
msgid "Have to bring this ring back too."
msgstr "还得把这个圆环带回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TELESTAFF"
msgid "If I don't have to walk, I won't."
msgstr "能不走路就不走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENSEIGA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENSEIGA"
msgid "As long as it saves people. Hopefully everyone comes back."
msgstr "能救人就好，最好每个人都能回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENT.BURNT"
msgid "Where do I sleep tonight."
msgstr "晚上睡哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENT.GENERIC"
msgid "Can I go to bed early today."
msgstr "今天能早点睡吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE"
msgid "Don't stand here, something comes up from underground."
msgstr "别站这里，地下会伸出东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLESPIKE"
msgid "Slippery to hold, hurts when it hits."
msgstr "拿着滑，打着疼。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLESPOTS"
msgid "Don't tell me what part this is."
msgstr "别告诉我这是哪个部位。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_GARDEN"
msgid "How are there this many."
msgstr "怎么还有这么多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR"
msgid "This one moves too."
msgstr "这根也会动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Even the small ones, don't wrap my feet."
msgstr "小的也别缠我的脚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "It smells bad, and I still have to look down there."
msgstr "味道不好，还得往下看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "After all that, now I have to wait."
msgstr "折腾完还得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.CRIMSON"
msgid "This shade of red's not great."
msgstr "这个红色可不太好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.ENABLED"
msgid "Something's really lit up in there."
msgstr "里面真的亮起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.GENERIC"
msgid "Stare too long and my head spins."
msgstr "看久了脑袋有点晕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "Finally, no more eyes on me."
msgstr "终于不用再被眼睛盯着了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "Have to wait till dark."
msgstr "还要等天黑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Nothing much left inside."
msgstr "里面也不剩什么了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "Better step back before opening it."
msgstr "开之前最好先退一步。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "This chest doesn't look like it belongs here."
msgstr "这箱子看着不属于这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITE"
msgid "Have to go underground to find this stuff."
msgstr "这种材料还得跑地下找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITEBUGNET"
msgid "Using such an expensive net to catch bugs."
msgstr "用这么贵的网抓虫子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THULECITE_PIECES"
msgid "Save them up, they're still useful."
msgstr "攒起来还能用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.THURIBLE"
msgid "That's a pretty strong smell."
msgstr "味道有点重。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.ABANDONED"
msgid "I'll try on my own."
msgstr "我自己试试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.GENERIC"
msgid "Looks good at finding things."
msgstr "看着就很会找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.LOST_TRACK"
msgid "Someone else found it first."
msgstr "被别人先找了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.NEARBY"
msgid "Should be right nearby."
msgstr "应该就在旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "This area's all searched."
msgstr "这里已经找完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.SUCCESS"
msgid "Found it. Nice work."
msgstr "找到了，做得好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "Too far, try another direction."
msgstr "太远了，换个方向。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TRACKING"
msgid "Just follow it."
msgstr "跟着走就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "It's helping someone else look."
msgstr "它在帮别人找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEED"
msgid "More weeds, you can never pull them all."
msgstr "又长杂草，拔都拔不完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEEDSALVE"
msgid "That's a pretty good use for it."
msgstr "这样用倒挺合适。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TILLWEED_DRIED"
msgid "Keep it, might be useful later."
msgstr "留着吧，之后可能用得上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Stay away from it, the smell's too strong."
msgstr "别靠近它，味道太重了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL.RAGE"
msgid "It's started jumping around, back off."
msgstr "它开始乱跳了，离远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Just a hole left."
msgstr "只剩一个洞。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Don't just chop it, there's something below."
msgstr "别随便砍，下面还有东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Something's about to come up."
msgstr "有东西要冒出来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOKIJIN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOKIJIN.GENERIC"
msgid "This sword makes me really uncomfortable."
msgstr "这把刀让我很不舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOKIJIN.RESENTMENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOKIJIN.RESENTMENT"
msgid "Resentment, obsession, and a sorrow that won't fade. Louis, please put it away."
msgstr "怨恨、执念，还有不肯散去的悲伤。Louis，先把它收起来吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO"
msgid "This one's fresh, it's edible."
msgstr "这个新鲜，可以吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_COOKED"
msgid "Better in soup."
msgstr "做汤会更好一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_OVERSIZED"
msgid "Holding it feels like hugging a ball."
msgstr "拿着像抱了个球。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOMATO_SEEDS"
msgid "Another row and that'll be enough."
msgstr "再种一排就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPHAT"
msgid "Too formal to wear."
msgstr "戴着太正式了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOPHAT_MAGICIAN"
msgid "Wear it and I can do magic tricks?"
msgstr "戴上就能变戏法？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TORCH"
msgid "Get through this night first."
msgstr "先撑过这一晚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOURTIERE"
msgid "Save me a piece once it's cut."
msgstr "切开以后给我留一块。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Hurry, no more waiting."
msgstr "快走，别再等了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "When it's not on, it's just a sand pile."
msgstr "不启动的时候就是个沙堆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I can go back, no walking."
msgstr "能回去了，不用走路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "Bring it along and you can get back."
msgstr "带着就能回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAILMIX"
msgid "Something to chew on the road."
msgstr "路上嚼一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAILS"
msgid "Don't let it throw stuff at me."
msgstr "别让它扔东西砸过来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRANSISTOR"
msgid "Little parts, saving them."
msgstr "小零件，攒着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP"
msgid "Put it here and come back for it later."
msgstr "放这里，过会回来收。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_BRAMBLE"
msgid "Remember the spot, don't step on it yourself."
msgstr "记好位置，别自己踩了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "It's cold, have to heat it first."
msgstr "冷了，得先加热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "Burning hot, put it down!"
msgstr "烫手，先放下！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "Don't step on it, you'll get burned."
msgstr "别踩上去，会烫伤的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "Still a bit hot, don't touch it directly."
msgstr "还有点热，别直接碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "Knew it would bite."
msgstr "果然会咬人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "Don't touch it yet, it looks too neat."
msgstr "先别碰，看着太整齐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_TEETH"
msgid "Check your feet before coming."
msgstr "来之前先看清脚下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "Go around, don't step on it."
msgstr "绕开，别踩上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.BURNT"
msgid "What's inside couldn't be saved either."
msgstr "里面的也保不住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.GENERIC"
msgid "Put the stuff away first."
msgstr "东西先收好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "Now it holds a lot again."
msgstr "这下又能放很多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREASURECHEST_TRAP"
msgid "So conveniently placed, it's actually kind of suspicious."
msgstr "摆得这么方便，反而有点可疑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREECLUMP"
msgid "This row of trees blocks the way a bit too neatly."
msgstr "这排树挡得太整齐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREEGROWTHSOLUTION"
msgid "Makes trees grow faster."
msgstr "能让树长快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.BURNING"
msgid "Back up, don't get burned."
msgstr "离远一点，别被烧到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "All chopped."
msgstr "已经砍完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK.GENERIC"
msgid "This tree doesn't look easy to chop."
msgstr "这树看着就不好砍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK_SAPLING"
msgid "It's still small, don't step on it."
msgstr "现在还小，别踩到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TREE_ROCK_SEED"
msgid "Plant it and you still have to wait for it to grow."
msgstr "种下以后还得等它长大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRIDENT"
msgid "Keep away from the boat when swinging."
msgstr "挥的时候离船远点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_1"
msgid "The marbles are all stuck together."
msgstr "弹珠都黏成一块了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_10"
msgid "False teeth, to scare people?"
msgstr "这副假牙拿来吓人？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_11"
msgid "The little robot says weird stuff too."
msgstr "小机器人还会说些奇怪的话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_12"
msgid "This tentacle doesn't look like a normal toy."
msgstr "这根触手不像正常的玩具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_13"
msgid "Another little gnome."
msgstr "另一只小地精。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_14"
msgid "The cup's cracked, tea would leak out."
msgstr "杯子都裂了，喝茶会漏。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_15"
msgid "Maxwell's chess pieces, scattered again."
msgstr "麦斯威尔的棋子又乱放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_16"
msgid "Here's another one."
msgstr "还有这一枚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_17"
msgid "Eating with this is asking too much."
msgstr "吃饭用这个也太为难了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_18"
msgid "Is something hidden in this toy?"
msgstr "玩具里是不是藏了东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_19"
msgid "Spins a couple times and stops."
msgstr "转两下就停了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_2"
msgid "No sound when you blow it."
msgstr "吹一下也没声音。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_20"
msgid "Don't suddenly hit me with this."
msgstr "别拿这个突然打我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_21"
msgid "The whisk's this bent, better get another one."
msgstr "打蛋器歪成这样，还是换一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_22"
msgid "The string's too old. Don't count on it to hold."
msgstr "线太旧了，别指望能绑牢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_23"
msgid "I can put on my own shoes."
msgstr "穿鞋我自己会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_24"
msgid "Did a cat live in here once?"
msgstr "里面以前有只猫？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_25"
msgid "Sat too long, the smell's changed."
msgstr "放久了，味道都变了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_26"
msgid "You can actually eat this cup."
msgstr "这个杯子还真能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_27"
msgid "Way too long unfolded. Careful not to hit anyone."
msgstr "展开太长了，小心碰到人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_28"
msgid "A white chess piece."
msgstr "一枚白棋子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_29"
msgid "The black one's here too."
msgstr "黑色的这枚也在。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_3"
msgid "A knot you can't undo no matter how long you try."
msgstr "解半天也解不开的结。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_30"
msgid "Why are chess pieces everywhere."
msgstr "棋子怎么到处都是。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_31"
msgid "If you want to play, set up a proper set."
msgstr "要玩倒是摆一套整齐的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_32"
msgid "You can really see the future with this?"
msgstr "拿着它真的能看到以后？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_33"
msgid "Hopefully no spiders crawl out of those fingers."
msgstr "手指上可别爬出蜘蛛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_34"
msgid "I'll make a wish: no getting up early tomorrow."
msgstr "许个愿，明天不用早起。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_35"
msgid "Even an empty bottle needs a sniff first."
msgstr "空瓶子也得先闻一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_36"
msgid "Too much candy, and this is what I'd need?"
msgstr "糖吃多了，以后就靠这个？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_37"
msgid "A wooden stake, I could keep it."
msgstr "木桩子，留着也行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_38"
msgid "These binoculars are from somewhere else."
msgstr "这副望远镜来自别的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_39"
msgid "Just one glove."
msgstr "只有一只手套。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_4"
msgid "Someone likes these little knickknacks."
msgstr "这种小摆件有人喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_40"
msgid "Holding it makes me want to trade it for something."
msgstr "拿着它就想去换点东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_41"
msgid "Still a little warm to the touch."
msgstr "摸着还有点热。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_42"
msgid "Somebody must have played with this as a kid."
msgstr "这是谁小时候一直玩的东西吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_43"
msgid "This toy doesn't jump very well."
msgstr "这只玩具跳得不怎么样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_44"
msgid "A packed plant specimen."
msgstr "装好的植物样本。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_45"
msgid "It seems to pick up sounds from elsewhere."
msgstr "好像能收到别的地方的声音。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_46"
msgid "It blows out a little wind."
msgstr "这个能吹出点风。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_5"
msgid "Too small to sit on."
msgstr "太小了，坐不上去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_6"
msgid "The wires are all snapped, can't fix it."
msgstr "线全断了，修不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_7"
msgid "Played a bit, nothing else to do."
msgstr "玩两下，没别的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_8"
msgid "Found the bathtub plug. Where's the tub."
msgstr "浴缸塞找到了，浴缸呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRINKET_9"
msgid "The buttons don't even match."
msgstr "扣子都不成对。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "The scale's on fire, get the fish off."
msgstr "秤烧起来了，快把鱼拿下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "The record burned too."
msgstr "纪录也烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Let's put today's catch on it."
msgstr "把今天钓的放上去看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}\nThe fish is here now."
msgstr "重量：{weight}\n捕获者：{owner}\n鱼已经放在这里了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nThis one was pretty worth the wait."
msgstr "重量：{weight}\n捕获者：{owner}\n这一条还挺值得等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nI caught this one. Not bad, right?"
msgstr "重量：{weight}\n捕获者：{owner}\n这是我钓的，还不错吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nThis one made a whole day of sitting worthwhile."
msgstr "重量：{weight}\n捕获者：{owner}\n这条可没让我白坐一天。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "It'll be cooked before it even gets to the pot."
msgstr "菜还没进锅就要熟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "All charred, can't eat it."
msgstr "全焦了，不能吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "This one needs the big scale."
msgstr "这颗得用大秤。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvest day: {day}\nThe planting paid off."
msgstr "重量：{weight}\n收获天数：{day}\n没白种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvest day: {day}\nIt really grew this big."
msgstr "重量：{weight}\n收获天数：{day}\n还真长这么大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "So light it's not even worth showing."
msgstr "轻得都不用显示了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_HITOKIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_HITOKIRI"
msgid "However strong you are, don't swing it around."
msgstr "力量再大也别乱挥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_KOSHIRAE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_KOSHIRAE"
msgid "You can chop down something that big with this?"
msgstr "这么大的家伙也能砍倒？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_RAIKIRI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_RAIKIRI"
msgid "I'll back up, then watch her try the blade."
msgstr "先退远一点再看她试刀。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_SHIRASAYA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUE_SHIRASAYA"
msgid "It should come in handy against those monsters."
msgstr "打那些怪物会用得上吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Just the right thickness, I can still wear it."
msgstr "厚度刚好，还能穿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNKVEST_WINTER"
msgid "This is what I'll wear in winter."
msgstr "冬天就穿这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_COOKED"
msgid "Can you bring it over once it's cut up?"
msgstr "能切开以后再端来吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_SUMMER"
msgid "Clean it first."
msgstr "先处理干净。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TRUNK_WINTER"
msgid "The fur on it's pretty warm."
msgstr "上面的毛倒挺暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TUMBLEWEED"
msgid "Have to catch it to know what's inside."
msgstr "追上才知道里面有什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURFCRAFTINGSTATION"
msgid "Even changing floors needs a machine first."
msgstr "换地板也得先做机器。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ARCHIVE"
msgid "The kind of floor in the archives."
msgstr "档案馆那种地面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BADLANDS"
msgid "Looks dry even laid out."
msgstr "铺上也显得很干。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_BEARD_RUG"
msgid "Don't lay this next to my bed."
msgstr "别铺在我床边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CARPETFLOOR"
msgid "Not as soft as I imagined."
msgstr "没有想象的软。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CARPETFLOOR2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CARPETFLOOR2"
msgid "Nice to step on."
msgstr "踩着这个舒服。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CAVE"
msgid "Shoveled from the cave."
msgstr "从洞里铲来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Looks nice laid out neatly."
msgstr "铺整齐了挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COTL_BRICK"
msgid "Have to line up the bricks one by one."
msgstr "一块块砖还得对齐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_COTL_GOLD"
msgid "Stepping on something this expensive."
msgstr "这么贵的也拿来踩。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DECIDUOUS"
msgid "Still has fallen leaves on it."
msgstr "还带着落叶。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DESERTDIRT"
msgid "Desert dirt, don't get it in my shoes."
msgstr "沙漠的土，别掉鞋里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DIRT"
msgid "A patch of ground, shoveled up."
msgstr "从地上铲起来的一块地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_DRAGONFLY"
msgid "If it's fireproof, it's worth laying."
msgstr "能防火就值得铺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FOREST"
msgid "Brought back a patch of forest."
msgstr "带回了一块林地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS"
msgid "Smells like mushroom ground."
msgstr "蘑菇地面的味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "Dirt from near green mushrooms."
msgstr "绿蘑菇附近的土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_MOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_MOON"
msgid "Mushroom soil from the moon side."
msgstr "月亮那边的蘑菇土。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_FUNGUS_RED"
msgid "Dug from near red mushrooms."
msgstr "红蘑菇附近挖的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_GRASS"
msgid "Lay it down and it's greener."
msgstr "铺好就绿一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MARSH"
msgid "Don't lay this where I sleep."
msgstr "别铺到睡觉的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_METEOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_METEOR"
msgid "Broken ground from the moon."
msgstr "月亮来的碎地皮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MONKEY_GROUND
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MONKEY_GROUND"
msgid "Sandy ground from Monkey Island."
msgstr "猴子岛上的沙地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_BLUE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_BLUE"
msgid "This blue one's pretty."
msgstr "蓝色的这一块挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_GREY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_GREY"
msgid "The grey one holds up better to look at."
msgstr "灰色这款耐看一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_RED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MOSAIC_RED"
msgid "Red. Don't lay it through the whole house."
msgstr "红色的，别整屋都铺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_MUD"
msgid "My shoes are getting dirty again."
msgstr "鞋底又要脏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PEBBLEBEACH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_PEBBLEBEACH"
msgid "Pebbles feel kind of lumpy underfoot."
msgstr "石子踩着有点硌。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ROAD"
msgid "Paving saves walking time."
msgstr "铺路能少走点时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_ROCKY"
msgid "Rocky ground, hauled off."
msgstr "搬走的石地面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSBRICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSBRICK"
msgid "Old bricks from the ruins."
msgstr "遗迹里的旧砖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSBRICK_GLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSBRICK_GLOW"
msgid "These bricks glow at night too."
msgstr "这种砖晚上还亮着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTILES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTILES"
msgid "Pretty neat when lined up."
msgstr "排好以后挺整齐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTILES_GLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTILES_GLOW"
msgid "The floor doesn't even need a separate lamp."
msgstr "地板都不用另外照灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTRIM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTRIM"
msgid "Just right for the edges."
msgstr "放在边缘刚好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTRIM_GLOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_RUINSTRIM_GLOW"
msgid "Even the edges light up a bit."
msgstr "边上也能亮一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SANDY"
msgid "Brought back a whole floor of sand."
msgstr "带回来一地沙子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SAVANNA"
msgid "Shoveled off the savanna."
msgstr "草原上铲下来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SHELLBEACH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SHELLBEACH"
msgid "Brought the shells back along with it."
msgstr "贝壳都一起带回来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_SINKHOLE"
msgid "Turf dug out of the cave."
msgstr "洞里挖出来的地皮。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_UNDERROCK"
msgid "Another piece of underground stone floor."
msgstr "又一块地下的石地面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VAULT"
msgid "Bring it back and you can redo the floor."
msgstr "带回去可以重新铺地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_VENT"
msgid "This turf's dug from near the hot vents."
msgstr "这块地皮是从热气附近挖来的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURF_WOODFLOOR"
msgid "Wood floors are nicer to walk on."
msgstr "木地板走着舒服一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURKEYDINNER"
msgid "Everybody come, it's no good once it's cold."
msgstr "大家都来，凉了就不好吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP"
msgid "More root vegetables."
msgstr "又是根茎蔬菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP_COOKED"
msgid "Boil it soft before eating."
msgstr "煮软了再吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURNIP_SEEDS"
msgid "Have to find somewhere to plant it."
msgstr "还得找地方种。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TURTILLUS"
msgid "Don't touch its shell, it's all spikes."
msgstr "别碰它的壳，全是刺。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Burned before I could collect it."
msgstr "还没捡就烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Just charred twigs."
msgstr "只剩焦枝了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Chop, then pick up."
msgstr "砍完就捡起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Skinny to begin with, and now it's droopier."
msgstr "本来就瘦，现在更蔫了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Plenty of twigs, at least."
msgstr "枝条倒是很多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_NUT"
msgid "Another tree's seed."
msgstr "又一棵树的种子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It can just grow by itself."
msgstr "它自己慢慢长就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGGY_OLD"
msgid "This tree doesn't have much life in it."
msgstr "这树看着没什么精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWIGS"
msgid "Keep the twigs for now."
msgstr "树枝先收着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWINOFTERROR1"
msgid "One's annoying enough already."
msgstr "一只已经够烦了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.TWINOFTERROR2"
msgid "There's another one. No sleep today."
msgstr "还有另一只，今天不用睡了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UMBRELLA"
msgid "Just don't let my uniform get wet."
msgstr "别把制服淋湿就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNAGI"
msgid "This one's good, save me a serving."
msgstr "这道可以，给我留一份。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.UNIMPLEMENTED"
msgid "Clearly not finished yet."
msgstr "看着就还没做好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "The lamp's broken. Have to find another light."
msgstr "灯坏了，得另外找光。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "Follow it and we should have less wandering."
msgstr "跟着它走，应该能少绕些路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "Here. Let's find what we came for."
msgstr "到了，先找找要拿的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Doesn't work here. Put it away."
msgstr "这里用不了，先收起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Why's it dropping from above again!"
msgstr "怎么又从上面掉下来！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "It's in. Now what."
msgstr "放进去了，然后呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Look around before pulling it."
msgstr "先看看四周，再拉吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_DECON_DOOR"
msgid "We can come back after going through, right?"
msgstr "过去以后还能回来吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_DECON_MISTER"
msgid "Will it spray me as I go past."
msgstr "经过的时候会不会喷到我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY"
msgid "Got the key. Still have to find the door."
msgstr "钥匙有了，还得找到门。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Have to get power to it first."
msgstr "还得先通上电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_EXIT"
msgid "Can't tie a rope here, try somewhere else."
msgstr "这里没法绑绳子，换个地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "Check around before taking it."
msgstr "拿的时候先看看周围。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "Empty, it's already been taken."
msgstr "空了，东西已经拿过了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Tie the rope first, for the way back."
msgstr "先绑好绳子，回去时方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_ORB"
msgid "This orb should still be useful."
msgstr "这个球应该还有用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_ORB_REFINED"
msgid "It's processed. Where does it go next."
msgstr "处理好了，接下来放哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "This big, don't let it block the way out."
msgstr "这么大，别挡住退路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "Materials aren't all here, have to go find more."
msgstr "材料没齐，还得去找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Leave a path before setting it down."
msgstr "摆好之前先留条路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "With it on guard, I can rest for a bit."
msgstr "有它守着，我能歇一会了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "Don't touch it yet, let's watch."
msgstr "先别碰它，看看再说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "It's built, just needs activating."
msgstr "做完了，还差启动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "Take it for now, need it for later."
msgstr "先拿着，回去还要用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Still works after all this time. Let's figure out how to place it."
msgstr "这么久了还能用，先看看怎么放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_RUNE"
msgid "Can anyone read what's written here."
msgstr "谁能看懂上面写的什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE1"
msgid "Something awful happened here once."
msgstr "以前发生过很糟糕的事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE1_STALKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE1_STALKER"
msgid "No wonder you still remember."
msgstr "难怪你到现在还记着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE2"
msgid "There's another part here. Let's finish reading."
msgstr "这里还有一段，先看完吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_STATUE.LORE3"
msgid "So there's more to the story."
msgstr "原来后面还有这些事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "It's broken, can't go for now."
msgstr "坏了，暂时走不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "Bring everything, then go through."
msgstr "东西带齐，再过去吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "Out of power. Have to deal with that first."
msgstr "没能量了，还得先处理这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION"
msgid "Can't go this way yet."
msgstr "这里还不能走。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "Pressing it doesn't work, it needs fixing."
msgstr "按了也没用，得修。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "With light, it's much easier going."
msgstr "有了光就好走多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGGIEOMLET"
msgid "It's not omelette rice. It'll do."
msgstr "不是蛋包饭，凑合吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "Planted this long, and it's all rotten."
msgstr "种了这么久，全坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VEGSTINGER"
msgid "Do I have to eat the celery too?"
msgstr "这根芹菜也得一起吃？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "A beefalo in this looks ready for a dinner party."
msgstr "牛穿着像要去参加晚宴。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH"
msgid "A cloth I can't quite get a feel for."
msgstr "摸不太明白的布。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTHHAT"
msgid "Wearing it, I want to talk to people even less."
msgstr "戴上更不想和人说话了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Remember to catch it after you throw. No spacing out."
msgstr "扔完记得接，别发呆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_KIT"
msgid "Even shadow cloth has to be sewn yourself."
msgstr "暗影的布也得自己缝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Harvest a whole patch at once. Such a time-saver."
msgstr "一次能收一大片，真省事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "It blocks even acid rain."
msgstr "连酸雨也能挡住。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VOLTGOATJELLY"
msgid "Eat it and get shocked. Desserts keep getting more complicated."
msgstr "吃完带电，甜点越来越复杂了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VSCODE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.VSCODE"
msgid "I have to deal with code even here?"
msgstr "在这里也要面对代码？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAFFLES"
msgid "A bit more syrup and today's good."
msgstr "再加一点糖浆，今天就很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT"
msgid "A machine this big, who's fixing it?"
msgstr "这么大的机器，谁来修？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "Still covered up. Must not be done."
msgstr "还盖着，看来没做好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "Something this big, find a good spot first."
msgstr "这么大一台，先找好位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "Don't lose any, or we're searching again."
msgstr "别少一件，不然又得找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "Finally got a leg off."
msgstr "腿总算拆下来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "Can you shut it down first!"
msgstr "能先关机再说吗！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "So something was hidden here."
msgstr "这里原来还藏着东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_BEACON"
msgid "Makes them stay where they're supposed to."
msgstr "让它们留在规定的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "Too broken to fix. Strip it for parts."
msgstr "坏得修不了了，拆零件吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Now it's not safe overhead either."
msgstr "头顶也开始不安全了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "Not moving right now."
msgstr "现在没在动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_PARTS"
msgid "The parts are still usable."
msgstr "零件还能再用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "Fix it, or take it apart."
msgstr "修一修，或者拆下来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "This one won't chase and hit me."
msgstr "这只不会追着打我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Don't roll over to my feet."
msgstr "别滚到我脚边来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Let's see how to turn it on."
msgstr "先看看怎么开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNKBITS_KIT"
msgid "Let machines fix machines."
msgstr "让机器自己修机器就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNKHAT"
msgid "Wearing it, you can hear the parts rattle."
msgstr "戴着都能听到零件响。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_BITS"
msgid "Saving them to repair gear."
msgstr "留着修装备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Fenced in, they can't run around as much."
msgstr "围起来就不容易乱跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Even the floor's this complicated."
msgstr "地板也这么复杂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_LEVER"
msgid "Before flipping it, check what it starts."
msgstr "扳之前先看看会启动什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "Back at the workbench again."
msgstr "又要回到工作台前面。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "You can actually touch this glove."
msgstr "这只手套居然摸得到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "This clipboard's real too."
msgstr "记录板这回也是真的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Could anyone keep track of this pile of parts?"
msgstr "这一大堆零件还找得清？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "So many notes, is this on the test?"
msgstr "笔记写这么多，考试会考吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC"
msgid "Just say what you're looking for, stop beating around the bush."
msgstr "要找什么直说，别绕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Do you never rest?"
msgstr "您一直不休息的吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Where to now? I haven't caught up yet."
msgstr "又要去哪里，我还没跟上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "This must be what he wanted."
msgstr "这件应该是他要的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "The name's too long. Let's try this first."
msgstr "名字太长了，先拿这个试试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Just looks complicated."
msgstr "长得就很复杂。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "About what he described."
msgstr "和他说的样子差不多。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "Another tool I can't identify."
msgstr "又一件认不出来的工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK"
msgid "Can I get a lifeboat?"
msgstr "能给条救生船吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "Just walk off like this?"
msgstr "就这么走下去？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_GRASS"
msgid "This plank doesn't look steady."
msgstr "这块板看着就不稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKINGPLANK_YOTD"
msgid "Pretty decorations won't make me want to jump."
msgstr "装饰漂亮也不会更想跳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALKING_STICK"
msgid "Walking with it's a little faster."
msgstr "拿着走路能快一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_DREADSTONE"
msgid "Very sturdy, but it doesn't look reassuring."
msgstr "很牢，就是看着不太安心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Build the wall first."
msgstr "先把墙搭好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY.BURNT"
msgid "Not fire-resistant, as expected."
msgstr "果然不耐火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY.GENERIC"
msgid "If it blocks for a while, that's fine."
msgstr "能挡一会就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_HAY_ITEM"
msgid "Don't build it beside a fire."
msgstr "别搭在火旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_MOONROCK"
msgid "This wall's pretty sturdy."
msgstr "这墙挺结实。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Not heavy to hold, but really hard once built."
msgstr "拿着不重，搭起来却很硬。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS"
msgid "It's old, but pretty steady."
msgstr "旧归旧，还挺稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS_2"
msgid "This stretch is still standing too."
msgstr "这一段也还站着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_RUINS_ITEM"
msgid "Bring it back, then install it."
msgstr "搬回来再装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_SCRAP"
msgid "Even assembled junk can block the way."
msgstr "破烂拼好也能挡路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_SCRAP_ITEM"
msgid "The parts are prickly, careful holding them."
msgstr "零件扎手，小心拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE"
msgid "A stone wall's somewhat reassuring."
msgstr "石墙看着安心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE_2"
msgid "This stretch is plenty stable too."
msgstr "这段也够稳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_STONE_ITEM"
msgid "Let's stack it piece by piece."
msgstr "一块块搭起来吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD.BURNT"
msgid "Wooden walls still don't like fire."
msgstr "木墙还是怕火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD.GENERIC"
msgid "It's all spiky on top."
msgstr "顶上都是尖的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALL_WOOD_ITEM"
msgid "Don't stab yourself building it."
msgstr "装的时候别扎到自己。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS"
msgid "Don't let it aim that blowdart at me."
msgstr "别让它拿吹箭瞄着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUSHAT"
msgid "Warm, just some old fur."
msgstr "暖和，就是有些旧毛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "Someone only comes back in winter."
msgstr "冬天才有人回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Looks warm inside, and I'm clearly not welcome."
msgstr "里面看着暖和，又不欢迎我进去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALRUS_TUSK"
msgid "Make it a cane and I won't walk so slowly."
msgstr "拿来做手杖就不用走那么慢了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.ATTACKER"
msgid "Scouts shouldn't throw the first punch, right?"
msgstr "童子军不该先动手吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s, that's not a campfire."
msgstr "%s，那可不是篝火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.GENERIC"
msgid "%s, keep the stories short."
msgstr "%s，故事别讲太长。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.GHOST"
msgid "Don't worry Woby. I'll go find a heart."
msgstr "别逗沃比着急，我去找心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.MURDERER"
msgid "%s, this kind of thing isn't a story."
msgstr "%s，这种事情可不是故事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTER.REVIVER"
msgid "%s, really, thank you today."
msgstr "%s，今天真的多谢你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WALTERHAT"
msgid "That kind of hat from club activities."
msgstr "课外活动那种帽子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.ATTACKER"
msgid "%s, hold on, let's talk this through."
msgstr "%s，停一下，有话慢慢说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.FIRESTARTER"
msgid "Changing the time doesn't mean burning things."
msgstr "改时间也不用烧东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.GENERIC"
msgid "%s, can you make a boring afternoon go faster?"
msgstr "%s，能让无聊的下午过快一点吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.GHOST"
msgid "Don't worry, this time we're the ones racing the clock."
msgstr "别急，这次换我们赶时间。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.MURDERER"
msgid "Stop using time as an excuse!"
msgstr "别再用时间当借口了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDA.REVIVER"
msgid "%s, you're right on time."
msgstr "%s，你赶得正好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "This beefalo's getting up is kind of weird."
msgstr "这头牛的打扮有点奇怪。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "Got anything good to trade?"
msgstr "有好东西可以换吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.BURNING"
msgid "The clothes are still in there!"
msgstr "衣服还在里面！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.BURNT"
msgid "Well, no choices now."
msgstr "这下没得选了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARDROBE.GENERIC"
msgid "Which one today? I've been thinking and still can't decide."
msgstr "今天换哪一件，想半天也没决定。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARG"
msgid "So big, and it brings a pack too."
msgstr "这么大一只还要带一群来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.BURNING"
msgid "Don't get back up this time."
msgstr "这回别再站起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.GENERIC"
msgid "Still doesn't make me feel safe."
msgstr "看着还是不太放心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Knew it! It moved again!"
msgstr "果然又动了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGLET"
msgid "Getting chased around again today."
msgstr "今天又要被追着跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.BURNING"
msgid "Too big a fire, put it out first."
msgstr "火太大了，先灭掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.BURNT"
msgid "It's burned out."
msgstr "已经烧坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Put a torch in first."
msgstr "先放个火把。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Could make something fun."
msgstr "能做点好玩的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.ATTACKER"
msgid "Put down the cookware, don't do anything rash."
msgstr "先放下厨具，别冲动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.FIRESTARTER"
msgid "The fire's left the kitchen!"
msgstr "火已经烧出厨房了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.GENERIC"
msgid "%s, what are you making today? I can taste it first."
msgstr "%s，今天做什么？我可以先尝一口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.GHOST"
msgid "Don't go far, we're having dinner together."
msgstr "别走远，我们还要一起吃晚饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.MURDERER"
msgid "Cookware isn't for that!"
msgstr "厨具可不能这样用！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WARLY.REVIVER"
msgid "%s, thanks. This time I'll finish my meal properly."
msgstr "%s，谢谢。这次我会把饭好好吃完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAR_BLUEPRINT"
msgid "Even a beefalo looks fiercer in this."
msgstr "牛穿上都显得更凶了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WASPHIVE"
msgid "So many red ones, go around."
msgstr "这么多红色的，绕路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERBALLOON"
msgid "Not in the face."
msgstr "别往脸上扔。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Empty. Back to the pond."
msgstr "空了，还得去池塘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Watering time again."
msgstr "又到浇水的时候了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON"
msgid "Save me the sweetest piece once it's cut."
msgstr "切开以后给我留最甜的那块。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELONHAT"
msgid "Cool, sure, but juice all over my face."
msgstr "凉是凉，脸上全是汁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELONICLE"
msgid "This makes summer bearable."
msgstr "这个夏天还过得下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_COOKED"
msgid "It's better cold."
msgstr "还是冰一点更好吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_OVERSIZED"
msgid "Enough for everybody."
msgstr "大家一起吃也够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERMELON_SEEDS"
msgid "By the time it's grown, summer's half over."
msgstr "等长好，夏天都过半了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT"
msgid "Don't pick it, it'll get mad."
msgstr "别乱摘，它会生气。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_BABY"
msgid "So small, and pretty quiet."
msgstr "这么小还挺安静。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_BOMB"
msgid "It's throwing stuff over, dodge!"
msgstr "它把东西扔过来了，躲开！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPLANT_PLANTER"
msgid "Have to find a reef in the sea."
msgstr "得找块海里的礁石。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERPUMP"
msgid "If only it would put out the fire quickly."
msgstr "能赶快灭火就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERTREE_PILLAR"
msgid "You could rest a long time under it."
msgstr "在下面能歇很久。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATERTREE_ROOT"
msgid "Don't get the boat stuck on the roots."
msgstr "船别卡在根上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s, I don't feel like sparring right now."
msgstr "%s，我不想现在陪练。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "%s, put out the fire before the war cries."
msgstr "%s，先灭火再喊口号。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.GENERIC"
msgid "%s, so much energy again today."
msgstr "%s，今天也有这么多精神。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.GHOST"
msgid "%s, no rush for Valhalla, everyone's waiting for you."
msgstr "%s，别急着去英灵殿，大家还在等你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.MURDERER"
msgid "%s, come to your senses, stop fighting!"
msgstr "%s，清醒一点，别再打了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s, you were really dependable this time."
msgstr "%s，这次是真的很可靠。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHRHAT"
msgid "Horns this big, you'd hit your head on the door."
msgstr "角这么大，进门会撞到吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "Wear this and I have to lead the team?"
msgstr "戴着就得负责带队吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WATHGRITHR_SHIELD"
msgid "With this I can block it."
msgstr "有这个就能挡住了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXED_PLANT"
msgid "This way, no need to look after it every day."
msgstr "这样就不用天天照顾。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXPAPER"
msgid "Wrap it up and it lasts longer."
msgstr "包起来能留得久一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.ATTACKER"
msgid "Call off your shadows."
msgstr "把影子收回去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "%s, you've learned to play with fire too?"
msgstr "%s，你也学会乱点火了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.GENERIC"
msgid "%s, don't make your shadows do everything again."
msgstr "%s，别又让影子替你做完所有事。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.GHOST"
msgid "%s, don't rush me, I don't have your shadows to help."
msgstr "%s，别催，我没有你的影子帮忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.MURDERER"
msgid "Haven't you learned your lesson!"
msgstr "你还没吸取教训吗！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELL.REVIVER"
msgid "%s... thanks. I'll remember this time."
msgstr "%s……谢谢，这次我会记得。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "The cost of reading this one is way too high."
msgstr "读这本的代价也太高了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.ATTACKER"
msgid "Calm down first, don't send your friends at me."
msgstr "先冷静，别让朋友们一起上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Webs burn too, put it out!"
msgstr "蛛网也会烧，快灭火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.GENERIC"
msgid "%s, come sit. Keep the spiders back a bit."
msgstr "%s，过来坐，蜘蛛先留远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.GHOST"
msgid "%s, don't be scared, just wait for me a little."
msgstr "%s，别害怕，等姐姐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.MURDERER"
msgid "%s, stop! This isn't playing anymore!"
msgstr "%s，停下来！这已经不是玩闹了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER.REVIVER"
msgid "%s, you did really well. Really."
msgstr "%s，做得很好，真的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBERSKULL"
msgid "So small... he should be left to rest in peace."
msgstr "这么小……该让他好好安息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "I know you're here to help."
msgstr "知道你们是来帮忙的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEED_IVY"
msgid "That's no vegetable growing."
msgstr "这长的可不是菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.ATTACKER"
msgid "%s, put down the sharp thing first."
msgstr "%s，把尖的东西先放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.FIRESTARTER"
msgid "%s, keep Abigail away from the fire."
msgstr "%s，别让阿比盖尔靠近火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.GENERIC"
msgid "%s, let's sit for a while. We don't have to talk."
msgstr "%s，一起坐会吧。不说话也可以。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.GHOST"
msgid "%s, don't float away, I'll go find a heart."
msgstr "%s，别乱飘，我去找颗心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.MURDERER"
msgid "Abigail wouldn't want you doing this!"
msgstr "阿比盖尔不会希望你这样做！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY.REVIVER"
msgid "%s, thank you."
msgstr "%s，谢谢你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "She knows she can still come back."
msgstr "她知道自己还能回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_BEAVER"
msgid "Woodie has to eat weird stuff even to transform."
msgstr "伍迪连变身都得吃奇怪的东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_GOOSE"
msgid "Eat it and turn into a goose?"
msgstr "吃了就变成鹅？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WEREITEM_MOOSE"
msgid "Looks pretty hefty."
msgstr "看着就很有分量。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.ATTACKER"
msgid "%s, I can tell you want to fight even without a sound."
msgstr "%s，不出声也看得出你想动手。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.FIRESTARTER"
msgid "Quit acting, go get water."
msgstr "别演了，先去拿水。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.GENERIC"
msgid "%s, no talking today either. That's nice."
msgstr "%s，今天也不用说话，挺好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.GHOST"
msgid "I know. Let me go make a heart."
msgstr "我知道。等我去做颗心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.MURDERER"
msgid "Stop! I can see what you did!"
msgstr "停下！我看得见你做了什么！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WES.REVIVER"
msgid "%s, no need to explain. I know it was you."
msgstr "%s，不用解释，我知道是你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETGOOP"
msgid "You can't even say what's in this pot."
msgstr "连这锅是什么都说不清。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETPAPER"
msgid "Don't touch it till it's dry."
msgstr "晾干以前别碰。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WETPOUCH"
msgid "It's falling apart, careful with it."
msgstr "快散了，小心拿。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WHIP"
msgid "Don't crack it suddenly, it's too loud."
msgstr "别突然甩，声音太大。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "Ms. %s, please put the book down first."
msgstr "%s女士，先把书放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Ma'am, the books are right there!"
msgstr "女士，书还在旁边！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Ms. %s, no quiz today, right?"
msgstr "%s女士，今天没有测验吧？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "Ms. %s, let us look after you this time."
msgstr "%s女士，这次让我们来照顾您。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Ma'am, this can't count as teaching!"
msgstr "女士，这可不能当作教学！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "Ms. %s, thank you."
msgstr "%s女士，谢谢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.ATTACKER"
msgid "%s, don't take it out on other people."
msgstr "%s，别把气撒在别人身上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Again? Put the fire out first!"
msgstr "又来了？先灭火！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.GENERIC"
msgid "%s, sit over here. Put the lighter away first."
msgstr "%s，坐过来，打火机先收好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.GHOST"
msgid "%s, Bernie's still waiting for you."
msgstr "%s，伯尼还在等你呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.MURDERER"
msgid "That's enough! Stop hurting people!"
msgstr "够了！别再伤害别人！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILLOW.REVIVER"
msgid "%s, thanks. No nagging about your lighter today."
msgstr "%s，谢了，今天不念你的打火机了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.ATTACKER"
msgid "Put down the lab equipment."
msgstr "把实验工具放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.FIRESTARTER"
msgid "%s, is this part of the experiment too?"
msgstr "%s，这也是实验的一部分？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.GENERIC"
msgid "For this experiment, could you make breakfast first."
msgstr "这次实验能不能先做早餐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.GHOST"
msgid "Don't study how you're floating yet. I'll go find a heart."
msgstr "先别研究自己怎么飘，我去找心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.MURDERER"
msgid "%s, science can't be your excuse!"
msgstr "%s，科学可不能拿来当借口！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WILSON.REVIVER"
msgid "%s, thank you."
msgstr "%s，谢谢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.GENERIC"
msgid "Heavy stuff can go to the machine."
msgstr "重东西交给机器就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "What did it haul up?"
msgstr "捞到了什么？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "Just pull it up slowly."
msgstr "慢慢拉上来就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.ATTACKER"
msgid "%s, put the tools down and then talk."
msgstr "%s，先放下工具再说话。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.FIRESTARTER"
msgid "It's burning next to the workbench!"
msgstr "工作台旁边烧起来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.GENERIC"
msgid "%s, take a break, the machines aren't going anywhere."
msgstr "%s，先休息一下吧，机器不会跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.GHOST"
msgid "This time it's my turn to help you."
msgstr "这次轮到我帮你了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.MURDERER"
msgid "%s, stop, this won't fix the people you hurt!"
msgstr "%s，停手，这修不好你伤害的人！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA.REVIVER"
msgid "%s, you always think of something."
msgstr "%s，你总能想到办法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "The generator's on fire!"
msgstr "发电机烧起来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "No more power."
msgstr "供不了电了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Put gems in and it generates power."
msgstr "宝石放进去就能供电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "Almost out of power."
msgstr "快没电了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Not on yet."
msgstr "还没开起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "Too big a load, back off!"
msgstr "负荷太大，离远一点！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Put out the fire first!"
msgstr "先把火灭掉！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Too broken to use."
msgstr "坏得不能用了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Let it power everything."
msgstr "让它替大家供电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Fuel's almost out."
msgstr "燃料快用完了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "It's shut down."
msgstr "停机了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Even the defense machine's on fire!"
msgstr "防卫机器也着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "It can't guard camp now."
msgstr "这回守不了营地了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Having it on guard is a bit reassuring."
msgstr "有它守着就安心一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It can't fire without power."
msgstr "没电就打不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "Let it rest for now."
msgstr "暂时让它休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.CHARGED"
msgid "Ready."
msgstr "准备好了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.CHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.CHARGING"
msgid "Still charging."
msgstr "还在充电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.GENERIC"
msgid "Press a button to control it."
msgstr "按按钮就能控制。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_REMOTE.OFF"
msgid "No power, pressing it does nothing."
msgstr "没电，按了也没用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Even the lights are on fire!"
msgstr "灯也烧起来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Can't light the way now."
msgstr "照不了路了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "No more worrying about light running out two steps in."
msgstr "不怕走两步就没光了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Still needs power."
msgstr "还得供电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "Off for now."
msgstr "暂时关着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "Ready to get to work."
msgstr "能开始干活了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "You charge, I'll sit a while."
msgstr "你充电，我坐一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "Come here, help me put stuff away."
msgstr "过来，帮我收一下东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "Out of power, don't rush it."
msgstr "没电了，先别催它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "It needs rest too."
msgstr "它也要休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "Now I can go straight there."
msgstr "这回能直接过去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "Have to wait a little longer."
msgstr "还得再等会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "Winona's made another thing that saves walking."
msgstr "薇诺娜又做出省走路的东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "No power, can't go for now."
msgstr "没电，暂时走不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "The teleport pad's on fire!"
msgstr "传送台着火了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "There goes that shortcut."
msgstr "这条近路没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "Set a teleport point here."
msgstr "在这里设个传送点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "No power."
msgstr "没供电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERHAT"
msgid "With this, winter's a bit more bearable."
msgstr "有了它，冬天好过一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTEROMETER.BURNT"
msgid "I don't need it to tell me the temperature now."
msgstr "温度已经不用它提醒了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Reading it won't make things warmer."
msgstr "看完也不会自动变暖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTFUEL"
msgid "Put it in and it feels like a holiday."
msgstr "放进去就有过节的感觉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "Almost ready, I'll get the plates."
msgstr "快好了，我先拿盘子。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Wait, stop lifting the lid."
msgstr "等会，别一直掀。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Bring it out, let's all eat."
msgstr "端上去，大家一起吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "Could make something special today."
msgstr "今天能做些特别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD1"
msgid "A gingerbread man. Which side do I bite first."
msgstr "姜饼小人，先咬哪边呢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD2"
msgid "Sugar cookie, I'll take another."
msgstr "糖霜饼干，再拿一块。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD3"
msgid "This candy stick lasts all afternoon."
msgstr "这根糖能吃一下午。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD4"
msgid "Looks so real I almost didn't dare eat it."
msgstr "做得太像了，差点没敢吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD5"
msgid "Finally, a change of flavor."
msgstr "总算换点口味了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD6"
msgid "Save me some pudding."
msgstr "布丁给我留一份。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD7"
msgid "A cup made of an apple, that's dedication."
msgstr "苹果做的杯子，也太认真了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD8"
msgid "Nice and warm, one sip and I feel great."
msgstr "暖暖的，一口就舒服了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_FOOD9"
msgid "This eggnog's really good."
msgstr "这杯蛋奶味道真好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENT"
msgid "Hang it where it can be seen."
msgstr "挂到看得到的位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "This one should go in the most prominent spot."
msgstr "这个得摆在最显眼的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Reminds me of that fight."
msgstr "看着就想起那场打斗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "This ornament's making me hungry."
msgstr "这个装饰让我饿了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "It'll look nice lit up at night."
msgstr "晚上亮起来会很好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Hang it up. Don't keep it stored away."
msgstr "挂起来吧，别收着看不到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.BURNING"
msgid "Put it out, the gifts are still under the tree!"
msgstr "快灭火，礼物还在树下！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.BURNT"
msgid "There goes this year's tree..."
msgstr "今年的树没了……"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Let's get it decorated today."
msgstr "今天就把它装饰好吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Not big enough to hang stuff on yet."
msgstr "还没长到能挂东西。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "The stand burned too."
msgstr "架子也烧坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "Still missing a pinecone."
msgstr "还缺一颗松果。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_DEN"
msgid "Wobsters hide in the rocks."
msgstr "龙虾躲在石头里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_MOONGLASS"
msgid "Moon wobsters look hard to catch too."
msgstr "月亮的龙虾看着也挺难抓。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER"
msgid "Just don't pinch me."
msgstr "别夹到我就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Now it can go in the pot."
msgstr "这回可以拿去做饭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Eat it hot, today's looking good."
msgstr "趁热吃，今天不错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYBIG.1"
msgid "Woby, can you give me a lift today too?"
msgstr "沃比，今天也能带我一程吗？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYBIG.2"
msgid "Grown big and still so good."
msgstr "变大了还是这么乖。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYSMALL.1"
msgid "Come here, let me pet you."
msgstr "过来，摸一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBYSMALL.2"
msgid "As soon as you come over, I can't bring myself to get up."
msgstr "你一靠过来，我就舍不得起身了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOBY_TREAT"
msgid "That's Woby's, don't take the wrong one."
msgstr "这是沃比的，别拿错了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.ATTACKER"
msgid "Calm down first. Being strong means going easy."
msgstr "先冷静，力气大也要轻点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "%s, you can't punch a fire out."
msgstr "%s，火可不能用拳头解决。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.GENERIC"
msgid "%s, could you carry this heavy thing for me."
msgstr "%s，这个重的能帮我拿一下吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.GHOST"
msgid "Hold still, I'll go find a heart."
msgstr "别乱动，我去找颗心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.MURDERER"
msgid "Stop! That's our friend!"
msgstr "停下！那是我们的同伴！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s, really, thank you."
msgstr "%s，真的谢谢你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOLFGANG_WHISTLE"
msgid "Hearing it reminds me of gym class."
msgstr "一听就想起体育课。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.ATTACKER"
msgid "Quit fooling around, put it down."
msgstr "先别闹，把东西放下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Being a monkey doesn't mean you can light fires."
msgstr "变成猴子也不能乱点火。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.GENERIC"
msgid "How did you end up like this."
msgstr "你怎么变成这样了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.GHOST"
msgid "Don't float around, I'll figure something out."
msgstr "先别到处飘，我去想办法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.MURDERER"
msgid "Stop, don't hurt anyone else!"
msgstr "停手，别再伤人！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WONKEY.REVIVER"
msgid "Thanks. Let's eat together when you're back to normal."
msgstr "谢谢，变回来了再一起吃饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODCARVEDHAT"
msgid "This pattern must have taken forever to carve."
msgstr "这花纹得刻很久吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.ATTACKER"
msgid "%s, put Lucy down for a bit."
msgstr "%s，露西先放一放。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.BEAVER"
msgid "%s, don't gnaw through all the trees in camp."
msgstr "%s，别把营地的树也啃完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "%s, no rush, I'll think of something soon."
msgstr "%s，先别着急，马上想办法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.FIRESTARTER"
msgid "%s, the wood's going to burn!"
msgstr "%s，木头都要烧了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GENERIC"
msgid "%s, chopping trees today too?"
msgstr "%s，今天也在砍树？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GHOST"
msgid "%s, wait a little, we'll help you."
msgstr "%s，先等一会，我们会帮你的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GOOSE"
msgid "You sure run fast."
msgstr "你跑得可真快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "No more running around once you're back."
msgstr "回来以后别再乱跑了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MOOSE"
msgid "Don't charge around near the tents."
msgstr "别在帐篷旁边冲。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Even something this big gets cold, huh. Wait for me."
msgstr "这么大一只也会冷吧，等我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.MURDERER"
msgid "Come to your senses, stop chopping!"
msgstr "清醒一点，别再砍了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOODIE.REVIVER"
msgid "%s, thank you."
msgstr "%s，谢谢你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "Sit on it and it'll definitely fall apart."
msgstr "坐下去肯定会散。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Finally, somewhere to sit."
msgstr "终于有地方坐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Someone's sitting here."
msgstr "这里有人了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.BURNT"
msgid "This table's no good now."
msgstr "这桌用不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "Bring food over and we can eat."
msgstr "把饭端来就能开吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "There's something on the table."
msgstr "桌上有东西了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.DIRT"
msgid "Stay away, that pile of dirt moves."
msgstr "别靠近，那堆土会动。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.PLANT"
msgid "Looks like food, but don't rush to pick it."
msgstr "长得像食物，也别急着摘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM.WORM"
msgid "Knew it! It came from underground!"
msgstr "果然从地下钻出来了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE.GENERIC"
msgid "Just looking at it, I don't want to jump in."
msgstr "光看着就不想跳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE.OPEN"
msgid "Less walking, just a little gross."
msgstr "能少走路，就是有点恶心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMHOLE_LIMITED"
msgid "This one looks like it's about to give out."
msgstr "这个看着快不行了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT"
msgid "Glowing doesn't make it a snack."
msgstr "会发光也不能直接当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT_LESSER"
msgid "A bit wrinkly. Sat too long?"
msgstr "有点皱，放太久了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMLIGHT_PLANT"
msgid "Check underground before picking it."
msgstr "先看看地下再摘。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.ATTACKER"
msgid "%s, put the thorns away first."
msgstr "%s，先把刺收起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s, stay away from the fire, you can burn too."
msgstr "%s，离火远点，你也会烧伤的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.GENERIC"
msgid "%s, looking after your friends today too?"
msgstr "%s，今天也在照顾朋友们？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.GHOST"
msgid "I'm here. I won't let you wait alone."
msgstr "我在这里，不会让你一个人等。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.MURDERER"
msgid "%s, stop hurting everyone!"
msgstr "%s，别再伤害大家了！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s, thanks."
msgstr "%s，谢谢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "It stopped moving."
msgstr "已经不动了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Wormwood's new friend can run too."
msgstr "沃姆伍德的新朋友还会跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "Don't burrow around in my pocket."
msgstr "别在口袋里乱钻。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "It looks so small asleep."
msgstr "睡着的样子真小。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Don't pick it yet, it's alive."
msgstr "先别摘，它还活着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "Be careful once it's ripe."
msgstr "熟了以后可要小心。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "Pretty cute when it's quietly asleep."
msgstr "安静睡着的时候倒很可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "He found another little lamp."
msgstr "他又找来一只小灯。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM_BOSS"
msgid "This big. How much more is underground."
msgstr "这么大，地下到底还有多少。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM_BOSS_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORM_BOSS_SHADOW"
msgid "There's hardly anywhere left to back away to."
msgstr "连退开的地方都快没有了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.ATTACKER"
msgid "%s, that's enough joking around."
msgstr "%s，玩笑到这里就够了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.FIRESTARTER"
msgid "%s, that's not funny."
msgstr "%s，这样可不好笑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.GENERIC"
msgid "%s, don't mess with me today."
msgstr "%s，今天先别捉弄我。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.GHOST"
msgid "Guess it's up to us this time too."
msgstr "这次也要靠我们了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.MURDERER"
msgid "Stop pretending it's just a prank!"
msgstr "别再装成只是恶作剧！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX.REVIVER"
msgid "%s, thanks. Next time I'll treat you to... whatever you can eat."
msgstr "%s，谢谢。下次请你吃……你能吃的那个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_NABBAG"
msgid "Handy for grabbing stuff. Don't grab mine."
msgstr "捡东西很方便，别捡我的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_REVIVER"
msgid "A tuft of fur can save someone?"
msgstr "留一撮毛就能救人？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WORTOX_SOULJAR"
msgid "Close it up, don't let what's inside out."
msgstr "盖好，别让里面的跑出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.ATTACKER"
msgid "%s, put the weapon down first, let's talk."
msgstr "%s，先把武器放下，慢慢说。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.FIRESTARTER"
msgid "Fire will burn your home too."
msgstr "火会把家也烧掉的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.GENERIC"
msgid "%s, want some of my vegetables."
msgstr "%s，要不要分你一点蔬菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.GHOST"
msgid "%s, don't be scared, I'll find a heart and be right back."
msgstr "%s，别怕，我去找心，很快回来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.MURDERER"
msgid "Stop, someone won't come back from this!"
msgstr "停下，这样会有人回不来的！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT.REVIVER"
msgid "%s, thank you."
msgstr "%s，谢谢你。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "Looking at it makes my head a little dizzy."
msgstr "看着脑袋有点发晕。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "Wurt, can you keep this farther away."
msgstr "沃特，这个放远一点好吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.ATTACKER"
msgid "%s, don't treat everyone as an enemy."
msgstr "%s，别把所有人都当敌人。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.FIRESTARTER"
msgid "%s, put out the fire first, even your casing can't take that."
msgstr "%s，先灭火，外壳也会受不了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.GENERIC"
msgid "%s, do you get bored too with nothing to do."
msgstr "%s，没事做的时候你也会无聊吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.GHOST"
msgid "%s, as long as your soul's here there's still a way."
msgstr "%s，灵魂还在就还有办法。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.MURDERER"
msgid "%s, stop right now!"
msgstr "%s，立刻停下！"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78.REVIVER"
msgid "%s, thanks."
msgstr "%s，谢谢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_BEE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_BEE"
msgid "I heard it lets it self-repair."
msgstr "听说能让它自己恢复。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_CHESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_CHESS"
msgid "Install it and it can bring along machines?"
msgstr "装了以后就能带着机械走了？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_COLD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_COLD"
msgid "It cools down the machine."
msgstr "给机器降温的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_DIGESTION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_DIGESTION"
msgid "Machines need this to eat too."
msgstr "机器吃东西也需要这个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_HEAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_HEAT"
msgid "Should be warm near it in winter."
msgstr "冬天靠近它应该会暖和。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_LIGHT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_LIGHT"
msgid "Install it and it works as a lamp."
msgstr "装好就能当灯用。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_LIGHT2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_LIGHT2"
msgid "Can see better at night."
msgstr "晚上能看得更清楚了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHEALTH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHEALTH"
msgid "Lets the casing hold up longer."
msgstr "能让外壳多撑一会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHEALTH2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHEALTH2"
msgid "This one adds a bit more."
msgstr "这一片能多加一些。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHUNGER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHUNGER"
msgid "Install it and I look for food less often."
msgstr "装完能少找几次饭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHUNGER1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXHUNGER1"
msgid "A smaller food storage circuit."
msgstr "小一点的储粮电路。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXSANITY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXSANITY"
msgid "This makes it think more clearly?"
msgstr "这能让它想得更清楚？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXSANITY1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MAXSANITY1"
msgid "Also helps keep its head steady."
msgstr "也能帮它稳住脑袋。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MOVESPEED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MOVESPEED"
msgid "If it runs faster, I don't have to wait."
msgstr "跑快一点就不用等它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MOVESPEED2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MOVESPEED2"
msgid "It can run even faster."
msgstr "还能跑得更快。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_MUSIC"
msgid "Machines can play music now."
msgstr "机器也能放音乐了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_NIGHTVISION"
msgid "No light needed at night. So convenient."
msgstr "晚上都不用灯，真方便。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_RADAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_RADAR"
msgid "Saves searching all over the place."
msgstr "省得四处乱找。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SCREECH
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SCREECH"
msgid "Warn me before using it."
msgstr "用的时候先提醒我一声。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SHIELDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SHIELDING"
msgid "Getting hurt a bit less is great."
msgstr "能少受点伤就很好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SPIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_SPIN"
msgid "If you're going to spin, get away from me first."
msgstr "要转的话先离我远一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_STACKSIZE"
msgid "A few less trips back and forth."
msgstr "能少来回搬几趟了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_TASER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78MODULE_TASER"
msgid "Think twice before touching it."
msgstr "碰它之前得想清楚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_BACKUPBODY.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "It can even keep a spare body."
msgstr "连身体都能准备一份备用的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "If it can deliver, that's so much easier."
msgstr "能帮忙送过去就方便多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Have it look first, saves a wasted trip."
msgstr "让它先看看，省得白跑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_ZAP"
msgid "Don't zap me too."
msgstr "别把我也电到。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Confirm where it is before pressing."
msgstr "按之前先确认它在哪里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "How could you possibly eat this."
msgstr "这怎么吃得下去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Soaked, it should be a bit less hard."
msgstr "泡过以后应该没那么硬了吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Once it's locked in, don't come back out."
msgstr "关进去以后别再跑出来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Now it has somewhere to put its own stuff."
msgstr "它自己的东西有地方放了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_MODULEREMOVER"
msgid "There's a special tool even for pulling circuits."
msgstr "拔电路也有专门工具。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Who's actually inside this body."
msgstr "这具身体里到底是谁。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.GENERIC"
msgid "So tiny, and flying around so busily."
msgstr "小小一台，飞得倒很忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.HUNTING"
msgid "Still looking for a target."
msgstr "还在找目标。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.SCANNING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER.SCANNING"
msgid "Found it. Wait till it finishes scanning."
msgstr "找到了，等它扫完。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER_ITEM"
msgid "It can be put away quietly now."
msgstr "现在能安静收起来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER_SUCCEEDED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SCANNER_SUCCEEDED"
msgid "Notes done. Bring it back to WX-78."
msgstr "记完了，回去交给WX-78。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "Let it deal with the enemies."
msgstr "让它去对付敌人吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.WX78_SHADOWDRONE_HARVESTER"
msgid "Good, someone to help collect stuff."
msgstr "有人帮忙收东西就好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.W_RADIO"
msgid "Tune it first, no more constant static."
msgstr "先调好，别一直响杂音。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YARI
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YARI"
msgid "Long enough. Check your sides before turning with it."
msgstr "够长，拿着转身先看看旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWAMULET"
msgid "Wear it and you can see the area clearly."
msgstr "戴着就能看清周围。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWGEM"
msgid "This one looks like it's been in the sun."
msgstr "这颗像晒过太阳。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWMOONEYE"
msgid "Mark it here so I won't go the wrong way next time."
msgstr "标在这里，下次就不会走错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YELLOWSTAFF"
msgid "At least there's somewhere warm at night."
msgstr "晚上能有个暖和的地方。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT"
msgid "The beefalo festival burned down too."
msgstr "牛的节日也烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY"
msgid "Put in some beefalo wool first."
msgstr "先放点牛毛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC"
msgid "What to make for the beefalo this year."
msgstr "今年给牛做什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.GENERIC"
msgid "However fierce, a little doll's still huggable."
msgstr "小玩偶再凶也能抱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.YOTB"
msgid "Show it to the judge."
msgstr "拿给裁判看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_DOLL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_DOLL.GENERIC"
msgid "This one's soft, I want to keep it."
msgstr "这个软，想留一个。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_DOLL.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_DOLL.YOTB"
msgid "What will he think of this one?"
msgstr "他会怎么评价这款？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.GENERIC"
msgid "This one's best for the holiday table."
msgstr "这个最适合摆在过节的桌上。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.YOTB"
msgid "Let's see if the judge likes it."
msgstr "看看裁判喜不喜欢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.GENERIC"
msgid "Even the little doll dresses this formally."
msgstr "小玩偶也穿得这么正式。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.YOTB"
msgid "Let the judge choose."
msgstr "让裁判来挑。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.GENERIC"
msgid "Hugging it shouldn't actually be cold."
msgstr "抱着应该不会真的冷。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.YOTB"
msgid "Will this one score high."
msgstr "这款会拿高分吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.GENERIC"
msgid "The flower decorations are pretty cute."
msgstr "花装饰得挺可爱。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.YOTB"
msgid "Take it over and show him."
msgstr "拿过去让他看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ROBOT.GENERIC"
msgid "At least the doll doesn't need charging."
msgstr "玩偶至少不用充电。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ROBOT.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_ROBOT.YOTB"
msgid "Does he like this style."
msgstr "这种风格他喜欢吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.GENERIC"
msgid "Way too much detail."
msgstr "做得也太仔细了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_VICTORIAN.YOTB"
msgid "Ask the judge first."
msgstr "先问问裁判。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.GENERIC"
msgid "So tiny, and so serious."
msgstr "小小一只也这么认真。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.YOTB
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_BEEFALO_DOLL_WAR.YOTB"
msgid "Time to go show it."
msgstr "该拿去展示了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_1"
msgid "Only got part of the pattern."
msgstr "图样只拿到一部分。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_2"
msgid "Need a few more pieces to sew."
msgstr "再凑几片才能缝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_PATTERN_FRAGMENT_3"
msgid "Still have to find them all."
msgstr "还得找齐才行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_POST"
msgid "Tie the beefalo here to wait for the contest."
msgstr "把牛拴这里等比赛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_POST_ITEM"
msgid "Set up the display spot first."
msgstr "先摆好展示的位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "I've never been this careful sewing my own clothes."
msgstr "给自己缝衣服都没这么认真。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "Set it up before sewing."
msgstr "装好才能开始缝。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_STAGE"
msgid "When exactly did the judge get in there."
msgstr "裁判到底什么时候进去的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTB_STAGE_ITEM"
msgid "Even have to build the judge's stage myself."
msgstr "连裁判台也要自己搭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Can't make anything now."
msgstr "这下做不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It should like carrots."
msgstr "它应该喜欢胡萝卜。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "Let's see what we can make."
msgstr "看看能做点什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "No direction training today."
msgstr "今天不用练方向了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "First, train till it stops running backward."
msgstr "先练到别跑反。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "This way. That's right."
msgstr "这个方向，对了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "Set it up, then call it over."
msgstr "装好再把它叫来。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Practice has to stop too."
msgstr "练习也只能停了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "Reaction training next."
msgstr "还得练反应。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "A bit faster this time."
msgstr "这次快了一点。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "So it isn't always half a beat late."
msgstr "让它别总慢半拍。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "The treadmill burned too."
msgstr "跑步机也烧坏了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Gotta run faster to win."
msgstr "跑快一些才能赢。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "A bit faster, I'll count for you."
msgstr "再快一点，我替你数着。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "Another thing to set up."
msgstr "又一件要装的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Only resting now."
msgstr "现在只能休息了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Don't get tired halfway."
msgstr "别跑到一半就累。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Hold on a bit longer and you can rest."
msgstr "再撑一下就能休息。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "Set it up for stamina training."
msgstr "装好给它练耐力。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "Remember, you have to go through here."
msgstr "记住，要从这里过。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "Set them out clearly so it's harder to go wrong."
msgstr "摆清楚就不容易走错。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "Even the finish line burned."
msgstr "终点都烧没了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "It's over when you get here."
msgstr "跑到这里就结束。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "We won! The training paid off."
msgstr "赢了！训练没白做。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} won. We'll try again next time."
msgstr "{winner}赢了，下次我们再试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "This goes here last."
msgstr "最后放在这里。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Are all the racers ready."
msgstr "选手都准备好了吗。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Set up the start line first."
msgstr "起点先设好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Can't measure now."
msgstr "测不了了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "Needs more training."
msgstr "还得继续练。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Now I can feel good about sending it out."
msgstr "这回能放心上场了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "Let's see how the training's going."
msgstr "先看看训练得怎么样。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "Have to set up the scale first."
msgstr "得先把秤装好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_SEEDPACKET"
msgid "Open it and see what can be planted."
msgstr "拆开看看能种什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "This packet's pretty rare."
msgstr "这包倒挺少见。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_ANCHOR"
msgid "Parked. No rush to leave."
msgstr "停稳了，先别急着开。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Give the dragon boat an anchor too."
msgstr "给龙舟也装个锚。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Too much fire."
msgstr "火用得太多了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "Put a piece of charcoal in first."
msgstr "先放一块木炭。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Let's see what's new this year."
msgstr "看看今年有什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_OAR"
msgid "Racing still means rowing properly."
msgstr "赛船还是得认真划。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Don't rush the turns."
msgstr "转弯的时候别太急。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "Install it, then sail."
msgstr "装好再开船。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Once this is done I'm sitting in it first."
msgstr "这个做好了我要先坐。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Fine as long as it's not blocking my eyes."
msgstr "戴着不挡眼睛就行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "Burned up, have to prepare it all over."
msgstr "烧掉了，还得重新准备。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "Let's see what it wants first."
msgstr "先看看它要什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "Let's see what can be made this time."
msgstr "看看这次能做些什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Walking with this is actually kind of fun."
msgstr "拿着这个走路还挺有意思。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTH_LANCE"
msgid "This long, check beside you before turning."
msgstr "这么长，转身前先看旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD1"
msgid "This one looks appetizing."
msgstr "这份看着就让人有胃口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD2"
msgid "Better give this one to some other creature."
msgstr "这份还是给别的生物吧。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTP_FOOD3"
msgid "Pretty plain, but it works as a snack."
msgstr "普通一点，也能当零食。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "A bunny lantern. Nice at night."
msgstr "兔子灯，晚上挺好看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "Not lit. Should check on it."
msgstr "没亮，得看看。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "Put it by the tent."
msgstr "放在帐篷旁边。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "This one lit up too."
msgstr "这个也亮起来了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "The light's out."
msgstr "光灭了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "Find a visible spot for it."
msgstr "找个显眼的地方摆。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "The bell hasn't rung. Resting for now."
msgstr "铃还没响，先歇会。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "It's started. Not in the face."
msgstr "开始了，别砸脸。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "Even a pillow fight needs an arena set up first."
msgstr "玩枕头也要先搭场地。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD1"
msgid "Carrots like this, I'm willing to eat."
msgstr "胡萝卜做成这样就愿意吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD2"
msgid "Weird color, but it tastes alright."
msgstr "这个颜色怪，味道倒还行。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD3"
msgid "It's all wobbly. I'll take a bite first."
msgstr "晃来晃去的，先吃一口。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_FOOD4"
msgid "Rabbit-shaped. Way too cute."
msgstr "兔子形状的，也太可爱了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "All the decorations burned."
msgstr "装饰全烧了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Give it some food first."
msgstr "先给它点吃的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "What can I make for the Rabbit festival."
msgstr "兔子节能做点什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTR_TOKEN"
msgid "Whoever you give it to, you have to fight them?"
msgstr "给谁就得和谁打一场？"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "The lantern post burned."
msgstr "灯架烧掉了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "Once the lanterns are hung, it has real atmosphere."
msgstr "灯挂好就很有气氛。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "Pick a spot first."
msgstr "先选好位置。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "Can't trade for anything now."
msgstr "这下什么也换不了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "It wants monster meat."
msgstr "它想吃怪物肉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "Let's see what I can trade for."
msgstr "看看能换些什么。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOTS_WORM"
msgid "Even the little ones can burrow around."
msgstr "小的也能钻来钻去。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "The kittens won't like that smell."
msgstr "小猫不会喜欢这个味道。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "Try putting in a feather."
msgstr "放根羽毛试试。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "Could make something for the kittens to play with."
msgstr "能做些给小猫玩的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_GENERIC"
msgid "Nothing special that I can tell."
msgstr "看不出有什么特别的。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTHAPPY"
msgid "It's growing well. No extra work today."
msgstr "长得不错，今天不用多忙。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSED"
msgid "It's not growing very well."
msgstr "长得不太好。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "Needs some of its own kind planted nearby."
msgstr "旁边得种些同类。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "I have to talk to it too. What a pain."
msgstr "还得陪它说话。真麻烦。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "Have to pull the weeds beside it."
msgstr "得把旁边的杂草拔掉。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "Time to water again."
msgstr "又该浇水了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "The soil's short on fertilizer."
msgstr "土里缺肥。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "Planted too close together."
msgstr "种得太挤了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTSTRESSORSEASON"
msgid "This season doesn't suit it."
msgstr "这个季节不适合它。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_PLANTVERYSTRESSED"
msgid "If nobody looks after it, there'll be no vegetables."
msgstr "再不照顾就没菜吃了。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_SMOLDERING"
msgid "It's about to catch fire, gotta deal with that."
msgstr "快烧起来了，得处理一下。"

#. STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.DESCRIBE_TOODARK"
msgid "Too dark. I'll look when there's light."
msgstr "太暗了，等有光再看。"

#. STRINGS.CHARACTERS.KIRITZUKA.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "What did I just bite into..."
msgstr "刚才咬到的是什么……"

#. STRINGS.CHARACTERS.KIRITZUKA.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.EAT_FOOD.WINTERSFEASTFUEL"
msgid "This taste actually feels like a holiday."
msgstr "这个味道，倒像过节了。"

#. STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_LOSE"
msgid "I don't think we're getting back now."
msgstr "这下恐怕回不去了。"

#. STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Burned. Can't eat it."
msgstr "烧焦了，不能拿来吃。"

#. STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "This combination can't make a dish at all."
msgstr "这些搭配根本做不成菜。"

#. STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.KIRITZUKA.QUAGMIRE_ANNOUNCE_WIN"
msgid "We can go. Finally."
msgstr "可以走了，终于。"


#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRANKEN_PIG
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.FRANKEN_PIG"
msgid "Pardon me, have you changed your hair?"
msgstr "打扰了，您换发型了吗？"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_10
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_10"
msgid "Everyone keeps asking me to hang this on the tree."
msgstr "大家一直催我把这个挂到树上。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_7
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_7"
msgid "The stitching is uneven. It needs more practice."
msgstr "针脚不太整齐，还需要多加练习。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_8
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_8"
msgid "Decorating is good discipline, though I do get tangled up."
msgstr "装饰也是一种修行，只是我总会被缠住。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_9
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.HALLOWEEN_ORNAMENT_9"
msgid "This one is among my favorites."
msgstr "这是我最喜欢的装饰之一。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFPILE
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.LEAFPILE"
msgid "I should sweep that up properly."
msgstr "我应该好好把它扫干净。"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUMMY_MERM
msgctxt "STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.MUMMY_MERM"
msgid "A mummy! Please keep your distance!"
msgstr "木乃伊！请保持距离！"

#. STRINGS.CHARACTERS.MANUTSAWEE.DESCRIBE.PUMPKIN_BOMB
